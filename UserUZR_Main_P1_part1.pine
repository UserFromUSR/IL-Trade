indicator("UserUZR Main - All-in-One Optimized (FVG, VP, S&D, SMC, OB/BB, HeatMap)", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=5000, max_polylines_count=100)

// ====================================================================================================================
// НАСТРОЙКИ МОДУЛЕЙ
// ====================================================================================================================

// ── 1. Clusters Volume Profile ───────────────────────────────────────────────
grp_1      = "1. Clusters Volume Profile"
en_1       = input.bool(true,  "Включить Clusters VP",          group=grp_1)
lookback_1 = input.int(200,    "Период (Lookback)",  minval=10,  group=grp_1)
k_1        = input.int(5,      "Количество кластеров", minval=2, maxval=10, group=grp_1)
iters_1    = input.int(50,     "Итерации K-Means",  minval=5,   maxval=50,  group=grp_1)
rows_1     = input.int(20,     "Строк на кластер (Bins)", minval=3, group=grp_1)
vpWidth    = input.int(40,     "Ширина гистограммы (бары)", minval=5, group=grp_1)
vpOffset   = input.int(10,     "Отступ гистограммы",          group=grp_1)
showDots   = input.bool(true,  "Точки прайса (Price Dots)",     group=grp_1)

// ── 2. FVG Volume Profile ────────────────────────────────────────────────────
grp_2          = "2. FVG Volume Profile [ChartPrime]"
en_2           = input.bool(true,   "Включить FVG VP",                   group=grp_2)
fvg_autoTf     = input.bool(true,   "Auto",          inline="1",          group=grp_2)
fvg_tf1        = input.timeframe("10", "",            inline="1",          group=grp_2, tooltip="Custom timeframe for detecting volume of Fair Value Gaps.")
fvg_hideVP     = input.bool(true,   "Display",                            group=grp_2)
fvg_bins       = input.int(10,      "Resolution",                         group=grp_2)
fvg_gap_filter = input.float(0.3,   "Filter Gaps",   step=0.01,           group=grp_2)
fvg_bull_color = input.color(#1da370, "Bullish Color",                    group=grp_2)
fvg_bear_color = input.color(#bc25d6, "Bearish Color",                    group=grp_2)

// ── 3. Supply & Demand ───────────────────────────────────────────────────────
grp_3      = "3. Supply & Demand (Flux)"
en_3       = input.bool(true,  "Включить S&D",                            group=grp_3)
sd_retests = input.bool(true,  "Скрытая логика ретеста (On)",             group=grp_3, tooltip="Метки скрыты визуально, но логика работает для сигналов.")
sd_d_col   = input.color(color.new(#089981, 70), "Цвет Demand",           group=grp_3)
sd_s_col   = input.color(color.new(#f23645, 70), "Цвет Supply",           group=grp_3)
sd_text_col= input.color(color.new(#ffffff, 30), "Цвет текста S&D",       group=grp_3)

// ── 4. SMC & Order Blocks ────────────────────────────────────────────────────
grp_4          = "4. SMC & Order Blocks"
en_smc         = input.bool(true,   "Включить SMC & OB",                  group=grp_4)
bb_swingLimit  = input.int(100,     "Swing Limit",  minval=10, maxval=200, group=grp_4)
bb_smc_up_col  = input.color(#089981, "Цвет бычьей SMC",                  group=grp_4)
bb_smc_dn_col  = input.color(#f23645, "Цвет медвежьей SMC",               group=grp_4)
bb_showMapping = input.bool(true,   "Show Mapping Structure",              group=grp_4)
bb_mappingStyle= input.string("----","Mapping Style", options=["⎯⎯⎯⎯","----"], group=grp_4)
bb_mappingcss  = input.color(color.silver, "Mapping Color",               group=grp_4)
bb_msmode      = input.string("Adjusted Points","Algorithmic Logic", options=["Extreme Points","Adjusted Points"], group=grp_4)
bb_mslen       = input.int(5,       "Swing Length", minval=2,              group=grp_4)
bb_buildsweep  = input.bool(true,   "Build Sweep (x)",                    group=grp_4)
bb_msbubble    = input.bool(true,   "Bubbles on Structure",               group=grp_4)
bb_mstext      = input.string("Tiny","SMC Text Size", options=["Tiny","Small","Normal","Large","Huge","Auto"], group=grp_4)
bb_obshow      = input.bool(true,   "Show Order Blocks",                  group=grp_4)
bb_obupcs      = input.color(color.new(#089981, 90), "OB Bull Color",     group=grp_4)
bb_obdncs      = input.color(color.new(#f23645, 90), "OB Bear Color",     group=grp_4)
bb_obshowactivity = input.bool(true,"Show OB Buy/Sell Activity",          group=grp_4)
bb_obactup     = input.color(color.new(#089981, 50), "OB Activity Bull",  group=grp_4)
bb_obactdn     = input.color(color.new(#f23645, 50), "OB Activity Bear",  group=grp_4)
bb_obshowbb    = input.bool(true,   "Show Breakers",                      group=grp_4)
bb_bbup        = input.color(color.new(#089981, 90), "Breaker Bull",      group=grp_4)
bb_bbdn        = input.color(color.new(#f23645, 90), "Breaker Bear",      group=grp_4)
bb_obmode      = input.string("Length","OB Construction", options=["Length","Full"], group=grp_4)
bb_len         = input.int(3,       "OB ATR Length", minval=1,            group=grp_4)
bb_obmiti      = input.string("Close","Mitigation Method", options=["Close","Wick","Avg"], group=grp_4)
bb_obtxt       = input.string("Normal","OB Metric Text Size", options=["Tiny","Small","Normal","Large","Huge","Auto"], group=grp_4)
bb_showmetric  = input.bool(true,   "Show OB Metrics",                    group=grp_4)
bb_showline    = input.bool(true,   "Show OB Mid-Line",                   group=grp_4)
bb_overlap     = input.bool(true,   "Hide OB Overlap",                    group=grp_4)
bb_wichlap     = input.string("Recent","Which Overlap to Hide", options=["Recent","Old"], group=grp_4)

// ── 5. Dynamic HeatMap ───────────────────────────────────────────────────────
grp_5      = "5. Dynamic HeatMap (BigBeluga)"
en_hm      = input.bool(true,  "Включить HeatMap",                        group=grp_5)
hm_lookBack= input.int(150,    "Calculated Bars", minval=50, maxval=1000,  group=grp_5)
hm_displPf = input.bool(true,  "Profile",                                 group=grp_5)
hm_bins    = input.int(35,     "Resolution",                              group=grp_5)
hm_sellColor = input.color(color.blue,  "Sell Liquidity",                 group=grp_5)
hm_buyColor  = input.color(color.lime,  "Buy Liquidity",                  group=grp_5)
hm_poc     = input.bool(true,  "Max Point Liquidity",                     group=grp_5)
hm_maxColor= input.color(color.orange,  "Max Color",                      group=grp_5)
hm_resolution = 100

// ====================================================================================================================
// ЕДИНЫЕ ТАЙМФРЕЙМЫ
// ====================================================================================================================

grp_tf_common = "TF — Таймфреймы (общие для всех модулей)"
g_ltf1 = input.timeframe("1",   "LTF1 ТФ", group=grp_tf_common, tooltip="Должен совпадать с LTF1 в Sniper P2")
g_ltf2 = input.timeframe("3",   "LTF2 ТФ", group=grp_tf_common, tooltip="Должен совпадать с LTF2 в Sniper P2")
g_ltf3 = input.timeframe("5",   "LTF3 ТФ", group=grp_tf_common, tooltip="Должен совпадать с LTF3 в Sniper P2")
g_htf1 = input.timeframe("60",  "HTF1 ТФ", group=grp_tf_common, tooltip="Должен совпадать с HTF1 в Sniper P2")
g_htf2 = input.timeframe("240", "HTF2 ТФ", group=grp_tf_common, tooltip="Должен совпадать с HTF2 в Sniper P2")
g_htf3 = input.timeframe("D",   "HTF3 ТФ", group=grp_tf_common, tooltip="Должен совпадать с HTF3 в Sniper P2")

grp_tf_weights = "TF — Веса в синтезе модулей"
g_w_ltf = input.int(1, "Вес каждого LTF в модуле", minval=1, maxval=4, group=grp_tf_weights, tooltip="Совпадает с весом LTF в Sniper P2 скоринге")
g_w_htf = input.int(2, "Вес каждого HTF в модуле", minval=1, maxval=4, group=grp_tf_weights, tooltip="Совпадает с весом HTF в Sniper P2 скоринге")

// ====================================================================================================================
// ENGINE LTF1 (1m)
// ====================================================================================================================
grp_e1 = "Engine LTF1 (1m) — RSI"
e1_use_rsi      = input.bool(true,  "Включить RSI",                    group=grp_e1)
e1_rsi_len      = input.int(7,      "RSI Length",        minval=2,      group=grp_e1)
e1_rsi_bull_th  = input.int(58,     "Бык: RSI <",        minval=1, maxval=99, group=grp_e1)
e1_rsi_bear_th  = input.int(42,     "Медведь: RSI >",   minval=1, maxval=99, group=grp_e1)

grp_e1b = "Engine LTF1 (1m) — Свечи"
e1_use_candles  = input.bool(true,  "Включить паттерны свечей",         group=grp_e1b)
e1_candle_cnt   = input.int(3,      "Мин. свечей из 5 (накопление)",    group=grp_e1b, minval=1, maxval=5)
e1_use_engulf   = input.bool(true,  "Включить Engulfing",               group=grp_e1b)
e1_use_strong   = input.bool(true,  "Включить Strong Body (ratio>X)",   group=grp_e1b)
e1_strong_ratio = input.float(0.65, "Strong Body порог", step=0.05,     group=grp_e1b)

grp_e1c = "Engine LTF1 (1m) — Объём"
e1_use_vol      = input.bool(true,  "Включить объём",                   group=grp_e1c)
e1_vol_sma_len  = input.int(20,     "SMA объёма Length",    minval=5,   group=grp_e1c)
e1_vol_mult     = input.float(2.2,  "Объём > SMA × X",      step=0.1,   group=grp_e1c)
e1_vol_must     = input.bool(false, "Объём ОБЯЗАТЕЛЕН",                 group=grp_e1c)

grp_e1d = "Engine LTF1 (1m) — OB прокси"
e1_use_ob       = input.bool(true,  "Включить OB прокси",               group=grp_e1d)
e1_ob_atr_len   = input.int(14,     "ATR Length для OB",    minval=5,   group=grp_e1d)
e1_ob_atr_mult  = input.float(0.8,  "Мин. дислокация ATR×", step=0.1,  group=grp_e1d)
e1_ob_vol_mult  = input.float(1.5,  "OB объём > SMA ×",     step=0.1,  group=grp_e1d)

grp_e1e = "Engine LTF1 (1m) — FVG прокси"
e1_use_fvg      = input.bool(true,  "Включить FVG прокси",              group=grp_e1e)
e1_fvg_thr      = input.float(0.25, "FVG gap threshold",    step=0.05,  group=grp_e1e)
e1_fvg_with_htf = input.bool(false, "Только по HTF тренду",             group=grp_e1e)

grp_e1f = "Engine LTF1 (1m) — HeatMap прокси"
e1_use_hm       = input.bool(true,  "Включить HeatMap прокси",          group=grp_e1f)
e1_hm_lookback  = input.int(30,     "HM Lookback (баров)",  minval=10,  group=grp_e1f)
e1_hm_vol_mult  = input.float(1.8,  "HM объём > SMA ×",     step=0.1,  group=grp_e1f)

grp_e1g = "Engine LTF1 (1m) — S&D прокси"
e1_use_sd       = input.bool(true,  "Включить S&D прокси",              group=grp_e1g)
e1_sd_body_mult = input.float(1.5,  "S&D тело дислокации > ATR×", step=0.1, group=grp_e1g)
e1_sd_base_mult = input.float(0.7,  "S&D база < ATR×",        step=0.1, group=grp_e1g)

grp_e1h = "Engine LTF1 (1m) — SMC прокси"
e1_use_smc      = input.bool(true,  "Включить SMC прокси",              group=grp_e1h)
e1_smc_swing    = input.int(3,      "Swing Length (пивоты)", minval=2,  group=grp_e1h)
e1_smc_hh_cnt   = input.int(2,      "Мин. HH/HL или LH/LL из 3",       group=grp_e1h, minval=1, maxval=3)
e1_smc_must     = input.bool(false, "SMC тренд ОБЯЗАТЕЛЕН",             group=grp_e1h)

grp_e1i = "Engine LTF1 (1m) — Веса и порог"
e1_w_struct     = input.int(2,  "Вес структурных (SMC,OB)",  minval=1, maxval=4, group=grp_e1i)
e1_w_volume     = input.int(2,  "Вес объёмных (Vol,HM,FVG)", minval=1, maxval=4, group=grp_e1i)
e1_w_pattern    = input.int(1,  "Вес паттернных (RSI,свечи,S&D)", minval=1, maxval=4, group=grp_e1i)
e1_min_score    = input.int(6,  "Мин. сумма для OK",         minval=1, maxval=40, group=grp_e1i)

// ====================================================================================================================
// ENGINE LTF2 (3m)
// ====================================================================================================================
grp_e2 = "Engine LTF2 (3m) — RSI"
e2_use_rsi      = input.bool(true,  "Включить RSI",                    group=grp_e2)
e2_rsi_len      = input.int(7,      "RSI Length",        minval=2,      group=grp_e2)
e2_rsi_bull_th  = input.int(60,     "Бык: RSI <",        minval=1, maxval=99, group=grp_e2)
e2_rsi_bear_th  = input.int(40,     "Медведь: RSI >",   minval=1, maxval=99, group=grp_e2)

grp_e2b = "Engine LTF2 (3m) — Свечи"
e2_use_candles  = input.bool(true,  "Включить паттерны свечей",         group=grp_e2b)
e2_candle_cnt   = input.int(3,      "Мин. свечей из 5",                 group=grp_e2b, minval=1, maxval=5)
e2_use_engulf   = input.bool(true,  "Включить Engulfing",               group=grp_e2b)
e2_use_strong   = input.bool(true,  "Включить Strong Body",             group=grp_e2b)
e2_strong_ratio = input.float(0.65, "Strong Body порог", step=0.05,     group=grp_e2b)

grp_e2c = "Engine LTF2 (3m) — Объём"
e2_use_vol      = input.bool(true,  "Включить объём",                   group=grp_e2c)
e2_vol_sma_len  = input.int(20,     "SMA объёма Length",    minval=5,   group=grp_e2c)
e2_vol_mult     = input.float(2.0,  "Объём > SMA × X",      step=0.1,   group=grp_e2c)
e2_vol_must     = input.bool(false, "Объём ОБЯЗАТЕЛЕН",                 group=grp_e2c)

grp_e2d = "Engine LTF2 (3m) — OB прокси"
e2_use_ob       = input.bool(true,  "Включить OB прокси",               group=grp_e2d)
e2_ob_atr_len   = input.int(14,     "ATR Length для OB",    minval=5,   group=grp_e2d)
e2_ob_atr_mult  = input.float(0.9,  "Мин. дислокация ATR×", step=0.1,  group=grp_e2d)
e2_ob_vol_mult  = input.float(1.5,  "OB объём > SMA ×",     step=0.1,  group=grp_e2d)

grp_e2e = "Engine LTF2 (3m) — FVG прокси"
e2_use_fvg      = input.bool(true,  "Включить FVG прокси",              group=grp_e2e)
e2_fvg_thr      = input.float(0.28, "FVG gap threshold",    step=0.05,  group=grp_e2e)
e2_fvg_with_htf = input.bool(false, "Только по HTF тренду",             group=grp_e2e)

grp_e2f = "Engine LTF2 (3m) — HeatMap прокси"
e2_use_hm       = input.bool(true,  "Включить HeatMap прокси",          group=grp_e2f)
e2_hm_lookback  = input.int(40,     "HM Lookback (баров)",  minval=10,  group=grp_e2f)
e2_hm_vol_mult  = input.float(1.8,  "HM объём > SMA ×",     step=0.1,  group=grp_e2f)

grp_e2g = "Engine LTF2 (3m) — S&D прокси"
e2_use_sd       = input.bool(true,  "Включить S&D прокси",              group=grp_e2g)
e2_sd_body_mult = input.float(1.5,  "S&D тело > ATR×",      step=0.1,  group=grp_e2g)
e2_sd_base_mult = input.float(0.7,  "S&D база < ATR×",       step=0.1,  group=grp_e2g)

grp_e2h = "Engine LTF2 (3m) — SMC прокси"
e2_use_smc      = input.bool(true,  "Включить SMC прокси",              group=grp_e2h)
e2_smc_swing    = input.int(3,      "Swing Length",          minval=2,  group=grp_e2h)
e2_smc_hh_cnt   = input.int(2,      "Мин. HH/HL или LH/LL", minval=1, maxval=3, group=grp_e2h)
e2_smc_must     = input.bool(false, "SMC тренд ОБЯЗАТЕЛЕН",             group=grp_e2h)

grp_e2i = "Engine LTF2 (3m) — Веса и порог"
e2_w_struct     = input.int(2,  "Вес структурных",  minval=1, maxval=4, group=grp_e2i)
e2_w_volume     = input.int(2,  "Вес объёмных",     minval=1, maxval=4, group=grp_e2i)
e2_w_pattern    = input.int(1,  "Вес паттернных",   minval=1, maxval=4, group=grp_e2i)
e2_min_score    = input.int(6,  "Мин. сумма для OK", minval=1, maxval=40, group=grp_e2i)

