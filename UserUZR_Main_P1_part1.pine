grp_e3f = "Engine LTF3 (5m) — HeatMap прокси"
e3_use_hm       = input.bool(true,  "Включить HeatMap прокси",          group=grp_e3f)
e3_hm_lookback  = input.int(50,     "HM Lookback (баров)",  minval=10,  group=grp_e3f)
e3_hm_vol_mult  = input.float(1.8,  "HM объём > SMA ×",     step=0.1,  group=grp_e3f)

grp_e3g = "Engine LTF3 (5m) — S&D прокси"
e3_use_sd       = input.bool(true,  "Включить S&D прокси",              group=grp_e3g)
e3_sd_body_mult = input.float(1.5,  "S&D тело > ATR×",      step=0.1,  group=grp_e3g)
e3_sd_base_mult = input.float(0.7,  "S&D база < ATR×",       step=0.1,  group=grp_e3g)

grp_e3h = "Engine LTF3 (5m) — SMC прокси"
e3_use_smc      = input.bool(true,  "Включить SMC прокси",              group=grp_e3h)
