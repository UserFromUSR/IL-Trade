// ENGINE LTF3 (5m)
// ====================================================================================================================
grp_e3 = "Engine LTF3 (5m) — RSI"
e3_use_rsi      = input.bool(true,  "Включить RSI",                    group=grp_e3)
e3_rsi_len      = input.int(9,      "RSI Length",        minval=2,      group=grp_e3)
