float p1_ob_sd_bear_src          = input.source(close,"[P1] OB in SD Bear",            group=grp_p1)

// ====================================================================================================================
// ИНИЦИАЛИЗАЦИЯ P1 — ПРОВЕРКА ПОДКЛЮЧЕНИЯ
// Единственный источник истины — ALIVE_SIGNAL = 9999.0
// ====================================================================================================================

is_conn(src) => not na(p1_alive_src) and p1_alive_src == 9999.0 and not na(src)

bool p1_connected = not na(p1_alive_src) and p1_alive_src == 9999.0

// ── Базовые P1 значения ───────────────────────────────────────────────────────
float p1_tf_mins      = is_conn(p1_tf_src)             ? p1_tf_src             : na
int   p1_smc_trend    = is_conn(p1_smc_src)            ? int(p1_smc_src)       : 0
float p1_bos_level    = is_conn(p1_bos_src)            ? p1_bos_src            : na
int   p1_bos_trig     = is_conn(p1_bos_trig_src)       ? int(p1_bos_trig_src)  : 0
int   p1_ob_signal    = is_conn(p1_ob_src)             ? int(p1_ob_src)        : 0
int   p1_sd_zone      = is_conn(p1_sd_src)             ? int(p1_sd_src)        : 0
int   p1_fvg_dir      = is_conn(p1_fvg_src)            ? int(p1_fvg_src)       : 0
