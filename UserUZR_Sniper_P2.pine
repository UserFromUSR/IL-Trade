//            Market Regime, CVD & OTE, Live MTF Cascade Светофор, HTF Engine v2)
//@version=6
indicator("UserUZR Sniper - All-In-One Optimized (EMA, RSI, STC, MACD, Cndl, MDivs, SM, Logic)", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

get_size(str) =>
    switch str
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        "huge"   => size.huge
        => size.auto

// ====================================================================================================================
// 1. СКОЛЬЗЯЩИЕ СРЕДНИЕ
// ====================================================================================================================
grp_trend    = "1. Скользящие Средние (MA) и Тренд"
en_mod_ma    = input.bool(true,  "🟢 Включить модуль MA",                    group=grp_trend)
sync_len     = input.int(5,      "Swing Период",        minval=2,             group=grp_trend)
ma_sig_logic = input.string("Fast > Slow","Логика Тренда MA", options=["Fast > Slow","Price > Global MA","Both"], group=grp_trend)
ma_fast_type = input.string("EMA","Тип Быстрой MA", options=["EMA","WMA","HMA","ALMA","SMA"], group=grp_trend)
ma_fast_len  = input.int(20,  "Длина Быстрой MA",      minval=1,             group=grp_trend)
ma_slow_type = input.string("EMA","Тип Медленной MA", options=["EMA","WMA","HMA","ALMA","SMA"], group=grp_trend)
ma_slow_len  = input.int(50,  "Длина Медленной MA",    minval=1,             group=grp_trend)
ma_filt_type = input.string("EMA","Тип Глобальной MA", options=["EMA","WMA","HMA","ALMA","SMA"], group=grp_trend)
ma_filt_len  = input.int(200, "Длина Глобальной MA",   minval=1,             group=grp_trend)
alma_offset  = input.float(0.85,"ALMA Offset",                               group=grp_trend)
alma_sigma   = input.float(6.0, "ALMA Sigma",                                group=grp_trend)
en_ma        = input.bool(true,  "Показывать Fast/Slow MA",                  group=grp_trend)
en_ma_filt   = input.bool(true,  "Показывать Global MA",                     group=grp_trend)
en_ma_cross  = input.bool(true,  "Отмечать пересечение Fast/Slow",           group=grp_trend)
ma_fast_col  = input.color(color.new(#2196F3,0),"Цвет Fast MA",              group=grp_trend)
ma_slow_col  = input.color(color.new(#9C27B0,0),"Цвет Slow MA",              group=grp_trend)
ma_filt_col  = input.color(color.new(#FF9800,0),"Цвет Global MA",            group=grp_trend)

// ====================================================================================================================
// 1.1 MARKET REGIME
// ====================================================================================================================
grp_regime = "1.1 Market Regime (Мастер-фильтр)"
en_regime  = input.bool(true,  "🟢 Включить Фильтр Фазы Рынка",             group=grp_regime)
chop_len   = input.int(14,     "Период Choppiness",                          group=grp_regime)
adx_len    = input.int(14,     "Период ADX",                                 group=grp_regime)
vol_th     = input.float(0.65, "Порог волатильности (ATR Ratio)", step=0.05, group=grp_regime)

// ====================================================================================================================
// 2. ОСЦИЛЛЯТОРЫ
// ====================================================================================================================
grp_osc_kde  = "2.1. Осциллятор: KDE RSI"
en_mod_kde   = input.bool(true,       "🟢 Включить модуль (Главный)",        group=grp_osc_kde)
kde_rsi_len  = input.int(14,          "RSI Длина",      minval=1,            group=grp_osc_kde)
kde_piv_len  = input.int(21,          "Длина Пивотов",  minval=1,            group=grp_osc_kde)
kde_kernel   = input.string("Gaussian","Ядро (Kernel)", options=["Uniform","Gaussian","Sigmoid"], group=grp_osc_kde)
kde_bandw    = input.float(2.71828,   "Сглаживание (Bandwidth)",             group=grp_osc_kde)
kde_steps    = input.int(75,          "Точность (Bins)", minval=10,           group=grp_osc_kde)
kde_thresh   = input.string("Medium", "Порог активации", options=["High","Medium","Low"], group=grp_osc_kde)

grp_osc_stc  = "2.2. Осциллятор: Stoch Z-Score"
en_mod_stoch = input.bool(true,  "🟢 Включить модуль (Главный)",             group=grp_osc_stc)
stoch_z_src  = input.source(hlc3,"Source (Stoch Z)",                         group=grp_osc_stc)
stoch_z_len  = input.int(21,     "Length (Stoch Z)",    minval=1,            group=grp_osc_stc)
stoch_z_ob   = input.float(2.0,  "Overbought Level",    step=0.5,            group=grp_osc_stc)
stoch_z_os   = input.float(-2.0, "Oversold Level",      step=0.5,            group=grp_osc_stc)
stoch_strict = input.bool(true,  "Строгий фильтр (учет ALMA LTM)",           group=grp_osc_stc)

grp_osc_dlx   = "2.3. Осциллятор: Adaptive MACD Deluxe"
en_mod_dlx    = input.bool(true,   "🟢 Включить модуль (Главный)",           group=grp_osc_dlx)
macd_dlx_r2   = input.int(20,      "R-Squared Lookback",   minval=2,         group=grp_osc_dlx)
macd_dlx_fast = input.int(10,      "Fast EMA Length",      minval=2,         group=grp_osc_dlx)
macd_dlx_slow = input.int(20,      "Slow EMA Length",      minval=2,         group=grp_osc_dlx)
macd_dlx_ob   = input.float(100.0, "Уровень Перекупленности (OB)",           group=grp_osc_dlx)
macd_dlx_os   = input.float(-100.0,"Уровень Перепроданности (OS)",           group=grp_osc_dlx)

grp_osc_cci   = "2.4. Осциллятор: Advanced CCI (ST + L3)"
en_mod_cci    = input.bool(true,  "🟢 Включить модуль (Главный)",            group=grp_osc_cci)
cci_st_len    = input.int(28,     "CCI Period (Supertrend)", minval=1,        group=grp_osc_cci)
cci_st_factor = input.float(3.0,  "Factor (Supertrend)",    minval=0.1,      group=grp_osc_cci)
cci_st_pd     = input.int(3,      "ATR Period (Supertrend)",minval=1,         group=grp_osc_cci)
cci_l3_len    = input.int(11,     "CCI Length (L3 Super)",  minval=1,         group=grp_osc_cci)
cci_l3_ci     = input.int(5,      "CI EMA Length (L3 Super)",minval=1,        group=grp_osc_cci)

grp_osc_sm_act = "2.5. Объемы: Smart Money Activity"
en_mod_smact   = input.bool(true, "🟢 Включить модуль (Главный)",            group=grp_osc_sm_act)
sm_act_ltf     = input.timeframe("5","Младший ТФ (LTF)",                     group=grp_osc_sm_act)
sm_act_zlen    = input.int(50,    "Период накопления Z-Score", minval=5,      group=grp_osc_sm_act)
sm_act_th      = input.float(2.5, "Порог экстремального Z-Score", step=0.1,  group=grp_osc_sm_act)

grp_osc_sm_idx = "2.6. Объемы: Smart Money Index"
en_mod_smidx   = input.bool(true,  "🟢 Включить модуль (Главный)",           group=grp_osc_sm_idx)
sm_idx_x       = input.int(25,     "Период Индекса",  minval=1,              group=grp_osc_sm_idx)
sm_idx_rr      = input.int(14,     "Период RSI (Volume Flow)", minval=1,     group=grp_osc_sm_idx)
sm_idx_peak    = input.int(500,    "Период Нормализации", minval=1,           group=grp_osc_sm_idx)
sm_idx_thr     = input.float(0.7,  "Порог активности", minval=0.01, step=0.05, group=grp_osc_sm_idx)
sm_idx_strict  = input.bool(true,  "Строгий триггер",                        group=grp_osc_sm_idx)

grp_osc_sm_int = "2.7. Объемы: Smart Money Interest"
en_mod_smint   = input.bool(true,  "🟢 Включить модуль (Главный)",           group=grp_osc_sm_int)
sm_int_x       = input.int(25,     "Период Индекса",  minval=1,              group=grp_osc_sm_int)
sm_int_rr      = input.int(14,     "Период RSI",      minval=1,              group=grp_osc_sm_int)
sm_int_peak    = input.int(500,    "Период Нормализации", minval=1,           group=grp_osc_sm_int)
sm_int_thr     = input.float(0.9,  "Порог активности", minval=0.01, step=0.05, group=grp_osc_sm_int)

grp_osc_mdiv = "2.8. Дивергенции: Multi-Div (Lonesome)"
en_mod_mdiv  = input.bool(true,  "🟢 Включить модуль (Главный)",             group=grp_osc_mdiv)
mdiv_prd     = input.int(5,      "Период Пивотов",  minval=1,                group=grp_osc_mdiv)
mdiv_type    = input.string("Regular/Hidden","Тип дивера", options=["Regular","Hidden","Regular/Hidden"], group=grp_osc_mdiv)
mdiv_limit   = input.int(1,      "Мин. кол-во диверов", minval=1, maxval=11, group=grp_osc_mdiv)
mdiv_maxb    = input.int(100,    "Макс. длина поиска (баров)", minval=30,     group=grp_osc_mdiv)

grp_osc_peter = "2.9. Дивергенции: Multi-Div (PeterO)"
en_mod_peter  = input.bool(true, "🟢 Включить модуль (Главный)",             group=grp_osc_peter)
peter_lbL     = input.int(3,    "Pivot Lookback Left",   minval=1,           group=grp_osc_peter)
peter_lbR     = input.int(1,    "Pivot Lookback Right",  minval=1,           group=grp_osc_peter)
peter_rngL    = input.int(1,    "Min Lookback Range",    minval=1,           group=grp_osc_peter)
peter_rngU    = input.int(60,   "Max Lookback Range",    minval=10,          group=grp_osc_peter)
peter_limit   = input.int(2,    "Min Div Count",         minval=1, maxval=10, group=grp_osc_peter)

grp_osc_tfdiv = "3.0. Дивергенции: TradingFinder Fractal"
en_mod_tfdiv  = input.bool(true, "🟢 Включить модуль (Главный)",             group=grp_osc_tfdiv)
tfdiv_n       = input.int(4,    "Fractal Periods (n)",  minval=2,            group=grp_osc_tfdiv)
tfdiv_type    = input.string("MACD","Осциллятор (Type)", options=["MACD","RSI","AO"], group=grp_osc_tfdiv)

grp_osc_smt = "3.1. Дивергенции: SMT (Межрыночные)"
en_mod_smt  = input.bool(true,  "🟢 Включить модуль (Главный)",              group=grp_osc_smt)
smt_len     = input.int(3,      "SMT Pivot Lookback",   minval=2,            group=grp_osc_smt)
smt_use1    = input.bool(true,  "Включить Символ 1",   inline="symA",        group=grp_osc_smt)
smt_sym1    = input.symbol("CME_MINI_DL:ES1!","",      inline="symA",        group=grp_osc_smt)
smt_use2    = input.bool(true,  "Включить Символ 2",   inline="symB",        group=grp_osc_smt)
smt_sym2    = input.symbol("CBOT_MINI_DL:YM1!","",     inline="symB",        group=grp_osc_smt)

// ====================================================================================================================
// 3.2 СВЕЧНОЙ МОДУЛЬ
// ====================================================================================================================
grp_cndl      = "3.2. Свечной анализ (LuxAlgo)"
en_mod_cndl   = input.bool(true, "🟢 Включить модуль Свечей",                group=grp_cndl)
cndl_bull_col = input.color(color.new(#089981,0),"Цвет Бычьих",              group=grp_cndl)
cndl_bear_col = input.color(color.new(#f23645,0),"Цвет Медвежьих",           group=grp_cndl)
cndl_neut_col = input.color(color.new(color.black,0),"Цвет Нейтральных",     group=grp_cndl)
cndl_lbl_size = input.string("tiny","Размер текста названия", options=["auto","tiny","small","normal","large"], group=grp_cndl)
cndl_bar_col  = input.bool(true, "Красить бары",                              group=grp_cndl)
cndl_show_lbl = input.bool(true, "Показывать ярлыки и текст",                 group=grp_cndl)
en_hammer     = input.bool(true, "Бычьи: Молот",     group=grp_cndl, inline="b1")
en_ihammer    = input.bool(true, "Пер. Молот",        group=grp_cndl, inline="b1")
en_bull_eng   = input.bool(true, "Поглощение",        group=grp_cndl, inline="b2")
en_r3         = input.bool(true, "3 Поднимающихся",   group=grp_cndl, inline="b2")
en_3ws        = input.bool(true, "3 Белых Солдата",   group=grp_cndl, inline="b3")
en_mstar      = input.bool(true, "Утренняя звезда",   group=grp_cndl, inline="b3")
en_bull_har   = input.bool(true, "Харами",             group=grp_cndl, inline="b4")
en_tw_bot     = input.bool(true, "Пинцет Дно",         group=grp_cndl, inline="b4")
en_hman       = input.bool(true, "Медв: Повешенный",  group=grp_cndl, inline="s1")
en_sstar      = input.bool(true, "Падающая звезда",   group=grp_cndl, inline="s1")
en_bear_eng   = input.bool(true, "Поглощение",         group=grp_cndl, inline="s2")
en_f3         = input.bool(true, "3 Падающих",         group=grp_cndl, inline="s2")
en_3bc        = input.bool(true, "3 Черн. Вороны",    group=grp_cndl, inline="s3")
en_estar      = input.bool(true, "Вечерняя звезда",   group=grp_cndl, inline="s3")
en_bear_har   = input.bool(true, "Харами",             group=grp_cndl, inline="s4")
en_tw_top     = input.bool(true, "Пинцет Вершина",    group=grp_cndl, inline="s4")
en_doji       = input.bool(false,"Нейтральная: Doji", group=grp_cndl)

// ====================================================================================================================
// 4. НАСТРОЙКИ СИГНАЛОВ И ВИЗУАЛ
// ====================================================================================================================
grp_sig         = "4. Настройки Сигнала и Визуал"
en_sig_labels   = input.bool(true,    "Показывать ярлыки BUY/SELL",          group=grp_sig)
en_info_block   = input.bool(true,    "Показывать Инфоблок (чек-лист)",      group=grp_sig)
sig_lookback    = input.int(3,        "Блокировка повтора", minval=0, maxval=20, group=grp_sig)
bos_bars_ok     = input.int(3,        "BOS окно подтверждения (баров)", minval=1, maxval=20, group=grp_sig)
sig_text_size   = input.string("normal","Размер текста BUY/SELL", options=["auto","tiny","small","normal","large","huge"], group=grp_sig)
sig_text_col    = input.color(color.white,"Цвет текста BUY/SELL",            group=grp_sig)
sig_bg_buy_col  = input.color(color.new(#089981,15),"Фон BUY сигнала",       group=grp_sig)
sig_bg_sell_col = input.color(color.new(#f23645,15),"Фон SELL сигнала",      group=grp_sig)
info_gap        = input.float(0.4,    "Дистанция Инфоблока (ATR)", minval=0.1, step=0.1, group=grp_sig)
info_text_size  = input.string("tiny","Размер текста Инфоблока", options=["auto","tiny","small","normal","large","huge"], group=grp_sig)
info_align      = input.string("Left","Расположение текста Инфоблока", options=["Left","Center","Right"], group=grp_sig)
info_text_col   = input.color(color.white,              "Цвет текста Инфоблока", group=grp_sig)
info_bg_col     = input.color(color.new(color.gray,80),"Фон Инфоблока",       group=grp_sig)
en_bg_trend     = input.bool(false,   "Фон графика по тренду",               group=grp_sig)
bg_bull_col     = input.color(color.new(#089981,95),"Фон Бычий",             group=grp_sig)
bg_bear_col     = input.color(color.new(#f23645,95),"Фон Медвежий",          group=grp_sig)

// ====================================================================================================================
// 5. MTF КАСКАД (Живой Светофор)
// ====================================================================================================================
grp_mtf       = "5. MTF Каскад (Живой Светофор)"
mtf_tv_1      = input.timeframe("1", "LTF1 ТФ (совпадает с Main P1)",        group=grp_mtf, tooltip="Должен точно совпадать с LTF1 ТФ в Main P1")
mtf_tv_2      = input.timeframe("3", "LTF2 ТФ (совпадает с Main P1)",        group=grp_mtf, tooltip="Должен точно совпадать с LTF2 ТФ в Main P1")
mtf_tv_3      = input.timeframe("5", "LTF3 ТФ (совпадает с Main P1)",        group=grp_mtf, tooltip="Должен точно совпадать с LTF3 ТФ в Main P1")
htf_tv_1      = input.timeframe("60",  "HTF1 ТФ (совпадает с Main P1)",      group=grp_mtf, tooltip="Должен точно совпадать с HTF1 ТФ в Main P1")
htf_tv_2      = input.timeframe("240", "HTF2 ТФ (совпадает с Main P1)",      group=grp_mtf, tooltip="Должен точно совпадать с HTF2 ТФ в Main P1")
htf_tv_3      = input.timeframe("D",   "HTF3 ТФ (совпадает с Main P1)",      group=grp_mtf, tooltip="Должен точно совпадать с HTF3 ТФ в Main P1")

// ── P2 осцилляторный движок — пороги для подтверждения тира ─────────────────
grp_p2_osc    = "5.1 P2 Осцилляторный движок (подтверждение тира)"
p2_rsi_bull_lo  = input.int(45, "RSI бычий: от",  minval=1, maxval=99,  group=grp_p2_osc)
p2_rsi_bull_hi  = input.int(75, "RSI бычий: до",  minval=1, maxval=99,  group=grp_p2_osc)
p2_rsi_bear_lo  = input.int(25, "RSI медвежий: от", minval=1, maxval=99, group=grp_p2_osc)
p2_rsi_bear_hi  = input.int(55, "RSI медвежий: до", minval=1, maxval=99, group=grp_p2_osc)
p2_rsi_len      = input.int(14, "RSI Length",      minval=2,             group=grp_p2_osc)
p2_macd_fast    = input.int(12, "MACD Fast",       minval=2,             group=grp_p2_osc)
p2_macd_slow    = input.int(26, "MACD Slow",       minval=2,             group=grp_p2_osc)
p2_macd_signal  = input.int(9,  "MACD Signal",     minval=1,             group=grp_p2_osc)
p2_ema_fast_len = input.int(8,  "EMA Fast Length", minval=2,             group=grp_p2_osc)
p2_ema_slow_len = input.int(21, "EMA Slow Length", minval=2,             group=grp_p2_osc)
p2_zscore_len   = input.int(21, "Z-Score Length",  minval=5,             group=grp_p2_osc)
p2_osc_min_ok   = input.int(2,  "Мин. подтверждений из 4 (OSC OK)", minval=1, maxval=4, group=grp_p2_osc, tooltip="Сколько из 4 осцилляторов (RSI, MACD, EMA, Z-Score) должны подтвердить тир")

// ── Пороги каскада ───────────────────────────────────────────────────────────
mtf_window    = input.int(5, "Окно каскада LTF (баров)", minval=1, maxval=20,  group=grp_mtf)
htf_window    = input.int(3, "Окно каскада HTF (баров)", minval=1, maxval=10,  group=grp_mtf)
ltf_gate_min  = input.int(2, "Мин. LTF тиров для сигнала (0=откл.)", minval=0, maxval=3, group=grp_mtf)
htf_gate_min  = input.int(2, "Мин. HTF тиров для сигнала (0=откл.)", minval=0, maxval=3, group=grp_mtf)

// ── Визуал светофора ─────────────────────────────────────────────────────────
en_live_lbl   = input.bool(true,  "Показывать живой светофор",                group=grp_mtf)
live_lbl_gap  = input.float(1.2,  "Дистанция светофора (ATR)", step=0.1, minval=0.5, group=grp_mtf)
live_text_size= input.string("small","Размер текста светофора", options=["tiny","small","normal","large","huge"], group=grp_mtf)
live_text_col = input.color(color.white, "Цвет текста светофора",             group=grp_mtf)
live_bg_bull  = input.color(color.new(#1565C0, 10), "Фон светофора (бычий)",  group=grp_mtf)
live_bg_bear  = input.color(color.new(#b71c1c, 10), "Фон светофора (медвежий)", group=grp_mtf)
live_bg_warn  = input.color(color.new(color.orange, 10), "Фон светофора (ожидание)", group=grp_mtf)
live_bg_neut  = input.color(color.new(color.gray, 20),   "Фон светофора (нейтраль)", group=grp_mtf)

// ====================================================================================================================
// 6. КОНСТРУКТОР СИГНАЛОВ (СКОРИНГ)
// ====================================================================================================================
grp_score     = "6. Конструктор сигналов (Скоринг)"
req_score     = input.int(4,  "Целевой порог:", minval=1, maxval=35,          group=grp_score)

s_rsi_kde  = input.bool(true,"Учет: KDE RSI",        inline="rsi_kde",  group=grp_score), m_rsi_kde  = input.bool(false,"Обязат.",inline="rsi_kde",  group=grp_score)
s_stoch    = input.bool(true,"Учет: Stoch Z",         inline="stc",      group=grp_score), m_stoch    = input.bool(false,"Обязат.",inline="stc",      group=grp_score)
s_macd_dlx = input.bool(true,"Учет: MACD Dlx",        inline="mac2",     group=grp_score), m_macd_dlx = input.bool(false,"Обязат.",inline="mac2",     group=grp_score)
s_cci      = input.bool(true,"Учет: Advanced CCI",    inline="cci",      group=grp_score), m_cci      = input.bool(false,"Обязат.",inline="cci",      group=grp_score)
