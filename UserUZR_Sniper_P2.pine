// ── Таймфреймы в минутах из P1 ───────────────────────────────────────────────
float p1_ltf1_tf_mins = is_conn(p1_ltf1_tf_mins_src) ? p1_ltf1_tf_mins_src : na
float p1_ltf2_tf_mins = is_conn(p1_ltf2_tf_mins_src) ? p1_ltf2_tf_mins_src : na
