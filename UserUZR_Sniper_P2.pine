float p1_fvg_bot      = is_conn(p1_fvg_bot_src)        ? p1_fvg_bot_src        : na
float p1_hm_vol       = is_conn(p1_hm_vol_src)         ? p1_hm_vol_src         : 0.0
float p1_choch_lvl    = is_conn(p1_choch_lvl_src)      ? p1_choch_lvl_src      : na
float p1_avwap        = is_conn(p1_avwap_src)          ? p1_avwap_src          : na
float p1_avwap_fast   = is_conn(p1_avwap_fast_src)     ? p1_avwap_fast_src     : na
int   p1_disp         = is_conn(p1_disp_src)           ? int(p1_disp_src)      : 0
float p1_bull_prox    = is_conn(p1_bull_prox_src)      ? p1_bull_prox_src      : na
float p1_bear_prox    = is_conn(p1_bear_prox_src)      ? p1_bear_prox_src      : na
