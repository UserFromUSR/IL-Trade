int   p1_htf3_ss      = is_conn(p1_htf3_score_bear_src) ? int(p1_htf3_score_bear_src) : 0
// ── Пороги из P1 ─────────────────────────────────────────────────────────────
int   p1_ltf1_min     = is_conn(p1_ltf1_min_src) ? int(p1_ltf1_min_src) : 6
int   p1_ltf2_min     = is_conn(p1_ltf2_min_src) ? int(p1_ltf2_min_src) : 6
