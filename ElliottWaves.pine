//@version=6
indicator("UserUZR Elliote Waves Auto-Detect Engine v1", overlay=true, max_bars_back=5000)

// ================================================================
// SECTION 1 — INPUTS
// ================================================================
grpMethod   = "Метод определения пивотов"
