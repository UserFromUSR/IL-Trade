var array<float> KDEHighX = array.new<float>(), var array<float> KDEHighY = array.new<float>(), var array<float> KDEHighYSum = array.new<float>()
var array<float> KDELowX  = array.new<float>(), var array<float> KDELowY  = array.new<float>(), var array<float> KDELowYSum  = array.new<float>()
var bool in_kde_bull = false, var bool in_kde_bear = false

if en_mod_kde
    kde_rsi := ta.rsi(close, kde_rsi_len)
    float kde_hp = ta.pivothigh(high, kde_piv_len, kde_piv_len)
    float kde_lp = ta.pivotlow(low,  kde_piv_len, kde_piv_len)
    float lowProb = 0.0, float highProb = 0.0

    if not na(kde_hp)
        if highPivotRSIs.size() > 300
            highPivotRSIs.remove(0)
        highPivotRSIs.push(kde_rsi[kde_piv_len])
        [kx, ky] = f_kde(highPivotRSIs, kde_kernel, kde_bandw, kde_steps)
        KDEHighX := kx, KDEHighY := ky
        KDEHighYSum.clear()
        float tH = 0.0
        for i = 0 to KDEHighY.size() - 1
            tH += KDEHighY.get(i), KDEHighYSum.push(tH)

    if not na(kde_lp)
        if lowPivotRSIs.size() > 300
            lowPivotRSIs.remove(0)
        lowPivotRSIs.push(kde_rsi[kde_piv_len])
        [lx, ly] = f_kde(lowPivotRSIs, kde_kernel, kde_bandw, kde_steps)
        KDELowX := lx, KDELowY := ly
        KDELowYSum.clear()
        float tL = 0.0
        for i = 0 to KDELowY.size() - 1
            tL += KDELowY.get(i), KDELowYSum.push(tL)

    if highPivotRSIs.size() > 0 and KDEHighX.size() > 0
        int search_L = array.binary_search_leftmost(KDEHighX, kde_rsi)
        int search_R = array.binary_search_rightmost(KDEHighX, kde_rsi)
        int highXIndexL = math.max(0, math.min(search_L, KDEHighX.size() - 1))
        int highXIndexR = math.max(0, math.min(search_R, KDEHighX.size() - 1))
        nearestIdxH = (math.abs(kde_rsi - KDEHighX.get(highXIndexL)) < math.abs(kde_rsi - KDEHighX.get(highXIndexR))) ? highXIndexL : highXIndexR
        highProb := f_prefixSum(KDEHighYSum, 0, nearestIdxH)

    if lowPivotRSIs.size() > 0 and KDELowX.size() > 0
        int search_L = array.binary_search_leftmost(KDELowX, kde_rsi)
        int search_R = array.binary_search_rightmost(KDELowX, kde_rsi)
        int lowXIndexL = math.max(0, math.min(search_L, KDELowX.size() - 1))
        int lowXIndexR = math.max(0, math.min(search_R, KDELowX.size() - 1))
        nearestIdxL = (math.abs(kde_rsi - KDELowX.get(lowXIndexL)) < math.abs(kde_rsi - KDELowX.get(lowXIndexR))) ? lowXIndexL : lowXIndexR
        lowProb := f_prefixSum(KDELowYSum, nearestIdxL, KDELowYSum.size() - 1)

    float act_thresh = kde_thresh == "High" ? 0.4 : kde_thresh == "Medium" ? 0.25 : 0.15
    bool curr_in_kde_bull = KDELowY.size()  > 0 and lowProb  > array.get(KDELowYSum,  KDELowYSum.size()  - 1) * (1.0 - act_thresh)
    bool curr_in_kde_bear = KDEHighY.size() > 0 and highProb > array.get(KDEHighYSum, KDEHighYSum.size() - 1) * (1.0 - act_thresh)
    osc_kde_bull := not curr_in_kde_bull and in_kde_bull
    osc_kde_bear := not curr_in_kde_bear and in_kde_bear
    in_kde_bull  := curr_in_kde_bull
    in_kde_bear  := curr_in_kde_bear

