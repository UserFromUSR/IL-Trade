if en_mod_smidx
    float safe_pvi  = nz(ta.pvi, 1.0), float safe_nvi = nz(ta.nvi, 1.0)
    float sm_dumb   = safe_pvi - ta.ema(safe_pvi, 255)
    float sm_smart  = safe_nvi - ta.ema(safe_nvi, 255)
    float sm_drsi   = ta.rsi(sm_dumb,  sm_idx_rr), float sm_srsi = ta.rsi(sm_smart, sm_idx_rr)
    float drsi_safe     = sm_drsi == 0 ? 1e-10 : sm_drsi
    float drsi_inv_safe = (100.0 - sm_drsi) == 0 ? 1e-10 : (100.0 - sm_drsi)
    float sm_r_buy  = sm_srsi / drsi_safe
    float sm_r_sell = (100.0 - sm_srsi) / drsi_inv_safe
    float sm_sums_buy  = math.sum(sm_r_buy,  sm_idx_x)
    float sm_sums_sell = math.sum(sm_r_sell, sm_idx_x)
    float sm_peak      = ta.highest(math.max(sm_sums_buy, sm_sums_sell), sm_idx_peak)
    float sm_peak_safe = sm_peak == 0 ? 1e-10 : sm_peak

    sm_net_index := (sm_sums_buy / sm_peak_safe) - (sm_sums_sell / sm_peak_safe)

    if sm_idx_strict
        sm_idx_bull := ta.crossover(sm_net_index,  sm_idx_thr)
        sm_idx_bear := ta.crossunder(sm_net_index, -sm_idx_thr)
    else
        sm_idx_bull := sm_net_index >  sm_idx_thr and sm_net_index > nz(sm_net_index[1])
        sm_idx_bear := sm_net_index < -sm_idx_thr and sm_net_index < nz(sm_net_index[1])

