// ИЗОЛИРОВАННЫЙ МОДУЛЬ 2.5: SMART MONEY VOLUME ACTIVITY (+ CVD & ABSORPTION)
// ====================================================================================================================
bool sm_act_bull = false, bool sm_act_bear = false
var array<float> sm_vols = array.new<float>()

var float cvd = 0.0
var array<float> cvd_hist_arr = array.new<float>()
bool cvd_bull_div  = false, bool cvd_bear_div = false
bool sm_absorption = false

if en_mod_smact
    float[] lt_v    = global_lt_v
    float[] lt_c    = global_lt_c
    float[] lt_o    = global_lt_o
    int res_size    = array.size(lt_v)
    int sm_maximum  = sm_act_zlen * math.max(1, res_size)

    if res_size > 0
        float bar_cvd    = 0.0
        float max_bull_vol = 0.0, float max_bear_vol = 0.0
        for i = 0 to res_size - 1
            float v = array.get(lt_v, i), c = array.get(lt_c, i), o = array.get(lt_o, i)
            if c > o
                bar_cvd      += v
                max_bull_vol := math.max(max_bull_vol, v)
            else if c < o
                bar_cvd      -= v
                max_bear_vol := math.max(max_bear_vol, v)

        array.unshift(cvd_hist_arr, bar_cvd)
        if array.size(cvd_hist_arr) > 50
            array.pop(cvd_hist_arr)
        cvd := array.sum(cvd_hist_arr)

        if max_bull_vol > (ta.sma(volume, 50) * 0.5) and max_bear_vol > (ta.sma(volume, 50) * 0.5)
            sm_absorption := true
        cvd_bull_div := close < ta.sma(close, 10) and cvd > ta.sma(cvd, 10)
        cvd_bear_div := close > ta.sma(close, 10) and cvd < ta.sma(cvd, 10)

        for i = res_size - 1 to 0
            array.unshift(sm_vols, array.get(lt_v, i))
        while array.size(sm_vols) > sm_maximum
            array.pop(sm_vols)

        float volsAvg   = array.avg(sm_vols)
        float volsStdev = array.stdev(sm_vols)

        if volsStdev > 0
            float max_z  = 0.0
            int   max_idx = -1
            for i = 0 to res_size - 1
                float evtVol    = array.get(lt_v, i)
                float act_zscore = (evtVol - volsAvg) / volsStdev
                if act_zscore > max_z
                    max_z   := act_zscore
                    max_idx := i

            if max_z > sm_act_th and max_idx != -1
                float intra_close = array.get(lt_c, max_idx)
                float intra_open  = array.get(lt_o, max_idx)
                bool  isBull      = intra_close > intra_open
                float bodyMin     = math.min(open, close)
                float bodyMax     = math.max(open, close)

                bool isAtClose       = math.abs(intra_close - close) < syminfo.mintick
                bool isStrictInBody  = intra_close > bodyMin and intra_close < bodyMax
                bool isNearBody      = intra_close >= bodyMin * 0.995 and intra_close <= bodyMax * 1.005

                bool cls2 = isAtClose or isStrictInBody
                bool cls1 = isNearBody and not cls2

                if cls2
                    if isBull
                        sm_act_bull := true
                    else
                        sm_act_bear := true
                else if cls1 and max_z > sm_act_th * 1.3
                    if isBull
                        sm_act_bull := true
                    else
                        sm_act_bear := true

