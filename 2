bool chk_reg = mdiv_type == "Regular" or mdiv_type == "Regular/Hidden"
bool chk_hid = mdiv_type == "Hidden"  or mdiv_type == "Regular/Hidden"

f_check_pos_div(series float src, int cond_type) =>
    int div_found = 0
    if src > src[1] or close > close[1]
        for x = 0 to 9
            int len = bar_index - array.get(mdiv_pl_pos, x) + mdiv_prd
            if array.get(mdiv_pl_pos, x) == 0 or len > mdiv_maxb
                break
            if len > 5
                bool cond1 = (cond_type == 1 and src[1] > src[len] and close[1] < array.get(mdiv_pl_val, x))
                bool cond2 = (cond_type == 2 and src[1] < src[len] and close[1] > array.get(mdiv_pl_val, x))
                if cond1 or cond2
                    float slope1 = (src[1] - src[len]) / (len - 1), float vline1 = src[1] - slope1
                    float slope2 = (close[1] - close[len]) / (len - 1), float vline2 = close[1] - slope2
                    bool arrived = true
                    for y = 2 to len - 1
                        if src[y] < vline1 or close[y] < vline2
                            arrived := false
                            break
                        vline1 -= slope1, vline2 -= slope2
                    if arrived
                        div_found := 1
                        break
    div_found

f_check_neg_div(series float src, int cond_type) =>
    int div_found = 0
    if src < src[1] or close < close[1]
        for x = 0 to 9
            int len = bar_index - array.get(mdiv_ph_pos, x) + mdiv_prd
            if array.get(mdiv_ph_pos, x) == 0 or len > mdiv_maxb
                break
            if len > 5
                bool cond1 = (cond_type == 1 and src[1] < src[len] and close[1] > array.get(mdiv_ph_val, x))
                bool cond2 = (cond_type == 2 and src[1] > src[len] and close[1] < array.get(mdiv_ph_val, x))
                if cond1 or cond2
                    float slope1 = (src[1] - src[len]) / (len - 1), float vline1 = src[1] - slope1
                    float slope2 = (close[1] - close[len]) / (len - 1), float vline2 = close[1] - slope2
                    bool arrived = true
                    for y = 2 to len - 1
                        if src[y] > vline1 or close[y] > vline2
                            arrived := false
                            break
                        vline1 -= slope1, vline2 -= slope2
                    if arrived
                        div_found := 1
                        break
    div_found

f_add_div(series float src, bool en) =>
    int reg_pos = f_check_pos_div(src, 1)
    int reg_neg = f_check_neg_div(src, 1)
    int hid_pos = f_check_pos_div(src, 2)
    int hid_neg = f_check_neg_div(src, 2)
    int b = 0, int br = 0
    if en
        if chk_reg
            b  += reg_pos
            br += reg_neg
        if chk_hid
            b  += hid_pos
            br += hid_neg
    [b, br]

if en_mod_mdiv
    float mdiv_ph = ta.pivothigh(close, mdiv_prd, mdiv_prd)
    float mdiv_pl = ta.pivotlow(close,  mdiv_prd, mdiv_prd)
    if not na(mdiv_ph)
        array.unshift(mdiv_ph_pos, bar_index), array.unshift(mdiv_ph_val, mdiv_ph), array.pop(mdiv_ph_pos), array.pop(mdiv_ph_val)
    if not na(mdiv_pl)
        array.unshift(mdiv_pl_pos, bar_index), array.unshift(mdiv_pl_val, mdiv_pl), array.pop(mdiv_pl_pos), array.pop(mdiv_pl_val)

    [b1, br1]   = f_add_div(g_rsi,   true), [b2,  br2]  = f_add_div(g_macdL, true), [b3,  br3]  = f_add_div(g_macdH, true)
    [b4, br4]   = f_add_div(g_stc,   true), [b5,  br5]  = f_add_div(g_cci,   true), [b6,  br6]  = f_add_div(g_mom,   true)
    [b7, br7]   = f_add_div(g_obv,   true), [b8,  br8]  = f_add_div(g_vwm,   true), [b9,  br9]  = f_add_div(g_cmf,   true)
    [b10, br10] = f_add_div(g_mfi,   true)

    total_mdiv_bull := b1+b2+b3+b4+b5+b6+b7+b8+b9+b10
    total_mdiv_bear := br1+br2+br3+br4+br5+br6+br7+br8+br9+br10
    osc_mdiv_bull   := total_mdiv_bull >= mdiv_limit
    osc_mdiv_bear   := total_mdiv_bear >= mdiv_limit

// ====================================================================================================================
// ИЗОЛИРОВАННЫЙ МОДУЛЬ 2.9: MULTI-DIV (PeterO NON-REPAINT)
// ====================================================================================================================
bool osc_peter_bull = false, bool osc_peter_bear = false

f_petero_div(series float _osc, int _lbL, int _lbR, int _rL, int _rU) =>
    bool pl_found = not na(ta.pivotlow(_osc,  _lbL, _lbR))
    bool ph_found = not na(ta.pivothigh(_osc, _lbL, _lbR))

    float osc_prev_l = ta.valuewhen(pl_found, _osc[_lbR],  1), float prc_prev_l = ta.valuewhen(pl_found, low[_lbR],  1)
    float osc_prev_h = ta.valuewhen(ph_found, _osc[_lbR],  1), float prc_prev_h = ta.valuewhen(ph_found, high[_lbR], 1)

    int l_bars_since = ta.barssince(pl_found[1]), int h_bars_since = ta.barssince(ph_found[1])
    bool l_in_rng = l_bars_since >= _rL and l_bars_since <= _rU
    bool h_in_rng = h_bars_since >= _rL and h_bars_since <= _rU

    int b_reg = (low[_lbR]  < prc_prev_l and _osc[_lbR] > osc_prev_l and l_in_rng and pl_found) ? 1 : 0
    int b_hid = (low[_lbR]  > prc_prev_l and _osc[_lbR] < osc_prev_l and l_in_rng and pl_found) ? 1 : 0
    int s_reg = (high[_lbR] > prc_prev_h and _osc[_lbR] < osc_prev_h and h_in_rng and ph_found) ? 1 : 0
    int s_hid = (high[_lbR] < prc_prev_h and _osc[_lbR] > osc_prev_h and h_in_rng and ph_found) ? 1 : 0

    [b_reg + b_hid, s_reg + s_hid]

if en_mod_peter
    int pt_b = 0, int pt_s = 0
    [b1,  s1]  = f_petero_div(g_rsi,     peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b += b1,  pt_s += s1
    [b2,  s2]  = f_petero_div(g_macdL,   peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b += b2,  pt_s += s2
    [b3,  s3]  = f_petero_div(g_macdH,   peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b += b3,  pt_s += s3
    [b4,  s4]  = f_petero_div(g_mom,     peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b += b4,  pt_s += s4
    [b5,  s5]  = f_petero_div(g_cci,     peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b += b5,  pt_s += s5
    [b6,  s6]  = f_petero_div(g_p_obv,   peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b += b6,  pt_s += s6
    [b7,  s7]  = f_petero_div(g_stc,     peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b += b7,  pt_s += s7
    [b8,  s8]  = f_petero_div(g_p_diosc, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b += b8,  pt_s += s8
    [b9,  s9]  = f_petero_div(g_vwm,     peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b += b9,  pt_s += s9
    [b10, s10] = f_petero_div(g_cmf,     peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b += b10, pt_s += s10

    osc_peter_bull := pt_b >= peter_limit
    osc_peter_bear := pt_s >= peter_limit

// ====================================================================================================================
// ИЗОЛИРОВАННЫЙ МОДУЛЬ 3.0: TRADINGFINDER FRACTAL DIV
// ====================================================================================================================
bool osc_tfdiv_bull = false, bool osc_tfdiv_bear = false

float tf_aoH  = ta.sma(hl2, 5) - ta.sma(hl2, 34)
float tf_rsiH = ta.rsi(close, 14) - 50
float tf_hist = tfdiv_type == "MACD" ? g_macdH : tfdiv_type == "AO" ? tf_aoH : tf_rsiH

float tf_ema     = ta.ema(close, 50)
bool  tf_up_trend = close[tfdiv_n] > tf_ema, bool tf_dn_trend = close[tfdiv_n] < tf_ema
bool  tf_up_frac  = not na(ta.pivothigh(tfdiv_n, tfdiv_n)) and tf_up_trend
bool  tf_dn_frac  = not na(ta.pivotlow(tfdiv_n,  tfdiv_n)) and tf_dn_trend

float t_h_last_prc = ta.valuewhen(tf_up_frac, high[tfdiv_n],    0)
float t_h_prev_prc = ta.valuewhen(tf_up_frac, high[tfdiv_n],    1)
float t_h_last_hst = ta.valuewhen(tf_up_frac, tf_hist[tfdiv_n], 0)
float t_h_prev_hst = ta.valuewhen(tf_up_frac, tf_hist[tfdiv_n], 1)
int   t_h_last_bar = ta.valuewhen(tf_up_frac, bar_index[tfdiv_n], 0)
int   t_h_prev_bar = ta.valuewhen(tf_up_frac, bar_index[tfdiv_n], 1)

float t_l_last_prc = ta.valuewhen(tf_dn_frac, low[tfdiv_n],     0)
float t_l_prev_prc = ta.valuewhen(tf_dn_frac, low[tfdiv_n],     1)
float t_l_last_hst = ta.valuewhen(tf_dn_frac, tf_hist[tfdiv_n], 0)
float t_l_prev_hst = ta.valuewhen(tf_dn_frac, tf_hist[tfdiv_n], 1)
int   t_l_last_bar = ta.valuewhen(tf_dn_frac, bar_index[tfdiv_n], 0)
int   t_l_prev_bar = ta.valuewhen(tf_dn_frac, bar_index[tfdiv_n], 1)

float change_t_h = ta.change(t_h_last_prc)
float change_t_l = ta.change(t_l_last_prc)

if en_mod_tfdiv
    bool tf_bear_cond    = (t_h_last_hst > 0 and t_h_prev_hst > 0 and (t_h_last_bar + 30 > bar_index) and (t_h_last_bar - t_h_prev_bar < 30))
    bool is_tf_bear_div  = tf_bear_cond and (t_h_last_prc > t_h_prev_prc) and (t_h_last_hst < t_h_prev_hst)
    osc_tfdiv_bear      := change_t_h != 0 and is_tf_bear_div

    bool tf_bull_cond    = (t_l_last_hst < 0 and t_l_prev_hst < 0 and (t_l_last_bar + 30 > bar_index) and (t_l_last_bar - t_l_prev_bar < 30))
    bool is_tf_bull_div  = tf_bull_cond and (t_l_last_prc < t_l_prev_prc) and (t_l_last_hst > t_l_prev_hst)
    osc_tfdiv_bull      := change_t_l != 0 and is_tf_bull_div

// ====================================================================================================================
// ИЗОЛИРОВАННЫЙ МОДУЛЬ 3.1: SMT DIVERGENCES
// ====================================================================================================================
bool osc_smt_bull = false, bool osc_smt_bear = false

f_get_smt_div(bool is_ph, float y2, float sym_y2) =>
    var float y1 = na, var float sym_y1 = na
    var int smt_count    = 0
    var int last_div_bar = 0
    int RESET_BARS = 50

    if bar_index - last_div_bar > RESET_BARS
        smt_count := 0

    if y2 != y2[1] and sym_y2 != sym_y2[1]
        if not na(y1) and not na(sym_y1)
            if (y2 - y1) * (sym_y2 - sym_y1) < 0
                smt_count    += 1
                last_div_bar := bar_index
        sym_y1 := sym_y2
        y1     := y2
    else if (is_ph and y2 > y2[1]) or (not is_ph and y2 < y2[1])
        sym_y1 := na
        y1     := y2
    smt_count

if en_mod_smt
    float smt_ph = fixnan(ta.pivothigh(smt_len, smt_len))
    float smt_pl = fixnan(ta.pivotlow(smt_len,  smt_len))
    float h1 = s_h1, float l1 = s_l1
    float h2 = s_h2, float l2 = s_l2

    float sym_ph1 = fixnan(ta.pivothigh(h1, smt_len, smt_len)), float sym_pl1 = fixnan(ta.pivotlow(l1, smt_len, smt_len))
    float sym_ph2 = fixnan(ta.pivothigh(h2, smt_len, smt_len)), float sym_pl2 = fixnan(ta.pivotlow(l2, smt_len, smt_len))
    int ph_smt1 = f_get_smt_div(true,  smt_ph, sym_ph1), int pl_smt1 = f_get_smt_div(false, smt_pl, sym_pl1)
    int ph_smt2 = f_get_smt_div(true,  smt_ph, sym_ph2), int pl_smt2 = f_get_smt_div(false, smt_pl, sym_pl2)

    if smt_ph != nz(smt_ph[1])
        if (smt_use1 and ph_smt1 > nz(ph_smt1[1])) or (smt_use2 and ph_smt2 > nz(ph_smt2[1]))
            osc_smt_bear := true

    if smt_pl != nz(smt_pl[1])
        if (smt_use1 and pl_smt1 > nz(pl_smt1[1])) or (smt_use2 and pl_smt2 > nz(pl_smt2[1]))
            osc_smt_bull := true

// ====================================================================================================================
// ИЗОЛИРОВАННЫЙ МОДУЛЬ 3.2: LUXALGO CANDLESTICK PATTERNS & TREND FILTER
// ====================================================================================================================
float c_upper = ta.highest(math.max(cndl_minor_len, 1))
float c_lower = ta.lowest(math.max(cndl_minor_len,  1))
var int minor_dir = 0
if high == c_upper and minor_dir != 1
    minor_dir := 1
if low  == c_lower and minor_dir != -1
    minor_dir := -1

var int major_dir = 0
float maj_ema1 = ta.ema(close, math.max(cndl_maj_ema1, 1))
float maj_ema2 = ta.ema(close, math.max(cndl_maj_ema2, 1))
[st_val, st_dir] = ta.supertrend(math.max(cndl_maj_st_f, 0.1), math.max(cndl_maj_st_l, 1))

float maj_dc_upper = ta.highest(math.max(cndl_maj_dc, 1))
float maj_dc_lower = ta.lowest(math.max(cndl_maj_dc,  1))
var int maj_dc_dir = 0
if high == maj_dc_upper and maj_dc_dir != 1
    maj_dc_dir := 1
if low  == maj_dc_lower and maj_dc_dir != -1
    maj_dc_dir := -1

var int os = 0
float choch_upper = ta.highest(math.max(cndl_maj_swing, 2))
float choch_lower = ta.lowest(math.max(cndl_maj_swing,  2))
os := high[math.max(cndl_maj_swing, 2)] > choch_upper ? 0 : low[math.max(cndl_maj_swing, 2)] < choch_lower ? 1 : nz(os[1])
float c_top_choch = os == 0 and nz(os[1]) != 0 ? high[math.max(cndl_maj_swing, 2)] : na
float c_btm_choch = os == 1 and nz(os[1]) != 1 ? low[math.max(cndl_maj_swing,  2)] : na

var float t_val = na, var float b_val = na
var int t_count = 1,  var int b_count = 1
if not na(c_top_choch)
    t_val := c_top_choch, t_count := 1
if not na(c_btm_choch)
    b_val := c_btm_choch, b_count := 1

bool bull_choch = ta.crossover(close,  t_val) and t_count == 1
bool bear_choch = ta.crossunder(close, b_val) and b_count == 1
var int choch_dir = 0
if bull_choch and choch_dir != 1
    t_count := 0, choch_dir := 1
if bear_choch and choch_dir != -1
    b_count := 0, choch_dir := -1

if cndl_maj_type == "EMA"
    major_dir := maj_ema1 > maj_ema2 ? 1 : -1
else if cndl_maj_type == "SuperTrend"
    major_dir := int(math.sign(st_dir))
else if cndl_maj_type == "Donchian Channel"
    major_dir := maj_dc_dir
else
    major_dir := choch_dir

bool  rc        = close < open
bool  gc        = close > open
float cand_top  = math.max(open, close)
float cand_bot  = math.min(open, close)
float hl_width  = high - low
float bod_width = cand_top - cand_bot
float hw_per    = hl_width == 0 ? 0 : ((high - cand_top) / hl_width) * 100
float lw_per    = hl_width == 0 ? 0 : ((cand_bot - low)  / hl_width) * 100
float b_per     = hl_width == 0 ? 0 : (bod_width / hl_width) * 100
bool  is_doji   = math.round_to_mintick(close) == math.round_to_mintick(open)

bool is_minor_bear = minor_dir < 0
bool is_minor_bull = minor_dir > 0

bool p_hammer   = lw_per > (b_per*2) and b_per < 50 and hw_per < 2 and not is_doji and is_minor_bear
bool p_ihammer  = hw_per > (b_per*2) and b_per < 50 and lw_per < 2 and not is_doji and is_minor_bear
bool p_rising_3 = gc[4] and b_per[4] > 50 and rc[3] and cand_top[3] <= high[4] and cand_bot[3] >= low[4] and rc[2] and cand_top[2] <= high[4] and cand_bot[2] >= low[4] and rc[1] and cand_top[1] <= high[4] and cand_bot[1] >= low[4] and gc and close > high[4] and b_per > 50 and is_minor_bull[4]
bool p_bull_eng = rc[1] and gc and bod_width > (bod_width[1]/2) and open < close[1] and cand_top > cand_top[1] and not p_rising_3 and not is_doji[1] and is_minor_bear
bool p_3ws      = gc[2] and b_per[2]>70 and gc[1] and b_per[1]>70 and cand_bot[1] >= cand_bot[2] and cand_bot[1] <= cand_top[2] and close[1] > high[2] and gc and b_per>70 and cand_bot >= cand_bot[1] and cand_bot <= cand_top[1] and close > high[1] and is_minor_bear[2]
bool p_mstar    = rc[2] and b_per[2] > 80 and rc[1] and bod_width[1] < (bod_width[2]/2) and open[1] < close[2] and gc and close > hl2[2] and is_minor_bear[2]
bool p_bull_har = gc and high <= cand_top[1] and low >= cand_bot[1] and rc[1] and is_minor_bear[1]
bool p_tw_bot   = math.round_to_mintick(low) == math.round_to_mintick(low[1]) and gc and rc[1] and is_minor_bear[1]

bool p_sstar    = hw_per > (b_per*2) and b_per < 50 and lw_per < 2 and not is_doji and is_minor_bull
bool p_hman     = lw_per > (b_per*2) and b_per < 50 and hw_per < 2 and not is_doji and is_minor_bull
bool p_falling_3= rc[4] and b_per[4] > 50 and gc[3] and cand_top[3] <= high[4] and cand_bot[3] >= low[4] and gc[2] and cand_top[2] <= high[4] and cand_bot[2] >= low[4] and gc[1] and cand_top[1] <= high[4] and cand_bot[1] >= low[4] and rc and close < low[4] and b_per > 50 and is_minor_bear[4]
bool p_bear_eng = gc[1] and rc and bod_width > (bod_width[1]/2) and open > close[1] and cand_bot < cand_bot[1] and not p_falling_3 and not is_doji[1] and is_minor_bull
bool p_3bc      = rc[2] and b_per[2]>70 and rc[1] and b_per[1]>70 and cand_top[1] <= cand_top[2] and cand_top[1] >= cand_bot[2] and close[1] < low[2] and rc and b_per>70 and cand_top <= cand_top[1] and cand_top >= cand_bot[1] and close < low[1] and is_minor_bull[2]
bool p_estar    = gc[2] and b_per[2] > 80 and gc[1] and bod_width[1] < (bod_width[2]/2) and open[1] > close[2] and rc and close < hl2[2] and is_minor_bull[2]
bool p_bear_har = rc and high <= cand_top[1] and low >= cand_bot[1] and gc[1] and is_minor_bull[1]
bool p_tw_top   = math.round_to_mintick(high) == math.round_to_mintick(high[1]) and rc and gc[1] and is_minor_bull[1]

bool is_major_bull = not en_cndl_trend or major_dir > 0
bool is_major_bear = not en_cndl_trend or major_dir < 0

bool   cndl_bull = false, bool cndl_bear = false, bool is_neutral = false
string cndl_name = ""

if en_mod_cndl
    if en_hammer   and p_hammer   and is_major_bull
        cndl_bull := true, cndl_name := "Молот"
    else if en_ihammer  and p_ihammer  and is_major_bull
        cndl_bull := true, cndl_name := "Пер. Молот"
    else if en_bull_eng and p_bull_eng and is_major_bull
        cndl_bull := true, cndl_name := "Быч. Поглощение"
    else if en_r3       and p_rising_3 and is_major_bull
        cndl_bull := true, cndl_name := "Метод 3 Подн."
    else if en_3ws      and p_3ws      and is_major_bull
        cndl_bull := true, cndl_name := "3 Белых Солдата"
    else if en_mstar    and p_mstar    and is_major_bull
        cndl_bull := true, cndl_name := "Утренняя Звезда"
    else if en_bull_har and p_bull_har and is_major_bull
        cndl_bull := true, cndl_name := "Бычье Харами"
    else if en_tw_bot   and p_tw_bot   and is_major_bull
        cndl_bull := true, cndl_name := "Пинцет Дно"

    if en_sstar    and p_sstar    and is_major_bear
        cndl_bear := true, cndl_name := "Падающая Звезда"
    else if en_hman     and p_hman     and is_major_bear
        cndl_bear := true, cndl_name := "Повешенный"
    else if en_bear_eng and p_bear_eng and is_major_bear
        cndl_bear := true, cndl_name := "Медв. Поглощение"
    else if en_f3       and p_falling_3 and is_major_bear
        cndl_bear := true, cndl_name := "Метод 3 Пад."
    else if en_3bc      and p_3bc      and is_major_bear
        cndl_bear := true, cndl_name := "3 Черные Вороны"
    else if en_estar    and p_estar    and is_major_bear
        cndl_bear := true, cndl_name := "Вечерняя Звезда"
    else if en_bear_har and p_bear_har and is_major_bear
        cndl_bear := true, cndl_name := "Медв. Харами"
    else if en_tw_top   and p_tw_top   and is_major_bear
        cndl_bear := true, cndl_name := "Пинцет Вершина"

    if en_doji and is_doji and not cndl_bull and not cndl_bear
        is_neutral := true, cndl_name := "Doji (Нейтраль)"

plotshape(en_mod_cndl and cndl_show_lbl and cndl_bull, title="Бычий паттерн",    style=shape.triangleup,   location=location.belowbar, color=cndl_bull_col, text="", size=size.tiny)
if en_mod_cndl and cndl_show_lbl and cndl_bull
    label.new(bar_index, low  - g_cndl_atr*0.2, text=cndl_name, style=label.style_label_up,   color=color.new(color.white, 100), textcolor=cndl_bull_col, size=get_size(cndl_lbl_size))

plotshape(en_mod_cndl and cndl_show_lbl and cndl_bear, title="Медвежий паттерн", style=shape.triangledown, location=location.abovebar, color=cndl_bear_col, text="", size=size.tiny)
if en_mod_cndl and cndl_show_lbl and cndl_bear
    label.new(bar_index, high + g_cndl_atr*0.2, text=cndl_name, style=label.style_label_down, color=color.new(color.white, 100), textcolor=cndl_bear_col, size=get_size(cndl_lbl_size))

plotshape(en_mod_cndl and cndl_show_lbl and is_neutral, title="Нейтральный паттерн", style=shape.xcross, location=location.abovebar, color=cndl_neut_col, text="", size=size.tiny)
if en_mod_cndl and cndl_show_lbl and is_neutral
    label.new(bar_index, high + g_cndl_atr*0.2, text=cndl_name, style=label.style_label_down, color=color.new(color.white, 100), textcolor=cndl_neut_col, size=get_size(cndl_lbl_size))

barcolor(en_mod_cndl and cndl_bar_col ? (cndl_bull ? cndl_bull_col : cndl_bear ? cndl_bear_col : is_neutral ? cndl_neut_col : na) : na)

// ====================================================================================================================
// СТРУКТУРА P1 И БАЗОВАЯ ЛОГИКА (+ ИНТЕГРАЦИЯ TRUE OTE)
// ====================================================================================================================
bool b_smc_bull = smc_conn ? p1_smc_trend ==  1 : false, bool b_smc_bear = smc_conn ? p1_smc_trend == -1 : false
bool b_ob_bull  = ob_conn  ? p1_ob_signal ==  1 : false, bool b_ob_bear  = ob_conn  ? p1_ob_signal == -1 : false
bool b_sd_bull  = sd_conn  ? p1_sd_zone   ==  1 : false, bool b_sd_bear  = sd_conn  ? p1_sd_zone   == -1 : false
bool b_fvg_bull = fvg_conn ? p1_fvg_dir   ==  1 : false, bool b_fvg_bear = fvg_conn ? p1_fvg_dir   == -1 : false
bool b_bos_bull = bos_conn ? (bars_since_bos <= bos_bars_ok and p1_smc_trend ==  1) : false
bool b_bos_bear = bos_conn ? (bars_since_bos <= bos_bars_ok and p1_smc_trend == -1) : false

bool b_bb_bull    = p1_bb_signal    ==  1, bool b_bb_bear    = p1_bb_signal    == -1
bool b_hm_bull    = p1_hm_signal    ==  1, bool b_hm_bear    = p1_hm_signal    == -1
