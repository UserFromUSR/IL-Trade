// --- ИНТЕГРАЦИЯ TRUE OTE (FIBONACCI) ---
var float recent_swing_h = na, var float recent_swing_l = na
if is_conn(p1_choch_src) and (p1_choch_src != 0 or p1_bos_src != 0)
    recent_swing_h := high
    recent_swing_l := low
else
    recent_swing_h := math.max(nz(recent_swing_h, high), high)
    recent_swing_l := math.min(nz(recent_swing_l, low),  low)

float impulse_range  = recent_swing_h - recent_swing_l
float ote_long_top   = recent_swing_h - (impulse_range * 0.618)
float ote_long_bot   = recent_swing_h - (impulse_range * 0.786)
float disc_long_top  = recent_swing_h - (impulse_range * 0.5)

float ote_short_bot  = recent_swing_l + (impulse_range * 0.618)
float ote_short_top  = recent_swing_l + (impulse_range * 0.786)
float prem_short_bot = recent_swing_l + (impulse_range * 0.5)

int ote_score_bull = close <= ote_long_top  and close >= ote_long_bot  ? 2 : close < disc_long_top  ? 1 : 0
int ote_score_bear = close >= ote_short_bot and close <= ote_short_top ? 2 : close > prem_short_bot ? 1 : 0

