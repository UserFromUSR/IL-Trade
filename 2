    float l3_typ_price = (high + low + close) / 3.0
    float l3_avgDev    = ta.dev(l3_typ_price, cci_l3_len)
    float l3_cci_val   = (l3_typ_price - ta.sma(l3_typ_price, cci_l3_len)) / (0.015 * math.max(l3_avgDev, 1e-10))
    float l3_ci_val    = ta.ema(l3_cci_val, cci_l3_ci)

    bool l3_str_buy  = ta.crossover(l3_cci_val,  l3_ci_val) and l3_cci_val < -100
    bool l3_nrm_buy  = ta.crossover(l3_cci_val,  l3_ci_val) and l3_cci_val >= -100 and l3_cci_val < 0
    bool l3_str_sell = ta.crossunder(l3_cci_val, l3_ci_val) and l3_cci_val > 100
    bool l3_nrm_sell = ta.crossunder(l3_cci_val, l3_ci_val) and l3_cci_val <= 100 and l3_cci_val > 0

    bool l3_cci_bull = l3_str_buy  or l3_nrm_buy
    bool l3_cci_bear = l3_str_sell or l3_nrm_sell

