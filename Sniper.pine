p2_ltf2_min_ok_raw = qa_ltf2_min_ok_raw
p2_ltf3_min_ok_raw = qa_ltf3_min_ok_raw
p2_htf1_min_ok_raw = qa_htf1_min_ok_raw
p2_htf2_min_ok_raw = qa_htf2_min_ok_raw
p2_htf3_min_ok_raw = qa_htf3_min_ok_raw

var int[] PR_OSC_OFS_LTF = array.from(-2, 1)
var int[] PR_OSC_OFS_HTF = array.from(-2, 1)

f_pr_osc_ltf(int base) =>
    int result = base
    if preset_idx_p2 >= 0
        result := math.max(1, math.min(10, base + PR_OSC_OFS_LTF.get(preset_idx_p2)))
    result

f_pr_osc_htf(int base) =>
    int result = base
    if preset_idx_p2 >= 0
        result := math.max(1, math.min(10, base + PR_OSC_OFS_HTF.get(preset_idx_p2)))
    result

p2_ltf1_min_ok = f_pr_osc_ltf(p2_ltf1_min_ok_raw)
p2_ltf2_min_ok = f_pr_osc_ltf(p2_ltf2_min_ok_raw)
p2_ltf3_min_ok = f_pr_osc_ltf(p2_ltf3_min_ok_raw)
p2_htf1_min_ok = f_pr_osc_htf(p2_htf1_min_ok_raw)
p2_htf2_min_ok = f_pr_osc_htf(p2_htf2_min_ok_raw)
