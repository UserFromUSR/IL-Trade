tp1_pct = input.float(0.4, "TP1 % от входа", minval=0.01, step=0.05, inline="tp1", group=grp_trade)
tp1_vol = input.float(25.0, "TP1 % объёма", minval=1.0, maxval=100.0, step=1.0, inline="tp1", group=grp_trade)
