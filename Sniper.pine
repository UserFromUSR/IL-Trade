// ====================================================================================================================
// КОНТЕКСТ СЕССИИ И ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
// ====================================================================================================================
f_session_context() =>
    bool asian = not na(time("1440","0000-0900:1234567","UTC"))
    bool london = not na(time("1440","0700-1600:1234567","UTC"))
    bool ny = not na(time("1440","1200-2100:1234567","UTC"))
    bool overlap = london and ny
    string sess = overlap ? "🔥ЛДН+НЙ" : ny ? "🗽НЙ" : london ? "🇬🇧ЛДН" : asian ? "🌏АЗИЯ" : "🌙Закрыто"
    string day = dayofweek==dayofweek.monday?"Пн":dayofweek==dayofweek.tuesday?"Вт":dayofweek==dayofweek.wednesday?"Ср":dayofweek==dayofweek.thursday?"Чт":dayofweek==dayofweek.friday?"Пт":"Вых"
    sess + "│" + day + " " + str.format_time(time, "HH:mm", "UTC") + " UTC"

f_get_align(str) => str == "Left" ? text.align_left : str == "Right" ? text.align_right : text.align_center

f_cap_lines(string txt, int max_lines) =>
    string result = txt
    int newline_count = str.length(txt) - str.length(str.replace_all(txt, "\n", ""))
    if newline_count > max_lines
        string acc = ""
        int cnt = 0
        string remaining = txt
        while cnt < max_lines
            int pos = str.pos(remaining, "\n")
            if na(pos)
                acc += remaining
                cnt := max_lines
            else
                acc += str.substring(remaining, 0, pos+1)
                remaining := str.substring(remaining, pos+1)
                cnt += 1
        result := acc + "…[обрезано]"
    result

f_counter_side_summary(bool main_is_bull) =>
    int c_ltf = main_is_bull ? mtf_state_bear : mtf_state_bull
    int c_htf = main_is_bull ? htf_bear_conf : htf_bull_conf
    int c_sc = main_is_bull ? sell_score : buy_score
    string c_dir = main_is_bull ? "ПРОДАЖА" : "ПОКУПКА"
    "⚖️ Противовес(" + c_dir + "): HTF " + str.tostring(c_htf) + "/3│LTF " + str.tostring(c_ltf) + "/3│Скор " + str.tostring(c_sc) + "/" + str.tostring(req_score)

f_consensus_line(bool sig_is_bull) =>
    bool light_lean_bull = consensus_lean_bull
    bool match = sig_is_bull == light_lean_bull
    inc_f67 ? ("🚦 Консенсус со светофором: " + (match ? "✅ Согласован" : "⚠️ Расхождение") + " (светофор клонится: " + (light_lean_bull ? "ПОКУПКА" : "ПРОДАЖА") + ")") : ""

f_score_bar(int cur_s, int req_s) =>
    int filled = math.min(cur_s, req_s)
    string bar_str = ""
    for i = 1 to req_s
        bar_str += i <= filled ? "█" : "░"
    string suffix = cur_s >= req_s ? " ✅ Готово" : " (осталось: " + str.tostring(math.max(0, req_s-cur_s)) + ")"
    "[" + bar_str + "] " + str.tostring(cur_s) + "/" + str.tostring(req_s) + suffix

f_zone_star_rating(side_detail d) =>
    int layers = d.layers
    bool virgin = d.virgin
    bool ob_sd = d.ob_sd
    bool choch_sw = d.choch_sw
    int stars = 0
    if layers >= 3
        stars += 2
    else if layers >= 2
        stars += 1
    if virgin
        stars += 1
    if ob_sd
        stars += 1
    if choch_sw
        stars += 1
    stars := math.min(stars, 5)
    string star_str = ""
    for i = 1 to 5
        star_str += i <= stars ? "⭐" : "☆"
    star_str + " (" + str.tostring(stars) + "/5)"

f_freshness_sorted(side_detail d) =>
    int c_bars = d.chb
    int s_bars = d.swb
    int hm_bars = d.hm_bars
    int di_bars = d.dpb
    int sm_bars = d.sm_bars
    int lvz_bars = d.lvz_bars
    int[] ev_b = array.new<int>()
    string[] ev_n = array.new<string>()
    int THRESH = 12
    if c_bars < THRESH
        ev_b.push(c_bars), ev_n.push("⚡CHoCH")
    if s_bars < THRESH
        ev_b.push(s_bars), ev_n.push("🌊Sweep")
    if hm_bars < THRESH
        ev_b.push(hm_bars), ev_n.push("🔊HM-Sweep")
    if di_bars < THRESH
        ev_b.push(di_bars), ev_n.push("💥Дисплейсмент")
    if sm_bars < THRESH
        ev_b.push(sm_bars), ev_n.push("🐋SM-активность")
    if lvz_bars < THRESH
        ev_b.push(lvz_bars), ev_n.push("⚡ЛВЗ")
    int sz = ev_b.size()
    if sz > 1
        for i = 0 to sz-2
            for j = 0 to sz-2-i
                if ev_b.get(j) > ev_b.get(j+1)
                    int tb = ev_b.get(j)
                    string tn = ev_n.get(j)
                    ev_b.set(j, ev_b.get(j+1))
                    ev_n.set(j, ev_n.get(j+1))
                    ev_b.set(j+1, tb)
                    ev_n.set(j+1, tn)
    string out = ""
    int top_n = math.min(sz-1, 3)
    if sz > 0
        for i = 0 to top_n
            int b = ev_b.get(i)
            string nm = ev_n.get(i)
            string ic = b==0 ? "🔴" : b<=2 ? "🟠" : "🟡"
            out += ic + " " + nm + ": " + str.tostring(b) + " б.назад\n"
    out

// ====================================================================================================================
// ТЕКСТОВЫЕ СЕКЦИИ (ТЗ раздел 4) — исправления по всем пунктам 4.1-4.13
// ====================================================================================================================
f_struct_section(side_detail d, bool is_bull) =>
    string out = ""
    if d.smc
        out += "📍 SMC: " + (is_bull ? "бычья" : "медвежья") + "\n"
    if d.choch_sw
        out += "⚡🌊 CHoCH после Sweep\n"
    if d.bb
        out += "🔗 Брейкер активен\n"
    if d.bos
        out += "🔄 BOS подтверждён\n"
    if d.choch
        out += "⚡ CHoCH активен\n"
    if d.sweep
        out += "🌊 Sweep ликвидности\n"
    bool sweep_ob_this = is_bull ? b_sweep_ob_bull : b_sweep_ob_bear
    if sweep_ob_this and inc_f46
        out += "🌊📦 Sweep+OB\n"
    if d.disp
        out += "💥 Displacement\n"
    bool disp_ob_this = is_bull ? b_disp_ob_bull : b_disp_ob_bear
    if disp_ob_this and inc_f47
        out += "💥📦 Disp+OB\n"
    bool disp_fvg_this = is_bull ? b_disp_fvg_bull : b_disp_fvg_bear
    if disp_fvg_this and inc_f48
        out += "💥📦 Disp+FVG\n"
    if d.avwap_x
        out += "🎯 AVWAP пересечён " + (is_bull ? "вверх" : "вниз") + "\n"
    else if d.avwap
        out += "📌 Цена на стороне AVWAP\n"
    bool ob_avwap_this = is_bull ? b_ob_avwap_bull : b_ob_avwap_bear
    if ob_avwap_this and inc_f49
        out += "📦📌 OB+AVWAP\n"
    if d.virgin
        out += "✨ Девственный OB (каса.:" + str.tostring(d.touches) + ")\n"
    else if d.touches == 1 and inc_f42
        out += "⚠️ OB: 1-е повт.каса.\n"
    else if d.touches > 1
        out += "⚠️ OB каса.раз: " + str.tostring(d.touches) + "\n"
    if d.ob_sd
        out += "🎯 OB в S&D\n"
    if d.bos_retest
        out += d.bos_retest_text + "\n🔄🎯 BOS+Retest\n"
    if d.choch_retest
        out += d.choch_retest_text + "\n⚡🎯 CHoCH+Retest\n"
    bool regime_smc_this = is_bull ? b_regime_smc_bull : b_regime_smc_bear
    if regime_smc_this and inc_f71
        out += "📊📍 Regime+SMC\n"
    if d.struct_fresh
        out += "🏗️ Структ.свежесть-комбо (2+ событий недавно)\n"
    out == "" ? "" : "── 🏗️ Структура ──\n" + out

f_zones_section(side_detail d, bool is_bull) =>
    string out = ""
    int v_layers = d.layers
    if d.zone_conf_fresh or v_layers >= 1
        string zone_q = v_layers>=3 ? "🔥📦📦📦 Зона 3 слоя\n" : v_layers==2 ? "💪 Зона 2 слоя\n" : v_layers==1 ? "⚪ Зона 1 слой\n" : ""
        out += zone_q
    // ── ТЗ 4.2: OB Activity и Fresh OB печатаются независимо, без else-if ──
    if d.ob
        out += "📦 OB активен\n"
    if d.ob_fr
        out += "✨ Свежий OB (каса. недавно)\n"
    if d.sd
        out += "📦 Зона " + (is_bull ? "Demand" : "Supply") + "\n"
    bool sd_fvg_this = is_bull ? b_sd_fvg_bull : b_sd_fvg_bear
    if sd_fvg_this and inc_f51
        out += "📦📦 S&D+FVG\n"
    // ── ТЗ 4.3: FVG — d.fvg_p и d.fvg суть одна форма фактора f17 (OR), гейт единый ──
    if d.fvg_p
        out += "📦 Внутри точного FVG\n"
    else if d.fvg
        out += "📦 FVG (направление, без точн. каса.)\n"
    if d.fvg_poc
        out += "🎯 FVG POC (точный центр)\n"
    // ── ТЗ 4.5: OTE и Prem/Discount — раздельные if, без else, отдельный gating для комбо ──
    int v_ote = d.ote
    if v_ote == 2
        out += "⚖️ OTE зона(0.618-0.786)\n"
    // ── НОВОЕ (f78): OTE обычный, точная зона — отдельный независимый фактор ──
    if d.ote_zone
        out += "⚖️ OTE (точная зона) — фактор подтверждён ✅\n"
    if d.ote_ob
        out += "⚖️📦 OTE+OB\n"
    if d.ote_sd
        out += "⚖️📦 OTE+S&D\n"
    if d.pd
        out += "📉 Зона " + (is_bull ? "дисконта" : "премии") + "\n"
    if d.ote_conf
        out += "⚖️🎯 OTE Confluence (Main+Sniper совпали)\n"
    bool cndl_ob_this = is_bull ? b_candle_inside_ob_bull : b_candle_inside_ob_bear
    if cndl_ob_this and inc_f45
        out += "🕯️📦 Свеча в OB\n"
    bool cndl_sd_this = is_bull ? b_candle_sd_bull : b_candle_sd_bear
    if cndl_sd_this and inc_f54
        out += "🕯️📦 Свеча на границе S&D\n"
    bool freshob_cndl_this = is_bull ? b_freshob_candle_bull : b_freshob_candle_bear
    if freshob_cndl_this and inc_f50
        out += "✨🕯️ FreshOB+Candle\n"
    out == "" ? "" : "── 📐 Зоны ──\n" + out

f_volume_section(side_detail d, bool is_bull) =>
    string out = ""
    if d.sm_act
        out += "🐋 SM Activity\n"
    else if d.sm_bars <= 5
        out += "🐋 SM была " + str.tostring(d.sm_bars) + " б.назад\n"
    if d.sm_idx
        out += "💰 SM Index\n"
    if d.sm_int
        out += "💡 SM Interest\n"
    bool smact_smidx_this = is_bull ? b_smact_smidx_bull : b_smact_smidx_bear
    if smact_smidx_this and inc_f55
        out += "🐋💰 SMAct+SMIdx\n"
    bool sm_all3_this = is_bull ? sm_all3_bull : sm_all3_bear
    if sm_all3_this and inc_f43
        out += "🐋💰💡 SM Триплет\n"
    if d.cvd
        out += "🌊 CVD дивергенция\n"
    bool cvd_mdiv_this = is_bull ? b_cvd_mdiv_bull : b_cvd_mdiv_bear
    if cvd_mdiv_this and inc_f70
        out += "🌊🔍 CVD+MDiv\n"
    // ── ТЗ 4.8: Absorption направленно на свою сторону, без нейтральной ветки ──
    if d.absorp_this_side
        out += "🧽 Absorption (" + (is_bull ? "бычье доминир." : "медвежье доминир.") + ")\n"
    bool cvd_absorp_this = is_bull ? b_cvd_absorp_bull : b_cvd_absorp_bear
    if cvd_absorp_this and inc_f56
        out += "🌊🧽 CVD+Absorption(направл.)\n"
    if d.hm_bars <= 5
        out += "🔊 HM-Sweep " + str.tostring(d.hm_bars) + " б.назад\n"
    // ── ТЗ 4.4: HeatMap Sweep (f20) — поле hm_sig ──
    if d.hm_sig
        out += "🔊 HM Sweep (в этом баре)\n"
    if d.hm_vol_sig
        out += "📦🔊 HM Sweep Vol(аномальный): " + str.tostring(p1_hm_vol, format.volume) + "\n"
    bool cvd_sm_hm_this = is_bull ? b_cvd_sm_hm_bull : b_cvd_sm_hm_bear
    if cvd_sm_hm_this and inc_f57
        out += "🐋🔊 CVD+SM+HM (тройной)\n"
    if d.sdinv
        out += "💥 S&D Break\n"
    if d.lvz_confirmed
        out += "⚡🎯 LVZ подтверждён (снятие ликвидности в вакууме)\n"
    else if d.lvz
        out += "⚡ Цена в LVZ (ожидание подтверждения)\n"
    if d.lvz_sweep
        out += "⚡🌊 LVZ+Sweep\n"
    if d.lvz_cvd
        out += "⚡🌊 LVZ+CVD\n"
    if d.lvz_ob
        out += "⚡📦 LVZ+OB\n"
    if d.lvz_avwap
        out += "⚡📌 LVZ+AVWAP Cross\n"
    out == "" ? "" : "── 📊 Объём ──\n" + out

f_osc_section(side_detail d, bool is_bull) =>
    string out = ""
    if d.kde
        out += "📐 KDE RSI вышел из плотности\n"
    if d.stoch
        out += "🌀 Stoch Z развернулся\n"
    bool kde_stoch_this = is_bull ? b_kde_stoch_bull : b_kde_stoch_bear
    if kde_stoch_this and inc_f58
        out += "📐🌀 KDE+StochZ\n"
    if d.macd
        out += "⚙️ MACD Deluxe пересёк\n"
    if d.cci
        out += "🎢 Advanced CCI\n"
    bool macd_cci_this = is_bull ? b_macd_cci_bull : b_macd_cci_bear
    if macd_cci_this and inc_f59
        out += "⚙️🎢 MACD+CCI\n"
    if d.mdiv
        out += "🔍 Multi-Div(" + str.tostring(d.mdiv_cnt) + ")\n"
    bool mdiv_multi_this = is_bull ? osc_mdiv_multi_bull : osc_mdiv_multi_bear
    if mdiv_multi_this and inc_f44
        out += "🔍🔍 Multi-Div 3+\n"
    if d.peter
        out += "🔎 Div-Engine B\n"
    if d.tfdiv
        out += "🧩 Div-Engine C\n"
    bool peter_tfdiv_this = is_bull ? b_peter_tfdiv_bull : b_peter_tfdiv_bear
    if peter_tfdiv_this and inc_f60
        out += "🔎🧩 EngineB+EngineC\n"
    if d.smt
        out += "🌐 SMT дивергенция\n"
    bool smt_mdiv_this = is_bull ? b_smt_mdiv_bull : b_smt_mdiv_bear
    if smt_mdiv_this and inc_f61
        out += "🌐🔍 SMT+MDiv\n"
    bool triple_div_this = is_bull ? b_triple_div_bull : b_triple_div_bear
    if triple_div_this and inc_f62
        out += "🔍🔎🌐 Triple Div\n"
    if d.osc6
        out += "💪 OSC10 6+/10\n"
    // ── ТЗ 4.10: OSC10 сумма — строка с ✅ только при выполнении условия и включённом чекбоксе ──
    if d.osc10_sum_ok
        out += "📊 OSC10 сумма LTF: " + str.tostring(d.osc10_sum,"#.#") + "/30 ✅\n"
    out == "" ? "" : "── 🎛️ Осцилляторы ──\n" + out

f_cndl_ma_section(side_detail d, bool is_bull) =>
    string out = ""
    out += "🕯️ Свеча в моменте: " + d.cndl_name + "\n"
    if d.ma_x
        out += "✕ MA Cross " + (is_bull ? "вверх" : "вниз") + "\n"
    if d.ma_tr
        out += "📈 MA Trend " + (is_bull ? "бычий" : "медвежий") + "\n"
    bool macross_matrend_this = is_bull ? b_macross_matrend_bull : b_macross_matrend_bear
    if macross_matrend_this and inc_f63
        out += "✕📈 MACross+MATrend\n"
    "── 🕯️ Свечи и MA ──\n" + out

f_market_section(side_detail d, bool is_bull) =>
    string out = ""
    if d.regime
        out += "📈 Regime: ADX " + str.tostring(math.round(adx_val)) + " тир" + str.tostring(d.adx_tier) + " " + (is_bull ? "бычий" : "медвежий") + "\n"
    // ── ТЗ 4.11: ADX-тир — независимая строка от d.regime (own gating через d.adx_tier, уже гейтован inc_f65) ──
    if d.adx_tier >= 1 and not d.regime
        out += "🌡️ ADX тир " + str.tostring(d.adx_tier) + " (без учёта режима)\n"
    out == "" ? "" : "── 🌡️ Режим ──\n" + out

f_mtf_complex_section(side_detail d, int ltf_sc, int htf_sc, int sc, int req) =>
    string out = ""
    if ltf_sc == 3 and htf_sc == 3
        out += "🔵🟢 LTF3/3+HTF3/3 — A+ потенциал\n"
    else if ltf_sc == 3 and htf_sc >= 2 and (sc >= req)
        out += "🔵🟡 LTF3/3+HTF2/3 — A потенциал\n"
    else if ltf_sc >= 2 and htf_sc >= 2 and sc >= req
        out += "🟡🟡 LTF2/3+HTF2/3 — B потенциал\n"
    else if ltf_sc >= 1 and htf_sc >= 1
        out += "⚪⚪ Накопление контекста (C)\n"
    // ── ТЗ 4.13: используем гейтованные d.master_p1/d.conf_main вместо сырых булевых ──
    if d.master_p1
        out += "✅ Master Signal P1\n"
    if d.conf_main
        out += "✅ Confluence Main ≥7\n"
    if d.master_p1 and d.conf_main and ltf_sc == 3 and htf_sc == 3 and sc >= req
        out += "💎 Снайперский комплекс (A+)\n"
    if d.htf_gate_score
        out += "🟢 HTF Gate: превышен порог\n"
    out == "" ? "" : "── 🧬 MTF-комплексы ──\n" + out

f_all_factors_block(side_detail d, bool is_bull, int ltf_sc, int htf_sc, int sc, int req) =>
    f_struct_section(d, is_bull) + f_zones_section(d, is_bull) + f_volume_section(d, is_bull) + f_osc_section(d, is_bull) + f_cndl_ma_section(d, is_bull) + f_market_section(d, is_bull) + f_mtf_complex_section(d, ltf_sc, htf_sc, sc, req)

// ====================================================================================================================
// КОНТЕКСТНЫЙ БЛОК (ТЗ раздел 5) — информация, не влияющая на скор, визуально отделена
// ====================================================================================================================
f_context_section(side_detail d) =>
    string out = ""
    if regime_ranging
        out += "😴 Ranging\n"
    if regime_trending
        out += "📊 Trending\n"
    if regime_compression
        out += "🔇 Compression\n"
    if vol_ok
        out += "🌪️ Волатильность расширена\n"
    out += "📊 OSC10 сумма LTF (сырое): " + str.tostring(d.osc10_sum,"#.#") + "/30\n"
    out += f_freshness_sorted(d)
    out == "" ? "" : "── ℹ️ Контекст рынка (не влияет на скор) ──\n" + out

// ====================================================================================================================
// ИНФОБЛОК
// ====================================================================================================================
f_build_info(side_detail d, tf_detail_strings tf, int ltf_sc, int htf_sc, int layers, int sc, float sig_px, string grade, bool is_bull) =>
    string info = ""
    if not p1_connected
        info := "⛔ Main P1 не подключён"
    else
        info += f_grade_emoji(grade) + " Грейд: " + grade + "\n"
        info += "💲 Цена сигнала: " + str.tostring(sig_px, format.mintick) + "\n"
        if info_show_time
            info += "🕐 " + str.format_time(time, "HH:mm dd.MM.yy", "UTC") + " UTC\n"
        if info_show_regime
            string regime_str = d.regime ? "📈 " + (is_bull?"Бычий":"Медвежий") + " (ADX=" + str.tostring(math.round(adx_val)) + ")" : regime_compression ? "🔇 Сжатие" : regime_ranging ? "😴 Боковик" : "❓ Переход"
            info += "🔭 Режим: " + regime_str + "\n"
        if info_show_trade_levels and en_trade_mgmt
            [p_sl, p_tp1, p_tp2, p_tp3, p_sl_pct] = f_trade_preview(is_bull, sig_px)
            info += "──────────────\n" + f_trade_lvls_text(p_sl, p_tp1, p_tp2, p_tp3, p_sl_pct) + "\n"
        info += "──────────────\n"
        info += f_htf_icon(htf_sc) + " HTF(" + str.tostring(htf_sc) + "/3)──\n"
        info += tf.htf1 + "\n" + tf.htf2 + "\n" + tf.htf3 + "\n" + tf.htf_verdict + "\n"
        info += f_ltf_icon(ltf_sc) + " LTF(" + str.tostring(ltf_sc) + "/3)──\n"
        info += tf.ltf1 + "\n" + tf.ltf2 + "\n" + tf.ltf3 + "\n" + tf.ltf_cascade_verdict + "\n"
        info += "──────────────\n"
        if info_show_zone_stars
            info += "⭐ Зона: " + f_zone_star_rating(d) + "\n──────────────\n"
        info += "🎯 СКОР: " + str.tostring(sc) + "/" + str.tostring(req_score) + "\n"
        if info_show_counter
            info += f_counter_side_summary(is_bull) + "\n"
        if info_show_consensus
            info += f_consensus_line(is_bull) + "\n"
        info += "── ✅ Активные факторы ──\n"
        info += f_all_factors_block(d, is_bull, ltf_sc, htf_sc, sc, req_score)
        info += f_context_section(d)
    f_cap_lines(info, info_max_lines)

// ====================================================================================================================
// ЖИВОЙ СВЕТОФОР — полный / компактный (мини) режим по переключателю en_live_compact
// ====================================================================================================================
f_live_text_full(string tier_txt, string metrics, tf_detail_strings tf, side_detail d, bool is_bull_d, int cur_ltf, int cur_htf, int cur_score, string poi_s) =>
    tier_txt + "\n" + metrics + "─────────\n── HTF ──\n" + tf.htf1 + "\n" + tf.htf2 + "\n" + tf.htf3 + "\n── LTF ──\n" + tf.ltf1 + "\n" + tf.ltf2 + "\n" + tf.ltf3 + "\n── POI: " + (poi_s=="" ? "нет" : poi_s) + " ──\n" + f_all_factors_block(d, is_bull_d, cur_ltf, cur_htf, cur_score, req_score) + f_context_section(d)

f_live_text_compact(string tier_txt, bool is_bull_d, int cur_ltf, int cur_htf, int cur_score, float px) =>
    tier_txt + "\n" + f_htf_icon(cur_htf) + " HTF:" + str.tostring(cur_htf) + "/3│" + f_ltf_icon(cur_ltf) + " LTF:" + str.tostring(cur_ltf) + "/3\n📊 " + f_score_bar(cur_score, req_score) + "\n💲 " + str.tostring(px, format.mintick) + "\n" + f_counter_side_summary(is_bull_d)

var label dynamic_lbl = na
if (barstate.isrealtime or barstate.islast) and en_live_lbl and p1_connected
    int cur_ltf_bull = mtf_state_bull
    int cur_ltf_bear = mtf_state_bear
    int cur_htf_bull = htf_bull_conf
    int cur_htf_bear = htf_bear_conf
    float strength_bull = f_side_strength(cur_ltf_bull, cur_htf_bull, buy_score)
    float strength_bear = f_side_strength(cur_ltf_bear, cur_htf_bear, sell_score)
    bool is_bull_d = strength_bull > strength_bear and (cur_ltf_bull > 0 or cur_htf_bull > 0 or buy_score > 0)
    bool is_bear_d = not is_bull_d and (cur_ltf_bear > 0 or cur_htf_bear > 0 or sell_score > 0)
    int cur_ltf = is_bull_d ? cur_ltf_bull : cur_ltf_bear
    int cur_htf = is_bull_d ? cur_htf_bull : cur_htf_bear
    bool live_now = is_bull_d ? intrabar_signal_live_buy : intrabar_signal_live_sell
    float live_price = is_bull_d ? intrabar_signal_price_buy : intrabar_signal_price_sell

    if cur_ltf > 0 or cur_htf > 0 or live_now or buy_score > 0 or sell_score > 0
        string dir = is_bull_d ? "ПОКУПКА ↑" : "ПРОДАЖА ↓"
        int cur_layers = is_bull_d ? p1_zone_layers_bull : p1_zone_layers_bear
        int cur_score = is_bull_d ? buy_score : sell_score
        bool cur_regime_aligned = is_bull_d ? final_regime_bull : final_regime_bear
        bool cur_lvz_confirmed = is_bull_d ? b_lvz_confirmed_bull : b_lvz_confirmed_bear
        bool cur_ote_conf = is_bull_d ? b_ote_conf_bull : b_ote_conf_bear
        string cur_grade = f_signal_grade(cur_ltf, cur_htf, cur_layers, cur_score, req_score, cur_regime_aligned, cur_lvz_confirmed, cur_ote_conf)
        side_detail cur_pack = is_bull_d ? pack_bull : pack_bear
        tf_detail_strings cur_tf_pack = is_bull_d ? tf_pack_bull : tf_pack_bear
        bool ready = (is_bull_d ? buy_score : sell_score) >= req_score and (is_bull_d ? buy_valid : sell_valid) and (is_bull_d ? full_gate_bull : full_gate_bear)
        color bg_c = live_now ? live_bg_intrabar : f_grade_live_bg(cur_grade, is_bull_d)
        string tier_txt = live_now ? "⚡ СИГНАЛ ВНУТРИ БАРА — " + dir + " @ " + str.tostring(live_price, format.mintick) : ready ? f_grade_emoji(cur_grade) + " СНАЙПЕРСКИЙ ВХОД (" + dir + ")" : cur_grade=="B" ? f_grade_emoji(cur_grade) + " Готов (" + dir + ")" : cur_grade=="C" ? f_grade_emoji(cur_grade) + " Почти готов (" + dir + ")" : cur_grade=="D" ? f_grade_emoji(cur_grade) + " Накопление (" + dir + ")" : "⏳ Нет контекста (" + dir + ")"
        string poi_s = is_bull_d ? (b_ob_bull?"OB ":"")+(b_sd_bull?"S&D ":"")+(b_fvg_precise_bull?"FVG ":"")+(ote_score_bull>=2?"OTE":"") : (b_ob_bear?"OB ":"")+(b_sd_bear?"S&D ":"")+(b_fvg_precise_bear?"FVG ":"")+(ote_score_bear>=2?"OTE":"")
        string trade_prev_txt = ""
        if en_trade_mgmt and live_now
            [pv_sl, pv_tp1, pv_tp2, pv_tp3, pv_sl_pct] = f_trade_preview(is_bull_d, live_price)
            trade_prev_txt := f_trade_lvls_text(pv_sl, pv_tp1, pv_tp2, pv_tp3, pv_sl_pct) + "\n"
        string metrics = f_htf_icon(cur_htf) + " HTF:" + str.tostring(cur_htf) + "/3│" + f_ltf_icon(cur_ltf) + " LTF:" + str.tostring(cur_ltf) + "/3\n📊 " + f_score_bar(cur_score, req_score) + "\n💲 " + str.tostring(close, format.mintick) + (live_show_session ? "│" + f_session_context() : "") + "\n🕯️ Свеча сейчас: " + cndl_name_live + "\n" + trade_prev_txt + (info_show_counter ? f_counter_side_summary(is_bull_d) + "\n" : "") + (info_show_consensus ? f_consensus_line(is_bull_d) + "\n" : "")
        string live_txt_raw = en_live_compact ? f_live_text_compact(tier_txt, is_bull_d, cur_ltf, cur_htf, cur_score, close) : f_live_text_full(tier_txt, metrics, cur_tf_pack, cur_pack, is_bull_d, cur_ltf, cur_htf, cur_score, poi_s)
        string live_txt = f_cap_lines(live_txt_raw, live_max_lines)
        float y_pos = is_bull_d ? low - atr14*live_lbl_gap : high + atr14*live_lbl_gap
        string lbl_st = is_bull_d ? label.style_label_up : label.style_label_down
        if not na(dynamic_lbl)
            label.delete(dynamic_lbl)
        dynamic_lbl := label.new(bar_index, y_pos, text=live_txt, style=lbl_st, color=bg_c, textcolor=live_text_col, size=get_size(live_text_size))
    else
        if not na(dynamic_lbl)
            label.delete(dynamic_lbl)
            dynamic_lbl := na

if barstate.isconfirmed
    if not na(dynamic_lbl)
        label.delete(dynamic_lbl)
        dynamic_lbl := na

// ====================================================================================================================
// 9. АЛЕРТЫ
// ====================================================================================================================
grp_alert = "9. Алерты"
en_alert_buy = input.bool(true, "Алерт ПОКУПКА", group=grp_alert)
en_alert_sell = input.bool(true, "Алерт ПРОДАЖА", group=grp_alert)
en_alert_intrabar = input.bool(true, "Алерт внутри бара", group=grp_alert)
alert_prefix = input.string("🤖 UserUZR Sniper", "Префикс", group=grp_alert)
alert_max_chars = input.int(3800, "Макс.символов", minval=500, maxval=4000, group=grp_alert)

f_tv_link() => "https://www.tradingview.com/chart/?symbol=" + syminfo.tickerid
f_alert_header(string direction, string grade, float price) => alert_prefix + "\n━━━━━━━━━━━━\n" + direction + " [" + grade + "] " + f_grade_emoji(grade) + "\n━━━━━━━━━━━━\n📊 " + syminfo.tickerid + " │ТФ:" + timeframe.period + "\n🔗 " + f_tv_link() + "\n💲 Вход: " + str.tostring(price, format.mintick) + "\n🕐 " + str.format_time(time, "HH:mm dd.MM.yyyy", "UTC") + " UTC\n━━━━━━━━━━━━\n"
f_cap_chars(string txt, int max_c) => str.length(txt) > max_c ? str.substring(txt, 0, max_c) + "\n…[обрезано]" : txt

if en_alert_intrabar and intrabar_signal_live_buy
    string ib_grade_b = f_signal_grade(mtf_state_bull, htf_bull_conf, p1_zone_layers_bull, buy_score, req_score, final_regime_bull, b_lvz_confirmed_bull, b_ote_conf_bull)
    string ib_trade_txt = ""
    if en_trade_mgmt
        [ib_sl,ib_tp1,ib_tp2,ib_tp3,ib_slp] = f_trade_preview(true, intrabar_signal_price_buy)
        ib_trade_txt := f_trade_lvls_text(ib_sl,ib_tp1,ib_tp2,ib_tp3,ib_slp) + "\n"
    string msg_ib_buy = f_alert_header("⚡ ВНУТРИ БАРА — ПОКУПКА", ib_grade_b, intrabar_signal_price_buy) + f_htf_icon(htf_bull_conf) + " HTF:" + str.tostring(htf_bull_conf) + "/3│" + f_ltf_icon(mtf_state_bull) + " LTF:" + str.tostring(mtf_state_bull) + "/3\n📊 " + f_score_bar(buy_score, req_score) + "\n🕯️ " + cndl_name_live + "\n" + ib_trade_txt + "─────\n" + f_all_factors_block(pack_bull, true, mtf_state_bull, htf_bull_conf, buy_score, req_score)
    alert(f_cap_chars(msg_ib_buy, alert_max_chars), alert.freq_once_per_bar)

if en_alert_intrabar and intrabar_signal_live_sell
    string ib_grade_s = f_signal_grade(mtf_state_bear, htf_bear_conf, p1_zone_layers_bear, sell_score, req_score, final_regime_bear, b_lvz_confirmed_bear, b_ote_conf_bear)
    string ib_trade_txt_s = ""
    if en_trade_mgmt
        [ib_sl_s,ib_tp1_s,ib_tp2_s,ib_tp3_s,ib_slp_s] = f_trade_preview(false, intrabar_signal_price_sell)
        ib_trade_txt_s := f_trade_lvls_text(ib_sl_s,ib_tp1_s,ib_tp2_s,ib_tp3_s,ib_slp_s) + "\n"
    string msg_ib_sell = f_alert_header("⚡ ВНУТРИ БАРА — ПРОДАЖА", ib_grade_s, intrabar_signal_price_sell) + f_htf_icon(htf_bear_conf) + " HTF:" + str.tostring(htf_bear_conf) + "/3│" + f_ltf_icon(mtf_state_bear) + " LTF:" + str.tostring(mtf_state_bear) + "/3\n📊 " + f_score_bar(sell_score, req_score) + "\n🕯️ " + cndl_name_live + "\n" + ib_trade_txt_s + "─────\n" + f_all_factors_block(pack_bear, false, mtf_state_bear, htf_bear_conf, sell_score, req_score)
    alert(f_cap_chars(msg_ib_sell, alert_max_chars), alert.freq_once_per_bar)

// ====================================================================================================================
// УПРАВЛЕНИЕ СДЕЛКОЙ — открытие/отслеживание
// ====================================================================================================================
if en_trade_mgmt and barstate.isconfirmed and (is_buy or is_sell)
    bool new_is_buy = is_buy
    float new_entry = new_is_buy ? signal_price_buy : signal_price_sell
    string new_grade = new_is_buy ? signal_grade_buy : signal_grade_sell
    if cur_trade.active and not cur_trade.closed
        bool had_remaining = not cur_trade.tp3_hit and not cur_trade.sl_hit
        if had_remaining and en_alert_replaced
            string msg_repl = f_alert_header("🔁 СДЕЛКА ЗАКРЫТА НОВЫМ СИГНАЛОМ", cur_trade.grade, close) + f_trade_ref(cur_trade) + "Новый: " + (new_is_buy ? "ПОКУПКА" : "ПРОДАЖА") + "[" + new_grade + "]@" + str.tostring(new_entry, format.mintick)
            alert(f_cap_chars(msg_repl, alert_max_chars), alert.freq_once_per_bar_close)
        cur_trade.active := false
        cur_trade.closed := true
    [n_sl, n_tp1, n_tp2, n_tp3, n_sl_pct] = f_trade_preview(new_is_buy, new_entry)
    trade_state t = trade_state.new()
    t.active := true
    t.is_buy := new_is_buy
    t.entry := new_entry
    t.sl := n_sl
    t.tp1 := n_tp1
    t.tp2 := n_tp2
    t.tp3 := n_tp3
    t.grade := new_grade
    t.entry_time := time
    t.signal_bar := bar_index
    t.signal_price := new_entry
    t.sl_pct_calc := n_sl_pct
    cur_trade := t
    if en_alert_trade_open
        string dir_lbl = new_is_buy ? "📈 ОТКРЫТА — ПОКУПКА" : "📉 ОТКРЫТА — ПРОДАЖА"
        string msg_open = f_alert_header(dir_lbl, new_grade, new_entry) + f_trade_lvls_text(cur_trade.sl, cur_trade.tp1, cur_trade.tp2, cur_trade.tp3, cur_trade.sl_pct_calc)
        alert(f_cap_chars(msg_open, alert_max_chars), alert.freq_once_per_bar_close)
    if en_trade_info_lbl
        string lvl_txt = "SL " + str.tostring(cur_trade.sl, format.mintick) + "(" + str.tostring(cur_trade.sl_pct_calc,"#.##") + "%)\nTP1 " + str.tostring(cur_trade.tp1, format.mintick) + "\nTP2 " + str.tostring(cur_trade.tp2, format.mintick) + "\nTP3 " + str.tostring(cur_trade.tp3, format.mintick)
        label.new(bar_index, new_is_buy ? low - atr14*2.2 : high + atr14*2.2, text=lvl_txt, style=new_is_buy ? label.style_label_up : label.style_label_down, color=trade_lbl_bg_col, textcolor=trade_lbl_text_col, size=get_size(trade_lbl_text_size))

if en_trade_mgmt and barstate.isconfirmed and cur_trade.active and not cur_trade.closed
    bool event_happened = false
    if cur_trade.is_buy
        if not event_happened and low <= cur_trade.sl
            cur_trade.sl_hit := true, cur_trade.active := false, cur_trade.closed := true, event_happened := true
            if en_alert_sl
                alert(f_cap_chars(f_alert_header("🛑 SL СРАБОТАЛ", cur_trade.grade, cur_trade.sl) + f_trade_ref(cur_trade) + "SL:" + str.tostring(cur_trade.sl, format.mintick) + (cur_trade.be_active?"(был в БУ)":""), alert_max_chars), alert.freq_once_per_bar_close)
        if not event_happened and not cur_trade.tp1_hit and high >= cur_trade.tp1
            cur_trade.tp1_hit := true, event_happened := true
            if en_alert_tp1
                alert(f_cap_chars(f_alert_header("🎯 TP1", cur_trade.grade, cur_trade.tp1) + f_trade_ref(cur_trade) + "Зафикс:" + str.tostring(tp1_vol,"#") + "%│Остаток:" + str.tostring(100-tp1_vol,"#") + "%", alert_max_chars), alert.freq_once_per_bar_close)
            if en_be_on_tp1
                cur_trade.sl := cur_trade.entry, cur_trade.be_active := true
                if en_alert_be
                    alert(f_cap_chars(f_alert_header("🔄 БЕЗУБЫТОК", cur_trade.grade, cur_trade.entry) + f_trade_ref(cur_trade) + "Новый SL:" + str.tostring(cur_trade.sl, format.mintick), alert_max_chars), alert.freq_once_per_bar_close)
        if not event_happened and cur_trade.tp1_hit and not cur_trade.tp2_hit and high >= cur_trade.tp2
            cur_trade.tp2_hit := true, event_happened := true
            if en_alert_tp2
                alert(f_cap_chars(f_alert_header("🎯 TP2", cur_trade.grade, cur_trade.tp2) + f_trade_ref(cur_trade) + "Зафикс:" + str.tostring(tp2_vol,"#") + "%│Остаток:" + str.tostring(math.max(0.0,100-tp1_vol-tp2_vol),"#") + "%", alert_max_chars), alert.freq_once_per_bar_close)
        if not event_happened and cur_trade.tp2_hit and not cur_trade.tp3_hit and high >= cur_trade.tp3
            cur_trade.tp3_hit := true, cur_trade.active := false, cur_trade.closed := true, event_happened := true
            if en_alert_tp3
                alert(f_cap_chars(f_alert_header("🎯 TP3-ЗАКРЫТИЕ", cur_trade.grade, cur_trade.tp3) + f_trade_ref(cur_trade) + "Остаток зафиксирован.", alert_max_chars), alert.freq_once_per_bar_close)
    else
        if not event_happened and high >= cur_trade.sl
            cur_trade.sl_hit := true, cur_trade.active := false, cur_trade.closed := true, event_happened := true
            if en_alert_sl
                alert(f_cap_chars(f_alert_header("🛑 SL СРАБОТАЛ", cur_trade.grade, cur_trade.sl) + f_trade_ref(cur_trade) + "SL:" + str.tostring(cur_trade.sl, format.mintick) + (cur_trade.be_active?"(был в БУ)":""), alert_max_chars), alert.freq_once_per_bar_close)
        if not event_happened and not cur_trade.tp1_hit and low <= cur_trade.tp1
            cur_trade.tp1_hit := true, event_happened := true
            if en_alert_tp1
                alert(f_cap_chars(f_alert_header("🎯 TP1", cur_trade.grade, cur_trade.tp1) + f_trade_ref(cur_trade) + "Зафикс:" + str.tostring(tp1_vol,"#") + "%│Остаток:" + str.tostring(100-tp1_vol,"#") + "%", alert_max_chars), alert.freq_once_per_bar_close)
            if en_be_on_tp1
                cur_trade.sl := cur_trade.entry, cur_trade.be_active := true
                if en_alert_be
                    alert(f_cap_chars(f_alert_header("🔄 БЕЗУБЫТОК", cur_trade.grade, cur_trade.entry) + f_trade_ref(cur_trade) + "Новый SL:" + str.tostring(cur_trade.sl, format.mintick), alert_max_chars), alert.freq_once_per_bar_close)
        if not event_happened and cur_trade.tp1_hit and not cur_trade.tp2_hit and low <= cur_trade.tp2
            cur_trade.tp2_hit := true, event_happened := true
            if en_alert_tp2
                alert(f_cap_chars(f_alert_header("🎯 TP2", cur_trade.grade, cur_trade.tp2) + f_trade_ref(cur_trade) + "Зафикс:" + str.tostring(tp2_vol,"#") + "%│Остаток:" + str.tostring(math.max(0.0,100-tp1_vol-tp2_vol),"#") + "%", alert_max_chars), alert.freq_once_per_bar_close)
        if not event_happened and cur_trade.tp2_hit and not cur_trade.tp3_hit and low <= cur_trade.tp3
            cur_trade.tp3_hit := true, cur_trade.active := false, cur_trade.closed := true, event_happened := true
            if en_alert_tp3
                alert(f_cap_chars(f_alert_header("🎯 TP3-ЗАКРЫТИЕ", cur_trade.grade, cur_trade.tp3) + f_trade_ref(cur_trade) + "Остаток зафиксирован.", alert_max_chars), alert.freq_once_per_bar_close)

// ====================================================================================================================
// ВИЗУАЛИЗАЦИЯ ЛЕЙБЛОВ BUY/SELL (управляется en_sig_labels из группы 0.2.1)
// ====================================================================================================================
if is_buy
    int ltf_s = mtf_state_bull
    int htf_s = htf_bull_conf
    int layers = p1_zone_layers_bull
    string grade = signal_grade_buy
    color buy_col = f_label_color_bull(grade)
    string zone_ic = layers>=3 ? "🔥" : layers==2 ? "💪" : ""
    string buy_txt = f_grade_emoji(grade) + " " + f_htf_icon(htf_s) + f_ltf_icon(ltf_s) + zone_ic + " ПОКУПКА[" + grade + "]\nСкор:" + str.tostring(buy_score) + "/" + str.tostring(req_score)
    if en_sig_labels
        label.new(bar_index, low - atr14, text=buy_txt, style=label.style_label_up, color=buy_col, textcolor=sig_text_col, size=get_size(sig_text_size))
    side_detail pack_bull_signal = pack_bull
    pack_bull_signal.cndl_name := signal_cndl_name_buy
    if en_info_block
        color info_bg = f_grade_info_bg(grade, true)
        label.new(bar_index, low - atr14*(1+info_gap), text=f_build_info(pack_bull_signal, tf_pack_bull, ltf_s, htf_s, layers, buy_score, signal_price_buy, grade, true), style=label.style_label_up, color=info_bg, textcolor=info_text_col, size=get_size(info_text_size), textalign=f_get_align(info_align))
    if en_alert_buy
        string msg_buy = f_alert_header("📈 ПОКУПКА", signal_grade_buy, signal_price_buy) + f_build_info(pack_bull_signal, tf_pack_bull, mtf_state_bull, htf_bull_conf, p1_zone_layers_bull, buy_score, signal_price_buy, signal_grade_buy, true)
        alert(f_cap_chars(msg_buy, alert_max_chars), alert.freq_once_per_bar_close)

if is_sell
    int ltf_s = mtf_state_bear
    int htf_s = htf_bear_conf
    int layers = p1_zone_layers_bear
    string grade = signal_grade_sell
    color sell_col = f_label_color_bear(grade)
    string zone_ic = layers>=3 ? "🔥" : layers==2 ? "💪" : ""
    string sell_txt = f_grade_emoji(grade) + " " + f_htf_icon(htf_s) + f_ltf_icon(ltf_s) + zone_ic + " ПРОДАЖА[" + grade + "]\nСкор:" + str.tostring(sell_score) + "/" + str.tostring(req_score)
    if en_sig_labels
        label.new(bar_index, high + atr14, text=sell_txt, style=label.style_label_down, color=sell_col, textcolor=sig_text_col, size=get_size(sig_text_size))
    side_detail pack_bear_signal = pack_bear
    pack_bear_signal.cndl_name := signal_cndl_name_sell
    if en_info_block
        color info_bg = f_grade_info_bg(grade, false)
        label.new(bar_index, high + atr14*(1+info_gap), text=f_build_info(pack_bear_signal, tf_pack_bear, ltf_s, htf_s, layers, sell_score, signal_price_sell, grade, false), style=label.style_label_down, color=info_bg, textcolor=info_text_col, size=get_size(info_text_size), textalign=f_get_align(info_align))
    if en_alert_sell
        string msg_sell = f_alert_header("📉 ПРОДАЖА", signal_grade_sell, signal_price_sell) + f_build_info(pack_bear_signal, tf_pack_bear, mtf_state_bear, htf_bear_conf, p1_zone_layers_bear, sell_score, signal_price_sell, signal_grade_sell, false)
        alert(f_cap_chars(msg_sell, alert_max_chars), alert.freq_once_per_bar_close)
