indicator("UserUZR Sniper - All-In-One (EMA,RSI,CCI,STC,MACD,CVD,OTE,LTF/HTF,AVWAP,Cndl,MDivs,SM,Logic,Signal,Alert)", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500, max_bars_back=2500)

get_size(str) => switch str
    "tiny" => size.tiny
    "small" => size.small
    "normal" => size.normal
    "large" => size.large
    "huge" => size.huge
    => size.auto

