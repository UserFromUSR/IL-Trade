bool tier_htf3_bear = p1_tier_htf3_bear and p2_htf3_osc_s

// ── Market Regime (константы под BTCUSDT.P 15-30m: chop_len, adx_len, vol_th из Части 2) ──
float atr14 = ta.atr(14)
float atr100 = ta.atr(100)
bool vol_ok = (atr14 / math.max(atr100, 1e-10)) > vol_th
float chop_tr_sum = math.sum(ta.tr, chop_len)
float chop_hi = ta.highest(high, chop_len)
float chop_lo = ta.lowest(low, chop_len)
float choppiness = 100 * math.log10(chop_tr_sum / math.max(chop_hi - chop_lo, 1e-10)) / math.log10(chop_len)
[di_plus, di_minus, adx_val] = ta.dmi(adx_len, adx_len)
bool regime_trending = adx_val > 25 and choppiness < 50
bool regime_ranging = choppiness > 61.8 or adx_val < 20
bool regime_compression = vol_ok == false and choppiness > 61.8
bool local_regime_bull = adx_val > 20 and di_plus > di_minus
bool local_regime_bear = adx_val > 20 and di_minus > di_plus
bool final_regime_bull = p1_connected ? p1_regime_bull : local_regime_bull
bool final_regime_bear = p1_connected ? p1_regime_bear : local_regime_bear
float final_adx = p1_connected and not na(p1_adx_val) ? p1_adx_val : adx_val
int adx_tier_bull = final_regime_bull ? (final_adx>=adx_tier_th3?3:final_adx>=adx_tier_th2?2:final_adx>=adx_tier_th1?1:0) : 0
int adx_tier_bear = final_regime_bear ? (final_adx>=adx_tier_th3?3:final_adx>=adx_tier_th2?2:final_adx>=adx_tier_th1?1:0) : 0

float retest_tol = atr14 * 0.15
bool b_bos_retest_bull = p1_connected and bos_level_dir == 1 and not na(bos_level_price) and math.abs(close - bos_level_price) <= retest_tol and p1_bos_touches <= 3
bool b_bos_retest_bear = p1_connected and bos_level_dir == -1 and not na(bos_level_price) and math.abs(close - bos_level_price) <= retest_tol and p1_bos_touches <= 3
bool b_choch_retest_bull = p1_connected and choch_level_dir == 1 and not na(choch_level_price) and math.abs(close - choch_level_price) <= retest_tol and p1_choch_touches <= 3
bool b_choch_retest_bear = p1_connected and choch_level_dir == -1 and not na(choch_level_price) and math.abs(close - choch_level_price) <= retest_tol and p1_choch_touches <= 3
bool bos_level_exhausted = p1_bos_touches > 3
bool choch_level_exhausted = p1_choch_touches > 3

float hm_vol_base_sma = ta.sma(volume, 20)
bool hm_vol_significant = p1_connected ? p1_hm_vol_anomalous : (p1_hm_vol > hm_vol_base_sma * 1.5)

// ====================================================================================================================
// ЗАДАЧА А — ЕДИНЫЙ TMR-МАССИВ ТАЙМЕРОВ (16 элементов; индекс 15 = LVZ подтверждён, ТЗ B.3)
// ====================================================================================================================
var bar_timer[] TMR = array.new<bar_timer>(0)
if bar_index == 0
    for i = 0 to 15
        TMR.push(bar_timer.new())

// ====================================================================================================================
// КЭШ PRESET_FACTOR (производительность): вычисляется один раз на первом баре, устраняет дублирующие
// вызовы f_pr_get для одних и тех же индексов при скоринге и при построении inc_fN-флагов гейтинга.
// ====================================================================================================================
var array<preset_factor> PF_CACHE = array.new<preset_factor>(68)
if bar_index == 0
    for i = 0 to 67
        PF_CACHE.set(i, f_pr_get(i, SCORE_RAW_INC.get(i), SCORE_RAW_WEIGHT.get(i), SCORE_RAW_MUST.get(i)))

// ====================================================================================================================
// ГЛОБАЛЬНЫЕ ИНДИКАТОРЫ, LOWER-TF ЗАПРОСЫ, MA/ТРЕНД
// ====================================================================================================================
[g_mac_line, g_mac_signal, g_mac_hist] = ta.macd(close, 12, 26, 9)
float g_macdL = g_mac_line
float g_macdH = g_mac_hist
float g_rsi = ta.rsi(close, 14)
float g_stc = ta.sma(ta.stoch(close, high, low, 14), 3)
float g_cci = ta.cci(close, 10)
float g_mom = ta.mom(close, 10)
float g_obv = ta.obv
float g_vwm = ta.vwma(close, 12) - ta.vwma(close, 26)
float g_cmf = ta.sma((((close-low)-(high-close))/(high-low))*volume, 21) / ta.sma(volume, 21)
float g_mfi = ta.mfi(close, 14)
float chg_close = ta.change(close)
float chg_high = ta.change(high)
float chg_low = ta.change(low)
float g_p_obv = ta.cum(chg_close > 0 ? volume : chg_close < 0 ? -volume : 0)
float g_p_diosc = fixnan(100 * ta.rma(chg_high - (-chg_low), 14) / ta.rma(ta.tr, 14))
float g_cndl_atr = ta.atr(14)

float s_h1 = request.security(smt_sym1, timeframe.period, high)
float s_l1 = request.security(smt_sym1, timeframe.period, low)
float s_h2 = request.security(smt_sym2, timeframe.period, high)
float s_l2 = request.security(smt_sym2, timeframe.period, low)
float[] global_lt_v = request.security_lower_tf(syminfo.tickerid, sm_act_ltf, volume)
float[] global_lt_c = request.security_lower_tf(syminfo.tickerid, sm_act_ltf, close)
float[] global_lt_o = request.security_lower_tf(syminfo.tickerid, sm_act_ltf, open)

f_get_ma(src, len, type) => switch type
    "EMA" => ta.ema(src, len)
    "WMA" => ta.wma(src, len)
    "HMA" => ta.hma(src, len)
    "ALMA" => ta.alma(src, len, alma_offset, alma_sigma)
    => ta.sma(src, len)

float ma_f = f_get_ma(close, ma_fast_len, ma_fast_type)
float ma_s = f_get_ma(close, ma_slow_len, ma_slow_type)
float ma_g = f_get_ma(close, ma_filt_len, ma_filt_type)
bool cond_cross_bull = ma_f > ma_s
bool cond_cross_bear = ma_f < ma_s
bool cond_pglob_bull = close > ma_g
bool cond_pglob_bear = close < ma_g
bool ma_trend_bull = ma_sig_logic == "Fast > Slow" ? cond_cross_bull : ma_sig_logic == "Price > Global MA" ? cond_pglob_bull : (cond_cross_bull and cond_pglob_bull)
bool ma_trend_bear = ma_sig_logic == "Fast > Slow" ? cond_cross_bear : ma_sig_logic == "Price > Global MA" ? cond_pglob_bear : (cond_cross_bear and cond_pglob_bear)
int ma_trend_status = ma_trend_bull ? 1 : ma_trend_bear ? -1 : 0
bool x_ma_bull = ta.crossover(ma_f, ma_s)
bool x_ma_bear = ta.crossunder(ma_f, ma_s)

plot(en_ma ? ma_f : na, "MA Fast", ma_fast_col, 1)
plot(en_ma ? ma_s : na, "MA Slow", ma_slow_col, 2)
plot(en_ma_filt ? ma_g : na, "MA Global", ma_filt_col, 2)
plotshape(en_ma and en_ma_cross and x_ma_bull, "MA Cross Bull", shape.labelup, location.belowbar, color.new(#2196F3,30), 0, "✕", color.white, size=size.tiny)
plotshape(en_ma and en_ma_cross and x_ma_bear, "MA Cross Bear", shape.labeldown, location.abovebar, color.new(#9C27B0,30), 0, "✕", color.white, size=size.tiny)

var float swing_h = na
var float swing_l = na
var int auto_trend = 1
float ph_sw = ta.pivothigh(high, sync_len, sync_len)
float pl_sw = ta.pivotlow(low, sync_len, sync_len)
if not na(ph_sw)
    swing_h := ph_sw
if not na(pl_sw)
    swing_l := pl_sw
bool cross_up = ta.crossover(close, swing_h)
bool cross_down = ta.crossunder(close, swing_l)
if not na(swing_h) and cross_up
    auto_trend := 1
if not na(swing_l) and cross_down
    auto_trend := -1
int final_trend = p1_connected ? p1_smc_trend : auto_trend
bgcolor(en_bg_trend ? (final_trend == 1 ? bg_bull_col : bg_bear_col) : na, title="Фон тренда")

var int bars_since_bos = 999
bars_since_bos := (p1_connected and p1_bos_trig != 0) ? 0 : math.min(bars_since_bos + 1, 999)

// ====================================================================================================================
// МОДУЛЬ KDE RSI (UserUZR, скрыт под капот)
// ====================================================================================================================
f_gaussian(float dist, float bw) => 1.0/math.sqrt(2.0*math.pi)*math.pow(math.e, -0.5*math.pow(dist/bw, 2.0))
f_uniform(float dist, float bw) => (math.abs(dist) > bw) ? 0.0 : 0.5
f_sigmoid(float dist, float bw) => 2.0/math.pi*(1.0/(math.pow(math.e, (dist/bw))+math.pow(math.e, -(dist/bw))))

f_kde(array<float> arr, string kernel, float bw, int steps) =>
    arrSize = arr.size()
    arrRange = arr.range()
    arrMin = arr.min()
    stepCount = arrRange / math.max(steps, 1)
    densityRange = array.new<float>(steps * 2)
    for i = 0 to (steps*2)-1
        densityRange.set(i, arrMin + i * stepCount)
    xArr = array.new<float>()
    yArr = array.new<float>()
    for i = 0 to densityRange.size()-1
        float temp = 0
        for j = 0 to arr.size()-1
            switch kernel
                "Gaussian" => temp += f_gaussian(densityRange.get(i)-arr.get(j), 1.0/bw)
                "Uniform" => temp += f_uniform(densityRange.get(i)-arr.get(j), 1.0/bw)
                "Sigmoid" => temp += f_sigmoid(densityRange.get(i)-arr.get(j), 1.0/bw)
        xArr.push(densityRange.get(i))
        yArr.push(1.0/math.max(arrSize,1)*temp)
    [xArr, yArr]

f_prefixSum(array<float> arr, int l, int r) => arr.get(r) - (l == 0 ? 0 : arr.get(l-1))

float kde_rsi = na
bool osc_kde_bull = false
bool osc_kde_bear = false
var array<float> highPivotRSIs = array.new<float>()
var array<float> lowPivotRSIs = array.new<float>()
var array<float> KDEHighX = array.new<float>()
var array<float> KDEHighY = array.new<float>()
var array<float> KDEHighYSum = array.new<float>()
var array<float> KDELowX = array.new<float>()
var array<float> KDELowY = array.new<float>()
var array<float> KDELowYSum = array.new<float>()
var bool in_kde_bull = false
var bool in_kde_bear = false

if en_mod_kde
    kde_rsi := ta.rsi(close, kde_rsi_len)
    float kde_hp = ta.pivothigh(high, kde_piv_len, kde_piv_len)
    float kde_lp = ta.pivotlow(low, kde_piv_len, kde_piv_len)
    float lowProb = 0.0
    float highProb = 0.0
    if not na(kde_hp)
        if highPivotRSIs.size() > 100
            highPivotRSIs.remove(0)
        highPivotRSIs.push(kde_rsi[kde_piv_len])
        [kx, ky] = f_kde(highPivotRSIs, kde_kernel, kde_bandw, kde_steps)
        KDEHighX := kx, KDEHighY := ky, KDEHighYSum.clear()
        float tH = 0.0
        for i = 0 to KDEHighY.size()-1
            tH += KDEHighY.get(i)
            KDEHighYSum.push(tH)
    if not na(kde_lp)
        if lowPivotRSIs.size() > 100
            lowPivotRSIs.remove(0)
        lowPivotRSIs.push(kde_rsi[kde_piv_len])
        [lx, ly] = f_kde(lowPivotRSIs, kde_kernel, kde_bandw, kde_steps)
        KDELowX := lx, KDELowY := ly, KDELowYSum.clear()
        float tL = 0.0
        for i = 0 to KDELowY.size()-1
            tL += KDELowY.get(i)
            KDELowYSum.push(tL)
    if highPivotRSIs.size() > 0 and KDEHighX.size() > 0
        int sL = array.binary_search_leftmost(KDEHighX, kde_rsi)
        int sR = array.binary_search_rightmost(KDEHighX, kde_rsi)
        int iL = math.max(0, math.min(sL, KDEHighX.size()-1))
        int iR = math.max(0, math.min(sR, KDEHighX.size()-1))
        int ni = (math.abs(kde_rsi-KDEHighX.get(iL)) < math.abs(kde_rsi-KDEHighX.get(iR))) ? iL : iR
        highProb := f_prefixSum(KDEHighYSum, 0, ni)
    if lowPivotRSIs.size() > 0 and KDELowX.size() > 0
        int sL = array.binary_search_leftmost(KDELowX, kde_rsi)
        int sR = array.binary_search_rightmost(KDELowX, kde_rsi)
        int iL = math.max(0, math.min(sL, KDELowX.size()-1))
        int iR = math.max(0, math.min(sR, KDELowX.size()-1))
        int ni = (math.abs(kde_rsi-KDELowX.get(iL)) < math.abs(kde_rsi-KDELowX.get(iR))) ? iL : iR
        lowProb := f_prefixSum(KDELowYSum, ni, KDELowYSum.size()-1)
    float act_thresh = kde_thresh == "High" ? 0.4 : kde_thresh == "Medium" ? 0.25 : 0.15
    bool curr_in_bull = KDELowY.size() > 0 and lowProb > array.get(KDELowYSum, KDELowYSum.size()-1) * (1.0 - act_thresh)
    bool curr_in_bear = KDEHighY.size() > 0 and highProb > array.get(KDEHighYSum, KDEHighYSum.size()-1) * (1.0 - act_thresh)
    osc_kde_bull := not curr_in_bull and in_kde_bull
    osc_kde_bear := not curr_in_bear and in_kde_bear
    in_kde_bull := curr_in_bull
    in_kde_bear := curr_in_bear

// ====================================================================================================================
// МОДУЛЬ STOCH Z-SCORE (скрыт под капот)
// ====================================================================================================================
bool osc_stoch_bull = false
bool osc_stoch_bear = false
float smoothed_scaled = na
if en_mod_stoch
    float stoch_basis = ta.sma(stoch_z_src, stoch_z_len)
    float stoch_stdev = ta.stdev(stoch_z_src, stoch_z_len)
    float zscore = stoch_stdev == 0 ? 0.0 : (stoch_z_src - stoch_basis) / stoch_stdev
    float highest_z = ta.highest(zscore, stoch_z_len)
    float lowest_z = ta.lowest(zscore, stoch_z_len)
    float range_z = highest_z - lowest_z
    float stochZ = range_z == 0 ? 50.0 : 100.0 * (zscore - lowest_z) / range_z
    float scaledSZ = (stochZ / 25.0) - 2.0
    smoothed_scaled := ta.hma(scaledSZ, stoch_z_len)
    float prev = nz(smoothed_scaled[1], 0.0)
    float ltm = nz(ta.alma(zscore, stoch_z_len, 0.0, 0.1), 0.0)
    osc_stoch_bull := ta.crossover(smoothed_scaled, prev) and prev < stoch_z_os and (stoch_strict ? ltm > 0 : true)
    osc_stoch_bear := ta.crossunder(smoothed_scaled, prev) and prev > stoch_z_ob and (stoch_strict ? ltm < 0 : true)

// ====================================================================================================================
// МОДУЛЬ ADAPTIVE MACD DELUXE (скрыт под капот)
// ====================================================================================================================
bool osc_macd_dlx_bull = false
bool osc_macd_dlx_bear = false
float dlx_macSeries = na
var float mac_dlx = 0.0
if en_mod_dlx
    float dlx_r = ta.correlation(close, bar_index, macd_dlx_r2)
    float dlx_detWgt = 0.5 + 0.5 * nz(math.pow(dlx_r, 2), 0.0)
    float dlx_fastK = 2.0 / (macd_dlx_fast + 1)
    float dlx_slowK = 2.0 / (macd_dlx_slow + 1)
    float dlx_blend = dlx_detWgt * (1-dlx_fastK) * (1-dlx_slowK) + (1-dlx_detWgt) * (1-dlx_fastK) / (1-dlx_slowK)
    mac_dlx := (close - nz(close[1], close)) * (dlx_fastK - dlx_slowK) + (2-dlx_fastK-dlx_slowK) * nz(mac_dlx[1], 0.0) - dlx_blend * nz(mac_dlx[2], 0.0)
    float dlx_hl_ema = ta.ema(high - low, macd_dlx_slow)
    dlx_macSeries := dlx_hl_ema == 0 ? 0.0 : (mac_dlx / dlx_hl_ema * 100.0)
    osc_macd_dlx_bull := ta.crossover(dlx_macSeries, macd_dlx_os)
    osc_macd_dlx_bear := ta.crossunder(dlx_macSeries, macd_dlx_ob)

// ====================================================================================================================
// МОДУЛЬ ADVANCED CCI (скрыт под капот)
// ====================================================================================================================
bool osc_cci_bull = false
bool osc_cci_bear = false
var float st_TrendUp = na
var float st_TrendDown = na
var int st_Trend = 1
if en_mod_cci
    float st_cci_val = ta.cci(close, cci_st_len)
    float st_Up = hl2 - (cci_st_factor * ta.atr(cci_st_pd))
    float st_Dn = hl2 + (cci_st_factor * ta.atr(cci_st_pd))
    st_TrendUp := nz(st_cci_val[1]) > 0 ? math.max(st_Up, nz(st_TrendUp, st_Up)) : st_Up
    st_TrendDown := nz(st_cci_val[1]) < 0 ? math.min(st_Dn, nz(st_TrendDown, st_Dn)) : st_Dn
    st_Trend := st_cci_val > 0 ? 1 : st_cci_val < 0 ? -1 : nz(st_Trend[1], 1)
    float st_tsl = st_Trend == 1 ? st_TrendUp : st_TrendDown
    float l3_typ = (high + low + close) / 3.0
    float l3_dev = ta.dev(l3_typ, cci_l3_len)
    float l3_cci_val = (l3_typ - ta.sma(l3_typ, cci_l3_len)) / (0.015 * math.max(l3_dev, 1e-10))
    float l3_ci_val = ta.ema(l3_cci_val, cci_l3_ci)
    osc_cci_bull := ta.crossover(close, st_tsl) or (ta.crossover(l3_cci_val, l3_ci_val) and l3_cci_val < 0)
    osc_cci_bear := ta.crossunder(close, st_tsl) or (ta.crossunder(l3_cci_val, l3_ci_val) and l3_cci_val > 0)

// ====================================================================================================================
// МОДУЛЬ SMART MONEY ACTIVITY + CVD (с инпутами)
// ====================================================================================================================
bool sm_act_bull = false
bool sm_act_bear = false
var array<float> sm_vols = array.new<float>()
var float cvd = 0.0
var array<float> cvd_hist_arr = array.new<float>()
bool cvd_bull_div = false
bool cvd_bear_div = false
bool sm_absorption = false
var bool sm_absorp_bull_dom = false
var bool sm_absorp_bear_dom = false
if en_mod_smact
    float[] lt_v = global_lt_v
    float[] lt_c = global_lt_c
    float[] lt_o = global_lt_o
    int res_size = array.size(lt_v)
    int sm_maximum = sm_act_zlen * math.max(1, res_size)
    if res_size > 0
        float bar_cvd = 0.0, float max_bull_vol = 0.0, float max_bear_vol = 0.0
        for i = 0 to res_size-1
            float v = array.get(lt_v, i)
            float c = array.get(lt_c, i)
            float o = array.get(lt_o, i)
            if c > o
                bar_cvd += v, max_bull_vol := math.max(max_bull_vol, v)
            else if c < o
                bar_cvd -= v, max_bear_vol := math.max(max_bear_vol, v)
        array.unshift(cvd_hist_arr, bar_cvd)
        if array.size(cvd_hist_arr) > 50
            array.pop(cvd_hist_arr)
        cvd := array.sum(cvd_hist_arr)
        sm_absorp_bull_dom := false
        sm_absorp_bear_dom := false
        if max_bull_vol > (ta.sma(volume, 50) * 0.5) and max_bear_vol > (ta.sma(volume, 50) * 0.5)
            sm_absorption := true
            sm_absorp_bull_dom := max_bull_vol >= max_bear_vol
            sm_absorp_bear_dom := max_bear_vol > max_bull_vol
        cvd_bull_div := close < ta.sma(close, 10) and cvd > ta.sma(cvd, 10)
        cvd_bear_div := close > ta.sma(close, 10) and cvd < ta.sma(cvd, 10)
        for i = res_size-1 to 0
            array.unshift(sm_vols, array.get(lt_v, i))
        while array.size(sm_vols) > sm_maximum
            array.pop(sm_vols)
        float volsAvg = array.avg(sm_vols), float volsStdev = array.stdev(sm_vols)
        if volsStdev > 0
            float max_z = 0.0, int max_idx = -1
            for i = 0 to res_size-1
                float az = (array.get(lt_v, i) - volsAvg) / volsStdev
                if az > max_z
                    max_z := az, max_idx := i
            if max_z > sm_act_th and max_idx != -1
                float ic = array.get(lt_c, max_idx)
                float io = array.get(lt_o, max_idx)
                bool isBull = ic > io
                float bMin = math.min(open, close), float bMax = math.max(open, close)
                bool cls2 = math.abs(ic - close) < syminfo.mintick or (ic > bMin and ic < bMax)
                bool cls1 = (ic >= bMin*0.995 and ic <= bMax*1.005) and not cls2
                if cls2
                    if isBull
                        sm_act_bull := true
                    else
                        sm_act_bear := true
                else if cls1 and max_z > sm_act_th*1.3
                    if isBull
                        sm_act_bull := true
                    else
                        sm_act_bear := true

// ====================================================================================================================
// ЕДИНЫЙ TMR-МАССИВ ТАЙМЕРОВ (16 элементов) — заполнение (индекс 15 = LVZ подтверждён, ТЗ B.3)
// ====================================================================================================================
bool[] TMR_COND_BULL = array.from(tier_ltf1_bull, tier_ltf2_bull, tier_ltf3_bull, tier_htf1_bull, tier_htf2_bull, tier_htf3_bull, (p1_connected and p1_choch_src == 1), (p1_connected and p1_hm_src == 1), (p1_connected and p1_sweep_src == 1), (p1_connected and p1_sdinv_src == 1), (p1_connected and p1_ob_touch_src == 1), (p1_connected and p1_disp_src == 1), (p1_connected and p1_zone_conf_bull_src == 1), (p1_connected and p1_choch_sw_bull_src == 1), sm_act_bull, (p1_connected and p1_lvz_bull == 2))
bool[] TMR_COND_BEAR = array.from(tier_ltf1_bear, tier_ltf2_bear, tier_ltf3_bear, tier_htf1_bear, tier_htf2_bear, tier_htf3_bear, (p1_connected and p1_choch_src == -1), (p1_connected and p1_hm_src == -1), (p1_connected and p1_sweep_src == -1), (p1_connected and p1_sdinv_src == -1), (p1_connected and p1_ob_touch_src == -1), (p1_connected and p1_disp_src == -1), (p1_connected and p1_zone_conf_bear_src == 1), (p1_connected and p1_choch_sw_bear_src == 1), sm_act_bear, (p1_connected and p1_lvz_bear == 2))

for i = 0 to 15
    bar_timer t = TMR.get(i)
    t.bull := TMR_COND_BULL.get(i) ? 0 : math.min(t.bull + 1, 999)
    t.bear := TMR_COND_BEAR.get(i) ? 0 : math.min(t.bear + 1, 999)

int mtf_state_raw_bull = (TMR.get(0).bull<=mtf_window?1:0)+(TMR.get(1).bull<=mtf_window?1:0)+(TMR.get(2).bull<=mtf_window?1:0)
int mtf_state_raw_bear = (TMR.get(0).bear<=mtf_window?1:0)+(TMR.get(1).bear<=mtf_window?1:0)+(TMR.get(2).bear<=mtf_window?1:0)
int htf_state_raw_bull = (TMR.get(3).bull<=htf_window?1:0)+(TMR.get(4).bull<=htf_window?1:0)+(TMR.get(5).bull<=htf_window?1:0)
int htf_state_raw_bear = (TMR.get(3).bear<=htf_window?1:0)+(TMR.get(4).bear<=htf_window?1:0)+(TMR.get(5).bear<=htf_window?1:0)

// ====================================================================================================================
// МОДУЛЬ SMART MONEY INDEX (скрыт под капот)
// ====================================================================================================================
bool sm_idx_bull = false
bool sm_idx_bear = false
float sm_net_index = na
if en_mod_smidx
    float safe_pvi = nz(ta.pvi, 1.0), float safe_nvi = nz(ta.nvi, 1.0)
    float sm_drsi = ta.rsi(safe_pvi - ta.ema(safe_pvi, 255), sm_idx_rr)
    float sm_srsi = ta.rsi(safe_nvi - ta.ema(safe_nvi, 255), sm_idx_rr)
    float dr_safe = sm_drsi == 0 ? 1e-10 : sm_drsi
    float di_safe = (100.0-sm_drsi) == 0 ? 1e-10 : (100.0-sm_drsi)
    float sb = math.sum(sm_srsi/dr_safe, sm_idx_x)
    float ss = math.sum((100.0-sm_srsi)/di_safe, sm_idx_x)
    float pk = ta.highest(math.max(sb, ss), sm_idx_peak)
    float pks = pk == 0 ? 1e-10 : pk
    sm_net_index := (sb/pks) - (ss/pks)
    if sm_idx_strict
        sm_idx_bull := ta.crossover(sm_net_index, sm_idx_thr)
        sm_idx_bear := ta.crossunder(sm_net_index, -sm_idx_thr)
    else
        sm_idx_bull := sm_net_index > sm_idx_thr and sm_net_index > nz(sm_net_index[1])
        sm_idx_bear := sm_net_index < -sm_idx_thr and sm_net_index < nz(sm_net_index[1])

// ====================================================================================================================
// МОДУЛЬ SMART MONEY INTEREST (скрыт под капот)
// ====================================================================================================================
bool sm_int_bull = false
bool sm_int_bear = false
if en_mod_smint
    float d = ta.pvi - ta.ema(ta.pvi, 255)
    float s = ta.nvi - ta.ema(ta.nvi, 255)
    float dr = ta.rsi(d, sm_int_rr), float sr = ta.rsi(s, sm_int_rr)
    float dr_s = dr == 0 ? 1e-10 : dr, float sr_s = sr == 0 ? 1e-10 : sr
    float sumb = math.sum(sr/dr_s, sm_int_x)
    float sums = math.sum(dr/sr_s, sm_int_x)
    float pkb = ta.highest(sumb, sm_int_peak)
    float pks_ = ta.highest(sums, sm_int_peak)
    sm_int_bull := sumb/(pkb==0?1e-10:pkb) > sm_int_thr
    sm_int_bear := sums/(pks_==0?1e-10:pks_) > sm_int_thr

bool sm_all3_bull = en_mod_smact and en_mod_smidx and en_mod_smint and sm_act_bull and sm_idx_bull and sm_int_bull
bool sm_all3_bear = en_mod_smact and en_mod_smidx and en_mod_smint and sm_act_bear and sm_idx_bear and sm_int_bear

// ====================================================================================================================
// МОДУЛЬ MULTI-INDICATOR DIVERGENCE Engine A (скрыт под капот)
// ====================================================================================================================
bool osc_mdiv_bull = false
bool osc_mdiv_bear = false
int total_mdiv_bull = 0
int total_mdiv_bear = 0
var int[] mdiv_ph_pos = array.new<int>(10, 0)
var int[] mdiv_pl_pos = array.new<int>(10, 0)
var float[] mdiv_ph_val = array.new<float>(10, 0.0)
var float[] mdiv_pl_val = array.new<float>(10, 0.0)
bool chk_reg = mdiv_type == "Regular" or mdiv_type == "Regular/Hidden"
bool chk_hid = mdiv_type == "Hidden" or mdiv_type == "Regular/Hidden"

f_check_pos_div(series float src, int cond_type) =>
    int div_found = 0
    if src > src[1] or close > close[1]
        for x = 0 to 9
            int len = bar_index - array.get(mdiv_pl_pos, x) + mdiv_prd
            if array.get(mdiv_pl_pos, x) == 0 or len > mdiv_maxb
                break
            if len > 5
                bool c1 = (cond_type == 1 and src[1] > src[len] and close[1] < array.get(mdiv_pl_val, x))
                bool c2 = (cond_type == 2 and src[1] < src[len] and close[1] > array.get(mdiv_pl_val, x))
                if c1 or c2
                    float s1 = (src[1]-src[len])/(len-1), float v1 = src[1]-s1
                    float s2 = (close[1]-close[len])/(len-1), float v2 = close[1]-s2
                    bool ok = true
                    for y = 2 to len-1
                        if src[y] < v1 or close[y] < v2
                            ok := false, break
                        v1 -= s1, v2 -= s2
                    if ok
                        div_found := 1, break
    div_found

f_check_neg_div(series float src, int cond_type) =>
    int div_found = 0
    if src < src[1] or close < close[1]
        for x = 0 to 9
            int len = bar_index - array.get(mdiv_ph_pos, x) + mdiv_prd
            if array.get(mdiv_ph_pos, x) == 0 or len > mdiv_maxb
                break
            if len > 5
                bool c1 = (cond_type == 1 and src[1] < src[len] and close[1] > array.get(mdiv_ph_val, x))
                bool c2 = (cond_type == 2 and src[1] > src[len] and close[1] < array.get(mdiv_ph_val, x))
                if c1 or c2
                    float s1 = (src[1]-src[len])/(len-1), float v1 = src[1]-s1
                    float s2 = (close[1]-close[len])/(len-1), float v2 = close[1]-s2
                    bool ok = true
                    for y = 2 to len-1
                        if src[y] > v1 or close[y] > v2
                            ok := false, break
                        v1 -= s1, v2 -= s2
                    if ok
                        div_found := 1, break
    div_found

f_add_div(series float src, bool en) =>
    int b = 0, int br = 0
    if en
        if chk_reg
            b += f_check_pos_div(src, 1)
            br += f_check_neg_div(src, 1)
        if chk_hid
            b += f_check_pos_div(src, 2)
            br += f_check_neg_div(src, 2)
    [b, br]

if en_mod_mdiv
    float mdiv_ph = ta.pivothigh(close, mdiv_prd, mdiv_prd)
    float mdiv_pl = ta.pivotlow(close, mdiv_prd, mdiv_prd)
    if not na(mdiv_ph)
        array.unshift(mdiv_ph_pos, bar_index), array.unshift(mdiv_ph_val, mdiv_ph)
        array.pop(mdiv_ph_pos), array.pop(mdiv_ph_val)
    if not na(mdiv_pl)
        array.unshift(mdiv_pl_pos, bar_index), array.unshift(mdiv_pl_val, mdiv_pl)
        array.pop(mdiv_pl_pos), array.pop(mdiv_pl_val)
    [b1,br1] = f_add_div(g_rsi, true), [b2,br2] = f_add_div(g_macdL, true)
    [b3,br3] = f_add_div(g_macdH, true), [b4,br4] = f_add_div(g_stc, true)
    [b5,br5] = f_add_div(g_cci, true), [b6,br6] = f_add_div(g_mom, true)
    [b7,br7] = f_add_div(g_obv, true), [b8,br8] = f_add_div(g_vwm, true)
    [b9,br9] = f_add_div(g_cmf, true), [b10,br10] = f_add_div(g_mfi, true)
    total_mdiv_bull := b1+b2+b3+b4+b5+b6+b7+b8+b9+b10
    total_mdiv_bear := br1+br2+br3+br4+br5+br6+br7+br8+br9+br10
    osc_mdiv_bull := total_mdiv_bull >= mdiv_limit
    osc_mdiv_bear := total_mdiv_bear >= mdiv_limit

bool osc_mdiv_multi_bull = osc_mdiv_bull and total_mdiv_bull >= 3
bool osc_mdiv_multi_bear = osc_mdiv_bear and total_mdiv_bear >= 3

// ====================================================================================================================
// МОДУЛЬ Div Engine B нерепейнт (скрыт под капот)
// ====================================================================================================================
bool osc_peter_bull = false
bool osc_peter_bear = false

f_div_engine_b(series float _osc, int _lbL, int _lbR, int _rL, int _rU) =>
    bool pl = not na(ta.pivotlow(_osc, _lbL, _lbR))
    bool ph = not na(ta.pivothigh(_osc, _lbL, _lbR))
    float opl = ta.valuewhen(pl, _osc[_lbR], 1), float cpl = ta.valuewhen(pl, low[_lbR], 1)
    float oph = ta.valuewhen(ph, _osc[_lbR], 1), float cph = ta.valuewhen(ph, high[_lbR], 1)
    int ls = ta.barssince(pl[1]), int hs = ta.barssince(ph[1])
    bool lr = ls >= _rL and ls <= _rU, bool hr = hs >= _rL and hs <= _rU
    int breg = (low[_lbR] < cpl and _osc[_lbR] > opl and lr and pl) ? 1 : 0
    int bhid = (low[_lbR] > cpl and _osc[_lbR] < opl and lr and pl) ? 1 : 0
    int sreg = (high[_lbR] > cph and _osc[_lbR] < oph and hr and ph) ? 1 : 0
    int shid = (high[_lbR] < cph and _osc[_lbR] > oph and hr and ph) ? 1 : 0
    [breg+bhid, sreg+shid]

if en_mod_peter
    int pt_b = 0, int pt_s = 0
    [b1,s1] = f_div_engine_b(g_rsi, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b1, pt_s+=s1
    [b2,s2] = f_div_engine_b(g_macdL, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b2, pt_s+=s2
    [b3,s3] = f_div_engine_b(g_macdH, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b3, pt_s+=s3
    [b4,s4] = f_div_engine_b(g_mom, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b4, pt_s+=s4
    [b5,s5] = f_div_engine_b(g_cci, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b5, pt_s+=s5
    [b6,s6] = f_div_engine_b(g_p_obv, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b6, pt_s+=s6
    [b7,s7] = f_div_engine_b(g_stc, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b7, pt_s+=s7
    [b8,s8] = f_div_engine_b(g_p_diosc, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b8, pt_s+=s8
    [b9,s9] = f_div_engine_b(g_vwm, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b9, pt_s+=s9
    [b10,s10] = f_div_engine_b(g_cmf, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b10, pt_s+=s10
    osc_peter_bull := pt_b >= peter_limit
    osc_peter_bear := pt_s >= peter_limit

// ====================================================================================================================
// МОДУЛЬ Div Engine C фрактальная (скрыт под капот)
// ====================================================================================================================
bool osc_tfdiv_bull = false
bool osc_tfdiv_bear = false
float tf_aoH = ta.sma(hl2, 5) - ta.sma(hl2, 34)
float tf_rsiH = ta.rsi(close, 14) - 50
float tf_hist = tfdiv_type == "MACD" ? g_macdH : tfdiv_type == "AO" ? tf_aoH : tf_rsiH
float tf_ema = ta.ema(close, 50)
bool tf_up_frac = not na(ta.pivothigh(tfdiv_n, tfdiv_n)) and close[tfdiv_n] > tf_ema
bool tf_dn_frac = not na(ta.pivotlow(tfdiv_n, tfdiv_n)) and close[tfdiv_n] < tf_ema
float t_h_lp = ta.valuewhen(tf_up_frac, high[tfdiv_n], 0)
float t_h_pp = ta.valuewhen(tf_up_frac, high[tfdiv_n], 1)
float t_h_lh = ta.valuewhen(tf_up_frac, tf_hist[tfdiv_n], 0)
float t_h_ph = ta.valuewhen(tf_up_frac, tf_hist[tfdiv_n], 1)
int t_h_lb = ta.valuewhen(tf_up_frac, bar_index[tfdiv_n], 0)
int t_h_pb = ta.valuewhen(tf_up_frac, bar_index[tfdiv_n], 1)
float t_l_lp = ta.valuewhen(tf_dn_frac, low[tfdiv_n], 0)
float t_l_pp = ta.valuewhen(tf_dn_frac, low[tfdiv_n], 1)
float t_l_lh = ta.valuewhen(tf_dn_frac, tf_hist[tfdiv_n], 0)
float t_l_ph = ta.valuewhen(tf_dn_frac, tf_hist[tfdiv_n], 1)
int t_l_lb = ta.valuewhen(tf_dn_frac, bar_index[tfdiv_n], 0)
int t_l_pb = ta.valuewhen(tf_dn_frac, bar_index[tfdiv_n], 1)
if en_mod_tfdiv
    bool bc = t_h_lh > 0 and t_h_ph > 0 and (t_h_lb+30 > bar_index) and (t_h_lb-t_h_pb < 30)
    osc_tfdiv_bear := ta.change(t_h_lp) != 0 and bc and t_h_lp > t_h_pp and t_h_lh < t_h_ph
    bool bc2 = t_l_lh < 0 and t_l_ph < 0 and (t_l_lb+30 > bar_index) and (t_l_lb-t_l_pb < 30)
    osc_tfdiv_bull := ta.change(t_l_lp) != 0 and bc2 and t_l_lp < t_l_pp and t_l_lh > t_l_ph

// ====================================================================================================================
// МОДУЛЬ SMT DIVERGENCES (с инпутами)
// ====================================================================================================================
bool osc_smt_bull = false
bool osc_smt_bear = false

f_get_smt_div(bool is_ph, float y2, float sym_y2) =>
    var float y1 = na, var float sy1 = na, var int cnt = 0, var int ldb = 0
    if bar_index - ldb > 50
        cnt := 0
    if y2 != y2[1] and sym_y2 != sym_y2[1]
        if not na(y1) and not na(sy1) and (y2-y1)*(sym_y2-sy1) < 0
            cnt += 1, ldb := bar_index
        sy1 := sym_y2, y1 := y2
    else if (is_ph and y2 > y2[1]) or (not is_ph and y2 < y2[1])
        sy1 := na, y1 := y2
    cnt

if en_mod_smt
    float smt_ph = fixnan(ta.pivothigh(smt_len, smt_len))
    float smt_pl = fixnan(ta.pivotlow(smt_len, smt_len))
    float sph1 = fixnan(ta.pivothigh(s_h1, smt_len, smt_len))
    float spl1 = fixnan(ta.pivotlow(s_l1, smt_len, smt_len))
    float sph2 = fixnan(ta.pivothigh(s_h2, smt_len, smt_len))
    float spl2 = fixnan(ta.pivotlow(s_l2, smt_len, smt_len))
    int ph1 = f_get_smt_div(true, smt_ph, sph1), int pl1 = f_get_smt_div(false, smt_pl, spl1)
    int ph2 = f_get_smt_div(true, smt_ph, sph2), int pl2 = f_get_smt_div(false, smt_pl, spl2)
    if smt_ph != nz(smt_ph[1]) and ((smt_use1 and ph1 > nz(ph1[1])) or (smt_use2 and ph2 > nz(ph2[1])))
        osc_smt_bear := true
    if smt_pl != nz(smt_pl[1]) and ((smt_use1 and pl1 > nz(pl1[1])) or (smt_use2 and pl2 > nz(pl2[1])))
        osc_smt_bull := true

// ====================================================================================================================
// СВЕЧНОЙ ДВИЖОК UserUZR — LIVE (каждый тик) + SIGNAL (заморозка на баре сигнала)
// ====================================================================================================================
float c_upper = ta.highest(cndl_minor_len)
float c_lower = ta.lowest(cndl_minor_len)
var int minor_dir = 0
if high == c_upper and minor_dir != 1
    minor_dir := 1
if low == c_lower and minor_dir != -1
    minor_dir := -1

bool rc = close < open
bool gc = close > open
float cand_top = math.max(open, close), float cand_bot = math.min(open, close)
float hl_width = high - low, float bod_width = cand_top - cand_bot
float hw_per = hl_width == 0 ? 0 : ((high - cand_top) / hl_width) * 100
float lw_per = hl_width == 0 ? 0 : ((cand_bot - low) / hl_width) * 100
float b_per = hl_width == 0 ? 0 : (bod_width / hl_width) * 100
bool is_doji = math.round_to_mintick(close) == math.round_to_mintick(open)
bool is_minor_bear = minor_dir < 0
bool is_minor_bull = minor_dir > 0

bool p_hammer = lw_per>(b_per*1.6) and b_per<50 and hw_per<7 and not is_doji and is_minor_bear
bool p_ihammer = hw_per>(b_per*1.6) and b_per<50 and lw_per<7 and not is_doji and is_minor_bear
bool p_rising_3 = gc[4] and b_per[4]>40 and rc[3] and cand_top[3]<=high[4] and cand_bot[3]>=low[4] and rc[2] and cand_top[2]<=high[4] and cand_bot[2]>=low[4] and rc[1] and cand_top[1]<=high[4] and cand_bot[1]>=low[4] and gc and close>high[4] and b_per>40 and is_minor_bull[4]
bool p_bull_eng = rc[1] and gc and bod_width>(bod_width[1]*0.5) and open<close[1] and cand_top>cand_top[1] and not p_rising_3 and not is_doji[1] and is_minor_bear
bool p_3ws = gc[2] and b_per[2]>55 and gc[1] and b_per[1]>55 and cand_bot[1]>=cand_bot[2] and cand_bot[1]<=cand_top[2] and close[1]>high[2] and gc and b_per>55 and cand_bot>=cand_bot[1] and cand_bot<=cand_top[1] and close>high[1] and is_minor_bear[2]
bool p_mstar = rc[2] and b_per[2]>65 and rc[1] and bod_width[1]<(bod_width[2]*0.6) and open[1]<close[2] and gc and close>hl2[2] and is_minor_bear[2]
bool p_bull_har = gc and high<=cand_top[1] and low>=cand_bot[1] and rc[1] and b_per<70 and is_minor_bear[1]
bool p_tw_bot = math.abs(low-low[1])<=syminfo.mintick*3 and gc and rc[1] and is_minor_bear[1]
bool p_sstar = hw_per>(b_per*1.6) and b_per<50 and lw_per<7 and not is_doji and is_minor_bull
bool p_hman = lw_per>(b_per*1.6) and b_per<50 and hw_per<7 and not is_doji and is_minor_bull
bool p_falling_3 = rc[4] and b_per[4]>40 and gc[3] and cand_top[3]<=high[4] and cand_bot[3]>=low[4] and gc[2] and cand_top[2]<=high[4] and cand_bot[2]>=low[4] and gc[1] and cand_top[1]<=high[4] and cand_bot[1]>=low[4] and rc and close<low[4] and b_per>40 and is_minor_bear[4]
bool p_bear_eng = gc[1] and rc and bod_width>(bod_width[1]*0.5) and open>close[1] and cand_bot<cand_bot[1] and not p_falling_3 and not is_doji[1] and is_minor_bull
bool p_3bc = rc[2] and b_per[2]>55 and rc[1] and b_per[1]>55 and cand_top[1]<=cand_top[2] and cand_top[1]>=cand_bot[2] and close[1]<low[2] and rc and b_per>55 and cand_top<=cand_top[1] and cand_top>=cand_bot[1] and close<low[1] and is_minor_bull[2]
bool p_estar = gc[2] and b_per[2]>65 and gc[1] and bod_width[1]<(bod_width[2]*0.6) and open[1]>close[2] and rc and close<hl2[2] and is_minor_bull[2]
bool p_bear_har = rc and high<=cand_top[1] and low>=cand_bot[1] and gc[1] and b_per<70 and is_minor_bull[1]
bool p_tw_top = math.abs(high-high[1])<=syminfo.mintick*3 and rc and gc[1] and is_minor_bull[1]
bool p_marub_bull = gc and b_per > 96 and is_minor_bear
bool p_marub_bear = rc and b_per > 96 and is_minor_bull
bool p_piercing = rc[1] and b_per[1]>50 and gc and open<low[1] and close>(cand_top[1]+cand_bot[1])/2 and close<cand_top[1] and is_minor_bear[1]
bool p_darkcloud = gc[1] and b_per[1]>50 and rc and open>high[1] and close<(cand_top[1]+cand_bot[1])/2 and close>cand_bot[1] and is_minor_bull[1]
bool p_outside_bull = high>high[1] and low<low[1] and gc and b_per>50 and is_minor_bear
bool p_outside_bear = high>high[1] and low<low[1] and rc and b_per>50 and is_minor_bull
bool p_belthold_bull = gc and math.abs(open-low)<=syminfo.mintick*2 and b_per>75 and is_minor_bear
bool p_belthold_bear = rc and math.abs(open-high)<=syminfo.mintick*2 and b_per>75 and is_minor_bull
bool p_3in_up = p_bull_har[1] and gc and close>cand_top[2] and is_minor_bear[2]
bool p_3in_dn = p_bear_har[1] and rc and close<cand_bot[2] and is_minor_bull[2]
bool p_dragonfly = is_doji and lw_per>65 and hw_per<6 and is_minor_bear
bool p_gravestone = is_doji and hw_per>65 and lw_per<6 and is_minor_bull
bool p_kicker_bull = rc[1] and open>high[1] and gc and b_per>70 and is_minor_bear[1]
bool p_kicker_bear = gc[1] and open<low[1] and rc and b_per>70 and is_minor_bull[1]
bool p_hcross_bull = high<=cand_top[1] and low>=cand_bot[1] and rc[1] and b_per<15 and is_minor_bear[1]
bool p_hcross_bear = high<=cand_top[1] and low>=cand_bot[1] and gc[1] and b_per<15 and is_minor_bull[1]

f_cndl_scan() =>
    bool bull = false
    bool bear = false
    string bull_name = ""
    string bear_name = ""
    if en_mod_cndl
        if en_kicker_bull and p_kicker_bull
            bull := true, bull_name := "Бычий Кикер"
        else if en_marub_bull and p_marub_bull
            bull := true, bull_name := "Маруботсу Бычий"
        else if en_belthold_bull and p_belthold_bull
            bull := true, bull_name := "Бычий Бэлт-Холд"
        else if en_piercing and p_piercing
            bull := true, bull_name := "Просвет в Облаках"
        else if en_3in_up and p_3in_up
            bull := true, bull_name := "Три Внутри Вверх"
        else if en_outside_bull and p_outside_bull
            bull := true, bull_name := "Бычий Внешний Бар"
        else if en_hammer and p_hammer
            bull := true, bull_name := "Молот"
        else if en_ihammer and p_ihammer
            bull := true, bull_name := "Перевёрнутый Молот"
        else if en_bull_eng and p_bull_eng
            bull := true, bull_name := "Бычье Поглощение"
        else if en_r3 and p_rising_3
            bull := true, bull_name := "Метод 3 Поднимающихся"
        else if en_3ws and p_3ws
            bull := true, bull_name := "3 Белых Солдата"
        else if en_mstar and p_mstar
            bull := true, bull_name := "Утренняя Звезда"
        else if en_hcross_bull and p_hcross_bull
            bull := true, bull_name := "Харами Крест Бычий"
        else if en_bull_har and p_bull_har
            bull := true, bull_name := "Бычье Харами"
        else if en_tw_bot and p_tw_bot
            bull := true, bull_name := "Пинцет Дно"
        else if en_dragonfly and p_dragonfly
            bull := true, bull_name := "Дракон Доджи"
        if en_kicker_bear and p_kicker_bear
            bear := true, bear_name := "Медвежий Кикер"
        else if en_marub_bear and p_marub_bear
            bear := true, bear_name := "Маруботсу Медвежий"
        else if en_belthold_bear and p_belthold_bear
            bear := true, bear_name := "Медвежий Бэлт-Холд"
        else if en_darkcloud and p_darkcloud
            bear := true, bear_name := "Тёмное Облако"
        else if en_3in_dn and p_3in_dn
            bear := true, bear_name := "Три Внутри Вниз"
        else if en_outside_bear and p_outside_bear
            bear := true, bear_name := "Медвежий Внешний Бар"
        else if en_sstar and p_sstar
            bear := true, bear_name := "Падающая Звезда"
        else if en_hman and p_hman
            bear := true, bear_name := "Повешенный"
        else if en_bear_eng and p_bear_eng
            bear := true, bear_name := "Медвежье Поглощение"
        else if en_f3 and p_falling_3
            bear := true, bear_name := "Метод 3 Падающих"
        else if en_3bc and p_3bc
            bear := true, bear_name := "3 Чёрные Вороны"
        else if en_estar and p_estar
            bear := true, bear_name := "Вечерняя Звезда"
        else if en_hcross_bear and p_hcross_bear
            bear := true, bear_name := "Харами Крест Медвежий"
        else if en_bear_har and p_bear_har
            bear := true, bear_name := "Медвежье Харами"
        else if en_tw_top and p_tw_top
            bear := true, bear_name := "Пинцет Вершина"
        else if en_gravestone and p_gravestone
            bear := true, bear_name := "Надгробие Доджи"
    [bull, bear, bull_name, bear_name]

[cndl_bull, cndl_bear, cndl_bull_name, cndl_bear_name] = f_cndl_scan()
string cndl_name_live = cndl_bull ? cndl_bull_name : cndl_bear ? cndl_bear_name : "—"

plotshape(en_mod_cndl and cndl_show_lbl and cndl_bull, "Бычий паттерн", shape.triangleup, location.belowbar, cndl_bull_col, text="", size=size.tiny)
plotshape(en_mod_cndl and cndl_show_lbl and cndl_bear, "Медвежий паттерн", shape.triangledown, location.abovebar, cndl_bear_col, text="", size=size.tiny)
if en_mod_cndl and cndl_show_lbl and barstate.isconfirmed
    if cndl_bull
        label.new(bar_index, low - g_cndl_atr*0.2, text=cndl_bull_name, style=label.style_label_up, color=color.new(color.white,100), textcolor=cndl_bull_col, size=get_size(cndl_lbl_size))
    if cndl_bear
        label.new(bar_index, high + g_cndl_atr*0.2, text=cndl_bear_name, style=label.style_label_down, color=color.new(color.white,100), textcolor=cndl_bear_col, size=get_size(cndl_lbl_size))
barcolor(en_mod_cndl and cndl_bar_col ? (cndl_bull ? cndl_bull_col : cndl_bear ? cndl_bear_col : na) : na)

// ====================================================================================================================
// P1 СТРУКТУРНЫЕ БУЛЕВЫ
// ====================================================================================================================
bool b_smc_bull = p1_connected ? p1_smc_trend == 1 : false
bool b_smc_bear = p1_connected ? p1_smc_trend == -1 : false
bool b_ob_bull = p1_connected ? p1_ob_signal == 1 : false
bool b_ob_bear = p1_connected ? p1_ob_signal == -1 : false
bool b_sd_bull = p1_connected ? p1_sd_zone == 1 : false
bool b_sd_bear = p1_connected ? p1_sd_zone == -1 : false
bool b_fvg_bull = p1_connected ? p1_fvg_dir == 1 : false
bool b_fvg_bear = p1_connected ? p1_fvg_dir == -1 : false
bool b_bos_bull = p1_connected ? (bars_since_bos <= bos_bars_ok and p1_smc_trend == 1) : false
bool b_bos_bear = p1_connected ? (bars_since_bos <= bos_bars_ok and p1_smc_trend == -1) : false
bool b_bb_bull = p1_bb_signal == 1
bool b_bb_bear = p1_bb_signal == -1
bool b_hm_bull = p1_hm_signal == 1
bool b_hm_bear = p1_hm_signal == -1
bool b_sdinv_bull = TMR.get(9).bull <= 2
bool b_sdinv_bear = TMR.get(9).bear <= 2
bool b_sweep_bull = p1_sweep_signal == 1
bool b_sweep_bear = p1_sweep_signal == -1
bool b_choch_bull = p1_choch_signal == 1
bool b_choch_bear = p1_choch_signal == -1
bool b_ob_fresh_bull = TMR.get(10).bull <= 2
bool b_ob_fresh_bear = TMR.get(10).bear <= 2
bool b_disp_bull = TMR.get(11).bull <= 2
bool b_disp_bear = TMR.get(11).bear <= 2
bool b_fvg_precise_bull = p1_connected and is_conn(p1_fvg_top_src) and is_conn(p1_fvg_bot_src) and not na(p1_fvg_top) and not na(p1_fvg_bot) and close<=p1_fvg_top and close>=p1_fvg_bot and p1_fvg_dir == 1
bool b_fvg_precise_bear = p1_connected and is_conn(p1_fvg_top_src) and is_conn(p1_fvg_bot_src) and not na(p1_fvg_top) and not na(p1_fvg_bot) and close<=p1_fvg_top and close>=p1_fvg_bot and p1_fvg_dir == -1

float fvg_poc_level = (not na(p1_fvg_top) and not na(p1_fvg_bot)) ? (p1_fvg_top + p1_fvg_bot) / 2.0 : na
bool b_fvg_poc_bull = p1_connected and not na(fvg_poc_level) and p1_fvg_dir == 1 and math.abs(close - fvg_poc_level) <= atr14*0.1
bool b_fvg_poc_bear = p1_connected and not na(fvg_poc_level) and p1_fvg_dir == -1 and math.abs(close - fvg_poc_level) <= atr14*0.1

bool b_zone_conf_bull = TMR.get(12).bull <= 4
bool b_zone_conf_bear = TMR.get(12).bear <= 4
bool b_choch_sw_bull = TMR.get(13).bull <= 2
bool b_choch_sw_bear = TMR.get(13).bear <= 2
bool b_ob_sd_bull = p1_ob_sd_bull
bool b_ob_sd_bear = p1_ob_sd_bear
bool b_ob_virgin_bull = is_conn(p1_ob_touch_cnt_bull_src) and p1_ob_touch_cnt_bull <= 1
bool b_ob_virgin_bear = is_conn(p1_ob_touch_cnt_bear_src) and p1_ob_touch_cnt_bear <= 1
bool b_ob_touch_fresh1_bull = is_conn(p1_ob_touch_cnt_bull_src) and p1_ob_touch_cnt_bull == 1
bool b_ob_touch_fresh1_bear = is_conn(p1_ob_touch_cnt_bear_src) and p1_ob_touch_cnt_bear == 1
bool b_master_bull = p1_connected and p1_master == 1
bool b_master_bear = p1_connected and p1_master == -1
bool b_conf_bull_ok = p1_connected and p1_conf_bull >= 7
bool b_conf_bear_ok = p1_connected and p1_conf_bear >= 7
bool b_candle_inside_ob_bull = (b_ob_bull) and cndl_bull
bool b_candle_inside_ob_bear = (b_ob_bear) and cndl_bear

bool b_lvz_bull = p1_connected and p1_lvz_bull >= 1
bool b_lvz_bear = p1_connected and p1_lvz_bear >= 1
bool b_lvz_confirmed_bull = p1_connected and p1_lvz_bull == 2
bool b_lvz_confirmed_bear = p1_connected and p1_lvz_bear == 2

// ====================================================================================================================
// OTE РАСЧЁТЫ (включая новый фактор f78 — OTE обычный, точная зона 0.618-0.786)
// ====================================================================================================================
var float recent_swing_h = na
var float recent_swing_l = na
if p1_connected and (p1_choch_src != 0 or p1_bos_trig != 0)
    recent_swing_h := high, recent_swing_l := low
else
    recent_swing_h := math.max(nz(recent_swing_h, high), high)
    recent_swing_l := math.min(nz(recent_swing_l, low), low)

float ote_swing_h = is_conn(p1_swing_h_src) ? p1_swing_h : recent_swing_h
float ote_swing_l = is_conn(p1_swing_l_src) ? p1_swing_l : recent_swing_l
float ote_range = nz(ote_swing_h) - nz(ote_swing_l)
float ote_long_top = nz(ote_swing_h) - (ote_range*0.618)
float ote_long_bot = nz(ote_swing_h) - (ote_range*0.786)
float disc_long_top = nz(ote_swing_h) - (ote_range*0.5)
float ote_short_bot = nz(ote_swing_l) + (ote_range*0.618)
float ote_short_top = nz(ote_swing_l) + (ote_range*0.786)
float prem_short_bot = nz(ote_swing_l) + (ote_range*0.5)
int ote_score_bull = (ote_range>0 and close<=ote_long_top and close>=ote_long_bot) ? 2 : (ote_range>0 and close<disc_long_top) ? 1 : 0
int ote_score_bear = (ote_range>0 and close>=ote_short_bot and close<=ote_short_top) ? 2 : (ote_range>0 and close>prem_short_bot) ? 1 : 0
if p1_ote_zone == 1
    ote_score_bull := math.max(ote_score_bull, 2)
else if p1_ote_zone == -1
    ote_score_bear := math.max(ote_score_bear, 2)
bool b_pd_bull = p1_connected ? (ote_score_bull >= 1) : false
bool b_pd_bear = p1_connected ? (ote_score_bear >= 1) : false

// ── НОВОЕ (f78): OTE обычный — строго точная зона 0.618-0.786, независимо от Prem/Discount (f24) ──
bool b_ote_zone_bull = ote_score_bull >= 2
bool b_ote_zone_bear = ote_score_bear >= 2

bool b_ote_conf_bull = p1_connected and is_conn(p1_ote_conf_bull_src) and p1_ote_conf_bull_src >= 0.5
bool b_ote_conf_bear = p1_connected and is_conn(p1_ote_conf_bear_src) and p1_ote_conf_bear_src >= 0.5

bool b_avwap_bull = is_conn(p1_avwap_fast_src) and not na(p1_avwap_fast) ? (close>p1_avwap_fast) : (is_conn(p1_avwap_src) and not na(p1_avwap) ? close>p1_avwap : false)
bool b_avwap_bear = is_conn(p1_avwap_fast_src) and not na(p1_avwap_fast) ? (close<p1_avwap_fast) : (is_conn(p1_avwap_src) and not na(p1_avwap) ? close<p1_avwap : false)
bool b_avwap_cross_bull = is_conn(p1_avwap_fast_src) and not na(p1_avwap_fast) ? ta.crossover(close, p1_avwap_fast) : (is_conn(p1_avwap_src) and not na(p1_avwap) ? ta.crossover(close, p1_avwap) : false)
bool b_avwap_cross_bear = is_conn(p1_avwap_fast_src) and not na(p1_avwap_fast) ? ta.crossunder(close, p1_avwap_fast) : (is_conn(p1_avwap_src) and not na(p1_avwap) ? ta.crossunder(close, p1_avwap) : false)

// ── LVZ Confluence-усилители (используются и в скоринге f72-f75, и в тексте) ──
bool b_lvz_sweep_bull = b_lvz_confirmed_bull and TMR.get(8).bull <= 2
bool b_lvz_sweep_bear = b_lvz_confirmed_bear and TMR.get(8).bear <= 2
bool b_lvz_cvd_bull = b_lvz_confirmed_bull and cvd_bull_div
bool b_lvz_cvd_bear = b_lvz_confirmed_bear and cvd_bear_div
bool b_lvz_ob_bull = b_lvz_confirmed_bull and b_ob_bull
bool b_lvz_ob_bear = b_lvz_confirmed_bear and b_ob_bear
bool b_lvz_avwap_bull = b_lvz_confirmed_bull and b_avwap_cross_bull
bool b_lvz_avwap_bear = b_lvz_confirmed_bear and b_avwap_cross_bear

// ── Условия ТЗ 6.3 (f70, f71) ──
bool b_cvd_mdiv_bull = cvd_bull_div and osc_mdiv_bull
bool b_cvd_mdiv_bear = cvd_bear_div and osc_mdiv_bear
bool b_regime_smc_bull = final_regime_bull and b_smc_bull
bool b_regime_smc_bear = final_regime_bear and b_smc_bear

bool in_poi_bull = b_ob_bull or b_sd_bull or b_fvg_precise_bull or ote_score_bull >= 2
bool in_poi_bear = b_ob_bear or b_sd_bear or b_fvg_precise_bear or ote_score_bear >= 2
int mtf_state_bull = (not in_poi_required or in_poi_bull) ? mtf_state_raw_bull : 0
int mtf_state_bear = (not in_poi_required or in_poi_bear) ? mtf_state_raw_bear : 0
int htf_bull_conf = htf_state_raw_bull
int htf_bear_conf = htf_state_raw_bear

bool ltf_gate_bull = (ltf_gate_min == 0 or mtf_state_bull >= ltf_gate_min or not p1_connected)
bool ltf_gate_bear = (ltf_gate_min == 0 or mtf_state_bear >= ltf_gate_min or not p1_connected)
bool htf_gate_bull = (htf_gate_min == 0 or htf_bull_conf >= htf_gate_min)
bool htf_gate_bear = (htf_gate_min == 0 or htf_bear_conf >= htf_gate_min)
bool full_gate_bull = ltf_gate_bull and htf_gate_bull
bool full_gate_bear = ltf_gate_bear and htf_gate_bear

int fresh_cnt_bull = (TMR.get(6).bull<=struct_fresh_bars?1:0)+(TMR.get(8).bull<=struct_fresh_bars?1:0)+(TMR.get(7).bull<=struct_fresh_bars?1:0)+(TMR.get(11).bull<=struct_fresh_bars?1:0)+(TMR.get(14).bull<=struct_fresh_bars?1:0)+(TMR.get(15).bull<=struct_fresh_bars?1:0)
int fresh_cnt_bear = (TMR.get(6).bear<=struct_fresh_bars?1:0)+(TMR.get(8).bear<=struct_fresh_bars?1:0)+(TMR.get(7).bear<=struct_fresh_bars?1:0)+(TMR.get(11).bear<=struct_fresh_bars?1:0)+(TMR.get(14).bear<=struct_fresh_bars?1:0)+(TMR.get(15).bear<=struct_fresh_bars?1:0)
bool struct_fresh_bull = fresh_cnt_bull >= 2
bool struct_fresh_bear = fresh_cnt_bear >= 2

tf_detail_strings tf_pack_bull = tf_detail_strings.new()
tf_detail_strings tf_pack_bear = tf_detail_strings.new()

tf_pack_bull.htf1 := "HTF1(" + htf_tv_1 + "): P1=" + str.tostring(p1_htf1_sb) + "/" + str.tostring(p1_htf1_min) + " OSC=" + str.tostring(p2_htf1_cnt_b) + "/10(мин." + str.tostring(p2_htf1_min_ok) + ")" + (tier_htf1_bull ? " ✅" : " —")
tf_pack_bull.htf2 := "HTF2(" + htf_tv_2 + "): P1=" + str.tostring(p1_htf2_sb) + "/" + str.tostring(p1_htf2_min) + " OSC=" + str.tostring(p2_htf2_cnt_b) + "/10(мин." + str.tostring(p2_htf2_min_ok) + ")" + (tier_htf2_bull ? " ✅" : " —")
tf_pack_bull.htf3 := "HTF3(" + htf_tv_3 + "): P1=" + str.tostring(p1_htf3_sb) + "/" + str.tostring(p1_htf3_min) + " OSC=" + str.tostring(p2_htf3_cnt_b) + "/10(мин." + str.tostring(p2_htf3_min_ok) + ")" + (tier_htf3_bull ? " ✅" : " —")
tf_pack_bear.htf1 := "HTF1(" + htf_tv_1 + "): P1=" + str.tostring(p1_htf1_ss) + "/" + str.tostring(p1_htf1_min) + " OSC=" + str.tostring(p2_htf1_cnt_s) + "/10(мин." + str.tostring(p2_htf1_min_ok) + ")" + (tier_htf1_bear ? " ✅" : " —")
tf_pack_bear.htf2 := "HTF2(" + htf_tv_2 + "): P1=" + str.tostring(p1_htf2_ss) + "/" + str.tostring(p1_htf2_min) + " OSC=" + str.tostring(p2_htf2_cnt_s) + "/10(мин." + str.tostring(p2_htf2_min_ok) + ")" + (tier_htf2_bear ? " ✅" : " —")
tf_pack_bear.htf3 := "HTF3(" + htf_tv_3 + "): P1=" + str.tostring(p1_htf3_ss) + "/" + str.tostring(p1_htf3_min) + " OSC=" + str.tostring(p2_htf3_cnt_s) + "/10(мин." + str.tostring(p2_htf3_min_ok) + ")" + (tier_htf3_bear ? " ✅" : " —")
tf_pack_bull.ltf1 := "LTF1(" + mtf_tv_1 + "м): P1=" + str.tostring(p1_ltf1_sb) + "/" + str.tostring(p1_ltf1_min) + " OSC=" + str.tostring(p2_ltf1_cnt_b) + "/10(мин." + str.tostring(p2_ltf1_min_ok) + ")" + (tier_ltf1_bull ? " ✅" : (TMR.get(0).bull<=mtf_window ? " ⏳" : " —"))
tf_pack_bull.ltf2 := "LTF2(" + mtf_tv_2 + "м): P1=" + str.tostring(p1_ltf2_sb) + "/" + str.tostring(p1_ltf2_min) + " OSC=" + str.tostring(p2_ltf2_cnt_b) + "/10(мин." + str.tostring(p2_ltf2_min_ok) + ")" + (tier_ltf2_bull ? " ✅" : (TMR.get(1).bull<=mtf_window ? " ⏳" : " —"))
tf_pack_bull.ltf3 := "LTF3(" + mtf_tv_3 + "м): P1=" + str.tostring(p1_ltf3_sb) + "/" + str.tostring(p1_ltf3_min) + " OSC=" + str.tostring(p2_ltf3_cnt_b) + "/10(мин." + str.tostring(p2_ltf3_min_ok) + ")" + (tier_ltf3_bull ? " ✅" : (TMR.get(2).bull<=mtf_window ? " ⏳" : " —"))
tf_pack_bear.ltf1 := "LTF1(" + mtf_tv_1 + "м): P1=" + str.tostring(p1_ltf1_ss) + "/" + str.tostring(p1_ltf1_min) + " OSC=" + str.tostring(p2_ltf1_cnt_s) + "/10(мин." + str.tostring(p2_ltf1_min_ok) + ")" + (tier_ltf1_bear ? " ✅" : (TMR.get(0).bear<=mtf_window ? " ⏳" : " —"))
tf_pack_bear.ltf2 := "LTF2(" + mtf_tv_2 + "м): P1=" + str.tostring(p1_ltf2_ss) + "/" + str.tostring(p1_ltf2_min) + " OSC=" + str.tostring(p2_ltf2_cnt_s) + "/10(мин." + str.tostring(p2_ltf2_min_ok) + ")" + (tier_ltf2_bear ? " ✅" : (TMR.get(1).bear<=mtf_window ? " ⏳" : " —"))
tf_pack_bear.ltf3 := "LTF3(" + mtf_tv_3 + "м): P1=" + str.tostring(p1_ltf3_ss) + "/" + str.tostring(p1_ltf3_min) + " OSC=" + str.tostring(p2_ltf3_cnt_s) + "/10(мин." + str.tostring(p2_ltf3_min_ok) + ")" + (tier_ltf3_bear ? " ✅" : (TMR.get(2).bear<=mtf_window ? " ⏳" : " —"))
tf_pack_bull.htf_verdict := htf_bull_conf == 3 ? "🟢 HTF: все 3 подтв." : htf_bull_conf == 2 ? "🟡 HTF: 2/3" : htf_bull_conf == 1 ? "⚪ HTF: 1/3" : "❌ HTF: нет"
tf_pack_bear.htf_verdict := htf_bear_conf == 3 ? "🟢 HTF: все 3 подтв." : htf_bear_conf == 2 ? "🟡 HTF: 2/3" : htf_bear_conf == 1 ? "⚪ HTF: 1/3" : "❌ HTF: нет"
tf_pack_bull.ltf_cascade_verdict := mtf_state_bull == 3 ? "🟢 LTF: все тиры" : mtf_state_bull == 2 ? "🟡 LTF: 2/3" : mtf_state_bull == 1 ? "⚪ LTF: 1/3" : (in_poi_required and in_poi_bull) ? "❌ LTF: не подтв." : (not in_poi_required) ? "— Без POI" : "— Вне POI"
tf_pack_bear.ltf_cascade_verdict := mtf_state_bear == 3 ? "🟢 LTF: все тиры" : mtf_state_bear == 2 ? "🟡 LTF: 2/3" : mtf_state_bear == 1 ? "⚪ LTF: 1/3" : (in_poi_required and in_poi_bear) ? "❌ LTF: не подтв." : (not in_poi_required) ? "— Без POI" : "— Вне POI"

string bos_retest_str_b = (not na(bos_level_price) and bos_level_dir == 1) ? "🎯 BOS(бык) " + str.tostring(bos_level_price, format.mintick) + " каса.:" + str.tostring(p1_bos_touches) + (bos_level_exhausted ? " (истощён)" : "") : ""
string bos_retest_str_s = (not na(bos_level_price) and bos_level_dir == -1) ? "🎯 BOS(медв) " + str.tostring(bos_level_price, format.mintick) + " каса.:" + str.tostring(p1_bos_touches) + (bos_level_exhausted ? " (истощён)" : "") : ""
string choch_retest_str_b = (not na(choch_level_price) and choch_level_dir == 1) ? "🎯 CHoCH(бык) " + str.tostring(choch_level_price, format.mintick) + " каса.:" + str.tostring(p1_choch_touches) + (choch_level_exhausted ? " (истощён)" : "") : ""
string choch_retest_str_s = (not na(choch_level_price) and choch_level_dir == -1) ? "🎯 CHoCH(медв) " + str.tostring(choch_level_price, format.mintick) + " каса.:" + str.tostring(p1_choch_touches) + (choch_level_exhausted ? " (истощён)" : "") : ""

side_detail pack_bull = side_detail.new()
side_detail pack_bear = side_detail.new()

// ====================================================================================================================
// СКОРИНГ — 68 факторов (f0-f67) + f68 (LVZ) + f69 (OTE Confluence) + f70-f77 (ТЗ синхронизации)
// + f78 (НОВЫЙ: OTE обычный, точная зона)
// ====================================================================================================================
int buy_score = 0
int sell_score = 0
bool buy_valid = true
bool sell_valid = true
if not p1_connected
    buy_valid := false, sell_valid := false

bool b_fvg_combo_bull = b_fvg_bull or b_fvg_precise_bull
bool b_fvg_combo_bear = b_fvg_bear or b_fvg_precise_bear
bool hmv_b = b_hm_bull and hm_vol_significant
bool hmv_s = b_hm_bear and hm_vol_significant
bool b_sweep_ob_bull = b_sweep_bull and b_ob_bull
bool b_sweep_ob_bear = b_sweep_bear and b_ob_bear
bool b_disp_ob_bull = b_disp_bull and b_ob_bull
bool b_disp_ob_bear = b_disp_bear and b_ob_bear
bool b_disp_fvg_bull = b_disp_bull and b_fvg_precise_bull
bool b_disp_fvg_bear = b_disp_bear and b_fvg_precise_bear
bool b_ob_avwap_bull = b_ob_bull and b_avwap_bull
bool b_ob_avwap_bear = b_ob_bear and b_avwap_bear
bool b_freshob_candle_bull = b_ob_virgin_bull and cndl_bull
bool b_freshob_candle_bear = b_ob_virgin_bear and cndl_bear
bool b_sd_fvg_bull = b_sd_bull and b_fvg_precise_bull
bool b_sd_fvg_bear = b_sd_bear and b_fvg_precise_bear
bool b_ote_ob_bull = (ote_score_bull >= 2) and b_ob_bull
bool b_ote_ob_bear = (ote_score_bear >= 2) and b_ob_bear
bool b_ote_sd_bull = (ote_score_bull >= 2) and b_sd_bull
