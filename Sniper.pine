// ====================================================================================================================
// 3.3 P2 TF ENGINE — КАЛИБРОВАННЫЕ ПАРАМЕТРЫ ПО ТАЙМФРЕЙМАМ (UserUZR)
// ====================================================================================================================
var p2_tf_params p2_ltf1 = p2_tf_params.new(9, 45,75, 25,55, 8,17,6, 5,13, 14, 14,2.0, 0.25,0.75, 9,3,3, 20.0,80.0, 14,2.0,7, 10, 0.50, 14,1.4)
var p2_tf_params p2_ltf2 = p2_tf_params.new(11, 45,75, 25,55, 10,21,7, 6,16, 17, 16,2.0, 0.28,0.72, 11,3,3, 22.0,78.0, 17,2.2,8, 12, 0.52, 17,1.4)
var p2_tf_params p2_ltf3 = p2_tf_params.new(14, 45,75, 25,55, 12,26,9, 8,21, 21, 20,2.0, 0.30,0.70, 14,3,3, 25.0,75.0, 20,2.5,10, 14, 0.55, 20,1.5)
var p2_tf_params p2_htf1 = p2_tf_params.new(18, 45,75, 25,55, 12,26,9, 10,30, 26, 24,2.1, 0.30,0.70, 18,4,4, 25.0,75.0, 24,2.8,12, 18, 0.58, 24,1.6)
var p2_tf_params p2_htf2 = p2_tf_params.new(21, 45,75, 25,55, 12,26,9, 13,34, 30, 26,2.2, 0.30,0.70, 21,5,5, 25.0,75.0, 28,3.0,14, 22, 0.60, 28,1.7)
var p2_tf_params p2_htf3 = p2_tf_params.new(25, 45,75, 25,55, 12,26,9, 21,50, 34, 30,2.3, 0.30,0.70, 25,5,5, 25.0,75.0, 32,3.2,16, 26, 0.62, 32,1.8)

p2_osc_engine(simple int rsi_len, simple float rsi_bull_lo, simple float rsi_bull_hi, simple float rsi_bear_lo, simple float rsi_bear_hi, simple int macd_fast, simple int macd_slow, simple int macd_sig, simple int ema_fast, simple int ema_slow, simple int zscore_len, simple int bb_len, simple float bb_mult, simple float bb_bull_max, simple float bb_bear_min, simple int srsi_len, simple int srsi_k, simple int srsi_d, simple float srsi_bull_max, simple float srsi_bear_min, simple int cci_len, simple float cci_factor, simple int cci_atr_len, simple int mdiv_len, simple float body_ratio, simple int vol_sma_len, simple float vol_z_th) =>
    float rsi_v = ta.rsi(close, rsi_len)
    bool rsi_bull = rsi_v >= rsi_bull_lo and rsi_v <= rsi_bull_hi
    bool rsi_bear = rsi_v >= rsi_bear_lo and rsi_v <= rsi_bear_hi
    [mac_l, mac_s, mac_h] = ta.macd(close, macd_fast, macd_slow, macd_sig)
    bool macd_bull = mac_l > mac_s or mac_h > 0
    bool macd_bear = mac_l < mac_s or mac_h < 0
    float ema_f = ta.ema(close, ema_fast)
    float ema_s = ta.ema(close, ema_slow)
    bool ema_bull = ema_f > ema_s
    bool ema_bear = ema_f < ema_s
    float zs_basis = ta.sma(close, zscore_len)
    float zs_dev = ta.stdev(close, zscore_len)
    float zscore = zs_dev > 0 ? (close - zs_basis) / zs_dev : 0.0
    bool zs_bull = zscore < -1.0
    bool zs_bear = zscore > 1.0
    float bb_basis = ta.sma(close, bb_len)
    float bb_dev = ta.stdev(close, bb_len) * bb_mult
    float bb_upper = bb_basis + bb_dev
    float bb_lower = bb_basis - bb_dev
    float bb_range = math.max(bb_upper - bb_lower, 1e-10)
    float bb_pctb = (close - bb_lower) / bb_range
    bool bb_bull = bb_pctb <= bb_bull_max
    bool bb_bear = bb_pctb >= bb_bear_min
    float rsi_for_stoch = ta.rsi(close, srsi_len)
    float stoch_rsi_raw = ta.stoch(rsi_for_stoch, rsi_for_stoch, rsi_for_stoch, srsi_len)
    float stoch_rsi_k = ta.sma(stoch_rsi_raw, srsi_k)
    float stoch_rsi_d = ta.sma(stoch_rsi_k, srsi_d)
    bool srsi_bull = stoch_rsi_k <= srsi_bull_max and stoch_rsi_k >= stoch_rsi_d
    bool srsi_bear = stoch_rsi_k >= srsi_bear_min and stoch_rsi_k <= stoch_rsi_d
    float cci_v = ta.cci(close, cci_len)
    float cci_atr = ta.atr(cci_atr_len)
    float cci_up = hl2 - (cci_factor * cci_atr)
    float cci_dn = hl2 + (cci_factor * cci_atr)
    bool cci_bull = cci_v > 0 and close > cci_up
    bool cci_bear = cci_v < 0 and close < cci_dn
    float price_now = close
    float price_then = close[mdiv_len]
    float rsi_now = rsi_v
    float rsi_then = rsi_v[mdiv_len]
    bool div_bull_reg = price_now < price_then and rsi_now > rsi_then
    bool div_bear_reg = price_now > price_then and rsi_now < rsi_then
    float macd_now = mac_l
    float macd_then = mac_l[mdiv_len]
    bool div_bull_macd = price_now < price_then and macd_now > macd_then
    bool div_bear_macd = price_now > price_then and macd_now < macd_then
    bool mdiv_bull = div_bull_reg or div_bull_macd
    bool mdiv_bear = div_bear_reg or div_bear_macd
    float body_r = math.abs(close - open) / math.max(high - low, syminfo.mintick)
    bool strong_body_bull = body_r > body_ratio and close > open
    bool strong_body_bear = body_r > body_ratio and close < open
    bool engulf_bull = close > open and close > high[1] and open < close[1]
    bool engulf_bear = close < open and close < low[1] and open > close[1]
    bool cndl_bull_eq = strong_body_bull or engulf_bull
    bool cndl_bear_eq = strong_body_bear or engulf_bear
    float vol_sma_v = ta.sma(volume, vol_sma_len)
    float vol_stdev_v = ta.stdev(volume, vol_sma_len)
    float vol_z = vol_stdev_v > 0 ? (volume - vol_sma_v) / vol_stdev_v : 0.0
    bool vol_spike = vol_z > vol_z_th
    bool vol_bull = vol_spike and close > open
    bool vol_bear = vol_spike and close < open
    int cnt_bull = (rsi_bull?1:0)+(macd_bull?1:0)+(ema_bull?1:0)+(zs_bull?1:0)+(bb_bull?1:0)+(srsi_bull?1:0)+(cci_bull?1:0)+(mdiv_bull?1:0)+(cndl_bull_eq?1:0)+(vol_bull?1:0)
    int cnt_bear = (rsi_bear?1:0)+(macd_bear?1:0)+(ema_bear?1:0)+(zs_bear?1:0)+(bb_bear?1:0)+(srsi_bear?1:0)+(cci_bear?1:0)+(mdiv_bear?1:0)+(cndl_bear_eq?1:0)+(vol_bear?1:0)
    [cnt_bull, cnt_bear]

