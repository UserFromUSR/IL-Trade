// 10. УПРАВЛЕНИЕ СДЕЛКОЙ
// ====================================================================================================================
grp_trade = "10. Управление сделкой"
en_trade_mgmt = input.bool(true, "🟢 Модуль сделки", group=grp_trade)
sl_mode = input.string("Под свечу сигнала", "Режим стопа", options=["% от входа", "Под свечу сигнала"], group=grp_trade)
