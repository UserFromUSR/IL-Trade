trade_lbl_text_col = input.color(color.black, "Цвет текста метки", inline="tlbl", group=grp_trade)
trade_lbl_text_size = input.string("tiny", "Размер текста метки", options=["auto","tiny","small","normal","large","huge"], group=grp_trade)

var trade_state cur_trade = trade_state.new()

f_calc_sl(bool is_bull, float entry_px, float sig_low, float sig_high) =>
    float sl_result = na
    if sl_mode == "% от входа"
        sl_result := is_bull ? entry_px * (1 - sl_pct/100) : entry_px * (1 + sl_pct/100)
    else
        sl_result := is_bull ? sig_low : sig_high
    sl_result

f_trade_preview(bool is_bull, float entry_px) =>
    float p_sl = f_calc_sl(is_bull, entry_px, low, high)
    float p_tp1 = is_bull ? entry_px * (1 + tp1_pct/100) : entry_px * (1 - tp1_pct/100)
    float p_tp2 = is_bull ? entry_px * (1 + tp2_pct/100) : entry_px * (1 - tp2_pct/100)
    float p_tp3 = is_bull ? entry_px * (1 + tp3_pct/100) : entry_px * (1 - tp3_pct/100)
    float p_sl_pct = math.abs(entry_px - p_sl) / entry_px * 100
    [p_sl, p_tp1, p_tp2, p_tp3, p_sl_pct]

f_trade_lvls_text(float p_sl, float p_tp1, float p_tp2, float p_tp3, float p_sl_pct) =>
    "🛡️ SL:" + str.tostring(p_sl, format.mintick) + "(" + str.tostring(p_sl_pct,"#.##") + "%,реж:" + sl_mode + ")\n" + "🎯 TP1:" + str.tostring(p_tp1, format.mintick) + "(" + str.tostring(tp1_pct,"#.##") + "%,vol" + str.tostring(tp1_vol,"#") + "%)\n" + "🎯 TP2:" + str.tostring(p_tp2, format.mintick) + "(" + str.tostring(tp2_pct,"#.##") + "%,vol" + str.tostring(tp2_vol,"#") + "%)\n" + "🎯 TP3:" + str.tostring(p_tp3, format.mintick) + "(" + str.tostring(tp3_pct,"#.##") + "%,остаток)" + (en_be_on_tp1 ? "\n🔄 БУ на TP1: вкл" : "")

f_trade_ref(trade_state t) =>
    string dir_str = t.is_buy ? "📈 ПОКУПКА" : "📉 ПРОДАЖА"
    "🔗 " + dir_str + " [" + t.grade + "]\n💲 Вход:" + str.tostring(t.entry, format.mintick) + "│🕐" + str.format_time(t.entry_time, "HH:mm dd.MM.yyyy", "UTC") + " UTC\n📊 " + syminfo.tickerid + "│🔗 " + "https://www.tradingview.com/chart/?symbol=" + syminfo.tickerid + "\n"

// ====================================================================================================================
// ГЕНЕРАЦИЯ СИГНАЛОВ — realtime intrabar + non-repaint итог
// ====================================================================================================================
bool signal_is_score_buy = p1_connected and (buy_score >= req_score and buy_valid and full_gate_bull)
bool signal_is_score_sell = p1_connected and (sell_score >= req_score and sell_valid and full_gate_bear)

var int intrabar_bar_idx_buy = -1
var int intrabar_bar_idx_sell = -1
var float intrabar_signal_price_buy = na
var float intrabar_signal_price_sell = na
if intrabar_bar_idx_buy != bar_index
    intrabar_signal_price_buy := na
    intrabar_bar_idx_buy := bar_index
if intrabar_bar_idx_sell != bar_index
    intrabar_signal_price_sell := na
    intrabar_bar_idx_sell := bar_index
if signal_is_score_buy and na(intrabar_signal_price_buy)
    intrabar_signal_price_buy := close
if signal_is_score_sell and na(intrabar_signal_price_sell)
    intrabar_signal_price_sell := close
if not signal_is_score_buy
    intrabar_signal_price_buy := na
if not signal_is_score_sell
    intrabar_signal_price_sell := na
bool intrabar_signal_live_buy = not na(intrabar_signal_price_buy) and not barstate.isconfirmed
bool intrabar_signal_live_sell = not na(intrabar_signal_price_sell) and not barstate.isconfirmed

var bool is_buy = false
var bool is_sell = false
var int bars_since_any_buy = 999
var int bars_since_any_sell = 999
var float signal_price_buy = na
var float signal_price_sell = na
var string signal_grade_buy = "NONE"
var string signal_grade_sell = "NONE"
var string signal_cndl_name_buy = "—"
var string signal_cndl_name_sell = "—"
is_buy := false
is_sell := false
bars_since_any_buy := math.min(bars_since_any_buy+1, 999)
bars_since_any_sell := math.min(bars_since_any_sell+1, 999)

if barstate.isconfirmed
    string grade_b_now = f_signal_grade(mtf_state_bull, htf_bull_conf, p1_zone_layers_bull, buy_score, req_score, final_regime_bull, b_lvz_confirmed_bull, b_ote_conf_bull)
    string grade_s_now = f_signal_grade(mtf_state_bear, htf_bear_conf, p1_zone_layers_bear, sell_score, req_score, final_regime_bear, b_lvz_confirmed_bear, b_ote_conf_bear)
    if signal_is_score_buy and bars_since_any_buy >= sig_lookback and f_grade_allowed(grade_b_now)
        is_buy := true, bars_since_any_buy := 0
        signal_price_buy := not na(intrabar_signal_price_buy) ? intrabar_signal_price_buy : close
        signal_grade_buy := grade_b_now
        signal_cndl_name_buy := cndl_name_live
    if signal_is_score_sell and bars_since_any_sell >= sig_lookback and f_grade_allowed(grade_s_now)
        is_sell := true, bars_since_any_sell := 0
        signal_price_sell := not na(intrabar_signal_price_sell) ? intrabar_signal_price_sell : close
        signal_grade_sell := grade_s_now
        signal_cndl_name_sell := cndl_name_live

