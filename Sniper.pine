// ====================================================================================================================
// 0. ПРЕСЕТ ЧУВСТВИТЕЛЬНОСТИ (2 профиля: Скальпинг, Консервативный A+ Only)
// ====================================================================================================================
grp_0 = "0. Пресет чувствительности"
preset_mode_p2 = input.string("Custom", "Профиль", options=["Custom", "Скальпинг", "Консервативный (A+ Only)"], group=grp_0)

f_preset_idx_p2() =>
    int idx = -1
    if preset_mode_p2 == "Скальпинг"
        idx := 0
    else if preset_mode_p2 == "Консервативный (A+ Only)"
        idx := 1
    idx

int preset_idx_p2 = f_preset_idx_p2()

var int[] PR_REQ_SCORE_OFS = array.from(-3, 5)
var int[] PR_GATE_OFS_LTF = array.from(-2, 1)
var int[] PR_GATE_OFS_HTF = array.from(-2, 1)
var bool[] PR_IN_POI_REQUIRED = array.from(false, true)

f_pr_score_p2(int base) =>
    int result = base
    if preset_idx_p2 >= 0
        result := math.max(1, base + PR_REQ_SCORE_OFS.get(preset_idx_p2))
    result

f_pr_gate_ltf_p2(int base) =>
    int result = base
    if preset_idx_p2 >= 0
        result := math.max(0, math.min(3, base + PR_GATE_OFS_LTF.get(preset_idx_p2)))
    result

f_pr_gate_htf_p2(int base) =>
    int result = base
    if preset_idx_p2 >= 0
        result := math.max(0, math.min(3, base + PR_GATE_OFS_HTF.get(preset_idx_p2)))
    result

f_pr_in_poi_required(bool manual_raw) =>
    bool result = manual_raw
    if preset_idx_p2 >= 0
        result := PR_IN_POI_REQUIRED.get(preset_idx_p2)
    result

// ====================================================================================================================
// 0.1 БЫСТРЫЙ ДОСТУП
// ====================================================================================================================
grp_quick_p2 = "0.1 Быстрый доступ"
qa_req_score_raw = input.int(4, "req_score", minval=1, maxval=90, group=grp_quick_p2)
qa_ltf1_min_ok_raw = input.int(3, "OSC10 мин LTF1", minval=1, maxval=10, inline="qosc_ltf", group=grp_quick_p2)
qa_ltf2_min_ok_raw = input.int(4, "LTF2", minval=1, maxval=10, inline="qosc_ltf", group=grp_quick_p2)
qa_ltf3_min_ok_raw = input.int(4, "LTF3", minval=1, maxval=10, inline="qosc_ltf", group=grp_quick_p2)
qa_htf1_min_ok_raw = input.int(4, "OSC10 мин HTF1", minval=1, maxval=10, inline="qosc_htf", group=grp_quick_p2)
qa_htf2_min_ok_raw = input.int(5, "HTF2", minval=1, maxval=10, inline="qosc_htf", group=grp_quick_p2)
qa_htf3_min_ok_raw = input.int(5, "HTF3", minval=1, maxval=10, inline="qosc_htf", group=grp_quick_p2)
qa_ltf_gate_min_raw = input.int(2, "Мин LTF тиров", minval=0, maxval=3, inline="qgate", group=grp_quick_p2)
qa_htf_gate_min_raw = input.int(2, "Мин HTF тиров", minval=0, maxval=3, inline="qgate", group=grp_quick_p2)
qa_in_poi_required_raw = input.bool(true, "Требовать POI (Custom)", group=grp_quick_p2)

// ====================================================================================================================
// 0.2 ГРЕЙДЫ
// ====================================================================================================================
grp_grade = "0.2 Грейды"
ga_w_ltf_raw = input.float(0.30, "Вес LTF", minval=0.0, maxval=1.0, step=0.05, inline="gw1", group=grp_grade)
ga_w_htf_raw = input.float(0.30, "Вес HTF", minval=0.0, maxval=1.0, step=0.05, inline="gw1", group=grp_grade)
ga_w_score_raw = input.float(0.40, "Вес скора", minval=0.0, maxval=1.0, step=0.05, inline="gw2", group=grp_grade)
ga_score_cap_raw = input.float(1.50, "Потолок доли скора", minval=1.0, maxval=3.0, step=0.1, inline="gw2", group=grp_grade)
ga_bonus_layers_raw = input.float(0.15, "Бонус Zone Confl≥2", minval=0.0, maxval=0.5, step=0.05, inline="gb1", group=grp_grade)
ga_bonus_regime_raw = input.float(0.10, "Бонус Regime match", minval=0.0, maxval=0.5, step=0.05, inline="gb1", group=grp_grade)
ga_bonus_lvz_raw = input.float(0.05, "Бонус LVZ подтверждён", minval=0.0, maxval=0.3, step=0.01, inline="gb2", group=grp_grade)
ga_bonus_ote_conf_raw = input.float(0.05, "Бонус OTE Confluence", minval=0.0, maxval=0.3, step=0.01, inline="gb2", group=grp_grade)
ga_thresh_app_raw = input.float(1.35, "Порог A+", minval=0.5, maxval=2.0, step=0.05, inline="gt1", group=grp_grade)
ga_thresh_a_raw = input.float(1.10, "Порог A", minval=0.3, maxval=2.0, step=0.05, inline="gt1", group=grp_grade)
ga_thresh_b_raw = input.float(0.75, "Порог B", minval=0.2, maxval=2.0, step=0.05, inline="gt2", group=grp_grade)
ga_thresh_c_raw = input.float(0.50, "Порог C", minval=0.1, maxval=2.0, step=0.05, inline="gt2", group=grp_grade)
ga_require_layers_or_regime_for_ab = input.bool(true, "Полугейт: A/A+ требует Zone Confl≥2 ИЛИ Regime match (все профили)", group=grp_grade)

var float[] PR_GRADE_W_LTF_OFS = array.from(0.00, 0.00)
var float[] PR_GRADE_W_HTF_OFS = array.from(0.00, 0.05)
var float[] PR_GRADE_W_SCORE_OFS = array.from(0.00, 0.00)
var float[] PR_GRADE_BONUS_L_OFS = array.from(0.00, 0.00)
var float[] PR_GRADE_BONUS_R_OFS = array.from(0.00, 0.00)
var float[] PR_GRADE_TH_APP_OFS = array.from(-0.08, 0.15)
var float[] PR_GRADE_TH_A_OFS = array.from(-0.05, 0.10)
var float[] PR_GRADE_TH_B_OFS = array.from(-0.05, 0.08)
var float[] PR_GRADE_TH_C_OFS = array.from(-0.05, 0.08)

f_pr_grade_f(float base, array<float> ofs_arr, float minv, float maxv) =>
    float result = base
    if preset_idx_p2 >= 0
        result := math.max(minv, math.min(maxv, base + ofs_arr.get(preset_idx_p2)))
    result

float ga_w_ltf = f_pr_grade_f(ga_w_ltf_raw, PR_GRADE_W_LTF_OFS, 0.0, 1.0)
float ga_w_htf = f_pr_grade_f(ga_w_htf_raw, PR_GRADE_W_HTF_OFS, 0.0, 1.0)
float ga_w_score = f_pr_grade_f(ga_w_score_raw, PR_GRADE_W_SCORE_OFS, 0.0, 1.0)
float ga_score_cap = ga_score_cap_raw
float ga_bonus_layers = f_pr_grade_f(ga_bonus_layers_raw, PR_GRADE_BONUS_L_OFS, 0.0, 0.5)
float ga_bonus_regime = f_pr_grade_f(ga_bonus_regime_raw, PR_GRADE_BONUS_R_OFS, 0.0, 0.5)
float ga_thresh_app = f_pr_grade_f(ga_thresh_app_raw, PR_GRADE_TH_APP_OFS, 0.3, 2.0)
float ga_thresh_a = f_pr_grade_f(ga_thresh_a_raw, PR_GRADE_TH_A_OFS, 0.2, 2.0)
float ga_thresh_b = f_pr_grade_f(ga_thresh_b_raw, PR_GRADE_TH_B_OFS, 0.1, 2.0)
float ga_thresh_c = f_pr_grade_f(ga_thresh_c_raw, PR_GRADE_TH_C_OFS, 0.05, 2.0)

// ── 0.2.1 Видимость и фильтр по грейду ──
grp_vis = "0.2.1 Видимость и фильтр по грейду"
en_info_block = input.bool(true, "Инфоблок", group=grp_vis)
en_live_lbl = input.bool(true, "Живой светофор (вкл/выкл)", inline="livesw", group=grp_vis)
en_live_compact = input.bool(false, "Компактный (мини) режим", inline="livesw", group=grp_vis)
en_sig_labels = input.bool(true, "Ярлыки BUY/SELL", group=grp_vis)
show_grade_app = input.bool(true, "A+", inline="grades", group=grp_vis)
show_grade_a = input.bool(true, "A", inline="grades", group=grp_vis)
show_grade_b = input.bool(true, "B", inline="grades", group=grp_vis)
show_grade_c = input.bool(true, "C", inline="grades", group=grp_vis)
show_grade_d = input.bool(true, "D", inline="grades", group=grp_vis)
show_htf_circle_green = input.bool(true, "HTF🟢3/3", inline="htfcirc", group=grp_vis)
show_htf_circle_yellow = input.bool(true, "🟡2/3", inline="htfcirc", group=grp_vis)
show_htf_circle_white = input.bool(true, "⚪1/3", inline="htfcirc", group=grp_vis)
show_htf_circle_red = input.bool(true, "❌0/3", inline="htfcirc", group=grp_vis)
show_ltf_circle_blue = input.bool(true, "LTF🔵3/3", inline="ltfcirc", group=grp_vis)
show_ltf_circle_yellow = input.bool(true, "🟡2/3", inline="ltfcirc", group=grp_vis)
show_ltf_circle_white = input.bool(true, "⚪1/3", inline="ltfcirc", group=grp_vis)
show_ltf_circle_red = input.bool(true, "❌0/3", inline="ltfcirc", group=grp_vis)

f_grade_allowed(string grade) => switch grade
    "A+" => show_grade_app
    "A" => show_grade_a
    "B" => show_grade_b
    "C" => show_grade_c
    "D" => show_grade_d
    => false
f_htf_icon(int htf_s) => htf_s == 3 ? (show_htf_circle_green ? "🟢" : "") : htf_s == 2 ? (show_htf_circle_yellow ? "🟡" : "") : htf_s == 1 ? (show_htf_circle_white ? "⚪" : "") : (show_htf_circle_red ? "❌" : "")
f_ltf_icon(int ltf_s) => ltf_s == 3 ? (show_ltf_circle_blue ? "🔵" : "") : ltf_s == 2 ? (show_ltf_circle_yellow ? "🟡" : "") : ltf_s == 1 ? (show_ltf_circle_white ? "⚪" : "") : (show_ltf_circle_red ? "❌" : "")

// ====================================================================================================================
// МАТРИЦА СКОРИНГА (2 профиля × 68 факторов = 136 записей)
// ====================================================================================================================
type preset_factor
    bool include
    int weight
    bool must

var array<preset_factor> PR_FACTORS = array.from(
  // ═══ Профиль 0: Скальпинг ═══
  preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(false,1,false),
  preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(true,2,false), preset_factor.new(true,1,false),
  preset_factor.new(false,1,false), preset_factor.new(true,3,true), preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false),
  preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false),
  preset_factor.new(true,2,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false),
  preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,2,false), preset_factor.new(true,2,false), preset_factor.new(true,1,false),
  preset_factor.new(true,1,false), preset_factor.new(false,1,false), preset_factor.new(true,1,false), preset_factor.new(false,1,false), preset_factor.new(true,1,false),
  preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(false,1,false), preset_factor.new(false,1,false),
  preset_factor.new(true,1,false), preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(true,1,false),
  preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(true,1,false), preset_factor.new(false,1,false),
  preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(true,1,false), preset_factor.new(false,1,false),
  preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(true,1,false), preset_factor.new(false,1,false),
  preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(true,1,false),
  preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false),
  preset_factor.new(true,1,false), preset_factor.new(true,1,false),

  // ═══ Профиль 1: Консервативный (A+ Only) ═══
  preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(false,1,false),
  preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(true,3,true), preset_factor.new(true,2,false),
  preset_factor.new(false,2,false), preset_factor.new(true,2,true), preset_factor.new(true,2,false), preset_factor.new(true,2,false), preset_factor.new(true,3,true),
  preset_factor.new(true,3,false), preset_factor.new(true,3,false), preset_factor.new(true,3,false), preset_factor.new(true,3,false), preset_factor.new(true,3,false),
  preset_factor.new(true,3,false), preset_factor.new(true,3,false), preset_factor.new(true,3,false), preset_factor.new(true,3,false), preset_factor.new(true,3,false),
  preset_factor.new(true,3,false), preset_factor.new(true,3,false), preset_factor.new(true,4,false), preset_factor.new(true,4,false), preset_factor.new(true,1,true),
  preset_factor.new(true,1,true), preset_factor.new(false,3,true), preset_factor.new(true,3,false), preset_factor.new(false,3,false), preset_factor.new(true,2,false),
  preset_factor.new(true,2,false), preset_factor.new(true,3,false), preset_factor.new(true,3,false), preset_factor.new(false,2,false), preset_factor.new(false,2,false),
  preset_factor.new(true,2,false), preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(false,2,false), preset_factor.new(true,1,false),
  preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(true,1,false), preset_factor.new(false,1,false),
  preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(true,1,false), preset_factor.new(false,1,false),
  preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(true,1,false), preset_factor.new(false,2,false),
  preset_factor.new(false,2,false), preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(true,1,false),
  preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,2,false), preset_factor.new(true,1,false), preset_factor.new(true,2,false),
  preset_factor.new(true,3,false), preset_factor.new(true,1,false))

f_pr_get(int factor_idx, bool raw_inc, int raw_w, bool raw_must) =>
    preset_factor result = preset_factor.new(raw_inc, raw_w, raw_must)
    if preset_idx_p2 >= 0
        preset_factor pf = PR_FACTORS.get(preset_idx_p2 * 68 + factor_idx)
        result := preset_factor.new(pf.include, pf.weight, raw_must or pf.must)
    result

// ====================================================================================================================
// 0.3 КОНСТРУКТОР СИГНАЛОВ (СКОРИНГ) — f0-f67 (матрица), f68 LVZ, f69 OTE Confluence,
// f70-f77 факторы синхронизации, f78 OTE (обычный, точная зона) — новый обязательный-совместимый фактор
// ====================================================================================================================
grp_score = "0.3 Конструктор сигналов (Скоринг)"
req_score_raw = qa_req_score_raw
req_score = f_pr_score_p2(req_score_raw)

s_rsi_kde = input.bool(true,"📐 KDE RSI",inline="f0",group=grp_score), m_rsi_kde = input.bool(false,"Обяз.",inline="f0",group=grp_score)
s_stoch = input.bool(true,"🌀 Stoch Z",inline="f1",group=grp_score), m_stoch = input.bool(false,"Обяз.",inline="f1",group=grp_score)
