dash_text_size_str = input.string("small","Размер текста дашборда",options=["auto","tiny","small","normal","large","huge"],group=grp_dash)

// ====================================================================================================================
// 6. ВНЕШНИЕ ИНДИКАТОРЫ (P1 ← Main)
// ====================================================================================================================
grp_p1                   = "6. Внешние Индикаторы (Подключение)"
float p1_alive_src       = input.source(close,"[P1] ALIVE_SIGNAL (9999.0)",        group=grp_p1)
