// ====================================================================================================================
grp_hc_trp = "9.3. Hardcoded: Traps & Sweeps"
en_hc_a2   = input.bool(true,"A2: Структурная ловушка (False BOS)",          group=grp_hc_trp)
en_hc_b3   = input.bool(true,"B3: Дельта-ловушка (Delta Reversal)",          group=grp_hc_trp)
