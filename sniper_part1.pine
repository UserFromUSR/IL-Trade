float p1_swing_l_src     = input.source(close,"[P1] Swing Low",                    group=grp_p1)
// ── Новые P1: LTF Triple Engine v2 (каждый тир 0–6) ──────────────────────────
float p1_ltf1_bull_src   = input.source(close,"[P1] LTF1 Confirm Bull",            group=grp_p1)
float p1_ltf1_bear_src   = input.source(close,"[P1] LTF1 Confirm Bear",            group=grp_p1)
float p1_ltf2_bull_src   = input.source(close,"[P1] LTF2 Confirm Bull",            group=grp_p1)
float p1_ltf2_bear_src   = input.source(close,"[P1] LTF2 Confirm Bear",            group=grp_p1)
float p1_ltf3_bull_src   = input.source(close,"[P1] LTF3 Confirm Bull",            group=grp_p1)
float p1_ltf3_bear_src   = input.source(close,"[P1] LTF3 Confirm Bear",            group=grp_p1)
// ── Новые P1: Master Synthesis ─────────────────────────────────────────────────
float p1_master_src      = input.source(close,"[P1] Master Signal",                group=grp_p1)
float p1_conf_bull_src   = input.source(close,"[P1] Confluence Bull",              group=grp_p1)
float p1_conf_bear_src   = input.source(close,"[P1] Confluence Bear",              group=grp_p1)
float p1_ote_zone_src    = input.source(close,"[P1] OTE Zone",                     group=grp_p1)
float p1_p2agrees_b_src  = input.source(close,"[P1] P2 Agrees Bull",               group=grp_p1)
float p1_p2agrees_s_src  = input.source(close,"[P1] P2 Agrees Bear",               group=grp_p1)

// ====================================================================================================================
// 7. КОНСТРУКТОР СИГНАЛОВ (СКОРИНГ)
// ====================================================================================================================
grp_score     = "7. Конструктор сигналов (Скоринг)"
req_score     = input.int(4,  "Целевой порог:", minval=1, maxval=35,          group=grp_score)
en_standalone = input.bool(false,"🔧 Автономный режим (без Main)",            group=grp_score,
    tooltip="Если Main не подключён — HC паттерны работают только на внутренних модулях")
// ltf_gate_min: maxval=3 т.к. каскад теперь 3 тира (а не 4 фактора)
ltf_gate_min  = input.int(2,  "Мин. LTF тиров (0=откл.)", minval=0, maxval=3,group=grp_score,
    tooltip="0 = LTF Gate выключен. 2 = нужно 2 из 3 тиров. Рекомендуется 2.")

s_rsi_kde  = input.bool(true,"Учет: KDE RSI",        inline="rsi_kde",  group=grp_score), m_rsi_kde  = input.bool(false,"Обязат.",inline="rsi_kde",  group=grp_score)
s_stoch    = input.bool(true,"Учет: Stoch Z",         inline="stc",      group=grp_score), m_stoch    = input.bool(false,"Обязат.",inline="stc",      group=grp_score)
s_macd_dlx = input.bool(true,"Учет: MACD Dlx",        inline="mac2",     group=grp_score), m_macd_dlx = input.bool(false,"Обязат.",inline="mac2",     group=grp_score)
s_cci      = input.bool(true,"Учет: Advanced CCI",    inline="cci",      group=grp_score), m_cci      = input.bool(false,"Обязат.",inline="cci",      group=grp_score)
s_mdiv     = input.bool(true,"Учет: Multi-Div",       inline="mdiv",     group=grp_score), m_mdiv     = input.bool(false,"Обязат.",inline="mdiv",     group=grp_score)
s_peter    = input.bool(true,"Учет: PeterO Div",      inline="pdv",      group=grp_score), m_peter    = input.bool(false,"Обязат.",inline="pdv",      group=grp_score)
s_tfdiv    = input.bool(true,"Учет: T-Finder Div",    inline="tfdv",     group=grp_score), m_tfdiv    = input.bool(false,"Обязат.",inline="tfdv",     group=grp_score)
s_smt      = input.bool(true,"Учет: SMT Div",         inline="smt",      group=grp_score), m_smt      = input.bool(false,"Обязат.",inline="smt",      group=grp_score)
s_sm_act   = input.bool(true,"Учет: SM Act",          inline="vol_act",  group=grp_score), m_sm_act   = input.bool(false,"Обязат.",inline="vol_act",  group=grp_score)
s_sm_idx   = input.bool(true,"Учет: SM Index",        inline="vol_idx",  group=grp_score), m_sm_idx   = input.bool(false,"Обязат.",inline="vol_idx",  group=grp_score)
s_sm_int   = input.bool(true,"Учет: SM Int",          inline="vol_int",  group=grp_score), m_sm_int   = input.bool(false,"Обязат.",inline="vol_int",  group=grp_score)
s_cndl     = input.bool(true,"Учет: Candles",         inline="cndl",     group=grp_score), m_cndl     = input.bool(false,"Обязат.",inline="cndl",     group=grp_score)
s_ma_cross = input.bool(true,"Учет: MA Cross",        inline="ma_x",     group=grp_score), m_ma_cross = input.bool(false,"Обязат.",inline="ma_x",     group=grp_score)
s_ma_trend = input.bool(true,"Учет: MA Trend",        inline="ma_t",     group=grp_score), m_ma_trend = input.bool(false,"Обязат.",inline="ma_t",     group=grp_score)
s_smc      = input.bool(true,"SMC Trend Вкл",         inline="smc",      group=grp_score), m_smc      = input.bool(false,"Обязат.",inline="smc",      group=grp_score)
s_ob       = input.bool(true,"OB Activity Вкл",       inline="ob",       group=grp_score), m_ob       = input.bool(false,"Обязат.",inline="ob",       group=grp_score)
s_sd       = input.bool(true,"S&D Zones Вкл",         inline="sd",       group=grp_score), m_sd       = input.bool(false,"Обязат.",inline="sd",       group=grp_score)
s_fvg      = input.bool(true,"FVG Вкл",               inline="fvg",      group=grp_score), m_fvg      = input.bool(false,"Обязат.",inline="fvg",      group=grp_score)
s_bos      = input.bool(false,"BOS Level Вкл",        inline="bos",      group=grp_score), m_bos      = input.bool(false,"Обязат.",inline="bos",      group=grp_score)
s_bb       = input.bool(true,"Breaker Вкл",           inline="bb",       group=grp_score), m_bb       = input.bool(false,"Обязат.",inline="bb",       group=grp_score)
s_hm       = input.bool(true,"HeatMap Sweep Вкл",     inline="hm",       group=grp_score), m_hm       = input.bool(false,"Обязат.",inline="hm",       group=grp_score)
s_sdinv    = input.bool(true,"S&D Break Вкл",         inline="sdinv",    group=grp_score), m_sdinv    = input.bool(false,"Обязат.",inline="sdinv",    group=grp_score)
s_sweep    = input.bool(true,"SMC Sweep Вкл",         inline="swp",      group=grp_score), m_sweep    = input.bool(false,"Обязат.",inline="swp",      group=grp_score)
s_choch    = input.bool(true,"CHoCH Вкл",             inline="choch",    group=grp_score), m_choch    = input.bool(false,"Обязат.",inline="choch",    group=grp_score)
s_pd       = input.bool(true,"Prem/Discount Вкл",     inline="pd",       group=grp_score), m_pd       = input.bool(false,"Обязат.",inline="pd",       group=grp_score)
s_avwap    = input.bool(true,"AVWAP Align Вкл",       inline="avwap",    group=grp_score), m_avwap    = input.bool(false,"Обязат.",inline="avwap",    group=grp_score)
s_disp     = input.bool(true,"Displacement Вкл",      inline="disp",     group=grp_score), m_disp     = input.bool(false,"Обязат.",inline="disp",     group=grp_score)
s_ob_frsh  = input.bool(true,"Fresh OB Вкл",          inline="obfr",     group=grp_score), m_ob_frsh  = input.bool(false,"Обязат.",inline="obfr",     group=grp_score)

