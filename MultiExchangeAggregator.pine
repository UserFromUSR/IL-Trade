// ╔══════════════════════════════════════════════════════════════════╗
// ║       MULTI-EXCHANGE DATA AGGREGATOR  —  PineScript v6          ║
// ║  Автоматически определяет актив и собирает данные с 8 бирж      ║
// ║  Данные: OHLCV · Volume · OI · Funding Rate                    ║
// ║  ⚠ Order Book — недоступен в Pine (нужен внешний WebSocket)     ║
// ╚══════════════════════════════════════════════════════════════════╝
//@version=6
indicator("Multi-Exchange Aggregator", overlay=false, max_lines_count=500)

// ═══════════════════════════════════════════════════════════════════
// БЛОК 1: НАСТРОЙКИ
// ═══════════════════════════════════════════════════════════════════
grp_ex   = "Биржи"
grp_disp = "Отображение"
grp_filt = "Фильтр данных"

use_binance  = input.bool(true,  "Binance Futures",  group=grp_ex)
use_bybit    = input.bool(true,  "Bybit Perp",       group=grp_ex)
use_okx      = input.bool(true,  "OKX Swap",         group=grp_ex)
use_coinbase = input.bool(true,  "Coinbase",         group=grp_ex)
use_kraken   = input.bool(true,  "Kraken",           group=grp_ex)
use_gate     = input.bool(false, "Gate.io",          group=grp_ex)
use_htx      = input.bool(false, "HTX (Huobi)",      group=grp_ex)
use_kucoin   = input.bool(false, "KuCoin",           group=grp_ex)

show_prices   = input.bool(true,  "Цены закрытия по биржам",   group=grp_disp)
show_volumes  = input.bool(true,  "Объёмы по биржам",          group=grp_disp)
show_oi       = input.bool(true,  "Открытый интерес (OI)",     group=grp_disp)
show_funding  = input.bool(false, "Funding Rate",              group=grp_disp)
show_spread   = input.bool(true,  "Спред между биржами",       group=grp_disp)
show_cvd      = input.bool(true,  "CVD (агрегированный)",      group=grp_disp)

// ═══════════════════════════════════════════════════════════════════
// БЛОК 2: АВТООПРЕДЕЛЕНИЕ АКТИВА
// ═══════════════════════════════════════════════════════════════════
// Берём базовую валюту текущего графика (BTC, ETH и т.д.)
BASE  = syminfo.basecurrency    // например "BTC"
QUOTE = "USDT"

// Строим тикеры для каждой биржи динамически
// ──────────────────────────────────────────────
// Spot / Standard
sym_binance_spot  = "BINANCE:"   + BASE + QUOTE
sym_coinbase_spot = "COINBASE:"  + BASE + "USD"
sym_kraken_spot   = "KRAKEN:"    + BASE + "USD"
sym_gate_spot     = "GATEIO:"    + BASE + QUOTE
sym_kucoin_spot   = "KUCOIN:"    + BASE + QUOTE

// Perpetual Futures (для OI и Funding Rate)
sym_binance_perp  = "BINANCE:"   + BASE + QUOTE + ".P"   // Binance Perpetual
sym_bybit_perp    = "BYBIT:"     + BASE + QUOTE + ".P"   // Bybit Perpetual
sym_okx_swap      = "OKX:"       + BASE + QUOTE + ".P"   // OKX Swap
sym_htx_swap      = "HUOBI:"     + BASE + QUOTE + ".P"   // HTX Swap

// ═══════════════════════════════════════════════════════════════════
// БЛОК 3: ЗАГРУЗКА ДАННЫХ — OHLCV
// Используем request.security() для каждой биржи
// Лимит TradingView: 40 вызовов на скрипт
// ═══════════════════════════════════════════════════════════════════

// Вспомогательная функция: безопасный запрос (возвращает na если биржа недоступна)
f_req(sym, src) =>
    request.security(sym, timeframe.period, src, ignore_invalid_symbol=true)

// ─── Binance (spot) ───
[o_bn, h_bn, l_bn, c_bn, v_bn] = use_binance ?
    request.security(sym_binance_spot, timeframe.period,
        [open, high, low, close, volume], ignore_invalid_symbol=true) :
    [float(na), float(na), float(na), float(na), float(na)]

// ─── Bybit Perpetual ───
[o_bb, h_bb, l_bb, c_bb, v_bb] = use_bybit ?
    request.security(sym_bybit_perp, timeframe.period,
        [open, high, low, close, volume], ignore_invalid_symbol=true) :
    [float(na), float(na), float(na), float(na), float(na)]

// ─── OKX Swap ───
[o_ok, h_ok, l_ok, c_ok, v_ok] = use_okx ?
    request.security(sym_okx_swap, timeframe.period,
        [open, high, low, close, volume], ignore_invalid_symbol=true) :
    [float(na), float(na), float(na), float(na), float(na)]

// ─── Coinbase ───
[o_cb, h_cb, l_cb, c_cb, v_cb] = use_coinbase ?
    request.security(sym_coinbase_spot, timeframe.period,
        [open, high, low, close, volume], ignore_invalid_symbol=true) :
    [float(na), float(na), float(na), float(na), float(na)]

// ─── Kraken ───
[o_kr, h_kr, l_kr, c_kr, v_kr] = use_kraken ?
    request.security(sym_kraken_spot, timeframe.period,
        [open, high, low, close, volume], ignore_invalid_symbol=true) :
    [float(na), float(na), float(na), float(na), float(na)]

// ─── Gate.io ───
[o_gt, h_gt, l_gt, c_gt, v_gt] = use_gate ?
    request.security(sym_gate_spot, timeframe.period,
        [open, high, low, close, volume], ignore_invalid_symbol=true) :
    [float(na), float(na), float(na), float(na), float(na)]

// ─── HTX ───
[o_htx, h_htx, l_htx, c_htx, v_htx] = use_htx ?
    request.security(sym_htx_swap, timeframe.period,
        [open, high, low, close, volume], ignore_invalid_symbol=true) :
    [float(na), float(na), float(na), float(na), float(na)]

// ─── KuCoin ───
[o_ku, h_ku, l_ku, c_ku, v_ku] = use_kucoin ?
    request.security(sym_kucoin_spot, timeframe.period,
        [open, high, low, close, volume], ignore_invalid_symbol=true) :
    [float(na), float(na), float(na), float(na), float(na)]

// ═══════════════════════════════════════════════════════════════════
// БЛОК 4: ОТКРЫТЫЙ ИНТЕРЕС (OI)
// Доступен только для перп-фьючерсов.
// TradingView предоставляет OI через специальный тикер _OI
// ═══════════════════════════════════════════════════════════════════
oi_bn = use_binance ?
    f_req("BINANCE:" + BASE + QUOTE + "PERP_OI", close) : float(na)

oi_bb = use_bybit ?
    f_req("BYBIT:" + BASE + QUOTE + "_OI", close) : float(na)

oi_ok = use_okx ?
    f_req("OKX:" + BASE + QUOTE + "_OI", close) : float(na)

// Суммарный OI по всем доступным биржам
oi_values = array.new_float(0)
if not na(oi_bn) and use_binance
    array.push(oi_values, oi_bn)
if not na(oi_bb) and use_bybit
    array.push(oi_values, oi_bb)
if not na(oi_ok) and use_okx
    array.push(oi_values, oi_ok)

oi_total = array.size(oi_values) > 0 ? array.sum(oi_values) : float(na)

// ═══════════════════════════════════════════════════════════════════
// БЛОК 5: FUNDING RATE
// Доступен только для перп-фьючерсов.
// Обновляется каждые 8 часов (Binance) / 8ч (Bybit, OKX)
// ═══════════════════════════════════════════════════════════════════
fr_bn = use_binance ?
    f_req("BINANCE:" + BASE + QUOTE + "PERP_FUNDING_RATE", close) : float(na)

fr_bb = use_bybit ?
    f_req("BYBIT:" + BASE + QUOTE + "_FUNDING_RATE", close) : float(na)

fr_ok = use_okx ?
    f_req("OKX:" + BASE + QUOTE + "_FUNDING_RATE", close) : float(na)

// Средняя ставка финансирования
fr_arr = array.new_float(0)
if not na(fr_bn) and use_binance
    array.push(fr_arr, fr_bn)
if not na(fr_bb) and use_bybit
    array.push(fr_arr, fr_bb)
if not na(fr_ok) and use_okx
    array.push(fr_arr, fr_ok)

fr_avg = array.size(fr_arr) > 0 ? array.avg(fr_arr) : float(na)

// ═══════════════════════════════════════════════════════════════════
// БЛОК 6: УПАКОВКА В МАССИВЫ
// Главный агрегатор — все данные в одном месте
// ═══════════════════════════════════════════════════════════════════

// Имена бирж (для меток на графике)
var exchange_names = array.from("Binance", "Bybit", "OKX", "Coinbase", "Kraken", "Gate", "HTX", "KuCoin")

// ─── Массив цен закрытия ───
prices = array.from(c_bn, c_bb, c_ok, c_cb, c_kr, c_gt, c_htx, c_ku)

// ─── Массив объёмов ───
volumes = array.from(v_bn, v_bb, v_ok, v_cb, v_kr, v_gt, v_htx, v_ku)

// ─── Массив OI ───
oi_arr = array.from(oi_bn, oi_bb, oi_ok,
                    float(na), float(na), float(na), float(na), float(na))

// ─── Массив Funding Rate ───
funding_arr = array.from(fr_bn, fr_bb, fr_ok,
                         float(na), float(na), float(na), float(na), float(na))

// ═══════════════════════════════════════════════════════════════════
// БЛОК 7: АГРЕГИРОВАННЫЕ МЕТРИКИ
// ═══════════════════════════════════════════════════════════════════

// Фильтруем только валидные (не na) значения
var valid_prices   = array.new_float(0)
var valid_volumes  = array.new_float(0)
array.clear(valid_prices)
array.clear(valid_volumes)

for i = 0 to array.size(prices) - 1
    p = array.get(prices, i)
    v = array.get(volumes, i)
    if not na(p)
        array.push(valid_prices, p)
    if not na(v)
        array.push(valid_volumes, v)

n_ex = array.size(valid_prices)  // количество активных бирж с данными

// Средняя цена (простое и взвешенное по объёму)
avg_price   = n_ex > 0 ? array.avg(valid_prices) : float(na)
price_high  = n_ex > 0 ? array.max(valid_prices) : float(na)
price_low   = n_ex > 0 ? array.min(valid_prices) : float(na)

// Спред: разница макс/мин цены по биржам в % (арбитраж-сигнал)
spread_pct = not na(price_high) and not na(price_low) and price_low > 0 ?
    (price_high - price_low) / price_low * 100 : float(na)

// Суммарный объём
total_volume = array.size(valid_volumes) > 0 ? array.sum(valid_volumes) : float(na)

// CVD — Cumulative Volume Delta (Buy vs Sell pressure)
// На уровне баров: buy vol = vol если close > open, иначе sell vol
f_cvd_bar(o, c, v) =>
    not na(o) and not na(c) and not na(v) ?
        (c >= o ? v : -v) : float(na)

cvd_bn  = f_cvd_bar(o_bn,  c_bn,  v_bn)
cvd_bb  = f_cvd_bar(o_bb,  c_bb,  v_bb)
cvd_ok  = f_cvd_bar(o_ok,  c_ok,  v_ok)
cvd_cb  = f_cvd_bar(o_cb,  c_cb,  v_cb)
cvd_kr  = f_cvd_bar(o_kr,  c_kr,  v_kr)

cvd_raw = na(cvd_bn) ? 0.0 : cvd_bn
cvd_raw := cvd_raw + (na(cvd_bb) ? 0.0 : cvd_bb)
cvd_raw := cvd_raw + (na(cvd_ok) ? 0.0 : cvd_ok)
cvd_raw := cvd_raw + (na(cvd_cb) ? 0.0 : cvd_cb)
cvd_raw := cvd_raw + (na(cvd_kr) ? 0.0 : cvd_kr)

cvd_cum = ta.cum(cvd_raw)  // накопленный CVD

// ═══════════════════════════════════════════════════════════════════
// БЛОК 8: ОТОБРАЖЕНИЕ
// ═══════════════════════════════════════════════════════════════════

// ─── Панель 1: Цены по биржам ───
var p_bn  = plot(show_prices ? c_bn  : na, "Binance",  color=color.new(#2962FF, 0),  linewidth=1)
var p_bb  = plot(show_prices ? c_bb  : na, "Bybit",    color=color.new(#FF6D00, 0),  linewidth=1)
var p_ok  = plot(show_prices ? c_ok  : na, "OKX",      color=color.new(#00BCD4, 0),  linewidth=1)
var p_cb  = plot(show_prices ? c_cb  : na, "Coinbase", color=color.new(#1565C0, 0),  linewidth=1)
var p_kr  = plot(show_prices ? c_kr  : na, "Kraken",   color=color.new(#7B1FA2, 0),  linewidth=1)
var p_gt  = plot(show_prices ? c_gt  : na, "Gate",     color=color.new(#00897B, 0),  linewidth=1)
var p_htx = plot(show_prices ? c_htx : na, "HTX",      color=color.new(#E53935, 0),  linewidth=1)
var p_ku  = plot(show_prices ? c_ku  : na, "KuCoin",   color=color.new(#43A047, 0),  linewidth=1)

// Средняя цена (толстая белая линия)
plot(show_prices ? avg_price : na, "Avg Price", color=color.white, linewidth=2)

// ─── Спред ───
hline(0.1, "Спред 0.1%", color=color.new(color.yellow, 70), linestyle=hline.style_dashed)
spread_color = spread_pct > 0.3 ? color.red :
               spread_pct > 0.1 ? color.yellow : color.green

plot(show_spread ? spread_pct : na, "Spread %",
     color=spread_color, style=plot.style_area,
     display=show_spread ? display.all : display.none)

// ─── CVD ───
cvd_color = cvd_cum >= 0 ? color.new(color.green, 60) : color.new(color.red, 60)
plot(show_cvd ? cvd_cum : na, "CVD Aggregate",
     color=cvd_color, style=plot.style_histogram,
     display=show_cvd ? display.all : display.none)

// ─── OI ───
plot(show_oi ? oi_total : na, "OI Total",
     color=color.new(color.orange, 30), linewidth=2,
     display=show_oi ? display.all : display.none)

// ─── Funding Rate ───
fr_color = fr_avg > 0.001 ? color.red :
           fr_avg < -0.001 ? color.green : color.gray
plot(show_funding ? fr_avg * 100 : na, "Funding Rate avg %",
     color=fr_color, style=plot.style_columns,
     display=show_funding ? display.all : display.none)
hline(0.01, "FR +0.01%", color=color.new(color.red, 70), linestyle=hline.style_dotted,
      display=show_funding ? display.all : display.none)
hline(-0.01, "FR -0.01%", color=color.new(color.green, 70), linestyle=hline.style_dotted,
      display=show_funding ? display.all : display.none)

// ═══════════════════════════════════════════════════════════════════
// БЛОК 9: ИНФОРМАЦИОННАЯ ТАБЛИЦА
// Показывает актуальные данные по каждой бирже в правом углу
// ═══════════════════════════════════════════════════════════════════
if barstate.islast
    var tbl = table.new(position.top_right, 6, 10,
                        bgcolor=color.new(color.black, 80),
                        border_color=color.new(color.white, 60),
                        border_width=1, frame_color=color.white, frame_width=1)

    // Заголовки
    table.cell(tbl, 0, 0, "Биржа",    text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 40))
    table.cell(tbl, 1, 0, "Цена",     text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 40))
    table.cell(tbl, 2, 0, "Δ Avg",    text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 40))
    table.cell(tbl, 3, 0, "Volume",   text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 40))
    table.cell(tbl, 4, 0, "OI",       text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 40))
    table.cell(tbl, 5, 0, "Funding",  text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 40))

    // Данные по биржам
    exch_prices  = array.from(c_bn,  c_bb,  c_ok,  c_cb,  c_kr,  c_gt,  c_htx, c_ku)
    exch_vols    = array.from(v_bn,  v_bb,  v_ok,  v_cb,  v_kr,  v_gt,  v_htx, v_ku)
    exch_oi_vals = array.from(oi_bn, oi_bb, oi_ok, float(na), float(na), float(na), float(na), float(na))
    exch_fr_vals = array.from(fr_bn, fr_bb, fr_ok, float(na), float(na), float(na), float(na), float(na))
    exch_enabled = array.from(use_binance, use_bybit, use_okx, use_coinbase, use_kraken, use_gate, use_htx, use_kucoin)

    row = 1
    for i = 0 to 7
        if array.get(exch_enabled, i)
            px = array.get(exch_prices, i)
            vx = array.get(exch_vols, i)
            ox = array.get(exch_oi_vals, i)
            fx = array.get(exch_fr_vals, i)

            delta_pct = not na(px) and not na(avg_price) and avg_price > 0 ?
                        (px - avg_price) / avg_price * 100 : float(na)

            d_color = not na(delta_pct) ?
                      (delta_pct > 0 ? color.lime : delta_pct < 0 ? color.red : color.gray) :
                      color.gray
            f_color = not na(fx) ?
                      (fx > 0 ? color.red : fx < 0 ? color.lime : color.gray) :
                      color.gray

            table.cell(tbl, 0, row, array.get(exchange_names, i),
                       text_color=color.white, text_size=size.small)
            table.cell(tbl, 1, row,
                       not na(px) ? str.tostring(px, format.mintick) : "—",
                       text_color=color.white, text_size=size.small)
            table.cell(tbl, 2, row,
                       not na(delta_pct) ? str.tostring(delta_pct, "#.###") + "%" : "—",
                       text_color=d_color, text_size=size.small)
            table.cell(tbl, 3, row,
                       not na(vx) ? str.tostring(math.round(vx / 1000), "#,###") + "K" : "—",
                       text_color=color.silver, text_size=size.small)
            table.cell(tbl, 4, row,
                       not na(ox) ? str.tostring(math.round(ox / 1e6), "#,###") + "M" : "—",
                       text_color=color.orange, text_size=size.small)
            table.cell(tbl, 5, row,
                       not na(fx) ? str.tostring(fx * 100, "#.####") + "%" : "—",
                       text_color=f_color, text_size=size.small)
            row := row + 1

    // Итоговая строка
    table.cell(tbl, 0, row, "ИТОГО / AVG",    text_color=color.white,  text_size=size.small, bgcolor=color.new(color.navy, 50))
    table.cell(tbl, 1, row, not na(avg_price) ? str.tostring(avg_price, format.mintick) : "—",
               text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 50))
    table.cell(tbl, 2, row, not na(spread_pct) ? "spread " + str.tostring(spread_pct, "#.###") + "%" : "—",
               text_color=color.aqua, text_size=size.small, bgcolor=color.new(color.navy, 50))
    table.cell(tbl, 3, row, not na(total_volume) ? str.tostring(math.round(total_volume / 1e6), "#,###") + "M" : "—",
               text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 50))
    table.cell(tbl, 4, row, not na(oi_total) ? str.tostring(math.round(oi_total / 1e6), "#,###") + "M" : "—",
               text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 50))
    table.cell(tbl, 5, row, not na(fr_avg) ? str.tostring(fr_avg * 100, "#.####") + "%" : "—",
               text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 50))

// ═══════════════════════════════════════════════════════════════════
// БЛОК 10: АЛЕРТЫ
// ═══════════════════════════════════════════════════════════════════
// Алерт на аномальный спред (возможный арбитраж)
alertcondition(spread_pct > 0.3, "Арбитраж-спред > 0.3%",
    "Спред между биржами превысил 0.3%! Проверь арбитраж.")

// Алерт на экстремальный funding (перегрев рынка)
alertcondition(fr_avg > 0.003, "Funding Rate экстремальный +",
    "Средний Funding Rate выше 0.3% — рынок перегрет лонгами")
alertcondition(fr_avg < -0.003, "Funding Rate экстремальный −",
    "Средний Funding Rate ниже -0.3% — давление шортов")

// Алерт на разворот CVD
alertcondition(ta.crossover(cvd_cum, 0), "CVD пересёк 0 снизу", "CVD стал позитивным — давление покупателей")
alertcondition(ta.crossunder(cvd_cum, 0), "CVD пересёк 0 сверху", "CVD стал негативным — давление продавцов")

// ═══════════════════════════════════════════════════════════════════
// ЭКСПОРТИРУЕМЫЕ ПЕРЕМЕННЫЕ (для использования в другом скрипте)
// Через pine library или просто как reference:
//   avg_price   — средняя цена по всем биржам
//   total_volume — суммарный объём
//   oi_total    — суммарный открытый интерес
//   fr_avg      — средний funding rate
//   spread_pct  — спред между биржами в %
//   cvd_cum     — накопленный агрегированный CVD
//   n_ex        — количество активных бирж с данными
// ═══════════════════════════════════════════════════════════════════
