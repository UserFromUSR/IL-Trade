indicator("UserUZR Main - All-in-One (FVG, VP, S&D, SMC, OB/BB, HeatMap)", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=5000, max_polylines_count=100)

// ====================================================================================================================
// КОНЦЕПЦИЯ ВЕСОВ LTF / HTF
// ─────────────────────────────────────────────────────────────────────────────
// Каждый модуль (Clusters, FVG, S&D, SMC/OB, HeatMap) получает сырые баллы
// 0..6 с каждого таймфрейма через один общий tf_engine().
//
// tf_engine() считает 6 факторов на выбранном ТФ:
//   1. micro_bull/bear  — пробой максимума/минимума последних 5 баров
//   2. vol_b/vol_s      — объём > 2× среднего + закрытие в направлении
//   3. acc_bull/bear    — 3+ бычьих/медвежьих свечей из 5 подряд
//   4. rsi_b/rsi_s      — RSI(7) < 65 (не перекуплен) / > 35 (не перепродан)
//   5. eng_bull/bear    — поглощающая свеча в направлении
//   6. strong_b/s       — тело > 60% от диапазона свечи
//
// Результат: cb (bull score) и cs (bear score), каждый от 0 до 6.
//
// Для каждого модуля и каждого ТФ задаётся:
//   thresh — минимальный балл для "подтверждения тира" (1..6)
//   w_ltf  — вес одного подтверждённого LTF-тира в общем счёте (1..4)
//   w_htf  — вес одного подтверждённого HTF-тира в общем счёте (1..4)
//
// Пример для модуля SMC:
//   LTF1 (1м) cb = 4/6, thresh_ltf1_smc = 3 → тир подтверждён → +w_ltf_smc
//   LTF2 (3м) cb = 2/6, thresh_ltf2_smc = 3 → НЕ подтверждён  → 0
//   LTF3 (5м) cb = 5/6, thresh_ltf3_smc = 3 → тир подтверждён → +w_ltf_smc
//   HTF1 (1ч) cb = 5/6, thresh_htf1_smc = 3 → тир подтверждён → +w_htf_smc
//   HTF2 (4ч) cb = 1/6, thresh_htf2_smc = 3 → НЕ подтверждён  → 0
//   HTF3 (1д) cb = 4/6, thresh_htf3_smc = 3 → тир подтверждён → +w_htf_smc
//
// Итого от SMC в conf_bull: 2*w_ltf + 2*w_htf очков.
//
// Аналогично считается от всех 5 модулей.
// Все вклады суммируются в export_conf_bull/bear → Master Signal.
//
// Таймфреймы задаются ГЛОБАЛЬНО (6 инпутов), пороги и веса — PER-MODULE.
// ====================================================================================================================

// ── Глобальные таймфреймы ────────────────────────────────────────────────────
grp_tfs = "Таймфреймы (глобальные — общие для всех модулей)"
g_ltf1  = input.timeframe("1",   "LTF1 — самый быстрый", group=grp_tfs,
    tooltip="Используется всеми модулями как первый LTF-тир. Типично: 1м (для 15м-графика), 5м (для 1ч-графика).")
g_ltf2  = input.timeframe("3",   "LTF2 — средний",       group=grp_tfs,
    tooltip="Второй LTF-тир. Типично: 3м (для 15м-графика), 15м (для 1ч-графика).")
g_ltf3  = input.timeframe("5",   "LTF3 — финальный LTF", group=grp_tfs,
    tooltip="Третий LTF-тир. Типично: 5м (для 15м-графика), 30м (для 1ч-графика).")
g_htf1  = input.timeframe("60",  "HTF1 — быстрый тренд", group=grp_tfs,
    tooltip="Первый HTF-тир задаёт тренд. Типично: 1ч (для 15м-графика), 4ч (для 1ч-графика).")
g_htf2  = input.timeframe("240", "HTF2 — средний тренд", group=grp_tfs,
    tooltip="Второй HTF-тир. Типично: 4ч (для 15м-графика), 1д (для 1ч-графика).")
g_htf3  = input.timeframe("D",   "HTF3 — мастер-тренд",  group=grp_tfs,
    tooltip="Старший тренд. Типично: 1д или 1W.")

