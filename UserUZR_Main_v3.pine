// ====================================================================================================================
// ОБЩИЙ TF ENGINE — 6 вызовов request.security
// ====================================================================================================================

tf_engine() =>
    float rsi7    = ta.rsi(close, 7)
    float vol_sma = ta.sma(volume, 20)
    float h5      = ta.highest(high, 5)[1]
    float l5      = ta.lowest(low,   5)[1]
    // Фактор 1: микро-пробой уровня
    bool micro_bull = ta.crossover(close,  h5)
    bool micro_bear = ta.crossunder(close, l5)
    // Фактор 2: объём > 2× среднего в направлении
    bool vol_b = volume > vol_sma * 2.0 and close > open
    bool vol_s = volume > vol_sma * 2.0 and close < open
    // Фактор 3: накопление свечей (3+ из 5)
    int bull_cnt = (close    > open    ? 1 : 0) + (close[1] > open[1] ? 1 : 0) +
                   (close[2] > open[2] ? 1 : 0) + (close[3] > open[3] ? 1 : 0) +
                   (close[4] > open[4] ? 1 : 0)
    int bear_cnt = (close    < open    ? 1 : 0) + (close[1] < open[1] ? 1 : 0) +
                   (close[2] < open[2] ? 1 : 0) + (close[3] < open[3] ? 1 : 0) +
                   (close[4] < open[4] ? 1 : 0)
    bool acc_bull = bull_cnt >= 3
    bool acc_bear = bear_cnt >= 3
    // Фактор 4: RSI не перекуплен/перепродан
    bool rsi_b = rsi7 < 65
    bool rsi_s = rsi7 > 35
    // Фактор 5: поглощающая свеча
    bool eng_bull = close > open and close > high[1] and open < close[1]
    bool eng_bear = close < open and close < low[1]  and open > close[1]
    // Фактор 6: сильное тело > 60% диапазона
    float body_r  = math.abs(close - open) / math.max(high - low, syminfo.mintick)
    bool strong_b = body_r > 0.6 and close > open
    bool strong_s = body_r > 0.6 and close < open
    int cb = (micro_bull ? 1 : 0) + (vol_b    ? 1 : 0) + (acc_bull ? 1 : 0) +
             (rsi_b      ? 1 : 0) + (eng_bull ? 1 : 0) + (strong_b ? 1 : 0)
    int cs = (micro_bear ? 1 : 0) + (vol_s    ? 1 : 0) + (acc_bear ? 1 : 0) +
             (rsi_s      ? 1 : 0) + (eng_bear ? 1 : 0) + (strong_s ? 1 : 0)
    [cb, cs]

[raw_ltf1_b, raw_ltf1_s] = request.security(syminfo.tickerid, g_ltf1, tf_engine(), lookahead=barmerge.lookahead_off)
[raw_ltf2_b, raw_ltf2_s] = request.security(syminfo.tickerid, g_ltf2, tf_engine(), lookahead=barmerge.lookahead_off)
[raw_ltf3_b, raw_ltf3_s] = request.security(syminfo.tickerid, g_ltf3, tf_engine(), lookahead=barmerge.lookahead_off)
[raw_htf1_b, raw_htf1_s] = request.security(syminfo.tickerid, g_htf1, tf_engine(), lookahead=barmerge.lookahead_off)
[raw_htf2_b, raw_htf2_s] = request.security(syminfo.tickerid, g_htf2, tf_engine(), lookahead=barmerge.lookahead_off)
[raw_htf3_b, raw_htf3_s] = request.security(syminfo.tickerid, g_htf3, tf_engine(), lookahead=barmerge.lookahead_off)

// ====================================================================================================================
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ДЛЯ ПОДСЧЁТА ВКЛАДА МОДУЛЯ В СИНТЕЗ
// ====================================================================================================================

// f_tier: один ТФ-тир. Возвращает вес если балл >= порог, иначе 0.
f_tier(int raw_b, int raw_s, int thr, int w) =>
    int cb = raw_b >= thr ? w : 0
    int cs = raw_s >= thr ? w : 0
    [cb, cs]

// f_mod_ltf: суммарный вклад трёх LTF-тиров для модуля.
// Если en_mod выключен — возвращает 0/0.
f_mod_ltf(bool en_mod, int thr1, int thr2, int thr3, int w) =>
    int cb = 0
    int cs = 0
    if en_mod
        [b1, s1] = f_tier(raw_ltf1_b, raw_ltf1_s, thr1, w)
        [b2, s2] = f_tier(raw_ltf2_b, raw_ltf2_s, thr2, w)
        [b3, s3] = f_tier(raw_ltf3_b, raw_ltf3_s, thr3, w)
        cb := b1 + b2 + b3
        cs := s1 + s2 + s3
    [cb, cs]

// f_mod_htf: суммарный вклад трёх HTF-тиров для модуля.
f_mod_htf(bool en_mod, int thr1, int thr2, int thr3, int w) =>
    int cb = 0
    int cs = 0
    if en_mod
        [b1, s1] = f_tier(raw_htf1_b, raw_htf1_s, thr1, w)
        [b2, s2] = f_tier(raw_htf2_b, raw_htf2_s, thr2, w)
        [b3, s3] = f_tier(raw_htf3_b, raw_htf3_s, thr3, w)
        cb := b1 + b2 + b3
        cs := s1 + s2 + s3
    [cb, cs]

// Вклады всех 5 модулей
[m1_ltf_b, m1_ltf_s] = f_mod_ltf(m1_en_ltf, m1_thr_ltf1, m1_thr_ltf2, m1_thr_ltf3, m1_w_ltf)
[m1_htf_b, m1_htf_s] = f_mod_htf(m1_en_htf, m1_thr_htf1, m1_thr_htf2, m1_thr_htf3, m1_w_htf)
[m2_ltf_b, m2_ltf_s] = f_mod_ltf(m2_en_ltf, m2_thr_ltf1, m2_thr_ltf2, m2_thr_ltf3, m2_w_ltf)
[m2_htf_b, m2_htf_s] = f_mod_htf(m2_en_htf, m2_thr_htf1, m2_thr_htf2, m2_thr_htf3, m2_w_htf)
[m3_ltf_b, m3_ltf_s] = f_mod_ltf(m3_en_ltf, m3_thr_ltf1, m3_thr_ltf2, m3_thr_ltf3, m3_w_ltf)
[m3_htf_b, m3_htf_s] = f_mod_htf(m3_en_htf, m3_thr_htf1, m3_thr_htf2, m3_thr_htf3, m3_w_htf)
[m4_ltf_b, m4_ltf_s] = f_mod_ltf(m4_en_ltf, m4_thr_ltf1, m4_thr_ltf2, m4_thr_ltf3, m4_w_ltf)
[m4_htf_b, m4_htf_s] = f_mod_htf(m4_en_htf, m4_thr_htf1, m4_thr_htf2, m4_thr_htf3, m4_w_htf)
[m5_ltf_b, m5_ltf_s] = f_mod_ltf(m5_en_ltf, m5_thr_ltf1, m5_thr_ltf2, m5_thr_ltf3, m5_w_ltf)
[m5_htf_b, m5_htf_s] = f_mod_htf(m5_en_htf, m5_thr_htf1, m5_thr_htf2, m5_thr_htf3, m5_w_htf)

// Агрегированные состояния для экспорта (используем пороги SMC m4 как репрезентативные)
bool htf1_bull_ok = raw_htf1_b >= m4_thr_htf1
bool htf2_bull_ok = raw_htf2_b >= m4_thr_htf2
bool htf3_bull_ok = raw_htf3_b >= m4_thr_htf3
bool htf1_bear_ok = raw_htf1_s >= m4_thr_htf1
bool htf2_bear_ok = raw_htf2_s >= m4_thr_htf2
bool htf3_bear_ok = raw_htf3_s >= m4_thr_htf3
int  htf_bull_conf = (htf1_bull_ok ? 1 : 0) + (htf2_bull_ok ? 1 : 0) + (htf3_bull_ok ? 1 : 0)
int  htf_bear_conf = (htf1_bear_ok ? 1 : 0) + (htf2_bear_ok ? 1 : 0) + (htf3_bear_ok ? 1 : 0)
bool ltf1_bull_ok = raw_ltf1_b >= m4_thr_ltf1
bool ltf2_bull_ok = raw_ltf2_b >= m4_thr_ltf2
bool ltf3_bull_ok = raw_ltf3_b >= m4_thr_ltf3
bool ltf1_bear_ok = raw_ltf1_s >= m4_thr_ltf1
bool ltf2_bear_ok = raw_ltf2_s >= m4_thr_ltf2
bool ltf3_bear_ok = raw_ltf3_s >= m4_thr_ltf3
int  ltf_bull_conf = (ltf1_bull_ok ? 1 : 0) + (ltf2_bull_ok ? 1 : 0) + (ltf3_bull_ok ? 1 : 0)
int  ltf_bear_conf = (ltf1_bear_ok ? 1 : 0) + (ltf2_bear_ok ? 1 : 0) + (ltf3_bear_ok ? 1 : 0)

