// МОДУЛЬ 1 — CLUSTERS VOLUME PROFILE
// ====================================================================================================================
grp_1 = "1. Clusters Volume Profile"
en_1       = input.bool(true,  "Включить Clusters VP",         group=grp_1)
lookback_1 = input.int(200,    "Период (Lookback)",  minval=10, group=grp_1)
k_1        = input.int(5,      "Кол-во кластеров", minval=2, maxval=10, group=grp_1)
iters_1    = input.int(50,     "Итерации K-Means", minval=5, maxval=50,  group=grp_1)
rows_1     = input.int(20,     "Строк на кластер (Bins)", minval=3,      group=grp_1)
vpWidth    = input.int(40,     "Ширина гистограммы (бары)", minval=5,    group=grp_1)
vpOffset   = input.int(10,     "Отступ гистограммы",                     group=grp_1)
showDots   = input.bool(true,  "Точки прайса (Price Dots)",               group=grp_1)

grp_1f = "1. Clusters VP — LTF фильтр"
m1_en_ltf   = input.bool(false, "Учитывать LTF в Master Synthesis",   group=grp_1f,
    tooltip="Если включено — подтверждённые LTF-тиры этого модуля добавляют очки в общий conf_bull/bear.")
m1_thr_ltf1 = input.int(3, "LTF1 порог (из 6 факторов)", minval=1, maxval=6, group=grp_1f,
    tooltip="Сколько из 6 факторов tf_engine() должно сработать на LTF1, чтобы тир считался подтверждённым.")
m1_thr_ltf2 = input.int(3, "LTF2 порог (из 6 факторов)", minval=1, maxval=6, group=grp_1f,
    tooltip="Порог для LTF2.")
m1_thr_ltf3 = input.int(3, "LTF3 порог (из 6 факторов)", minval=1, maxval=6, group=grp_1f,
    tooltip="Порог для LTF3.")
m1_w_ltf    = input.int(1, "Вес LTF-тира (очки за 1 тир)", minval=1, maxval=4, group=grp_1f,
    tooltip="Каждый подтверждённый LTF-тир добавляет это кол-во очков в conf_bull или conf_bear. Макс. от 3 тиров: 3×вес.")

grp_1h = "1. Clusters VP — HTF фильтр (тренд)"
m1_en_htf   = input.bool(false, "Учитывать HTF в Master Synthesis",   group=grp_1h,
    tooltip="HTF задаёт тренд. Если включено — подтверждённые HTF-тиры добавляют очки с повышенным весом.")
m1_thr_htf1 = input.int(3, "HTF1 порог (из 6 факторов)", minval=1, maxval=6, group=grp_1h,
    tooltip="Порог подтверждения для HTF1 (быстрый тренд).")
m1_thr_htf2 = input.int(3, "HTF2 порог (из 6 факторов)", minval=1, maxval=6, group=grp_1h,
    tooltip="Порог подтверждения для HTF2 (средний тренд).")
m1_thr_htf3 = input.int(3, "HTF3 порог (из 6 факторов)", minval=1, maxval=6, group=grp_1h,
    tooltip="Порог подтверждения для HTF3 (мастер-тренд).")
m1_w_htf    = input.int(2, "Вес HTF-тира (очки за 1 тир)", minval=1, maxval=4, group=grp_1h,
    tooltip="HTF обычно весит больше LTF, т.к. задаёт тренд. Макс. от 3 тиров: 3×вес.")

