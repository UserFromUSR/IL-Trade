int   p1_zone_layers_bull  = is_conn(p1_zone_layers_bull_src) ? int(p1_zone_layers_bull_src) : 0
int   p1_zone_layers_bear  = is_conn(p1_zone_layers_bear_src) ? int(p1_zone_layers_bear_src) : 0
bool  p1_choch_sw_bull     = is_conn(p1_choch_sw_bull_src)    and p1_choch_sw_bull_src    == 1
bool  p1_choch_sw_bear     = is_conn(p1_choch_sw_bear_src)    and p1_choch_sw_bear_src    == 1
int   p1_ob_touch_cnt_bull = is_conn(p1_ob_touch_cnt_bull_src) ? int(p1_ob_touch_cnt_bull_src) : 0
int   p1_ob_touch_cnt_bear = is_conn(p1_ob_touch_cnt_bear_src) ? int(p1_ob_touch_cnt_bear_src) : 0
bool  p1_ob_sd_bull        = is_conn(p1_ob_sd_bull_src)       and p1_ob_sd_bull_src       == 1
bool  p1_ob_sd_bear        = is_conn(p1_ob_sd_bear_src)       and p1_ob_sd_bear_src       == 1

// ====================================================================================================================
// ВАЛИДАЦИЯ ТАЙМФРЕЙМОВ P1 ↔ P2
// ====================================================================================================================
float p2_ltf1_mins = timeframe.in_seconds(mtf_tv_1) / 60
float p2_ltf2_mins = timeframe.in_seconds(mtf_tv_2) / 60
float p2_ltf3_mins = timeframe.in_seconds(mtf_tv_3) / 60
float p2_htf1_mins = timeframe.in_seconds(htf_tv_1) / 60
float p2_htf2_mins = timeframe.in_seconds(htf_tv_2) / 60
float p2_htf3_mins = timeframe.in_seconds(htf_tv_3) / 60

bool tf_ltf1_ok = na(p1_ltf1_tf_mins) or math.abs(p1_ltf1_tf_mins - p2_ltf1_mins) < 0.1
bool tf_ltf2_ok = na(p1_ltf2_tf_mins) or math.abs(p1_ltf2_tf_mins - p2_ltf2_mins) < 0.1
bool tf_ltf3_ok = na(p1_ltf3_tf_mins) or math.abs(p1_ltf3_tf_mins - p2_ltf3_mins) < 0.1
bool tf_htf1_ok = na(p1_htf1_tf_mins) or math.abs(p1_htf1_tf_mins - p2_htf1_mins) < 0.1
bool tf_htf2_ok = na(p1_htf2_tf_mins) or math.abs(p1_htf2_tf_mins - p2_htf2_mins) < 0.1
bool tf_htf3_ok = na(p1_htf3_tf_mins) or math.abs(p1_htf3_tf_mins - p2_htf3_mins) < 0.1
bool all_tf_ok  = tf_ltf1_ok and tf_ltf2_ok and tf_ltf3_ok and tf_htf1_ok and tf_htf2_ok and tf_htf3_ok

// ====================================================================================================================
// ПРЕДУПРЕЖДЕНИЯ — P1 не подключён / несовпадение TF
// ====================================================================================================================
if not p1_connected and barstate.islast
    label.new(bar_index, high + ta.atr(14) * 3,
        text      = "⛔ Main P1 не подключён\nSniper работает только совместно с Main P1\nПодключите индикатор через Input → Source",
        style     = label.style_label_down,
        color     = color.new(color.red, 10),
        textcolor = color.white,
        size      = size.normal)

if p1_connected and not all_tf_ok and barstate.islast
    string tf_warn = "⚠️ Несовпадение TF (P1 ≠ P2):\n"
    if not tf_ltf1_ok
        tf_warn += "LTF1: P1=" + str.tostring(p1_ltf1_tf_mins) + "м P2=" + str.tostring(p2_ltf1_mins) + "м\n"
    if not tf_ltf2_ok
        tf_warn += "LTF2: P1=" + str.tostring(p1_ltf2_tf_mins) + "м P2=" + str.tostring(p2_ltf2_mins) + "м\n"
    if not tf_ltf3_ok
        tf_warn += "LTF3: P1=" + str.tostring(p1_ltf3_tf_mins) + "м P2=" + str.tostring(p2_ltf3_mins) + "м\n"
    if not tf_htf1_ok
        tf_warn += "HTF1: P1=" + str.tostring(p1_htf1_tf_mins) + "м P2=" + str.tostring(p2_htf1_mins) + "м\n"
    if not tf_htf2_ok
        tf_warn += "HTF2: P1=" + str.tostring(p1_htf2_tf_mins) + "м P2=" + str.tostring(p2_htf2_mins) + "м\n"
    if not tf_htf3_ok
        tf_warn += "HTF3: P1=" + str.tostring(p1_htf3_tf_mins) + "м P2=" + str.tostring(p2_htf3_mins) + "м"
    label.new(bar_index, high + ta.atr(14) * 2,
        text      = tf_warn,
        style     = label.style_label_down,
        color     = color.new(color.orange, 10),
        textcolor = color.white,
        size      = size.small)

// ====================================================================================================================
// P2 ОСЦИЛЛЯТОРНЫЙ ДВИЖОК — stateless, request.security на каждый TF
// Исправлено: Z-Score взаимоисключающий (пороги ±1.0 вместо ±0.5)
// ====================================================================================================================
p2_osc_engine() =>
    float rsi_v    = ta.rsi(close, p2_rsi_len)
    bool  rsi_bull = rsi_v >= p2_rsi_bull_lo and rsi_v <= p2_rsi_bull_hi
    bool  rsi_bear = rsi_v >= p2_rsi_bear_lo and rsi_v <= p2_rsi_bear_hi

    [mac_l, mac_s, mac_h] = ta.macd(close, p2_macd_fast, p2_macd_slow, p2_macd_signal)
    bool  macd_bull = mac_l > mac_s or mac_h > 0
    bool  macd_bear = mac_l < mac_s or mac_h < 0

    float ema_f    = ta.ema(close, p2_ema_fast_len)
    float ema_s    = ta.ema(close, p2_ema_slow_len)
    bool  ema_bull = ema_f > ema_s
    bool  ema_bear = ema_f < ema_s

    // Исправлено: взаимоисключающие пороги ±1.0
    // bull: zscore < -1.0 (перепроданность — потенциал роста)
    // bear: zscore > +1.0 (перекупленность — потенциал падения)
    float zs_basis  = ta.sma(close, p2_zscore_len)
    float zs_dev    = ta.stdev(close, p2_zscore_len)
    float zscore    = zs_dev > 0 ? (close - zs_basis) / zs_dev : 0.0
    bool  zs_bull   = zscore < -1.0
    bool  zs_bear   = zscore > 1.0

    int cnt_bull = (rsi_bull ? 1 : 0) + (macd_bull ? 1 : 0) + (ema_bull ? 1 : 0) + (zs_bull ? 1 : 0)
    int cnt_bear = (rsi_bear ? 1 : 0) + (macd_bear ? 1 : 0) + (ema_bear ? 1 : 0) + (zs_bear ? 1 : 0)

    bool osc_bull_ok = cnt_bull >= p2_osc_min_ok
    bool osc_bear_ok = cnt_bear >= p2_osc_min_ok
    [osc_bull_ok, osc_bear_ok]

// ── request.security на каждый TF ────────────────────────────────────────────
[p2_ltf1_osc_b, p2_ltf1_osc_s] = request.security(syminfo.tickerid, mtf_tv_1, p2_osc_engine(), lookahead=barmerge.lookahead_off)
[p2_ltf2_osc_b, p2_ltf2_osc_s] = request.security(syminfo.tickerid, mtf_tv_2, p2_osc_engine(), lookahead=barmerge.lookahead_off)
[p2_ltf3_osc_b, p2_ltf3_osc_s] = request.security(syminfo.tickerid, mtf_tv_3, p2_osc_engine(), lookahead=barmerge.lookahead_off)
[p2_htf1_osc_b, p2_htf1_osc_s] = request.security(syminfo.tickerid, htf_tv_1, p2_osc_engine(), lookahead=barmerge.lookahead_off)
[p2_htf2_osc_b, p2_htf2_osc_s] = request.security(syminfo.tickerid, htf_tv_2, p2_osc_engine(), lookahead=barmerge.lookahead_off)
[p2_htf3_osc_b, p2_htf3_osc_s] = request.security(syminfo.tickerid, htf_tv_3, p2_osc_engine(), lookahead=barmerge.lookahead_off)

// ====================================================================================================================
// СИНХРОННЫЙ MTF КАСКАД
// Тир = P1 score >= P1 min_score AND P2 osc_ok
// P2 пересчитывает булевы из сырых скоров — единый источник истины
// ====================================================================================================================

// ── Структурный тир из P1 (пересчитан в P2 из сырых скоров) ─────────────────
bool p1_tier_ltf1_bull = p1_connected and (p1_ltf1_sb >= p1_ltf1_min)
bool p1_tier_ltf1_bear = p1_connected and (p1_ltf1_ss >= p1_ltf1_min)
bool p1_tier_ltf2_bull = p1_connected and (p1_ltf2_sb >= p1_ltf2_min)
bool p1_tier_ltf2_bear = p1_connected and (p1_ltf2_ss >= p1_ltf2_min)
bool p1_tier_ltf3_bull = p1_connected and (p1_ltf3_sb >= p1_ltf3_min)
bool p1_tier_ltf3_bear = p1_connected and (p1_ltf3_ss >= p1_ltf3_min)
bool p1_tier_htf1_bull = p1_connected and (p1_htf1_sb >= p1_htf1_min)
bool p1_tier_htf1_bear = p1_connected and (p1_htf1_ss >= p1_htf1_min)
bool p1_tier_htf2_bull = p1_connected and (p1_htf2_sb >= p1_htf2_min)
bool p1_tier_htf2_bear = p1_connected and (p1_htf2_ss >= p1_htf2_min)
bool p1_tier_htf3_bull = p1_connected and (p1_htf3_sb >= p1_htf3_min)
bool p1_tier_htf3_bear = p1_connected and (p1_htf3_ss >= p1_htf3_min)

// ── Итоговый тир = P1 структура AND P2 осцилляторы ───────────────────────────
bool tier_ltf1_bull = p1_tier_ltf1_bull and p2_ltf1_osc_b
bool tier_ltf1_bear = p1_tier_ltf1_bear and p2_ltf1_osc_s
bool tier_ltf2_bull = p1_tier_ltf2_bull and p2_ltf2_osc_b
bool tier_ltf2_bear = p1_tier_ltf2_bear and p2_ltf2_osc_s
bool tier_ltf3_bull = p1_tier_ltf3_bull and p2_ltf3_osc_b
bool tier_ltf3_bear = p1_tier_ltf3_bear and p2_ltf3_osc_s
bool tier_htf1_bull = p1_tier_htf1_bull and p2_htf1_osc_b
bool tier_htf1_bear = p1_tier_htf1_bear and p2_htf1_osc_s
bool tier_htf2_bull = p1_tier_htf2_bull and p2_htf2_osc_b
bool tier_htf2_bear = p1_tier_htf2_bear and p2_htf2_osc_s
bool tier_htf3_bull = p1_tier_htf3_bull and p2_htf3_osc_b
bool tier_htf3_bear = p1_tier_htf3_bear and p2_htf3_osc_s

// ====================================================================================================================
// MTF CASCADE TIMER-MEMORY
// ====================================================================================================================
var int blt1b = 999, var int blt2b = 999, var int blt3b = 999
var int blt1s = 999, var int blt2s = 999, var int blt3s = 999
var int bht1b = 999, var int bht2b = 999, var int bht3b = 999
var int bht1s = 999, var int bht2s = 999, var int bht3s = 999

blt1b := tier_ltf1_bull ? 0 : math.min(blt1b + 1, 999)
blt2b := tier_ltf2_bull ? 0 : math.min(blt2b + 1, 999)
blt3b := tier_ltf3_bull ? 0 : math.min(blt3b + 1, 999)
blt1s := tier_ltf1_bear ? 0 : math.min(blt1s + 1, 999)
blt2s := tier_ltf2_bear ? 0 : math.min(blt2s + 1, 999)
blt3s := tier_ltf3_bear ? 0 : math.min(blt3s + 1, 999)

bht1b := tier_htf1_bull ? 0 : math.min(bht1b + 1, 999)
bht2b := tier_htf2_bull ? 0 : math.min(bht2b + 1, 999)
bht3b := tier_htf3_bull ? 0 : math.min(bht3b + 1, 999)
bht1s := tier_htf1_bear ? 0 : math.min(bht1s + 1, 999)
bht2s := tier_htf2_bear ? 0 : math.min(bht2s + 1, 999)
bht3s := tier_htf3_bear ? 0 : math.min(bht3s + 1, 999)

// ── LTF каскад — последовательный LTF1 → LTF2 → LTF3 ───────────────────────
int mtf_state_raw_bull = blt1b <= mtf_window and blt2b <= mtf_window and blt3b <= mtf_window ? 3 :
                         blt1b <= mtf_window and blt2b <= mtf_window                         ? 2 :
                         blt1b <= mtf_window                                                  ? 1 : 0

int mtf_state_raw_bear = blt1s <= mtf_window and blt2s <= mtf_window and blt3s <= mtf_window ? 3 :
                         blt1s <= mtf_window and blt2s <= mtf_window                         ? 2 :
                         blt1s <= mtf_window                                                  ? 1 : 0

// ── HTF состояние ────────────────────────────────────────────────────────────
int htf_state_raw_bull = (bht1b <= htf_window ? 1 : 0) + (bht2b <= htf_window ? 1 : 0) + (bht3b <= htf_window ? 1 : 0)
int htf_state_raw_bear = (bht1s <= htf_window ? 1 : 0) + (bht2s <= htf_window ? 1 : 0) + (bht3s <= htf_window ? 1 : 0)

// ====================================================================================================================
// MARKET REGIME
// ====================================================================================================================
float atr14   = ta.atr(14)
float atr100  = ta.atr(100)
bool  vol_ok  = (atr14 / math.max(atr100, 1e-10)) > vol_th

float chop_tr_sum = math.sum(ta.tr, chop_len)
float chop_hi     = ta.highest(high, chop_len)
float chop_lo     = ta.lowest(low,   chop_len)
float choppiness  = 100 * math.log10(chop_tr_sum / math.max(chop_hi - chop_lo, 1e-10)) / math.log10(chop_len)

[di_plus, di_minus, adx_val] = ta.dmi(adx_len, adx_len)

bool regime_trending    = adx_val > 25 and choppiness < 50
bool regime_ranging     = choppiness > 61.8 or adx_val < 20
bool regime_compression = vol_ok == false and choppiness > 61.8

// ====================================================================================================================
// ТАЙМЕРЫ СОБЫТИЙ P1
// ====================================================================================================================
var int bars_since_choch_bull     = 999
var int bars_since_choch_bear     = 999
var int bars_since_hm_bull        = 999
var int bars_since_hm_bear        = 999
var int bars_since_sweep_bull     = 999
var int bars_since_sweep_bear     = 999
var int bars_since_sdinv_bull     = 999
var int bars_since_sdinv_bear     = 999
var int bars_since_ob_touch_bull  = 999
var int bars_since_ob_touch_bear  = 999
var int bars_since_disp_bull      = 999
var int bars_since_disp_bear      = 999
var int bars_since_zone_conf_bull = 999
var int bars_since_zone_conf_bear = 999
var int bars_since_choch_sw_bull  = 999
var int bars_since_choch_sw_bear  = 999

bars_since_choch_bull    := (p1_connected and p1_choch_src ==  1) ? 0 : math.min(bars_since_choch_bull    + 1, 999)
bars_since_choch_bear    := (p1_connected and p1_choch_src == -1) ? 0 : math.min(bars_since_choch_bear    + 1, 999)
bars_since_hm_bull       := (p1_connected and p1_hm_src    ==  1) ? 0 : math.min(bars_since_hm_bull       + 1, 999)
bars_since_hm_bear       := (p1_connected and p1_hm_src    == -1) ? 0 : math.min(bars_since_hm_bear       + 1, 999)
bars_since_sweep_bull    := (p1_connected and p1_sweep_src  ==  1) ? 0 : math.min(bars_since_sweep_bull    + 1, 999)
bars_since_sweep_bear    := (p1_connected and p1_sweep_src  == -1) ? 0 : math.min(bars_since_sweep_bear    + 1, 999)
bars_since_sdinv_bull    := (p1_connected and p1_sdinv_src  ==  1) ? 0 : math.min(bars_since_sdinv_bull    + 1, 999)
bars_since_sdinv_bear    := (p1_connected and p1_sdinv_src  == -1) ? 0 : math.min(bars_since_sdinv_bear    + 1, 999)
bars_since_ob_touch_bull := (p1_connected and p1_ob_touch_src ==  1) ? 0 : math.min(bars_since_ob_touch_bull + 1, 999)
bars_since_ob_touch_bear := (p1_connected and p1_ob_touch_src == -1) ? 0 : math.min(bars_since_ob_touch_bear + 1, 999)
bars_since_disp_bull     := (p1_connected and p1_disp_src ==  1) ? 0 : math.min(bars_since_disp_bull  + 1, 999)
bars_since_disp_bear     := (p1_connected and p1_disp_src == -1) ? 0 : math.min(bars_since_disp_bear  + 1, 999)
bars_since_zone_conf_bull := (p1_connected and p1_zone_conf_bull_src == 1) ? 0 : math.min(bars_since_zone_conf_bull + 1, 999)
bars_since_zone_conf_bear := (p1_connected and p1_zone_conf_bear_src == 1) ? 0 : math.min(bars_since_zone_conf_bear + 1, 999)
bars_since_choch_sw_bull  := (p1_connected and p1_choch_sw_bull_src == 1) ? 0 : math.min(bars_since_choch_sw_bull + 1, 999)
bars_since_choch_sw_bear  := (p1_connected and p1_choch_sw_bear_src == 1) ? 0 : math.min(bars_since_choch_sw_bear + 1, 999)
