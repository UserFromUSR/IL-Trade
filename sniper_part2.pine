f_pat_A2() =>
    r = hc_result.new()
    r.bull := en_hc_a2 and b_bostrg_bear and not sm_act_bear and bars_since_hm_bear <= 3
        and (osc_stoch_bull or osc_kde_bull) and osc_cci_bull
        and (b_sd_bull or b_ob_bull or b_fvg_precise_bull) and ltf_gate_bull
    r.bear := en_hc_a2 and b_bostrg_bull and not sm_act_bull and bars_since_hm_bull <= 3
        and (osc_stoch_bear or osc_kde_bear) and osc_cci_bear
        and (b_sd_bear or b_ob_bear or b_fvg_precise_bear) and ltf_gate_bear
    r.name_b := r.bull ? "A2: Ложный структурный пробой" : ""
    r.name_s := r.bear ? "A2: Ложный структурный пробой" : ""
    if r.bull
        r.keys_b := "BOS медвежий (ложный)|Без SM Activity|HM Sweep ≤3 бар|Adv CCI|"
        r.keys_b := f_k(r.keys_b, osc_kde_bull, "KDE RSI"), r.keys_b := f_k(r.keys_b, osc_stoch_bull, "Stoch Z")
        r.keys_b := f_k(r.keys_b, b_sd_bull, "S&D"), r.keys_b := f_k(r.keys_b, b_ob_bull, "OB"), r.keys_b := f_k(r.keys_b, b_fvg_precise_bull, "FVG")
    if r.bear
        r.keys_s := "BOS бычий (ложный)|Без SM Activity|HM Sweep ≤3 бар|Adv CCI|"
        r.keys_s := f_k(r.keys_s, osc_kde_bear, "KDE RSI"), r.keys_s := f_k(r.keys_s, osc_stoch_bear, "Stoch Z")
        r.keys_s := f_k(r.keys_s, b_sd_bear, "S&D"), r.keys_s := f_k(r.keys_s, b_ob_bear, "OB"), r.keys_s := f_k(r.keys_s, b_fvg_precise_bear, "FVG")
    r

f_pat_B1() =>
    r = hc_result.new()
    r.bull := en_hc_b1 and sm_int_bull and not sm_idx_bull and sm_act_bull
        and (b_sd_bull or b_ob_bull) and osc_kde_bull and regime_ranging and ltf_gate_bull
    r.bear := en_hc_b1 and sm_int_bear and not sm_idx_bear and sm_act_bear
        and (b_sd_bear or b_ob_bear) and osc_kde_bear and regime_ranging and ltf_gate_bear
    r.name_b := r.bull ? "B1: Тихое накопление" : ""
    r.name_s := r.bear ? "B1: Тихое распределение" : ""
