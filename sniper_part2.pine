// ====================================================================================================================
// СЕКЦИЯ 9: КОМПЛЕКСНЫЕ ХАРДКОДНЫЕ ПАТТЕРНЫ (НОВАЯ ЛОГИКА ПО ТЗ)
// ====================================================================================================================

// --- Счётчики для C1 (вычисляются до паттернов) ---
int c1_mom_bull = (osc_kde_bull ? 1 : 0) + (osc_macd_dlx_bull ? 1 : 0) + (osc_cci_bull ? 1 : 0) + (osc_stoch_bull ? 1 : 0)
int c1_vol_bull = (sm_idx_bull ? 1 : 0) + (sm_int_bull ? 1 : 0) + (osc_mdiv_bull ? 1 : 0) + (sm_act_bull ? 1 : 0)
int c1_mom_bear = (osc_kde_bear ? 1 : 0) + (osc_macd_dlx_bear ? 1 : 0) + (osc_cci_bear ? 1 : 0) + (osc_stoch_bear ? 1 : 0)
int c1_vol_bear = (sm_idx_bear ? 1 : 0) + (sm_int_bear ? 1 : 0) + (osc_mdiv_bear ? 1 : 0) + (sm_act_bear ? 1 : 0)

// ====================================================================================================================
// 9.1 Развороты
// ====================================================================================================================

// A1: Каскадный разворот
bool pat_A1_bull = en_hc_a1
     and b_smc_bull
     and bars_since_choch_bull <= 3
     and b_fvg_precise_bull
     and bars_since_hm_bull <= 5
     and (b_sd_bull or b_ob_bull)
     and (sm_act_bull or sm_idx_bull)

bool pat_A1_bear = en_hc_a1
     and b_smc_bear
     and bars_since_choch_bear <= 3
     and b_fvg_precise_bear
     and bars_since_hm_bear <= 5
     and (b_sd_bear or b_ob_bear)
     and (sm_act_bear or sm_idx_bear)

// A3: Точка PD-арбитража
bool pat_A3_bull = en_hc_a3
     and ote_score_bull == 2
     and b_fvg_precise_bull
     and b_sd_bull
     and osc_smt_bull
     and (sm_int_bull or sm_idx_bull)

bool pat_A3_bear = en_hc_a3
     and ote_score_bear == 2
     and b_fvg_precise_bear
     and b_sd_bear
     and osc_smt_bear
     and (sm_int_bear or sm_idx_bear)

// C1: Тройное дивергентное давление
bool pat_C1_bull = en_hc_c1
     and (c1_mom_bull >= 2)
     and (c1_vol_bull >= 2)
     and (osc_smt_bull or osc_tfdiv_bull)
     and (b_ob_bull or b_fvg_bull or b_sd_bull or ote_score_bull >= 1)

bool pat_C1_bear = en_hc_c1
     and (c1_mom_bear >= 2)
     and (c1_vol_bear >= 2)
     and (osc_smt_bear or osc_tfdiv_bear)
     and (b_ob_bear or b_fvg_bear or b_sd_bear or ote_score_bear >= 1)

// C3: Фрактальная конвергенция
bool pat_C3_bull = en_hc_c3
     and osc_tfdiv_bull
     and osc_peter_bull
     and osc_mdiv_bull
     and cndl_bull
     and (sm_act_bull or sm_int_bull)

bool pat_C3_bear = en_hc_c3
     and osc_tfdiv_bear
     and osc_peter_bear
     and osc_mdiv_bear
     and cndl_bear
     and (sm_act_bear or sm_int_bear)

// G3: Контртрендовый снайпер
bool pat_G3_bull = en_hc_g3
     and b_smc_bear
     and ote_score_bull == 2
     and bars_since_hm_bull <= 5
     and (total_mdiv_bull >= 4)
     and sm_idx_bull
     and osc_smt_bull
     and cndl_bull

bool pat_G3_bear = en_hc_g3
     and b_smc_bull
     and ote_score_bear == 2
     and bars_since_hm_bear <= 5
     and (total_mdiv_bear >= 4)
     and sm_idx_bear
     and osc_smt_bear
     and cndl_bear

// Ж1: Исторический кластер RSI
bool pat_ZH1_bull = en_hc_zh1
     and osc_kde_bull
     and sm_int_bull
     and b_fvg_precise_bull
     and (b_ob_bull or b_sd_bull)
     and (osc_mdiv_bull or osc_peter_bull)

bool pat_ZH1_bear = en_hc_zh1
     and osc_kde_bear
     and sm_int_bear
     and b_fvg_precise_bear
     and (b_ob_bear or b_sd_bear)
     and (osc_mdiv_bear or osc_peter_bear)

// Ж4: Снайперский OTE-вход
bool pat_ZH4_bull = en_hc_zh4
     and ote_score_bull == 2
     and b_avwap_bull
     and b_fvg_precise_bull
     and osc_smt_bull
     and (sm_int_bull or sm_idx_bull)

bool pat_ZH4_bear = en_hc_zh4
     and ote_score_bear == 2
     and b_avwap_bear
     and b_fvg_precise_bear
     and osc_smt_bear
     and (sm_int_bear or sm_idx_bear)

// ====================================================================================================================
// 9.2 Продолжение тренда
// ====================================================================================================================

// B2: Живой объёмный дисбаланс
bool pat_B2_bull = en_hc_b2
     and b_smc_bull
     and (b_fvg_bull or b_fvg_precise_bull)
     and sm_act_bull
     and sm_idx_bull
     and b_disp_bull

bool pat_B2_bear = en_hc_b2
     and b_smc_bear
     and (b_fvg_bear or b_fvg_precise_bear)
     and sm_act_bear
     and sm_idx_bear
     and b_disp_bear

// C2: Скрытая дивергенция в тренде
bool pat_C2_bull = en_hc_c2
     and b_smc_bull
     and ma_trend_bull
     and osc_peter_bull
     and (b_ob_bull or b_fvg_precise_bull)
     and sm_int_bull
     and not sm_act_bear

bool pat_C2_bear = en_hc_c2
     and b_smc_bear
     and ma_trend_bear
     and osc_peter_bear
     and (b_ob_bear or b_fvg_precise_bear)
     and sm_int_bear
     and not sm_act_bull

// D1: Контекст старшего — вход по событию
bool pat_D1_bull = en_hc_d1
     and b_smc_bull
     and (bars_since_sweep_bull <= 3 or bars_since_choch_bull <= 3)
     and (osc_kde_bull or osc_stoch_bull or osc_macd_dlx_bull)
     and (b_ob_bull or b_fvg_bull or b_sd_bull)
     and (sm_act_bull or sm_idx_bull)

bool pat_D1_bear = en_hc_d1
     and b_smc_bear
     and (bars_since_sweep_bear <= 3 or bars_since_choch_bear <= 3)
     and (osc_kde_bear or osc_stoch_bear or osc_macd_dlx_bear)
     and (b_ob_bear or b_fvg_bear or b_sd_bear)
     and (sm_act_bear or sm_idx_bear)

// D2: Тихий откат в тренде
bool pat_D2_bull = en_hc_d2
     and b_smc_bull
     and not sm_act_bear
     and (b_ob_bull or b_sd_bull or b_ob_fresh_bull)
     and sm_idx_bull
     and sm_int_bull

bool pat_D2_bear = en_hc_d2
     and b_smc_bear
     and not sm_act_bull
     and (b_ob_bear or b_sd_bear or b_ob_fresh_bear)
     and sm_idx_bear
     and sm_int_bear

// G2: Взрыв из консолидации
bool pat_G2_bull = en_hc_g2
     and (regime_compression[1] or regime_ranging[1])
     and b_sdinv_bull
     and sm_act_bull
     and b_disp_bull
     and (b_smc_bull or osc_kde_bull or ma_trend_bull)

bool pat_G2_bear = en_hc_g2
     and (regime_compression[1] or regime_ranging[1])
     and b_sdinv_bear
     and sm_act_bear
     and b_disp_bear
     and (b_smc_bear or osc_kde_bear or ma_trend_bear)

// Ж2: Структурный объёмный всплеск
bool pat_ZH2_bull = en_hc_zh2
     and b_bostrg_bull
     and sm_act_bull
     and b_smc_bull
     and (sm_idx_bull or sm_int_bull)

bool pat_ZH2_bear = en_hc_zh2
     and b_bostrg_bear
     and sm_act_bear
     and b_smc_bear
     and (sm_idx_bear or sm_int_bear)

// Ж6: Взрыв компрессии
bool pat_ZH6_bull = en_hc_zh6
     and regime_compression
     and b_sdinv_bull
     and sm_act_bull
     and b_disp_bull
     and (b_smc_bull or ma_trend_bull)

bool pat_ZH6_bear = en_hc_zh6
     and regime_compression
     and b_sdinv_bear
     and sm_act_bear
     and b_disp_bear
     and (b_smc_bear or ma_trend_bear)

// Ж7: Возврат через AVWAP
bool pat_ZH7_bull = en_hc_zh7
     and avwap_cross_bull
     and b_smc_bull
     and b_ob_fresh_bull
     and sm_int_bull
     and (osc_kde_bull or osc_macd_dlx_bull or sm_act_bull)

bool pat_ZH7_bear = en_hc_zh7
     and avwap_cross_bear
     and b_smc_bear
     and b_ob_fresh_bear
     and sm_int_bear
     and (osc_kde_bear or osc_macd_dlx_bear or sm_act_bear)

// ====================================================================================================================
// 9.3 Ловушки и свипы
// ====================================================================================================================

// A2: Ложный структурный пробой
bool pat_A2_bull = en_hc_a2
     and b_bostrg_bear
     and not sm_act_bear
     and bars_since_hm_bear <= 3
     and (osc_stoch_bull or osc_kde_bull)
     and osc_cci_bull
     and (b_sd_bull or b_ob_bull or b_fvg_precise_bull)

bool pat_A2_bear = en_hc_a2
     and b_bostrg_bull
     and not sm_act_bull
     and bars_since_hm_bull <= 3
     and (osc_stoch_bear or osc_kde_bear)
     and osc_cci_bear
     and (b_sd_bear or b_ob_bear or b_fvg_precise_bear)

// B3: Дельта-ловушка
bool pat_B3_bull = en_hc_b3
     and sm_idx_bull
     and sm_int_bear
     and bars_since_hm_bull <= 5
     and (b_choch_bull or bars_since_choch_bull <= 5)
     and (osc_mdiv_bull and osc_peter_bull)
     and (osc_tfdiv_bull or osc_smt_bull)

bool pat_B3_bear = en_hc_b3
     and sm_idx_bear
     and sm_int_bull
     and bars_since_hm_bear <= 5
     and (b_choch_bear or bars_since_choch_bear <= 5)
     and (osc_mdiv_bear and osc_peter_bear)
     and (osc_tfdiv_bear or osc_smt_bear)

// E1: Ловушка в зоне спроса / предложения
bool pat_E1_bull = en_hc_e1
     and b_sd_bull
     and b_sdinv_bear
     and sm_act_bull
     and not sm_act_bear
     and (osc_mdiv_bull and osc_peter_bull)
     and (osc_tfdiv_bull or osc_smt_bull)

bool pat_E1_bear = en_hc_e1
     and b_sd_bear
     and b_sdinv_bull
     and sm_act_bear
     and not sm_act_bull
     and (osc_mdiv_bear and osc_peter_bear)
     and (osc_tfdiv_bear or osc_smt_bear)

// G1: Вход после снятия ликвидности
bool pat_G1_bull = en_hc_g1
     and bars_since_sweep_bull <= 3
     and (b_choch_bull or bars_since_choch_bull <= 5)
     and sm_act_bull
     and (b_ob_bull or b_fvg_precise_bull or b_sd_bull)
     and (osc_kde_bull or osc_stoch_bull or osc_macd_dlx_bull)

bool pat_G1_bear = en_hc_g1
     and bars_since_sweep_bear <= 3
     and (b_choch_bear or bars_since_choch_bear <= 5)
     and sm_act_bear
     and (b_ob_bear or b_fvg_precise_bear or b_sd_bear)
     and (osc_kde_bear or osc_stoch_bear or osc_macd_dlx_bear)

// Ж3: Межрыночный корреляционный сбой
bool pat_ZH3_bull = en_hc_zh3
     and osc_smt_bull
     and bars_since_hm_bull <= 5
     and (sm_int_bull or sm_idx_bull)
     and (b_ob_bull or b_sd_bull or b_fvg_precise_bull)

bool pat_ZH3_bear = en_hc_zh3
     and osc_smt_bear
     and bars_since_hm_bear <= 5
     and (sm_int_bear or sm_idx_bear)
     and (b_ob_bear or b_sd_bear or b_fvg_precise_bear)

// Ж5: CVD-поглощение
bool pat_ZH5_bull = en_hc_zh5
     and sm_absorption
     and cvd_bull_div
     and b_sd_bull
     and cndl_bull
     and (osc_kde_bull or osc_stoch_bull)

bool pat_ZH5_bear = en_hc_zh5
     and sm_absorption
     and cvd_bear_div
     and b_sd_bear
     and cndl_bear
     and (osc_kde_bear or osc_stoch_bear)

// ====================================================================================================================
// 9.4 Предупреждения и блокировщики
// ====================================================================================================================

// F1: Смена режима рынка (предупреждение)
bool warn_F1_shift_bull = en_hc_f1 and regime_ranging[1] and regime_trending and b_bos_bull and sm_act_bull
bool warn_F1_shift_bear = en_hc_f1 and regime_ranging[1] and regime_trending and b_bos_bear and sm_act_bear

// B1: Тихое накопление / распределение
bool pat_B1_bull = en_hc_b1
     and sm_int_bull
     and not sm_idx_bull
     and sm_act_bull
     and (b_sd_bull or b_ob_bull)
     and osc_kde_bull
     and regime_ranging

bool pat_B1_bear = en_hc_b1
     and sm_int_bear
     and not sm_idx_bear
     and sm_act_bear
     and (b_sd_bear or b_ob_bear)
     and osc_kde_bear
     and regime_ranging

// E2: Истощение тренда (предупреждение)
bool warn_E2_bull_exhaustion = en_hc_e2 and b_smc_bull and sm_int_bear and b_hm_bear and b_bb_bear
bool warn_E2_bear_exhaustion = en_hc_e2 and b_smc_bear and sm_int_bull and b_hm_bull and b_bb_bull

// E3: Блокировщик ложного CHoCH
bool block_E3_choch_bull = en_hc_e3 and b_choch_bull and not sm_act_bull and not b_hm_bull and not (osc_mdiv_bull or osc_peter_bull or osc_tfdiv_bull) and not b_sd_bull
bool block_E3_choch_bear = en_hc_e3 and b_choch_bear and not sm_act_bear and not b_hm_bear and not (osc_mdiv_bear or osc_peter_bear or osc_tfdiv_bear) and not b_sd_bear

// ====================================================================================================================
// ПРИОРИТЕТНЫЙ ВЫБОР АКТИВНОГО ПАТТЕРНА
// ====================================================================================================================
string active_hc_bull_name = ""
if pat_A1_bull
    active_hc_bull_name := "Каскадный разворот"
else if pat_A3_bull
    active_hc_bull_name := "Точка PD-арбитража"
else if pat_C1_bull
    active_hc_bull_name := "Тройное дивергентное давление"
else if pat_C3_bull
    active_hc_bull_name := "Фрактальная конвергенция"
else if pat_G3_bull
    active_hc_bull_name := "Контртрендовый снайпер"
else if pat_ZH1_bull
    active_hc_bull_name := "Исторический кластер RSI"
else if pat_ZH4_bull
    active_hc_bull_name := "Снайперский OTE-вход"
else if pat_B2_bull
    active_hc_bull_name := "Живой объёмный дисбаланс"
else if pat_C2_bull
    active_hc_bull_name := "Скрытая дивергенция в тренде"
else if pat_D1_bull
    active_hc_bull_name := "Контекст старшего — вход по событию"
else if pat_D2_bull
    active_hc_bull_name := "Тихий откат в тренде"
else if pat_G2_bull
    active_hc_bull_name := "Взрыв из консолидации"
else if pat_ZH2_bull
    active_hc_bull_name := "Структурный объёмный всплеск"
else if pat_ZH6_bull
    active_hc_bull_name := "Взрыв компрессии"
else if pat_ZH7_bull
    active_hc_bull_name := "Возврат через AVWAP"
else if pat_A2_bull
    active_hc_bull_name := "Ложный структурный пробой"
else if pat_B3_bull
    active_hc_bull_name := "Дельта-ловушка"
else if pat_E1_bull
    active_hc_bull_name := "Ловушка в зоне спроса"
else if pat_G1_bull
    active_hc_bull_name := "Вход после снятия ликвидности"
else if pat_ZH3_bull
    active_hc_bull_name := "Межрыночный корреляционный сбой"
else if pat_ZH5_bull
    active_hc_bull_name := "CVD-поглощение"
else if pat_B1_bull
    active_hc_bull_name := "Тихое накопление"

string active_hc_bear_name = ""
if pat_A1_bear
    active_hc_bear_name := "Каскадный разворот"
else if pat_A3_bear
    active_hc_bear_name := "Точка PD-арбитража"
else if pat_C1_bear
    active_hc_bear_name := "Тройное дивергентное давление"
else if pat_C3_bear
    active_hc_bear_name := "Фрактальная конвергенция"
else if pat_G3_bear
    active_hc_bear_name := "Контртрендовый снайпер"
else if pat_ZH1_bear
    active_hc_bear_name := "Исторический кластер RSI"
else if pat_ZH4_bear
    active_hc_bear_name := "Снайперский OTE-вход"
else if pat_B2_bear
    active_hc_bear_name := "Живой объёмный дисбаланс"
else if pat_C2_bear
    active_hc_bear_name := "Скрытая дивергенция в тренде"
else if pat_D1_bear
    active_hc_bear_name := "Контекст старшего — вход по событию"
else if pat_D2_bear
    active_hc_bear_name := "Тихий откат в тренде"
else if pat_G2_bear
    active_hc_bear_name := "Взрыв из консолидации"
else if pat_ZH2_bear
    active_hc_bear_name := "Структурный объёмный всплеск"
else if pat_ZH6_bear
    active_hc_bear_name := "Взрыв компрессии"
else if pat_ZH7_bear
    active_hc_bear_name := "Возврат через AVWAP"
else if pat_A2_bear
    active_hc_bear_name := "Ложный структурный пробой"
else if pat_B3_bear
    active_hc_bear_name := "Дельта-ловушка"
else if pat_E1_bear
    active_hc_bear_name := "Ловушка в зоне предложения"
else if pat_G1_bear
    active_hc_bear_name := "Вход после снятия ликвидности"
else if pat_ZH3_bear
    active_hc_bear_name := "Межрыночный корреляционный сбой"
else if pat_ZH5_bear
    active_hc_bear_name := "CVD-поглощение"
else if pat_B1_bear
    active_hc_bear_name := "Тихое распределение"

// ====================================================================================================================
// СЕКЦИЯ 11: ГЕНЕРАЦИЯ ФИНАЛЬНЫХ СИГНАЛОВ (ТОЛЬКО HC — БЕЗ СКОРИНГА)
// ====================================================================================================================
bool hc_buy_trigger  = active_hc_bull_name != ""
bool hc_sell_trigger = active_hc_bear_name != ""

bool is_buy  = false
bool is_sell = false

var int bars_since_buy  = 999
var int bars_since_sell = 999

if not block_E3_choch_bull
    if hc_buy_trigger and bars_since_buy >= sig_lookback
        is_buy := true
        bars_since_buy := 0

if not block_E3_choch_bear
    if hc_sell_trigger and bars_since_sell >= sig_lookback
        is_sell := true
        bars_since_sell := 0

bars_since_buy  += is_buy  ? 0 : 1
bars_since_sell += is_sell ? 0 : 1

// ====================================================================================================================
// СЕКЦИЯ 12: SL/TP РАСЧЁТ И ОТРИСОВКА (% РЕЖИМ)
// ====================================================================================================================
if is_buy
    trade_entry := close
    trade_dir := 1
    tp1_hit := false, tp2_hit := false, tp3_hit := false
    current_sl := close * (1 - sl_perc / 100)
    tp1_level := trade_entry + (trade_entry * (tp1_perc / 100))
    tp2_level := trade_entry + (trade_entry * (tp2_perc / 100))
    tp3_level := trade_entry + (trade_entry * (tp3_perc / 100))

if is_sell
    trade_entry := close
    trade_dir := -1
    tp1_hit := false, tp2_hit := false, tp3_hit := false
    current_sl := close * (1 + sl_perc / 100)
    tp1_level := trade_entry - (trade_entry * (tp1_perc / 100))
    tp2_level := trade_entry - (trade_entry * (tp2_perc / 100))
    tp3_level := trade_entry - (trade_entry * (tp3_perc / 100))

if trade_dir == 1
    if low <= current_sl
        trade_dir := 0
    else
        if high >= tp1_level and not tp1_hit
            tp1_hit := true
            if be_after_tp1
                current_sl := trade_entry
        if high >= tp2_level and not tp2_hit
            tp2_hit := true
        if high >= tp3_level and not tp3_hit
            tp3_hit := true
            trade_dir := 0

if trade_dir == -1
    if high >= current_sl
        trade_dir := 0
    else
        if low <= tp1_level and not tp1_hit
            tp1_hit := true
            if be_after_tp1
                current_sl := trade_entry
        if low <= tp2_level and not tp2_hit
            tp2_hit := true
        if low <= tp3_level and not tp3_hit
            tp3_hit := true
            trade_dir := 0

plot(en_sltp and trade_dir != 0 ? trade_entry : na, "Entry", color.blue, style=plot.style_linebr)
plot(en_sltp and trade_dir != 0 ? current_sl : na, "Stop Loss", color.red, style=plot.style_linebr)
plot(en_sltp and trade_dir != 0 and not tp1_hit ? tp1_level : na, "TP1", color.new(color.green, 50), style=plot.style_linebr)
plot(en_sltp and trade_dir != 0 and not tp2_hit ? tp2_level : na, "TP2", color.new(color.green, 30), style=plot.style_linebr)
plot(en_sltp and trade_dir != 0 and not tp3_hit ? tp3_level : na, "TP3", color.green, style=plot.style_linebr)

// ====================================================================================================================
// СЕКЦИЯ 13: ВИЗУАЛИЗАЦИЯ — СИГНАЛЫ + ИНФОБЛОК (НОВАЯ СТРУКТУРА ПО ТЗ)
// ====================================================================================================================
f_get_align(str) =>
    str == "Left" ? text.align_left : str == "Right" ? text.align_right : text.align_center

if is_buy and en_sig_labels
    label.new(bar_index, low - ta.atr(14), text="BUY", style=label.style_label_up, color=color.new(#089981, 0), textcolor=sig_text_col, size=get_size(sig_text_size))

if is_sell and en_sig_labels
