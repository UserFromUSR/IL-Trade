f_pat_ZH4() =>
    r = hc_result.new()
    r.bull := en_hc_zh4 and ote_score_bull == 2 and b_avwap_bull and b_fvg_precise_bull
        and osc_smt_bull and sm_int_bull and (ltf_bull_conf >= 3)
    r.bear := en_hc_zh4 and ote_score_bear == 2 and b_avwap_bear and b_fvg_precise_bear
        and osc_smt_bear and sm_int_bear and (ltf_bear_conf >= 3)
    r.name_b := r.bull ? "Ж4: Снайперский OTE-вход" : ""
    r.name_s := r.bear ? "Ж4: Снайперский OTE-вход" : ""
