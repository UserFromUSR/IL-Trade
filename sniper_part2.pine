f_pat_N1() =>
    r = hc_result.new()
    bool zn_b = b_ob_bull or b_sd_bull or b_fvg_precise_bull or ote_score_bull == 2
    bool zn_s = b_ob_bear or b_sd_bear or b_fvg_precise_bear or ote_score_bear == 2
    r.bull := en_hc_n1 and osc_kde_bull and osc_stoch_bull and osc_macd_dlx_bull and osc_cci_bull
        and zn_b and (sm_act_bull or sm_int_bull) and vol_ok and ltf_gate_bull
    r.bear := en_hc_n1 and osc_kde_bear and osc_stoch_bear and osc_macd_dlx_bear and osc_cci_bear
        and zn_s and (sm_act_bear or sm_int_bear) and vol_ok and ltf_gate_bear
    r.name_b := r.bull ? "N1: Квадратурный осц. консенсус" : ""
    r.name_s := r.bear ? "N1: Квадратурный осц. консенсус" : ""
    if r.bull
        r.keys_b := "KDE RSI|Stoch Z|MACD Deluxe|Adv CCI|Волатильность ОК|"
        r.keys_b := f_k(r.keys_b, sm_act_bull, "SM Activity"), r.keys_b := f_k(r.keys_b, sm_int_bull, "SM Interest")
        r.keys_b := f_k(r.keys_b, b_ob_bull, "OB"), r.keys_b := f_k(r.keys_b, b_sd_bull, "S&D")
        r.keys_b := f_k(r.keys_b, b_fvg_precise_bull, "FVG"), r.keys_b := f_k(r.keys_b, ote_score_bull == 2, "OTE 2")
    if r.bear
        r.keys_s := "KDE RSI|Stoch Z|MACD Deluxe|Adv CCI|Волатильность ОК|"
        r.keys_s := f_k(r.keys_s, sm_act_bear, "SM Activity"), r.keys_s := f_k(r.keys_s, sm_int_bear, "SM Interest")
        r.keys_s := f_k(r.keys_s, b_ob_bear, "OB"), r.keys_s := f_k(r.keys_s, b_sd_bear, "S&D")
        r.keys_s := f_k(r.keys_s, b_fvg_precise_bear, "FVG"), r.keys_s := f_k(r.keys_s, ote_score_bear == 2, "OTE 2")
    r

f_pat_N2() =>
    r = hc_result.new()
    bool zn_b = b_ob_bull or b_sd_bull or b_fvg_precise_bull or ote_score_bull >= 1
    bool zn_s = b_ob_bear or b_sd_bear or b_fvg_precise_bear or ote_score_bear >= 1
    r.bull := en_hc_n2 and osc_mdiv_bull and osc_peter_bull and osc_tfdiv_bull and osc_smt_bull
        and total_mdiv_bull >= 3 and zn_b and (sm_int_bull or sm_idx_bull or sm_act_bull) and vol_ok and ltf_gate_bull
    r.bear := en_hc_n2 and osc_mdiv_bear and osc_peter_bear and osc_tfdiv_bear and osc_smt_bear
        and total_mdiv_bear >= 3 and zn_s and (sm_int_bear or sm_idx_bear or sm_act_bear) and vol_ok and ltf_gate_bear
    r.name_b := r.bull ? "N2: Полная дивергентная конвергенция" : ""
    r.name_s := r.bear ? "N2: Полная дивергентная конвергенция" : ""
    if r.bull
        r.keys_b := "Multi-Div (" + str.tostring(total_mdiv_bull) + ")|PeterO Div|Fractal Div|SMT Div|OTE ≥1|Волат. ОК|"
        r.keys_b := f_k(r.keys_b, sm_int_bull, "SM Interest"), r.keys_b := f_k(r.keys_b, sm_idx_bull, "SM Index")
        r.keys_b := f_k(r.keys_b, sm_act_bull, "SM Activity")
    if r.bear
        r.keys_s := "Multi-Div (" + str.tostring(total_mdiv_bear) + ")|PeterO Div|Fractal Div|SMT Div|OTE ≥1|Волат. ОК|"
        r.keys_s := f_k(r.keys_s, sm_int_bear, "SM Interest"), r.keys_s := f_k(r.keys_s, sm_idx_bear, "SM Index")
        r.keys_s := f_k(r.keys_s, sm_act_bear, "SM Activity")
    r

f_pat_N3() =>
    r = hc_result.new()
    bool ph1_b = bars_since_hm_bull <= 10, bool ph2_b = bars_since_sm_act_bull_N3 >= 2 and bars_since_sm_act_bull_N3 <= 8
    bool ph3_b = not sm_act_bull and sm_int_bull
    bool ph1_s = bars_since_hm_bear <= 10, bool ph2_s = bars_since_sm_act_bear_N3 >= 2 and bars_since_sm_act_bear_N3 <= 8
    bool ph3_s = not sm_act_bear and sm_int_bear
    r.bull := en_hc_n3 and ph1_b and ph2_b and ph3_b and (b_ob_bull or b_sd_bull)
        and (osc_kde_bull or osc_stoch_bull) and b_smc_bull and ltf_gate_bull
    r.bear := en_hc_n3 and ph1_s and ph2_s and ph3_s and (b_ob_bear or b_sd_bear)
        and (osc_kde_bear or osc_stoch_bear) and b_smc_bear and ltf_gate_bear
    r.name_b := r.bull ? "N3: Трёхфазный цикл накопления" : ""
    r.name_s := r.bear ? "N3: Трёхфазный цикл накопления" : ""
    if r.bull
        r.keys_b := "Ф1: HM Sweep ≤10 бар|Ф2: SM Act 2-8 бар назад|Ф3: SM Int (без Act)|SMC бычий|"
        r.keys_b := f_k(r.keys_b, b_ob_bull, "OB"), r.keys_b := f_k(r.keys_b, b_sd_bull, "S&D")
        r.keys_b := f_k(r.keys_b, osc_kde_bull, "KDE RSI"), r.keys_b := f_k(r.keys_b, osc_stoch_bull, "Stoch Z")
    if r.bear
        r.keys_s := "Ф1: HM Sweep ≤10 бар|Ф2: SM Act 2-8 бар назад|Ф3: SM Int (без Act)|SMC медвежий|"
        r.keys_s := f_k(r.keys_s, b_ob_bear, "OB"), r.keys_s := f_k(r.keys_s, b_sd_bear, "S&D")
        r.keys_s := f_k(r.keys_s, osc_kde_bear, "KDE RSI"), r.keys_s := f_k(r.keys_s, osc_stoch_bear, "Stoch Z")
    r

