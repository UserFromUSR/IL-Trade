    r = hc_result.new()
    r.bull := en_hc_zh1 and osc_kde_bull and sm_int_bull and b_fvg_precise_bull
        and (b_ob_bull or b_sd_bull) and (osc_mdiv_bull or osc_peter_bull) and ltf_gate_bull
