        r.keys_b := "SM Interest (без Index)|SM Activity|KDE RSI|Флэт-режим|"
        r.keys_b := f_k(r.keys_b, b_sd_bull, "S&D Demand"), r.keys_b := f_k(r.keys_b, b_ob_bull, "OB State")
    if r.bear
        r.keys_s := "SM Interest (без Index)|SM Activity|KDE RSI|Флэт-режим|"
        r.keys_s := f_k(r.keys_s, b_sd_bear, "S&D Supply"), r.keys_s := f_k(r.keys_s, b_ob_bear, "OB State")
    r

f_pat_B3() =>
    r = hc_result.new()
    r.bull := en_hc_b3 and sm_idx_bull and sm_int_bear and bars_since_hm_bull <= 5
        and (b_choch_bull or bars_since_choch_bull <= 5) and (osc_mdiv_bull and osc_peter_bull)
        and (osc_tfdiv_bull or osc_smt_bull) and ltf_gate_bull
    r.bear := en_hc_b3 and sm_idx_bear and sm_int_bull and bars_since_hm_bear <= 5
        and (b_choch_bear or bars_since_choch_bear <= 5) and (osc_mdiv_bear and osc_peter_bear)
        and (osc_tfdiv_bear or osc_smt_bear) and ltf_gate_bear
    r.name_b := r.bull ? "B3: Дельта-ловушка" : ""
    r.name_s := r.bear ? "B3: Дельта-ловушка" : ""
    if r.bull
        r.keys_b := "SM Index бычий|SM Interest медвежий (дивергенция)|HM ≤5 бар|Multi-Div|PeterO Div|"
        r.keys_b := f_k(r.keys_b, bars_since_choch_bull<=5, "CHoCH ≤5 бар")
        r.keys_b := f_k(r.keys_b, osc_tfdiv_bull, "Fractal Div"), r.keys_b := f_k(r.keys_b, osc_smt_bull, "SMT Div")
    if r.bear
