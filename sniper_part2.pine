        r.keys_b := f_k(r.keys_b, b_sd_bull, "S&D"), r.keys_b := f_k(r.keys_b, sm_int_bull, "SM Interest")
        r.keys_b := f_k(r.keys_b, sm_idx_bull, "SM Index")
    if r.bear
        r.keys_s := "LTF 3/3 тира|SMC медвежий|OTE ≥1|"
        r.keys_s := f_k(r.keys_s, b_ob_bear, "OB"), r.keys_s := f_k(r.keys_s, b_fvg_precise_bear, "FVG")
        r.keys_s := f_k(r.keys_s, b_sd_bear, "S&D"), r.keys_s := f_k(r.keys_s, sm_int_bear, "SM Interest")
        r.keys_s := f_k(r.keys_s, sm_idx_bear, "SM Index")
    r

