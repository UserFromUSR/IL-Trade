    r.name_s := r.bear ? "Ж1: Исторический кластер RSI" : ""
    if r.bull
        r.keys_b := "KDE RSI|SM Interest|FVG точный|"
        r.keys_b := f_k(r.keys_b, b_ob_bull, "OB"), r.keys_b := f_k(r.keys_b, b_sd_bull, "S&D Demand")
        r.keys_b := f_k(r.keys_b, osc_mdiv_bull, "Multi-Div"), r.keys_b := f_k(r.keys_b, osc_peter_bull, "PeterO Div")
    if r.bear
        r.keys_s := "KDE RSI|SM Interest|FVG точный|"
        r.keys_s := f_k(r.keys_s, b_ob_bear, "OB"), r.keys_s := f_k(r.keys_s, b_sd_bear, "S&D Supply")
        r.keys_s := f_k(r.keys_s, osc_mdiv_bear, "Multi-Div"), r.keys_s := f_k(r.keys_s, osc_peter_bear, "PeterO Div")
