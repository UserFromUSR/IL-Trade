        info += (sm_act_bear ? "✅ SM Activity всплеск\n" : "✅ SM Index медведи\n")
    else if pat_D2_bear
        info += "✅ SMC тренд медвежий\n"
        info += "✅ SM Activity тихий (откат)\n"
        if b_ob_bear
            info += "✅ Order Block\n"
        else if b_sd_bear
            info += "✅ S&D Supply\n"
        else if b_ob_fresh_bear
            info += "✅ Fresh OB (1й вход)\n"
        info += "✅ SM Index медведи\n"
        info += "✅ SM Interest\n"
    else if pat_G2_bear
        info += "✅ Предыдущая фаза: компрессия/флэт\n"
        info += "✅ S&D пробой\n"
        info += "✅ SM Activity всплеск\n"
        info += "✅ Displacement свеча\n"
        if b_smc_bear
            info += "✅ SMC тренд медвежий\n"
        else if osc_kde_bear
            info += "✅ KDE RSI моментум\n"
        else if ma_trend_bear
            info += "✅ MA тренд медвежий\n"
    else if pat_ZH2_bear
        info += "✅ BOS триггер\n"
        info += "✅ SM Activity всплеск\n"
        info += "✅ SMC тренд медвежий\n"
        info += (sm_idx_bear ? "✅ SM Index медведи\n" : "✅ SM Interest\n")
    else if pat_ZH6_bear
        info += "✅ Фаза компрессии\n"
        info += "✅ S&D пробой\n"
        info += "✅ SM Activity всплеск\n"
        info += "✅ Displacement свеча\n"
        info += (b_smc_bear ? "✅ SMC тренд медвежий\n" : "✅ MA тренд медвежий\n")
    else if pat_ZH7_bear
        info += "✅ AVWAP пересечение вниз\n"
        info += "✅ SMC тренд медвежий\n"
        info += "✅ Fresh OB (1й вход)\n"
        info += "✅ SM Interest\n"
        if osc_kde_bear
            info += "✅ KDE RSI моментум\n"
        else if osc_macd_dlx_bear
            info += "✅ MACD Dlx сигнал\n"
        else if sm_act_bear
            info += "✅ SM Activity всплеск\n"
    else if pat_A2_bear
        info += "✅ Ложный BOS бычий\n"
        info += "✅ SM Activity отсутствует\n"
        info += "✅ HeatMap снят (" + str.tostring(bars_since_hm_bull) + " бар)\n"
        info += (osc_stoch_bear ? "✅ Stoch Z разворот\n" : "✅ KDE RSI моментум\n")
        info += "✅ CCI разворот\n"
        if b_sd_bear
            info += "✅ S&D Supply\n"
        else if b_ob_bear
            info += "✅ Order Block\n"
        else if b_fvg_precise_bear
            info += "✅ FVG точный вход\n"
    else if pat_B3_bear
        info += "✅ SM Index медведи\n"
        info += "✅ SM Interest бычий (противофаза)\n"
        info += "✅ HeatMap снят (" + str.tostring(bars_since_hm_bear) + " бар)\n"
        info += (b_choch_bear ? "✅ CHoCH медвежий\n" : "✅ CHoCH (" + str.tostring(bars_since_choch_bear) + " бар)\n")
        info += "✅ Multi-Div (" + str.tostring(total_mdiv_bear) + ")\n"
        info += "✅ PeterO дивергенция\n"
        info += (osc_tfdiv_bear ? "✅ Фрактальная Div\n" : "✅ SMT дивергенция\n")
    else if pat_E1_bear
        info += "✅ S&D Supply\n"
        info += "✅ S&D ложный пробой вверх\n"
        info += "✅ SM Activity всплеск (поглощение)\n"
        info += "✅ Multi-Div (" + str.tostring(total_mdiv_bear) + ")\n"
        info += "✅ PeterO дивергенция\n"
        info += (osc_tfdiv_bear ? "✅ Фрактальная Div\n" : "✅ SMT дивергенция\n")
    else if pat_G1_bear
        info += "✅ Sweep (" + str.tostring(bars_since_sweep_bear) + " бар назад)\n"
        info += (b_choch_bear ? "✅ CHoCH медвежий\n" : "✅ CHoCH (" + str.tostring(bars_since_choch_bear) + " бар)\n")
        info += "✅ SM Activity всплеск\n"
        if b_ob_bear
            info += "✅ Order Block\n"
        else if b_fvg_precise_bear
            info += "✅ FVG точный вход\n"
        else if b_sd_bear
            info += "✅ S&D Supply\n"
        if osc_kde_bear
            info += "✅ KDE RSI моментум\n"
        else if osc_stoch_bear
            info += "✅ Stoch Z разворот\n"
        else if osc_macd_dlx_bear
            info += "✅ MACD Dlx сигнал\n"
    else if pat_ZH3_bear
        info += "✅ SMT дивергенция\n"
        info += "✅ HeatMap снят (" + str.tostring(bars_since_hm_bear) + " бар)\n"
        info += (sm_int_bear ? "✅ SM Interest\n" : "✅ SM Index медведи\n")
        if b_ob_bear
            info += "✅ Order Block\n"
        else if b_sd_bear
            info += "✅ S&D Supply\n"
        else if b_fvg_precise_bear
            info += "✅ FVG точный вход\n"
    else if pat_ZH5_bear
        info += "✅ CVD Absorption (поглощение)\n"
        info += "✅ CVD медвежья дивергенция\n"
        info += "✅ S&D Supply\n"
        info += "✅ Свечной паттерн: " + cndl_name + "\n"
        info += (osc_kde_bear ? "✅ KDE RSI моментум\n" : "✅ Stoch Z разворот\n")
    else if pat_B1_bear
        info += "✅ SM Interest (распределение)\n"
        info += "✅ SM Index нейтральный\n"
        info += "✅ SM Activity всплеск\n"
        info += (b_sd_bear ? "✅ S&D Supply\n" : "✅ Order Block\n")
        info += "✅ KDE RSI моментум\n"
        info += "✅ Фаза флэта (ranging)\n"

    // --- Бонусы SELL ---
    string bonus_str = ""

    bool hc_uses_ote2_b     = pat_A3_bear or pat_G3_bear or pat_ZH4_bear
    bool hc_uses_ob_fresh_b = pat_D2_bear or pat_ZH7_bear
    bool hc_uses_disp_b     = pat_B2_bear or pat_G2_bear or pat_ZH6_bear
    bool hc_uses_cndl_b     = pat_C3_bear or pat_G3_bear or pat_ZH5_bear
    bool hc_uses_smt_b      = pat_A3_bear or pat_C1_bear or pat_G3_bear or pat_ZH4_bear or pat_B3_bear or pat_E1_bear or pat_ZH3_bear
    bool hc_uses_kde_b      = pat_ZH1_bear or pat_A2_bear or pat_ZH7_bear or pat_D1_bear or pat_G1_bear or pat_G2_bear or pat_B1_bear
    bool hc_uses_stoch_b    = pat_A2_bear or pat_D1_bear or pat_G1_bear or pat_ZH5_bear
    bool hc_uses_macd_dlx_b = pat_D1_bear or pat_ZH7_bear or pat_G1_bear
    bool hc_uses_mdiv_b     = pat_C1_bear or pat_C3_bear or pat_G3_bear or pat_B3_bear or pat_E1_bear
    bool hc_uses_peter_b    = pat_C3_bear or pat_B3_bear or pat_C2_bear or pat_E1_bear
    bool hc_uses_tfdiv_b    = pat_C1_bear or pat_C3_bear or pat_B3_bear or pat_E1_bear
    bool hc_uses_avwap_b    = pat_ZH4_bear or pat_ZH7_bear
    bool hc_uses_ob_b       = pat_A1_bear or pat_C1_bear or pat_D1_bear or pat_D2_bear or pat_G1_bear or pat_ZH1_bear or pat_ZH3_bear or pat_A2_bear
    bool hc_uses_sd_b       = pat_A1_bear or pat_A3_bear or pat_C1_bear or pat_D1_bear or pat_D2_bear or pat_E1_bear or pat_G1_bear or pat_ZH1_bear or pat_ZH3_bear or pat_A2_bear or pat_G3_bear or pat_ZH5_bear or pat_B1_bear
    bool hc_uses_fvg_prec_b = pat_A1_bear or pat_A3_bear or pat_C2_bear or pat_D1_bear or pat_G1_bear or pat_ZH1_bear or pat_ZH4_bear or pat_A2_bear or pat_ZH3_bear
    bool hc_uses_sm_act_b   = pat_A1_bear or pat_C3_bear or pat_B2_bear or pat_D1_bear or pat_G1_bear or pat_G2_bear or pat_ZH2_bear or pat_ZH6_bear or pat_ZH7_bear or pat_E1_bear or pat_B1_bear
    bool hc_uses_sm_idx_b   = pat_A1_bear or pat_A3_bear or pat_B2_bear or pat_C1_bear or pat_D1_bear or pat_D2_bear or pat_G3_bear or pat_ZH2_bear or pat_ZH4_bear or pat_B3_bear
    bool hc_uses_sm_int_b   = pat_A3_bear or pat_C2_bear or pat_D2_bear or pat_ZH1_bear or pat_ZH4_bear or pat_ZH7_bear or pat_B1_bear
    bool hc_uses_choch_t_b  = pat_A1_bear or pat_B3_bear or pat_G1_bear
    bool hc_uses_sweep_t_b  = pat_D1_bear or pat_G1_bear

    if ote_score_bear == 2 and not hc_uses_ote2_b
        bonus_str += "⭐ OTE 0.618–0.786\n"
    if b_ob_fresh_bear and not hc_uses_ob_fresh_b
        bonus_str += "⭐ Fresh OB (1й вход)\n"
    if b_disp_bear and not hc_uses_disp_b
        bonus_str += "⭐ Displacement свеча\n"
    if cndl_bear and not hc_uses_cndl_b
        bonus_str += "⭐ Паттерн: " + cndl_name + "\n"
    if osc_smt_bear and not hc_uses_smt_b
        bonus_str += "⭐ SMT дивергенция\n"
    if osc_kde_bear and not hc_uses_kde_b
        bonus_str += "⭐ KDE RSI моментум\n"
    if osc_stoch_bear and not hc_uses_stoch_b
        bonus_str += "⭐ Stoch Z разворот\n"
    if osc_macd_dlx_bear and not hc_uses_macd_dlx_b
        bonus_str += "⭐ MACD Dlx сигнал\n"
    if osc_mdiv_bear and not hc_uses_mdiv_b
        bonus_str += "⭐ Multi-Div (" + str.tostring(total_mdiv_bear) + ")\n"
    if osc_peter_bear and not hc_uses_peter_b
        bonus_str += "⭐ PeterO дивергенция\n"
    if osc_tfdiv_bear and not hc_uses_tfdiv_b
        bonus_str += "⭐ Фрактальная Div\n"
    if b_avwap_bear and not hc_uses_avwap_b
        bonus_str += "⭐ AVWAP выравнивание\n"
    if b_ob_bear and not hc_uses_ob_b
        bonus_str += "⭐ Order Block\n"
    if b_sd_bear and not hc_uses_sd_b
        bonus_str += "⭐ S&D Supply\n"
    if b_fvg_precise_bear and not hc_uses_fvg_prec_b
        bonus_str += "⭐ FVG точный вход\n"
    if sm_act_bear and not hc_uses_sm_act_b
        bonus_str += "⭐ SM Activity всплеск\n"
    if sm_idx_bear and not hc_uses_sm_idx_b
        bonus_str += "⭐ SM Index медведи\n"
    if sm_int_bear and not hc_uses_sm_int_b
        bonus_str += "⭐ SM Interest\n"
    if bars_since_choch_bear <= 3 and not hc_uses_choch_t_b
        bonus_str += "⭐ CHoCH (" + str.tostring(bars_since_choch_bear) + " бар)\n"
    if bars_since_sweep_bear <= 3 and not hc_uses_sweep_t_b
        bonus_str += "⭐ Sweep (" + str.tostring(bars_since_sweep_bear) + " бар)\n"
    if bars_since_hm_bear <= 3
        bonus_str += "⭐ HeatMap снят (" + str.tostring(bars_since_hm_bear) + " бар)\n"

    if bonus_str != ""
        info += "─── Бонусы ─────────────\n"
        info += bonus_str

    if warn_F1_shift_bear
        info += "⚠️ Смена режима рынка!\n"
    if warn_E2_bear_exhaustion
        info += "⚠️ Истощение тренда!\n"

    label.new(bar_index, high + ta.atr(14) * (1 + info_gap), text=info, style=label.style_label_down, color=info_bg_col, textcolor=info_text_col, size=get_size(info_text_size), textalign=f_get_align(info_align))

// ====================================================================================================================
// СЕКЦИЯ 14: ДАШБОРД (TABLE)
// ====================================================================================================================
var table dash = table.new(dash_pos_str == "Сверху справа" ? position.top_right : dash_pos_str == "Снизу справа" ? position.bottom_right : position.bottom_left, 3, 29, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.gray)

f_cell(table _tbl, int _col, int _row, string _txt, color _txt_col, color _cell_bg = na) =>
    table.cell(_tbl, _col, _row, text=_txt, text_color=_txt_col, text_size=get_size(dash_text_size_str), bgcolor=_cell_bg)

if en_dash
    f_cell(dash, 0, 0, "СИСТЕМА", dash_text_col)
    f_cell(dash, 1, 0, "СТАТУС", dash_text_col)
    f_cell(dash, 2, 0, "ДЕТАЛИ", dash_text_col)

    // MAIN CONNECTION (P1)
    f_cell(dash, 0, 1, "Связь (Main)", dash_text_col)
    f_cell(dash, 1, 1, tf_conn ? "АКТИВНА" : "ОФФЛАЙН", tf_conn ? color.lime : color.red)
    f_cell(dash, 2, 1, tf_conn ? "TF: " + str.tostring(p1_tf_mins) + "m" : "Только локально", dash_text_col)

    // МАСТЕР ФИЛЬТРЫ
    f_cell(dash, 0, 2, "Фаза Рынка", dash_text_col)
    f_cell(dash, 1, 2, regime_trending ? "ТРЕНД" : regime_ranging ? "ФЛЭТ" : regime_compression ? "КОМПРЕССИЯ" : "NEUTRAL", regime_trending ? color.lime : regime_ranging ? color.orange : regime_compression ? color.yellow : color.gray)
    f_cell(dash, 2, 2, "ADX:" + str.tostring(math.round(adx_val, 1)) + " C:" + str.tostring(math.round(choppiness, 1)), dash_text_col)

    // MAIN SMC
    f_cell(dash, 0, 3, "SMC Тренд", dash_text_col)
    f_cell(dash, 1, 3, b_smc_bull ? "БЫЧИЙ" : b_smc_bear ? "МЕДВЕЖИЙ" : "НЕТ", b_smc_bull ? color.lime : b_smc_bear ? color.red : color.gray)
    f_cell(dash, 2, 3, "Main Export", dash_text_col)

    // ОСЦИЛЛЯТОРЫ (Моментум)
    f_cell(dash, 0, 4, "KDE RSI", dash_text_col)
    f_cell(dash, 1, 4, osc_kde_bull ? "ПОКУПКА" : osc_kde_bear ? "ПРОДАЖА" : "НЕЙТРАЛЬ", osc_kde_bull ? color.lime : osc_kde_bear ? color.red : color.gray)
    f_cell(dash, 2, 4, str.tostring(math.round(kde_rsi, 1)), dash_text_col)

    f_cell(dash, 0, 5, "Stoch Z", dash_text_col)
    f_cell(dash, 1, 5, osc_stoch_bull ? "ПОКУПКА" : osc_stoch_bear ? "ПРОДАЖА" : "НЕЙТРАЛЬ", osc_stoch_bull ? color.lime : osc_stoch_bear ? color.red : color.gray)
    f_cell(dash, 2, 5, str.tostring(math.round(smoothed_scaled, 2)), dash_text_col)

    f_cell(dash, 0, 6, "MACD Deluxe", dash_text_col)
    f_cell(dash, 1, 6, osc_macd_dlx_bull ? "ПОКУПКА" : osc_macd_dlx_bear ? "ПРОДАЖА" : "НЕЙТРАЛЬ", osc_macd_dlx_bull ? color.lime : osc_macd_dlx_bear ? color.red : color.gray)
    f_cell(dash, 2, 6, str.tostring(math.round(dlx_macSeries, 1)), dash_text_col)

    f_cell(dash, 0, 7, "Adv. CCI", dash_text_col)
    f_cell(dash, 1, 7, osc_cci_bull ? "ПОКУПКА" : osc_cci_bear ? "ПРОДАЖА" : "НЕЙТРАЛЬ", osc_cci_bull ? color.lime : osc_cci_bear ? color.red : color.gray)
    f_cell(dash, 2, 7, "ST / L3", dash_text_col)

    // ДИВЕРГЕНЦИИ
    f_cell(dash, 0, 8, "Multi-Div", dash_text_col)
    f_cell(dash, 1, 8, osc_mdiv_bull ? "ПОКУПКА" : osc_mdiv_bear ? "ПРОДАЖА" : "НЕТ", osc_mdiv_bull ? color.lime : osc_mdiv_bear ? color.red : color.gray)
    f_cell(dash, 2, 8, "B:" + str.tostring(total_mdiv_bull) + " S:" + str.tostring(total_mdiv_bear), dash_text_col)

    f_cell(dash, 0, 9, "PeterO Div", dash_text_col)
    f_cell(dash, 1, 9, osc_peter_bull ? "ПОКУПКА" : osc_peter_bear ? "ПРОДАЖА" : "НЕТ", osc_peter_bull ? color.lime : osc_peter_bear ? color.red : color.gray)
    f_cell(dash, 2, 9, "NR Div", dash_text_col)

    f_cell(dash, 0, 10, "TF Fractal", dash_text_col)
    f_cell(dash, 1, 10, osc_tfdiv_bull ? "ПОКУПКА" : osc_tfdiv_bear ? "ПРОДАЖА" : "НЕТ", osc_tfdiv_bull ? color.lime : osc_tfdiv_bear ? color.red : color.gray)
    f_cell(dash, 2, 10, "Fractal + " + tfdiv_type, dash_text_col)

    f_cell(dash, 0, 11, "SMT Div", dash_text_col)
    f_cell(dash, 1, 11, osc_smt_bull ? "ПОКУПКА" : osc_smt_bear ? "ПРОДАЖА" : "НЕТ", osc_smt_bull ? color.lime : osc_smt_bear ? color.red : color.gray)
    f_cell(dash, 2, 11, "Intermarket", dash_text_col)

    // ОБЪЕМЫ (SMART MONEY)
    f_cell(dash, 0, 12, "SM Activity", dash_text_col)
    f_cell(dash, 1, 12, sm_act_bull ? "ПОКУПКА (Всплеск)" : sm_act_bear ? "ПРОДАЖА (Всплеск)" : "ШТИЛЬ", sm_act_bull ? color.lime : sm_act_bear ? color.red : color.gray)
    f_cell(dash, 2, 12, "Z-Score Thr", dash_text_col)

    f_cell(dash, 0, 13, "SM Index", dash_text_col)
    f_cell(dash, 1, 13, sm_idx_bull ? "БЫКИ ДОМИН." : sm_idx_bear ? "МЕДВЕДИ ДОМИН." : "НЕЙТРАЛЬ", sm_idx_bull ? color.lime : sm_idx_bear ? color.red : color.gray)
    f_cell(dash, 2, 13, str.tostring(math.round(sm_net_index, 2)), dash_text_col)

    f_cell(dash, 0, 14, "SM Interest", dash_text_col)
    f_cell(dash, 1, 14, sm_int_bull ? "АКУМУЛЯЦИЯ" : sm_int_bear ? "ДИСТРИБУЦИЯ" : "СПЯТ", sm_int_bull ? color.lime : sm_int_bear ? color.red : color.gray)
    f_cell(dash, 2, 14, "NVI/PVI", dash_text_col)

    // P1 ДАННЫЕ
    f_cell(dash, 0, 15, "HeatMap Swp", dash_text_col)
    f_cell(dash, 1, 15, b_hm_bull ? "СНЯЛИ НИЗ" : b_hm_bear ? "СНЯЛИ ВЕРХ" : "НЕТ", b_hm_bull ? color.lime : b_hm_bear ? color.red : color.gray)
    f_cell(dash, 2, 15, str.tostring(p1_hm_vol, format.volume), dash_text_col)

    f_cell(dash, 0, 16, "Order Block", dash_text_col)
    f_cell(dash, 1, 16, b_ob_bull ? "В ЗОНЕ BUY" : b_ob_bear ? "В ЗОНЕ SELL" : "ВНЕ ЗОН", b_ob_bull ? color.lime : b_ob_bear ? color.red : color.gray)
    f_cell(dash, 2, 16, b_ob_fresh_bull or b_ob_fresh_bear ? "FRESH (1 Touch)" : "Mitigated", dash_text_col)

    f_cell(dash, 0, 17, "S&D Zone", dash_text_col)
    f_cell(dash, 1, 17, b_sd_bull ? "DEMAND" : b_sd_bear ? "SUPPLY" : "ВНЕ ЗОН", b_sd_bull ? color.lime : b_sd_bear ? color.red : color.gray)
    f_cell(dash, 2, 17, b_sdinv_bull or b_sdinv_bear ? "Breakout Alert" : "Hold", dash_text_col)

    f_cell(dash, 0, 18, "FVG POC", dash_text_col)
    f_cell(dash, 1, 18, b_fvg_bull ? "В БЫЧЬЕМ" : b_fvg_bear ? "В МЕДВЕЖЬЕМ" : "ВНЕ GAP", b_fvg_bull ? color.lime : b_fvg_bear ? color.red : color.gray)
    f_cell(dash, 2, 18, b_fvg_precise_bull or b_fvg_precise_bear ? "Precise In" : "Near", dash_text_col)

    f_cell(dash, 0, 19, "SMC Sweep", dash_text_col)
    f_cell(dash, 1, 19, b_sweep_bull ? "СВЕЙП НИЗ" : b_sweep_bear ? "СВЕЙП ВЕРХ" : "НЕТ", b_sweep_bull ? color.lime : b_sweep_bear ? color.red : color.gray)
    f_cell(dash, 2, 19, "x", dash_text_col)

    f_cell(dash, 0, 20, "Candle Pat", dash_text_col)
    f_cell(dash, 1, 20, cndl_bull ? "БЫЧИЙ" : cndl_bear ? "МЕДВЕЖИЙ" : "НЕТ", cndl_bull ? color.lime : cndl_bear ? color.red : color.gray)
    f_cell(dash, 2, 20, cndl_name, dash_text_col)

    f_cell(dash, 0, 21, "SMC BOS", dash_text_col)
    f_cell(dash, 1, 21, b_bos_bull ? "BOS (BULL)" : b_bos_bear ? "BOS (BEAR)" : "НЕТ", b_bos_bull ? color.lime : b_bos_bear ? color.red : color.gray)
    f_cell(dash, 2, 21, "LvL: " + str.tostring(p1_bos_level), dash_text_col)

    f_cell(dash, 0, 22, "SMC CHoCH", dash_text_col)
    f_cell(dash, 1, 22, b_choch_bull ? "CHoCH (BULL)" : b_choch_bear ? "CHoCH (BEAR)" : "НЕТ", b_choch_bull ? color.lime : b_choch_bear ? color.red : color.gray)
    f_cell(dash, 2, 22, "LvL: " + str.tostring(p1_choch_lvl), dash_text_col)

    f_cell(dash, 0, 23, "True OTE", dash_text_col)
    f_cell(dash, 1, 23, ote_score_bull == 2 ? "OTE LONG" : ote_score_bear == 2 ? "OTE SHORT" : ote_score_bull == 1 ? "DISCOUNT" : ote_score_bear == 1 ? "PREMIUM" : "EQUATOR", ote_score_bull == 2 or ote_score_bear == 2 ? color.lime : ote_score_bull == 1 or ote_score_bear == 1 ? color.yellow : color.gray)
    f_cell(dash, 2, 23, "Fibo Matrix", dash_text_col)

    f_cell(dash, 0, 24, "AVWAP", dash_text_col)
    f_cell(dash, 1, 24, b_avwap_bull ? "ЦЕНА ВЫШЕ" : b_avwap_bear ? "ЦЕНА НИЖЕ" : "НЕТ ДАННЫХ", b_avwap_bull ? color.lime : b_avwap_bear ? color.red : color.gray)
    f_cell(dash, 2, 24, str.tostring(p1_avwap, format.mintick), dash_text_col)

    f_cell(dash, 0, 25, "Displacement", dash_text_col)
    f_cell(dash, 1, 25, b_disp_bull ? "IMPULSE UP" : b_disp_bear ? "IMPULSE DOWN" : "FLAT", b_disp_bull ? color.lime : b_disp_bear ? color.red : color.gray)
    f_cell(dash, 2, 25, "Body > 1.5 ATR", dash_text_col)

    f_cell(dash, 0, 26, "Volume CVD", dash_text_col)
    f_cell(dash, 1, 26, sm_absorption ? "ABSORPTION" : cvd_bull_div ? "BULL DIV" : cvd_bear_div ? "BEAR DIV" : "NORMAL", sm_absorption ? color.yellow : cvd_bull_div ? color.lime : cvd_bear_div ? color.red : color.gray)
    f_cell(dash, 2, 26, "CVD Delta", dash_text_col)

    // ACTIVE PATTERN ROW
    string p_txt = active_hc_bull_name != "" ? active_hc_bull_name : active_hc_bear_name != "" ? active_hc_bear_name : "Сбор данных..."
    color p_col = active_hc_bull_name != "" ? color.lime : active_hc_bear_name != "" ? color.red : color.gray
    if warn_F1_shift_bull or warn_F1_shift_bear
        p_txt := "⚠️ F1: REGIME SHIFT DETECTED"
        p_col := color.orange
    f_cell(dash, 0, 27, "ХАРДКОД ПАТТЕРН", dash_text_col)
    table.merge_cells(dash, 1, 27, 2, 27)
    f_cell(dash, 1, 27, p_txt, p_col)
