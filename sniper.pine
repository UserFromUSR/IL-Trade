f_pat_D1() =>
    r = hc_result.new()
    bool a_b = b_smc_bull and bars_since_sweep_bull <= 3 and (osc_kde_bull or osc_stoch_bull)
        and (osc_macd_dlx_bull or osc_cci_bull) and (b_ob_bull or b_fvg_precise_bull or b_sd_bull)
        and (sm_act_bull or sm_idx_bull) and ote_score_bull >= 1 and ltf_gate_bull
    bool b_b = b_smc_bull and bars_since_choch_bull <= 3 and bars_since_sweep_bull > 10
        and (osc_kde_bull or osc_macd_dlx_bull) and (b_ob_bull or b_fvg_precise_bull or b_sd_bull)
        and sm_int_bull and ote_score_bull >= 1 and ltf_gate_bull
    bool a_s = b_smc_bear and bars_since_sweep_bear <= 3 and (osc_kde_bear or osc_stoch_bear)
        and (osc_macd_dlx_bear or osc_cci_bear) and (b_ob_bear or b_fvg_precise_bear or b_sd_bear)
        and (sm_act_bear or sm_idx_bear) and ote_score_bear >= 1 and ltf_gate_bear
    bool b_s = b_smc_bear and bars_since_choch_bear <= 3 and bars_since_sweep_bear > 10
        and (osc_kde_bear or osc_macd_dlx_bear) and (b_ob_bear or b_fvg_precise_bear or b_sd_bear)
        and sm_int_bear and ote_score_bear >= 1 and ltf_gate_bear
    r.bull := en_hc_d1 and (a_b or b_b), r.bear := en_hc_d1 and (a_s or b_s)
    r.name_b := r.bull ? "D1: Контекст старший — вход по событию" : ""
    r.name_s := r.bear ? "D1: Контекст старший — вход по событию" : ""
    if r.bull
        string sub = a_b ? "Post-Sweep" : "Post-CHoCH"
        r.keys_b := "SMC бычий|" + sub + "|OTE ≥1|"
        r.keys_b := f_k(r.keys_b, bars_since_sweep_bull<=3, "Sweep ≤3 бар")
        r.keys_b := f_k(r.keys_b, bars_since_choch_bull<=3, "CHoCH ≤3 бар")
        r.keys_b := f_k(r.keys_b, sm_act_bull, "SM Activity"), r.keys_b := f_k(r.keys_b, sm_idx_bull, "SM Index")
        r.keys_b := f_k(r.keys_b, sm_int_bull, "SM Interest")
        r.keys_b := f_k(r.keys_b, b_ob_bull, "OB"), r.keys_b := f_k(r.keys_b, b_sd_bull, "S&D"), r.keys_b := f_k(r.keys_b, b_fvg_precise_bull, "FVG")
    if r.bear
        string sub = a_s ? "Post-Sweep" : "Post-CHoCH"
        r.keys_s := "SMC медвежий|" + sub + "|OTE ≥1|"
        r.keys_s := f_k(r.keys_s, bars_since_sweep_bear<=3, "Sweep ≤3 бар")
        r.keys_s := f_k(r.keys_s, bars_since_choch_bear<=3, "CHoCH ≤3 бар")
        r.keys_s := f_k(r.keys_s, sm_act_bear, "SM Activity"), r.keys_s := f_k(r.keys_s, sm_idx_bear, "SM Index")
        r.keys_s := f_k(r.keys_s, sm_int_bear, "SM Interest")
        r.keys_s := f_k(r.keys_s, b_ob_bear, "OB"), r.keys_s := f_k(r.keys_s, b_sd_bear, "S&D"), r.keys_s := f_k(r.keys_s, b_fvg_precise_bear, "FVG")
    r

