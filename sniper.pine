// ====================================================================================================================
grp_hc_exh = "9.4. Hardcoded: Warnings & Exits"
en_hc_f1   = input.bool(true,"F1: Regime Shift Warning 🔄",                  group=grp_hc_exh)
en_hc_b1   = input.bool(true,"B1: Тихий институционал (Accumulation)",       group=grp_hc_exh)
en_hc_e2   = input.bool(true,"E2: Истощение тренда ⚠️",                       group=grp_hc_exh)
en_hc_e3   = input.bool(true,"E3: Ложный CHoCH (Блокиратор) 🛑",             group=grp_hc_exh)

// ====================================================================================================================
// ИНИЦИАЛИЗАЦИЯ P1 ИСТОЧНИКОВ
// ====================================================================================================================
is_conn(src) =>
    not na(p1_alive_src) and p1_alive_src == 9999.0 and not na(src)

bool tf_conn         = is_conn(p1_tf_src)
bool smc_conn        = is_conn(p1_smc_src)
bool bos_conn        = is_conn(p1_bos_src)
bool bostrg_conn     = is_conn(p1_bos_trig_src)
bool ob_conn         = is_conn(p1_ob_src)
bool sd_conn         = is_conn(p1_sd_src)
bool fvg_conn        = is_conn(p1_fvg_src)
bool bb_conn         = is_conn(p1_bb_src)
bool hm_conn         = is_conn(p1_hm_src)
bool sdinv_conn      = is_conn(p1_sdinv_src)
bool sweep_conn      = is_conn(p1_sweep_src)
bool choch_conn      = is_conn(p1_choch_src)
bool pd_conn         = is_conn(p1_pd_src)
bool ob_touch_conn   = is_conn(p1_ob_touch_src)
bool fvg_top_conn    = is_conn(p1_fvg_top_src)
bool fvg_bot_conn    = is_conn(p1_fvg_bot_src)
bool hm_vol_conn     = is_conn(p1_hm_vol_src)
bool choch_lvl_conn  = is_conn(p1_choch_lvl_src)
bool avwap_conn      = is_conn(p1_avwap_src)
bool avwap_fast_conn = is_conn(p1_avwap_fast_src)
bool disp_conn       = is_conn(p1_disp_src)
bool bull_prox_conn  = is_conn(p1_bull_prox_src)
bool bear_prox_conn  = is_conn(p1_bear_prox_src)
bool swing_h_conn    = is_conn(p1_swing_h_src)
bool swing_l_conn    = is_conn(p1_swing_l_src)
// ── Новые P1 connections ──────────────────────────────────────────────────────
bool ltf1b_conn      = is_conn(p1_ltf1_bull_src)
bool ltf1s_conn      = is_conn(p1_ltf1_bear_src)
bool ltf2b_conn      = is_conn(p1_ltf2_bull_src)
bool ltf2s_conn      = is_conn(p1_ltf2_bear_src)
bool ltf3b_conn      = is_conn(p1_ltf3_bull_src)
bool ltf3s_conn      = is_conn(p1_ltf3_bear_src)
bool master_conn     = is_conn(p1_master_src)
bool conf_bull_conn  = is_conn(p1_conf_bull_src)
bool conf_bear_conn  = is_conn(p1_conf_bear_src)
bool ote_zone_conn   = is_conn(p1_ote_zone_src)
bool p2agr_b_conn    = is_conn(p1_p2agrees_b_src)
bool p2agr_s_conn    = is_conn(p1_p2agrees_s_src)

// ── P1 значения ───────────────────────────────────────────────────────────────
float p1_tf_mins      = tf_conn        ? p1_tf_src             : na
int   p1_smc_trend    = smc_conn       ? int(p1_smc_src)       : na
float p1_bos_level    = bos_conn       ? p1_bos_src            : na
int   p1_bos_trig     = bostrg_conn    ? int(p1_bos_trig_src)  : 0
int   p1_ob_signal    = ob_conn        ? int(p1_ob_src)        : na
int   p1_sd_zone      = sd_conn        ? int(p1_sd_src)        : na
int   p1_fvg_dir      = fvg_conn       ? int(p1_fvg_src)       : na
int   p1_bb_signal    = bb_conn        ? int(p1_bb_src)        : 0
int   p1_hm_signal    = hm_conn        ? int(p1_hm_src)        : 0
int   p1_sdinv_signal = sdinv_conn     ? int(p1_sdinv_src)     : 0
int   p1_sweep_signal = sweep_conn     ? int(p1_sweep_src)     : 0
int   p1_choch_signal = choch_conn     ? int(p1_choch_src)     : 0
int   p1_pd_signal    = pd_conn        ? int(p1_pd_src)        : 0
int   p1_ob_touch     = ob_touch_conn  ? int(p1_ob_touch_src)  : 0
float p1_fvg_top      = fvg_top_conn   ? p1_fvg_top_src        : na
float p1_fvg_bot      = fvg_bot_conn   ? p1_fvg_bot_src        : na
float p1_hm_vol       = hm_vol_conn    ? p1_hm_vol_src         : 0.0
float p1_choch_lvl    = choch_lvl_conn ? p1_choch_lvl_src      : na
float p1_avwap        = avwap_conn     ? p1_avwap_src          : na
float p1_avwap_fast   = avwap_fast_conn? p1_avwap_fast_src     : na
int   p1_disp         = disp_conn      ? int(p1_disp_src)      : 0
float p1_bull_prox    = bull_prox_conn ? p1_bull_prox_src      : na
float p1_bear_prox    = bear_prox_conn ? p1_bear_prox_src      : na
float p1_swing_h      = swing_h_conn   ? p1_swing_h_src        : na
float p1_swing_l      = swing_l_conn   ? p1_swing_l_src        : na
// ── Новые P1 значения ────────────────────────────────────────────────────────
int   p1_ltf1_bull    = ltf1b_conn     ? int(p1_ltf1_bull_src) : 0
int   p1_ltf1_bear    = ltf1s_conn     ? int(p1_ltf1_bear_src) : 0
int   p1_ltf2_bull    = ltf2b_conn     ? int(p1_ltf2_bull_src) : 0
int   p1_ltf2_bear    = ltf2s_conn     ? int(p1_ltf2_bear_src) : 0
int   p1_ltf3_bull    = ltf3b_conn     ? int(p1_ltf3_bull_src) : 0
int   p1_ltf3_bear    = ltf3s_conn     ? int(p1_ltf3_bear_src) : 0
int   p1_master       = master_conn    ? int(p1_master_src)    : 0
int   p1_conf_bull    = conf_bull_conn ? int(p1_conf_bull_src) : 0
int   p1_conf_bear    = conf_bear_conn ? int(p1_conf_bear_src) : 0
int   p1_ote_zone     = ote_zone_conn  ? int(p1_ote_zone_src)  : 0
bool  p1_p2agrees_b   = p2agr_b_conn   and p1_p2agrees_b_src == 1
bool  p1_p2agrees_s   = p2agr_s_conn   and p1_p2agrees_s_src == 1

// ====================================================================================================================
// MARKET REGIME
// ====================================================================================================================
float atr14   = ta.atr(14)
float atr100  = ta.atr(100)
bool  vol_ok  = (atr14 / math.max(atr100, 1e-10)) > vol_th

float chop_tr_sum = math.sum(ta.tr, chop_len)
float chop_hi     = ta.highest(high, chop_len)
float chop_lo     = ta.lowest(low,   chop_len)
float choppiness  = 100 * math.log10(chop_tr_sum / math.max(chop_hi - chop_lo, 1e-10)) / math.log10(chop_len)

[di_plus, di_minus, adx_val] = ta.dmi(adx_len, adx_len)

bool regime_trending    = adx_val > 25 and choppiness < 50
bool regime_ranging     = choppiness > 61.8 or adx_val < 20
bool regime_compression = vol_ok == false and choppiness > 61.8

// ====================================================================================================================
// ТАЙМЕРЫ СОБЫТИЙ
// ====================================================================================================================
var int bars_since_choch_bull     = 999
var int bars_since_choch_bear     = 999
var int bars_since_hm_bull        = 999
var int bars_since_hm_bear        = 999
var int bars_since_sweep_bull     = 999
var int bars_since_sweep_bear     = 999
var int bars_since_sdinv_bull     = 999
var int bars_since_sdinv_bear     = 999
var int bars_since_ob_touch_bull  = 999
var int bars_since_ob_touch_bear  = 999
var int bars_since_disp_bull      = 999
var int bars_since_disp_bear      = 999
var int bars_since_sm_act_bull_N3 = 999
var int bars_since_sm_act_bear_N3 = 999

// N4 state
var int  n4_sweep_bar_bull       = 0
var int  n4_sweep_bar_bear       = 0
var int  n4_choch_bar_bull       = 0
var int  n4_choch_bar_bear       = 0
var bool n4_had_sweep_choch_bull = false
var bool n4_had_sweep_choch_bear = false
var bool n4_full_cycle_bull      = false
var bool n4_full_cycle_bear      = false

bars_since_choch_bull    := (choch_conn and p1_choch_src ==  1) ? 0 : math.min(bars_since_choch_bull    + 1, 999)
bars_since_choch_bear    := (choch_conn and p1_choch_src == -1) ? 0 : math.min(bars_since_choch_bear    + 1, 999)
bars_since_hm_bull       := (hm_conn    and p1_hm_src    ==  1) ? 0 : math.min(bars_since_hm_bull       + 1, 999)
bars_since_hm_bear       := (hm_conn    and p1_hm_src    == -1) ? 0 : math.min(bars_since_hm_bear       + 1, 999)
bars_since_sweep_bull    := (sweep_conn and p1_sweep_src  ==  1) ? 0 : math.min(bars_since_sweep_bull    + 1, 999)
bars_since_sweep_bear    := (sweep_conn and p1_sweep_src  == -1) ? 0 : math.min(bars_since_sweep_bear    + 1, 999)
bars_since_sdinv_bull    := (sdinv_conn and p1_sdinv_src  ==  1) ? 0 : math.min(bars_since_sdinv_bull    + 1, 999)
bars_since_sdinv_bear    := (sdinv_conn and p1_sdinv_src  == -1) ? 0 : math.min(bars_since_sdinv_bear    + 1, 999)
bars_since_ob_touch_bull := (ob_touch_conn and p1_ob_touch_src ==  1) ? 0 : math.min(bars_since_ob_touch_bull + 1, 999)
bars_since_ob_touch_bear := (ob_touch_conn and p1_ob_touch_src == -1) ? 0 : math.min(bars_since_ob_touch_bear + 1, 999)
bars_since_disp_bull     := (disp_conn and p1_disp_src ==  1) ? 0 : math.min(bars_since_disp_bull  + 1, 999)
bars_since_disp_bear     := (disp_conn and p1_disp_src == -1) ? 0 : math.min(bars_since_disp_bear  + 1, 999)

// ====================================================================================================================
// ГЛОБАЛЬНЫЕ РАСЧЕТЫ
// ====================================================================================================================
[g_mac_line, g_mac_signal, g_mac_hist] = ta.macd(close, 12, 26, 9)
float g_macdL    = g_mac_line
float g_macdH    = g_mac_hist
float g_rsi      = ta.rsi(close, 14)
float g_stc      = ta.sma(ta.stoch(close, high, low, 14), 3)
float g_cci      = ta.cci(close, 10)
float g_mom      = ta.mom(close, 10)
float g_obv      = ta.obv
float g_vwm      = ta.vwma(close, 12) - ta.vwma(close, 26)
float g_cmf      = ta.sma((((close-low)-(high-close))/(high-low))*volume, 21) / ta.sma(volume, 21)
float g_mfi      = ta.mfi(close, 14)
float chg_close  = ta.change(close)
float chg_high   = ta.change(high)
float chg_low    = ta.change(low)
float g_p_obv    = ta.cum(chg_close > 0 ? volume : chg_close < 0 ? -volume : 0)
float g_p_diosc  = fixnan(100 * ta.rma(chg_high - (-chg_low), 14) / ta.rma(ta.tr, 14))
float g_cndl_atr = ta.atr(14)

// SMT межрыночные (4 security calls)
float s_h1 = request.security(smt_sym1, timeframe.period, high)
float s_l1 = request.security(smt_sym1, timeframe.period, low)
float s_h2 = request.security(smt_sym2, timeframe.period, high)
float s_l2 = request.security(smt_sym2, timeframe.period, low)

// SM Activity LTF данные (3 security_lower_tf calls)
float[] global_lt_v = request.security_lower_tf(syminfo.tickerid, sm_act_ltf, volume)
float[] global_lt_c = request.security_lower_tf(syminfo.tickerid, sm_act_ltf, close)
float[] global_lt_o = request.security_lower_tf(syminfo.tickerid, sm_act_ltf, open)

// ====================================================================================================================
// LTF ENGINE INTERNAL — Fallback когда Main не подключён
// 6 факторов: micro CHoCH, Volume Spike, Accumulation, RSI filter, Engulfing, Strong Body
// Используется только как локальный расчёт; результат читается через request.security
// ====================================================================================================================
ltf_engine_internal() =>
    float rsi7    = ta.rsi(close, 7)
    float vol_sma = ta.sma(volume, 20)
    // [1] исключает незакрытую текущую свечу данного ТФ
    float h5 = ta.highest(high, 5)[1]
    float l5 = ta.lowest (low,  5)[1]

    bool micro_bull = ta.crossover (close, h5)
    bool micro_bear = ta.crossunder(close, l5)

    bool vol_b = volume > vol_sma * 2.0 and close > open
    bool vol_s = volume > vol_sma * 2.0 and close < open

    int bull_cnt = (close    >open   ?1:0) + (close[1]>open[1]?1:0) + (close[2]>open[2]?1:0)
                 + (close[3]>open[3]?1:0) + (close[4]>open[4]?1:0)
    int bear_cnt = (close    <open   ?1:0) + (close[1]<open[1]?1:0) + (close[2]<open[2]?1:0)
                 + (close[3]<open[3]?1:0) + (close[4]<open[4]?1:0)
    bool acc_bull = bull_cnt >= 3
    bool acc_bear = bear_cnt >= 3

    bool rsi_b = rsi7 < 65
    bool rsi_s = rsi7 > 35

    bool eng_bull = close > open and close > high[1] and open < close[1]
    bool eng_bear = close < open and close < low[1]  and open > close[1]

    float body_r  = math.abs(close - open) / math.max(high - low, syminfo.mintick)
    bool strong_b = body_r > 0.6 and close > open
    bool strong_s = body_r > 0.6 and close < open

    int cb = (micro_bull?1:0)+(vol_b?1:0)+(acc_bull?1:0)+(rsi_b?1:0)+(eng_bull?1:0)+(strong_b?1:0)
    int cs = (micro_bear?1:0)+(vol_s?1:0)+(acc_bear?1:0)+(rsi_s?1:0)+(eng_bear?1:0)+(strong_s?1:0)
    [cb, cs]

// 3 request.security для LTF fallback (каждый ТФ независим, lookahead_off)
[loc_ltf1_cb, loc_ltf1_cs] = request.security(syminfo.tickerid, mtf_tv_1, ltf_engine_internal(), lookahead=barmerge.lookahead_off)
[loc_ltf2_cb, loc_ltf2_cs] = request.security(syminfo.tickerid, mtf_tv_2, ltf_engine_internal(), lookahead=barmerge.lookahead_off)
[loc_ltf3_cb, loc_ltf3_cs] = request.security(syminfo.tickerid, mtf_tv_3, ltf_engine_internal(), lookahead=barmerge.lookahead_off)

// ── Эффективные LTF счета: Main (P1) если подключён, иначе локальный fallback ──
// Приоритет Main: более богатый контекст (6 факторов + SMC/S&D весовка).
// Fallback: те же 6 факторов локально — работает без Main.
int eff_ltf1_bull = ltf1b_conn ? p1_ltf1_bull : loc_ltf1_cb
int eff_ltf1_bear = ltf1s_conn ? p1_ltf1_bear : loc_ltf1_cs
int eff_ltf2_bull = ltf2b_conn ? p1_ltf2_bull : loc_ltf2_cb
int eff_ltf2_bear = ltf2s_conn ? p1_ltf2_bear : loc_ltf2_cs
int eff_ltf3_bull = ltf3b_conn ? p1_ltf3_bull : loc_ltf3_cb
int eff_ltf3_bear = ltf3s_conn ? p1_ltf3_bear : loc_ltf3_cs

// ====================================================================================================================
// MTF CASCADE TIMER-MEMORY
// Таймеры: bars_since когда тир набрал ≥ mtf_thresh баллов.
// Каскад активен только внутри POI (вычисляется в части 2).
// Здесь объявляем var и обновляем таймеры — POI-гейт применяется в части 2.
// ====================================================================================================================
var int blt1b = 999, var int blt2b = 999, var int blt3b = 999  // bull тиры
var int blt1s = 999, var int blt2s = 999, var int blt3s = 999  // bear тиры

blt1b := eff_ltf1_bull >= mtf_thresh ? 0 : math.min(blt1b + 1, 999)
blt2b := eff_ltf2_bull >= mtf_thresh ? 0 : math.min(blt2b + 1, 999)
blt3b := eff_ltf3_bull >= mtf_thresh ? 0 : math.min(blt3b + 1, 999)
blt1s := eff_ltf1_bear >= mtf_thresh ? 0 : math.min(blt1s + 1, 999)
blt2s := eff_ltf2_bear >= mtf_thresh ? 0 : math.min(blt2s + 1, 999)
blt3s := eff_ltf3_bear >= mtf_thresh ? 0 : math.min(blt3s + 1, 999)

// Предварительный каскад (без POI-гейта — гейт добавляется в части 2)
// mtf_state = 0–3: число подтверждённых тиров в пределах окна
int mtf_state_raw_bull =
    blt1b <= mtf_window and blt2b <= mtf_window and blt3b <= mtf_window ? 3 :
    blt1b <= mtf_window and blt2b <= mtf_window                          ? 2 :
    blt1b <= mtf_window                                                  ? 1 : 0

int mtf_state_raw_bear =
    blt1s <= mtf_window and blt2s <= mtf_window and blt3s <= mtf_window ? 3 :
    blt1s <= mtf_window and blt2s <= mtf_window                          ? 2 :
    blt1s <= mtf_window                                                  ? 1 : 0

// ltf_bull_conf / ltf_bear_conf = mtf_state (используются HC паттернами и ltf_gate)
// POI-гейтированные версии вычисляются в части 2 после in_poi
// Здесь публикуем raw для использования в MA/swing секции
int ltf_bull_conf_raw = mtf_state_raw_bull
int ltf_bear_conf_raw = mtf_state_raw_bear

// ====================================================================================================================
// MA РАСЧЕТЫ
// ====================================================================================================================
f_get_ma(src, len, type) =>
    switch type
        "EMA"  => ta.ema(src, len)
        "WMA"  => ta.wma(src, len)
        "HMA"  => ta.hma(src, len)
        "ALMA" => ta.alma(src, len, alma_offset, alma_sigma)
        => ta.sma(src, len)

float ma_f = f_get_ma(close, ma_fast_len, ma_fast_type)
float ma_s = f_get_ma(close, ma_slow_len, ma_slow_type)
float ma_g = f_get_ma(close, ma_filt_len, ma_filt_type)

bool cond_cross_bull = ma_f > ma_s
bool cond_cross_bear = ma_f < ma_s
bool cond_pglob_bull = close > ma_g
bool cond_pglob_bear = close < ma_g

bool ma_trend_bull = ma_sig_logic == "Fast > Slow" ? cond_cross_bull
     : ma_sig_logic == "Price > Global MA"          ? cond_pglob_bull
     : (cond_cross_bull and cond_pglob_bull)
bool ma_trend_bear = ma_sig_logic == "Fast > Slow" ? cond_cross_bear
     : ma_sig_logic == "Price > Global MA"          ? cond_pglob_bear
     : (cond_cross_bear and cond_pglob_bear)

int  ma_trend_status = ma_trend_bull ? 1 : ma_trend_bear ? -1 : 0
bool x_ma_bull       = ta.crossover(ma_f,  ma_s)
bool x_ma_bear       = ta.crossunder(ma_f, ma_s)

plot(en_ma      ? ma_f : na, "MA Fast",   ma_fast_col, 1)
plot(en_ma      ? ma_s : na, "MA Slow",   ma_slow_col, 2)
plot(en_ma_filt ? ma_g : na, "MA Global", ma_filt_col, 2)
plotshape(en_ma and en_ma_cross and x_ma_bull, "MA Cross Bull", shape.labelup,   location.belowbar, color.new(#2196F3,30), 0, "✕", color.white, size=size.tiny)
plotshape(en_ma and en_ma_cross and x_ma_bear, "MA Cross Bear", shape.labeldown, location.abovebar, color.new(#9C27B0,30), 0, "✕", color.white, size=size.tiny)

// ── Swing + auto_trend ────────────────────────────────────────────────────────
var float swing_h  = na
var float swing_l  = na
var int   auto_trend = 1
float ph = ta.pivothigh(high, sync_len, sync_len)
float pl = ta.pivotlow(low,   sync_len, sync_len)
if not na(ph)
    swing_h := ph
if not na(pl)
    swing_l := pl
if not na(swing_h) and ta.crossover(close,  swing_h)
    auto_trend := 1
if not na(swing_l) and ta.crossunder(close, swing_l)
    auto_trend := -1

int final_trend = smc_conn ? p1_smc_trend : auto_trend
bgcolor(en_bg_trend ? (final_trend == 1 ? bg_bull_col : bg_bear_col) : na, title="Фон тренда")

// ── BOS timer ─────────────────────────────────────────────────────────────────
var int   bars_since_bos = 999
float bos_rounded = bos_conn ? math.round(p1_bos_level / syminfo.mintick) * syminfo.mintick : na
float bos_prev    = nz(bos_rounded[1], na)
bool  bos_changed = bos_conn and not na(bos_rounded) and not na(bos_prev) and bos_rounded != bos_prev
bars_since_bos := bos_changed ? 0 : math.min(bars_since_bos + 1, 999)

// ====================================================================================================================
// МОДУЛЬ 2.1: KDE RSI
// ====================================================================================================================
f_gaussian(float dist, float bw) =>
    1.0 / math.sqrt(2.0 * math.pi) * math.pow(math.e, -0.5 * math.pow(dist / bw, 2.0))
f_uniform(float dist, float bw) =>
    (math.abs(dist) > bw) ? 0.0 : 0.5
f_sigmoid(float dist, float bw) =>
    2.0 / math.pi * (1.0 / (math.pow(math.e, (dist/bw)) + math.pow(math.e, -(dist/bw))))

f_kde(array<float> arr, string kernel, float bw, int steps) =>
    arrSize   = arr.size()
    arrRange  = arr.range()
    arrMin    = arr.min()
    stepCount    = arrRange / math.max(steps, 1)
    densityRange = array.new<float>(steps * 2)
    for i = 0 to (steps * 2) - 1
        densityRange.set(i, arrMin + i * stepCount)
    xArr = array.new<float>()
    yArr = array.new<float>()
    for i = 0 to densityRange.size() - 1
        float temp = 0
        for j = 0 to arr.size() - 1
            switch kernel
                "Gaussian" => temp += f_gaussian(densityRange.get(i) - arr.get(j), 1.0 / bw)
                "Uniform"  => temp += f_uniform(densityRange.get(i)  - arr.get(j), 1.0 / bw)
                "Sigmoid"  => temp += f_sigmoid(densityRange.get(i)  - arr.get(j), 1.0 / bw)
        xArr.push(densityRange.get(i))
        yArr.push(1.0 / math.max(arrSize, 1) * temp)
    [xArr, yArr]

f_prefixSum(array<float> arr, int l, int r) =>
    arr.get(r) - (l == 0 ? 0 : arr.get(l - 1))

float kde_rsi    = na
bool  osc_kde_bull = false
bool  osc_kde_bear = false

var array<float> highPivotRSIs = array.new<float>()
var array<float> lowPivotRSIs  = array.new<float>()
var array<float> KDEHighX      = array.new<float>()
var array<float> KDEHighY      = array.new<float>()
var array<float> KDEHighYSum   = array.new<float>()
var array<float> KDELowX       = array.new<float>()
var array<float> KDELowY       = array.new<float>()
var array<float> KDELowYSum    = array.new<float>()
var bool in_kde_bull = false
var bool in_kde_bear = false

if en_mod_kde
    kde_rsi := ta.rsi(close, kde_rsi_len)
    float kde_hp = ta.pivothigh(high, kde_piv_len, kde_piv_len)
    float kde_lp = ta.pivotlow(low,  kde_piv_len, kde_piv_len)
    float lowProb  = 0.0
    float highProb = 0.0

    if not na(kde_hp)
        if highPivotRSIs.size() > 300
            highPivotRSIs.remove(0)
        highPivotRSIs.push(kde_rsi[kde_piv_len])
        [kx, ky] = f_kde(highPivotRSIs, kde_kernel, kde_bandw, kde_steps)
        KDEHighX := kx, KDEHighY := ky, KDEHighYSum.clear()
        float tH = 0.0
        for i = 0 to KDEHighY.size() - 1
            tH += KDEHighY.get(i)
            KDEHighYSum.push(tH)

    if not na(kde_lp)
        if lowPivotRSIs.size() > 300
            lowPivotRSIs.remove(0)
        lowPivotRSIs.push(kde_rsi[kde_piv_len])
        [lx, ly] = f_kde(lowPivotRSIs, kde_kernel, kde_bandw, kde_steps)
        KDELowX := lx, KDELowY := ly, KDELowYSum.clear()
        float tL = 0.0
        for i = 0 to KDELowY.size() - 1
            tL += KDELowY.get(i)
            KDELowYSum.push(tL)

    if highPivotRSIs.size() > 0 and KDEHighX.size() > 0
        int sL = array.binary_search_leftmost(KDEHighX,  kde_rsi)
        int sR = array.binary_search_rightmost(KDEHighX, kde_rsi)
        int iL = math.max(0, math.min(sL, KDEHighX.size()-1))
        int iR = math.max(0, math.min(sR, KDEHighX.size()-1))
        int ni = (math.abs(kde_rsi - KDEHighX.get(iL)) < math.abs(kde_rsi - KDEHighX.get(iR))) ? iL : iR
        highProb := f_prefixSum(KDEHighYSum, 0, ni)

    if lowPivotRSIs.size() > 0 and KDELowX.size() > 0
        int sL = array.binary_search_leftmost(KDELowX,  kde_rsi)
        int sR = array.binary_search_rightmost(KDELowX, kde_rsi)
        int iL = math.max(0, math.min(sL, KDELowX.size()-1))
        int iR = math.max(0, math.min(sR, KDELowX.size()-1))
        int ni = (math.abs(kde_rsi - KDELowX.get(iL)) < math.abs(kde_rsi - KDELowX.get(iR))) ? iL : iR
        lowProb := f_prefixSum(KDELowYSum, ni, KDELowYSum.size()-1)

    float act_thresh  = kde_thresh == "High" ? 0.4 : kde_thresh == "Medium" ? 0.25 : 0.15
    bool curr_in_bull = KDELowY.size()  > 0 and lowProb  > array.get(KDELowYSum,  KDELowYSum.size()-1)  * (1.0 - act_thresh)
    bool curr_in_bear = KDEHighY.size() > 0 and highProb > array.get(KDEHighYSum, KDEHighYSum.size()-1) * (1.0 - act_thresh)
    osc_kde_bull := not curr_in_bull and in_kde_bull
    osc_kde_bear := not curr_in_bear and in_kde_bear
    in_kde_bull  := curr_in_bull
    in_kde_bear  := curr_in_bear

// ====================================================================================================================
// МОДУЛЬ 2.2: STOCHASTIC Z-SCORE
// ====================================================================================================================
bool  osc_stoch_bull  = false
bool  osc_stoch_bear  = false
float smoothed_scaled = na

if en_mod_stoch
    float stoch_basis = ta.sma(stoch_z_src, stoch_z_len)
    float stoch_stdev = ta.stdev(stoch_z_src, stoch_z_len)
    float zscore      = stoch_stdev == 0 ? 0.0 : (stoch_z_src - stoch_basis) / stoch_stdev
    float highest_z   = ta.highest(zscore, stoch_z_len)
    float lowest_z    = ta.lowest(zscore,  stoch_z_len)
    float range_z     = highest_z - lowest_z
    float stochZ      = range_z == 0 ? 50.0 : 100.0 * (zscore - lowest_z) / range_z
    float scaledSZ    = (stochZ / 25.0) - 2.0
    smoothed_scaled  := ta.hma(scaledSZ, stoch_z_len)
    float prev        = nz(smoothed_scaled[1], 0.0)
    float ltm         = nz(ta.alma(zscore, stoch_z_len, 0.0, 0.1), 0.0)
    osc_stoch_bull   := ta.crossover(smoothed_scaled,  prev) and prev < stoch_z_os and (stoch_strict ? ltm > 0 : true)
    osc_stoch_bear   := ta.crossunder(smoothed_scaled, prev) and prev > stoch_z_ob and (stoch_strict ? ltm < 0 : true)

// ====================================================================================================================
// МОДУЛЬ 2.3: ADAPTIVE MACD DELUXE
// ====================================================================================================================
bool  osc_macd_dlx_bull = false
bool  osc_macd_dlx_bear = false
float dlx_macSeries     = na
var float mac_dlx       = 0.0

if en_mod_dlx
    float dlx_r          = ta.correlation(close, bar_index, macd_dlx_r2)
    float dlx_detWgt     = 0.5 + 0.5 * nz(math.pow(dlx_r, 2), 0.0)
    float dlx_fastK      = 2.0 / (macd_dlx_fast + 1)
    float dlx_slowK      = 2.0 / (macd_dlx_slow + 1)
    float dlx_blend      = dlx_detWgt * (1 - dlx_fastK) * (1 - dlx_slowK) + (1 - dlx_detWgt) * (1 - dlx_fastK) / (1 - dlx_slowK)
    mac_dlx             := (close - nz(close[1],close)) * (dlx_fastK - dlx_slowK)
                         + (2 - dlx_fastK - dlx_slowK) * nz(mac_dlx[1], 0.0)
                         - dlx_blend * nz(mac_dlx[2], 0.0)
    float dlx_hl_ema    = ta.ema(high - low, macd_dlx_slow)
    dlx_macSeries       := dlx_hl_ema == 0 ? 0.0 : (mac_dlx / dlx_hl_ema * 100.0)
    osc_macd_dlx_bull   := ta.crossover(dlx_macSeries,  macd_dlx_os)
    osc_macd_dlx_bear   := ta.crossunder(dlx_macSeries, macd_dlx_ob)

// ====================================================================================================================
// МОДУЛЬ 2.4: ADVANCED CCI
// ====================================================================================================================
bool osc_cci_bull  = false
bool osc_cci_bear  = false
var float st_TrendUp   = na
var float st_TrendDown = na
var int   st_Trend     = 1

if en_mod_cci
    float st_cci_val = ta.cci(close, cci_st_len)
    float st_Up      = hl2 - (cci_st_factor * ta.atr(cci_st_pd))
    float st_Dn      = hl2 + (cci_st_factor * ta.atr(cci_st_pd))
    st_TrendUp   := nz(st_cci_val[1]) > 0 ? math.max(st_Up, nz(st_TrendUp[1],   st_Up)) : st_Up
    st_TrendDown := nz(st_cci_val[1]) < 0 ? math.min(st_Dn, nz(st_TrendDown[1], st_Dn)) : st_Dn
    st_Trend     := st_cci_val > 0 ? 1 : st_cci_val < 0 ? -1 : nz(st_Trend[1], 1)
    float st_tsl     = st_Trend == 1 ? st_TrendUp : st_TrendDown
    float l3_typ     = (high + low + close) / 3.0
    float l3_dev     = ta.dev(l3_typ, cci_l3_len)
    float l3_cci_val = (l3_typ - ta.sma(l3_typ, cci_l3_len)) / (0.015 * math.max(l3_dev, 1e-10))
    float l3_ci_val  = ta.ema(l3_cci_val, cci_l3_ci)
    osc_cci_bull := ta.crossover(close,  st_tsl) or (ta.crossover(l3_cci_val,  l3_ci_val) and l3_cci_val < 0)
    osc_cci_bear := ta.crossunder(close, st_tsl) or (ta.crossunder(l3_cci_val, l3_ci_val) and l3_cci_val > 0)

// ====================================================================================================================
// МОДУЛЬ 2.5: SMART MONEY ACTIVITY + CVD
// ====================================================================================================================
bool  sm_act_bull    = false
bool  sm_act_bear    = false
var array<float> sm_vols    = array.new<float>()
var float cvd               = 0.0
var array<float> cvd_hist_arr = array.new<float>()
bool cvd_bull_div   = false
bool cvd_bear_div   = false
bool sm_absorption  = false

if en_mod_smact
    float[] lt_v   = global_lt_v
    float[] lt_c   = global_lt_c
    float[] lt_o   = global_lt_o
    int res_size   = array.size(lt_v)
    int sm_maximum = sm_act_zlen * math.max(1, res_size)
    if res_size > 0
        float bar_cvd = 0.0, float max_bull_vol = 0.0, float max_bear_vol = 0.0
        for i = 0 to res_size - 1
            float v = array.get(lt_v, i), float c = array.get(lt_c, i), float o = array.get(lt_o, i)
            if c > o
                bar_cvd += v, max_bull_vol := math.max(max_bull_vol, v)
            else if c < o
                bar_cvd -= v, max_bear_vol := math.max(max_bear_vol, v)
        array.unshift(cvd_hist_arr, bar_cvd)
        if array.size(cvd_hist_arr) > 50
            array.pop(cvd_hist_arr)
        cvd := array.sum(cvd_hist_arr)
        if max_bull_vol > (ta.sma(volume, 50) * 0.5) and max_bear_vol > (ta.sma(volume, 50) * 0.5)
            sm_absorption := true
        cvd_bull_div := close < ta.sma(close, 10) and cvd > ta.sma(cvd, 10)
        cvd_bear_div := close > ta.sma(close, 10) and cvd < ta.sma(cvd, 10)
        for i = res_size - 1 to 0
            array.unshift(sm_vols, array.get(lt_v, i))
        while array.size(sm_vols) > sm_maximum
            array.pop(sm_vols)
        float volsAvg = array.avg(sm_vols), float volsStdev = array.stdev(sm_vols)
        if volsStdev > 0
            float max_z = 0.0, int max_idx = -1
            for i = 0 to res_size - 1
                float az = (array.get(lt_v, i) - volsAvg) / volsStdev
                if az > max_z
                    max_z := az, max_idx := i
            if max_z > sm_act_th and max_idx != -1
                float ic = array.get(lt_c, max_idx), float io = array.get(lt_o, max_idx)
                bool isBull = ic > io
                float bMin = math.min(open, close), float bMax = math.max(open, close)
                bool cls2 = math.abs(ic - close) < syminfo.mintick or (ic > bMin and ic < bMax)
                bool cls1 = (ic >= bMin * 0.995 and ic <= bMax * 1.005) and not cls2
                if cls2
                    if isBull then sm_act_bull := true else sm_act_bear := true
                else if cls1 and max_z > sm_act_th * 1.3
                    if isBull then sm_act_bull := true else sm_act_bear := true

bars_since_sm_act_bull_N3 := sm_act_bull ? 0 : math.min(bars_since_sm_act_bull_N3 + 1, 999)
bars_since_sm_act_bear_N3 := sm_act_bear ? 0 : math.min(bars_since_sm_act_bear_N3 + 1, 999)

// ====================================================================================================================
// МОДУЛЬ 2.6: SMART MONEY INDEX
// ====================================================================================================================
bool  sm_idx_bull  = false
bool  sm_idx_bear  = false
float sm_net_index = na

if en_mod_smidx
    float safe_pvi = nz(ta.pvi, 1.0), float safe_nvi = nz(ta.nvi, 1.0)
    float sm_drsi  = ta.rsi(safe_pvi - ta.ema(safe_pvi, 255), sm_idx_rr)
    float sm_srsi  = ta.rsi(safe_nvi - ta.ema(safe_nvi, 255), sm_idx_rr)
    float dr_safe  = sm_drsi == 0 ? 1e-10 : sm_drsi
    float di_safe  = (100.0 - sm_drsi) == 0 ? 1e-10 : (100.0 - sm_drsi)
    float sb  = math.sum(sm_srsi / dr_safe, sm_idx_x)
    float ss  = math.sum((100.0 - sm_srsi) / di_safe, sm_idx_x)
    float pk  = ta.highest(math.max(sb, ss), sm_idx_peak)
    float pks = pk == 0 ? 1e-10 : pk
    sm_net_index := (sb / pks) - (ss / pks)
    if sm_idx_strict
        sm_idx_bull := ta.crossover(sm_net_index,   sm_idx_thr)
        sm_idx_bear := ta.crossunder(sm_net_index, -sm_idx_thr)
    else
        sm_idx_bull := sm_net_index >  sm_idx_thr and sm_net_index > nz(sm_net_index[1])
        sm_idx_bear := sm_net_index < -sm_idx_thr and sm_net_index < nz(sm_net_index[1])

// ====================================================================================================================
// МОДУЛЬ 2.7: SMART MONEY INTEREST
// ====================================================================================================================
bool sm_int_bull = false
bool sm_int_bear = false

if en_mod_smint
    float d = ta.pvi - ta.ema(ta.pvi, 255), float s = ta.nvi - ta.ema(ta.nvi, 255)
    float dr = ta.rsi(d, sm_int_rr), float sr = ta.rsi(s, sm_int_rr)
    float dr_s = dr == 0 ? 1e-10 : dr, float sr_s = sr == 0 ? 1e-10 : sr
    float sumb = math.sum(sr / dr_s, sm_int_x), float sums = math.sum(dr / sr_s, sm_int_x)
    float pkb  = ta.highest(sumb, sm_int_peak), float pks_ = ta.highest(sums, sm_int_peak)
    sm_int_bull := sumb / (pkb  == 0 ? 1e-10 : pkb)  > sm_int_thr
    sm_int_bear := sums / (pks_ == 0 ? 1e-10 : pks_) > sm_int_thr

// ====================================================================================================================
// МОДУЛЬ 2.8: MULTI-INDICATOR DIVERGENCE
// ====================================================================================================================
bool osc_mdiv_bull   = false
bool osc_mdiv_bear   = false
int  total_mdiv_bull = 0
int  total_mdiv_bear = 0

var int[]   mdiv_ph_pos = array.new<int>(10, 0)
var int[]   mdiv_pl_pos = array.new<int>(10, 0)
var float[] mdiv_ph_val = array.new<float>(10, 0.0)
var float[] mdiv_pl_val = array.new<float>(10, 0.0)

bool chk_reg = mdiv_type == "Regular" or mdiv_type == "Regular/Hidden"
bool chk_hid = mdiv_type == "Hidden"  or mdiv_type == "Regular/Hidden"

f_check_pos_div(series float src, int cond_type) =>
    int div_found = 0
    if src > src[1] or close > close[1]
        for x = 0 to 9
            int len = bar_index - array.get(mdiv_pl_pos, x) + mdiv_prd
            if array.get(mdiv_pl_pos, x) == 0 or len > mdiv_maxb
                break
            if len > 5
                bool c1 = (cond_type == 1 and src[1] > src[len] and close[1] < array.get(mdiv_pl_val, x))
                bool c2 = (cond_type == 2 and src[1] < src[len] and close[1] > array.get(mdiv_pl_val, x))
                if c1 or c2
                    float s1 = (src[1] - src[len]) / (len - 1), float v1 = src[1] - s1
                    float s2 = (close[1] - close[len]) / (len - 1), float v2 = close[1] - s2
                    bool ok = true
                    for y = 2 to len - 1
                        if src[y] < v1 or close[y] < v2
                            ok := false, break
                        v1 -= s1, v2 -= s2
                    if ok
                        div_found := 1, break
    div_found

f_check_neg_div(series float src, int cond_type) =>
    int div_found = 0
    if src < src[1] or close < close[1]
        for x = 0 to 9
            int len = bar_index - array.get(mdiv_ph_pos, x) + mdiv_prd
            if array.get(mdiv_ph_pos, x) == 0 or len > mdiv_maxb
                break
            if len > 5
                bool c1 = (cond_type == 1 and src[1] < src[len] and close[1] > array.get(mdiv_ph_val, x))
                bool c2 = (cond_type == 2 and src[1] > src[len] and close[1] < array.get(mdiv_ph_val, x))
                if c1 or c2
                    float s1 = (src[1] - src[len]) / (len - 1), float v1 = src[1] - s1
                    float s2 = (close[1] - close[len]) / (len - 1), float v2 = close[1] - s2
                    bool ok = true
                    for y = 2 to len - 1
                        if src[y] > v1 or close[y] > v2
                            ok := false, break
                        v1 -= s1, v2 -= s2
                    if ok
                        div_found := 1, break
    div_found

f_add_div(series float src, bool en) =>
    int b = 0, int br = 0
    if en
        if chk_reg
            b  += f_check_pos_div(src, 1)
            br += f_check_neg_div(src, 1)
        if chk_hid
            b  += f_check_pos_div(src, 2)
            br += f_check_neg_div(src, 2)
    [b, br]

if en_mod_mdiv
    float mdiv_ph = ta.pivothigh(close, mdiv_prd, mdiv_prd)
    float mdiv_pl = ta.pivotlow(close,  mdiv_prd, mdiv_prd)
    if not na(mdiv_ph)
        array.unshift(mdiv_ph_pos, bar_index), array.unshift(mdiv_ph_val, mdiv_ph)
        array.pop(mdiv_ph_pos), array.pop(mdiv_ph_val)
    if not na(mdiv_pl)
        array.unshift(mdiv_pl_pos, bar_index), array.unshift(mdiv_pl_val, mdiv_pl)
        array.pop(mdiv_pl_pos), array.pop(mdiv_pl_val)
    [b1,br1]  = f_add_div(g_rsi,   true), [b2, br2]  = f_add_div(g_macdL, true)
    [b3,br3]  = f_add_div(g_macdH, true), [b4, br4]  = f_add_div(g_stc,   true)
    [b5,br5]  = f_add_div(g_cci,   true), [b6, br6]  = f_add_div(g_mom,   true)
    [b7,br7]  = f_add_div(g_obv,   true), [b8, br8]  = f_add_div(g_vwm,   true)
    [b9,br9]  = f_add_div(g_cmf,   true), [b10,br10] = f_add_div(g_mfi,   true)
    total_mdiv_bull := b1+b2+b3+b4+b5+b6+b7+b8+b9+b10
    total_mdiv_bear := br1+br2+br3+br4+br5+br6+br7+br8+br9+br10
    osc_mdiv_bull   := total_mdiv_bull >= mdiv_limit
    osc_mdiv_bear   := total_mdiv_bear >= mdiv_limit

// ====================================================================================================================
// МОДУЛЬ 2.9: PETERO NON-REPAINT DIVERGENCE
// ====================================================================================================================
bool osc_peter_bull = false
bool osc_peter_bear = false

f_petero_div(series float _osc, int _lbL, int _lbR, int _rL, int _rU) =>
    bool pl = not na(ta.pivotlow(_osc,  _lbL, _lbR))
    bool ph = not na(ta.pivothigh(_osc, _lbL, _lbR))
    float opl = ta.valuewhen(pl, _osc[_lbR],  1), float cpl = ta.valuewhen(pl, low[_lbR],   1)
    float oph = ta.valuewhen(ph, _osc[_lbR],  1), float cph = ta.valuewhen(ph, high[_lbR],  1)
    int ls = ta.barssince(pl[1]), int hs = ta.barssince(ph[1])
    bool lr = ls >= _rL and ls <= _rU, bool hr = hs >= _rL and hs <= _rU
    int breg = (low[_lbR]  < cpl and _osc[_lbR] > opl and lr and pl) ? 1 : 0
    int bhid = (low[_lbR]  > cpl and _osc[_lbR] < opl and lr and pl) ? 1 : 0
    int sreg = (high[_lbR] > cph and _osc[_lbR] < oph and hr and ph) ? 1 : 0
    int shid = (high[_lbR] < cph and _osc[_lbR] > oph and hr and ph) ? 1 : 0
    [breg + bhid, sreg + shid]

if en_mod_peter
    int pt_b = 0, int pt_s = 0
    [b1,s1]  = f_petero_div(g_rsi,     peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b1,  pt_s+=s1
    [b2,s2]  = f_petero_div(g_macdL,   peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b2,  pt_s+=s2
    [b3,s3]  = f_petero_div(g_macdH,   peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b3,  pt_s+=s3
    [b4,s4]  = f_petero_div(g_mom,     peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b4,  pt_s+=s4
    [b5,s5]  = f_petero_div(g_cci,     peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b5,  pt_s+=s5
    [b6,s6]  = f_petero_div(g_p_obv,   peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b6,  pt_s+=s6
    [b7,s7]  = f_petero_div(g_stc,     peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b7,  pt_s+=s7
    [b8,s8]  = f_petero_div(g_p_diosc, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b8,  pt_s+=s8
    [b9,s9]  = f_petero_div(g_vwm,     peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b9,  pt_s+=s9
    [b10,s10]= f_petero_div(g_cmf,     peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b10, pt_s+=s10
    osc_peter_bull := pt_b >= peter_limit
    osc_peter_bear := pt_s >= peter_limit

// ====================================================================================================================
// МОДУЛЬ 3.0: TRADINGFINDER FRACTAL DIV
// ====================================================================================================================
bool osc_tfdiv_bull = false
bool osc_tfdiv_bear = false

float tf_aoH  = ta.sma(hl2, 5) - ta.sma(hl2, 34)
float tf_rsiH = ta.rsi(close, 14) - 50
float tf_hist = tfdiv_type == "MACD" ? g_macdH : tfdiv_type == "AO" ? tf_aoH : tf_rsiH
float tf_ema  = ta.ema(close, 50)
bool  tf_up_frac = not na(ta.pivothigh(tfdiv_n, tfdiv_n)) and close[tfdiv_n] > tf_ema
bool  tf_dn_frac = not na(ta.pivotlow(tfdiv_n,  tfdiv_n)) and close[tfdiv_n] < tf_ema

float t_h_lp = ta.valuewhen(tf_up_frac, high[tfdiv_n],    0), float t_h_pp = ta.valuewhen(tf_up_frac, high[tfdiv_n],    1)
float t_h_lh = ta.valuewhen(tf_up_frac, tf_hist[tfdiv_n], 0), float t_h_ph = ta.valuewhen(tf_up_frac, tf_hist[tfdiv_n], 1)
int   t_h_lb = ta.valuewhen(tf_up_frac, bar_index[tfdiv_n], 0), int t_h_pb = ta.valuewhen(tf_up_frac, bar_index[tfdiv_n], 1)
float t_l_lp = ta.valuewhen(tf_dn_frac, low[tfdiv_n],     0), float t_l_pp = ta.valuewhen(tf_dn_frac, low[tfdiv_n],     1)
float t_l_lh = ta.valuewhen(tf_dn_frac, tf_hist[tfdiv_n], 0), float t_l_ph = ta.valuewhen(tf_dn_frac, tf_hist[tfdiv_n], 1)
int   t_l_lb = ta.valuewhen(tf_dn_frac, bar_index[tfdiv_n], 0), int t_l_pb = ta.valuewhen(tf_dn_frac, bar_index[tfdiv_n], 1)

if en_mod_tfdiv
    bool bc = t_h_lh > 0 and t_h_ph > 0 and (t_h_lb+30 > bar_index) and (t_h_lb - t_h_pb < 30)
    osc_tfdiv_bear := ta.change(t_h_lp) != 0 and bc and t_h_lp > t_h_pp and t_h_lh < t_h_ph
    bool bc2 = t_l_lh < 0 and t_l_ph < 0 and (t_l_lb+30 > bar_index) and (t_l_lb - t_l_pb < 30)
    osc_tfdiv_bull := ta.change(t_l_lp) != 0 and bc2 and t_l_lp < t_l_pp and t_l_lh > t_l_ph

// ====================================================================================================================
// МОДУЛЬ 3.1: SMT DIVERGENCES
// ====================================================================================================================
bool osc_smt_bull = false
bool osc_smt_bear = false

f_get_smt_div(bool is_ph, float y2, float sym_y2) =>
    var float y1 = na, var float sy1 = na, var int cnt = 0, var int ldb = 0
    if bar_index - ldb > 50
        cnt := 0
    if y2 != y2[1] and sym_y2 != sym_y2[1]
        if not na(y1) and not na(sy1) and (y2 - y1) * (sym_y2 - sy1) < 0
            cnt += 1, ldb := bar_index
        sy1 := sym_y2, y1 := y2
    else if (is_ph and y2 > y2[1]) or (not is_ph and y2 < y2[1])
        sy1 := na, y1 := y2
    cnt

if en_mod_smt
    float smt_ph = fixnan(ta.pivothigh(smt_len, smt_len)), float smt_pl = fixnan(ta.pivotlow(smt_len, smt_len))
    float sph1 = fixnan(ta.pivothigh(s_h1, smt_len, smt_len)), float spl1 = fixnan(ta.pivotlow(s_l1, smt_len, smt_len))
    float sph2 = fixnan(ta.pivothigh(s_h2, smt_len, smt_len)), float spl2 = fixnan(ta.pivotlow(s_l2, smt_len, smt_len))
    int ph1 = f_get_smt_div(true,  smt_ph, sph1), int pl1 = f_get_smt_div(false, smt_pl, spl1)
    int ph2 = f_get_smt_div(true,  smt_ph, sph2), int pl2 = f_get_smt_div(false, smt_pl, spl2)
    if smt_ph != nz(smt_ph[1]) and ((smt_use1 and ph1 > nz(ph1[1])) or (smt_use2 and ph2 > nz(ph2[1])))
        osc_smt_bear := true
    if smt_pl != nz(smt_pl[1]) and ((smt_use1 and pl1 > nz(pl1[1])) or (smt_use2 and pl2 > nz(pl2[1])))
        osc_smt_bull := true

// ====================================================================================================================
// МОДУЛЬ 3.2: LUXALGO CANDLESTICK
// ====================================================================================================================
float c_upper = ta.highest(math.max(cndl_minor_len, 1))
float c_lower = ta.lowest(math.max(cndl_minor_len,  1))
var int minor_dir = 0
if high == c_upper and minor_dir != 1
    minor_dir := 1
if low  == c_lower and minor_dir != -1
    minor_dir := -1

var int   major_dir  = 0
float maj_ema1       = ta.ema(close, math.max(cndl_maj_ema1, 1))
float maj_ema2       = ta.ema(close, math.max(cndl_maj_ema2, 1))
[st_val, st_dir]     = ta.supertrend(math.max(cndl_maj_st_f, 0.1), math.max(cndl_maj_st_l, 1))
float maj_dc_upper   = ta.highest(math.max(cndl_maj_dc, 1))
float maj_dc_lower   = ta.lowest(math.max(cndl_maj_dc,  1))
var int maj_dc_dir   = 0
if high == maj_dc_upper and maj_dc_dir != 1
    maj_dc_dir := 1
if low  == maj_dc_lower and maj_dc_dir != -1
    maj_dc_dir := -1

var int os = 0
float choch_upper    = ta.highest(math.max(cndl_maj_swing, 2))
float choch_lower    = ta.lowest(math.max(cndl_maj_swing,  2))
os := (high[math.max(cndl_maj_swing, 2)] > choch_upper ? 0
    : low[math.max(cndl_maj_swing,   2)] < choch_lower ? 1 : nz(os[1]))
float c_top_choch = os == 0 and nz(os[1]) != 0 ? high[math.max(cndl_maj_swing, 2)] : na
float c_btm_choch = os == 1 and nz(os[1]) != 1 ? low[math.max(cndl_maj_swing,  2)] : na

var float t_val = na, var float b_val = na, var int t_count = 1, var int b_count = 1
if not na(c_top_choch)
    t_val := c_top_choch, t_count := 1
if not na(c_btm_choch)
    b_val := c_btm_choch, b_count := 1
bool bull_choch = ta.crossover(close,  t_val) and t_count == 1
bool bear_choch = ta.crossunder(close, b_val) and b_count == 1
var int choch_dir = 0
if bull_choch and choch_dir != 1
    t_count := 0, choch_dir := 1
if bear_choch and choch_dir != -1
    b_count := 0, choch_dir := -1

if cndl_maj_type == "EMA"
    major_dir := maj_ema1 > maj_ema2 ? 1 : -1
else if cndl_maj_type == "SuperTrend"
    major_dir := int(math.sign(st_dir))
else if cndl_maj_type == "Donchian Channel"
    major_dir := maj_dc_dir
else
    major_dir := choch_dir

bool  rc        = close < open, bool  gc        = close > open
float cand_top  = math.max(open, close), float cand_bot  = math.min(open, close)
float hl_width  = high - low,            float bod_width = cand_top - cand_bot
float hw_per    = hl_width == 0 ? 0 : ((high - cand_top) / hl_width) * 100
float lw_per    = hl_width == 0 ? 0 : ((cand_bot - low)  / hl_width) * 100
float b_per     = hl_width == 0 ? 0 : (bod_width / hl_width) * 100
bool  is_doji   = math.round_to_mintick(close) == math.round_to_mintick(open)
bool  is_minor_bear = minor_dir < 0, bool  is_minor_bull = minor_dir > 0

bool p_hammer   = lw_per>(b_per*2) and b_per<50 and hw_per<2 and not is_doji and is_minor_bear
bool p_ihammer  = hw_per>(b_per*2) and b_per<50 and lw_per<2 and not is_doji and is_minor_bear
bool p_rising_3 = gc[4] and b_per[4]>50 and rc[3] and cand_top[3]<=high[4] and cand_bot[3]>=low[4] and rc[2] and cand_top[2]<=high[4] and cand_bot[2]>=low[4] and rc[1] and cand_top[1]<=high[4] and cand_bot[1]>=low[4] and gc and close>high[4] and b_per>50 and is_minor_bull[4]
bool p_bull_eng = rc[1] and gc and bod_width>(bod_width[1]/2) and open<close[1] and cand_top>cand_top[1] and not p_rising_3 and not is_doji[1] and is_minor_bear
bool p_3ws      = gc[2] and b_per[2]>70 and gc[1] and b_per[1]>70 and cand_bot[1]>=cand_bot[2] and cand_bot[1]<=cand_top[2] and close[1]>high[2] and gc and b_per>70 and cand_bot>=cand_bot[1] and cand_bot<=cand_top[1] and close>high[1] and is_minor_bear[2]
bool p_mstar    = rc[2] and b_per[2]>80 and rc[1] and bod_width[1]<(bod_width[2]/2) and open[1]<close[2] and gc and close>hl2[2] and is_minor_bear[2]
bool p_bull_har = gc and high<=cand_top[1] and low>=cand_bot[1] and rc[1] and is_minor_bear[1]
bool p_tw_bot   = math.round_to_mintick(low)==math.round_to_mintick(low[1]) and gc and rc[1] and is_minor_bear[1]
bool p_sstar    = hw_per>(b_per*2) and b_per<50 and lw_per<2 and not is_doji and is_minor_bull
bool p_hman     = lw_per>(b_per*2) and b_per<50 and hw_per<2 and not is_doji and is_minor_bull
bool p_falling_3= rc[4] and b_per[4]>50 and gc[3] and cand_top[3]<=high[4] and cand_bot[3]>=low[4] and gc[2] and cand_top[2]<=high[4] and cand_bot[2]>=low[4] and gc[1] and cand_top[1]<=high[4] and cand_bot[1]>=low[4] and rc and close<low[4] and b_per>50 and is_minor_bear[4]
bool p_bear_eng = gc[1] and rc and bod_width>(bod_width[1]/2) and open>close[1] and cand_bot<cand_bot[1] and not p_falling_3 and not is_doji[1] and is_minor_bull
bool p_3bc      = rc[2] and b_per[2]>70 and rc[1] and b_per[1]>70 and cand_top[1]<=cand_top[2] and cand_top[1]>=cand_bot[2] and close[1]<low[2] and rc and b_per>70 and cand_top<=cand_top[1] and cand_top>=cand_bot[1] and close<low[1] and is_minor_bull[2]
bool p_estar    = gc[2] and b_per[2]>80 and gc[1] and bod_width[1]<(bod_width[2]/2) and open[1]>close[2] and rc and close<hl2[2] and is_minor_bull[2]
bool p_bear_har = rc and high<=cand_top[1] and low>=cand_bot[1] and gc[1] and is_minor_bull[1]
bool p_tw_top   = math.round_to_mintick(high)==math.round_to_mintick(high[1]) and rc and gc[1] and is_minor_bull[1]

bool is_major_bull = not en_cndl_trend or major_dir > 0
bool is_major_bear = not en_cndl_trend or major_dir < 0

bool   cndl_bull = false, bool   cndl_bear = false, bool   is_neutral = false, string cndl_name = ""
if en_mod_cndl
    if      en_hammer   and p_hammer    and is_major_bull  then cndl_bull := true, cndl_name := "Молот"
    else if en_ihammer  and p_ihammer   and is_major_bull  then cndl_bull := true, cndl_name := "Пер. Молот"
    else if en_bull_eng and p_bull_eng  and is_major_bull  then cndl_bull := true, cndl_name := "Быч. Поглощение"
    else if en_r3       and p_rising_3  and is_major_bull  then cndl_bull := true, cndl_name := "Метод 3 Подн."
    else if en_3ws      and p_3ws       and is_major_bull  then cndl_bull := true, cndl_name := "3 Белых Солдата"
    else if en_mstar    and p_mstar     and is_major_bull  then cndl_bull := true, cndl_name := "Утренняя Звезда"
    else if en_bull_har and p_bull_har  and is_major_bull  then cndl_bull := true, cndl_name := "Бычье Харами"
    else if en_tw_bot   and p_tw_bot    and is_major_bull  then cndl_bull := true, cndl_name := "Пинцет Дно"
    if      en_sstar    and p_sstar     and is_major_bear  then cndl_bear := true, cndl_name := "Падающая Звезда"
    else if en_hman     and p_hman      and is_major_bear  then cndl_bear := true, cndl_name := "Повешенный"
    else if en_bear_eng and p_bear_eng  and is_major_bear  then cndl_bear := true, cndl_name := "Медв. Поглощение"
    else if en_f3       and p_falling_3 and is_major_bear  then cndl_bear := true, cndl_name := "Метод 3 Пад."
    else if en_3bc      and p_3bc       and is_major_bear  then cndl_bear := true, cndl_name := "3 Черные Вороны"
    else if en_estar    and p_estar     and is_major_bear  then cndl_bear := true, cndl_name := "Вечерняя Звезда"
    else if en_bear_har and p_bear_har  and is_major_bear  then cndl_bear := true, cndl_name := "Медв. Харами"
    else if en_tw_top   and p_tw_top    and is_major_bear  then cndl_bear := true, cndl_name := "Пинцет Вершина"
    if en_doji and is_doji and not cndl_bull and not cndl_bear
        is_neutral := true, cndl_name := "Doji (Нейтраль)"

plotshape(en_mod_cndl and cndl_show_lbl and cndl_bull,   "Бычий паттерн",    shape.triangleup,   location.belowbar, cndl_bull_col, text="", size=size.tiny)
plotshape(en_mod_cndl and cndl_show_lbl and cndl_bear,   "Медвежий паттерн", shape.triangledown, location.abovebar, cndl_bear_col, text="", size=size.tiny)
plotshape(en_mod_cndl and cndl_show_lbl and is_neutral,  "Нейтральный",      shape.xcross,       location.abovebar, cndl_neut_col, text="", size=size.tiny)
if en_mod_cndl and cndl_show_lbl and cndl_bull
    label.new(bar_index, low  - g_cndl_atr*0.2, text=cndl_name, style=label.style_label_up,   color=color.new(color.white,100), textcolor=cndl_bull_col, size=get_size(cndl_lbl_size))
if en_mod_cndl and cndl_show_lbl and cndl_bear
    label.new(bar_index, high + g_cndl_atr*0.2, text=cndl_name, style=label.style_label_down, color=color.new(color.white,100), textcolor=cndl_bear_col, size=get_size(cndl_lbl_size))
if en_mod_cndl and cndl_show_lbl and is_neutral
    label.new(bar_index, high + g_cndl_atr*0.2, text=cndl_name, style=label.style_label_down, color=color.new(color.white,100), textcolor=cndl_neut_col, size=get_size(cndl_lbl_size))
barcolor(en_mod_cndl and cndl_bar_col ? (cndl_bull ? cndl_bull_col : cndl_bear ? cndl_bear_col : is_neutral ? cndl_neut_col : na) : na)

// ====================================================================================================================
// P1 СТРУКТУРА — БАЗОВЫЕ БУЛЕВЫ
// ====================================================================================================================
bool b_smc_bull      = smc_conn     ? p1_smc_trend ==  1 : false
bool b_smc_bear      = smc_conn     ? p1_smc_trend == -1 : false
bool b_ob_bull       = ob_conn      ? p1_ob_signal ==  1 : false
bool b_ob_bear       = ob_conn      ? p1_ob_signal == -1 : false
bool b_sd_bull       = sd_conn      ? p1_sd_zone   ==  1 : false
bool b_sd_bear       = sd_conn      ? p1_sd_zone   == -1 : false
bool b_fvg_bull      = fvg_conn     ? p1_fvg_dir   ==  1 : false
bool b_fvg_bear      = fvg_conn     ? p1_fvg_dir   == -1 : false
bool b_bos_bull      = bos_conn     ? (bars_since_bos <= bos_bars_ok and p1_smc_trend ==  1) : false
bool b_bos_bear      = bos_conn     ? (bars_since_bos <= bos_bars_ok and p1_smc_trend == -1) : false
bool b_bb_bull       = p1_bb_signal    ==  1
bool b_bb_bear       = p1_bb_signal    == -1
bool b_hm_bull       = p1_hm_signal    ==  1
bool b_hm_bear       = p1_hm_signal    == -1
bool b_sdinv_bull    = bars_since_sdinv_bull <= 3
bool b_sdinv_bear    = bars_since_sdinv_bear <= 3
bool b_sweep_bull    = p1_sweep_signal ==  1
bool b_sweep_bear    = p1_sweep_signal == -1
bool b_choch_bull    = p1_choch_signal ==  1
bool b_choch_bear    = p1_choch_signal == -1
bool b_bostrg_bull   = p1_bos_trig     ==  1
bool b_bostrg_bear   = p1_bos_trig     == -1
bool b_ob_fresh_bull = bars_since_ob_touch_bull <= 2
bool b_ob_fresh_bear = bars_since_ob_touch_bear <= 2
bool b_disp_bull     = bars_since_disp_bull <= 2
bool b_disp_bear     = bars_since_disp_bear <= 2
bool b_hm_vol_bull   = hm_vol_conn and p1_hm_vol > ta.sma(volume, 50) * 1.5
bool b_hm_vol_bear   = hm_vol_conn and p1_hm_vol > ta.sma(volume, 50) * 1.5
bool b_fvg_precise_bull = fvg_top_conn and fvg_bot_conn and close <= p1_fvg_top and close >= p1_fvg_bot and p1_fvg_dir ==  1
bool b_fvg_precise_bear = fvg_top_conn and fvg_bot_conn and close <= p1_fvg_top and close >= p1_fvg_bot and p1_fvg_dir == -1

// ── Master Signal от Main (если подключён) ────────────────────────────────────
bool b_master_bull  = master_conn and p1_master ==  1
bool b_master_bear  = master_conn and p1_master == -1
bool b_conf_bull_ok = conf_bull_conn and p1_conf_bull >= 8   // Main считает ≥8/16 → сильный
bool b_conf_bear_ok = conf_bear_conn and p1_conf_bear >= 8

// ====================================================================================================================
// OTE РАСЧЕТЫ
// ====================================================================================================================
var float recent_swing_h = na
var float recent_swing_l = na
if is_conn(p1_choch_src) and (p1_choch_src != 0 or p1_bos_src != 0)
    recent_swing_h := high, recent_swing_l := low
else
    recent_swing_h := math.max(nz(recent_swing_h, high), high)
    recent_swing_l := math.min(nz(recent_swing_l, low),  low)

float ote_swing_h    = swing_h_conn ? p1_swing_h : recent_swing_h
float ote_swing_l    = swing_l_conn ? p1_swing_l : recent_swing_l
float ote_range      = ote_swing_h - ote_swing_l
float ote_long_top   = ote_swing_h - (ote_range * 0.618)
float ote_long_bot   = ote_swing_h - (ote_range * 0.786)
float disc_long_top  = ote_swing_h - (ote_range * 0.5)
float ote_short_bot  = ote_swing_l + (ote_range * 0.618)
float ote_short_top  = ote_swing_l + (ote_range * 0.786)
float prem_short_bot = ote_swing_l + (ote_range * 0.5)

int ote_score_bull = (ote_range > 0 and close <= ote_long_top  and close >= ote_long_bot)  ? 2
                   : (ote_range > 0 and close < disc_long_top)                              ? 1 : 0
int ote_score_bear = (ote_range > 0 and close >= ote_short_bot and close <= ote_short_top) ? 2
                   : (ote_range > 0 and close > prem_short_bot)                             ? 1 : 0

// Если P1 OTE Zone подключён — перекрываем локальный расчёт
if ote_zone_conn
    if p1_ote_zone == 1
        ote_score_bull := math.max(ote_score_bull, 2)
    else if p1_ote_zone == -1
        ote_score_bear := math.max(ote_score_bear, 2)

bool b_pd_bull = pd_conn ? (ote_score_bull >= 1) : false
bool b_pd_bear = pd_conn ? (ote_score_bear >= 1) : false

// ====================================================================================================================
// AVWAP БУЛЕВЫ
// ====================================================================================================================
bool b_avwap_bull = avwap_fast_conn ? (close > p1_avwap_fast) : (avwap_conn and close > p1_avwap)
bool b_avwap_bear = avwap_fast_conn ? (close < p1_avwap_fast) : (avwap_conn and close < p1_avwap)
bool avwap_cross_bull = avwap_fast_conn ? ta.crossover(close,  p1_avwap_fast) : (avwap_conn and ta.crossover(close,  p1_avwap))
bool avwap_cross_bear = avwap_fast_conn ? ta.crossunder(close, p1_avwap_fast) : (avwap_conn and ta.crossunder(close, p1_avwap))

// ====================================================================================================================
// IN_POI — ГЕЙТВЕЙ ДЛЯ MTF CASCADE
// Логика запускается только если цена находится в зоне интереса
// ====================================================================================================================
bool in_poi_bull = b_ob_bull or b_sd_bull or b_fvg_precise_bull or ote_score_bull >= 1
bool in_poi_bear = b_ob_bear or b_sd_bear or b_fvg_precise_bear or ote_score_bear >= 1

// ── MTF State с POI-гейтом (финальный, используется везде ниже) ──────────────
int mtf_state_bull = in_poi_bull ? mtf_state_raw_bull : 0
int mtf_state_bear = in_poi_bear ? mtf_state_raw_bear : 0

// ltf_bull_conf / ltf_bear_conf: 0–3, используются в HC условиях
// Сохраняем совместимость с HC паттернами: >= 2 → двa тира, >= 3 → все три
int ltf_bull_conf = mtf_state_bull
int ltf_bear_conf = mtf_state_bear

// ── LTF Gate ─────────────────────────────────────────────────────────────────
// Открывается когда: gate выключен (=0), или каскад набрал нужное число тиров,
// или Main не подключён (автономный режим)
bool ltf_gate_bull = (ltf_gate_min == 0 or ltf_bull_conf >= ltf_gate_min or (en_standalone or not tf_conn))
bool ltf_gate_bear = (ltf_gate_min == 0 or ltf_bear_conf >= ltf_gate_min or (en_standalone or not tf_conn))

// ── Детали каждого LTF тира (для инфоблока) ──────────────────────────────────
// ltf_tier_desc_b/s: что именно сработало в каждом тире
// Формируем строки с аргументами каждого тира на основе eff_ltf* счётов
string ltf1_detail_b = "LTF1(" + mtf_tv_1 + "м): " + str.tostring(eff_ltf1_bull) + "/6"
    + (eff_ltf1_bull >= mtf_thresh ? " ✅" : " ⏳")
string ltf2_detail_b = "LTF2(" + mtf_tv_2 + "м): " + str.tostring(eff_ltf2_bull) + "/6"
    + (eff_ltf2_bull >= mtf_thresh ? " ✅" : (blt1b <= mtf_window ? " ⏳" : " —"))
string ltf3_detail_b = "LTF3(" + mtf_tv_3 + "м): " + str.tostring(eff_ltf3_bull) + "/6"
    + (eff_ltf3_bull >= mtf_thresh ? " ✅" : (blt2b <= mtf_window ? " ⏳" : " —"))

string ltf1_detail_s = "LTF1(" + mtf_tv_1 + "м): " + str.tostring(eff_ltf1_bear) + "/6"
    + (eff_ltf1_bear >= mtf_thresh ? " ✅" : " ⏳")
string ltf2_detail_s = "LTF2(" + mtf_tv_2 + "м): " + str.tostring(eff_ltf2_bear) + "/6"
    + (eff_ltf2_bear >= mtf_thresh ? " ✅" : (blt1s <= mtf_window ? " ⏳" : " —"))
string ltf3_detail_s = "LTF3(" + mtf_tv_3 + "м): " + str.tostring(eff_ltf3_bear) + "/6"
    + (eff_ltf3_bear >= mtf_thresh ? " ✅" : (blt2s <= mtf_window ? " ⏳" : " —"))

string ltf_cascade_verdict_b = mtf_state_bull == 3 ? "🟢 Все тиры подтверждены"
    : mtf_state_bull == 2 ? "🟡 2/3 тира — ждём " + mtf_tv_3 + "м"
    : mtf_state_bull == 1 ? "⚪ 1/3 тира — ждём " + mtf_tv_2 + "м"
    : in_poi_bull ? "❌ LTF не подтвердил" : "— Вне POI"
string ltf_cascade_verdict_s = mtf_state_bear == 3 ? "🟢 Все тиры подтверждены"
    : mtf_state_bear == 2 ? "🟡 2/3 тира — ждём " + mtf_tv_3 + "м"
    : mtf_state_bear == 1 ? "⚪ 1/3 тира — ждём " + mtf_tv_2 + "м"
    : in_poi_bear ? "❌ LTF не подтвердил" : "— Вне POI"

// ====================================================================================================================
// ПРЕДУПРЕЖДЕНИЯ И БЛОКИРОВЩИК E3
// ====================================================================================================================
bool warn_F1_shift_bull      = en_hc_f1 and regime_ranging[1] and regime_trending and b_bos_bull and sm_act_bull
bool warn_F1_shift_bear      = en_hc_f1 and regime_ranging[1] and regime_trending and b_bos_bear and sm_act_bear
bool warn_E2_bull_exhaustion = en_hc_e2 and b_smc_bull and sm_int_bear and b_hm_bear and b_bb_bear
bool warn_E2_bear_exhaustion = en_hc_e2 and b_smc_bear and sm_int_bull and b_hm_bull and b_bb_bull
bool block_E3_bull = en_hc_e3 and b_choch_bull and not sm_act_bull and not b_hm_bull
    and not (osc_mdiv_bull or osc_peter_bull or osc_tfdiv_bull) and not b_sd_bull
bool block_E3_bear = en_hc_e3 and b_choch_bear and not sm_act_bear and not b_hm_bear
    and not (osc_mdiv_bear or osc_peter_bear or osc_tfdiv_bear) and not b_sd_bear

// ====================================================================================================================
// N4 STATE: ПОЛНЫЙ SMC-ЦИКЛ
// ====================================================================================================================
if bars_since_sweep_bull == 0
    n4_sweep_bar_bull := bar_index, n4_had_sweep_choch_bull := false, n4_choch_bar_bull := 0
if bars_since_choch_bull == 0 and n4_sweep_bar_bull > 0 and (bar_index - n4_sweep_bar_bull) <= 15
    n4_choch_bar_bull := bar_index, n4_had_sweep_choch_bull := true
n4_full_cycle_bull := n4_had_sweep_choch_bull and b_bostrg_bull and n4_choch_bar_bull > 0 and (bar_index - n4_choch_bar_bull) <= 10

if bars_since_sweep_bear == 0
    n4_sweep_bar_bear := bar_index, n4_had_sweep_choch_bear := false, n4_choch_bar_bear := 0
if bars_since_choch_bear == 0 and n4_sweep_bar_bear > 0 and (bar_index - n4_sweep_bar_bear) <= 15
    n4_choch_bar_bear := bar_index, n4_had_sweep_choch_bear := true
n4_full_cycle_bear := n4_had_sweep_choch_bear and b_bostrg_bear and n4_choch_bar_bear > 0 and (bar_index - n4_choch_bar_bear) <= 10

// ====================================================================================================================
// UDT ДЛЯ HC — расширен полями keys_b / keys_s
// keys_b / keys_s: "|"-разделённые имена условий патерна для инфоблока.
// f_build_info использует их, чтобы отделить HC-аргументы от бонусов.
// ====================================================================================================================
type hc_result
    bool   bull   = false
    bool   bear   = false
    string name_b = ""
    string name_s = ""
    string keys_b = ""   // "|"-separated required conditions that fired (bull)
    string keys_s = ""   // "|"-separated required conditions that fired (bear)

// ── Вспомогательная функция: добавить условие к ключам ───────────────────────
// (встроенная, вызывается внутри HC-функций)
f_k(string existing, bool cond, string name) =>
    cond ? existing + name + "|" : existing

// ====================================================================================================================
// HC ФУНКЦИИ — ГРУППА: РАЗВОРОТЫ
// ====================================================================================================================

f_pat_A1() =>
    r = hc_result.new()
    r.bull := en_hc_a1 and b_smc_bull and bars_since_choch_bull <= 2 and b_fvg_precise_bull
        and bars_since_hm_bull <= 3 and (b_sd_bull or b_ob_bull) and sm_act_bull and ltf_gate_bull
    r.bear := en_hc_a1 and b_smc_bear and bars_since_choch_bear <= 2 and b_fvg_precise_bear
        and bars_since_hm_bear <= 3 and (b_sd_bear or b_ob_bear) and sm_act_bear and ltf_gate_bear
    r.name_b := r.bull ? "A1: Каскадный разворот" : ""
    r.name_s := r.bear ? "A1: Каскадный разворот" : ""
    if r.bull
        r.keys_b := f_k("", b_smc_bull, "SMC бычий")
        r.keys_b := f_k(r.keys_b, bars_since_choch_bull<=2, "CHoCH ≤2 бар")
        r.keys_b := f_k(r.keys_b, b_fvg_precise_bull, "FVG точный")
        r.keys_b := f_k(r.keys_b, bars_since_hm_bull<=3, "HM Sweep ≤3 бар")
        r.keys_b := f_k(r.keys_b, b_sd_bull, "S&D Demand"), r.keys_b := f_k(r.keys_b, b_ob_bull, "OB State")
        r.keys_b := f_k(r.keys_b, sm_act_bull, "SM Activity")
        r.keys_b += "LTF " + str.tostring(ltf_bull_conf) + "/3|"
    if r.bear
        r.keys_s := f_k("", b_smc_bear, "SMC медвежий")
        r.keys_s := f_k(r.keys_s, bars_since_choch_bear<=2, "CHoCH ≤2 бар")
        r.keys_s := f_k(r.keys_s, b_fvg_precise_bear, "FVG точный")
        r.keys_s := f_k(r.keys_s, bars_since_hm_bear<=3, "HM Sweep ≤3 бар")
        r.keys_s := f_k(r.keys_s, b_sd_bear, "S&D Supply"), r.keys_s := f_k(r.keys_s, b_ob_bear, "OB State")
        r.keys_s := f_k(r.keys_s, sm_act_bear, "SM Activity")
        r.keys_s += "LTF " + str.tostring(ltf_bear_conf) + "/3|"
    r

f_pat_A3() =>
    r = hc_result.new()
    r.bull := en_hc_a3 and ote_score_bull == 2 and b_fvg_precise_bull and b_sd_bull
        and osc_smt_bull and (sm_int_bull or sm_idx_bull) and b_avwap_bull
        and (osc_kde_bull or osc_stoch_bull or osc_macd_dlx_bull) and ltf_gate_bull
    r.bear := en_hc_a3 and ote_score_bear == 2 and b_fvg_precise_bear and b_sd_bear
        and osc_smt_bear and (sm_int_bear or sm_idx_bear) and b_avwap_bear
        and (osc_kde_bear or osc_stoch_bear or osc_macd_dlx_bear) and ltf_gate_bear
    r.name_b := r.bull ? "A3: PD-арбитраж" : ""
    r.name_s := r.bear ? "A3: PD-арбитраж" : ""
    if r.bull
        r.keys_b := "OTE 0.618-0.786|FVG точный|S&D Demand|SMT Div|AVWAP выравн.|"
        r.keys_b := f_k(r.keys_b, sm_int_bull, "SM Interest"), r.keys_b := f_k(r.keys_b, sm_idx_bull, "SM Index")
        r.keys_b := f_k(r.keys_b, osc_kde_bull, "KDE RSI"), r.keys_b := f_k(r.keys_b, osc_stoch_bull, "Stoch Z")
        r.keys_b := f_k(r.keys_b, osc_macd_dlx_bull, "MACD Deluxe")
    if r.bear
        r.keys_s := "OTE 0.618-0.786|FVG точный|S&D Supply|SMT Div|AVWAP выравн.|"
        r.keys_s := f_k(r.keys_s, sm_int_bear, "SM Interest"), r.keys_s := f_k(r.keys_s, sm_idx_bear, "SM Index")
        r.keys_s := f_k(r.keys_s, osc_kde_bear, "KDE RSI"), r.keys_s := f_k(r.keys_s, osc_stoch_bear, "Stoch Z")
        r.keys_s := f_k(r.keys_s, osc_macd_dlx_bear, "MACD Deluxe")
    r

f_pat_C1() =>
    r = hc_result.new()
    bool vol_b = sm_int_bull and (sm_idx_bull or sm_act_bull)
    bool vol_s = sm_int_bear and (sm_idx_bear or sm_act_bear)
    bool zn_b  = b_ob_bull or b_fvg_precise_bull or b_sd_bull or ote_score_bull == 2
    bool zn_s  = b_ob_bear or b_fvg_precise_bear or b_sd_bear or ote_score_bear == 2
    r.bull := en_hc_c1 and osc_kde_bull and (osc_macd_dlx_bull or osc_stoch_bull or osc_cci_bull)
        and vol_b and (osc_smt_bull or osc_tfdiv_bull) and zn_b and b_avwap_bull and ltf_gate_bull
    r.bear := en_hc_c1 and osc_kde_bear and (osc_macd_dlx_bear or osc_stoch_bear or osc_cci_bear)
        and vol_s and (osc_smt_bear or osc_tfdiv_bear) and zn_s and b_avwap_bear and ltf_gate_bear
    r.name_b := r.bull ? "C1: Тройная дивергенция" : ""
    r.name_s := r.bear ? "C1: Тройная дивергенция" : ""
    if r.bull
        r.keys_b := "KDE RSI|AVWAP выравн.|SM Interest|"
        r.keys_b := f_k(r.keys_b, sm_idx_bull, "SM Index"), r.keys_b := f_k(r.keys_b, sm_act_bull, "SM Activity")
        r.keys_b := f_k(r.keys_b, osc_smt_bull, "SMT Div"), r.keys_b := f_k(r.keys_b, osc_tfdiv_bull, "Fractal Div")
        r.keys_b := f_k(r.keys_b, osc_macd_dlx_bull, "MACD Deluxe"), r.keys_b := f_k(r.keys_b, osc_stoch_bull, "Stoch Z")
        r.keys_b := f_k(r.keys_b, osc_cci_bull, "Adv CCI")
        r.keys_b := f_k(r.keys_b, b_ob_bull, "OB State"), r.keys_b := f_k(r.keys_b, b_sd_bull, "S&D Demand")
        r.keys_b := f_k(r.keys_b, b_fvg_precise_bull, "FVG точный")
    if r.bear
        r.keys_s := "KDE RSI|AVWAP выравн.|SM Interest|"
        r.keys_s := f_k(r.keys_s, sm_idx_bear, "SM Index"), r.keys_s := f_k(r.keys_s, sm_act_bear, "SM Activity")
