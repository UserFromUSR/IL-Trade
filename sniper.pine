grp_mtf       = "8. MTF Каскад (Живой Светофор)"
mtf_tv_1      = input.timeframe("1", "LTF1 — Быстрый  (1м→15м | 5м→1ч)",    group=grp_mtf)
mtf_tv_2      = input.timeframe("3", "LTF2 — Средний  (3м→15м | 15м→1ч)",   group=grp_mtf)
mtf_tv_3      = input.timeframe("5", "LTF3 — Финальный(5м→15м | 30м→1ч)",   group=grp_mtf)
mtf_thresh    = input.int(3, "Мин. баллов тира (из 6)", minval=1, maxval=6,   group=grp_mtf,
    tooltip="Сколько из 6 факторов тира должны сработать для его подтверждения")
mtf_window    = input.int(5, "Окно каскада (баров HTF)", minval=1, maxval=20, group=grp_mtf,
    tooltip="На 15м: 5 баров = 75 минут. LTF1 должен сработать не позже чем окно баров назад")
en_live_lbl   = input.bool(true, "Показывать живой светофор",                group=grp_mtf)
