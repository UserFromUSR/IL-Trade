fvg_autoTf     = input.bool(true,   "Auto",          inline="1",          group=grp_2, tooltip="Что это: автоматический выбор младшего таймфрейма для подсчёта объёма внутри FVG на основе текущего ТФ графика. При включении игнорирует ручной ТФ ниже.")
