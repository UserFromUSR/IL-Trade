grp_e2 = "Engine LTF2 (3m) — RSI"
e2_use_rsi      = input.bool(true,  "Включить", inline="e2rsi", group=grp_e2, tooltip="Что это: RSI-фильтр по направлению (бык: RSI ниже порога, медведь: RSI выше порога). Выключение убирает этот фактор из скоринга LTF2.")
e2_rsi_len      = input.int(7,      "Length", minval=2, inline="e2rsi", group=grp_e2, tooltip="Период RSI. Увеличение — более плавный и медленный RSI, уменьшение — более резкий и быстрый.")
e2_rsi_bull_th  = input.int(57,     "Бык <",  minval=1, maxval=99, inline="e2rsi", group=grp_e2, tooltip="Порог RSI для бычьего фактора. Увеличение порога — срабатывает чаще, уменьшение — реже.")
e2_rsi_bear_th  = input.int(43,     "Медв >", minval=1, maxval=99, inline="e2rsi", group=grp_e2, tooltip="Порог RSI для медвежьего фактора. Уменьшение порога — срабатывает чаще, увеличение — реже.")

grp_e2b = "Engine LTF2 (3m) — Свечи"
e2_use_candles  = input.bool(true,  "Накопление", inline="e2c1", group=grp_e2b, tooltip="Что это: считает направленные свечи (бык/медведь) из последних 5. Выключение убирает этот фактор из скоринга.")
e2_candle_cnt   = input.int(2,      "Мин. из 5",  minval=1, maxval=5, inline="e2c1", group=grp_e2b, tooltip="Минимальное число однонаправленных свечей из последних 5. Увеличение — строже, уменьшение — мягче.")
e2_use_engulf   = input.bool(false, "Engulfing",  inline="e2c1", group=grp_e2b, tooltip="Что это: поглощение предыдущей свечи текущей. Выключено по умолчанию на всех TF движках.")
e2_use_strong   = input.bool(true,  "Strong Body", inline="e2c2", group=grp_e2b, tooltip="Что это: тело свечи превышает порог от диапазона high-low. Выключение убирает этот фактор из скоринга.")
e2_strong_ratio = input.float(0.62, "Порог",       step=0.05, inline="e2c2", group=grp_e2b, tooltip="Минимальная доля тела свечи от диапазона high-low. Увеличение — строже, уменьшение — мягче.")

grp_e2c = "Engine LTF2 (3m) — Объём"
e2_use_vol      = input.bool(true,  "Включить", inline="e2v", group=grp_e2c, tooltip="Что это: объём выше SMA×мульт на направленной свече. Выключение убирает этот фактор из скоринга.")
e2_vol_sma_len  = input.int(20,     "SMA Len",  minval=5, inline="e2v", group=grp_e2c, tooltip="Период SMA объёма. Увеличение — стабильнее, уменьшение — чувствительнее.")
e2_vol_mult_raw = input.float(1.8,  "Объём>SMA×", step=0.1, inline="e2v", group=grp_e2c, tooltip="Множитель SMA объёма для засчитывания всплеска. Увеличение — строже, уменьшение — мягче.")
e2_vol_must_raw = input.bool(true, "Обязателен", inline="e2v", group=grp_e2c, tooltip="Если включено — без подтверждения объёмом сигнал по этому TF не засчитывается.")

grp_e2d = "Engine LTF2 (3m) — OB прокси"
e2_use_ob       = input.bool(true,  "Включить",  inline="e2ob", group=grp_e2d, tooltip="Что это: дислокация цены (ATR×) с объёмным подтверждением — прокси Order Block. Выключение убирает этот фактор из скоринга.")
e2_ob_atr_len   = input.int(12,     "ATR Len",   minval=5, inline="e2ob", group=grp_e2d, tooltip="Период ATR для оценки дислокации цены. Увеличение — сглаженнее, уменьшение — чувствительнее.")
e2_ob_atr_mult_raw = input.float(0.9, "Дислок. ATR×", step=0.1, inline="e2ob", group=grp_e2d, tooltip="Минимальная дислокация цены в ATR для OB-прокси. Увеличение — строже, уменьшение — мягче.")
e2_ob_vol_mult_raw = input.float(1.4, "Объём>SMA×",   step=0.1, inline="e2ob", group=grp_e2d, tooltip="Минимальный множитель объёма для OB-прокси. Увеличение — строже, уменьшение — мягче.")

grp_e2e = "Engine LTF2 (3m) — FVG прокси"
e2_use_fvg      = input.bool(true,  "Включить",   inline="e2fvg", group=grp_e2e, tooltip="Что это: гэп между барами относительно stdev — прокси Fair Value Gap. Выключение убирает этот фактор из скоринга.")
e2_fvg_thr_raw  = input.float(0.12, "Gap порог",  step=0.05, inline="e2fvg", group=grp_e2e, tooltip="Минимальный нормализованный размер гэпа. Увеличение — строже, уменьшение — мягче.")
e2_fvg_with_htf = input.bool(false, "Только по HTF тренду", inline="e2fvg", group=grp_e2e, tooltip="Что это: засчитывать FVG-прокси только при совпадении с HTF EMA-трендом. По умолчанию выключено на всех TF.")

grp_e2f = "Engine LTF2 (3m) — HeatMap прокси"
e2_use_hm       = input.bool(true,  "Включить", inline="e2hm", group=grp_e2f, tooltip="Что это: экстремум диапазона lookback с объёмным подтверждением. Выключение убирает этот фактор из скоринга.")
e2_hm_lookback  = input.int(40,     "Lookback",  minval=10, inline="e2hm", group=grp_e2f, tooltip="Период поиска экстремума диапазона. Увеличение — реже, уменьшение — чаще.")
e2_hm_vol_mult_raw = input.float(1.5, "Объём>SMA×", step=0.1, inline="e2hm", group=grp_e2f, tooltip="Минимальный множитель объёма для HeatMap-прокси. Увеличение — строже, уменьшение — мягче.")

grp_e2g = "Engine LTF2 (3m) — S&D прокси"
e2_use_sd       = input.bool(true,  "Включить",  inline="e2sd", group=grp_e2g, tooltip="Что это: дислокация тела + узкая база — прокси Supply&Demand. Выключение убирает этот фактор из скоринга.")
e2_sd_body_mult_raw = input.float(1.4, "Тело>ATR×", step=0.1, inline="e2sd", group=grp_e2g, tooltip="Минимальный размер тела свечи в ATR. Увеличение — строже, уменьшение — мягче.")
e2_sd_base_mult_raw = input.float(0.55, "База<ATR×", step=0.1, inline="e2sd", group=grp_e2g, tooltip="Максимальный размер базы в ATR. Уменьшение — строже, увеличение — мягче.")

grp_e2h = "Engine LTF2 (3m) — SMC прокси"
e2_use_smc      = input.bool(true,  "Включить",  inline="e2smc", group=grp_e2h, tooltip="Что это: HH/HL или LH/LL по трём наборам пивотов — прокси структуры. Выключение убирает этот фактор из скоринга.")
e2_smc_swing    = input.int(4,      "Swing Len", minval=2, inline="e2smc", group=grp_e2h, tooltip="Период поиска пивотов структуры. Увеличение — крупнее и реже, уменьшение — чаще и мельче.")
e2_smc_hh_cnt   = input.int(2,      "Мин. из 3", minval=1, maxval=3, inline="e2smc", group=grp_e2h, tooltip="Минимальное число совпадающих наборов пивотов из 3. Увеличение — строже, уменьшение — мягче.")
e2_smc_must_raw = input.bool(false, "Обязателен", inline="e2smc", group=grp_e2h, tooltip="Если включено — без подтверждения SMC-трендом сигнал по этому TF не засчитывается.")

// ── Применение пресета (tf_level=2: LTF2) ──
e2_vol_mult     = f_pr_mult(e2_vol_mult_raw, 2)
e2_vol_must     = f_pr_must_vol(e2_vol_must_raw, 2)
e2_ob_atr_mult  = f_pr_mult(e2_ob_atr_mult_raw, 2)
e2_ob_vol_mult  = f_pr_mult(e2_ob_vol_mult_raw, 2)
e2_fvg_thr      = f_pr_mult(e2_fvg_thr_raw, 2)
e2_hm_vol_mult  = f_pr_mult(e2_hm_vol_mult_raw, 2)
e2_sd_body_mult = f_pr_mult(e2_sd_body_mult_raw, 2)
e2_sd_base_mult = f_pr_base_mult(e2_sd_base_mult_raw, 2)
e2_smc_must     = f_pr_must_smc(e2_smc_must_raw, 2)
e2_min_score    = f_pr_score(qa_min_ltf2, 2)
[e2_w_struct, e2_w_volume, e2_w_pattern] = f_pr_apply_focus(qa_w_struct_ltf2, qa_w_volume_ltf2, qa_w_pattern_ltf2)

