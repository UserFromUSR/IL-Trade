grp_lvz_det         = "7.1 LVZ — Детекция"
lvz_fib_thr         = input.float(0.12, "Порог пустоты Fibo-профиля / LVN (доля от POC-бина)", minval=0.02, maxval=0.5, step=0.01, group=grp_lvz_det, tooltip="Доля объёма бина Fibo-профиля относительно самого объёмного бина (POC), ниже которой бин считается 'пустым' — он же узел низкого объёма (LVN). Этот же порог используется и для классификации LVN в секции 7.3, отдельный инпут не заведён намеренно — LVZ и LVN технически одно и то же понятие вакуума объёма.")
lvz_cluster_thr     = input.float(0.12, "Порог 'ямы' во вторичном профиле (доля от max-бина)", minval=0.02, maxval=0.5, step=0.01, group=grp_lvz_det, tooltip="То же самое, но по независимому прямому объёмному профилю (не K-means).")
lvz_min_empty_pct   = input.float(60.0, "Мин. % пустых бинов в диапазоне FVG", minval=20.0, maxval=100.0, step=5.0, group=grp_lvz_det)
lvz_require_liq     = input.bool(true, "Требовать ликвидность HeatMap внутри зоны", group=grp_lvz_det)
