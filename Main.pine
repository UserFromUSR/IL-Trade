indicator("UserUZR Main - All-in-One (HTF/LTF,FVG,CVP,S&D,SMC,OB/BB,HeatMap,LVZ,Fibonacci)", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=2500, max_polylines_count=100)

// ====================================================================================================================
// 0. ПРЕСЕТ ЧУВСТВИТЕЛЬНОСТИ (синхронизировать вручную с тем же пресетом в Sniper)
// 3 пункта выпадающего списка: Custom + 2 профиля. Индексация профилей 0..1, строго совпадает с Sniper.
// ПРИМЕЧАНИЕ: профили "Свинг (Позиционный)" и "Волатильный рынок" исключены по требованию. Остались
// только Скальпинг и Консервативный (A+ Only). Таблицы PR_* сжаты с 4 элементов до 2.
// ====================================================================================================================
grp_0 = "0. Пресет чувствительности (синхронизировать с Sniper)"
preset_mode = input.string("Custom", "Профиль чувствительности", options=[
  "Custom", "Скальпинг", "Консервативный (A+ Only)"], group=grp_0,
  tooltip="Что это: общий профиль настроек всех 6 движков сразу (вместо ручной настройки каждого параметра).\n\n" +
          "Custom — все настройки ниже работают как обычные ручные инпуты, пресет не влияет ни на что.\n\n" +
          "Скальпинг — якорь: свечной паттерн + объём, LTF доминанта. min_score снижен максимально, мультипликаторы ослаблены, обязательные фильтры выключены. Больше сигналов на младших ТФ, меньше — на старших.\n\n" +
          "Консервативный (A+ Only) — максимальная строгость: min_score и мультипликаторы подняты сильнее всего, must-флаги включены на всех TF (объём + SMC-тренд обязательны). Очень редкие, но максимально отфильтрованные сигналы.\n\n" +
          "Профиль задаёт min_score, мультипликаторы и must-флаги для всех 6 TF движков. Синхронизируйте тот же профиль вручную в Sniper. Выбор Консервативный — сигналов меньше, но они чище; выбор Скальпинг — сигналов больше, но грязнее.")

// ── Таблица пресетов: индекс 0..1, порядок строго совпадает с порядком options ──
// 0=Скальпинг, 1=Консервативный (A+ Only)
var int[]   PR_SCORE_OFS_LTF1 = array.from(-4, 3)
var int[]   PR_SCORE_OFS_LTF2 = array.from(-4, 3)
var int[]   PR_SCORE_OFS_LTF3 = array.from(-4, 3)
var int[]   PR_SCORE_OFS_HTF1 = array.from(-4, 3)
var int[]   PR_SCORE_OFS_HTF2 = array.from(-4, 3)
var int[]   PR_SCORE_OFS_HTF3 = array.from(-4, 3)
var float[] PR_MULT_LTF       = array.from(-0.25, 0.25)
var float[] PR_MULT_HTF       = array.from(-0.25, 0.20)
var int[]   PR_MUST_LEVEL     = array.from(0, 2)  // 0=все false, 2=все forced
// ── Веса-акценты по профилю: какая группа факторов получает приоритетный вес (1=struct,2=volume,3=pattern,0=без акцента) ──
var int[]   PR_WEIGHT_FOCUS   = array.from(3, 0)

f_preset_idx() =>
    int idx = -1
    if preset_mode == "Скальпинг"
        idx := 0
    else if preset_mode == "Консервативный (A+ Only)"
        idx := 1
    idx

int preset_idx = f_preset_idx()

f_pr_score(int base, int tf_level) =>
    int result = base
    if preset_idx >= 0
        int ofs = tf_level == 1 ? PR_SCORE_OFS_LTF1.get(preset_idx) :
                  tf_level == 2 ? PR_SCORE_OFS_LTF2.get(preset_idx) :
                  tf_level == 3 ? PR_SCORE_OFS_LTF3.get(preset_idx) :
                  tf_level == 4 ? PR_SCORE_OFS_HTF1.get(preset_idx) :
                  tf_level == 5 ? PR_SCORE_OFS_HTF2.get(preset_idx) :
                                   PR_SCORE_OFS_HTF3.get(preset_idx)
        result := math.max(1, base + ofs)
    result

f_pr_mult(float base, int tf_level) =>
    float result = base
    if preset_idx >= 0
        float ofs = tf_level <= 3 ? PR_MULT_LTF.get(preset_idx) : PR_MULT_HTF.get(preset_idx)
        result := math.max(0.05, base + ofs)
    result

f_pr_base_mult(float base, int tf_level) =>
    // для "S&D база < ATR×" — логика обратная (меньше = строже)
    float result = base
    if preset_idx >= 0
        float ofs = tf_level <= 3 ? PR_MULT_LTF.get(preset_idx) : PR_MULT_HTF.get(preset_idx)
        result := math.max(0.05, base - ofs)
    result

f_pr_must_vol(bool raw, int tf_level) =>
    // ПРИМЕЧАНИЕ: ветка "lvl==1 / HTF forced" убрана — с удалением профилей Свинг/Волатильный
    // значение 1 в PR_MUST_LEVEL больше никогда не встречается (осталось только 0 и 2).
    bool result = raw
    if preset_idx >= 0
        int lvl = PR_MUST_LEVEL.get(preset_idx)
        if lvl == 0
            result := false
        else if lvl == 2
            result := true
    result

f_pr_must_smc(bool raw, int tf_level) =>
    bool result = raw
    if preset_idx >= 0
        int lvl = PR_MUST_LEVEL.get(preset_idx)
        if lvl == 0
            result := false
        else if lvl == 2
            result := true
    result

// ── Применение весового акцента профиля (PR_WEIGHT_FOCUS) к весам struct/volume/pattern движка ──
// focus: 0=без акцента(веса не трогаем), 1=struct усилен, 2=volume усилен, 3=pattern усилен
f_pr_apply_focus(int w_struct, int w_volume, int w_pattern) =>
    int rs = w_struct
    int rv = w_volume
    int rp = w_pattern
    if preset_idx >= 0
        int focus = PR_WEIGHT_FOCUS.get(preset_idx)
        if focus == 1
            rs := w_struct + 1
        else if focus == 2
            rv := w_volume + 1
        else if focus == 3
            rp := w_pattern + 1
    [rs, rv, rp]

// ====================================================================================================================
// 0.1 БЫСТРЫЙ ДОСТУП К ЧУВСТВИТЕЛЬНОСТИ, ВЕСАМ И СКОРИНГУ (компактно, по одной строке на TF)
// ====================================================================================================================
grp_quick = "0.1 Быстрый доступ — Чувствительность, Веса, Скоринг (по TF)"
qa_min_ltf123 = input.int(5, "Мин. сумма для OK — LTF1", minval=1, maxval=40, inline="qmin_ltf", group=grp_quick, tooltip="Что это: минимальная взвешенная сумма факторов (struct+volume+pattern), при которой сигнал на LTF1 засчитывается как подтверждённый.\n\nУвеличение — меньше сигналов, но они требуют более полного совпадения факторов (надёжнее). Уменьшение — больше сигналов, но слабее обоснованных.\n\nБазовые значения для Custom. При выбранном пресете (не Custom) реально используемые значения пересчитываются через таблицы в секции 0.")
qa_min_ltf2   = input.int(6, "LTF2", minval=1, maxval=40, inline="qmin_ltf", group=grp_quick, tooltip="То же самое для LTF2: минимальная сумма факторов для засчитывания сигнала. Больше — строже и реже, меньше — мягче и чаще.")
qa_min_ltf3   = input.int(7, "LTF3", minval=1, maxval=40, inline="qmin_ltf", group=grp_quick, tooltip="То же самое для LTF3. Больше — строже и реже, меньше — мягче и чаще.")
qa_min_htf1   = input.int(8, "Мин. сумма для OK — HTF1", minval=1, maxval=40, inline="qmin_htf", group=grp_quick, tooltip="Минимальная сумма факторов для HTF1. Старшие ТФ обычно держат порог чуть выше, чем младшие, т.к. реже обновляются. Больше — строже, меньше — мягче.")
qa_min_htf2   = input.int(9, "HTF2", minval=1, maxval=40, inline="qmin_htf", group=grp_quick, tooltip="Минимальная сумма факторов для HTF2. Больше — строже, меньше — мягче.")
qa_min_htf3   = input.int(11, "HTF3", minval=1, maxval=40, inline="qmin_htf", group=grp_quick, tooltip="Минимальная сумма факторов для HTF3 (самый старший ТФ). Больше — строже, меньше — мягче.")

qa_w_struct_ltf1 = input.int(2, "Вес структ. — LTF1", minval=1, maxval=4, inline="qws_ltf", group=grp_quick, tooltip="Что это: вес группы структурных факторов (SMC/OB/микроструктура) в общей сумме скоринга LTF1.\n\nУвеличение — структурные подтверждения значат больше в итоговой сумме (структура важнее объёма/паттернов). Уменьшение — структура менее влиятельна относительно других групп.")
qa_w_struct_ltf2 = input.int(2, "LTF2", minval=1, maxval=4, inline="qws_ltf", group=grp_quick, tooltip="Вес структурных факторов для LTF2. Больше — структура важнее, меньше — менее значима.")
qa_w_struct_ltf3 = input.int(2, "LTF3", minval=1, maxval=4, inline="qws_ltf", group=grp_quick, tooltip="Вес структурных факторов для LTF3. Больше — структура важнее, меньше — менее значима.")
qa_w_struct_htf1 = input.int(3, "Вес структ. — HTF1", minval=1, maxval=4, inline="qws_htf", group=grp_quick, tooltip="Вес структурных факторов для HTF1. На старших ТФ структура обычно весит больше. Больше — важнее, меньше — менее значима.")
qa_w_struct_htf2 = input.int(4, "HTF2", minval=1, maxval=4, inline="qws_htf", group=grp_quick, tooltip="Вес структурных факторов для HTF2. Больше — важнее, меньше — менее значима.")
qa_w_struct_htf3 = input.int(4, "HTF3", minval=1, maxval=4, inline="qws_htf", group=grp_quick, tooltip="Вес структурных факторов для HTF3. Больше — важнее, меньше — менее значима.")

qa_w_volume_ltf1 = input.int(3, "Вес объём. — LTF1", minval=1, maxval=4, inline="qwv_ltf", group=grp_quick, tooltip="Что это: вес группы объёмных факторов (Объём/HeatMap/FVG) в общей сумме скоринга LTF1.\n\nУвеличение — объёмные подтверждения значат больше. Уменьшение — объём менее влиятелен относительно структуры/паттернов.")
qa_w_volume_ltf2 = input.int(3, "LTF2", minval=1, maxval=4, inline="qwv_ltf", group=grp_quick, tooltip="Вес объёмных факторов для LTF2. Больше — важнее, меньше — менее значимо.")
qa_w_volume_ltf3 = input.int(3, "LTF3", minval=1, maxval=4, inline="qwv_ltf", group=grp_quick, tooltip="Вес объёмных факторов для LTF3. Больше — важнее, меньше — менее значимо.")
qa_w_volume_htf1 = input.int(2, "Вес объём. — HTF1", minval=1, maxval=4, inline="qwv_htf", group=grp_quick, tooltip="Вес объёмных факторов для HTF1. Больше — важнее, меньше — менее значимо.")
qa_w_volume_htf2 = input.int(2, "HTF2", minval=1, maxval=4, inline="qwv_htf", group=grp_quick, tooltip="Вес объёмных факторов для HTF2. Больше — важнее, меньше — менее значимо.")
qa_w_volume_htf3 = input.int(2, "HTF3", minval=1, maxval=4, inline="qwv_htf", group=grp_quick, tooltip="Вес объёмных факторов для HTF3. Больше — важнее, меньше — менее значимо.")

qa_w_pattern_ltf1 = input.int(1, "Вес паттерн. — LTF1", minval=1, maxval=4, inline="qwp_ltf", group=grp_quick, tooltip="Что это: вес группы паттерн-факторов (RSI/Свечи/Engulfing/Strong Body/S&D) в общей сумме скоринга LTF1.\n\nУвеличение — паттерны значат больше. Уменьшение — паттерны менее влиятельны относительно структуры/объёма.")
qa_w_pattern_ltf2 = input.int(1, "LTF2", minval=1, maxval=4, inline="qwp_ltf", group=grp_quick, tooltip="Вес паттерн-факторов для LTF2. Больше — важнее, меньше — менее значимо.")
qa_w_pattern_ltf3 = input.int(1, "LTF3", minval=1, maxval=4, inline="qwp_ltf", group=grp_quick, tooltip="Вес паттерн-факторов для LTF3. Больше — важнее, меньше — менее значимо.")
qa_w_pattern_htf1 = input.int(1, "Вес паттерн. — HTF1", minval=1, maxval=4, inline="qwp_htf", group=grp_quick, tooltip="Вес паттерн-факторов для HTF1. Больше — важнее, меньше — менее значимо.")
qa_w_pattern_htf2 = input.int(1, "HTF2", minval=1, maxval=4, inline="qwp_htf", group=grp_quick, tooltip="Вес паттерн-факторов для HTF2. Больше — важнее, меньше — менее значимо.")
qa_w_pattern_htf3 = input.int(1, "HTF3", minval=1, maxval=4, inline="qwp_htf", group=grp_quick, tooltip="Вес паттерн-факторов для HTF3. Больше — важнее, меньше — менее значимо.")

// ====================================================================================================================
// НАСТРОЙКИ МОДУЛЕЙ
// ====================================================================================================================

// ── 1. Fibonacci Projection (Zeiierman) ──────────────────────────────────────
grp_fib_main = "1. Fibonacci Projection (Zeiierman)"
en_fib     = input.bool(true, "Включить модуль Fibonacci", group=grp_fib_main, inline="fibmain", tooltip="Что это: общий выключатель всего модуля проекции Фибоначчи (свинги, уровни, проекция, объёмные профили). Выключение полностью останавливает расчёт и отрисовку модуля.")
en_fib_vis = input.bool(true, "Показывать визуал", group=grp_fib_main, inline="fibmain", tooltip="Что это: показывать ли графические элементы модуля (линии, боксы, метки) при включённом расчёте. Можно использовать для временного скрытия визуала без отключения расчёта (полезно, если значения модуля используются другими частями индикатора, включая модуль LVZ).")
fib_show_proj = input.bool(true, "Показывать проекцию движения", group=grp_fib_main, inline="fibmain", tooltip="Что это: отдельный выключатель ТОЛЬКО блока проекции будущего движения (линии-прогноз, % метки, боксы уровней проекции — секции 1.6–1.8). Не влияет на уровни Фибоначчи, линии свинг High/Low и объёмные профили — теми управляет «Показывать визуал» выше. Выключение — уровни и профили остаются, прогнозная часть пропадает.")

grp_fib_set = "1.1 Fibonacci — Настройки расчёта"
fib_prd = input.int(100, "Период", minval=10, group=grp_fib_set, inline="fibset", tooltip="Что это: количество баров для поиска свинг-хая и свинг-лоу. Увеличение — меньше, но крупнее свинги (реже обновление уровней, шире диапазон). Уменьшение — больше мелких свингов, чаще обновление.")
fib_lvl = input.float(0.618, "Уровень проекции", options=[0.236, 0.382, 0.5, 0.618, 0.786], group=grp_fib_set, inline="fibset", tooltip="Что это: коэффициент Фибоначчи, используемый для расчёта проекции будущей цели свинга. Увеличение значения — цель проекции дальше от текущего диапазона (агрессивнее). Уменьшение — цель ближе (консервативнее).")

grp_fib_lvlstyle = "1.2 Fibonacci — Уровни (стиль)"
fib_Color236 = input.color(#f23645, "0.236", group=grp_fib_lvlstyle, inline="fc1", tooltip="Цвет линии и метки уровня 23.6%. Влияет только на визуал, не на расчёт.")
fib_Color382 = input.color(#81c784, "0.382", group=grp_fib_lvlstyle, inline="fc1", tooltip="Цвет линии и метки уровня 38.2%. Влияет только на визуал, не на расчёт.")
fib_Color500 = input.color(#4caf50, "0.500", group=grp_fib_lvlstyle, inline="fc1", tooltip="Цвет линии и метки уровня 50.0%. Влияет только на визуал, не на расчёт.")
fib_Color618 = input.color(#089981, "0.618", group=grp_fib_lvlstyle, inline="fc2", tooltip="Цвет линии и метки уровня 61.8%. Влияет только на визуал, не на расчёт.")
fib_Color786 = input.color(#64b5f6, "0.786", group=grp_fib_lvlstyle, inline="fc2", tooltip="Цвет линии и метки уровня 78.6%. Влияет только на визуал, не на расчёт.")
fib_LineWidth = input.int(2, "Толщина линий", minval=1, maxval=5, group=grp_fib_lvlstyle, inline="fc2", tooltip="Толщина всех горизонтальных линий уровней Фибоначчи. Увеличение — толще и заметнее, уменьшение — тоньше.")
fib_showlab = input.bool(false, "Метки уровней", group=grp_fib_lvlstyle, inline="fc3", tooltip="Что это: показывать ли процентные подписи возле каждой линии уровня Фибоначчи. Влияет только на визуал.")
fib_LabelColor = input.color(color.white, "Цвет текста", group=grp_fib_lvlstyle, inline="fc3", tooltip="Цвет текста подписей уровней Фибоначчи.")
fib_LabelSizeStr = input.string("Small", "Размер", options=["Tiny","Small","Normal","Large","Huge"], group=grp_fib_lvlstyle, inline="fc3", tooltip="Размер шрифта подписей уровней. Больше — крупнее текст, меньше — мельче.")
fib_LabelOffset = 1

fib_LabelSize = fib_LabelSizeStr == "Tiny" ? size.tiny : fib_LabelSizeStr == "Small" ? size.small : fib_LabelSizeStr == "Large" ? size.large : fib_LabelSizeStr == "Huge" ? size.huge : size.normal

grp_fib_hilo = "1.3 Fibonacci — Линии свинг High/Low"
fib_loLineColor = input.color(color.new(color.green, 0), "Цвет Low", group=grp_fib_hilo, inline="fhl", tooltip="Цвет горизонтальной направляющей линии последнего свинг-лоу.")
fib_hiLineColor = input.color(color.new(color.red, 0), "Цвет High", group=grp_fib_hilo, inline="fhl", tooltip="Цвет горизонтальной направляющей линии последнего свинг-хая.")
fib_hiloLineWidth = input.int(2, "Толщина", minval=1, maxval=5, group=grp_fib_hilo, inline="fhl", tooltip="Толщина линий свинг-хая и свинг-лоу. Больше — толще, меньше — тоньше.")

grp_fib_vp = "1.4 Fibonacci — Объёмный профиль"
fib_showFibProfile = input.bool(true, "Включить профиль объёма", group=grp_fib_vp, inline="fvp1", tooltip="Что это: основной объёмный профиль, построенный между последним свинг-хаем и свинг-лоу. Выключение убирает только этот блок визуала/расчёта, остальной модуль продолжает работать. ВНИМАНИЕ: этот профиль также питает модуль LVZ (7) и узлы POC/LVN/HVN (7.3) — при выключении LVZ и узлы объёма теряют основной источник данных.")
fib_rows = input.int(10, "Строк", minval=2, maxval=100, group=grp_fib_vp, inline="fvp1", tooltip="Количество ценовых строк (бинов) в профиле объёма. Увеличение — более детальный профиль (тоньше строки), но выше нагрузка. Уменьшение — грубее, но легче.")
fib_flipOrder = input.bool(false, "Поменять Bull/Bear местами", group=grp_fib_vp, inline="fvp1", tooltip="Что это: меняет горизонтальное расположение бычьих и медвежьих объёмных баров в профиле местами. Влияет только на визуал.")
fib_bull_color = input.color(color.new(color.teal, 30), "Цвет Bull", group=grp_fib_vp, inline="fvp2", tooltip="Базовый цвет бычьего (растущего) объёма в профиле Фибоначчи.")
fib_bear_color = input.color(color.new(color.orange, 30), "Цвет Bear", group=grp_fib_vp, inline="fvp2", tooltip="Базовый цвет медвежьего (падающего) объёма в профиле Фибоначчи.")

grp_fib_delta = "1.5 Fibonacci — Дельта-профиль объёма"
fib_showFibDelta = input.bool(false, "Включить дельта-профиль", group=grp_fib_delta, inline="fd1", tooltip="Что это: отдельный профиль разницы (дельты) бычьего и медвежьего объёма между уровнями Фибоначчи. Выключение убирает только этот блок, остальной модуль продолжает работать.")
fib_deltaMaxWidth = input.int(30, "Макс. ширина", minval=5, maxval=200, group=grp_fib_delta, inline="fd1", tooltip="Максимальная горизонтальная ширина (в барах), используемая для масштабирования дельта-боксов от самого маленького до самого большого. Увеличение — боксы шире и заметнее, уменьшение — компактнее.")
fib_deltaBullColor = input.color(color.new(color.lime, 80), "Цвет Bull Δ", group=grp_fib_delta, inline="fd2", tooltip="Цвет заливки полос, где бычий объём превышает медвежий (положительная дельта).")
fib_deltaBearColor = input.color(color.new(color.red, 80), "Цвет Bear Δ", group=grp_fib_delta, inline="fd2", tooltip="Цвет заливки полос, где медвежий объём превышает бычий (отрицательная дельта).")

grp_fib_projline = "1.6 Fibonacci — Линии проекции"
fib_projLineBullColor = input.color(color.new(color.green, 0), "Цвет Bull", group=grp_fib_projline, inline="fpl1", tooltip="Цвет проекционного сегмента, когда цена прогнозируется вверх.")
fib_projLineBearColor = input.color(color.new(color.red, 0), "Цвет Bear", group=grp_fib_projline, inline="fpl1", tooltip="Цвет проекционного сегмента, когда цена прогнозируется вниз.")
fib_projLineWidth = input.int(2, "Толщина", minval=1, maxval=5, group=grp_fib_projline, inline="fpl1", tooltip="Толщина проекционных линий свинга. Больше — толще, меньше — тоньше.")
fib_projLineStyleStr = input.string("Arrow Right", "Стиль", options=["Solid", "Dashed", "Dotted", "Arrow Left", "Arrow Right"], group=grp_fib_projline, inline="fpl2", tooltip="Визуальный стиль проекционных линий (сплошная/штрих/точки/стрелка влево/стрелка вправо). Влияет только на визуал.")

fib_projLineStyle = fib_projLineStyleStr == "Solid" ? line.style_solid : fib_projLineStyleStr == "Dashed" ? line.style_dashed : fib_projLineStyleStr == "Dotted" ? line.style_dotted : fib_projLineStyleStr == "Arrow Left" ? line.style_arrow_left : line.style_arrow_right

grp_fib_projlabel = "1.7 Fibonacci — Метки проекции (%)"
fib_projPercBullColor = input.color(color.new(color.green, 0), "Фон Bull", group=grp_fib_projlabel, inline="fpp1", tooltip="Цвет фона метки процента для сегмента, направленного вверх.")
fib_projPercBearColor = input.color(color.new(color.red, 0), "Фон Bear", group=grp_fib_projlabel, inline="fpp1", tooltip="Цвет фона метки процента для сегмента, направленного вниз.")
fib_projPercTextColor = input.color(color.white, "Текст", group=grp_fib_projlabel, inline="fpp1", tooltip="Цвет текста метки процента проекции.")
fib_projPercLabelSizeStr = input.string("Small", "Размер", options=["Tiny","Small","Normal","Large","Huge"], group=grp_fib_projlabel, inline="fpp2", tooltip="Размер шрифта метки процента проекции. Больше — крупнее, меньше — мельче.")

fib_projPercLabelSize = fib_projPercLabelSizeStr == "Tiny" ? size.tiny : fib_projPercLabelSizeStr == "Small" ? size.small : fib_projPercLabelSizeStr == "Large" ? size.large : fib_projPercLabelSizeStr == "Huge" ? size.huge : size.normal

grp_fib_box = "1.8 Fibonacci — Бокс проекции"
fib_projBoxBgOn = input.bool(true, "Фон", group=grp_fib_box, inline="fbx1", tooltip="Что это: включает заливку фона боксов проекции. Влияет только на визуал.")
fib_projBoxBgColor = input.color(color.new(color.blue, 80), "", group=grp_fib_box, inline="fbx1", tooltip="Цвет заливки боксов проекции (когда фон включён).")
fib_projBoxBorderOn = input.bool(true, "Рамка", group=grp_fib_box, inline="fbx1", tooltip="Что это: включает отрисовку рамки вокруг боксов проекции. Влияет только на визуал.")
fib_projBoxBorderCol = input.color(color.new(color.white, 0), "", group=grp_fib_box, inline="fbx1", tooltip="Цвет рамки боксов проекции.")
fib_projBoxBorderW = input.int(1, "Толщ. рамки", minval=1, maxval=5, group=grp_fib_box, inline="fbx2", tooltip="Толщина рамки боксов проекции. Больше — толще, меньше — тоньше.")
fib_projBoxBorderStyleStr = input.string("Solid", "Стиль рамки", options=["Solid", "Dashed", "Dotted"], group=grp_fib_box, inline="fbx2", tooltip="Стиль линии рамки боксов проекции (сплошная/штрих/точки).")
fib_projBoxTextHAlignStr = input.string("Center", "Гориз. текста", options=["Left", "Center", "Right"], group=grp_fib_box, inline="fbx3", tooltip="Горизонтальное выравнивание текста внутри бокса проекции.")
fib_projBoxTextVAlignStr = input.string("Center", "Верт. текста", options=["Top", "Center", "Bottom"], group=grp_fib_box, inline="fbx3", tooltip="Вертикальное выравнивание текста внутри бокса проекции.")
fib_projBoxTextColor = input.color(color.white, "Цвет текста", group=grp_fib_box, inline="fbx4", tooltip="Цвет текста значения уровня внутри боксов проекции.")
fib_projBoxTextSizeStr = input.string("Normal", "Размер текста", options=["Tiny","Small","Normal","Large","Huge"], group=grp_fib_box, inline="fbx4", tooltip="Размер шрифта значения уровня внутри боксов проекции. Больше — крупнее, меньше — мельче.")

fib_projBoxTextSize = fib_projBoxTextSizeStr == "Tiny" ? size.tiny : fib_projBoxTextSizeStr == "Small" ? size.small : fib_projBoxTextSizeStr == "Large" ? size.large : fib_projBoxTextSizeStr == "Huge" ? size.huge : size.normal
fib_projBoxBorderStyle = fib_projBoxBorderStyleStr == "Solid" ? line.style_solid : fib_projBoxBorderStyleStr == "Dashed" ? line.style_dashed : line.style_dotted
fib_projBoxTextHAlign = fib_projBoxTextHAlignStr == "Left" ? "left" : fib_projBoxTextHAlignStr == "Right" ? "right" : "center"
fib_projBoxTextVAlign = fib_projBoxTextVAlignStr == "Top" ? "top" : fib_projBoxTextVAlignStr == "Bottom" ? "bottom" : "center"

// ~~ Fibonacci: расчёт свингов (по текущему графику, логика Zeiierman не изменена) ──
fib_hi = ta.highest(high, fib_prd)
fib_lo = ta.lowest(low, fib_prd)

fib_isHi = high == fib_hi
fib_isLo = low == fib_lo

fib_HB = ta.barssince(fib_isHi)
fib_LB = ta.barssince(fib_isLo)

fib_hiPrice = ta.valuewhen(fib_isHi, high, 0)
fib_loPrice = ta.valuewhen(fib_isLo, low, 0)

// ====================================================================================================================
// РАЗДЕЛ II (ТЗ) — Bonus OTE Confluence: переменные-накопители.
// ====================================================================================================================
var float fib_ote_upper  = na
var float fib_ote_lower  = na
var int   export_fib_ote = 0

bool fib_trend_up = fib_HB < fib_LB
bool fib_trend_dn = fib_HB > fib_LB

if en_fib and not na(fib_hiPrice) and not na(fib_loPrice) and fib_hiPrice > fib_loPrice
    float fib_rng = fib_hiPrice - fib_loPrice
    if fib_trend_up
        fib_ote_lower  := fib_loPrice + fib_rng * 0.214
        fib_ote_upper  := fib_loPrice + fib_rng * 0.382
        export_fib_ote := (close >= fib_ote_lower and close <= fib_ote_upper) ? 1 : 0
    else if fib_trend_dn
        fib_ote_upper  := fib_hiPrice - fib_rng * 0.214
        fib_ote_lower  := fib_hiPrice - fib_rng * 0.382
        export_fib_ote := (close >= fib_ote_lower and close <= fib_ote_upper) ? -1 : 0
    else
        export_fib_ote := 0
        fib_ote_upper  := na
        fib_ote_lower  := na
else
    export_fib_ote := 0
    fib_ote_upper  := na
    fib_ote_lower  := na

fib_hiBar = ta.valuewhen(fib_isHi, bar_index, 0)
fib_loBar = ta.valuewhen(fib_isLo, bar_index, 0)

// ~~ Fibonacci: персистентные объекты отрисовки ──
var line fib_hiLine = na
var line fib_loLine = na

if barstate.isfirst
    fib_hiLine := line.new(na, na, na, na, color=fib_hiLineColor, width=fib_hiloLineWidth)
    fib_loLine := line.new(na, na, na, na, color=fib_loLineColor, width=fib_hiloLineWidth)

var array<line>  fib_fibbLines       = array.new_line()
var array<label> fib_fibbLabels      = array.new_label()
var array<line>  fib_forecastLines   = array.new_line()
var array<box>   fib_areas           = array.new_box()
var array<label> fib_perc            = array.new_label()
var array<box>   fib_fibProfileBoxes = array.new_box()
var array<box>   fib_fibDeltaBoxes   = array.new_box()

var int fib_deltaStartX = na

var float fib_top    = na
var float fib_bottom = na
var array<float> fib_volUp = array.new_float(fib_rows, 0.0)
var array<float> fib_volDn = array.new_float(fib_rows, 0.0)

// ~~ POC/LVN/HVN (7.3): персистентное состояние узлов объёма Fibo-профиля. Заполняется в этом же блоке,
// используется позже модулем LVZ (Часть 3) для классификации зон и синтеза POI, без новых plot(). ──
var float      fib_poc_price = na
var int        fib_poc_idx   = -1
var float      fib_poc_maxtot = na
var array<bool> fib_isLVN    = array.new_bool(fib_rows, false)
var array<bool> fib_isHVN    = array.new_bool(fib_rows, false)

// ~~ Гейты производительности: тяжёлые профильные пересчёты — не чаще 1 раза за бар (не на каждый тик).
// Cluster Volume Profile (секция 2) НЕ затронут и пересчитывается как раньше. ──
var int fib_lastProfileBar = -1
var int fib_lastDeltaBar   = -1
bool    fib_doProfileCalc  = fib_lastProfileBar != bar_index
bool    fib_doDeltaCalc    = fib_lastDeltaBar   != bar_index

// ~~ Fibonacci: вспомогательные функции ──
f_fibbFunc(v, last, h, l) =>
    last ? h - (h - l) * v : l + (h - l) * v

f_fib_cleaner(a, idx) =>
    if idx >= 0 and idx < array.size(a)
        el = array.get(a, idx)
        if not na(el)
            el.delete()
        array.remove(a, idx)

// ~~ Fibonacci: основная логика (не изменена относительно оригинала Zeiierman) ──
if en_fib and not na(fib_HB) and not na(fib_LB) and not na(fib_hiPrice) and not na(fib_loPrice) and not na(fib_hiBar) and not na(fib_loBar)
    line.set_xy1(fib_hiLine, fib_hiBar, fib_hiPrice)
    line.set_xy2(fib_hiLine, bar_index, fib_hiPrice)
    line.set_color(fib_hiLine, en_fib_vis ? fib_hiLineColor : color.new(fib_hiLineColor, 100))
    line.set_width(fib_hiLine, fib_hiloLineWidth)

    line.set_xy1(fib_loLine, fib_loBar, fib_loPrice)
    line.set_xy2(fib_loLine, bar_index, fib_loPrice)
    line.set_color(fib_loLine, en_fib_vis ? fib_loLineColor : color.new(fib_loLineColor, 100))
    line.set_width(fib_loLine, fib_hiloLineWidth)

    fib_bars = math.abs(fib_HB - fib_LB)

    for i = array.size(fib_fibbLines) - 1 to 0
        f_fib_cleaner(fib_fibbLines, i)
    for i = array.size(fib_fibbLabels) - 1 to 0
        f_fib_cleaner(fib_fibbLabels, i)

    fib_lvls = array.from(0.236, 0.382, 0.5, 0.618, 0.786)
    fib_cols = array.from(fib_Color236, fib_Color382, fib_Color500, fib_Color618, fib_Color786)

    fib_baseOffset = fib_HB > fib_LB ? fib_LB : fib_HB
    fib_xFibStart  = bar_index - fib_baseOffset

    if en_fib_vis
        for [i, e] in fib_lvls
            f  = f_fibbFunc(e, fib_HB < fib_LB, fib_hiPrice, fib_loPrice)
            x1 = fib_xFibStart
            x2 = bar_index

            ln = line.new(
             chart.point.from_index(x1, f),
             chart.point.from_index(x2, f),
             color = fib_cols.get(i),
             width = fib_LineWidth
             )
            array.push(fib_fibbLines, ln)

            if fib_showlab
                fibText = str.tostring(e * 100, "#.##") + "%"
                lbl     = label.new(
                 chart.point.from_index(x2 + fib_LabelOffset, f),
                 fibText,
                 textcolor = fib_LabelColor,
                 style      = label.style_label_left,
                 size       = fib_LabelSize,
                 color = fib_cols.get(i)
                 )
                array.push(fib_fibbLabels, lbl)

    // Projection part
    fib_fibb  = f_fibbFunc(fib_lvl, fib_LB > fib_HB, fib_hiPrice, fib_loPrice)
    fib_fibb2 = fib_LB < fib_HB ?
     f_fibbFunc(fib_lvl, true,  fib_fibb,  fib_loPrice) :
     f_fibbFunc(fib_lvl, false, fib_hiPrice, fib_fibb)

    fib_trendfibb = fib_LB > fib_HB ?
     f_fibbFunc(1.272, true,  fib_hiPrice, fib_loPrice) :
     f_fibbFunc(1.272, false, fib_hiPrice, fib_loPrice)

    fib_forecast = array.from(fib_HB < fib_LB ? fib_hiPrice : fib_loPrice, fib_fibb, fib_fibb2, fib_trendfibb)
    fib_segment  = math.min(fib_bars, math.floor(500.0 / 4.0))

    for i = array.size(fib_forecastLines) - 1 to 0
        f_fib_cleaner(fib_forecastLines, i)
    for i = array.size(fib_areas) - 1 to 0
        f_fib_cleaner(fib_areas, i)
    for i = array.size(fib_perc) - 1 to 0
        f_fib_cleaner(fib_perc, i)

    fib_deltaStartX := na
    fib_future = bar_index

    // ПРИМЕЧАНИЕ: блок проекции теперь также проверяет fib_show_proj — отдельная кнопка
    // "Показывать проекцию движения", независимая от общего "Показывать визуал".
    if en_fib_vis and fib_show_proj
        for i = 0 to fib_forecast.size() - 2
            x1 = math.min(fib_future, bar_index + 500)
            x2 = math.min(fib_future + fib_segment, bar_index + 500)

            y1 = fib_forecast.get(i)
            y2 = fib_forecast.get(i + 1)

            lnForecast = line.new(
             x1, y1,
             x2, y2,
             color = y1 < y2 ? fib_projLineBullColor : fib_projLineBearColor,
             width = fib_projLineWidth,
             style = fib_projLineStyle
             )
            array.push(fib_forecastLines, lnForecast)

            midBoxLeft  = x2 - math.round((x1 - x2) / 4.0)
            midBoxRight = x2 + math.round((x1 - x2) / 4.0)
            boxHeight   = math.abs(y1 - y2) / 10.0

            txtLevel = i == fib_forecast.size() - 2 ?
                 "1.272" :
                 str.tostring(fib_lvl * 100, "#.##")

            boxBg   = fib_projBoxBgOn     ? fib_projBoxBgColor   : color.new(fib_projBoxBgColor, 100)
            boxBord = fib_projBoxBorderOn ? fib_projBoxBorderCol : color.new(fib_projBoxBorderCol, 100)

            bx = box.new(
             midBoxLeft,
             y2 + boxHeight,
             midBoxRight,
             y2 - boxHeight,
             bgcolor      = boxBg,
             border_color = boxBord,
             border_style = fib_projBoxBorderStyle,
             border_width = fib_projBoxBorderW,
             text         = txtLevel,
             text_halign  = fib_projBoxTextHAlign,
             text_valign  = fib_projBoxTextVAlign,
             text_color   = fib_projBoxTextColor,
             text_size    = fib_projBoxTextSize
             )
            array.push(fib_areas, bx)

            fib_deltaStartX := na(fib_deltaStartX) ? box.get_right(bx) : math.max(fib_deltaStartX, box.get_right(bx))

            change = (y2 - y1) / y1
            midX   = int(math.avg(x1, x2))
            midY   = line.get_price(lnForecast, midX)

            lb = label.new(
             chart.point.from_index(midX, midY),
             str.tostring(change * 100, format.percent),
             color     = change > 0 ? fib_projPercBullColor : fib_projPercBearColor,
             style     = i == 1 ? label.style_label_lower_right : label.style_label_lower_left,
             textcolor = fib_projPercTextColor,
             size      = fib_projPercLabelSize
             )
            array.push(fib_perc, lb)
            fib_future += fib_segment

    // Fib Volume Profile — пересчитывается не чаще 1 раза за бар (fib_doProfileCalc), а не на каждом тике.
    if en_fib and fib_showFibProfile and fib_doProfileCalc and fib_hiBar != fib_loBar and not na(fib_hiPrice) and not na(fib_loPrice)
        fib_lastProfileBar := bar_index

        for i = array.size(fib_fibProfileBoxes) - 1 to 0
            f_fib_cleaner(fib_fibProfileBoxes, i)

        fib_top    := math.max(fib_hiPrice, fib_loPrice)
        fib_bottom := math.min(fib_hiPrice, fib_loPrice)

        if fib_top != fib_bottom
            fib_step = (fib_top - fib_bottom) / fib_rows

            fib_levels = array.new_float()
            for i = 0 to fib_rows
                array.push(fib_levels, fib_bottom + fib_step * i)

            for i = 0 to fib_rows - 1
                array.set(fib_volUp, i, 0.0)
                array.set(fib_volDn, i, 0.0)

            fib_startBar = math.min(fib_hiBar, fib_loBar)
            fib_endBar   = math.max(fib_hiBar, fib_loBar)

            for bi = fib_startBar to fib_endBar
                offset = bar_index - bi
                price  = hlc3[offset]
                vol    = volume[offset]
                bull   = close[offset] > open[offset]

                for r = 0 to fib_rows - 1
                    dn = array.get(fib_levels, r)
                    up = array.get(fib_levels, r + 1)
                    if price >= dn and price < up
                        if bull
                            array.set(fib_volUp, r, array.get(fib_volUp, r) + vol)
                        else
                            array.set(fib_volDn, r, array.get(fib_volDn, r) + vol)
                        break

            // ~~ POC + классификация LVN/HVN по бинам (питает LVZ/POI в Части 3) ──
            float fib_maxTot = 0.0
            int   fib_poc_idx_local = 0
            for r = 0 to fib_rows - 1
                float binTot = array.get(fib_volUp, r) + array.get(fib_volDn, r)
                if binTot > fib_maxTot
                    fib_maxTot := binTot
                    fib_poc_idx_local := r
            fib_poc_idx   := fib_poc_idx_local
            fib_poc_price := fib_bottom + fib_step * (fib_poc_idx_local + 0.5)
            fib_poc_maxtot := fib_maxTot

            fib_span = fib_endBar - fib_startBar + 1

            if fib_maxTot > 0 and en_fib_vis
                for r = 0 to fib_rows - 1
                    upVol = array.get(fib_volUp, r)
                    dnVol = array.get(fib_volDn, r)

                    normUp = upVol == 0 ? 0 : int((upVol / fib_maxTot) * fib_span)
                    normDn = dnVol == 0 ? 0 : int((dnVol / fib_maxTot) * fib_span)

                    bullRowCol = color.from_gradient(r, 0, fib_rows - 1, color.new(fib_bull_color, 80), color.new(fib_bull_color, 10))
                    bearRowCol = color.from_gradient(r, 0, fib_rows - 1, color.new(fib_bear_color, 80), color.new(fib_bear_color, 10))

                    yTop    = array.get(fib_levels, r + 1)
                    yBottom = array.get(fib_levels, r)

                    leftBull  = fib_flipOrder ? fib_startBar : fib_startBar + normDn
                    rightBull = fib_flipOrder ? fib_startBar + normUp : fib_startBar + normDn + normUp

                    leftBear  = fib_flipOrder ? fib_startBar + normUp : fib_startBar
                    rightBear = fib_flipOrder ? fib_startBar + normUp + normDn : fib_startBar + normDn

                    if normUp > 0
                        bBull = box.new(
                         leftBull,  yTop,
                         rightBull, yBottom,
                         bgcolor      = bullRowCol,
                         border_color = color.new(bullRowCol, 0),
                         border_style = line.style_dotted
                         )
                        array.push(fib_fibProfileBoxes, bBull)

                    if normDn > 0
                        bBear = box.new(
                         leftBear,  yTop,
                         rightBear, yBottom,
                         bgcolor      = bearRowCol,
                         border_color = color.new(bearRowCol, 0),
                         border_style = line.style_dotted
                         )
                        array.push(fib_fibProfileBoxes, bBear)

    // Fib Volume Delta Profile — визуал-онли, пересчёт также не чаще 1 раза за бар (fib_doDeltaCalc).
    if en_fib_vis and fib_showFibDelta and fib_doDeltaCalc and fib_hiBar != fib_loBar and not na(fib_hiPrice) and not na(fib_loPrice)
        fib_lastDeltaBar := bar_index

        for i = array.size(fib_fibDeltaBoxes) - 1 to 0
            f_fib_cleaner(fib_fibDeltaBoxes, i)

        fib_fibPrices = array.new_float()
        array.push(fib_fibPrices, fib_hiPrice)
        for e in fib_lvls
            lvlPrice = f_fibbFunc(e, fib_HB < fib_LB, fib_hiPrice, fib_loPrice)
            array.push(fib_fibPrices, lvlPrice)
        array.push(fib_fibPrices, fib_loPrice)

        fib_fibSorted = array.copy(fib_fibPrices)
        array.sort(fib_fibSorted)

        fib_bandsCount = array.size(fib_fibSorted) - 1
        if fib_bandsCount > 0
            fib_bandBull = array.new_float(fib_bandsCount, 0.0)
            fib_bandBear = array.new_float(fib_bandsCount, 0.0)

            fib_startBar2 = math.min(fib_hiBar, fib_loBar)
            fib_endBar2   = math.max(fib_hiBar, fib_loBar)

            for bi = fib_startBar2 to fib_endBar2
                offset = bar_index - bi
                price  = hlc3[offset]
                vol    = volume[offset]
                bull   = close[offset] > open[offset]

                for b = 0 to fib_bandsCount - 1
                    bandLow  = array.get(fib_fibSorted, b)
                    bandHigh = array.get(fib_fibSorted, b + 1)
                    if price >= bandLow and price < bandHigh
                        if bull
                            array.set(fib_bandBull, b, array.get(fib_bandBull, b) + vol)
                        else
                            array.set(fib_bandBear, b, array.get(fib_bandBear, b) + vol)
                        break

            fib_maxAbsDelta = 0.0
            for b = 0 to fib_bandsCount - 1
                delta = array.get(fib_bandBull, b) - array.get(fib_bandBear, b)
                fib_maxAbsDelta := math.max(fib_maxAbsDelta, math.abs(delta))

            if fib_maxAbsDelta > 0
                fib_xStartBase = fib_startBar2

                for b = 0 to fib_bandsCount - 1
                    bandLow  = array.get(fib_fibSorted, b)
                    bandHigh = array.get(fib_fibSorted, b + 1)

                    delta = array.get(fib_bandBull, b) - array.get(fib_bandBear, b)
                    if delta == 0
                        continue

                    absDelta  = math.abs(delta)
                    widthBars = int((absDelta / fib_maxAbsDelta) * fib_deltaMaxWidth)
                    widthBars := math.max(widthBars, 1)

                    xEnd   = fib_xStartBase
                    xStart = fib_xStartBase - widthBars
                    col    = delta >= 0 ? fib_deltaBullColor : fib_deltaBearColor

                    dBox = box.new(
                     xStart,  bandHigh,
                     xEnd,    bandLow,
                     bgcolor      = col,
                     border_color = color.new(col, 0),
                     border_style = line.style_solid,
                     text         = "Δ " + str.tostring(delta, format.volume),
                     text_color   = color.white,
                     text_halign  = "center",
                     text_valign  = "center"
                     )
                    array.push(fib_fibDeltaBoxes, dBox)

// ── 2. Clusters Volume Profile ───────────────────────────────────────────────
grp_1      = "2. Clusters Volume Profile"
en_1       = input.bool(true,  "Включить Clusters VP",          group=grp_1, tooltip="Что это: общий выключатель модуля кластерного объёмного профиля (K-Means по цене и объёму). Выключение полностью останавливает расчёт и отрисовку.")
lookback_1 = input.int(200,    "Период (Lookback)",  minval=10,  group=grp_1, tooltip="Что это: количество баров истории, используемых для построения кластеров. Увеличение — учитывается больше истории (более стабильные, но медленнее обновляющиеся кластеры). Уменьшение — кластеры реагируют быстрее, но менее стабильны.")
k_1        = input.int(5,      "Количество кластеров", minval=2, maxval=10, group=grp_1, tooltip="Что это: на сколько ценовых кластеров K-Means разбивает диапазон. Увеличение — больше зон с более узким диапазоном каждая (детальнее). Уменьшение — крупные широкие зоны (обобщённее).")
iters_1    = input.int(50,     "Итерации K-Means",  minval=5,   maxval=50,  group=grp_1, tooltip="Что это: число итераций алгоритма K-Means для сходимости центров кластеров. Увеличение — точнее результат, но больше нагрузка на расчёт. Уменьшение — быстрее, но менее точное разбиение.")
rows_1     = input.int(20,     "Строк на кластер (Bins)", minval=3, group=grp_1, tooltip="Что это: на сколько ценовых строк делится каждый кластер для построения профиля объёма внутри него. Увеличение — детальнее профиль внутри кластера. Уменьшение — грубее.")
vpWidth    = input.int(40,     "Ширина гистограммы (бары)", minval=5, group=grp_1, tooltip="Что это: максимальная ширина (в барах) горизонтальных столбцов профиля объёма. Увеличение — столбцы шире и заметнее. Уменьшение — компактнее.")
vpOffset   = input.int(10,     "Отступ гистограммы",          group=grp_1, tooltip="Что это: горизонтальный отступ начала гистограммы профиля от последнего бара. Увеличение — профиль дальше от цены. Уменьшение — ближе к цене.")
showDots   = input.bool(true,  "Точки прайса (Price Dots)",     group=grp_1, tooltip="Что это: показывать ли точки цены (hl2) внутри каждого кластера. Влияет только на визуал.")

// ── 3. FVG Volume Profile ────────────────────────────────────────────────────
