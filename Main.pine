e4_smc_must_raw = input.bool(true, "Обязателен", inline="e4smc", group=grp_e4h, tooltip="Если включено — без подтверждения SMC-трендом сигнал по этому TF не засчитывается.")

// ── Применение пресета (tf_level=4: HTF1) ──
e4_vol_mult     = f_pr_mult(e4_vol_mult_raw, 4)
e4_vol_must     = f_pr_must_vol(e4_vol_must_raw, 4)
e4_ob_atr_mult  = f_pr_mult(e4_ob_atr_mult_raw, 4)
e4_ob_vol_mult  = f_pr_mult(e4_ob_vol_mult_raw, 4)
e4_fvg_thr      = f_pr_mult(e4_fvg_thr_raw, 4)
e4_hm_vol_mult  = f_pr_mult(e4_hm_vol_mult_raw, 4)
e4_sd_body_mult = f_pr_mult(e4_sd_body_mult_raw, 4)
e4_sd_base_mult = f_pr_base_mult(e4_sd_base_mult_raw, 4)
e4_smc_must     = f_pr_must_smc(e4_smc_must_raw, 4)
e4_min_score    = f_pr_score(qa_min_htf1, 4)
[e4_w_struct, e4_w_volume, e4_w_pattern] = f_pr_apply_focus(qa_w_struct_htf1, qa_w_volume_htf1, qa_w_pattern_htf1)

