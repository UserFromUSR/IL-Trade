grp_lvz_poi         = "7.3 LVZ — Узлы объёма (LVN / HVN / POC / POI)"
lvz_hvn_thr         = input.float(0.65, "Порог HVN (доля от POC-бина)", minval=0.2, maxval=0.95, step=0.05, group=grp_lvz_poi, tooltip="Доля объёма бина Fibo-профиля относительно самого объёмного бина (POC), выше которой бин считается узлом высокого объёма (HVN) — обычно работает как зона поддержки/сопротивления/поглощения. Увеличение — HVN распознаётся реже. Уменьшение — чаще.")
lvz_poc_tol_atr     = input.float(0.15, "Допуск близости к POC (×ATR14)", minval=0.02, maxval=1.0, step=0.01, group=grp_lvz_poi, tooltip="Допуск в множителях ATR(14), в пределах которого цена считается 'на POC' (Point of Control — уровень с максимальным объёмом по Fibo-профилю). Увеличение — POC засчитывается на более широком диапазоне. Уменьшение — строже.")
lvz_poi_min_layers  = input.int(3, "Мин. слоёв для POI", minval=2, maxval=6, group=grp_lvz_poi, tooltip="Минимальное число совпавших слоёв (OB/S&D/FVG-POC + узел объёма POC/HVN) для признания зоны 'Point of Interest' (POI) — приоритетной зоны. Использует уже существующий счётчик Zone Confluence, добавляя к нему слой узла объёма. Плоты '[P1] Zone Layers Bull/Bear' теперь могут доходить до этого значения — так можно отличить обычный confluence от POI без добавления новых plot().")
lvz_show_poc        = input.bool(true, "Показывать линию POC", group=grp_lvz_poi, inline="lvzpoi1")
lvz_show_hvn        = input.bool(true, "Показывать зоны HVN", group=grp_lvz_poi, inline="lvzpoi1")
lvz_poc_color       = input.color(color.new(#ffd600, 0), "Цвет POC", group=grp_lvz_poi, inline="lvzpoi2")
lvz_hvn_color       = input.color(color.new(#ff6d00, 75), "Цвет HVN", group=grp_lvz_poi, inline="lvzpoi2")

if fib_lastProfileBar == bar_index and not na(fib_poc_maxtot) and fib_poc_maxtot > 0
    for r = 0 to fib_rows - 1
        float binTot3 = array.get(fib_volUp, r) + array.get(fib_volDn, r)
        array.set(fib_isLVN, r, binTot3 < fib_poc_maxtot * lvz_fib_thr)
        array.set(fib_isHVN, r, binTot3 > fib_poc_maxtot * lvz_hvn_thr)

// ====================================================================================================================
// ЕДИНЫЕ ТАЙМФРЕЙМЫ
// ====================================================================================================================

grp_tf_common = "TF — Таймфреймы (общие для всех модулей)"
g_ltf1 = input.timeframe("1",   "LTF1 ТФ", group=grp_tf_common, tooltip="Что это: таймфрейм для движка LTF1. Должен совпадать с LTF1 в Sniper P2. Меньший ТФ — больше шума и сигналов, больший — меньше, но надёжнее.")
g_ltf2 = input.timeframe("3",   "LTF2 ТФ", group=grp_tf_common, tooltip="Что это: таймфрейм для движка LTF2. Должен совпадать с LTF2 в Sniper P2.")
g_ltf3 = input.timeframe("5",   "LTF3 ТФ", group=grp_tf_common, tooltip="Что это: таймфрейм для движка LTF3. Должен совпадать с LTF3 в Sniper P2.")
g_htf1 = input.timeframe("60",  "HTF1 ТФ", group=grp_tf_common, tooltip="Что это: таймфрейм для движка HTF1. Должен совпадать с HTF1 в Sniper P2.")
g_htf2 = input.timeframe("240", "HTF2 ТФ", group=grp_tf_common, tooltip="Что это: таймфрейм для движка HTF2. Должен совпадать с HTF2 в Sniper P2.")
g_htf3 = input.timeframe("D",   "HTF3 ТФ", group=grp_tf_common, tooltip="Что это: таймфрейм для движка HTF3. Должен совпадать с HTF3 в Sniper P2.")

// ====================================================================================================================
// ENGINE LTF1 (1m)
// ПРИМЕЧАНИЕ: min_score и веса struct/volume/pattern для LTF1 теперь задаются в секции 0.1 (быстрый
// доступ) через qa_min_ltf123/qa_w_struct_ltf1/qa_w_volume_ltf1/qa_w_pattern_ltf1. Локальные инпуты
// min_score/весов здесь удалены, чтобы не дублировать одно и то же значение в двух местах панели.
// ====================================================================================================================
grp_e1 = "Engine LTF1 (1m) — RSI"
e1_use_rsi      = input.bool(true,  "Включить", inline="e1rsi", group=grp_e1, tooltip="Что это: RSI-фильтр по направлению (бык: RSI ниже порога, медведь: RSI выше порога). Выключение убирает этот фактор из скоринга LTF1.")
e1_rsi_len      = input.int(9,      "Length", minval=2, inline="e1rsi", group=grp_e1, tooltip="Период RSI. Увеличение — более плавный и медленный RSI (меньше ложных сигналов). Уменьшение — более резкий и быстрый RSI (больше сигналов, больше шума).")
e1_rsi_bull_th  = input.int(55,     "Бык <",  minval=1, maxval=99, inline="e1rsi", group=grp_e1, tooltip="Порог RSI для бычьего фактора: засчитывается, если RSI ниже этого значения. Увеличение порога — фактор срабатывает чаще. Уменьшение — реже, требует более глубокой просадки RSI.")
e1_rsi_bear_th  = input.int(45,     "Медв >", minval=1, maxval=99, inline="e1rsi", group=grp_e1, tooltip="Порог RSI для медвежьего фактора: засчитывается, если RSI выше этого значения. Уменьшение порога — фактор срабатывает чаще. Увеличение — реже, требует более высокого RSI.")

grp_e1b = "Engine LTF1 (1m) — Свечи"
e1_use_candles  = input.bool(true,  "Накопление", inline="e1c1", group=grp_e1b, tooltip="Что это: считает направленные свечи (бык/медведь) из последних 5. Выключение убирает этот фактор из скоринга.")
e1_candle_cnt   = input.int(2,      "Мин. из 5",  minval=1, maxval=5, inline="e1c1", group=grp_e1b, tooltip="Минимальное число однонаправленных свечей из последних 5 для засчитывания фактора. Увеличение — строже (нужно больше согласованных свечей). Уменьшение — мягче.")
e1_use_engulf   = input.bool(false, "Engulfing",  inline="e1c1", group=grp_e1b, tooltip="Что это: поглощение предыдущей свечи текущей. Выключено по умолчанию на всех TF движках.")
e1_use_strong   = input.bool(true,  "Strong Body", inline="e1c2", group=grp_e1b, tooltip="Что это: тело свечи превышает порог от диапазона high-low. Выключение убирает этот фактор из скоринга.")
e1_strong_ratio = input.float(0.60, "Порог",       step=0.05, inline="e1c2", group=grp_e1b, tooltip="Минимальная доля тела свечи от полного диапазона high-low для признания свечи 'сильной'. Увеличение — строже (нужны более выраженные свечи). Уменьшение — мягче.")

grp_e1c = "Engine LTF1 (1m) — Объём"
e1_use_vol      = input.bool(true,  "Включить", inline="e1v", group=grp_e1c, tooltip="Что это: объём выше SMA×мульт на направленной свече. Выключение убирает этот фактор из скоринга.")
e1_vol_sma_len  = input.int(20,     "SMA Len",  minval=5, inline="e1v", group=grp_e1c, tooltip="Период SMA объёма, относительно которой ищется всплеск. Увеличение — более стабильная база сравнения. Уменьшение — более чувствительная к недавним изменениям.")
e1_vol_mult_raw = input.float(2.0,  "Объём>SMA×", step=0.1, inline="e1v", group=grp_e1c, tooltip="Множитель SMA объёма, который должен быть превышен для засчитывания всплеска. Увеличение — строже (нужен более крупный всплеск). Уменьшение — мягче.")
e1_vol_must_raw = input.bool(true, "Обязателен", inline="e1v", group=grp_e1c, tooltip="Если включено — без подтверждения объёмом сигнал по этому TF не засчитывается. Включение делает объём жёстким фильтром для всего движка LTF1.")

grp_e1d = "Engine LTF1 (1m) — OB прокси"
e1_use_ob       = input.bool(true,  "Включить",  inline="e1ob", group=grp_e1d, tooltip="Что это: дислокация цены (ATR×) с объёмным подтверждением — прокси Order Block. Выключение убирает этот фактор из скоринга.")
e1_ob_atr_len   = input.int(10,     "ATR Len",   minval=5, inline="e1ob", group=grp_e1d, tooltip="Период ATR, используемый для оценки дислокации цены. Увеличение — более сглаженная база, уменьшение — более чувствительная.")
e1_ob_atr_mult_raw = input.float(0.8, "Дислок. ATR×", step=0.1, inline="e1ob", group=grp_e1d, tooltip="Минимальная дислокация цены в множителях ATR для признания OB-прокси. Увеличение — строже, уменьшение — мягче.")
e1_ob_vol_mult_raw = input.float(1.3, "Объём>SMA×",   step=0.1, inline="e1ob", group=grp_e1d, tooltip="Минимальный множитель объёма для подтверждения OB-прокси. Увеличение — строже, уменьшение — мягче.")

grp_e1e = "Engine LTF1 (1m) — FVG прокси"
e1_use_fvg      = input.bool(true,  "Включить",   inline="e1fvg", group=grp_e1e, tooltip="Что это: гэп между барами относительно stdev — прокси Fair Value Gap. Выключение убирает этот фактор из скоринга.")
e1_fvg_thr_raw  = input.float(0.10, "Gap порог",  step=0.05, inline="e1fvg", group=grp_e1e, tooltip="Минимальный нормализованный размер гэпа для засчитывания FVG-прокси. Увеличение — строже (только крупные гэпы), уменьшение — мягче.")
e1_fvg_with_htf = input.bool(false, "Только по HTF тренду", inline="e1fvg", group=grp_e1e, tooltip="Что это: засчитывать FVG-прокси только если он совпадает с направлением HTF EMA-тренда. Включение делает фактор строже и реже, выключение — мягче и чаще. По умолчанию выключено на всех TF.")

grp_e1f = "Engine LTF1 (1m) — HeatMap прокси"
e1_use_hm       = input.bool(true,  "Включить", inline="e1hm", group=grp_e1f, tooltip="Что это: экстремум диапазона lookback с объёмным подтверждением. Выключение убирает этот фактор из скоринга.")
e1_hm_lookback  = input.int(30,     "Lookback",  minval=10, inline="e1hm", group=grp_e1f, tooltip="Период поиска экстремума диапазона. Увеличение — реже срабатывает (крупный экстремум), уменьшение — чаще.")
e1_hm_vol_mult_raw = input.float(1.5, "Объём>SMA×", step=0.1, inline="e1hm", group=grp_e1f, tooltip="Минимальный множитель объёма для подтверждения HeatMap-прокси. Увеличение — строже, уменьшение — мягче.")

grp_e1g = "Engine LTF1 (1m) — S&D прокси"
e1_use_sd       = input.bool(true,  "Включить",  inline="e1sd", group=grp_e1g, tooltip="Что это: дислокация тела + узкая база — прокси Supply&Demand. Выключение убирает этот фактор из скоринга.")
e1_sd_body_mult_raw = input.float(1.3, "Тело>ATR×", step=0.1, inline="e1sd", group=grp_e1g, tooltip="Минимальный размер тела свечи (в ATR) для признания дислокации. Увеличение — строже, уменьшение — мягче.")
e1_sd_base_mult_raw = input.float(0.60, "База<ATR×", step=0.1, inline="e1sd", group=grp_e1g, tooltip="Максимальный размер 'базы' (узкого консолидационного участка) в ATR. Уменьшение значения — строже (нужна более узкая база), увеличение — мягче.")

grp_e1h = "Engine LTF1 (1m) — SMC прокси"
e1_use_smc      = input.bool(true,  "Включить",  inline="e1smc", group=grp_e1h, tooltip="Что это: HH/HL или LH/LL по трём наборам пивотов — прокси структуры. Выключение убирает этот фактор из скоринга.")
e1_smc_swing    = input.int(3,      "Swing Len", minval=2, inline="e1smc", group=grp_e1h, tooltip="Период поиска пивотов для определения структуры. Увеличение — крупнее и реже структура, уменьшение — чаще и мельче.")
e1_smc_hh_cnt   = input.int(2,      "Мин. из 3", minval=1, maxval=3, inline="e1smc", group=grp_e1h, tooltip="Минимальное число совпадающих наборов пивотов (из 3) для подтверждения тренда. Увеличение — строже, уменьшение — мягче.")
e1_smc_must_raw = input.bool(false, "Обязателен", inline="e1smc", group=grp_e1h, tooltip="Если включено — без подтверждения SMC-трендом сигнал по этому TF не засчитывается.")

// ── Применение пресета (tf_level=1: LTF1) ──
e1_vol_mult     = f_pr_mult(e1_vol_mult_raw, 1)
e1_vol_must     = f_pr_must_vol(e1_vol_must_raw, 1)
e1_ob_atr_mult  = f_pr_mult(e1_ob_atr_mult_raw, 1)
e1_ob_vol_mult  = f_pr_mult(e1_ob_vol_mult_raw, 1)
e1_fvg_thr      = f_pr_mult(e1_fvg_thr_raw, 1)
e1_hm_vol_mult  = f_pr_mult(e1_hm_vol_mult_raw, 1)
e1_sd_body_mult = f_pr_mult(e1_sd_body_mult_raw, 1)
e1_sd_base_mult = f_pr_base_mult(e1_sd_base_mult_raw, 1)
e1_smc_must     = f_pr_must_smc(e1_smc_must_raw, 1)
e1_min_score    = f_pr_score(qa_min_ltf123, 1)
[e1_w_struct, e1_w_volume, e1_w_pattern] = f_pr_apply_focus(qa_w_struct_ltf1, qa_w_volume_ltf1, qa_w_pattern_ltf1)

