grp_e3 = "Engine LTF3 (5m) — RSI"
e3_use_rsi      = input.bool(true,  "Включить", inline="e3rsi", group=grp_e3, tooltip="Что это: RSI-фильтр по направлению (бык: RSI ниже порога, медведь: RSI выше порога). Выключение убирает этот фактор из скоринга LTF3.")
e3_rsi_len      = input.int(9,      "Length", minval=2, inline="e3rsi", group=grp_e3, tooltip="Период RSI. Увеличение — более плавный и медленный RSI, уменьшение — более резкий и быстрый.")
