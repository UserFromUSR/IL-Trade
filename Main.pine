e3_use_ob       = input.bool(true,  "Включить",  inline="e3ob", group=grp_e3d, tooltip="Что это: дислокация цены (ATR×) с объёмным подтверждением — прокси Order Block. Выключение убирает этот фактор из скоринга.")
