// ENGINE HTF2 (4h)
// ====================================================================================================================
grp_e5 = "Engine HTF2 (4h) — RSI"
e5_use_rsi      = input.bool(true,  "Включить", inline="e5rsi", group=grp_e5, tooltip="Что это: RSI-фильтр по направлению (бык: RSI ниже порога, медведь: RSI выше порога). Выключение убирает этот фактор из скоринга HTF2.")
e5_rsi_len      = input.int(14,     "Length", minval=2, inline="e5rsi", group=grp_e5, tooltip="Период RSI. Увеличение — более плавный и медленный RSI, уменьшение — более резкий и быстрый.")
e5_rsi_bull_th  = input.int(63,     "Бык <",  minval=1, maxval=99, inline="e5rsi", group=grp_e5, tooltip="Порог RSI для бычьего фактора. Увеличение порога — срабатывает чаще, уменьшение — реже.")
e5_rsi_bear_th  = input.int(37,     "Медв >", minval=1, maxval=99, inline="e5rsi", group=grp_e5, tooltip="Порог RSI для медвежьего фактора. Уменьшение порога — срабатывает чаще, увеличение — реже.")

grp_e5b = "Engine HTF2 (4h) — Свечи"
e5_use_candles  = input.bool(true,  "Накопление", inline="e5c1", group=grp_e5b, tooltip="Что это: считает направленные свечи (бык/медведь) из последних 5. Выключение убирает этот фактор из скоринга.")
e5_candle_cnt   = input.int(4,      "Мин. из 5",  minval=1, maxval=5, inline="e5c1", group=grp_e5b, tooltip="Минимальное число однонаправленных свечей из последних 5. Увеличение — строже, уменьшение — мягче.")
e5_use_engulf   = input.bool(false, "Engulfing",  inline="e5c1", group=grp_e5b, tooltip="Что это: поглощение предыдущей свечи текущей. Выключено по умолчанию на всех TF движках.")
e5_use_strong   = input.bool(true,  "Strong Body", inline="e5c2", group=grp_e5b, tooltip="Что это: тело свечи превышает порог от диапазона high-low. Выключение убирает этот фактор из скоринга.")
e5_strong_ratio = input.float(0.60, "Порог",       step=0.05, inline="e5c2", group=grp_e5b, tooltip="Минимальная доля тела свечи от диапазона high-low. Увеличение — строже, уменьшение — мягче.")

grp_e5c = "Engine HTF2 (4h) — Объём"
e5_use_vol      = input.bool(true,  "Включить", inline="e5v", group=grp_e5c, tooltip="Что это: объём выше SMA×мульт на направленной свече. Выключение убирает этот фактор из скоринга.")
e5_vol_sma_len  = input.int(20,     "SMA Len",  minval=5, inline="e5v", group=grp_e5c, tooltip="Период SMA объёма. Увеличение — стабильнее, уменьшение — чувствительнее.")
e5_vol_mult_raw = input.float(1.7,  "Объём>SMA×", step=0.1, inline="e5v", group=grp_e5c, tooltip="Множитель SMA объёма для засчитывания всплеска. Увеличение — строже, уменьшение — мягче.")
e5_vol_must_raw = input.bool(true, "Обязателен", inline="e5v", group=grp_e5c, tooltip="Если включено — без подтверждения объёмом сигнал по этому TF не засчитывается.")

grp_e5d = "Engine HTF2 (4h) — OB прокси"
e5_use_ob       = input.bool(true,  "Включить",  inline="e5ob", group=grp_e5d, tooltip="Что это: дислокация цены (ATR×) с объёмным подтверждением — прокси Order Block. Выключение убирает этот фактор из скоринга.")
e5_ob_atr_len   = input.int(14,     "ATR Len",   minval=5, inline="e5ob", group=grp_e5d, tooltip="Период ATR для оценки дислокации цены. Увеличение — сглаженнее, уменьшение — чувствительнее.")
e5_ob_atr_mult_raw = input.float(1.4, "Дислок. ATR×", step=0.1, inline="e5ob", group=grp_e5d, tooltip="Минимальная дислокация цены в ATR для OB-прокси. Увеличение — строже, уменьшение — мягче.")
e5_ob_vol_mult_raw = input.float(1.8, "Объём>SMA×",   step=0.1, inline="e5ob", group=grp_e5d, tooltip="Минимальный множитель объёма для OB-прокси. Увеличение — строже, уменьшение — мягче.")

grp_e5e = "Engine HTF2 (4h) — FVG прокси"
e5_use_fvg      = input.bool(true,  "Включить",   inline="e5fvg", group=grp_e5e, tooltip="Что это: гэп между барами относительно stdev — прокси Fair Value Gap. Выключение убирает этот фактор из скоринга.")
e5_fvg_thr_raw  = input.float(0.25, "Gap порог",  step=0.05, inline="e5fvg", group=grp_e5e, tooltip="Минимальный нормализованный размер гэпа. Увеличение — строже, уменьшение — мягче.")
e5_fvg_with_htf = input.bool(false,  "Только по HTF тренду", inline="e5fvg", group=grp_e5e, tooltip="Что это: засчитывать FVG-прокси только при совпадении с HTF EMA-трендом. По умолчанию выключено на всех TF.")

grp_e5f = "Engine HTF2 (4h) — HeatMap прокси"
e5_use_hm       = input.bool(true,  "Включить", inline="e5hm", group=grp_e5f, tooltip="Что это: экстремум диапазона lookback с объёмным подтверждением. Выключение убирает этот фактор из скоринга.")
e5_hm_lookback  = input.int(100,    "Lookback",  minval=10, inline="e5hm", group=grp_e5f, tooltip="Период поиска экстремума диапазона. Увеличение — реже, уменьшение — чаще.")
e5_hm_vol_mult_raw = input.float(1.8, "Объём>SMA×", step=0.1, inline="e5hm", group=grp_e5f, tooltip="Минимальный множитель объёма для HeatMap-прокси. Увеличение — строже, уменьшение — мягче.")

grp_e5g = "Engine HTF2 (4h) — S&D прокси"
e5_use_sd       = input.bool(true,  "Включить",  inline="e5sd", group=grp_e5g, tooltip="Что это: дислокация тела + узкая база — прокси Supply&Demand. Выключение убирает этот фактор из скоринга.")
e5_sd_body_mult_raw = input.float(1.7, "Тело>ATR×", step=0.1, inline="e5sd", group=grp_e5g, tooltip="Минимальный размер тела свечи в ATR. Увеличение — строже, уменьшение — мягче.")
e5_sd_base_mult_raw = input.float(0.45, "База<ATR×", step=0.1, inline="e5sd", group=grp_e5g, tooltip="Максимальный размер базы в ATR. Уменьшение — строже, увеличение — мягче.")

grp_e5h = "Engine HTF2 (4h) — SMC прокси"
e5_use_smc      = input.bool(true,  "Включить",  inline="e5smc", group=grp_e5h, tooltip="Что это: HH/HL или LH/LL по трём наборам пивотов — прокси структуры. Выключение убирает этот фактор из скоринга.")
e5_smc_swing    = input.int(8,      "Swing Len", minval=2, inline="e5smc", group=grp_e5h, tooltip="Период поиска пивотов структуры. Увеличение — крупнее и реже, уменьшение — чаще и мельче.")
e5_smc_hh_cnt   = input.int(3,      "Мин. из 3", minval=1, maxval=3, inline="e5smc", group=grp_e5h, tooltip="Минимальное число совпадающих наборов пивотов из 3. Увеличение — строже, уменьшение — мягче.")
e5_smc_must_raw = input.bool(true, "Обязателен", inline="e5smc", group=grp_e5h, tooltip="Если включено — без подтверждения SMC-трендом сигнал по этому TF не засчитывается.")

// ── Применение пресета (tf_level=5: HTF2) ──
