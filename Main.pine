grp_e3c = "Engine LTF3 (5m) — Объём"
e3_use_vol      = input.bool(true,  "Включить", inline="e3v", group=grp_e3c, tooltip="Что это: объём выше SMA×мульт на направленной свече. Выключение убирает этот фактор из скоринга.")
e3_vol_sma_len  = input.int(20,     "SMA Len",  minval=5, inline="e3v", group=grp_e3c, tooltip="Период SMA объёма. Увеличение — стабильнее, уменьшение — чувствительнее.")
e3_vol_mult_raw = input.float(2.0,  "Объём>SMA×", step=0.1, inline="e3v", group=grp_e3c, tooltip="Множитель SMA объёма для засчитывания всплеска. Увеличение — строже, уменьшение — мягче.")
e3_vol_must_raw = input.bool(true, "Обязателен", inline="e3v", group=grp_e3c, tooltip="Если включено — без подтверждения объёмом сигнал по этому TF не засчитывается.")

