ma_slow_col = input.color(color.new(#9C27B0,0), "Цвет Slow MA", group=grp_trend, tooltip="Цвет линии медленной MA.")
ma_filt_col = input.color(color.new(#FF9800,0), "Цвет Global MA", group=grp_trend, tooltip="Цвет линии глобальной MA.")

