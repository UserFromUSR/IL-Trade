pack_bull.sweep := b_sweep_bull, pack_bear.sweep := b_sweep_bear
pack_bull.swb := bars_since_sweep_bull, pack_bear.swb := bars_since_sweep_bear
pack_bull.disp := b_disp_bull, pack_bear.disp := b_disp_bear
pack_bull.dpb := bars_since_disp_bull, pack_bear.dpb := bars_since_disp_bear
