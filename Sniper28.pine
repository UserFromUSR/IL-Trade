en_3bc = input.bool(true, "3 Черн. Вороны", group=grp_cndl, inline="s3", tooltip="Три Чёрные Вороны — три последовательных сильных медвежьих свечи с падающими закрытиями.")
en_estar = input.bool(true, "Вечерняя звезда", group=grp_cndl, inline="s3", tooltip="Вечерняя Звезда — бычья свеча, малое тело гэпом выше, затем медвежья свеча, закрывающая ниже середины первой.")
