en_darkcloud = input.bool(true, "Тёмное Облако", group=grp_cndl, inline="nb2", tooltip="Тёмное Облако (Dark Cloud Cover) — бычья свеча, затем медвежья, открывающаяся выше её максимума и закрывающаяся ниже середины тела первой.")
en_outside_bull = input.bool(true, "Бычий Внешний Бар", group=grp_cndl, inline="nb3", tooltip="Бычий Внешний Бар (Outside Bar) — текущий бар полностью перекрывает диапазон (high и low) предыдущего, закрытие бычье.")
