pack_bull.sm_bars := bars_since_sm_act_bull_N3, pack_bear.sm_bars := bars_since_sm_act_bear_N3
pack_bull.sm_idx := sm_idx_bull, pack_bear.sm_idx := sm_idx_bear
pack_bull.sm_int := sm_int_bull, pack_bear.sm_int := sm_int_bear
pack_bull.cvd := cvd_bull_div, pack_bear.cvd := cvd_bear_div
pack_bull.hm_bars := bars_since_hm_bull, pack_bear.hm_bars := bars_since_hm_bear
pack_bull.sdinv := b_sdinv_bull, pack_bear.sdinv := b_sdinv_bear
pack_bull.kde := in_kde_bull, pack_bear.kde := in_kde_bear
pack_bull.stoch := osc_stoch_bull, pack_bear.stoch := osc_stoch_bear
pack_bull.macd := osc_macd_dlx_bull, pack_bear.macd := osc_macd_dlx_bear
pack_bull.cci := osc_cci_bull, pack_bear.cci := osc_cci_bear
pack_bull.mdiv := osc_mdiv_bull, pack_bear.mdiv := osc_mdiv_bear
pack_bull.mdiv_cnt := total_mdiv_bull, pack_bear.mdiv_cnt := total_mdiv_bear
pack_bull.peter := osc_peter_bull, pack_bear.peter := osc_peter_bear
pack_bull.tfdiv := osc_tfdiv_bull, pack_bear.tfdiv := osc_tfdiv_bear
pack_bull.smt := osc_smt_bull, pack_bear.smt := osc_smt_bear
pack_bull.osc6 := p2_osc6_strong_bull, pack_bear.osc6 := p2_osc6_strong_bear
pack_bull.cndl_name := cndl_bull_name, pack_bear.cndl_name := cndl_bear_name
pack_bull.cndl := cndl_bull, pack_bear.cndl := cndl_bear
