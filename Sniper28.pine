// ====================================================================================================================
// КОНТЕКСТ СЕССИИ (логика не изменена)
// ====================================================================================================================
f_session_context() =>
    bool asian = not na(time("1440","0000-0900:1234567","UTC"))
    bool london = not na(time("1440","0700-1600:1234567","UTC"))
    bool ny = not na(time("1440","1200-2100:1234567","UTC"))
    bool overlap = london and ny
    string sess = overlap ? "🔥ЛДН+НЙ" : ny ? "🗽НЙ" : london ? "🇬🇧ЛДН" : asian ? "🌏АЗИЯ" : "🌙Закрыто"
    string day = dayofweek==dayofweek.monday?"Пн":dayofweek==dayofweek.tuesday?"Вт":dayofweek==dayofweek.wednesday?"Ср":dayofweek==dayofweek.thursday?"Чт":dayofweek==dayofweek.friday?"Пт":"Вых"
    sess + "│" + day + " " + str.format_time(time, "HH:mm", "UTC") + " UTC"

// ====================================================================================================================
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ (логика не изменена)
// ====================================================================================================================
f_get_align(str) => str == "Left" ? text.align_left : str == "Right" ? text.align_right : text.align_center

f_cap_lines(string txt, int max_lines) =>
    string result = txt
    int newline_count = str.length(txt) - str.length(str.replace_all(txt, "\n", ""))
    if newline_count > max_lines
        string acc = ""
        int cnt = 0
        string remaining = txt
        while cnt < max_lines
            int pos = str.pos(remaining, "\n")
            if na(pos)
                acc += remaining
                cnt := max_lines
            else
                acc += str.substring(remaining, 0, pos+1)
                remaining := str.substring(remaining, pos+1)
                cnt += 1
        result := acc + "…[обрезано]"
    result

f_counter_side_summary(bool main_is_bull) =>
    int c_ltf = main_is_bull ? mtf_state_bear : mtf_state_bull
    int c_htf = main_is_bull ? htf_bear_conf : htf_bull_conf
    int c_sc = main_is_bull ? sell_score : buy_score
    string c_dir = main_is_bull ? "ПРОДАЖА" : "ПОКУПКА"
    "⚖️ Противовес (" + c_dir + "): HTF " + str.tostring(c_htf) + "/3 │ LTF " + str.tostring(c_ltf) + "/3 │ Скор " + str.tostring(c_sc) + "/" + str.tostring(req_score)

f_score_bar(int cur_s, int req_s) =>
    int filled = math.min(cur_s, req_s)
    string bar_str = ""
    for i = 1 to req_s
        bar_str += i <= filled ? "█" : "░"
    string suffix = cur_s >= req_s ? " ✅ Готово" : " (осталось: " + str.tostring(math.max(0, req_s-cur_s)) + ")"
    "[" + bar_str + "] " + str.tostring(cur_s) + "/" + str.tostring(req_s) + suffix

f_zone_star_rating(side_detail d) =>
    int layers = d.layers
    bool virgin = d.virgin
    bool ob_sd = d.ob_sd
    bool choch_sw = d.choch_sw
    int stars = 0
    if layers >= 3
        stars += 2
    else if layers >= 2
        stars += 1
    if virgin
        stars += 1
    if ob_sd
        stars += 1
    if choch_sw
        stars += 1
    stars := math.min(stars, 5)
    string star_str = ""
    for i = 1 to 5
        star_str += i <= stars ? "⭐" : "☆"
    star_str + " (" + str.tostring(stars) + "/5)"

f_freshness_sorted(side_detail d) =>
    int c_bars = d.chb
    int s_bars = d.swb
    int hm_bars = d.hm_bars
    int di_bars = d.dpb
    int sm_bars = d.sm_bars
    int[] ev_b = array.new<int>()
    string[] ev_n = array.new<string>()
    int THRESH = 12
    if c_bars < THRESH
        ev_b.push(c_bars), ev_n.push("⚡ CHoCH")
    if s_bars < THRESH
        ev_b.push(s_bars), ev_n.push("🌊 Sweep ликвидности")
    if hm_bars < THRESH
        ev_b.push(hm_bars), ev_n.push("🔊 Сметание HeatMap")
    if di_bars < THRESH
        ev_b.push(di_bars), ev_n.push("💥 Дисплейсмент")
    if sm_bars < THRESH
        ev_b.push(sm_bars), ev_n.push("🐋 Активность SM")
    int sz = ev_b.size()
    if sz > 1
        for i = 0 to sz-2
            for j = 0 to sz-2-i
                if ev_b.get(j) > ev_b.get(j+1)
                    int tb = ev_b.get(j)
                    string tn = ev_n.get(j)
                    ev_b.set(j, ev_b.get(j+1))
                    ev_n.set(j, ev_n.get(j+1))
                    ev_b.set(j+1, tb)
                    ev_n.set(j+1, tn)
    string out = ""
    int top_n = math.min(sz-1, 3)
    if sz > 0
        for i = 0 to top_n
            int b = ev_b.get(i)
            string nm = ev_n.get(i)
            string ic = b==0 ? "🔴" : b<=2 ? "🟠" : "🟡"
            out += ic + " " + nm + ": " + str.tostring(b) + " бар назад\n"
    out

// ====================================================================================================================
// СЕКЦИЯ: СТРУКТУРА РЫНКА (SMC) — добавлены 4 новых комплекса (Sweep+OB, Disp+OB, Disp+FVG, OB+AVWAP)
// ====================================================================================================================
f_struct_section(side_detail d, bool is_bull) =>
    string out = ""
    if d.smc
        out += "📍 Структура SMC: " + (is_bull ? "бычья" : "медвежья") + "\n"
    if d.choch_sw
        out += "⚡🌊 CHoCH сразу после Sweep (комплекс) — сильный разворотный сигнал\n"
    if d.bb
        out += "🔗 Брейкер-блок активен\n"
    if d.bos
        out += "🔄 BOS подтверждён — пробой структуры\n"
    if d.choch
        out += "⚡ CHoCH активен — смена характера движения\n"
    if d.sweep
        out += "🌊 Снятие ликвидности (Sweep)\n"
    if d.sweep and d.ob
        out += "🌊📦 Sweep + OB (комплекс) — вход на блоке после снятия ликвидности\n"
    if d.disp
        out += "💥 Импульсная свеча (Displacement)\n"
    if d.disp and d.ob
        out += "💥📦 OB + Displacement (комплекс) — импульс привёл к блоку\n"
    if d.disp and d.fvg_p
        out += "💥📦 Displacement + FVG (комплекс) — импульс создал гэп\n"
    if d.avwap_x
        out += "🎯 Пересечение AVWAP " + (is_bull ? "вверх" : "вниз") + "\n"
    else if d.avwap
        out += "📌 Цена на стороне AVWAP\n"
    if d.ob and d.avwap
        out += "📦📌 OB + AVWAP (комплекс) — блок и институциональный уровень совпали\n"
    if d.virgin
        out += "✨ Девственный Order Block (касаний: " + str.tostring(d.touches) + ")\n"
    else if d.touches == 1
        out += "⚠️ Order Block: 1-е повторное касание\n"
    else if d.touches > 1
        out += "⚠️ Order Block уже трогали раз: " + str.tostring(d.touches) + "\n"
    if d.ob_sd
        out += "🎯 Order Block внутри зоны Supply/Demand (OB+S&D)\n"
    if d.bos_retest
        out += d.bos_retest_text + "\n"
        out += "🔄🎯 BOS + Retest (комплекс)\n"
    if d.choch_retest
        out += d.choch_retest_text + "\n"
        out += "⚡🎯 CHoCH + Retest (комплекс)\n"
    out += f_freshness_sorted(d)
    out == "" ? "" : "── 🏗️ Структура рынка ──\n" + out

// ====================================================================================================================
// СЕКЦИЯ: ЗОНЫ ИНТЕРЕСА — добавлены 4 новых комплекса (S&D+FVG, OTE+OB/S&D уже были, Candle+S&D, FreshOB+Candle уже был)
// ====================================================================================================================
f_zones_section(side_detail d, bool is_bull) =>
    string out = ""
    int v_layers = d.layers
    string zone_q = v_layers>=3 ? "🔥📦📦📦 Зона из 3 слоёв (OB+S&D+FVG, комплекс) — мощное совпадение\n" : v_layers==2 ? "💪 Зона из 2 слоёв\n" : v_layers==1 ? "⚪ Зона из 1 слоя\n" : ""
    if v_layers >= 1
        out += zone_q
    if d.ob_fr
        out += "✨ Свежий Order Block\n"
    else if d.ob
        out += "📦 Order Block активен\n"
    if d.sd
        out += "📦 Зона " + (is_bull ? "Спроса (Demand)" : "Предложения (Supply)") + "\n"
    if d.sd and d.fvg_p
        out += "📦📦 S&D + FVG (комплекс) — зона спроса/предложения совпала с гэпом\n"
    if d.fvg_p
        out += "📦 Цена внутри точного FVG\n"
    if d.fvg_p
        out += "🎯 FVG POC — касание уровня максимального объёма внутри гэпа\n"
    int v_ote = d.ote
    if v_ote == 2
        out += "⚖️ Цена в зоне OTE (0.618–0.786 фибо)\n"
        if d.ob
            out += "⚖️📦 OTE + OB (комплекс) — оптимальный вход на блоке\n"
        if d.sd
            out += "⚖️📦 OTE + S&D (комплекс) — оптимальный вход в зоне спроса/предложения\n"
    else if d.pd
        out += "📉 Зона " + (is_bull ? "дисконта" : "премии") + "\n"
    if d.cndl and d.ob
        out += "🕯️📦 Свеча внутри OB (комплекс) — паттерн сформировался в блоке\n"
    if d.cndl and d.sd
        out += "🕯️📦 Свечной паттерн на границе зоны S&D (комплекс)\n"
    if d.virgin and d.cndl
        out += "✨🕯️ Fresh OB + Candlestick (комплекс) — первое касание блока + паттерн\n"
    out == "" ? "" : "── 📐 Зоны интереса ──\n" + out

// ====================================================================================================================
// СЕКЦИЯ: ОБЪЁМ И ЛИКВИДНОСТЬ — добавлен 1 новый комплекс (CVD+SM+HM тройной, текстовая правка)
// ====================================================================================================================
f_volume_section(side_detail d) =>
    string out = ""
    if d.sm_act
        out += "🐋 Активность умных денег (Smart Money Activity)\n"
    else if d.sm_bars <= 5
        out += "🐋 Активность SM была: " + str.tostring(d.sm_bars) + " бар назад\n"
    if d.sm_idx
        out += "💰 Индекс умных денег (SM Index)\n"
    if d.sm_int
        out += "💡 Интерес умных денег (SM Interest)\n"
    if d.sm_act and d.sm_idx
        out += "🐋💰 SM Activity + SM Index (комплекс) — активность и индекс совпали\n"
    if d.sm_act and d.sm_idx and d.sm_int
        out += "🐋💰💡 SM Триплет (комплекс) — все три модуля умных денег активны одновременно\n"
    if d.cvd
        out += "🌊 Дивергенция CVD (объёмный поток против цены)\n"
    if sm_absorption
        out += "🧽 Поглощение объёма (Absorption) — двустороннее поглощение внутри бара\n"
    if d.cvd and sm_absorption
        out += "🌊🧽 CVD Divergence + Absorption (комплекс)\n"
    if d.hm_bars <= 5
        out += "🔊 Сметание HeatMap-ликвидности: " + str.tostring(d.hm_bars) + " бар назад\n"
    if d.hm_vol_sig
        out += "📦🔊 HeatMap Sweep Vol (комплекс) — крупный объём (>1.5×SMA) подтвердил сметание ликвидности: " + str.tostring(p1_hm_vol, format.volume) + "\n"
    if d.hm_vol_sig and d.cvd and d.sm_act
        out += "🐋🔊 CVD Div + SM Activity + HeatMap Sweep (тройной объёмный комплекс)\n"
    if d.sdinv
        out += "💥 Пробой зоны Supply/Demand (S&D Break / Inversion)\n"
    out == "" ? "" : "── 📊 Объём и ликвидность ──\n" + out

// ====================================================================================================================
// СЕКЦИЯ: ОСЦИЛЛЯТОРЫ (логика не изменена — комплексы здесь уже были в тексте, теперь они и в скоринге)
// ====================================================================================================================
f_osc_section(side_detail d) =>
    string out = ""
    if d.kde
        out += "📐 RSI вышел из плотной зоны вероятностей (KDE)\n"
    if d.stoch
        out += "🌀 Stoch Z-Score развернулся на экстремуме\n"
    if d.kde and d.stoch
        out += "📐🌀 KDE RSI + Stoch Z-Score (комплекс) — два осциллятора развернулись одновременно\n"
    if d.macd
        out += "⚙️ Adaptive MACD Deluxe пересёк уровень\n"
    if d.cci
        out += "🎢 Advanced CCI Supertrend подтвердил\n"
    if d.macd and d.cci
        out += "⚙️🎢 MACD Deluxe + CCI (комплекс) — оба осциллятора подтвердили направление\n"
    if d.mdiv
        out += "🔍 Мульти-дивергенция найдена (" + str.tostring(d.mdiv_cnt) + " индикаторов)\n"
    if d.mdiv_cnt >= 3
        out += "🔍🔍 Multi-Div 3+ (усиленная) — расхождение по " + str.tostring(d.mdiv_cnt) + " индикаторам одновременно\n"
    if d.peter
        out += "🔎 Дивергенция PeterO (нерепейнт) подтверждена\n"
    if d.tfdiv
        out += "🧩 Фрактальная дивергенция TradingFinder найдена\n"
    if d.peter and d.tfdiv
        out += "🔎🧩 PeterO Div + TF Fractal Div (комплекс) — два независимых модуля совпали\n"
    if d.smt
        out += "🌐 Межрыночная дивергенция (SMT)\n"
    if d.cvd and d.mdiv
        out += "🌊🔍 CVD Divergence + Multi-Div (комплекс) — объёмное и классическое расхождение одновременно\n"
    if d.smt and d.mdiv
        out += "🌐🔍 SMT + Multi-Div (комплекс) — межрыночная и классическая дивергенция совпали\n"
    if d.mdiv and d.peter and d.smt
        out += "🔍🔎🌐 Multi-Div + PeterO Div + SMT Div (тройной дивергенционный комплекс)\n"
    if d.osc6
        out += "💪 Сильное совпадение P2 OSC10 (6+ из 10 на одном ТФ)\n"
    out == "" ? "" : "── 🎛️ Осцилляторы ──\n" + out

// ====================================================================================================================
// СЕКЦИЯ: СВЕЧИ И СРЕДНИЕ (логика не изменена — MACross+MATrend комплекс здесь уже был, теперь и в скоринге)
// ====================================================================================================================
f_cndl_ma_section(side_detail d, bool is_bull) =>
    string out = ""
    if d.cndl
        out += "🕯️ Свечной паттерн: " + d.cndl_name + "\n"
    if d.ma_x
        out += "✕ Пересечение MA " + (is_bull ? "вверх" : "вниз") + "\n"
    if d.ma_tr
        out += "📈 Тренд по MA " + (is_bull ? "бычий" : "медвежий") + "\n"
    if d.ma_x and d.ma_tr
        out += "✕📈 MA Cross + MA Trend (комплекс) — пересечение в направлении глобального тренда\n"
    out == "" ? "" : "── 🕯️ Свечи и средние ──\n" + out

f_market_section(side_detail d, bool is_bull) =>
    string out = ""
    if d.regime
        out += "📈 Directional Regime: ADX " + str.tostring(math.round(adx_val)) + " — выраженный " + (is_bull ? "бычий" : "медвежий") + " тренд\n"
    else if regime_ranging
        out += "😴 Ranging Market — ADX слабый / Choppiness высокий, направления нет\n"
    if regime_trending
        out += "📊 Trending Market — ADX>25 и Choppiness<50\n"
    if regime_compression
        out += "🔇 Volatility Compression — сжатие ATR с боковиком, рынок готовится к импульсу\n"
    if vol_ok
        out += "🌪️ Волатильность расширена выше нормы\n"
    if d.regime and d.smc
        out += "📊📍 Regime Trending + SMC (комплекс) — подтверждённый тренд по ADX совпадает со структурой\n"
    out == "" ? "" : "── 🌡️ Режим рынка ──\n" + out

f_mtf_complex_section(int ltf_sc, int htf_sc, int sc, int req, bool master_active, bool conf_ok) =>
    string out = ""
    if ltf_sc == 3 and htf_sc == 3
        out += "🔵🟢 LTF 3/3 + HTF 3/3 (полный MTF-каскад) — Grade A+ потенциал\n"
    else if ltf_sc == 3 and htf_sc >= 2 and (sc >= req)
        out += "🔵🟡 LTF 3/3 + HTF 2/3 + req_score выполнен — Grade A потенциал\n"
    else if ltf_sc >= 2 and htf_sc >= 2 and sc >= req
        out += "🟡🟡 LTF 2/3 + HTF 2/3 + req_score выполнен — Grade B потенциал\n"
    else if ltf_sc >= 1 and htf_sc >= 1
        out += "⚪⚪ LTF 1/3 + HTF 1/3 — накопление контекста (Grade C)\n"
    if master_active
        out += "✅ Master Signal P1 активен (Main подтвердил главный сигнал)\n"
    if conf_ok
        out += "✅ Confluence Main ≥7 — высокая совокупность факторов на стороне Main\n"
    if master_active and conf_ok and ltf_sc == 3 and htf_sc == 3 and sc >= req
        out += "💎 Все 6 ТФ + Master Signal + req_score — финальный снайперский комплекс (Grade A+)\n"
    out == "" ? "" : "── 🧬 MTF-комплексы ──\n" + out

f_all_factors_block(side_detail d, bool is_bull, int ltf_sc, int htf_sc, int sc, int req) =>
    f_struct_section(d, is_bull) + f_zones_section(d, is_bull) + f_volume_section(d) + f_osc_section(d) + f_cndl_ma_section(d, is_bull) + f_market_section(d, is_bull) + f_mtf_complex_section(ltf_sc, htf_sc, sc, req, is_bull ? b_master_bull : b_master_bear, is_bull ? b_conf_bull_ok : b_conf_bear_ok)

// ====================================================================================================================
// ИНФОБЛОК (логика не изменена)
// ====================================================================================================================
f_build_info(side_detail d, tf_detail_strings tf, int ltf_sc, int htf_sc, int layers, int sc, float sig_px, string grade, bool is_bull) =>
    string info = ""
    if not p1_connected
        info := "⛔ Main P1 не подключён\nСигналы недоступны"
    else
        info += f_grade_emoji(grade) + " Грейд сигнала: " + grade + "\n"
        info += "💲 Цена сигнала: " + str.tostring(sig_px, format.mintick) + "\n"
        if info_show_time
            info += "🕐 " + str.format_time(time, "HH:mm dd.MM.yy", "UTC") + " UTC\n"
        if info_show_regime
            string regime_str = d.regime ? "📈 " + (is_bull?"Бычий":"Медвежий") + " тренд (ADX=" + str.tostring(math.round(adx_val)) + ")" : regime_compression ? "🔇 Сжатие волатильности" : regime_ranging ? "😴 Боковик (Chop=" + str.tostring(math.round(choppiness)) + ")" : "❓ Переходное состояние"
            info += "🔭 Режим рынка: " + regime_str + "\n"
        info += "──────────────────────────\n"
        string htf_hdr = f_htf_icon(htf_sc)
        info += htf_hdr + " HTF Контекст (" + str.tostring(htf_sc) + "/3) ──────\n"
        info += tf.htf1 + "\n" + tf.htf2 + "\n" + tf.htf3 + "\n" + tf.htf_verdict + "\n"
        string ltf_hdr = f_ltf_icon(ltf_sc)
        info += ltf_hdr + " LTF Каскад (" + str.tostring(ltf_sc) + "/3 тира) ──\n"
        info += tf.ltf1 + "\n" + tf.ltf2 + "\n" + tf.ltf3 + "\n" + tf.ltf_cascade_verdict + "\n"
        info += "──────────────────────────\n"
        if info_show_zone_stars
            info += "⭐ Качество зоны: " + f_zone_star_rating(d) + "\n"
            info += "──────────────────────────\n"
        info += "🎯 СКОР: " + str.tostring(sc) + "/" + str.tostring(req_score) + "\n"
        if info_show_counter
            info += f_counter_side_summary(is_bull) + "\n"
        info += "── ✅ Что было активно в момент сигнала ──\n"
        info += f_all_factors_block(d, is_bull, ltf_sc, htf_sc, sc, req_score)
    f_cap_lines(info, info_max_lines)

// ====================================================================================================================
// ЖИВОЙ СВЕТОФОР (логика не изменена)
// ====================================================================================================================
var label dynamic_lbl = na
if (barstate.isrealtime or barstate.islast) and en_live_lbl and p1_connected
    int cur_ltf_bull = mtf_state_bull
    int cur_ltf_bear = mtf_state_bear
    int cur_htf_bull = htf_bull_conf
    int cur_htf_bear = htf_bear_conf
    float strength_bull = f_side_strength(cur_ltf_bull, cur_htf_bull, buy_score)
    float strength_bear = f_side_strength(cur_ltf_bear, cur_htf_bear, sell_score)
    bool is_bull_d = strength_bull > strength_bear and (cur_ltf_bull > 0 or cur_htf_bull > 0 or buy_score > 0)
    bool is_bear_d = not is_bull_d and (cur_ltf_bear > 0 or cur_htf_bear > 0 or sell_score > 0)
    int cur_ltf = is_bull_d ? cur_ltf_bull : cur_ltf_bear
    int cur_htf = is_bull_d ? cur_htf_bull : cur_htf_bear
    bool live_now = is_bull_d ? intrabar_signal_live_buy : intrabar_signal_live_sell
    float live_price = is_bull_d ? intrabar_signal_price_buy : intrabar_signal_price_sell

    if cur_ltf > 0 or cur_htf > 0 or live_now or buy_score > 0 or sell_score > 0
        string dir = is_bull_d ? "ПОКУПКА ↑" : "ПРОДАЖА ↓"
        int cur_layers = is_bull_d ? p1_zone_layers_bull : p1_zone_layers_bear
        int cur_score = is_bull_d ? buy_score : sell_score
        bool cur_regime_aligned = is_bull_d ? final_regime_bull : final_regime_bear
        string cur_grade = f_signal_grade(cur_ltf, cur_htf, cur_layers, cur_score, req_score, cur_regime_aligned)
        side_detail cur_pack = is_bull_d ? pack_bull : pack_bear
        tf_detail_strings cur_tf_pack = is_bull_d ? tf_pack_bull : tf_pack_bear
        bool ready = (is_bull_d ? buy_score : sell_score) >= req_score and (is_bull_d ? buy_valid : sell_valid) and (is_bull_d ? full_gate_bull : full_gate_bear)
        color bg_c = live_now ? live_bg_intrabar : f_grade_live_bg(cur_grade, is_bull_d)
        string htf_icon = f_htf_icon(cur_htf)
        string ltf_icon = f_ltf_icon(cur_ltf)
        string grade_ic = f_grade_emoji(cur_grade)
        string tier_txt = live_now ? "⚡ СИГНАЛ ВНУТРИ БАРА — " + dir + " @ " + str.tostring(live_price, format.mintick) : ready ? grade_ic + " СНАЙПЕРСКИЙ ВХОД (" + dir + ")" : cur_grade=="B" ? grade_ic + " Готов ко входу (" + dir + ")" : cur_grade=="C" ? grade_ic + " Почти готов (" + dir + ")" : cur_grade=="D" ? grade_ic + " Накопление контекста (" + dir + ")" : "⏳ Нет достаточного контекста (" + dir + ")"
        string poi_s = is_bull_d ? (b_ob_bull?"OB ":"")+(b_sd_bull?"S&D ":"")+(b_fvg_precise_bull?"FVG ":"")+(ote_score_bull>=2?"OTE":"") : (b_ob_bear?"OB ":"")+(b_sd_bear?"S&D ":"")+(b_fvg_precise_bear?"FVG ":"")+(ote_score_bear>=2?"OTE":"")
        string metrics = htf_icon + " HTF: " + str.tostring(cur_htf) + "/3  │  " + ltf_icon + " LTF: " + str.tostring(cur_ltf) + "/3\n" + "📊 " + f_score_bar(cur_score, req_score) + "\n" + "💲 " + str.tostring(close, format.mintick) + (live_show_session ? "  │  " + f_session_context() : "") + "\n" + (info_show_counter ? f_counter_side_summary(is_bull_d) + "\n" : "")
        string live_txt_raw = tier_txt + "\n" + metrics + "─────────────────────\n" + "── 🟦 HTF (P1 | OSC10) ──\n" + cur_tf_pack.htf1 + "\n" + cur_tf_pack.htf2 + "\n" + cur_tf_pack.htf3 + "\n" + "── 🟪 LTF (P1 | OSC10) ──\n" + cur_tf_pack.ltf1 + "\n" + cur_tf_pack.ltf2 + "\n" + cur_tf_pack.ltf3 + "\n" + "── 📍 Точки интереса: " + (poi_s=="" ? "нет" : poi_s) + " ──\n" + f_all_factors_block(cur_pack, is_bull_d, cur_ltf, cur_htf, cur_score, req_score)
        string live_txt = f_cap_lines(live_txt_raw, live_max_lines)
        float y_pos = is_bull_d ? low - atr14*live_lbl_gap : high + atr14*live_lbl_gap
        string lbl_st = is_bull_d ? label.style_label_up : label.style_label_down
        if not na(dynamic_lbl)
            label.delete(dynamic_lbl)
        dynamic_lbl := label.new(bar_index, y_pos, text=live_txt, style=lbl_st, color=bg_c, textcolor=live_text_col, size=get_size(live_text_size))
    else
        if not na(dynamic_lbl)
            label.delete(dynamic_lbl)
            dynamic_lbl := na

if barstate.isconfirmed
    if not na(dynamic_lbl)
        label.delete(dynamic_lbl)
        dynamic_lbl := na

// ====================================================================================================================
// ВИЗУАЛИЗАЦИЯ — ИТОГОВЫЕ ЛЕЙБЛЫ BUY/SELL (логика не изменена)
// ====================================================================================================================
if is_buy
    int ltf_s = mtf_state_bull
    int htf_s = htf_bull_conf
    int layers = p1_zone_layers_bull
    string grade = signal_grade_buy
    color buy_col = f_grade_color_bull(grade)
    string htf_ic = f_htf_icon(htf_s)
    string ltf_ic = f_ltf_icon(ltf_s)
    string zone_ic = layers>=3 ? "🔥" : layers==2 ? "💪" : ""
    string grade_b = f_grade_emoji(grade)
    string buy_txt = grade_b + " " + htf_ic + ltf_ic + zone_ic + " ПОКУПКА [" + grade + "]\nСкор: " + str.tostring(buy_score) + "/" + str.tostring(req_score)
    if en_sig_labels
        label.new(bar_index, low - atr14, text=buy_txt, style=label.style_label_up, color=buy_col, textcolor=sig_text_col, size=get_size(sig_text_size))
    if en_info_block
        color info_bg = f_grade_info_bg(grade, true)
        label.new(bar_index, low - atr14*(1+info_gap), text=f_build_info(pack_bull, tf_pack_bull, ltf_s, htf_s, layers, buy_score, signal_price_buy, grade, true), style=label.style_label_up, color=info_bg, textcolor=info_text_col, size=get_size(info_text_size), textalign=f_get_align(info_align))

if is_sell
    int ltf_s = mtf_state_bear
    int htf_s = htf_bear_conf
    int layers = p1_zone_layers_bear
    string grade = signal_grade_sell
    color sell_col = f_grade_color_bear(grade)
    string htf_ic = f_htf_icon(htf_s)
    string ltf_ic = f_ltf_icon(ltf_s)
    string zone_ic = layers>=3 ? "🔥" : layers==2 ? "💪" : ""
    string grade_s = f_grade_emoji(grade)
    string sell_txt = grade_s + " " + htf_ic + ltf_ic + zone_ic + " ПРОДАЖА [" + grade + "]\nСкор: " + str.tostring(sell_score) + "/" + str.tostring(req_score)
    if en_sig_labels
        label.new(bar_index, high + atr14, text=sell_txt, style=label.style_label_down, color=sell_col, textcolor=sig_text_col, size=get_size(sig_text_size))
    if en_info_block
        color info_bg = f_grade_info_bg(grade, false)
        label.new(bar_index, high + atr14*(1+info_gap), text=f_build_info(pack_bear, tf_pack_bear, ltf_s, htf_s, layers, sell_score, signal_price_sell, grade, false), style=label.style_label_down, color=info_bg, textcolor=info_text_col, size=get_size(info_text_size), textalign=f_get_align(info_align))
