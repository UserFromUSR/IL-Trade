en_hammer = input.bool(true, "Бычьи: Молот", group=grp_cndl, inline="b1", tooltip="Молот — длинная нижняя тень, малое тело, после нисходящего движения.")
en_ihammer = input.bool(true, "Пер. Молот", group=grp_cndl, inline="b1", tooltip="Перевёрнутый Молот — длинная верхняя тень, малое тело, после нисходящего движения.")
en_bull_eng = input.bool(true, "Поглощение", group=grp_cndl, inline="b2", tooltip="Бычье Поглощение — текущая бычья свеча телом перекрывает предыдущую медвежью.")
en_r3 = input.bool(true, "3 Поднимающихся", group=grp_cndl, inline="b2", tooltip="Метод 3 Поднимающихся — 3 малых медвежьих свечи внутри диапазона крупной, затем пробой вверх.")
en_3ws = input.bool(true, "3 Белых Солдата", group=grp_cndl, inline="b3", tooltip="Три Белых Солдата — три последовательных сильных бычьих свечи с растущими закрытиями.")
en_mstar = input.bool(true, "Утренняя звезда", group=grp_cndl, inline="b3", tooltip="Утренняя Звезда — медвежья свеча, малое тело гэпом ниже, затем бычья свеча, закрывающая выше середины первой.")
en_bull_har = input.bool(true, "Харами", group=grp_cndl, inline="b4", tooltip="Бычье Харами — малая бычья свеча внутри тела предыдущей крупной медвежьей.")
en_tw_bot = input.bool(true, "Пинцет Дно", group=grp_cndl, inline="b4", tooltip="Пинцет Дно — два соседних бара с почти одинаковым минимумом, второй бычий.")
