grp_trend = "1. Скользящие Средние (MA) и Тренд"
en_mod_ma = input.bool(true, "🟢 Включить модуль MA", group=grp_trend, tooltip="Включает/выключает весь модуль скользящих средних (Fast/Slow/Global) и его сигналы пересечения/тренда.")
sync_len = input.int(5, "Swing Период", minval=2, group=grp_trend, tooltip="Период поиска свинг-хай/лоу для авто-определения тренда, когда Main P1 не подключён. Больше — более крупные свинги и реже смена тренда.")
ma_sig_logic = input.string("Fast > Slow", "Логика Тренда MA", options=["Fast > Slow", "Price > Global MA", "Both"], group=grp_trend, tooltip="Как определять бычий/медвежий тренд MA: по пересечению Fast/Slow, по положению цены относительно глобальной MA, или по совпадению обоих условий (строже).")
ma_fast_type = input.string("EMA", "Тип Быстрой MA", options=["EMA", "WMA", "HMA", "ALMA", "SMA"], group=grp_trend, tooltip="Тип расчёта быстрой скользящей средней. HMA/ALMA быстрее реагируют на цену, SMA — самая инертная.")
ma_fast_len = input.int(20, "Длина Быстрой MA", minval=1, group=grp_trend, tooltip="Период быстрой MA. Меньше — чувствительнее к цене и больше пересечений, больше — более плавная линия.")
ma_slow_type = input.string("EMA", "Тип Медленной MA", options=["EMA", "WMA", "HMA", "ALMA", "SMA"], group=grp_trend, tooltip="Тип расчёта медленной скользящей средней.")
ma_slow_len = input.int(50, "Длина Медленной MA", minval=1, group=grp_trend, tooltip="Период медленной MA. Больше — более сглаженный, медленнее реагирующий ориентир тренда.")
ma_filt_type = input.string("EMA", "Тип Глобальной MA", options=["EMA", "WMA", "HMA", "ALMA", "SMA"], group=grp_trend, tooltip="Тип расчёта глобальной (фильтрующей) скользящей средней.")
ma_filt_len = input.int(200, "Длина Глобальной MA", minval=1, group=grp_trend, tooltip="Период глобальной MA — обычно крупный, служит долгосрочным фильтром направления.")
alma_offset = input.float(0.85, "ALMA Offset", group=grp_trend, tooltip="Смещение ALMA (0..1) — ближе к 1 делает ALMA более похожей на цену, ближе к 0 — более сглаженной.")
alma_sigma = input.float(6.0, "ALMA Sigma", group=grp_trend, tooltip="Параметр сглаживания ALMA — больше значение, сильнее сглаживание.")
en_ma = input.bool(true, "Показывать Fast/Slow MA", group=grp_trend, tooltip="Включает/выключает отрисовку линий Fast и Slow MA на графике.")
en_ma_filt = input.bool(true, "Показывать Global MA", group=grp_trend, tooltip="Включает/выключает отрисовку линии глобальной MA на графике.")
en_ma_cross = input.bool(true, "Отмечать пересечение Fast/Slow", group=grp_trend, tooltip="Включает/выключает значки-маркеры пересечения Fast/Slow MA на графике.")
