kde_steps = input.int(75, "Точность (Bins)", minval=10, group=grp_osc_kde, tooltip="Количество шагов разбиения диапазона RSI для построения плотности. Больше — точнее, но тяжелее по нагрузке.")
kde_thresh = input.string("Medium", "Порог активации", options=["High", "Medium", "Low"], group=grp_osc_kde, tooltip="Порог чувствительности срабатывания KDE-сигнала. High — самый строгий (реже сигнал), Low — самый мягкий (чаще).")

