p2_ema_fast_len = input.int(8, "EMA Fast", minval=2, inline="p2ema", group=grp_p2_osc, tooltip="3) EMA fast/slow — эквивалент MA Cross (модуль 1). Длина быстрой EMA.")
p2_ema_slow_len = input.int(21, "Slow", minval=2, inline="p2ema", group=grp_p2_osc, tooltip="Длина медленной EMA.")
p2_zscore_len = input.int(21, "Z-Score Length", minval=5, inline="p2z", group=grp_p2_osc, tooltip="4) Z-Score цены — эквивалент Stoch Z-Score (2.2) в компактной форме. Период расчёта Z-score цены.")
p2_bb_len = input.int(20, "BB Length", minval=5, inline="p2bb", group=grp_p2_osc, tooltip="5) Bollinger %B — экстремумы волатильности (доп. фактор). Период полос Боллинджера.")
p2_bb_mult = input.float(2.0, "Mult", minval=0.5, step=0.1, inline="p2bb", group=grp_p2_osc, tooltip="Множитель стандартного отклонения для полос Боллинджера.")
p2_bb_bull_max = input.float(0.3, "Бык макс", minval=0.0, maxval=1.0, step=0.05, inline="p2bb2", group=grp_p2_osc, tooltip="BB %B бычий: макс (перепроданность).")
p2_bb_bear_min = input.float(0.7, "Медв мин", minval=0.0, maxval=1.0, step=0.05, inline="p2bb2", group=grp_p2_osc, tooltip="BB %B медвежий: мин (перекупленность).")
p2_stochrsi_len = input.int(14, "StochRSI Len", minval=2, inline="p2srsi", group=grp_p2_osc, tooltip="6) Stochastic RSI — скорость осциллятора RSI (доп. фактор). Период StochRSI.")
p2_stochrsi_k = input.int(3, "%K", minval=1, inline="p2srsi", group=grp_p2_osc, tooltip="Сглаживание линии %K StochRSI.")
p2_stochrsi_d = input.int(3, "%D", minval=1, inline="p2srsi", group=grp_p2_osc, tooltip="Сглаживание линии %D StochRSI.")
p2_stochrsi_bull_max = input.float(25.0, "Бык макс", minval=0.0, maxval=100.0, step=1.0, inline="p2srsi2", group=grp_p2_osc, tooltip="Максимальный уровень %K StochRSI для бычьего сигнала.")
p2_stochrsi_bear_min = input.float(75.0, "Медв мин", minval=0.0, maxval=100.0, step=1.0, inline="p2srsi2", group=grp_p2_osc, tooltip="Минимальный уровень %K StochRSI для медвежьего сигнала.")
p2_cci_len = input.int(20, "CCI Len", minval=2, inline="p2cci", group=grp_p2_osc, tooltip="7) CCI Supertrend — эквивалент Advanced CCI (2.4). Период CCI.")
p2_cci_factor = input.float(2.5, "ATR Factor", minval=0.5, step=0.1, inline="p2cci", group=grp_p2_osc, tooltip="Множитель ATR для CCI-Supertrend линии.")
p2_cci_atr_len = input.int(10, "ATR Period", minval=2, inline="p2cci", group=grp_p2_osc, tooltip="Период ATR для CCI-Supertrend.")
p2_mdiv_len = input.int(14, "Дивергенция: окно поиска (баров)", minval=5, group=grp_p2_osc, tooltip="8) RSI+MACD дивергенция — эквивалент Multi-Div / PeterO Div (2.8/2.9) в компактной форме. Расстояние в барах для сравнения цены/осциллятора.")
p2_cndl_body_ratio = input.float(0.55, "Свеча: порог сильного тела", minval=0.1, maxval=0.95, step=0.05, group=grp_p2_osc, tooltip="9) Candlestick engulfing/strong body — эквивалент свечного модуля (3.2). Минимальная доля тела от диапазона бара для признания свечи 'сильной'.")
p2_vol_sma_len = input.int(20, "Volume Z: SMA Len", minval=5, inline="p2vol", group=grp_p2_osc, tooltip="10) Volume Z-Score spike — эквивалент Smart Money Activity (2.5). Период SMA объёма для Z-score.")
p2_vol_z_th = input.float(1.5, "Порог", minval=0.5, step=0.1, inline="p2vol", group=grp_p2_osc, tooltip="Порог Z-score объёма для признания всплеска.")

grp_p2_perTF = "6.1.1 P2 OSC10 — пороги подтверждения по каждому TF (0..10)"
p2_ltf1_min_ok_raw = qa_ltf1_min_ok_raw
p2_ltf2_min_ok_raw = qa_ltf2_min_ok_raw
p2_ltf3_min_ok_raw = qa_ltf3_min_ok_raw
p2_htf1_min_ok_raw = qa_htf1_min_ok_raw
p2_htf2_min_ok_raw = qa_htf2_min_ok_raw
p2_htf3_min_ok_raw = qa_htf3_min_ok_raw

var int[] PR_OSC_OFS_LTF = array.from(-1, -2)
var int[] PR_OSC_OFS_HTF = array.from(-1, -2)

f_pr_osc_ltf(int base) =>
    int result = base
    if preset_idx_p2 >= 0
        result := math.max(1, math.min(10, base + PR_OSC_OFS_LTF.get(preset_idx_p2)))
    result

f_pr_osc_htf(int base) =>
    int result = base
    if preset_idx_p2 >= 0
        result := math.max(1, math.min(10, base + PR_OSC_OFS_HTF.get(preset_idx_p2)))
    result

p2_ltf1_min_ok = f_pr_osc_ltf(p2_ltf1_min_ok_raw)
p2_ltf2_min_ok = f_pr_osc_ltf(p2_ltf2_min_ok_raw)
p2_ltf3_min_ok = f_pr_osc_ltf(p2_ltf3_min_ok_raw)
p2_htf1_min_ok = f_pr_osc_htf(p2_htf1_min_ok_raw)
p2_htf2_min_ok = f_pr_osc_htf(p2_htf2_min_ok_raw)
p2_htf3_min_ok = f_pr_osc_htf(p2_htf3_min_ok_raw)

// ====================================================================================================================
// P2 ОСЦИЛЛЯТОРНЫЙ ДВИЖОК — 10 STATELESS-ЭКВИВАЛЕНТОВ МОДУЛЕЙ SNIPER (логика не изменена)
// ====================================================================================================================
p2_osc_engine() =>
    float rsi_v = ta.rsi(close, p2_rsi_len)
    bool rsi_bull = rsi_v >= p2_rsi_bull_lo and rsi_v <= p2_rsi_bull_hi
    bool rsi_bear = rsi_v >= p2_rsi_bear_lo and rsi_v <= p2_rsi_bear_hi
    [mac_l, mac_s, mac_h] = ta.macd(close, p2_macd_fast, p2_macd_slow, p2_macd_signal)
    bool macd_bull = mac_l > mac_s or mac_h > 0
    bool macd_bear = mac_l < mac_s or mac_h < 0
    float ema_f = ta.ema(close, p2_ema_fast_len)
    float ema_s = ta.ema(close, p2_ema_slow_len)
    bool ema_bull = ema_f > ema_s
    bool ema_bear = ema_f < ema_s
    float zs_basis = ta.sma(close, p2_zscore_len)
    float zs_dev = ta.stdev(close, p2_zscore_len)
    float zscore = zs_dev > 0 ? (close - zs_basis) / zs_dev : 0.0
    bool zs_bull = zscore < -1.0
    bool zs_bear = zscore > 1.0
    float bb_basis = ta.sma(close, p2_bb_len)
    float bb_dev = ta.stdev(close, p2_bb_len) * p2_bb_mult
    float bb_upper = bb_basis + bb_dev
    float bb_lower = bb_basis - bb_dev
    float bb_range = math.max(bb_upper - bb_lower, 1e-10)
    float bb_pctb = (close - bb_lower) / bb_range
    bool bb_bull = bb_pctb <= p2_bb_bull_max
    bool bb_bear = bb_pctb >= p2_bb_bear_min
    float rsi_for_stoch = ta.rsi(close, p2_stochrsi_len)
    float stoch_rsi_raw = ta.stoch(rsi_for_stoch, rsi_for_stoch, rsi_for_stoch, p2_stochrsi_len)
    float stoch_rsi_k = ta.sma(stoch_rsi_raw, p2_stochrsi_k)
    float stoch_rsi_d = ta.sma(stoch_rsi_k, p2_stochrsi_d)
    bool srsi_bull = stoch_rsi_k <= p2_stochrsi_bull_max and stoch_rsi_k >= stoch_rsi_d
    bool srsi_bear = stoch_rsi_k >= p2_stochrsi_bear_min and stoch_rsi_k <= stoch_rsi_d
    float cci_v = ta.cci(close, p2_cci_len)
    float cci_atr = ta.atr(p2_cci_atr_len)
    float cci_up = hl2 - (p2_cci_factor * cci_atr)
    float cci_dn = hl2 + (p2_cci_factor * cci_atr)
    bool cci_bull = cci_v > 0 and close > cci_up
    bool cci_bear = cci_v < 0 and close < cci_dn
    float price_now = close
    float price_then = close[p2_mdiv_len]
    float rsi_now = rsi_v
    float rsi_then = rsi_v[p2_mdiv_len]
    bool div_bull_reg = price_now < price_then and rsi_now > rsi_then
    bool div_bear_reg = price_now > price_then and rsi_now < rsi_then
    float macd_now = mac_l
    float macd_then = mac_l[p2_mdiv_len]
    bool div_bull_macd = price_now < price_then and macd_now > macd_then
    bool div_bear_macd = price_now > price_then and macd_now < macd_then
    bool mdiv_bull = div_bull_reg or div_bull_macd
    bool mdiv_bear = div_bear_reg or div_bear_macd
    float body_r = math.abs(close - open) / math.max(high - low, syminfo.mintick)
    bool strong_body_bull = body_r > p2_cndl_body_ratio and close > open
    bool strong_body_bear = body_r > p2_cndl_body_ratio and close < open
    bool engulf_bull = close > open and close > high[1] and open < close[1]
    bool engulf_bear = close < open and close < low[1] and open > close[1]
    bool cndl_bull_eq = strong_body_bull or engulf_bull
    bool cndl_bear_eq = strong_body_bear or engulf_bear
    float vol_sma_v = ta.sma(volume, p2_vol_sma_len)
    float vol_stdev_v = ta.stdev(volume, p2_vol_sma_len)
    float vol_z = vol_stdev_v > 0 ? (volume - vol_sma_v) / vol_stdev_v : 0.0
    bool vol_spike = vol_z > p2_vol_z_th
    bool vol_bull = vol_spike and close > open
    bool vol_bear = vol_spike and close < open
    int cnt_bull = (rsi_bull?1:0)+(macd_bull?1:0)+(ema_bull?1:0)+(zs_bull?1:0)+(bb_bull?1:0)+(srsi_bull?1:0)+(cci_bull?1:0)+(mdiv_bull?1:0)+(cndl_bull_eq?1:0)+(vol_bull?1:0)
    int cnt_bear = (rsi_bear?1:0)+(macd_bear?1:0)+(ema_bear?1:0)+(zs_bear?1:0)+(bb_bear?1:0)+(srsi_bear?1:0)+(cci_bear?1:0)+(mdiv_bear?1:0)+(cndl_bear_eq?1:0)+(vol_bear?1:0)
    [cnt_bull, cnt_bear]

[p2_ltf1_cnt_b, p2_ltf1_cnt_s] = request.security(syminfo.tickerid, mtf_tv_1, p2_osc_engine(), lookahead=barmerge.lookahead_off)
[p2_ltf2_cnt_b, p2_ltf2_cnt_s] = request.security(syminfo.tickerid, mtf_tv_2, p2_osc_engine(), lookahead=barmerge.lookahead_off)
[p2_ltf3_cnt_b, p2_ltf3_cnt_s] = request.security(syminfo.tickerid, mtf_tv_3, p2_osc_engine(), lookahead=barmerge.lookahead_off)
[p2_htf1_cnt_b, p2_htf1_cnt_s] = request.security(syminfo.tickerid, htf_tv_1, p2_osc_engine(), lookahead=barmerge.lookahead_off)
[p2_htf2_cnt_b, p2_htf2_cnt_s] = request.security(syminfo.tickerid, htf_tv_2, p2_osc_engine(), lookahead=barmerge.lookahead_off)
[p2_htf3_cnt_b, p2_htf3_cnt_s] = request.security(syminfo.tickerid, htf_tv_3, p2_osc_engine(), lookahead=barmerge.lookahead_off)

bool p2_ltf1_osc_b = p2_ltf1_cnt_b >= p2_ltf1_min_ok
bool p2_ltf1_osc_s = p2_ltf1_cnt_s >= p2_ltf1_min_ok
bool p2_ltf2_osc_b = p2_ltf2_cnt_b >= p2_ltf2_min_ok
bool p2_ltf2_osc_s = p2_ltf2_cnt_s >= p2_ltf2_min_ok
bool p2_ltf3_osc_b = p2_ltf3_cnt_b >= p2_ltf3_min_ok
bool p2_ltf3_osc_s = p2_ltf3_cnt_s >= p2_ltf3_min_ok
bool p2_htf1_osc_b = p2_htf1_cnt_b >= p2_htf1_min_ok
bool p2_htf1_osc_s = p2_htf1_cnt_s >= p2_htf1_min_ok
bool p2_htf2_osc_b = p2_htf2_cnt_b >= p2_htf2_min_ok
bool p2_htf2_osc_s = p2_htf2_cnt_s >= p2_htf2_min_ok
bool p2_htf3_osc_b = p2_htf3_cnt_b >= p2_htf3_min_ok
bool p2_htf3_osc_s = p2_htf3_cnt_s >= p2_htf3_min_ok
bool p2_osc6_strong_bull = p2_ltf1_cnt_b >= 6 or p2_ltf2_cnt_b >= 6 or p2_ltf3_cnt_b >= 6
bool p2_osc6_strong_bear = p2_ltf1_cnt_s >= 6 or p2_ltf2_cnt_s >= 6 or p2_ltf3_cnt_s >= 6

// ====================================================================================================================
// 7. ВНЕШНИЕ ИНДИКАТОРЫ (P1 ← Main) — без изменений логики
// ====================================================================================================================
grp_p1 = "7. Внешние Индикаторы (Подключение Main P1)"
float p1_alive_src = input.source(close, "[P1] ALIVE_SIGNAL (9999.0)", group=grp_p1, tooltip="Сигнал 'живости' подключения к Main. Должен быть подан плот со значением 9999.0 — иначе Sniper считает Main не подключённым.")
float p1_smc_src = input.source(close, "[P1] SMC Trend", group=grp_p1, tooltip="Направление SMC-структуры из Main: 1 бычье, -1 медвежье, 0 нейтрально.")
float p1_ob_src = input.source(close, "[P1] OB State", group=grp_p1, tooltip="Состояние Order Block из Main: 1 бычий активен, -1 медвежий активен.")
float p1_ob_touch_src = input.source(close, "[P1] OB Touch", group=grp_p1, tooltip="Событие касания Order Block из Main: 1 бычье касание, -1 медвежье.")
float p1_bb_src = input.source(close, "[P1] Breaker Signal", group=grp_p1, tooltip="Сигнал брейкер-блока из Main.")
float p1_hm_src = input.source(close, "[P1] HM Sweep", group=grp_p1, tooltip="Событие сметания ликвидности (HeatMap Sweep) из Main.")
float p1_hm_vol_src = input.source(close, "[P1] HM Sweep Vol", group=grp_p1, tooltip="Объём бара, на котором произошло сметание ликвидности (для оценки значимости).")
float p1_fvg_src = input.source(close, "[P1] FVG POC", group=grp_p1, tooltip="Направление активного FVG из Main.")
float p1_fvg_top_src = input.source(close, "[P1] FVG Top", group=grp_p1, tooltip="Верхняя граница активного FVG.")
float p1_fvg_bot_src = input.source(close, "[P1] FVG Bottom", group=grp_p1, tooltip="Нижняя граница активного FVG.")
float p1_sd_src = input.source(close, "[P1] S&D Zone", group=grp_p1, tooltip="Направление активной зоны Supply/Demand из Main.")
float p1_sdinv_src = input.source(close, "[P1] S&D Break", group=grp_p1, tooltip="Событие пробоя/инверсии зоны Supply/Demand.")
float p1_sweep_src = input.source(close, "[P1] SMC Sweep", group=grp_p1, tooltip="Событие снятия ликвидности (SMC Sweep) из Main.")
float p1_choch_src = input.source(close, "[P1] CHoCH", group=grp_p1, tooltip="Событие смены характера движения (CHoCH) из Main.")
float p1_bos_trig_src = input.source(close, "[P1] BOS Trigger", group=grp_p1, tooltip="Событие срабатывания пробоя структуры (BOS) из Main.")
float p1_bos_src = input.source(close, "[P1] Confirmed BOS Level", group=grp_p1, tooltip="Знак цены = направление уровня: '+' бычий (поддержка при retest), '-' медвежий (сопротивление).")
float p1_choch_lvl_src = input.source(close, "[P1] Confirmed CHoCH Level", group=grp_p1, tooltip="Знак цены = направление уровня: '+' бычий (поддержка при retest), '-' медвежий (сопротивление).")
float p1_bos_touches_src = input.source(close, "[P1] BOS Level Touches", group=grp_p1, tooltip="Количество касаний подтверждённого уровня BOS.")
float p1_choch_touches_src = input.source(close, "[P1] CHoCH Level Touches", group=grp_p1, tooltip="Количество касаний подтверждённого уровня CHoCH.")
float p1_avwap_src = input.source(close, "[P1] Institutional AVWAP", group=grp_p1, tooltip="Институциональный анкерный VWAP из Main.")
float p1_avwap_fast_src = input.source(close, "[P1] Fast AVWAP", group=grp_p1, tooltip="Быстрый анкерный VWAP из Main (приоритетнее институционального, если подключён).")
float p1_disp_src = input.source(close, "[P1] Displacement Candle", group=grp_p1, tooltip="Событие импульсной свечи (Displacement) из Main.")
float p1_swing_h_src = input.source(close, "[P1] Swing High", group=grp_p1, tooltip="Уровень последнего свинг-хая из Main (для расчёта OTE).")
float p1_swing_l_src = input.source(close, "[P1] Swing Low", group=grp_p1, tooltip="Уровень последнего свинг-лоу из Main (для расчёта OTE).")
float p1_ote_zone_src = input.source(close, "[P1] OTE Zone", group=grp_p1, tooltip="Прямой флаг нахождения цены в OTE-зоне из Main.")
float p1_zone_conf_bull_src = input.source(close, "[P1] Zone Confluence Bull", group=grp_p1, tooltip="Флаг конфлюэнса зон (бычий) из Main.")
float p1_zone_conf_bear_src = input.source(close, "[P1] Zone Confluence Bear", group=grp_p1, tooltip="Флаг конфлюэнса зон (медвежий) из Main.")
float p1_zone_layers_bull_src = input.source(close, "[P1] Zone Layers Bull", group=grp_p1, tooltip="Количество совпавших слоёв зоны (бычьей) из Main.")
float p1_zone_layers_bear_src = input.source(close, "[P1] Zone Layers Bear", group=grp_p1, tooltip="Количество совпавших слоёв зоны (медвежьей) из Main.")
float p1_choch_sw_bull_src = input.source(close, "[P1] CHoCH After Sweep Bull", group=grp_p1, tooltip="Флаг CHoCH сразу после Sweep (бычий комплекс) из Main.")
float p1_choch_sw_bear_src = input.source(close, "[P1] CHoCH After Sweep Bear", group=grp_p1, tooltip="Флаг CHoCH сразу после Sweep (медвежий комплекс) из Main.")
float p1_ob_touch_cnt_bull_src = input.source(close, "[P1] Bull OB Touch Count", group=grp_p1, tooltip="Счётчик касаний бычьего Order Block из Main.")
float p1_ob_touch_cnt_bear_src = input.source(close, "[P1] Bear OB Touch Count", group=grp_p1, tooltip="Счётчик касаний медвежьего Order Block из Main.")
float p1_ob_sd_bull_src = input.source(close, "[P1] OB in SD Bull", group=grp_p1, tooltip="Флаг нахождения бычьего OB внутри зоны S&D из Main.")
float p1_ob_sd_bear_src = input.source(close, "[P1] OB in SD Bear", group=grp_p1, tooltip="Флаг нахождения медвежьего OB внутри зоны S&D из Main.")
float p1_conf_bull_src = input.source(close, "[P1] Confluence Bull", group=grp_p1, tooltip="Числовая совокупность факторов (бычья) из Main.")
float p1_conf_bear_src = input.source(close, "[P1] Confluence Bear", group=grp_p1, tooltip="Числовая совокупность факторов (медвежья) из Main.")
float p1_master_src = input.source(close, "[P1] Master Signal", group=grp_p1, tooltip="Главный мастер-сигнал из Main: 1 бычий, -1 медвежий.")
float p1_regime_bull_src = input.source(close, "[P1] Market Regime Bull", group=grp_p1, tooltip="Направленный фактор из Main: ADX+DI бычий контекст (не путать с недифференцированным ADX).")
float p1_regime_bear_src = input.source(close, "[P1] Market Regime Bear", group=grp_p1, tooltip="Направленный фактор из Main: ADX+DI медвежий контекст.")
float p1_adx_val_src = input.source(close, "[P1] ADX Value", group=grp_p1, tooltip="Значение ADX из Main.")
float p1_ltf1_score_bull_src = input.source(close, "[P1] LTF1 Score Bull", group=grp_p1, tooltip="Бычий скор LTF1 из Main.")
float p1_ltf1_score_bear_src = input.source(close, "[P1] LTF1 Score Bear", group=grp_p1, tooltip="Медвежий скор LTF1 из Main.")
float p1_ltf2_score_bull_src = input.source(close, "[P1] LTF2 Score Bull", group=grp_p1, tooltip="Бычий скор LTF2 из Main.")
float p1_ltf2_score_bear_src = input.source(close, "[P1] LTF2 Score Bear", group=grp_p1, tooltip="Медвежий скор LTF2 из Main.")
float p1_ltf3_score_bull_src = input.source(close, "[P1] LTF3 Score Bull", group=grp_p1, tooltip="Бычий скор LTF3 из Main.")
float p1_ltf3_score_bear_src = input.source(close, "[P1] LTF3 Score Bear", group=grp_p1, tooltip="Медвежий скор LTF3 из Main.")
float p1_htf1_score_bull_src = input.source(close, "[P1] HTF1 Score Bull", group=grp_p1, tooltip="Бычий скор HTF1 из Main.")
float p1_htf1_score_bear_src = input.source(close, "[P1] HTF1 Score Bear", group=grp_p1, tooltip="Медвежий скор HTF1 из Main.")
float p1_htf2_score_bull_src = input.source(close, "[P1] HTF2 Score Bull", group=grp_p1, tooltip="Бычий скор HTF2 из Main.")
float p1_htf2_score_bear_src = input.source(close, "[P1] HTF2 Score Bear", group=grp_p1, tooltip="Медвежий скор HTF2 из Main.")
float p1_htf3_score_bull_src = input.source(close, "[P1] HTF3 Score Bull", group=grp_p1, tooltip="Бычий скор HTF3 из Main.")
float p1_htf3_score_bear_src = input.source(close, "[P1] HTF3 Score Bear", group=grp_p1, tooltip="Медвежий скор HTF3 из Main.")
float p1_ltf1_min_src = input.source(close, "[P1] LTF1 Min Score", group=grp_p1, tooltip="Минимальный требуемый скор LTF1, заданный в Main.")
float p1_ltf2_min_src = input.source(close, "[P1] LTF2 Min Score", group=grp_p1, tooltip="Минимальный требуемый скор LTF2, заданный в Main.")
float p1_ltf3_min_src = input.source(close, "[P1] LTF3 Min Score", group=grp_p1, tooltip="Минимальный требуемый скор LTF3, заданный в Main.")
float p1_htf1_min_src = input.source(close, "[P1] HTF1 Min Score", group=grp_p1, tooltip="Минимальный требуемый скор HTF1, заданный в Main.")
float p1_htf2_min_src = input.source(close, "[P1] HTF2 Min Score", group=grp_p1, tooltip="Минимальный требуемый скор HTF2, заданный в Main.")
float p1_htf3_min_src = input.source(close, "[P1] HTF3 Min Score", group=grp_p1, tooltip="Минимальный требуемый скор HTF3, заданный в Main.")

// ====================================================================================================================
// ИНИЦИАЛИЗАЦИЯ P1 — ПРОВЕРКА ПОДКЛЮЧЕНИЯ (логика не изменена)
// ====================================================================================================================
is_conn(src) => not na(p1_alive_src) and p1_alive_src == 9999.0 and not na(src)
bool p1_connected = not na(p1_alive_src) and p1_alive_src == 9999.0

int p1_smc_trend = is_conn(p1_smc_src) ? int(p1_smc_src) : 0
int p1_bos_trig = is_conn(p1_bos_trig_src) ? int(p1_bos_trig_src) : 0
int p1_ob_signal = is_conn(p1_ob_src) ? int(p1_ob_src) : 0
int p1_sd_zone = is_conn(p1_sd_src) ? int(p1_sd_src) : 0
int p1_fvg_dir = is_conn(p1_fvg_src) ? int(p1_fvg_src) : 0
int p1_bb_signal = is_conn(p1_bb_src) ? int(p1_bb_src) : 0
int p1_hm_signal = is_conn(p1_hm_src) ? int(p1_hm_src) : 0
int p1_sdinv_signal = is_conn(p1_sdinv_src) ? int(p1_sdinv_src) : 0
int p1_sweep_signal = is_conn(p1_sweep_src) ? int(p1_sweep_src) : 0
int p1_choch_signal = is_conn(p1_choch_src) ? int(p1_choch_src) : 0
int p1_ob_touch = is_conn(p1_ob_touch_src) ? int(p1_ob_touch_src) : 0
float p1_fvg_top = is_conn(p1_fvg_top_src) ? p1_fvg_top_src : na
float p1_fvg_bot = is_conn(p1_fvg_bot_src) ? p1_fvg_bot_src : na
float p1_hm_vol = is_conn(p1_hm_vol_src) ? p1_hm_vol_src : 0.0
float p1_avwap = is_conn(p1_avwap_src) ? p1_avwap_src : na
float p1_avwap_fast = is_conn(p1_avwap_fast_src) ? p1_avwap_fast_src : na
int p1_disp = is_conn(p1_disp_src) ? int(p1_disp_src) : 0
float p1_swing_h = is_conn(p1_swing_h_src) ? p1_swing_h_src : na
float p1_swing_l = is_conn(p1_swing_l_src) ? p1_swing_l_src : na
int p1_ote_zone = is_conn(p1_ote_zone_src) ? int(p1_ote_zone_src) : 0
int p1_ltf1_sb = is_conn(p1_ltf1_score_bull_src) ? int(p1_ltf1_score_bull_src) : 0
int p1_ltf1_ss = is_conn(p1_ltf1_score_bear_src) ? int(p1_ltf1_score_bear_src) : 0
int p1_ltf2_sb = is_conn(p1_ltf2_score_bull_src) ? int(p1_ltf2_score_bull_src) : 0
int p1_ltf2_ss = is_conn(p1_ltf2_score_bear_src) ? int(p1_ltf2_score_bear_src) : 0
int p1_ltf3_sb = is_conn(p1_ltf3_score_bull_src) ? int(p1_ltf3_score_bull_src) : 0
int p1_ltf3_ss = is_conn(p1_ltf3_score_bear_src) ? int(p1_ltf3_score_bear_src) : 0
int p1_htf1_sb = is_conn(p1_htf1_score_bull_src) ? int(p1_htf1_score_bull_src) : 0
int p1_htf1_ss = is_conn(p1_htf1_score_bear_src) ? int(p1_htf1_score_bear_src) : 0
int p1_htf2_sb = is_conn(p1_htf2_score_bull_src) ? int(p1_htf2_score_bull_src) : 0
int p1_htf2_ss = is_conn(p1_htf2_score_bear_src) ? int(p1_htf2_score_bear_src) : 0
int p1_htf3_sb = is_conn(p1_htf3_score_bull_src) ? int(p1_htf3_score_bull_src) : 0
int p1_htf3_ss = is_conn(p1_htf3_score_bear_src) ? int(p1_htf3_score_bear_src) : 0
int p1_ltf1_min = is_conn(p1_ltf1_min_src) ? int(p1_ltf1_min_src) : 4
int p1_ltf2_min = is_conn(p1_ltf2_min_src) ? int(p1_ltf2_min_src) : 4
int p1_ltf3_min = is_conn(p1_ltf3_min_src) ? int(p1_ltf3_min_src) : 4
int p1_htf1_min = is_conn(p1_htf1_min_src) ? int(p1_htf1_min_src) : 5
int p1_htf2_min = is_conn(p1_htf2_min_src) ? int(p1_htf2_min_src) : 5
int p1_htf3_min = is_conn(p1_htf3_min_src) ? int(p1_htf3_min_src) : 6
int p1_master = is_conn(p1_master_src) ? int(p1_master_src) : 0
int p1_conf_bull = is_conn(p1_conf_bull_src) ? int(p1_conf_bull_src) : 0
int p1_conf_bear = is_conn(p1_conf_bear_src) ? int(p1_conf_bear_src) : 0
bool p1_regime_bull = is_conn(p1_regime_bull_src) and p1_regime_bull_src == 1
bool p1_regime_bear = is_conn(p1_regime_bear_src) and p1_regime_bear_src == 1
float p1_adx_val = is_conn(p1_adx_val_src) ? p1_adx_val_src : na
bool p1_zone_conf_bull = is_conn(p1_zone_conf_bull_src) and p1_zone_conf_bull_src == 1
bool p1_zone_conf_bear = is_conn(p1_zone_conf_bear_src) and p1_zone_conf_bear_src == 1
int p1_zone_layers_bull = is_conn(p1_zone_layers_bull_src) ? int(p1_zone_layers_bull_src) : 0
int p1_zone_layers_bear = is_conn(p1_zone_layers_bear_src) ? int(p1_zone_layers_bear_src) : 0
bool p1_choch_sw_bull = is_conn(p1_choch_sw_bull_src) and p1_choch_sw_bull_src == 1
bool p1_choch_sw_bear = is_conn(p1_choch_sw_bear_src) and p1_choch_sw_bear_src == 1
int p1_ob_touch_cnt_bull = is_conn(p1_ob_touch_cnt_bull_src) ? int(p1_ob_touch_cnt_bull_src) : 0
int p1_ob_touch_cnt_bear = is_conn(p1_ob_touch_cnt_bear_src) ? int(p1_ob_touch_cnt_bear_src) : 0
bool p1_ob_sd_bull = is_conn(p1_ob_sd_bull_src) and p1_ob_sd_bull_src == 1
bool p1_ob_sd_bear = is_conn(p1_ob_sd_bear_src) and p1_ob_sd_bear_src == 1
int bos_level_dir = is_conn(p1_bos_src) ? int(math.sign(p1_bos_src)) : 0
float bos_level_price = is_conn(p1_bos_src) ? math.abs(p1_bos_src) : na
int choch_level_dir = is_conn(p1_choch_lvl_src) ? int(math.sign(p1_choch_lvl_src)) : 0
float choch_level_price = is_conn(p1_choch_lvl_src) ? math.abs(p1_choch_lvl_src) : na
int p1_bos_touches = is_conn(p1_bos_touches_src) ? int(p1_bos_touches_src) : 0
int p1_choch_touches = is_conn(p1_choch_touches_src) ? int(p1_choch_touches_src) : 0

if not p1_connected and barstate.islast
    label.new(bar_index, high + ta.atr(14) * 3, text="⛔ Main P1 не подключён\nSniper работает только совместно с Main P1\nПодключите индикатор через Input → Source", style=label.style_label_down, color=color.new(color.red,10), textcolor=color.white, size=size.normal)

// ── Синхронный MTF каскад ──
bool p1_tier_ltf1_bull = p1_connected and (p1_ltf1_sb >= p1_ltf1_min)
bool p1_tier_ltf1_bear = p1_connected and (p1_ltf1_ss >= p1_ltf1_min)
bool p1_tier_ltf2_bull = p1_connected and (p1_ltf2_sb >= p1_ltf2_min)
bool p1_tier_ltf2_bear = p1_connected and (p1_ltf2_ss >= p1_ltf2_min)
bool p1_tier_ltf3_bull = p1_connected and (p1_ltf3_sb >= p1_ltf3_min)
bool p1_tier_ltf3_bear = p1_connected and (p1_ltf3_ss >= p1_ltf3_min)
bool p1_tier_htf1_bull = p1_connected and (p1_htf1_sb >= p1_htf1_min)
bool p1_tier_htf1_bear = p1_connected and (p1_htf1_ss >= p1_htf1_min)
bool p1_tier_htf2_bull = p1_connected and (p1_htf2_sb >= p1_htf2_min)
bool p1_tier_htf2_bear = p1_connected and (p1_htf2_ss >= p1_htf2_min)
bool p1_tier_htf3_bull = p1_connected and (p1_htf3_sb >= p1_htf3_min)
bool p1_tier_htf3_bear = p1_connected and (p1_htf3_ss >= p1_htf3_min)

bool tier_ltf1_bull = p1_tier_ltf1_bull and p2_ltf1_osc_b
bool tier_ltf1_bear = p1_tier_ltf1_bear and p2_ltf1_osc_s
bool tier_ltf2_bull = p1_tier_ltf2_bull and p2_ltf2_osc_b
bool tier_ltf2_bear = p1_tier_ltf2_bear and p2_ltf2_osc_s
bool tier_ltf3_bull = p1_tier_ltf3_bull and p2_ltf3_osc_b
bool tier_ltf3_bear = p1_tier_ltf3_bear and p2_ltf3_osc_s
bool tier_htf1_bull = p1_tier_htf1_bull and p2_htf1_osc_b
bool tier_htf1_bear = p1_tier_htf1_bear and p2_htf1_osc_s
bool tier_htf2_bull = p1_tier_htf2_bull and p2_htf2_osc_b
bool tier_htf2_bear = p1_tier_htf2_bear and p2_htf2_osc_s
bool tier_htf3_bull = p1_tier_htf3_bull and p2_htf3_osc_b
bool tier_htf3_bear = p1_tier_htf3_bear and p2_htf3_osc_s

// ── MTF Cascade Timer-Memory ──
var int blt1b = 999, var int blt2b = 999, var int blt3b = 999
var int blt1s = 999, var int blt2s = 999, var int blt3s = 999
var int bht1b = 999, var int bht2b = 999, var int bht3b = 999
var int bht1s = 999, var int bht2s = 999, var int bht3s = 999
blt1b := tier_ltf1_bull ? 0 : math.min(blt1b+1, 999)
blt2b := tier_ltf2_bull ? 0 : math.min(blt2b+1, 999)
blt3b := tier_ltf3_bull ? 0 : math.min(blt3b+1, 999)
blt1s := tier_ltf1_bear ? 0 : math.min(blt1s+1, 999)
blt2s := tier_ltf2_bear ? 0 : math.min(blt2s+1, 999)
blt3s := tier_ltf3_bear ? 0 : math.min(blt3s+1, 999)
bht1b := tier_htf1_bull ? 0 : math.min(bht1b+1, 999)
bht2b := tier_htf2_bull ? 0 : math.min(bht2b+1, 999)
bht3b := tier_htf3_bull ? 0 : math.min(bht3b+1, 999)
bht1s := tier_htf1_bear ? 0 : math.min(bht1s+1, 999)
bht2s := tier_htf2_bear ? 0 : math.min(bht2s+1, 999)
bht3s := tier_htf3_bear ? 0 : math.min(bht3s+1, 999)

int mtf_state_raw_bull = (blt1b<=mtf_window?1:0)+(blt2b<=mtf_window?1:0)+(blt3b<=mtf_window?1:0)
int mtf_state_raw_bear = (blt1s<=mtf_window?1:0)+(blt2s<=mtf_window?1:0)+(blt3s<=mtf_window?1:0)
int htf_state_raw_bull = (bht1b<=htf_window?1:0)+(bht2b<=htf_window?1:0)+(bht3b<=htf_window?1:0)
int htf_state_raw_bear = (bht1s<=htf_window?1:0)+(bht2s<=htf_window?1:0)+(bht3s<=htf_window?1:0)

// ── Market Regime (внутренний расчёт Sniper) ──
float atr14 = ta.atr(14)
float atr100 = ta.atr(100)
bool vol_ok = (atr14 / math.max(atr100, 1e-10)) > vol_th
float chop_tr_sum = math.sum(ta.tr, chop_len)
float chop_hi = ta.highest(high, chop_len)
float chop_lo = ta.lowest(low, chop_len)
float choppiness = 100 * math.log10(chop_tr_sum / math.max(chop_hi - chop_lo, 1e-10)) / math.log10(chop_len)
[di_plus, di_minus, adx_val] = ta.dmi(adx_len, adx_len)
bool regime_trending = adx_val > 25 and choppiness < 50
bool regime_ranging = choppiness > 61.8 or adx_val < 20
bool regime_compression = vol_ok == false and choppiness > 61.8
bool local_regime_bull = adx_val > 20 and di_plus > di_minus
bool local_regime_bear = adx_val > 20 and di_minus > di_plus
bool final_regime_bull = p1_connected ? p1_regime_bull : local_regime_bull
bool final_regime_bear = p1_connected ? p1_regime_bear : local_regime_bear

// ── Retest-логика BOS / CHoCH ──
float retest_tol = atr14 * 0.15
bool b_bos_retest_bull = p1_connected and bos_level_dir == 1 and not na(bos_level_price) and math.abs(close - bos_level_price) <= retest_tol and p1_bos_touches <= 3
bool b_bos_retest_bear = p1_connected and bos_level_dir == -1 and not na(bos_level_price) and math.abs(close - bos_level_price) <= retest_tol and p1_bos_touches <= 3
bool b_choch_retest_bull = p1_connected and choch_level_dir == 1 and not na(choch_level_price) and math.abs(close - choch_level_price) <= retest_tol and p1_choch_touches <= 3
bool b_choch_retest_bear = p1_connected and choch_level_dir == -1 and not na(choch_level_price) and math.abs(close - choch_level_price) <= retest_tol and p1_choch_touches <= 3
bool bos_level_exhausted = p1_bos_touches > 3
bool choch_level_exhausted = p1_choch_touches > 3

// ── HM Sweep Vol — значимость объёма sweep'а ──
float hm_vol_base_sma = ta.sma(volume, 20)
bool hm_vol_significant = p1_hm_vol > hm_vol_base_sma * 1.5

// ── Глобальные расчёты P2 ──
[g_mac_line, g_mac_signal, g_mac_hist] = ta.macd(close, 12, 26, 9)
float g_macdL = g_mac_line
float g_macdH = g_mac_hist
float g_rsi = ta.rsi(close, 14)
float g_stc = ta.sma(ta.stoch(close, high, low, 14), 3)
float g_cci = ta.cci(close, 10)
float g_mom = ta.mom(close, 10)
float g_obv = ta.obv
float g_vwm = ta.vwma(close, 12) - ta.vwma(close, 26)
float g_cmf = ta.sma((((close-low)-(high-close))/(high-low))*volume, 21) / ta.sma(volume, 21)
float g_mfi = ta.mfi(close, 14)
float chg_close = ta.change(close)
float chg_high = ta.change(high)
float chg_low = ta.change(low)
float g_p_obv = ta.cum(chg_close > 0 ? volume : chg_close < 0 ? -volume : 0)
float g_p_diosc = fixnan(100 * ta.rma(chg_high - (-chg_low), 14) / ta.rma(ta.tr, 14))
float g_cndl_atr = ta.atr(14)

float s_h1 = request.security(smt_sym1, timeframe.period, high)
float s_l1 = request.security(smt_sym1, timeframe.period, low)
float s_h2 = request.security(smt_sym2, timeframe.period, high)
float s_l2 = request.security(smt_sym2, timeframe.period, low)
float[] global_lt_v = request.security_lower_tf(syminfo.tickerid, sm_act_ltf, volume)
float[] global_lt_c = request.security_lower_tf(syminfo.tickerid, sm_act_ltf, close)
float[] global_lt_o = request.security_lower_tf(syminfo.tickerid, sm_act_ltf, open)

// ── MA расчёты ──
f_get_ma(src, len, type) => switch type
    "EMA" => ta.ema(src, len)
    "WMA" => ta.wma(src, len)
    "HMA" => ta.hma(src, len)
    "ALMA" => ta.alma(src, len, alma_offset, alma_sigma)
    => ta.sma(src, len)

float ma_f = f_get_ma(close, ma_fast_len, ma_fast_type)
float ma_s = f_get_ma(close, ma_slow_len, ma_slow_type)
float ma_g = f_get_ma(close, ma_filt_len, ma_filt_type)
bool cond_cross_bull = ma_f > ma_s
bool cond_cross_bear = ma_f < ma_s
bool cond_pglob_bull = close > ma_g
bool cond_pglob_bear = close < ma_g
bool ma_trend_bull = ma_sig_logic == "Fast > Slow" ? cond_cross_bull : ma_sig_logic == "Price > Global MA" ? cond_pglob_bull : (cond_cross_bull and cond_pglob_bull)
bool ma_trend_bear = ma_sig_logic == "Fast > Slow" ? cond_cross_bear : ma_sig_logic == "Price > Global MA" ? cond_pglob_bear : (cond_cross_bear and cond_pglob_bear)
int ma_trend_status = ma_trend_bull ? 1 : ma_trend_bear ? -1 : 0
bool x_ma_bull = ta.crossover(ma_f, ma_s)
bool x_ma_bear = ta.crossunder(ma_f, ma_s)

plot(en_ma ? ma_f : na, "MA Fast", ma_fast_col, 1)
plot(en_ma ? ma_s : na, "MA Slow", ma_slow_col, 2)
plot(en_ma_filt ? ma_g : na, "MA Global", ma_filt_col, 2)
plotshape(en_ma and en_ma_cross and x_ma_bull, "MA Cross Bull", shape.labelup, location.belowbar, color.new(#2196F3,30), 0, "✕", color.white, size=size.tiny)
plotshape(en_ma and en_ma_cross and x_ma_bear, "MA Cross Bear", shape.labeldown, location.abovebar, color.new(#9C27B0,30), 0, "✕", color.white, size=size.tiny)

var float swing_h = na
var float swing_l = na
var int auto_trend = 1
float ph_sw = ta.pivothigh(high, sync_len, sync_len)
float pl_sw = ta.pivotlow(low, sync_len, sync_len)
if not na(ph_sw)
    swing_h := ph_sw
if not na(pl_sw)
    swing_l := pl_sw
bool cross_up = ta.crossover(close, swing_h)
bool cross_down = ta.crossunder(close, swing_l)
if not na(swing_h) and cross_up
    auto_trend := 1
if not na(swing_l) and cross_down
    auto_trend := -1
int final_trend = p1_connected ? p1_smc_trend : auto_trend
bgcolor(en_bg_trend ? (final_trend == 1 ? bg_bull_col : bg_bear_col) : na, title="Фон тренда")

var int bars_since_bos = 999
bars_since_bos := (p1_connected and p1_bos_trig != 0) ? 0 : math.min(bars_since_bos + 1, 999)

// ====================================================================================================================
// МОДУЛЬ 2.1: KDE RSI (логика не изменена)
// ====================================================================================================================
f_gaussian(float dist, float bw) => 1.0/math.sqrt(2.0*math.pi)*math.pow(math.e, -0.5*math.pow(dist/bw, 2.0))
f_uniform(float dist, float bw) => (math.abs(dist) > bw) ? 0.0 : 0.5
f_sigmoid(float dist, float bw) => 2.0/math.pi*(1.0/(math.pow(math.e, (dist/bw))+math.pow(math.e, -(dist/bw))))

f_kde(array<float> arr, string kernel, float bw, int steps) =>
    arrSize = arr.size()
    arrRange = arr.range()
    arrMin = arr.min()
    stepCount = arrRange / math.max(steps, 1)
    densityRange = array.new<float>(steps * 2)
    for i = 0 to (steps*2)-1
        densityRange.set(i, arrMin + i * stepCount)
    xArr = array.new<float>()
    yArr = array.new<float>()
    for i = 0 to densityRange.size()-1
        float temp = 0
        for j = 0 to arr.size()-1
            switch kernel
                "Gaussian" => temp += f_gaussian(densityRange.get(i)-arr.get(j), 1.0/bw)
                "Uniform" => temp += f_uniform(densityRange.get(i)-arr.get(j), 1.0/bw)
                "Sigmoid" => temp += f_sigmoid(densityRange.get(i)-arr.get(j), 1.0/bw)
        xArr.push(densityRange.get(i))
        yArr.push(1.0/math.max(arrSize,1)*temp)
    [xArr, yArr]

f_prefixSum(array<float> arr, int l, int r) => arr.get(r) - (l == 0 ? 0 : arr.get(l-1))

float kde_rsi = na
bool osc_kde_bull = false
bool osc_kde_bear = false
var array<float> highPivotRSIs = array.new<float>()
var array<float> lowPivotRSIs = array.new<float>()
var array<float> KDEHighX = array.new<float>()
var array<float> KDEHighY = array.new<float>()
var array<float> KDEHighYSum = array.new<float>()
var array<float> KDELowX = array.new<float>()
var array<float> KDELowY = array.new<float>()
var array<float> KDELowYSum = array.new<float>()
var bool in_kde_bull = false
var bool in_kde_bear = false

if en_mod_kde
    kde_rsi := ta.rsi(close, kde_rsi_len)
    float kde_hp = ta.pivothigh(high, kde_piv_len, kde_piv_len)
    float kde_lp = ta.pivotlow(low, kde_piv_len, kde_piv_len)
    float lowProb = 0.0
    float highProb = 0.0
    if not na(kde_hp)
        if highPivotRSIs.size() > 300
            highPivotRSIs.remove(0)
        highPivotRSIs.push(kde_rsi[kde_piv_len])
        [kx, ky] = f_kde(highPivotRSIs, kde_kernel, kde_bandw, kde_steps)
        KDEHighX := kx, KDEHighY := ky, KDEHighYSum.clear()
        float tH = 0.0
        for i = 0 to KDEHighY.size()-1
            tH += KDEHighY.get(i)
            KDEHighYSum.push(tH)
    if not na(kde_lp)
        if lowPivotRSIs.size() > 300
            lowPivotRSIs.remove(0)
        lowPivotRSIs.push(kde_rsi[kde_piv_len])
        [lx, ly] = f_kde(lowPivotRSIs, kde_kernel, kde_bandw, kde_steps)
        KDELowX := lx, KDELowY := ly, KDELowYSum.clear()
        float tL = 0.0
        for i = 0 to KDELowY.size()-1
            tL += KDELowY.get(i)
            KDELowYSum.push(tL)
    if highPivotRSIs.size() > 0 and KDEHighX.size() > 0
        int sL = array.binary_search_leftmost(KDEHighX, kde_rsi)
        int sR = array.binary_search_rightmost(KDEHighX, kde_rsi)
        int iL = math.max(0, math.min(sL, KDEHighX.size()-1))
        int iR = math.max(0, math.min(sR, KDEHighX.size()-1))
        int ni = (math.abs(kde_rsi-KDEHighX.get(iL)) < math.abs(kde_rsi-KDEHighX.get(iR))) ? iL : iR
        highProb := f_prefixSum(KDEHighYSum, 0, ni)
    if lowPivotRSIs.size() > 0 and KDELowX.size() > 0
        int sL = array.binary_search_leftmost(KDELowX, kde_rsi)
        int sR = array.binary_search_rightmost(KDELowX, kde_rsi)
        int iL = math.max(0, math.min(sL, KDELowX.size()-1))
        int iR = math.max(0, math.min(sR, KDELowX.size()-1))
        int ni = (math.abs(kde_rsi-KDELowX.get(iL)) < math.abs(kde_rsi-KDELowX.get(iR))) ? iL : iR
        lowProb := f_prefixSum(KDELowYSum, ni, KDELowYSum.size()-1)
    float act_thresh = kde_thresh == "High" ? 0.4 : kde_thresh == "Medium" ? 0.25 : 0.15
    bool curr_in_bull = KDELowY.size() > 0 and lowProb > array.get(KDELowYSum, KDELowYSum.size()-1) * (1.0 - act_thresh)
    bool curr_in_bear = KDEHighY.size() > 0 and highProb > array.get(KDEHighYSum, KDEHighYSum.size()-1) * (1.0 - act_thresh)
    osc_kde_bull := not curr_in_bull and in_kde_bull
    osc_kde_bear := not curr_in_bear and in_kde_bear
    in_kde_bull := curr_in_bull
    in_kde_bear := curr_in_bear

// ====================================================================================================================
// МОДУЛЬ 2.2: STOCHASTIC Z-SCORE
// ====================================================================================================================
bool osc_stoch_bull = false
bool osc_stoch_bear = false
float smoothed_scaled = na
if en_mod_stoch
    float stoch_basis = ta.sma(stoch_z_src, stoch_z_len)
    float stoch_stdev = ta.stdev(stoch_z_src, stoch_z_len)
    float zscore = stoch_stdev == 0 ? 0.0 : (stoch_z_src - stoch_basis) / stoch_stdev
    float highest_z = ta.highest(zscore, stoch_z_len)
    float lowest_z = ta.lowest(zscore, stoch_z_len)
    float range_z = highest_z - lowest_z
    float stochZ = range_z == 0 ? 50.0 : 100.0 * (zscore - lowest_z) / range_z
    float scaledSZ = (stochZ / 25.0) - 2.0
    smoothed_scaled := ta.hma(scaledSZ, stoch_z_len)
    float prev = nz(smoothed_scaled[1], 0.0)
    float ltm = nz(ta.alma(zscore, stoch_z_len, 0.0, 0.1), 0.0)
    osc_stoch_bull := ta.crossover(smoothed_scaled, prev) and prev < stoch_z_os and (stoch_strict ? ltm > 0 : true)
    osc_stoch_bear := ta.crossunder(smoothed_scaled, prev) and prev > stoch_z_ob and (stoch_strict ? ltm < 0 : true)

// ====================================================================================================================
// МОДУЛЬ 2.3: ADAPTIVE MACD DELUXE
// ====================================================================================================================
bool osc_macd_dlx_bull = false
bool osc_macd_dlx_bear = false
float dlx_macSeries = na
var float mac_dlx = 0.0
if en_mod_dlx
    float dlx_r = ta.correlation(close, bar_index, macd_dlx_r2)
    float dlx_detWgt = 0.5 + 0.5 * nz(math.pow(dlx_r, 2), 0.0)
    float dlx_fastK = 2.0 / (macd_dlx_fast + 1)
    float dlx_slowK = 2.0 / (macd_dlx_slow + 1)
    float dlx_blend = dlx_detWgt * (1-dlx_fastK) * (1-dlx_slowK) + (1-dlx_detWgt) * (1-dlx_fastK) / (1-dlx_slowK)
    mac_dlx := (close - nz(close[1], close)) * (dlx_fastK - dlx_slowK) + (2-dlx_fastK-dlx_slowK) * nz(mac_dlx[1], 0.0) - dlx_blend * nz(mac_dlx[2], 0.0)
    float dlx_hl_ema = ta.ema(high - low, macd_dlx_slow)
    dlx_macSeries := dlx_hl_ema == 0 ? 0.0 : (mac_dlx / dlx_hl_ema * 100.0)
    osc_macd_dlx_bull := ta.crossover(dlx_macSeries, macd_dlx_os)
    osc_macd_dlx_bear := ta.crossunder(dlx_macSeries, macd_dlx_ob)

// ====================================================================================================================
// МОДУЛЬ 2.4: ADVANCED CCI
// ====================================================================================================================
bool osc_cci_bull = false
bool osc_cci_bear = false
var float st_TrendUp = na
var float st_TrendDown = na
var int st_Trend = 1
if en_mod_cci
    float st_cci_val = ta.cci(close, cci_st_len)
    float st_Up = hl2 - (cci_st_factor * ta.atr(cci_st_pd))
    float st_Dn = hl2 + (cci_st_factor * ta.atr(cci_st_pd))
    st_TrendUp := nz(st_cci_val[1]) > 0 ? math.max(st_Up, nz(st_TrendUp, st_Up)) : st_Up
    st_TrendDown := nz(st_cci_val[1]) < 0 ? math.min(st_Dn, nz(st_TrendDown, st_Dn)) : st_Dn
    st_Trend := st_cci_val > 0 ? 1 : st_cci_val < 0 ? -1 : nz(st_Trend[1], 1)
    float st_tsl = st_Trend == 1 ? st_TrendUp : st_TrendDown
    float l3_typ = (high + low + close) / 3.0
    float l3_dev = ta.dev(l3_typ, cci_l3_len)
    float l3_cci_val = (l3_typ - ta.sma(l3_typ, cci_l3_len)) / (0.015 * math.max(l3_dev, 1e-10))
    float l3_ci_val = ta.ema(l3_cci_val, cci_l3_ci)
    osc_cci_bull := ta.crossover(close, st_tsl) or (ta.crossover(l3_cci_val, l3_ci_val) and l3_cci_val < 0)
    osc_cci_bear := ta.crossunder(close, st_tsl) or (ta.crossunder(l3_cci_val, l3_ci_val) and l3_cci_val > 0)

// ====================================================================================================================
// МОДУЛЬ 2.5: SMART MONEY ACTIVITY + CVD
// ====================================================================================================================
bool sm_act_bull = false
bool sm_act_bear = false
var array<float> sm_vols = array.new<float>()
var float cvd = 0.0
var array<float> cvd_hist_arr = array.new<float>()
bool cvd_bull_div = false
bool cvd_bear_div = false
bool sm_absorption = false
if en_mod_smact
    float[] lt_v = global_lt_v
    float[] lt_c = global_lt_c
    float[] lt_o = global_lt_o
    int res_size = array.size(lt_v)
    int sm_maximum = sm_act_zlen * math.max(1, res_size)
    if res_size > 0
        float bar_cvd = 0.0, float max_bull_vol = 0.0, float max_bear_vol = 0.0
        for i = 0 to res_size-1
            float v = array.get(lt_v, i)
            float c = array.get(lt_c, i)
            float o = array.get(lt_o, i)
            if c > o
                bar_cvd += v, max_bull_vol := math.max(max_bull_vol, v)
            else if c < o
                bar_cvd -= v, max_bear_vol := math.max(max_bear_vol, v)
        array.unshift(cvd_hist_arr, bar_cvd)
        if array.size(cvd_hist_arr) > 50
            array.pop(cvd_hist_arr)
        cvd := array.sum(cvd_hist_arr)
        if max_bull_vol > (ta.sma(volume, 50) * 0.5) and max_bear_vol > (ta.sma(volume, 50) * 0.5)
            sm_absorption := true
        cvd_bull_div := close < ta.sma(close, 10) and cvd > ta.sma(cvd, 10)
        cvd_bear_div := close > ta.sma(close, 10) and cvd < ta.sma(cvd, 10)
        for i = res_size-1 to 0
            array.unshift(sm_vols, array.get(lt_v, i))
        while array.size(sm_vols) > sm_maximum
            array.pop(sm_vols)
        float volsAvg = array.avg(sm_vols), float volsStdev = array.stdev(sm_vols)
        if volsStdev > 0
            float max_z = 0.0, int max_idx = -1
            for i = 0 to res_size-1
                float az = (array.get(lt_v, i) - volsAvg) / volsStdev
                if az > max_z
                    max_z := az, max_idx := i
            if max_z > sm_act_th and max_idx != -1
                float ic = array.get(lt_c, max_idx)
                float io = array.get(lt_o, max_idx)
                bool isBull = ic > io
                float bMin = math.min(open, close), float bMax = math.max(open, close)
                bool cls2 = math.abs(ic - close) < syminfo.mintick or (ic > bMin and ic < bMax)
                bool cls1 = (ic >= bMin*0.995 and ic <= bMax*1.005) and not cls2
                if cls2
                    if isBull
                        sm_act_bull := true
                    else
                        sm_act_bear := true
                else if cls1 and max_z > sm_act_th*1.3
                    if isBull
                        sm_act_bull := true
                    else
                        sm_act_bear := true

var int bars_since_sm_act_bull_N3 = 999
var int bars_since_sm_act_bear_N3 = 999
bars_since_sm_act_bull_N3 := sm_act_bull ? 0 : math.min(bars_since_sm_act_bull_N3+1, 999)
bars_since_sm_act_bear_N3 := sm_act_bear ? 0 : math.min(bars_since_sm_act_bear_N3+1, 999)

// ====================================================================================================================
// МОДУЛЬ 2.6: SMART MONEY INDEX
// ====================================================================================================================
bool sm_idx_bull = false
bool sm_idx_bear = false
float sm_net_index = na
if en_mod_smidx
    float safe_pvi = nz(ta.pvi, 1.0), float safe_nvi = nz(ta.nvi, 1.0)
    float sm_drsi = ta.rsi(safe_pvi - ta.ema(safe_pvi, 255), sm_idx_rr)
    float sm_srsi = ta.rsi(safe_nvi - ta.ema(safe_nvi, 255), sm_idx_rr)
    float dr_safe = sm_drsi == 0 ? 1e-10 : sm_drsi
    float di_safe = (100.0-sm_drsi) == 0 ? 1e-10 : (100.0-sm_drsi)
    float sb = math.sum(sm_srsi/dr_safe, sm_idx_x)
    float ss = math.sum((100.0-sm_srsi)/di_safe, sm_idx_x)
    float pk = ta.highest(math.max(sb, ss), sm_idx_peak)
    float pks = pk == 0 ? 1e-10 : pk
    sm_net_index := (sb/pks) - (ss/pks)
    if sm_idx_strict
        sm_idx_bull := ta.crossover(sm_net_index, sm_idx_thr)
        sm_idx_bear := ta.crossunder(sm_net_index, -sm_idx_thr)
    else
        sm_idx_bull := sm_net_index > sm_idx_thr and sm_net_index > nz(sm_net_index[1])
        sm_idx_bear := sm_net_index < -sm_idx_thr and sm_net_index < nz(sm_net_index[1])

// ====================================================================================================================
// МОДУЛЬ 2.7: SMART MONEY INTEREST
// ====================================================================================================================
bool sm_int_bull = false
bool sm_int_bear = false
if en_mod_smint
    float d = ta.pvi - ta.ema(ta.pvi, 255)
    float s = ta.nvi - ta.ema(ta.nvi, 255)
    float dr = ta.rsi(d, sm_int_rr), float sr = ta.rsi(s, sm_int_rr)
    float dr_s = dr == 0 ? 1e-10 : dr, float sr_s = sr == 0 ? 1e-10 : sr
    float sumb = math.sum(sr/dr_s, sm_int_x)
    float sums = math.sum(dr/sr_s, sm_int_x)
    float pkb = ta.highest(sumb, sm_int_peak)
    float pks_ = ta.highest(sums, sm_int_peak)
    sm_int_bull := sumb/(pkb==0?1e-10:pkb) > sm_int_thr
    sm_int_bear := sums/(pks_==0?1e-10:pks_) > sm_int_thr

bool sm_all3_bull = en_mod_smact and en_mod_smidx and en_mod_smint and sm_act_bull and sm_idx_bull and sm_int_bull
bool sm_all3_bear = en_mod_smact and en_mod_smidx and en_mod_smint and sm_act_bear and sm_idx_bear and sm_int_bear

// ====================================================================================================================
// МОДУЛЬ 2.8: MULTI-INDICATOR DIVERGENCE
// ====================================================================================================================
bool osc_mdiv_bull = false
bool osc_mdiv_bear = false
int total_mdiv_bull = 0
int total_mdiv_bear = 0
var int[] mdiv_ph_pos = array.new<int>(10, 0)
var int[] mdiv_pl_pos = array.new<int>(10, 0)
var float[] mdiv_ph_val = array.new<float>(10, 0.0)
var float[] mdiv_pl_val = array.new<float>(10, 0.0)
bool chk_reg = mdiv_type == "Regular" or mdiv_type == "Regular/Hidden"
bool chk_hid = mdiv_type == "Hidden" or mdiv_type == "Regular/Hidden"

f_check_pos_div(series float src, int cond_type) =>
    int div_found = 0
    if src > src[1] or close > close[1]
        for x = 0 to 9
            int len = bar_index - array.get(mdiv_pl_pos, x) + mdiv_prd
            if array.get(mdiv_pl_pos, x) == 0 or len > mdiv_maxb
                break
            if len > 5
                bool c1 = (cond_type == 1 and src[1] > src[len] and close[1] < array.get(mdiv_pl_val, x))
                bool c2 = (cond_type == 2 and src[1] < src[len] and close[1] > array.get(mdiv_pl_val, x))
                if c1 or c2
                    float s1 = (src[1]-src[len])/(len-1), float v1 = src[1]-s1
                    float s2 = (close[1]-close[len])/(len-1), float v2 = close[1]-s2
                    bool ok = true
                    for y = 2 to len-1
                        if src[y] < v1 or close[y] < v2
                            ok := false, break
                        v1 -= s1, v2 -= s2
                    if ok
                        div_found := 1, break
    div_found

f_check_neg_div(series float src, int cond_type) =>
    int div_found = 0
    if src < src[1] or close < close[1]
        for x = 0 to 9
            int len = bar_index - array.get(mdiv_ph_pos, x) + mdiv_prd
            if array.get(mdiv_ph_pos, x) == 0 or len > mdiv_maxb
                break
            if len > 5
                bool c1 = (cond_type == 1 and src[1] < src[len] and close[1] > array.get(mdiv_ph_val, x))
                bool c2 = (cond_type == 2 and src[1] > src[len] and close[1] < array.get(mdiv_ph_val, x))
                if c1 or c2
                    float s1 = (src[1]-src[len])/(len-1), float v1 = src[1]-s1
                    float s2 = (close[1]-close[len])/(len-1), float v2 = close[1]-s2
                    bool ok = true
                    for y = 2 to len-1
                        if src[y] > v1 or close[y] > v2
                            ok := false, break
                        v1 -= s1, v2 -= s2
                    if ok
                        div_found := 1, break
    div_found

f_add_div(series float src, bool en) =>
    int b = 0, int br = 0
    if en
        if chk_reg
            b += f_check_pos_div(src, 1)
            br += f_check_neg_div(src, 1)
        if chk_hid
            b += f_check_pos_div(src, 2)
            br += f_check_neg_div(src, 2)
    [b, br]

if en_mod_mdiv
    float mdiv_ph = ta.pivothigh(close, mdiv_prd, mdiv_prd)
    float mdiv_pl = ta.pivotlow(close, mdiv_prd, mdiv_prd)
    if not na(mdiv_ph)
        array.unshift(mdiv_ph_pos, bar_index), array.unshift(mdiv_ph_val, mdiv_ph)
        array.pop(mdiv_ph_pos), array.pop(mdiv_ph_val)
    if not na(mdiv_pl)
        array.unshift(mdiv_pl_pos, bar_index), array.unshift(mdiv_pl_val, mdiv_pl)
        array.pop(mdiv_pl_pos), array.pop(mdiv_pl_val)
    [b1,br1] = f_add_div(g_rsi, true), [b2,br2] = f_add_div(g_macdL, true)
    [b3,br3] = f_add_div(g_macdH, true), [b4,br4] = f_add_div(g_stc, true)
    [b5,br5] = f_add_div(g_cci, true), [b6,br6] = f_add_div(g_mom, true)
    [b7,br7] = f_add_div(g_obv, true), [b8,br8] = f_add_div(g_vwm, true)
    [b9,br9] = f_add_div(g_cmf, true), [b10,br10] = f_add_div(g_mfi, true)
    total_mdiv_bull := b1+b2+b3+b4+b5+b6+b7+b8+b9+b10
    total_mdiv_bear := br1+br2+br3+br4+br5+br6+br7+br8+br9+br10
    osc_mdiv_bull := total_mdiv_bull >= mdiv_limit
    osc_mdiv_bear := total_mdiv_bear >= mdiv_limit

bool osc_mdiv_multi_bull = osc_mdiv_bull and total_mdiv_bull >= 3
bool osc_mdiv_multi_bear = osc_mdiv_bear and total_mdiv_bear >= 3

// ====================================================================================================================
// МОДУЛЬ 2.9: PETERO NON-REPAINT DIVERGENCE
// ====================================================================================================================
bool osc_peter_bull = false
bool osc_peter_bear = false

f_petero_div(series float _osc, int _lbL, int _lbR, int _rL, int _rU) =>
    bool pl = not na(ta.pivotlow(_osc, _lbL, _lbR))
    bool ph = not na(ta.pivothigh(_osc, _lbL, _lbR))
    float opl = ta.valuewhen(pl, _osc[_lbR], 1), float cpl = ta.valuewhen(pl, low[_lbR], 1)
    float oph = ta.valuewhen(ph, _osc[_lbR], 1), float cph = ta.valuewhen(ph, high[_lbR], 1)
    int ls = ta.barssince(pl[1]), int hs = ta.barssince(ph[1])
    bool lr = ls >= _rL and ls <= _rU, bool hr = hs >= _rL and hs <= _rU
    int breg = (low[_lbR] < cpl and _osc[_lbR] > opl and lr and pl) ? 1 : 0
    int bhid = (low[_lbR] > cpl and _osc[_lbR] < opl and lr and pl) ? 1 : 0
    int sreg = (high[_lbR] > cph and _osc[_lbR] < oph and hr and ph) ? 1 : 0
    int shid = (high[_lbR] < cph and _osc[_lbR] > oph and hr and ph) ? 1 : 0
    [breg+bhid, sreg+shid]

if en_mod_peter
    int pt_b = 0, int pt_s = 0
    [b1,s1] = f_petero_div(g_rsi, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b1, pt_s+=s1
    [b2,s2] = f_petero_div(g_macdL, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b2, pt_s+=s2
    [b3,s3] = f_petero_div(g_macdH, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b3, pt_s+=s3
    [b4,s4] = f_petero_div(g_mom, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b4, pt_s+=s4
    [b5,s5] = f_petero_div(g_cci, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b5, pt_s+=s5
    [b6,s6] = f_petero_div(g_p_obv, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b6, pt_s+=s6
    [b7,s7] = f_petero_div(g_stc, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b7, pt_s+=s7
    [b8,s8] = f_petero_div(g_p_diosc, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b8, pt_s+=s8
    [b9,s9] = f_petero_div(g_vwm, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b9, pt_s+=s9
    [b10,s10] = f_petero_div(g_cmf, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b10, pt_s+=s10
    osc_peter_bull := pt_b >= peter_limit
    osc_peter_bear := pt_s >= peter_limit

// ====================================================================================================================
// МОДУЛЬ 3.0: TRADINGFINDER FRACTAL DIV
// ====================================================================================================================
bool osc_tfdiv_bull = false
bool osc_tfdiv_bear = false
float tf_aoH = ta.sma(hl2, 5) - ta.sma(hl2, 34)
float tf_rsiH = ta.rsi(close, 14) - 50
float tf_hist = tfdiv_type == "MACD" ? g_macdH : tfdiv_type == "AO" ? tf_aoH : tf_rsiH
float tf_ema = ta.ema(close, 50)
bool tf_up_frac = not na(ta.pivothigh(tfdiv_n, tfdiv_n)) and close[tfdiv_n] > tf_ema
bool tf_dn_frac = not na(ta.pivotlow(tfdiv_n, tfdiv_n)) and close[tfdiv_n] < tf_ema
float t_h_lp = ta.valuewhen(tf_up_frac, high[tfdiv_n], 0)
float t_h_pp = ta.valuewhen(tf_up_frac, high[tfdiv_n], 1)
float t_h_lh = ta.valuewhen(tf_up_frac, tf_hist[tfdiv_n], 0)
float t_h_ph = ta.valuewhen(tf_up_frac, tf_hist[tfdiv_n], 1)
int t_h_lb = ta.valuewhen(tf_up_frac, bar_index[tfdiv_n], 0)
int t_h_pb = ta.valuewhen(tf_up_frac, bar_index[tfdiv_n], 1)
float t_l_lp = ta.valuewhen(tf_dn_frac, low[tfdiv_n], 0)
float t_l_pp = ta.valuewhen(tf_dn_frac, low[tfdiv_n], 1)
float t_l_lh = ta.valuewhen(tf_dn_frac, tf_hist[tfdiv_n], 0)
float t_l_ph = ta.valuewhen(tf_dn_frac, tf_hist[tfdiv_n], 1)
int t_l_lb = ta.valuewhen(tf_dn_frac, bar_index[tfdiv_n], 0)
int t_l_pb = ta.valuewhen(tf_dn_frac, bar_index[tfdiv_n], 1)
if en_mod_tfdiv
    bool bc = t_h_lh > 0 and t_h_ph > 0 and (t_h_lb+30 > bar_index) and (t_h_lb-t_h_pb < 30)
    osc_tfdiv_bear := ta.change(t_h_lp) != 0 and bc and t_h_lp > t_h_pp and t_h_lh < t_h_ph
    bool bc2 = t_l_lh < 0 and t_l_ph < 0 and (t_l_lb+30 > bar_index) and (t_l_lb-t_l_pb < 30)
    osc_tfdiv_bull := ta.change(t_l_lp) != 0 and bc2 and t_l_lp < t_l_pp and t_l_lh > t_l_ph

// ====================================================================================================================
// МОДУЛЬ 3.1: SMT DIVERGENCES
// ====================================================================================================================
bool osc_smt_bull = false
bool osc_smt_bear = false

f_get_smt_div(bool is_ph, float y2, float sym_y2) =>
    var float y1 = na, var float sy1 = na, var int cnt = 0, var int ldb = 0
    if bar_index - ldb > 50
        cnt := 0
    if y2 != y2[1] and sym_y2 != sym_y2[1]
        if not na(y1) and not na(sy1) and (y2-y1)*(sym_y2-sy1) < 0
            cnt += 1, ldb := bar_index
        sy1 := sym_y2, y1 := y2
    else if (is_ph and y2 > y2[1]) or (not is_ph and y2 < y2[1])
        sy1 := na, y1 := y2
    cnt

if en_mod_smt
    float smt_ph = fixnan(ta.pivothigh(smt_len, smt_len))
    float smt_pl = fixnan(ta.pivotlow(smt_len, smt_len))
    float sph1 = fixnan(ta.pivothigh(s_h1, smt_len, smt_len))
    float spl1 = fixnan(ta.pivotlow(s_l1, smt_len, smt_len))
    float sph2 = fixnan(ta.pivothigh(s_h2, smt_len, smt_len))
    float spl2 = fixnan(ta.pivotlow(s_l2, smt_len, smt_len))
    int ph1 = f_get_smt_div(true, smt_ph, sph1), int pl1 = f_get_smt_div(false, smt_pl, spl1)
    int ph2 = f_get_smt_div(true, smt_ph, sph2), int pl2 = f_get_smt_div(false, smt_pl, spl2)
    if smt_ph != nz(smt_ph[1]) and ((smt_use1 and ph1 > nz(ph1[1])) or (smt_use2 and ph2 > nz(ph2[1])))
        osc_smt_bear := true
    if smt_pl != nz(smt_pl[1]) and ((smt_use1 and pl1 > nz(pl1[1])) or (smt_use2 and pl2 > nz(pl2[1])))
        osc_smt_bull := true

// ====================================================================================================================
// МОДУЛЬ 3.2: СВЕЧНОЙ АНАЛИЗ — РАСШИРЕН (+10 новых паттернов: Маруботсу×2, Просвет/Тёмное Облако,
// Внешний Бар×2, Бэлт-Холд×2, Три Внутри×2, Волчок)
// ====================================================================================================================
float c_upper = ta.highest(cndl_minor_len)
float c_lower = ta.lowest(cndl_minor_len)
var int minor_dir = 0
if high == c_upper and minor_dir != 1
    minor_dir := 1
if low == c_lower and minor_dir != -1
    minor_dir := -1

bool rc = close < open
bool gc = close > open
float cand_top = math.max(open, close), float cand_bot = math.min(open, close)
float hl_width = high - low, float bod_width = cand_top - cand_bot
float hw_per = hl_width == 0 ? 0 : ((high - cand_top) / hl_width) * 100
float lw_per = hl_width == 0 ? 0 : ((cand_bot - low) / hl_width) * 100
float b_per = hl_width == 0 ? 0 : (bod_width / hl_width) * 100
bool is_doji = math.round_to_mintick(close) == math.round_to_mintick(open)
bool is_minor_bear = minor_dir < 0
bool is_minor_bull = minor_dir > 0

// ── Существующие паттерны LuxAlgo (логика не изменена) ──
bool p_hammer = lw_per>(b_per*1.5) and b_per<60 and hw_per<8 and not is_doji and is_minor_bear
bool p_ihammer = hw_per>(b_per*1.5) and b_per<60 and lw_per<8 and not is_doji and is_minor_bear
bool p_rising_3 = gc[4] and b_per[4]>40 and rc[3] and cand_top[3]<=high[4] and cand_bot[3]>=low[4] and rc[2] and cand_top[2]<=high[4] and cand_bot[2]>=low[4] and rc[1] and cand_top[1]<=high[4] and cand_bot[1]>=low[4] and gc and close>high[4] and b_per>40 and is_minor_bull[4]
bool p_bull_eng = rc[1] and gc and bod_width>(bod_width[1]*0.4) and open<close[1] and cand_top>cand_top[1] and not p_rising_3 and not is_doji[1] and is_minor_bear
bool p_3ws = gc[2] and b_per[2]>55 and gc[1] and b_per[1]>55 and cand_bot[1]>=cand_bot[2] and cand_bot[1]<=cand_top[2] and close[1]>high[2] and gc and b_per>55 and cand_bot>=cand_bot[1] and cand_bot<=cand_top[1] and close>high[1] and is_minor_bear[2]
bool p_mstar = rc[2] and b_per[2]>65 and rc[1] and bod_width[1]<(bod_width[2]*0.6) and open[1]<close[2] and gc and close>hl2[2] and is_minor_bear[2]
bool p_bull_har = gc and high<=cand_top[1] and low>=cand_bot[1] and rc[1] and is_minor_bear[1]
bool p_tw_bot = math.abs(low-low[1])<=syminfo.mintick*3 and gc and rc[1] and is_minor_bear[1]
bool p_sstar = hw_per>(b_per*1.5) and b_per<60 and lw_per<8 and not is_doji and is_minor_bull
bool p_hman = lw_per>(b_per*1.5) and b_per<60 and hw_per<8 and not is_doji and is_minor_bull
bool p_falling_3 = rc[4] and b_per[4]>40 and gc[3] and cand_top[3]<=high[4] and cand_bot[3]>=low[4] and gc[2] and cand_top[2]<=high[4] and cand_bot[2]>=low[4] and gc[1] and cand_top[1]<=high[4] and cand_bot[1]>=low[4] and rc and close<low[4] and b_per>40 and is_minor_bear[4]
bool p_bear_eng = gc[1] and rc and bod_width>(bod_width[1]*0.4) and open>close[1] and cand_bot<cand_bot[1] and not p_falling_3 and not is_doji[1] and is_minor_bull
bool p_3bc = rc[2] and b_per[2]>55 and rc[1] and b_per[1]>55 and cand_top[1]<=cand_top[2] and cand_top[1]>=cand_bot[2] and close[1]<low[2] and rc and b_per>55 and cand_top<=cand_top[1] and cand_top>=cand_bot[1] and close<low[1] and is_minor_bull[2]
bool p_estar = gc[2] and b_per[2]>65 and gc[1] and bod_width[1]<(bod_width[2]*0.6) and open[1]>close[2] and rc and close<hl2[2] and is_minor_bull[2]
bool p_bear_har = rc and high<=cand_top[1] and low>=cand_bot[1] and gc[1] and is_minor_bull[1]
bool p_tw_top = math.abs(high-high[1])<=syminfo.mintick*3 and rc and gc[1] and is_minor_bull[1]

// ── НОВЫЕ ПАТТЕРНЫ (10 шт.) ──
bool p_marub_bull = gc and b_per > 95 and is_minor_bear
bool p_marub_bear = rc and b_per > 95 and is_minor_bull
bool p_piercing = rc[1] and b_per[1]>50 and gc and open<low[1] and close>(cand_top[1]+cand_bot[1])/2 and close<cand_top[1] and is_minor_bear[1]
bool p_darkcloud = gc[1] and b_per[1]>50 and rc and open>high[1] and close<(cand_top[1]+cand_bot[1])/2 and close>cand_bot[1] and is_minor_bull[1]
bool p_outside_bull = high>high[1] and low<low[1] and gc and is_minor_bear
bool p_outside_bear = high>high[1] and low<low[1] and rc and is_minor_bull
bool p_belthold_bull = gc and math.abs(open-low)<=syminfo.mintick*2 and b_per>70 and is_minor_bear
bool p_belthold_bear = rc and math.abs(open-high)<=syminfo.mintick*2 and b_per>70 and is_minor_bull
bool p_3in_up = p_bull_har[1] and gc and close>cand_top[2] and is_minor_bear[2]
bool p_3in_dn = p_bear_har[1] and rc and close<cand_bot[2] and is_minor_bull[2]
bool p_spinning = b_per<35 and hw_per>20 and lw_per>20 and not is_doji

bool cndl_bull = false
bool cndl_bear = false
bool is_neutral = false
string cndl_bull_name = ""
string cndl_bear_name = ""
string cndl_neut_name = ""

if en_mod_cndl
    if en_marub_bull and p_marub_bull
        cndl_bull := true, cndl_bull_name := "Маруботсу Бычий"
    else if en_belthold_bull and p_belthold_bull
        cndl_bull := true, cndl_bull_name := "Бычий Бэлт-Холд"
    else if en_piercing and p_piercing
        cndl_bull := true, cndl_bull_name := "Просвет в Облаках"
    else if en_3in_up and p_3in_up
        cndl_bull := true, cndl_bull_name := "Три Внутри Вверх"
    else if en_outside_bull and p_outside_bull
        cndl_bull := true, cndl_bull_name := "Бычий Внешний Бар"
    else if en_hammer and p_hammer
        cndl_bull := true, cndl_bull_name := "Молот"
    else if en_ihammer and p_ihammer
        cndl_bull := true, cndl_bull_name := "Перевёрнутый Молот"
    else if en_bull_eng and p_bull_eng
        cndl_bull := true, cndl_bull_name := "Бычье Поглощение"
    else if en_r3 and p_rising_3
        cndl_bull := true, cndl_bull_name := "Метод 3 Поднимающихся"
    else if en_3ws and p_3ws
        cndl_bull := true, cndl_bull_name := "3 Белых Солдата"
    else if en_mstar and p_mstar
        cndl_bull := true, cndl_bull_name := "Утренняя Звезда"
    else if en_bull_har and p_bull_har
        cndl_bull := true, cndl_bull_name := "Бычье Харами"
    else if en_tw_bot and p_tw_bot
        cndl_bull := true, cndl_bull_name := "Пинцет Дно"
    if en_marub_bear and p_marub_bear
        cndl_bear := true, cndl_bear_name := "Маруботсу Медвежий"
    else if en_belthold_bear and p_belthold_bear
        cndl_bear := true, cndl_bear_name := "Медвежий Бэлт-Холд"
    else if en_darkcloud and p_darkcloud
        cndl_bear := true, cndl_bear_name := "Тёмное Облако"
    else if en_3in_dn and p_3in_dn
        cndl_bear := true, cndl_bear_name := "Три Внутри Вниз"
    else if en_outside_bear and p_outside_bear
        cndl_bear := true, cndl_bear_name := "Медвежий Внешний Бар"
    else if en_sstar and p_sstar
        cndl_bear := true, cndl_bear_name := "Падающая Звезда"
    else if en_hman and p_hman
        cndl_bear := true, cndl_bear_name := "Повешенный"
    else if en_bear_eng and p_bear_eng
        cndl_bear := true, cndl_bear_name := "Медвежье Поглощение"
    else if en_f3 and p_falling_3
        cndl_bear := true, cndl_bear_name := "Метод 3 Падающих"
    else if en_3bc and p_3bc
        cndl_bear := true, cndl_bear_name := "3 Чёрные Вороны"
    else if en_estar and p_estar
        cndl_bear := true, cndl_bear_name := "Вечерняя Звезда"
    else if en_bear_har and p_bear_har
        cndl_bear := true, cndl_bear_name := "Медвежье Харами"
    else if en_tw_top and p_tw_top
        cndl_bear := true, cndl_bear_name := "Пинцет Вершина"
    if en_doji and is_doji and not cndl_bull and not cndl_bear
        is_neutral := true, cndl_neut_name := "Доджи (Нейтраль)"
    else if en_spinning and p_spinning and not cndl_bull and not cndl_bear
        is_neutral := true, cndl_neut_name := "Волчок (Нейтраль)"

plotshape(en_mod_cndl and cndl_show_lbl and cndl_bull, "Бычий паттерн", shape.triangleup, location.belowbar, cndl_bull_col, text="", size=size.tiny)
plotshape(en_mod_cndl and cndl_show_lbl and cndl_bear, "Медвежий паттерн", shape.triangledown, location.abovebar, cndl_bear_col, text="", size=size.tiny)
plotshape(en_mod_cndl and cndl_show_lbl and is_neutral, "Нейтральный", shape.xcross, location.abovebar, cndl_neut_col, text="", size=size.tiny)
if en_mod_cndl and cndl_show_lbl
    if cndl_bull
        label.new(bar_index, low - g_cndl_atr*0.2, text=cndl_bull_name, style=label.style_label_up, color=color.new(color.white,100), textcolor=cndl_bull_col, size=get_size(cndl_lbl_size))
    if cndl_bear
        label.new(bar_index, high + g_cndl_atr*0.2, text=cndl_bear_name, style=label.style_label_down, color=color.new(color.white,100), textcolor=cndl_bear_col, size=get_size(cndl_lbl_size))
    if is_neutral
        label.new(bar_index, high + g_cndl_atr*0.2, text=cndl_neut_name, style=label.style_label_down, color=color.new(color.white,100), textcolor=cndl_neut_col, size=get_size(cndl_lbl_size))
barcolor(en_mod_cndl and cndl_bar_col ? (cndl_bull ? cndl_bull_col : cndl_bear ? cndl_bear_col : is_neutral ? cndl_neut_col : na) : na)

// ====================================================================================================================
// ТАЙМЕРЫ СОБЫТИЙ P1 (логика не изменена)
// ====================================================================================================================
var int bars_since_choch_bull = 999
var int bars_since_choch_bear = 999
var int bars_since_hm_bull = 999
var int bars_since_hm_bear = 999
var int bars_since_sweep_bull = 999
var int bars_since_sweep_bear = 999
var int bars_since_sdinv_bull = 999
var int bars_since_sdinv_bear = 999
var int bars_since_ob_touch_bull = 999
var int bars_since_ob_touch_bear = 999
var int bars_since_disp_bull = 999
var int bars_since_disp_bear = 999
var int bars_since_zone_conf_bull = 999
var int bars_since_zone_conf_bear = 999
var int bars_since_choch_sw_bull = 999
var int bars_since_choch_sw_bear = 999

bars_since_choch_bull := (p1_connected and p1_choch_src == 1) ? 0 : math.min(bars_since_choch_bull+1, 999)
bars_since_choch_bear := (p1_connected and p1_choch_src == -1) ? 0 : math.min(bars_since_choch_bear+1, 999)
bars_since_hm_bull := (p1_connected and p1_hm_src == 1) ? 0 : math.min(bars_since_hm_bull+1, 999)
bars_since_hm_bear := (p1_connected and p1_hm_src == -1) ? 0 : math.min(bars_since_hm_bear+1, 999)
bars_since_sweep_bull := (p1_connected and p1_sweep_src == 1) ? 0 : math.min(bars_since_sweep_bull+1, 999)
bars_since_sweep_bear := (p1_connected and p1_sweep_src == -1) ? 0 : math.min(bars_since_sweep_bear+1, 999)
bars_since_sdinv_bull := (p1_connected and p1_sdinv_src == 1) ? 0 : math.min(bars_since_sdinv_bull+1, 999)
bars_since_sdinv_bear := (p1_connected and p1_sdinv_src == -1) ? 0 : math.min(bars_since_sdinv_bear+1, 999)
bars_since_ob_touch_bull := (p1_connected and p1_ob_touch_src == 1) ? 0 : math.min(bars_since_ob_touch_bull+1, 999)
bars_since_ob_touch_bear := (p1_connected and p1_ob_touch_src == -1) ? 0 : math.min(bars_since_ob_touch_bear+1, 999)
bars_since_disp_bull := (p1_connected and p1_disp_src == 1) ? 0 : math.min(bars_since_disp_bull+1, 999)
bars_since_disp_bear := (p1_connected and p1_disp_src == -1) ? 0 : math.min(bars_since_disp_bear+1, 999)
bars_since_zone_conf_bull := (p1_connected and p1_zone_conf_bull_src == 1) ? 0 : math.min(bars_since_zone_conf_bull+1, 999)
bars_since_zone_conf_bear := (p1_connected and p1_zone_conf_bear_src == 1) ? 0 : math.min(bars_since_zone_conf_bear+1, 999)
bars_since_choch_sw_bull := (p1_connected and p1_choch_sw_bull_src == 1) ? 0 : math.min(bars_since_choch_sw_bull+1, 999)
bars_since_choch_sw_bear := (p1_connected and p1_choch_sw_bear_src == 1) ? 0 : math.min(bars_since_choch_sw_bear+1, 999)

// ====================================================================================================================
// P1 СТРУКТУРНЫЕ БУЛЕВЫ (логика не изменена)
// ====================================================================================================================
bool b_smc_bull = p1_connected ? p1_smc_trend == 1 : false
bool b_smc_bear = p1_connected ? p1_smc_trend == -1 : false
bool b_ob_bull = p1_connected ? p1_ob_signal == 1 : false
bool b_ob_bear = p1_connected ? p1_ob_signal == -1 : false
bool b_sd_bull = p1_connected ? p1_sd_zone == 1 : false
bool b_sd_bear = p1_connected ? p1_sd_zone == -1 : false
bool b_fvg_bull = p1_connected ? p1_fvg_dir == 1 : false
bool b_fvg_bear = p1_connected ? p1_fvg_dir == -1 : false
bool b_bos_bull = p1_connected ? (bars_since_bos <= bos_bars_ok and p1_smc_trend == 1) : false
bool b_bos_bear = p1_connected ? (bars_since_bos <= bos_bars_ok and p1_smc_trend == -1) : false
bool b_bb_bull = p1_bb_signal == 1
bool b_bb_bear = p1_bb_signal == -1
bool b_hm_bull = p1_hm_signal == 1
bool b_hm_bear = p1_hm_signal == -1
bool b_sdinv_bull = bars_since_sdinv_bull <= 2
bool b_sdinv_bear = bars_since_sdinv_bear <= 2
bool b_sweep_bull = p1_sweep_signal == 1
bool b_sweep_bear = p1_sweep_signal == -1
bool b_choch_bull = p1_choch_signal == 1
bool b_choch_bear = p1_choch_signal == -1
bool b_ob_fresh_bull = bars_since_ob_touch_bull <= 2
bool b_ob_fresh_bear = bars_since_ob_touch_bear <= 2
bool b_disp_bull = bars_since_disp_bull <= 2
bool b_disp_bear = bars_since_disp_bear <= 2
bool b_fvg_precise_bull = p1_connected and is_conn(p1_fvg_top_src) and is_conn(p1_fvg_bot_src) and not na(p1_fvg_top) and not na(p1_fvg_bot) and close<=p1_fvg_top and close>=p1_fvg_bot and p1_fvg_dir == 1
bool b_fvg_precise_bear = p1_connected and is_conn(p1_fvg_top_src) and is_conn(p1_fvg_bot_src) and not na(p1_fvg_top) and not na(p1_fvg_bot) and close<=p1_fvg_top and close>=p1_fvg_bot and p1_fvg_dir == -1
bool b_fvg_poc_bull = p1_connected and p1_fvg_dir == 1
bool b_fvg_poc_bear = p1_connected and p1_fvg_dir == -1
bool b_zone_conf_bull = bars_since_zone_conf_bull <= 4
bool b_zone_conf_bear = bars_since_zone_conf_bear <= 4
bool b_choch_sw_bull = bars_since_choch_sw_bull <= 2
bool b_choch_sw_bear = bars_since_choch_sw_bear <= 2
bool b_ob_sd_bull = p1_ob_sd_bull
bool b_ob_sd_bear = p1_ob_sd_bear
bool b_ob_virgin_bull = is_conn(p1_ob_touch_cnt_bull_src) and p1_ob_touch_cnt_bull <= 1
bool b_ob_virgin_bear = is_conn(p1_ob_touch_cnt_bear_src) and p1_ob_touch_cnt_bear <= 1
bool b_ob_touch_fresh1_bull = is_conn(p1_ob_touch_cnt_bull_src) and p1_ob_touch_cnt_bull == 1
bool b_ob_touch_fresh1_bear = is_conn(p1_ob_touch_cnt_bear_src) and p1_ob_touch_cnt_bear == 1
bool b_master_bull = p1_connected and p1_master == 1
bool b_master_bear = p1_connected and p1_master == -1
bool b_conf_bull_ok = p1_connected and p1_conf_bull >= 7
bool b_conf_bear_ok = p1_connected and p1_conf_bear >= 7
bool b_candle_inside_ob_bull = (b_ob_bull) and cndl_bull
bool b_candle_inside_ob_bear = (b_ob_bear) and cndl_bear

// ====================================================================================================================
// OTE РАСЧЕТЫ (логика не изменена)
// ====================================================================================================================
var float recent_swing_h = na
var float recent_swing_l = na
if p1_connected and (p1_choch_src != 0 or p1_bos_trig != 0)
    recent_swing_h := high, recent_swing_l := low
else
    recent_swing_h := math.max(nz(recent_swing_h, high), high)
    recent_swing_l := math.min(nz(recent_swing_l, low), low)

float ote_swing_h = is_conn(p1_swing_h_src) ? p1_swing_h : recent_swing_h
float ote_swing_l = is_conn(p1_swing_l_src) ? p1_swing_l : recent_swing_l
float ote_range = nz(ote_swing_h) - nz(ote_swing_l)
float ote_long_top = nz(ote_swing_h) - (ote_range*0.618)
float ote_long_bot = nz(ote_swing_h) - (ote_range*0.786)
float disc_long_top = nz(ote_swing_h) - (ote_range*0.5)
float ote_short_bot = nz(ote_swing_l) + (ote_range*0.618)
float ote_short_top = nz(ote_swing_l) + (ote_range*0.786)
float prem_short_bot = nz(ote_swing_l) + (ote_range*0.5)
int ote_score_bull = (ote_range>0 and close<=ote_long_top and close>=ote_long_bot) ? 2 : (ote_range>0 and close<disc_long_top) ? 1 : 0
int ote_score_bear = (ote_range>0 and close>=ote_short_bot and close<=ote_short_top) ? 2 : (ote_range>0 and close>prem_short_bot) ? 1 : 0
if p1_ote_zone == 1
    ote_score_bull := math.max(ote_score_bull, 2)
else if p1_ote_zone == -1
    ote_score_bear := math.max(ote_score_bear, 2)
bool b_pd_bull = p1_connected ? (ote_score_bull >= 1) : false
bool b_pd_bear = p1_connected ? (ote_score_bear >= 1) : false

// ====================================================================================================================
// AVWAP БУЛЕВЫ (логика не изменена)
// ====================================================================================================================
bool b_avwap_bull = is_conn(p1_avwap_fast_src) and not na(p1_avwap_fast) ? (close>p1_avwap_fast) : (is_conn(p1_avwap_src) and not na(p1_avwap) ? close>p1_avwap : false)
bool b_avwap_bear = is_conn(p1_avwap_fast_src) and not na(p1_avwap_fast) ? (close<p1_avwap_fast) : (is_conn(p1_avwap_src) and not na(p1_avwap) ? close<p1_avwap : false)
bool b_avwap_cross_bull = is_conn(p1_avwap_fast_src) and not na(p1_avwap_fast) ? ta.crossover(close, p1_avwap_fast) : (is_conn(p1_avwap_src) and not na(p1_avwap) ? ta.crossover(close, p1_avwap) : false)
bool b_avwap_cross_bear = is_conn(p1_avwap_fast_src) and not na(p1_avwap_fast) ? ta.crossunder(close, p1_avwap_fast) : (is_conn(p1_avwap_src) and not na(p1_avwap) ? ta.crossunder(close, p1_avwap) : false)

// ====================================================================================================================
// IN_POI — гейтвей для MTF каскада (логика не изменена)
// ====================================================================================================================
bool in_poi_bull = b_ob_bull or b_sd_bull or b_fvg_precise_bull or ote_score_bull >= 2
bool in_poi_bear = b_ob_bear or b_sd_bear or b_fvg_precise_bear or ote_score_bear >= 2
int mtf_state_bull = (not in_poi_required or in_poi_bull) ? mtf_state_raw_bull : 0
int mtf_state_bear = (not in_poi_required or in_poi_bear) ? mtf_state_raw_bear : 0
int ltf_bull_conf = mtf_state_bull
int ltf_bear_conf = mtf_state_bear
int htf_bull_conf = htf_state_raw_bull
int htf_bear_conf = htf_state_raw_bear

// ====================================================================================================================
// GATE БУЛЕВЫ — LTF и HTF (логика не изменена)
// ====================================================================================================================
bool ltf_gate_bull = (ltf_gate_min == 0 or ltf_bull_conf >= ltf_gate_min or not p1_connected)
bool ltf_gate_bear = (ltf_gate_min == 0 or ltf_bear_conf >= ltf_gate_min or not p1_connected)
bool htf_gate_bull = (htf_gate_min == 0 or htf_bull_conf >= htf_gate_min)
bool htf_gate_bear = (htf_gate_min == 0 or htf_bear_conf >= htf_gate_min)
bool full_gate_bull = ltf_gate_bull and htf_gate_bull
bool full_gate_bear = ltf_gate_bear and htf_gate_bear

// ====================================================================================================================
// ЗАПОЛНЕНИЕ UDT-ОБЪЕКТОВ TF_DETAIL_STRINGS (логика не изменена)
// ====================================================================================================================
tf_detail_strings tf_pack_bull = tf_detail_strings.new()
tf_detail_strings tf_pack_bear = tf_detail_strings.new()

tf_pack_bull.htf1 := "HTF1(" + htf_tv_1 + "): P1=" + str.tostring(p1_htf1_sb) + "/" + str.tostring(p1_htf1_min) + " OSC=" + str.tostring(p2_htf1_cnt_b) + "/10(мин." + str.tostring(p2_htf1_min_ok) + ")" + (tier_htf1_bull ? " ✅" : " —")
tf_pack_bull.htf2 := "HTF2(" + htf_tv_2 + "): P1=" + str.tostring(p1_htf2_sb) + "/" + str.tostring(p1_htf2_min) + " OSC=" + str.tostring(p2_htf2_cnt_b) + "/10(мин." + str.tostring(p2_htf2_min_ok) + ")" + (tier_htf2_bull ? " ✅" : " —")
tf_pack_bull.htf3 := "HTF3(" + htf_tv_3 + "): P1=" + str.tostring(p1_htf3_sb) + "/" + str.tostring(p1_htf3_min) + " OSC=" + str.tostring(p2_htf3_cnt_b) + "/10(мин." + str.tostring(p2_htf3_min_ok) + ")" + (tier_htf3_bull ? " ✅" : " —")
tf_pack_bear.htf1 := "HTF1(" + htf_tv_1 + "): P1=" + str.tostring(p1_htf1_ss) + "/" + str.tostring(p1_htf1_min) + " OSC=" + str.tostring(p2_htf1_cnt_s) + "/10(мин." + str.tostring(p2_htf1_min_ok) + ")" + (tier_htf1_bear ? " ✅" : " —")
tf_pack_bear.htf2 := "HTF2(" + htf_tv_2 + "): P1=" + str.tostring(p1_htf2_ss) + "/" + str.tostring(p1_htf2_min) + " OSC=" + str.tostring(p2_htf2_cnt_s) + "/10(мин." + str.tostring(p2_htf2_min_ok) + ")" + (tier_htf2_bear ? " ✅" : " —")
tf_pack_bear.htf3 := "HTF3(" + htf_tv_3 + "): P1=" + str.tostring(p1_htf3_ss) + "/" + str.tostring(p1_htf3_min) + " OSC=" + str.tostring(p2_htf3_cnt_s) + "/10(мин." + str.tostring(p2_htf3_min_ok) + ")" + (tier_htf3_bear ? " ✅" : " —")
tf_pack_bull.ltf1 := "LTF1(" + mtf_tv_1 + "м): P1=" + str.tostring(p1_ltf1_sb) + "/" + str.tostring(p1_ltf1_min) + " OSC=" + str.tostring(p2_ltf1_cnt_b) + "/10(мин." + str.tostring(p2_ltf1_min_ok) + ")" + (tier_ltf1_bull ? " ✅" : (blt1b<=mtf_window ? " ⏳" : " —"))
tf_pack_bull.ltf2 := "LTF2(" + mtf_tv_2 + "м): P1=" + str.tostring(p1_ltf2_sb) + "/" + str.tostring(p1_ltf2_min) + " OSC=" + str.tostring(p2_ltf2_cnt_b) + "/10(мин." + str.tostring(p2_ltf2_min_ok) + ")" + (tier_ltf2_bull ? " ✅" : (blt2b<=mtf_window ? " ⏳" : " —"))
tf_pack_bull.ltf3 := "LTF3(" + mtf_tv_3 + "м): P1=" + str.tostring(p1_ltf3_sb) + "/" + str.tostring(p1_ltf3_min) + " OSC=" + str.tostring(p2_ltf3_cnt_b) + "/10(мин." + str.tostring(p2_ltf3_min_ok) + ")" + (tier_ltf3_bull ? " ✅" : (blt3b<=mtf_window ? " ⏳" : " —"))
tf_pack_bear.ltf1 := "LTF1(" + mtf_tv_1 + "м): P1=" + str.tostring(p1_ltf1_ss) + "/" + str.tostring(p1_ltf1_min) + " OSC=" + str.tostring(p2_ltf1_cnt_s) + "/10(мин." + str.tostring(p2_ltf1_min_ok) + ")" + (tier_ltf1_bear ? " ✅" : (blt1s<=mtf_window ? " ⏳" : " —"))
tf_pack_bear.ltf2 := "LTF2(" + mtf_tv_2 + "м): P1=" + str.tostring(p1_ltf2_ss) + "/" + str.tostring(p1_ltf2_min) + " OSC=" + str.tostring(p2_ltf2_cnt_s) + "/10(мин." + str.tostring(p2_ltf2_min_ok) + ")" + (tier_ltf2_bear ? " ✅" : (blt2s<=mtf_window ? " ⏳" : " —"))
tf_pack_bear.ltf3 := "LTF3(" + mtf_tv_3 + "м): P1=" + str.tostring(p1_ltf3_ss) + "/" + str.tostring(p1_ltf3_min) + " OSC=" + str.tostring(p2_ltf3_cnt_s) + "/10(мин." + str.tostring(p2_ltf3_min_ok) + ")" + (tier_ltf3_bear ? " ✅" : (blt3s<=mtf_window ? " ⏳" : " —"))
tf_pack_bull.htf_verdict := htf_bull_conf == 3 ? "🟢 HTF: все 3 ТФ подтверждены" : htf_bull_conf == 2 ? "🟡 HTF: 2 из 3 ТФ подтверждено" : htf_bull_conf == 1 ? "⚪ HTF: 1 из 3 ТФ подтверждён" : "❌ HTF: нет подтверждения"
tf_pack_bear.htf_verdict := htf_bear_conf == 3 ? "🟢 HTF: все 3 ТФ подтверждены" : htf_bear_conf == 2 ? "🟡 HTF: 2 из 3 ТФ подтверждено" : htf_bear_conf == 1 ? "⚪ HTF: 1 из 3 ТФ подтверждён" : "❌ HTF: нет подтверждения"
tf_pack_bull.ltf_cascade_verdict := mtf_state_bull == 3 ? "🟢 LTF: все тиры подтверждены" : mtf_state_bull == 2 ? "🟡 LTF: 2 из 3 тиров" : mtf_state_bull == 1 ? "⚪ LTF: 1 из 3 тиров" : (in_poi_required and in_poi_bull) ? "❌ LTF: не подтвердил" : (not in_poi_required) ? "— Без POI-гейта" : "— Вне POI"
tf_pack_bear.ltf_cascade_verdict := mtf_state_bear == 3 ? "🟢 LTF: все тиры подтверждены" : mtf_state_bear == 2 ? "🟡 LTF: 2 из 3 тиров" : mtf_state_bear == 1 ? "⚪ LTF: 1 из 3 тиров" : (in_poi_required and in_poi_bear) ? "❌ LTF: не подтвердил" : (not in_poi_required) ? "— Без POI-гейта" : "— Вне POI"

string bos_retest_str_b = (not na(bos_level_price) and bos_level_dir == 1) ? "🎯 BOS-уровень (бычий) на " + str.tostring(bos_level_price, format.mintick) + " │ касаний: " + str.tostring(p1_bos_touches) + (bos_level_exhausted ? " (истощён)" : "") : ""
string bos_retest_str_s = (not na(bos_level_price) and bos_level_dir == -1) ? "🎯 BOS-уровень (медв.) на " + str.tostring(bos_level_price, format.mintick) + " │ касаний: " + str.tostring(p1_bos_touches) + (bos_level_exhausted ? " (истощён)" : "") : ""
string choch_retest_str_b = (not na(choch_level_price) and choch_level_dir == 1) ? "🎯 CHoCH-уровень (бычий) на " + str.tostring(choch_level_price, format.mintick) + " │ касаний: " + str.tostring(p1_choch_touches) + (choch_level_exhausted ? " (истощён)" : "") : ""
string choch_retest_str_s = (not na(choch_level_price) and choch_level_dir == -1) ? "🎯 CHoCH-уровень (медв.) на " + str.tostring(choch_level_price, format.mintick) + " │ касаний: " + str.tostring(p1_choch_touches) + (choch_level_exhausted ? " (истощён)" : "") : ""

// ====================================================================================================================
// 8. КОНСТРУКТОР СИГНАЛОВ (СКОРИНГ) — 64 ФАКТОРА — ИНПУТЫ
// Факторы 0-45: базовый набор (как в оригинале). Факторы 46-63: НОВЫЕ комплексы — комбинации уже
// рассчитанных переменных из текстовых секций инфоблока, теперь участвующие в самом скоринге.
// ====================================================================================================================
grp_score = "8. Конструктор сигналов (Скоринг)"
req_score_raw = qa_req_score_raw
req_score = f_pr_score_p2(req_score_raw)

s_rsi_kde = input.bool(true,"📐 Учет: KDE RSI",inline="rsi_kde",group=grp_score,tooltip="Учитывать разворот KDE RSI (выход из плотной зоны вероятностей) в скоринге."), m_rsi_kde = input.bool(false,"Обязат.",inline="rsi_kde",group=grp_score,tooltip="Если включено — без этого фактора сигнал невозможен (жёсткое условие).")
s_stoch = input.bool(true,"🌀 Учет: Stoch Z",inline="stc",group=grp_score,tooltip="Учитывать разворот Stoch Z-Score на экстремуме в скоринге."), m_stoch = input.bool(false,"Обязат.",inline="stc",group=grp_score,tooltip="Сделать Stoch Z обязательным условием сигнала.")
s_macd_dlx = input.bool(true,"⚙️ Учет: MACD Dlx",inline="mac2",group=grp_score,tooltip="Учитывать пересечение Adaptive MACD Deluxe в скоринге."), m_macd_dlx = input.bool(false,"Обязат.",inline="mac2",group=grp_score,tooltip="Сделать MACD Deluxe обязательным условием сигнала.")
s_cci = input.bool(true,"🎢 Учет: Advanced CCI",inline="cci",group=grp_score,tooltip="Учитывать подтверждение Advanced CCI (Supertrend/L3) в скоринге."), m_cci = input.bool(false,"Обязат.",inline="cci",group=grp_score,tooltip="Сделать Advanced CCI обязательным условием сигнала.")
s_mdiv = input.bool(true,"🔍 Учет: Multi-Div",inline="mdiv",group=grp_score,tooltip="Учитывать мульти-дивергенцию (Lonesome) в скоринге."), m_mdiv = input.bool(false,"Обязат.",inline="mdiv",group=grp_score,tooltip="Сделать Multi-Div обязательным условием сигнала.")
s_peter = input.bool(true,"🔎 Учет: PeterO Div",inline="pdv",group=grp_score,tooltip="Учитывать нерепейнт-дивергенцию PeterO в скоринге."), m_peter = input.bool(false,"Обязат.",inline="pdv",group=grp_score,tooltip="Сделать PeterO Div обязательным условием сигнала.")
s_tfdiv = input.bool(true,"🧩 Учет: T-Finder Div",inline="tfdv",group=grp_score,tooltip="Учитывать фрактальную дивергенцию TradingFinder в скоринге."), m_tfdiv = input.bool(false,"Обязат.",inline="tfdv",group=grp_score,tooltip="Сделать T-Finder Div обязательным условием сигнала.")
s_smt = input.bool(true,"🌐 Учет: SMT Div",inline="smt",group=grp_score,tooltip="Учитывать межрыночную дивергенцию SMT в скоринге."), m_smt = input.bool(false,"Обязат.",inline="smt",group=grp_score,tooltip="Сделать SMT Div обязательным условием сигнала.")
s_sm_act = input.bool(true,"🐋 Учет: SM Act",inline="vol_act",group=grp_score,tooltip="Учитывать активность умных денег (Smart Money Activity) в скоринге."), m_sm_act = input.bool(false,"Обязат.",inline="vol_act",group=grp_score,tooltip="Сделать SM Activity обязательным условием сигнала.")
s_sm_idx = input.bool(true,"💰 Учет: SM Index",inline="vol_idx",group=grp_score,tooltip="Учитывать индекс умных денег (SM Index) в скоринге."), m_sm_idx = input.bool(false,"Обязат.",inline="vol_idx",group=grp_score,tooltip="Сделать SM Index обязательным условием сигнала.")
s_sm_int = input.bool(true,"💡 Учет: SM Int",inline="vol_int",group=grp_score,tooltip="Учитывать интерес умных денег (SM Interest) в скоринге."), m_sm_int = input.bool(false,"Обязат.",inline="vol_int",group=grp_score,tooltip="Сделать SM Interest обязательным условием сигнала.")
s_cndl = input.bool(true,"🕯️ Учет: Candles",inline="cndl",group=grp_score,tooltip="Учитывать найденный свечной паттерн в скоринге."), m_cndl = input.bool(false,"Обязат.",inline="cndl",group=grp_score,tooltip="Сделать свечной паттерн обязательным условием сигнала.")
s_ma_cross = input.bool(true,"✕ Учет: MA Cross",inline="ma_x",group=grp_score,tooltip="Учитывать пересечение Fast/Slow MA в скоринге."), m_ma_cross = input.bool(false,"Обязат.",inline="ma_x",group=grp_score,tooltip="Сделать MA Cross обязательным условием сигнала.")
s_ma_trend = input.bool(true,"📈 Учет: MA Trend",inline="ma_t",group=grp_score,tooltip="Учитывать направление тренда MA в скоринге."), m_ma_trend = input.bool(false,"Обязат.",inline="ma_t",group=grp_score,tooltip="Сделать MA Trend обязательным условием сигнала.")
s_smc = input.bool(true,"📍 SMC Trend Вкл",inline="smc",group=grp_score,tooltip="Учитывать направление структуры SMC из Main в скоринге."), m_smc = input.bool(false,"Обязат.",inline="smc",group=grp_score,tooltip="Сделать SMC Trend обязательным условием сигнала.")
s_ob = input.bool(true,"📦 OB Activity Вкл",inline="ob",group=grp_score,tooltip="Учитывать активный Order Block из Main в скоринге."), m_ob = input.bool(false,"Обязат.",inline="ob",group=grp_score,tooltip="Сделать OB Activity обязательным условием сигнала.")
