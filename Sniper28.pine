f_pr_include(int factor_idx, bool raw_s) =>
    bool result = raw_s
    if preset_idx_p2 >= 0
        result := PR_FACTORS.get(preset_idx_p2 * 64 + factor_idx).include
    result

f_pr_weight(int factor_idx, int raw_weight) =>
    int result = raw_weight
    if preset_idx_p2 >= 0
        result := PR_FACTORS.get(preset_idx_p2 * 64 + factor_idx).weight
    result

f_pr_must(int factor_idx, bool raw_must) =>
    bool result = raw_must
    if preset_idx_p2 >= 0
        result := PR_FACTORS.get(preset_idx_p2 * 64 + factor_idx).must
    result

