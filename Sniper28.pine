en_belthold_bull = input.bool(true, "Бычий Бэлт-Холд", group=grp_cndl, inline="nb4", tooltip="Бычий Бэлт-Холд — открытие на минимуме бара (без нижней тени), длинное бычье тело, закрытие у максимума.")
