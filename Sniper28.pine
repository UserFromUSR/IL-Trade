buy_valid := buy_valid and (pf57.must ? b_cvd_sm_hm_bull : true)
sell_valid := sell_valid and (pf57.must ? b_cvd_sm_hm_bear : true)

preset_factor pf58 = f_pr_get(58, s_kde_stoch, 1, m_kde_stoch)
bool b_kde_stoch_bull = osc_kde_bull and osc_stoch_bull
bool b_kde_stoch_bear = osc_kde_bear and osc_stoch_bear
buy_score += pf58.include ? (b_kde_stoch_bull ? pf58.weight : 0) : 0
sell_score += pf58.include ? (b_kde_stoch_bear ? pf58.weight : 0) : 0
buy_valid := buy_valid and (pf58.must ? b_kde_stoch_bull : true)
sell_valid := sell_valid and (pf58.must ? b_kde_stoch_bear : true)

preset_factor pf59 = f_pr_get(59, s_macd_cci, 1, m_macd_cci)
bool b_macd_cci_bull = osc_macd_dlx_bull and osc_cci_bull
bool b_macd_cci_bear = osc_macd_dlx_bear and osc_cci_bear
buy_score += pf59.include ? (b_macd_cci_bull ? pf59.weight : 0) : 0
sell_score += pf59.include ? (b_macd_cci_bear ? pf59.weight : 0) : 0
buy_valid := buy_valid and (pf59.must ? b_macd_cci_bull : true)
sell_valid := sell_valid and (pf59.must ? b_macd_cci_bear : true)

preset_factor pf60 = f_pr_get(60, s_peter_tfdiv, 1, m_peter_tfdiv)
bool b_peter_tfdiv_bull = osc_peter_bull and osc_tfdiv_bull
bool b_peter_tfdiv_bear = osc_peter_bear and osc_tfdiv_bear
buy_score += pf60.include ? (b_peter_tfdiv_bull ? pf60.weight : 0) : 0
sell_score += pf60.include ? (b_peter_tfdiv_bear ? pf60.weight : 0) : 0
buy_valid := buy_valid and (pf60.must ? b_peter_tfdiv_bull : true)
sell_valid := sell_valid and (pf60.must ? b_peter_tfdiv_bear : true)

preset_factor pf61 = f_pr_get(61, s_smt_mdiv, 1, m_smt_mdiv)
bool b_smt_mdiv_bull = osc_smt_bull and osc_mdiv_bull
bool b_smt_mdiv_bear = osc_smt_bear and osc_mdiv_bear
buy_score += pf61.include ? (b_smt_mdiv_bull ? pf61.weight : 0) : 0
sell_score += pf61.include ? (b_smt_mdiv_bear ? pf61.weight : 0) : 0
buy_valid := buy_valid and (pf61.must ? b_smt_mdiv_bull : true)
sell_valid := sell_valid and (pf61.must ? b_smt_mdiv_bear : true)

preset_factor pf62 = f_pr_get(62, s_triple_div, 3, m_triple_div)
bool b_triple_div_bull = osc_mdiv_bull and osc_peter_bull and osc_smt_bull
bool b_triple_div_bear = osc_mdiv_bear and osc_peter_bear and osc_smt_bear
buy_score += pf62.include ? (b_triple_div_bull ? pf62.weight : 0) : 0
sell_score += pf62.include ? (b_triple_div_bear ? pf62.weight : 0) : 0
buy_valid := buy_valid and (pf62.must ? b_triple_div_bull : true)
sell_valid := sell_valid and (pf62.must ? b_triple_div_bear : true)

preset_factor pf63 = f_pr_get(63, s_macross_matrend, 1, m_macross_matrend)
bool b_macross_matrend_bull = x_ma_bull and ma_trend_bull
bool b_macross_matrend_bear = x_ma_bear and ma_trend_bear
buy_score += pf63.include ? (b_macross_matrend_bull ? pf63.weight : 0) : 0
sell_score += pf63.include ? (b_macross_matrend_bear ? pf63.weight : 0) : 0
buy_valid := buy_valid and (pf63.must ? b_macross_matrend_bull : true)
sell_valid := sell_valid and (pf63.must ? b_macross_matrend_bear : true)

// ====================================================================================================================
// ГРЕЙДАЦИЯ СИЛЫ СИГНАЛА (A+/A/B/C/D) — КОМПОЗИТНАЯ МОДЕЛЬ (логика не изменена)
// ====================================================================================================================
f_signal_grade(int ltf_sc, int htf_sc, int layers, int sc, int req, bool regime_aligned) =>
    float safe_req = math.max(req, 1)
    float ltf_pct = ltf_sc / 3.0
    float htf_pct = htf_sc / 3.0
    float score_pct = math.min(sc / safe_req, ga_score_cap)
    float bonus = (layers >= 2 ? ga_bonus_layers : 0.0) + (regime_aligned ? ga_bonus_regime : 0.0)
    float composite = ltf_pct*ga_w_ltf + htf_pct*ga_w_htf + score_pct*ga_w_score + bonus
    string result = "NONE"
    if composite >= ga_thresh_app
        result := "A+"
    else if composite >= ga_thresh_a
        result := "A"
    else if composite >= ga_thresh_b
        result := "B"
    else if composite >= ga_thresh_c
        result := "C"
    else if composite > 0.0
        result := "D"
    result

f_grade_emoji(string grade) => switch grade
    "A+" => "💎"
    "A" => "🏆"
    "B" => "🥇"
    "C" => "🥈"
    "D" => "⚪"
    => "—"

f_grade_color_bull(string grade) => switch grade
    "A+" => color.new(#00c853,0)
    "A" => color.new(#00c853,15)
    "B" => color.new(#2196f3,20)
    "C" => color.new(#2196f3,50)
    => color.new(color.gray,40)

f_grade_color_bear(string grade) => switch grade
    "A+" => color.new(#d50000,0)
    "A" => color.new(#d50000,15)
    "B" => color.new(#ff6f00,20)
    "C" => color.new(#ff6f00,50)
    => color.new(color.gray,40)

f_grade_info_bg(string grade, bool is_bull) => is_bull ? (grade=="A+"?info_bg_app_bull:grade=="A"?info_bg_a_bull:grade=="B"?info_bg_b_bull:grade=="C"?info_bg_c_bull:grade=="D"?info_bg_d_bull:info_bg_col) : (grade=="A+"?info_bg_app_bear:grade=="A"?info_bg_a_bear:grade=="B"?info_bg_b_bear:grade=="C"?info_bg_c_bear:grade=="D"?info_bg_d_bear:info_bg_col)

f_grade_live_bg(string grade, bool is_bull) => is_bull ? (grade=="A+"?live_bg_app_bull:grade=="A"?live_bg_a_bull:grade=="B"?live_bg_b_bull:grade=="C"?live_bg_c_bull:grade=="D"?live_bg_d_bull:live_bg_none) : (grade=="A+"?live_bg_app_bear:grade=="A"?live_bg_a_bear:grade=="B"?live_bg_b_bear:grade=="C"?live_bg_c_bear:grade=="D"?live_bg_d_bear:live_bg_none)

// ====================================================================================================================
// ГЕНЕРАЦИЯ СИГНАЛОВ — REALTIME-ФИКСАЦИЯ ВНУТРИ БАРА + NON-REPAINT ИТОГ НА ЗАКРЫТИИ (логика не изменена)
// ====================================================================================================================
bool signal_is_score_buy = p1_connected and (buy_score >= req_score and buy_valid and full_gate_bull)
bool signal_is_score_sell = p1_connected and (sell_score >= req_score and sell_valid and full_gate_bear)

var int intrabar_bar_idx_buy = -1
var int intrabar_bar_idx_sell = -1
var float intrabar_signal_price_buy = na
var float intrabar_signal_price_sell = na
if intrabar_bar_idx_buy != bar_index
    intrabar_signal_price_buy := na
    intrabar_bar_idx_buy := bar_index
if intrabar_bar_idx_sell != bar_index
    intrabar_signal_price_sell := na
    intrabar_bar_idx_sell := bar_index
if signal_is_score_buy and na(intrabar_signal_price_buy)
    intrabar_signal_price_buy := close
if signal_is_score_sell and na(intrabar_signal_price_sell)
    intrabar_signal_price_sell := close
if not signal_is_score_buy
    intrabar_signal_price_buy := na
if not signal_is_score_sell
    intrabar_signal_price_sell := na
bool intrabar_signal_live_buy = not na(intrabar_signal_price_buy) and not barstate.isconfirmed
bool intrabar_signal_live_sell = not na(intrabar_signal_price_sell) and not barstate.isconfirmed

var bool is_buy = false
var bool is_sell = false
var int bars_since_any_buy = 999
var int bars_since_any_sell = 999
var float signal_price_buy = na
var float signal_price_sell = na
var string signal_grade_buy = "NONE"
var string signal_grade_sell = "NONE"
is_buy := false
is_sell := false
bars_since_any_buy := math.min(bars_since_any_buy+1, 999)
bars_since_any_sell := math.min(bars_since_any_sell+1, 999)

if barstate.isconfirmed
    string grade_b_now = f_signal_grade(mtf_state_bull, htf_bull_conf, p1_zone_layers_bull, buy_score, req_score, final_regime_bull)
    string grade_s_now = f_signal_grade(mtf_state_bear, htf_bear_conf, p1_zone_layers_bear, sell_score, req_score, final_regime_bear)
    if signal_is_score_buy and bars_since_any_buy >= sig_lookback and f_grade_allowed(grade_b_now)
        is_buy := true, bars_since_any_buy := 0
        signal_price_buy := not na(intrabar_signal_price_buy) ? intrabar_signal_price_buy : close
        signal_grade_buy := grade_b_now
    if signal_is_score_sell and bars_since_any_sell >= sig_lookback and f_grade_allowed(grade_s_now)
        is_sell := true, bars_since_any_sell := 0
        signal_price_sell := not na(intrabar_signal_price_sell) ? intrabar_signal_price_sell : close
        signal_grade_sell := grade_s_now

// ── БАГ-ФИКС: side_strength = тиры×2 + скор ──
f_side_strength(int ltf_s, int htf_s, int sc) => ltf_s*2.0 + htf_s*2.0 + sc

// ====================================================================================================================
// ЗАПОЛНЕНИЕ UDT-ОБЪЕКТОВ SIDE_DETAIL (после скоринга, перед текстовыми функциями — логика не изменена)
// ====================================================================================================================
pack_bull.smc := b_smc_bull, pack_bear.smc := b_smc_bear
