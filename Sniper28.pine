indicator("UserUZR Sniper - All-In-One Optimized (EMA, RSI, STC, MACD, Cndl, MDivs, SM, Logic)", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

get_size(str) => switch str
    "tiny" => size.tiny
    "small" => size.small
    "normal" => size.normal
    "large" => size.large
    "huge" => size.huge
    => size.auto

// ── UDT для упаковки display-данных ──
type side_detail
    bool   smc = false
    bool   choch_sw = false
    bool   bb = false
    bool   bos = false
    bool   choch = false
    int    chb = 999
    bool   sweep = false
    int    swb = 999
    bool   disp = false
    int    dpb = 999
    bool   avwap_x = false
    bool   avwap = false
    bool   virgin = false
    int    touches = 0
    bool   ob_sd = false
    int    layers = 0
    bool   fvg_p = false
    bool   sd = false
    bool   ob = false
    bool   ob_fr = false
    int    ote = 0
    bool   pd = false
    bool   sm_act = false
    int    sm_bars = 999
    bool   sm_idx = false
    bool   sm_int = false
    bool   cvd = false
    int    hm_bars = 999
    bool   sdinv = false
    bool   kde = false
    bool   stoch = false
    bool   macd = false
    bool   cci = false
    bool   mdiv = false
    int    mdiv_cnt = 0
    bool   peter = false
    bool   tfdiv = false
    bool   smt = false
    bool   osc6 = false
    string cndl_name = ""
    bool   cndl = false
    bool   ma_x = false
    bool   ma_tr = false
    bool   regime = false
    bool   bos_retest = false
    string bos_retest_text = ""
    bool   choch_retest = false
    string choch_retest_text = ""
    bool   hm_vol_sig = false

type tf_detail_strings
    string htf1 = ""
    string htf2 = ""
    string htf3 = ""
    string htf_verdict = ""
    string ltf1 = ""
    string ltf2 = ""
    string ltf3 = ""
    string ltf_cascade_verdict = ""

// ====================================================================================================================
// 0. ПРЕСЕТ ЧУВСТВИТЕЛЬНОСТИ (синхронизировать вручную с тем же пресетом в Main)
// Удалены пресеты "Осцилляторный Шторм" и "Структурный Поток" — теперь только Custom / Скальпинг / Шумовой Максимум.
// ====================================================================================================================
grp_0 = "0. Пресет чувствительности (синхронизировать с Main)"
preset_mode_p2 = input.string("Custom", "Профиль чувствительности", options=["Custom", "Скальпинг", "Шумовой Максимум"], group=grp_0, tooltip="Custom — все настройки ниже работают как обычные ручные инпуты, пресет не влияет. Скальпинг — якорь: свечной паттерн, LTF Gate мягкий, HTF Gate отключён, req_score снижен максимально. Шумовой Максимум — все факторы скоринга включены с равным весом, req_score на минимуме, гейты отключены, максимальный поток сигналов. Профиль задаёт req_score, пороги OSC10, гейты каскада, требование POI, веса/пороги грейдов и матрицу факторов скоринга PR_FACTORS. Синхронизируйте тот же профиль вручную в Main.")

f_preset_idx_p2() =>
    int idx = -1
    if preset_mode_p2 == "Скальпинг"
        idx := 0
    else if preset_mode_p2 == "Шумовой Максимум"
        idx := 1
    idx

int preset_idx_p2 = f_preset_idx_p2()

// ── Скалярные пороги каскада: индекс 0=Скальпинг, 1=Шумовой Максимум ──
var int[] PR_REQ_SCORE_OFS = array.from(-2, -3)
var int[] PR_GATE_OFS_LTF = array.from(-1, -2)
var int[] PR_GATE_OFS_HTF = array.from(-2, -2)
var bool[] PR_IN_POI_REQUIRED = array.from(false, false)

f_pr_score_p2(int base) =>
    int result = base
    if preset_idx_p2 >= 0
        result := math.max(1, base + PR_REQ_SCORE_OFS.get(preset_idx_p2))
    result

f_pr_gate_ltf_p2(int base) =>
    int result = base
    if preset_idx_p2 >= 0
        result := math.max(0, math.min(3, base + PR_GATE_OFS_LTF.get(preset_idx_p2)))
    result

f_pr_gate_htf_p2(int base) =>
    int result = base
    if preset_idx_p2 >= 0
        result := math.max(0, math.min(3, base + PR_GATE_OFS_HTF.get(preset_idx_p2)))
    result

f_pr_in_poi_required(bool manual_raw) =>
    bool result = manual_raw
    if preset_idx_p2 >= 0
        result := PR_IN_POI_REQUIRED.get(preset_idx_p2)
    result

f_pr_get(int factor_idx, bool raw_inc, int raw_w, bool raw_must) =>
    preset_factor result = preset_factor.new(raw_inc, raw_w, raw_must)
    if preset_idx_p2 >= 0
        result := PR_FACTORS.get(preset_idx_p2 * 64 + factor_idx)
    result

// ====================================================================================================================
// 0.1 БЫСТРЫЙ ДОСТУП — req_score, P2 OSC10 пороги по TF, LTF/HTF гейты каскада, требование POI
// ====================================================================================================================
grp_quick_p2 = "0.1 Быстрый доступ — req_score, OSC10 пороги, Гейты каскада, POI"
qa_req_score_raw = input.int(4, "Целевой порог скоринга (req_score)", minval=1, maxval=64, group=grp_quick_p2, tooltip="Сколько взвешенных баллов скоринга нужно набрать для сигнала. Базовое значение для Custom — при выбранном пресете пересчитывается таблицей офсетов из секции 0. Увеличение — реже, но качественнее сигналы; уменьшение — чаще, но слабее.")

qa_ltf1_min_ok_raw = input.int(4, "OSC10 мин. подтв. — LTF1", minval=1, maxval=10, inline="qosc_ltf", group=grp_quick_p2, tooltip="Минимум подтверждений из 10 в P2-осцилляторном движке на LTF1 для засчитывания тира. Больше — строже фильтр шума, меньше — мягче и чаще.")
qa_ltf2_min_ok_raw = input.int(4, "LTF2", minval=1, maxval=10, inline="qosc_ltf", group=grp_quick_p2, tooltip="То же самое для LTF2.")
qa_ltf3_min_ok_raw = input.int(4, "LTF3", minval=1, maxval=10, inline="qosc_ltf", group=grp_quick_p2, tooltip="То же самое для LTF3.")
qa_htf1_min_ok_raw = input.int(3, "OSC10 мин. подтв. — HTF1", minval=1, maxval=10, inline="qosc_htf", group=grp_quick_p2, tooltip="Минимум подтверждений OSC10 на HTF1 для засчитывания HTF-тира. На старших ТФ обычно держат порог ниже, чем на LTF.")
qa_htf2_min_ok_raw = input.int(3, "HTF2", minval=1, maxval=10, inline="qosc_htf", group=grp_quick_p2, tooltip="То же самое для HTF2.")
qa_htf3_min_ok_raw = input.int(2, "HTF3", minval=1, maxval=10, inline="qosc_htf", group=grp_quick_p2, tooltip="То же самое для HTF3 (самый старший ТФ, порог обычно минимальный).")

qa_ltf_gate_min_raw = input.int(2, "Мин. LTF тиров (0=откл.)", minval=0, maxval=3, inline="qgate", group=grp_quick_p2, tooltip="Сколько из 3 LTF-тиров должно быть подтверждено, чтобы сигнал прошёл гейт. 0 — гейт полностью отключён (сигналы не блокируются по LTF).")
qa_htf_gate_min_raw = input.int(2, "Мин. HTF тиров (0=откл.)", minval=0, maxval=3, inline="qgate", group=grp_quick_p2, tooltip="Сколько из 3 HTF-тиров должно быть подтверждено для прохождения гейта. 0 — гейт по HTF отключён.")

qa_in_poi_required_raw = input.bool(true, "Требовать POI для LTF-каскада (Custom)", group=grp_quick_p2, tooltip="Если включено — LTF-каскад засчитывается только когда цена находится в точке интереса (OB/S&D/FVG/OTE). При выбранном пресете (не Custom) переопределяется таблицей PR_IN_POI_REQUIRED автоматически.")

// ====================================================================================================================
// 0.2 ГРЕЙДЫ — ВЕСА И ПОРОГИ + ВИДИМОСТЬ СИГНАЛОВ И ФИЛЬТР ПО ГРЕЙДУ (перенесено сюда из старого раздела 4 и из 5/6)
// Грейд считается взвешенной суммой трёх осей (LTF-консенсус, HTF-консенсус, выполнение скоринга) плюс бонусы.
// ====================================================================================================================
grp_grade = "0.2 Грейды — веса и пороги (композитная модель)"
ga_w_ltf_raw = input.float(0.30, "Вес LTF-консенсуса", minval=0.0, maxval=1.0, step=0.05, inline="gw1", group=grp_grade, tooltip="Доля влияния LTF-каскада (0..3 тира → 0..1) на композитный балл грейда. Увеличение веса делает грейд более зависимым от согласия младших ТФ.")
ga_w_htf_raw = input.float(0.30, "Вес HTF-консенсуса", minval=0.0, maxval=1.0, step=0.05, inline="gw1", group=grp_grade, tooltip="Доля влияния HTF-консенсуса на композитный балл грейда. Увеличение веса делает грейд более зависимым от согласия старших ТФ.")
ga_w_score_raw = input.float(0.40, "Вес выполнения скора", minval=0.0, maxval=1.0, step=0.05, inline="gw2", group=grp_grade, tooltip="Доля влияния отношения скор/req_score (с потолком ga_score_cap) на композитный балл. Увеличение веса делает грейд более зависимым от силы скоринга, а не от консенсуса ТФ.")
ga_score_cap_raw = input.float(1.50, "Потолок доли скора", minval=1.0, maxval=3.0, step=0.1, inline="gw2", group=grp_grade, tooltip="Максимум, до которого может разогнаться доля скора (sc/req), чтобы один огромный скор не задавил остальные оси без меры.")
ga_bonus_layers_raw = input.float(0.15, "Бонус: Zone Confluence ≥2 слоёв", minval=0.0, maxval=0.5, step=0.05, inline="gb1", group=grp_grade, tooltip="Прибавка к композитному баллу, если зона интереса состоит из 2+ слоёв (OB+S&D+FVG). Увеличение — зоны с конфлюэнсом сильнее поднимают грейд.")
ga_bonus_regime_raw = input.float(0.10, "Бонус: Режим рынка совпадает", minval=0.0, maxval=0.5, step=0.05, inline="gb1", group=grp_grade, tooltip="Прибавка к баллу, если направленный режим рынка (ADX+DI) совпадает с направлением сигнала. Увеличение — трендовые сигналы получают больше преимущества.")
ga_thresh_app_raw = input.float(1.25, "Порог A+", minval=0.5, maxval=2.0, step=0.05, inline="gt1", group=grp_grade, tooltip="Минимальный композитный балл для грейда A+. Повышение порога делает топ-грейд более редким и строгим.")
ga_thresh_a_raw = input.float(1.00, "Порог A", minval=0.3, maxval=2.0, step=0.05, inline="gt1", group=grp_grade, tooltip="Минимальный композитный балл для грейда A.")
ga_thresh_b_raw = input.float(0.75, "Порог B", minval=0.2, maxval=2.0, step=0.05, inline="gt2", group=grp_grade, tooltip="Минимальный композитный балл для грейда B.")
ga_thresh_c_raw = input.float(0.50, "Порог C", minval=0.1, maxval=2.0, step=0.05, inline="gt2", group=grp_grade, tooltip="Минимальный композитный балл для грейда C. Ниже этого порога (но выше 0) сигнал получает грейд D.")

var float[] PR_GRADE_W_LTF_OFS = array.from(0.00, -0.05)
var float[] PR_GRADE_W_HTF_OFS = array.from(0.00, -0.05)
var float[] PR_GRADE_W_SCORE_OFS = array.from(0.00, 0.10)
var float[] PR_GRADE_BONUS_L_OFS = array.from(0.00, 0.00)
var float[] PR_GRADE_BONUS_R_OFS = array.from(0.00, 0.00)
var float[] PR_GRADE_TH_APP_OFS = array.from(-0.10, -0.20)
var float[] PR_GRADE_TH_A_OFS = array.from(-0.08, -0.15)
var float[] PR_GRADE_TH_B_OFS = array.from(-0.05, -0.10)
var float[] PR_GRADE_TH_C_OFS = array.from(-0.05, -0.10)

f_pr_grade_f(float base, array<float> ofs_arr, float minv, float maxv) =>
    float result = base
    if preset_idx_p2 >= 0
        result := math.max(minv, math.min(maxv, base + ofs_arr.get(preset_idx_p2)))
    result

float ga_w_ltf = f_pr_grade_f(ga_w_ltf_raw, PR_GRADE_W_LTF_OFS, 0.0, 1.0)
float ga_w_htf = f_pr_grade_f(ga_w_htf_raw, PR_GRADE_W_HTF_OFS, 0.0, 1.0)
float ga_w_score = f_pr_grade_f(ga_w_score_raw, PR_GRADE_W_SCORE_OFS, 0.0, 1.0)
float ga_score_cap = ga_score_cap_raw
float ga_bonus_layers = f_pr_grade_f(ga_bonus_layers_raw, PR_GRADE_BONUS_L_OFS, 0.0, 0.5)
float ga_bonus_regime = f_pr_grade_f(ga_bonus_regime_raw, PR_GRADE_BONUS_R_OFS, 0.0, 0.5)
float ga_thresh_app = f_pr_grade_f(ga_thresh_app_raw, PR_GRADE_TH_APP_OFS, 0.3, 2.0)
float ga_thresh_a = f_pr_grade_f(ga_thresh_a_raw, PR_GRADE_TH_A_OFS, 0.2, 2.0)
float ga_thresh_b = f_pr_grade_f(ga_thresh_b_raw, PR_GRADE_TH_B_OFS, 0.1, 2.0)
float ga_thresh_c = f_pr_grade_f(ga_thresh_c_raw, PR_GRADE_TH_C_OFS, 0.05, 2.0)

// ── 0.2.1 Видимость сигналов и фильтр по грейду (ПЕРЕНЕСЕНО из старого раздела 4 + en_info_block из 5 + en_live_lbl из 6) ──
grp_vis = "0.2.1 Видимость сигналов и фильтр по грейду"
en_info_block = input.bool(true, "Показывать Инфоблок (чек-лист)", group=grp_vis, tooltip="Включает/выключает текстовый инфоблок с детальным разбором факторов под каждым сигналом BUY/SELL. Отключение полностью убирает блок, но не влияет на сам расчёт сигналов.")
en_live_lbl = input.bool(true, "Показывать живой светофор", group=grp_vis, tooltip="Включает/выключает динамическую метку 'светофор', которая в реальном времени показывает текущий статус накопления контекста ещё до появления финального сигнала.")
show_grade_app = input.bool(true, "A+", inline="grades", group=grp_vis, tooltip="Какие градации финального сигнала (BUY/SELL label + инфоблок) показывать. Светофор не фильтруется по грейду — он всегда отражает текущую ситуацию, но учитывает видимость HTF/LTF кружков ниже.")
show_grade_a = input.bool(true, "A", inline="grades", group=grp_vis, tooltip="Показывать сигналы грейда A.")
show_grade_b = input.bool(true, "B", inline="grades", group=grp_vis, tooltip="Показывать сигналы грейда B.")
show_grade_c = input.bool(true, "C", inline="grades", group=grp_vis, tooltip="Показывать сигналы грейда C.")
show_grade_d = input.bool(true, "D", inline="grades", group=grp_vis, tooltip="Показывать сигналы грейда D (самый слабый, накопление контекста).")
show_htf_circle_green = input.bool(true, "HTF 🟢 (3/3)", inline="htfcirc", group=grp_vis, tooltip="Видимость кружков-индикаторов совпадения HTF-контекста в светофоре/инфоблоке. Зелёный — все 3 старших ТФ подтвердили направление.")
show_htf_circle_yellow = input.bool(true, "🟡 (2/3)", inline="htfcirc", group=grp_vis, tooltip="Желтый кружок — 2 из 3 HTF подтвердили.")
show_htf_circle_white = input.bool(true, "⚪ (1/3)", inline="htfcirc", group=grp_vis, tooltip="Белый кружок — только 1 из 3 HTF подтвердил.")
show_ltf_circle_blue = input.bool(true, "LTF 🔵 (3/3)", inline="ltfcirc", group=grp_vis, tooltip="Видимость кружков-индикаторов совпадения LTF-каскада. Синий — все 3 младших ТФ подтвердили тир.")
show_ltf_circle_yellow = input.bool(true, "🟡 (2/3)", inline="ltfcirc", group=grp_vis, tooltip="Желтый кружок — 2 из 3 LTF подтвердили тир.")
show_ltf_circle_white = input.bool(true, "⚪ (1/3)", inline="ltfcirc", group=grp_vis, tooltip="Белый кружок — только 1 из 3 LTF подтвердил тир.")

f_grade_allowed(string grade) => switch grade
    "A+" => show_grade_app
    "A" => show_grade_a
    "B" => show_grade_b
    "C" => show_grade_c
    "D" => show_grade_d
    => false

f_htf_icon(int htf_s) => htf_s == 3 ? (show_htf_circle_green ? "🟢" : "") : htf_s == 2 ? (show_htf_circle_yellow ? "🟡" : "") : htf_s == 1 ? (show_htf_circle_white ? "⚪" : "") : "❌"

f_ltf_icon(int ltf_s) => ltf_s == 3 ? (show_ltf_circle_blue ? "🔵" : "") : ltf_s == 2 ? (show_ltf_circle_yellow ? "🟡" : "") : ltf_s == 1 ? (show_ltf_circle_white ? "⚪" : "") : "❌"

// ====================================================================================================================
// МАТРИЦА СОСТАВА/ВЕСОВ/ОБЯЗАТЕЛЬНОСТИ СКОРИНГА — UDT, ЕДИНЫЙ ПЛОСКИЙ МАССИВ (2 пресета × 64 фактора)
// Карта факторов (factor_idx 0..63): 0 rsi_kde,1 stoch,2 macd_dlx,3 cci,4 mdiv,5 peter,6 tfdiv,7 smt,8 sm_act,9 sm_idx,
// 10 sm_int,11 cndl,12 ma_cross,13 ma_trend,14 smc,15 ob,16 sd,17 fvg,18 bos,19 bb,20 hm,21 sdinv,22 sweep,23 choch,
// 24 pd,25 avwap,26 avwap_x,27 disp,28 ob_frsh,29 htf_bull,30 htf_bear,31 zone_conf,32 choch_sw,33 ob_sd,34 osc6,
// 35 regime,36 bos_retest,37 choch_retest,38 cvd,39 absorption,40 hm_vol_sig,41 fvg_poc,42 ob_touch_fresh1,43 sm_all3,
// 44 mdiv_multi,45 candle_inside_ob,46 sweep_ob,47 disp_ob,48 disp_fvg,49 ob_avwap,50 freshob_candle,51 sd_fvg,
// 52 ote_ob,53 ote_sd,54 candle_sd,55 smact_smidx,56 cvd_absorp,57 cvd_sm_hm,58 kde_stoch,59 macd_cci,60 peter_tfdiv,
// 61 smt_mdiv,62 triple_div,63 macross_matrend — НОВЫЕ КОМПЛЕКСЫ: 46..63 (заполняются в Части 3)
// ====================================================================================================================
type preset_factor
    bool include
    int weight
    bool must

var array<preset_factor> PR_FACTORS = array.from(
// ── 0: Скальпинг — якорь: cndl(11) + новые свечные комплексы. HTF off, без POI-гейта. ──
  preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(false,1,false),
  preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(true,2,false), preset_factor.new(true,1,false),
  preset_factor.new(false,1,false), preset_factor.new(true,3,true), preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false),
  preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false),
  preset_factor.new(true,2,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false),
  preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,2,false), preset_factor.new(true,2,false), preset_factor.new(true,1,false),
  preset_factor.new(true,1,false), preset_factor.new(false,1,false), preset_factor.new(true,1,false), preset_factor.new(false,1,false), preset_factor.new(true,1,false),
  preset_factor.new(true,1,false), preset_factor.new(true,1,false), preset_factor.new(true,1,false),
  preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(true,1,false), preset_factor.new(false,1,false),
  preset_factor.new(false,1,false), preset_factor.new(false,1,false), preset_factor.new(true,1,false),
