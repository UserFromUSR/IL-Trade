// ====================================================================================================================
// side_detail pack_bull/pack_bear — ОБЪЯВЛЕНИЕ (до скоринга, заполнение позже)
// ====================================================================================================================
side_detail pack_bull = side_detail.new()
side_detail pack_bear = side_detail.new()

// ====================================================================================================================
// СКОРИНГ — ВЗВЕШЕННЫЙ, С УЧЁТОМ ПРЕСЕТА (64 ФАКТОРА). ИСПРАВЛЕНО: вместо 3 отдельных переменных (include/
// weight/must) на фактор используется ОДНА переменная типа preset_factor через f_pr_get — экономит и токены
// (один вызов функции), и количество локальных переменных (1 вместо 3 на фактор). Логика идентична.
// ====================================================================================================================
int buy_score = 0
int sell_score = 0
bool buy_valid = true
bool sell_valid = true
if not p1_connected
    buy_valid := false, sell_valid := false

preset_factor pf0 = f_pr_get(0, s_rsi_kde, 1, m_rsi_kde)
buy_score += pf0.include ? (osc_kde_bull ? pf0.weight : 0) : 0
sell_score += pf0.include ? (osc_kde_bear ? pf0.weight : 0) : 0
buy_valid := buy_valid and (pf0.must ? osc_kde_bull : true)
sell_valid := sell_valid and (pf0.must ? osc_kde_bear : true)

preset_factor pf1 = f_pr_get(1, s_stoch, 1, m_stoch)
buy_score += pf1.include ? (osc_stoch_bull ? pf1.weight : 0) : 0
sell_score += pf1.include ? (osc_stoch_bear ? pf1.weight : 0) : 0
buy_valid := buy_valid and (pf1.must ? osc_stoch_bull : true)
sell_valid := sell_valid and (pf1.must ? osc_stoch_bear : true)

preset_factor pf2 = f_pr_get(2, s_macd_dlx, 1, m_macd_dlx)
buy_score += pf2.include ? (osc_macd_dlx_bull ? pf2.weight : 0) : 0
sell_score += pf2.include ? (osc_macd_dlx_bear ? pf2.weight : 0) : 0
buy_valid := buy_valid and (pf2.must ? osc_macd_dlx_bull : true)
sell_valid := sell_valid and (pf2.must ? osc_macd_dlx_bear : true)

preset_factor pf3 = f_pr_get(3, s_cci, 1, m_cci)
buy_score += pf3.include ? (osc_cci_bull ? pf3.weight : 0) : 0
sell_score += pf3.include ? (osc_cci_bear ? pf3.weight : 0) : 0
buy_valid := buy_valid and (pf3.must ? osc_cci_bull : true)
sell_valid := sell_valid and (pf3.must ? osc_cci_bear : true)

preset_factor pf4 = f_pr_get(4, s_mdiv, 1, m_mdiv)
buy_score += pf4.include ? (osc_mdiv_bull ? pf4.weight : 0) : 0
sell_score += pf4.include ? (osc_mdiv_bear ? pf4.weight : 0) : 0
buy_valid := buy_valid and (pf4.must ? osc_mdiv_bull : true)
sell_valid := sell_valid and (pf4.must ? osc_mdiv_bear : true)

preset_factor pf5 = f_pr_get(5, s_peter, 1, m_peter)
buy_score += pf5.include ? (osc_peter_bull ? pf5.weight : 0) : 0
sell_score += pf5.include ? (osc_peter_bear ? pf5.weight : 0) : 0
buy_valid := buy_valid and (pf5.must ? osc_peter_bull : true)
sell_valid := sell_valid and (pf5.must ? osc_peter_bear : true)

preset_factor pf6 = f_pr_get(6, s_tfdiv, 1, m_tfdiv)
buy_score += pf6.include ? (osc_tfdiv_bull ? pf6.weight : 0) : 0
sell_score += pf6.include ? (osc_tfdiv_bear ? pf6.weight : 0) : 0
