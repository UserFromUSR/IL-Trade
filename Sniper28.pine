grp_osc_kde = "2.1. Осциллятор: KDE RSI"
en_mod_kde = input.bool(true, "🟢 Включить модуль (Главный)", group=grp_osc_kde, tooltip="Включает/выключает модуль KDE RSI — оценку плотности вероятности RSI на пивотах для поиска разворотных зон.")
kde_rsi_len = input.int(14, "RSI Длина", minval=1, group=grp_osc_kde, tooltip="Период RSI, используемый внутри KDE-модуля.")
kde_piv_len = input.int(21, "Длина Пивотов", minval=1, group=grp_osc_kde, tooltip="Период поиска пивотов high/low для накопления выборки RSI. Больше — реже обновление выборки, но надёжнее пивоты.")
kde_kernel = input.string("Gaussian", "Ядро (Kernel)", options=["Uniform", "Gaussian", "Sigmoid"], group=grp_osc_kde, tooltip="Тип кернел-функции для оценки плотности. Gaussian — самый сглаженный и распространённый вариант.")
