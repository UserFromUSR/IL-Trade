indicator("UserUZR Main - All-in-One (HTF/LTF,FVG,iFVG,CVP,S&D,SMC,OB/BB,HeatMap,LVZ,VA,POI,Fibonacci)", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=2500, max_polylines_count=100)

// ====================================================================================================================
// 0. ПРЕСЕТ ЧУВСТВИТЕЛЬНОСТИ (синхронизировать вручную с тем же пресетом в Sniper)
// ====================================================================================================================
grp_0 = "0. Пресет чувствительности (синхронизировать с Sniper)"
preset_mode = input.string("Custom", "Профиль чувствительности", options=[
  "Custom",
  "1. Ультра-скальпинг",
  "2. Скальпинг",
  "3. Скальпинг+",
  "4. Скальпинг++",
  "5. Активный скальпинг",
  "6. Быстрый скальпинг",
  "7. Микро-скальпинг",
  "8. Флэш-скальпинг",
  "9. Ультра-флэш-скальпинг"], group=grp_0,
  tooltip="Что это: общий профиль настроек всех 6 движков сразу (вместо ручной настройки каждого параметра).\n\n" +
          "Custom — все настройки ниже работают как обычные ручные инпуты, пресет не влияет ни на что.\n\n" +
          "1–9 — шкала строгости от умеренного скальпинга до предельно агрессивного. Все 9 профилей — варианты скальпинга разной степени агрессивности.\n\n" +
          "ВАЖНО: пресеты НЕ включают и НЕ выключают отдельные факторы и НЕ трогают чекбоксы 'Обязателен'. Пресет задаёт только min_score, мультипликаторы чувствительности и веса групп struct/volume/pattern для всех 6 TF движков. Синхронизируйте тот же профиль вручную в Sniper.")

var int[]   PR_SCORE_OFS_LTF1 = array.from(-5, -4, -3, -6, -7, -8, -9, -10, -12)
var int[]   PR_SCORE_OFS_LTF2 = array.from(-5, -4, -3, -6, -7, -8, -9, -10, -12)
var int[]   PR_SCORE_OFS_LTF3 = array.from(-5, -4, -3, -6, -7, -8, -9, -10, -12)
var int[]   PR_SCORE_OFS_HTF1 = array.from(-5, -4, -3, -6, -7, -8, -9, -10, -12)
var int[]   PR_SCORE_OFS_HTF2 = array.from(-5, -4, -3, -6, -7, -8, -9, -10, -12)
var int[]   PR_SCORE_OFS_HTF3 = array.from(-5, -4, -3, -6, -7, -8, -9, -10, -12)
var float[] PR_MULT_LTF       = array.from(-0.30, -0.22, -0.15, -0.35, -0.40, -0.45, -0.50, -0.55, -0.60)
var float[] PR_MULT_HTF       = array.from(-0.25, -0.18, -0.12, -0.30, -0.35, -0.40, -0.45, -0.50, -0.55)
var int[]   PR_WEIGHT_FOCUS   = array.from(3, 3, 3, 3, 3, 3, 3, 3, 3)

// ── НОВОЕ: офсеты порога Master Signal по пресету (был захардкожен как ">=9" вне системы пресетов) ──
var int[]   PR_MASTER_OFS     = array.from(-2, -1, -1, -3, -3, -4, -4, -5, -5)

f_preset_idx() =>
    int idx = -1
    if preset_mode == "1. Ультра-скальпинг"
        idx := 0
    else if preset_mode == "2. Скальпинг"
        idx := 1
    else if preset_mode == "3. Скальпинг+"
        idx := 2
    else if preset_mode == "4. Скальпинг++"
        idx := 3
    else if preset_mode == "5. Активный скальпинг"
        idx := 4
    else if preset_mode == "6. Быстрый скальпинг"
        idx := 5
    else if preset_mode == "7. Микро-скальпинг"
        idx := 6
    else if preset_mode == "8. Флэш-скальпинг"
        idx := 7
    else if preset_mode == "9. Ультра-флэш-скальпинг"
        idx := 8
    idx

int preset_idx = f_preset_idx()

f_pr_score(int base, int tf_level) =>
    int result = base
    if preset_idx >= 0
        int ofs = tf_level == 1 ? PR_SCORE_OFS_LTF1.get(preset_idx) :
                  tf_level == 2 ? PR_SCORE_OFS_LTF2.get(preset_idx) :
                  tf_level == 3 ? PR_SCORE_OFS_LTF3.get(preset_idx) :
                  tf_level == 4 ? PR_SCORE_OFS_HTF1.get(preset_idx) :
                  tf_level == 5 ? PR_SCORE_OFS_HTF2.get(preset_idx) :
                                   PR_SCORE_OFS_HTF3.get(preset_idx)
        result := math.max(1, base + ofs)
    result

f_pr_mult(float base, int tf_level) =>
    float result = base
    if preset_idx >= 0
        float ofs = tf_level <= 3 ? PR_MULT_LTF.get(preset_idx) : PR_MULT_HTF.get(preset_idx)
        result := math.max(0.05, base + ofs)
    result

f_pr_base_mult(float base, int tf_level) =>
    float result = base
    if preset_idx >= 0
        float ofs = tf_level <= 3 ? PR_MULT_LTF.get(preset_idx) : PR_MULT_HTF.get(preset_idx)
        result := math.max(0.05, base - ofs)
    result

f_pr_must_vol(bool raw, int tf_level) =>
    bool result = raw
    result

f_pr_must_smc(bool raw, int tf_level) =>
    bool result = raw
    result

f_pr_apply_focus(int w_struct, int w_volume, int w_pattern) =>
    int rs = w_struct
    int rv = w_volume
    int rp = w_pattern
    if preset_idx >= 0
        int focus = PR_WEIGHT_FOCUS.get(preset_idx)
        if focus == 1
            rs := w_struct + 1
        else if focus == 2
            rv := w_volume + 1
        else if focus == 3
            rp := w_pattern + 1
    [rs, rv, rp]

// ── НОВОЕ: преобразование порога Master Signal (раздел "СИНТЕЗ СИГНАЛОВ P1" в Части 4) через пресет ──
f_pr_master_thr(int base) =>
    int result = base
    if preset_idx >= 0
        result := math.max(3, base + PR_MASTER_OFS.get(preset_idx))
    result

// ====================================================================================================================
// 0.1 БЫСТРЫЙ ДОСТУП К ЧУВСТВИТЕЛЬНОСТИ, ВЕСАМ И СКОРИНГУ (компактно, по одной строке на TF)
// ====================================================================================================================
grp_quick = "0.1 Быстрый доступ — Чувствительность, Веса, Скоринг (по TF)"
qa_min_ltf123 = input.int(5, "Мин. сумма для OK — LTF1", minval=1, maxval=40, inline="qmin_ltf", group=grp_quick, tooltip="Минимальная взвешенная сумма факторов для LTF1. Больше — строже и реже, меньше — мягче и чаще. При выбранном пресете реально используемые значения пересчитываются через таблицы в секции 0.")
qa_min_ltf2   = input.int(6, "LTF2", minval=1, maxval=40, inline="qmin_ltf", group=grp_quick, tooltip="То же для LTF2.")
qa_min_ltf3   = input.int(7, "LTF3", minval=1, maxval=40, inline="qmin_ltf", group=grp_quick, tooltip="То же для LTF3.")
qa_min_htf1   = input.int(8, "Мин. сумма для OK — HTF1", minval=1, maxval=40, inline="qmin_htf", group=grp_quick, tooltip="Минимальная сумма факторов для HTF1.")
qa_min_htf2   = input.int(9, "HTF2", minval=1, maxval=40, inline="qmin_htf", group=grp_quick, tooltip="Минимальная сумма факторов для HTF2.")
qa_min_htf3   = input.int(11, "HTF3", minval=1, maxval=40, inline="qmin_htf", group=grp_quick, tooltip="Минимальная сумма факторов для HTF3.")

qa_w_struct_ltf1 = input.int(2, "Вес структ. — LTF1", minval=1, maxval=4, inline="qws_ltf", group=grp_quick, tooltip="Вес группы структурных факторов (SMC/OB) в скоринге LTF1.")
qa_w_struct_ltf2 = input.int(2, "LTF2", minval=1, maxval=4, inline="qws_ltf", group=grp_quick, tooltip="Вес структурных факторов для LTF2.")
qa_w_struct_ltf3 = input.int(2, "LTF3", minval=1, maxval=4, inline="qws_ltf", group=grp_quick, tooltip="Вес структурных факторов для LTF3.")
qa_w_struct_htf1 = input.int(3, "Вес структ. — HTF1", minval=1, maxval=4, inline="qws_htf", group=grp_quick, tooltip="Вес структурных факторов для HTF1.")
qa_w_struct_htf2 = input.int(4, "HTF2", minval=1, maxval=4, inline="qws_htf", group=grp_quick, tooltip="Вес структурных факторов для HTF2.")
qa_w_struct_htf3 = input.int(4, "HTF3", minval=1, maxval=4, inline="qws_htf", group=grp_quick, tooltip="Вес структурных факторов для HTF3.")

qa_w_volume_ltf1 = input.int(3, "Вес объём. — LTF1", minval=1, maxval=4, inline="qwv_ltf", group=grp_quick, tooltip="Вес группы объёмных факторов для LTF1.")
qa_w_volume_ltf2 = input.int(3, "LTF2", minval=1, maxval=4, inline="qwv_ltf", group=grp_quick, tooltip="Вес объёмных факторов для LTF2.")
qa_w_volume_ltf3 = input.int(3, "LTF3", minval=1, maxval=4, inline="qwv_ltf", group=grp_quick, tooltip="Вес объёмных факторов для LTF3.")
qa_w_volume_htf1 = input.int(2, "Вес объём. — HTF1", minval=1, maxval=4, inline="qwv_htf", group=grp_quick, tooltip="Вес объёмных факторов для HTF1.")
qa_w_volume_htf2 = input.int(2, "HTF2", minval=1, maxval=4, inline="qwv_htf", group=grp_quick, tooltip="Вес объёмных факторов для HTF2.")
qa_w_volume_htf3 = input.int(2, "HTF3", minval=1, maxval=4, inline="qwv_htf", group=grp_quick, tooltip="Вес объёмных факторов для HTF3.")

qa_w_pattern_ltf1 = input.int(1, "Вес паттерн. — LTF1", minval=1, maxval=4, inline="qwp_ltf", group=grp_quick, tooltip="Вес группы паттерн-факторов для LTF1.")
qa_w_pattern_ltf2 = input.int(1, "LTF2", minval=1, maxval=4, inline="qwp_ltf", group=grp_quick, tooltip="Вес паттерн-факторов для LTF2.")
qa_w_pattern_ltf3 = input.int(1, "LTF3", minval=1, maxval=4, inline="qwp_ltf", group=grp_quick, tooltip="Вес паттерн-факторов для LTF3.")
qa_w_pattern_htf1 = input.int(1, "Вес паттерн. — HTF1", minval=1, maxval=4, inline="qwp_htf", group=grp_quick, tooltip="Вес паттерн-факторов для HTF1.")
qa_w_pattern_htf2 = input.int(1, "HTF2", minval=1, maxval=4, inline="qwp_htf", group=grp_quick, tooltip="Вес паттерн-факторов для HTF2.")
qa_w_pattern_htf3 = input.int(1, "HTF3", minval=1, maxval=4, inline="qwp_htf", group=grp_quick, tooltip="Вес паттерн-факторов для HTF3.")

// ====================================================================================================================
// НАСТРОЙКИ МОДУЛЕЙ
// ====================================================================================================================

// ── 1. Fibonacci Projection (Zeiierman) ──────────────────────────────────────
grp_fib_main = "1. Fibonacci Projection (Zeiierman)"
en_fib     = input.bool(true, "Включить модуль Fibonacci", group=grp_fib_main, inline="fibmain", tooltip="Общий выключатель всего модуля проекции Фибоначчи (свинги, уровни, объёмные профили, Value Area).")
en_fib_vis = input.bool(true, "Показывать визуал", group=grp_fib_main, inline="fibmain", tooltip="Показывать ли графические элементы модуля при включённом расчёте. Можно скрыть визуал без отключения расчёта — значения продолжают питать LVZ и Value Area.")

grp_fib_set = "1.1 Fibonacci — Настройки расчёта"
fib_prd = input.int(100, "Период", minval=10, group=grp_fib_set, tooltip="Количество баров для поиска свинг-хая и свинг-лоу.")
// УБРАНО по запросу: вход "Уровень проекции" (fib_lvl) — был зарезервирован под нереализованный блок
// построения прогноза движения и нигде фактически не использовался в расчётах.

grp_fib_lvlstyle = "1.2 Fibonacci — Уровни (стиль)"
fib_Color236 = input.color(#f23645, "0.236", group=grp_fib_lvlstyle, inline="fc1", tooltip="Цвет уровня 23.6%.")
fib_Color382 = input.color(#81c784, "0.382", group=grp_fib_lvlstyle, inline="fc1", tooltip="Цвет уровня 38.2%.")
fib_Color500 = input.color(#4caf50, "0.500", group=grp_fib_lvlstyle, inline="fc1", tooltip="Цвет уровня 50.0%.")
fib_Color618 = input.color(#089981, "0.618", group=grp_fib_lvlstyle, inline="fc2", tooltip="Цвет уровня 61.8%.")
fib_Color786 = input.color(#64b5f6, "0.786", group=grp_fib_lvlstyle, inline="fc2", tooltip="Цвет уровня 78.6%.")
fib_LineWidth = input.int(2, "Толщина линий", minval=1, maxval=5, group=grp_fib_lvlstyle, inline="fc2", tooltip="Толщина линий уровней Фибоначчи.")
fib_showlab = input.bool(false, "Метки уровней", group=grp_fib_lvlstyle, inline="fc3", tooltip="Показывать процентные подписи возле линий уровней.")
fib_LabelColor = input.color(color.white, "Цвет текста", group=grp_fib_lvlstyle, inline="fc3", tooltip="Цвет текста подписей уровней.")
fib_LabelSizeStr = input.string("Small", "Размер", options=["Tiny","Small","Normal","Large","Huge"], group=grp_fib_lvlstyle, inline="fc3", tooltip="Размер шрифта подписей уровней.")
fib_LabelOffset = 1

fib_LabelSize = fib_LabelSizeStr == "Tiny" ? size.tiny : fib_LabelSizeStr == "Small" ? size.small : fib_LabelSizeStr == "Large" ? size.large : fib_LabelSizeStr == "Huge" ? size.huge : size.normal

grp_fib_hilo = "1.3 Fibonacci — Линии свинг High/Low"
fib_loLineColor = input.color(color.new(color.green, 0), "Цвет Low", group=grp_fib_hilo, inline="fhl", tooltip="Цвет направляющей линии последнего свинг-лоу.")
fib_hiLineColor = input.color(color.new(color.red, 0), "Цвет High", group=grp_fib_hilo, inline="fhl", tooltip="Цвет направляющей линии последнего свинг-хая.")
fib_hiloLineWidth = input.int(2, "Толщина", minval=1, maxval=5, group=grp_fib_hilo, inline="fhl", tooltip="Толщина линий свинг-хая и свинг-лоу.")

grp_fib_vp = "1.4 Fibonacci — Объёмный профиль"
fib_showFibProfile = input.bool(true, "Включить профиль объёма", group=grp_fib_vp, inline="fvp1", tooltip="Основной объёмный профиль между последним свинг-хаем и свинг-лоу. ВНИМАНИЕ: этот профиль питает LVZ (7), узлы POC/LVN/HVN (7.3) и Value Area (1.4.1) — при выключении все они теряют источник данных.")
fib_rows = input.int(10, "Строк", minval=2, maxval=100, group=grp_fib_vp, inline="fvp1", tooltip="Количество ценовых строк (бинов) в профиле объёма.")
fib_flipOrder = input.bool(false, "Поменять Bull/Bear местами", group=grp_fib_vp, inline="fvp1", tooltip="Меняет горизонтальное расположение бычьих и медвежьих объёмных баров в профиле.")
fib_bull_color = input.color(color.new(color.teal, 30), "Цвет Bull", group=grp_fib_vp, inline="fvp2", tooltip="Цвет бычьего объёма в профиле Фибоначчи.")
fib_bear_color = input.color(color.new(color.orange, 30), "Цвет Bear", group=grp_fib_vp, inline="fvp2", tooltip="Цвет медвежьего объёма в профиле Фибоначчи.")

// ── 1.4.1 Value Area (VAL/VAH/POC) ──────────────────────────
grp_fib_va = "1.4.1 Value Area (VAL/VAH/POC)"
en_va          = input.bool(true, "Включить расчёт Value Area", group=grp_fib_va, tooltip="Что это: расчёт зоны 70% объёма (по умолчанию) вокруг POC текущего Fibonacci-профиля — стандартный TPO-алгоритм расширения от самого объёмного бина. Используется LVZ confluence (раздел 7) и POI (раздел 11). Это ЕДИНСТВЕННЫЙ общий POC/VAL/VAH во всём индикаторе — подпись рисуется НАД линией.")
va_threshold   = input.float(0.70, "Порог Value Area (%)", minval=0.5, maxval=0.95, step=0.05, group=grp_fib_va, tooltip="Доля суммарного объёма профиля, которая должна попасть внутрь Value Area. Увеличение — шире зона VAL-VAH, уменьшение — уже, ближе к POC.")
va_poc_tol_atr = input.float(0.10, "Допуск 'на POC' (×ATR14)", minval=0.02, maxval=0.5, step=0.01, group=grp_fib_va, tooltip="Допуск расстояния от цены до POC (в множителях ATR14), в пределах которого цена считается 'на POC'. Увеличение — шире зона 'на POC', уменьшение — уже.")

grp_fib_va_vis = "1.4.2 Value Area — Визуал"
va_show_lines  = input.bool(true, "Показывать линии VAL/VAH/POC", group=grp_fib_va_vis, inline="vav1", tooltip="Показывать ли линии верхней/нижней границы Value Area и линию POC. Влияет только на визуал — расчёт продолжает работать при выключении.")
va_show_fill   = input.bool(true, "Заливка между VAL/VAH", group=grp_fib_va_vis, inline="vav1", tooltip="Показывать ли заливку (linefill) между линиями VAL и VAH.")
va_show_labels = input.bool(true, "Метки цены VAL/VAH/POC", group=grp_fib_va_vis, inline="vav1", tooltip="Показывать ли текстовые метки с ценой у линий VAL/VAH/POC. Метки центрируются по горизонтали над соответствующей линией.")
va_extend_bars = input.int(20, "Продление линий вправо (баров)", minval=0, maxval=200, group=grp_fib_va_vis, inline="vav2", tooltip="На сколько баров вправо от текущего продлевать линии VAL/VAH/POC и заливку. Увеличение — линии видны дальше вперёд.")
va_line_width  = input.int(1, "Толщина VAL/VAH", minval=1, maxval=5, group=grp_fib_va_vis, inline="vav2", tooltip="Толщина линий VAL и VAH.")
va_poc_width   = input.int(2, "Толщина POC", minval=1, maxval=5, group=grp_fib_va_vis, inline="vav2", tooltip="Толщина линии POC.")
va_poc_style   = input.string("Dashed", "Стиль POC", options=["Solid","Dashed","Dotted"], group=grp_fib_va_vis, inline="vav3", tooltip="Стиль линии POC (сплошная/штрих/точки).")
va_label_size  = input.string("Small", "Размер меток", options=["Tiny","Small","Normal","Large"], group=grp_fib_va_vis, inline="vav3", tooltip="Размер шрифта меток цены VAL/VAH/POC.")
va_val_color   = input.color(color.new(#2196f3, 0), "Цвет VAL", group=grp_fib_va_vis, inline="vav4", tooltip="Цвет линии нижней границы Value Area (VAL).")
va_vah_color   = input.color(color.new(#2196f3, 0), "Цвет VAH", group=grp_fib_va_vis, inline="vav4", tooltip="Цвет линии верхней границы Value Area (VAH).")
va_poc_color_ext = input.color(color.new(#ffd600, 0), "Цвет POC", group=grp_fib_va_vis, inline="vav4", tooltip="Цвет линии POC.")
va_fill_color  = input.color(color.new(#2196f3, 92), "Цвет заливки", group=grp_fib_va_vis, inline="vav5", tooltip="Цвет заливки между VAL и VAH.")
va_label_color = input.color(color.white, "Цвет текста меток", group=grp_fib_va_vis, inline="vav5", tooltip="Цвет текста меток цены VAL/VAH/POC.")

va_poc_line_style = va_poc_style == "Solid" ? line.style_solid : va_poc_style == "Dotted" ? line.style_dotted : line.style_dashed
va_label_sz = va_label_size == "Tiny" ? size.tiny : va_label_size == "Normal" ? size.normal : va_label_size == "Large" ? size.large : size.small

grp_fib_delta = "1.5 Fibonacci — Дельта-профиль объёма"
fib_showFibDelta = input.bool(false, "Включить дельта-профиль", group=grp_fib_delta, inline="fd1", tooltip="Отдельный профиль разницы (дельты) бычьего и медвежьего объёма между уровнями Фибоначчи. Визуально накладывается ПОВЕРХ объёмного профиля 1.4 (тот же диапазон баров). Питает также проверку Directional Vacuum в LVZ (раздел 3.4 ТЗ). ПРИМЕЧАНИЕ: этот профиль — самостоятельный инструмент разметки диапазона Фибоначчи, поэтому его настройки НЕ входят в унифицированный раздел 8 (тот раздел управляет только дельтой ВНУТРИ блоков FVG/iFVG, S&D, OB/Breaker, LVZ/iLVZ).")
fib_deltaMaxWidth = input.int(30, "Макс. ширина", minval=5, maxval=200, group=grp_fib_delta, inline="fd1", tooltip="Максимальная ширина (в барах) дельта-боксов в пределах диапазона объёмного профиля.")
fib_deltaBullColor = input.color(color.new(color.lime, 80), "Цвет Bull Δ", group=grp_fib_delta, inline="fd2", tooltip="Цвет полос, где бычий объём превышает медвежий.")
fib_deltaBearColor = input.color(color.new(color.red, 80), "Цвет Bear Δ", group=grp_fib_delta, inline="fd2", tooltip="Цвет полос, где медвежий объём превышает бычий.")

// ~~ Fibonacci: расчёт свингов (по текущему графику, логика Zeiierman не изменена) ──
fib_hi = ta.highest(high, fib_prd)
fib_lo = ta.lowest(low, fib_prd)

fib_isHi = high == fib_hi
fib_isLo = low == fib_lo

fib_HB = ta.barssince(fib_isHi)
fib_LB = ta.barssince(fib_isLo)

fib_hiPrice = ta.valuewhen(fib_isHi, high, 0)
fib_loPrice = ta.valuewhen(fib_isLo, low, 0)

// ====================================================================================================================
// РАЗДЕЛ II (ТЗ) — Bonus OTE Confluence: переменные-накопители.
// ====================================================================================================================
var float fib_ote_upper  = na
var float fib_ote_lower  = na
var int   export_fib_ote = 0

bool fib_trend_up = fib_HB < fib_LB
bool fib_trend_dn = fib_HB > fib_LB

if en_fib and not na(fib_hiPrice) and not na(fib_loPrice) and fib_hiPrice > fib_loPrice
    float fib_rng = fib_hiPrice - fib_loPrice
    if fib_trend_up
        fib_ote_lower  := fib_loPrice + fib_rng * 0.214
        fib_ote_upper  := fib_loPrice + fib_rng * 0.382
        export_fib_ote := (close >= fib_ote_lower and close <= fib_ote_upper) ? 1 : 0
    else if fib_trend_dn
        fib_ote_upper  := fib_hiPrice - fib_rng * 0.214
        fib_ote_lower  := fib_hiPrice - fib_rng * 0.382
        export_fib_ote := (close >= fib_ote_lower and close <= fib_ote_upper) ? -1 : 0
    else
        export_fib_ote := 0
        fib_ote_upper  := na
        fib_ote_lower  := na
else
    export_fib_ote := 0
    fib_ote_upper  := na
    fib_ote_lower  := na

fib_hiBar = ta.valuewhen(fib_isHi, bar_index, 0)
fib_loBar = ta.valuewhen(fib_isLo, bar_index, 0)

// ~~ Fibonacci: персистентные объекты отрисовки ──
var line fib_hiLine = na
var line fib_loLine = na

if barstate.isfirst
    fib_hiLine := line.new(na, na, na, na, color=fib_hiLineColor, width=fib_hiloLineWidth)
    fib_loLine := line.new(na, na, na, na, color=fib_loLineColor, width=fib_hiloLineWidth)

var array<line>  fib_fibbLines       = array.new_line()
var array<label> fib_fibbLabels      = array.new_label()
var array<box>   fib_fibProfileBoxes = array.new_box()
var array<box>   fib_fibDeltaBoxes   = array.new_box()

var float fib_top    = na
var float fib_bottom = na
var array<float> fib_volUp = array.new_float(fib_rows, 0.0)
var array<float> fib_volDn = array.new_float(fib_rows, 0.0)

// ~~ POC (7.3 удалён по запросу — узлы LVN/HVN больше не рассчитываются). Остаётся только сам POC,
// который используется Value Area (1.4.1) и confluence LVZ (7). ──
var float      fib_poc_price = na
var int        fib_poc_idx   = -1
var float      fib_poc_maxtot = na

// ~~ Value Area — персистентное состояние границ VAL/VAH ──
var float va_val_price = na
var float va_vah_price = na
var int   va_val_idx   = -1
var int   va_vah_idx   = -1
var line  va_val_line  = na
var line  va_vah_line  = na
var line  va_poc_line_local = na
var linefill va_fill_obj = na
var label va_val_lbl = na
var label va_vah_lbl = na
var label va_poc_lbl = na

if barstate.isfirst
    va_val_line := line.new(na, na, na, na, color=va_val_color, width=va_line_width)
    va_vah_line := line.new(na, na, na, na, color=va_vah_color, width=va_line_width)
    va_poc_line_local := line.new(na, na, na, na, color=va_poc_color_ext, width=va_poc_width, style=va_poc_line_style)
    va_fill_obj := linefill.new(va_val_line, va_vah_line, color=color.new(va_fill_color, 100))

// ~~ Гейты производительности: тяжёлые профильные пересчёты — не чаще 1 раза за бар. ──
var int fib_lastProfileBar = -1
var int fib_lastDeltaBar   = -1
bool    fib_doProfileCalc  = fib_lastProfileBar != bar_index
bool    fib_doDeltaCalc    = fib_lastDeltaBar   != bar_index

// ~~ Fibonacci: вспомогательные функции ──
f_fibbFunc(v, last, h, l) =>
    last ? h - (h - l) * v : l + (h - l) * v

f_fib_cleaner(a, idx) =>
    if idx >= 0 and idx < array.size(a)
        el = array.get(a, idx)
        if not na(el)
            el.delete()
        array.remove(a, idx)

// ====================================================================================================================
// Value Area — стандартный TPO-алгоритм расширения от POC (5.3 ТЗ)
// ====================================================================================================================
f_calc_value_area(array<float> volUp, array<float> volDn, int rows, int pocIdx, float totalVol, float threshold) =>
    int loIdx = pocIdx
    int hiIdx = pocIdx
    float accum = array.get(volUp, pocIdx) + array.get(volDn, pocIdx)
    float target = totalVol * threshold
    while accum < target and (loIdx > 0 or hiIdx < rows - 1)
        float loNextVol = loIdx > 0 ? array.get(volUp, loIdx - 1) + array.get(volDn, loIdx - 1) : -1.0
        float hiNextVol = hiIdx < rows - 1 ? array.get(volUp, hiIdx + 1) + array.get(volDn, hiIdx + 1) : -1.0
        if loNextVol < 0 and hiNextVol < 0
            break
        if loNextVol >= hiNextVol
            loIdx -= 1
            accum += loNextVol
        else
            hiIdx += 1
            accum += hiNextVol
    [loIdx, hiIdx]

// ~~ Fibonacci: основная логика (не изменена относительно оригинала Zeiierman) ──
if en_fib and not na(fib_HB) and not na(fib_LB) and not na(fib_hiPrice) and not na(fib_loPrice) and not na(fib_hiBar) and not na(fib_loBar)
    line.set_xy1(fib_hiLine, fib_hiBar, fib_hiPrice)
    line.set_xy2(fib_hiLine, bar_index, fib_hiPrice)
    line.set_color(fib_hiLine, en_fib_vis ? fib_hiLineColor : color.new(fib_hiLineColor, 100))
    line.set_width(fib_hiLine, fib_hiloLineWidth)

    line.set_xy1(fib_loLine, fib_loBar, fib_loPrice)
    line.set_xy2(fib_loLine, bar_index, fib_loPrice)
    line.set_color(fib_loLine, en_fib_vis ? fib_loLineColor : color.new(fib_loLineColor, 100))
    line.set_width(fib_loLine, fib_hiloLineWidth)

    for i = array.size(fib_fibbLines) - 1 to 0
        f_fib_cleaner(fib_fibbLines, i)
    for i = array.size(fib_fibbLabels) - 1 to 0
        f_fib_cleaner(fib_fibbLabels, i)

    fib_lvls = array.from(0.236, 0.382, 0.5, 0.618, 0.786)
    fib_cols = array.from(fib_Color236, fib_Color382, fib_Color500, fib_Color618, fib_Color786)

    fib_baseOffset = fib_HB > fib_LB ? fib_LB : fib_HB
    fib_xFibStart  = bar_index - fib_baseOffset

    if en_fib_vis
        for [i, e] in fib_lvls
            f  = f_fibbFunc(e, fib_HB < fib_LB, fib_hiPrice, fib_loPrice)
            x1 = fib_xFibStart
            x2 = bar_index

            ln = line.new(
             chart.point.from_index(x1, f),
             chart.point.from_index(x2, f),
             color = fib_cols.get(i),
             width = fib_LineWidth
             )
            array.push(fib_fibbLines, ln)

            if fib_showlab
                fibText = str.tostring(e * 100, "#.##") + "%"
                lbl     = label.new(
                 chart.point.from_index(x2 + fib_LabelOffset, f),
                 fibText,
                 textcolor = fib_LabelColor,
                 style      = label.style_label_left,
                 size       = fib_LabelSize,
                 color = fib_cols.get(i)
                 )
                array.push(fib_fibbLabels, lbl)

    // Fib Volume Profile — пересчитывается не чаще 1 раза за бар (fib_doProfileCalc), а не на каждом тике.
    if en_fib and fib_showFibProfile and fib_doProfileCalc and fib_hiBar != fib_loBar and not na(fib_hiPrice) and not na(fib_loPrice)
        fib_lastProfileBar := bar_index

        for i = array.size(fib_fibProfileBoxes) - 1 to 0
            f_fib_cleaner(fib_fibProfileBoxes, i)

        fib_top    := math.max(fib_hiPrice, fib_loPrice)
        fib_bottom := math.min(fib_hiPrice, fib_loPrice)

        if fib_top != fib_bottom
            fib_step = (fib_top - fib_bottom) / fib_rows

            fib_levels = array.new_float()
            for i = 0 to fib_rows
                array.push(fib_levels, fib_bottom + fib_step * i)

            for i = 0 to fib_rows - 1
                array.set(fib_volUp, i, 0.0)
                array.set(fib_volDn, i, 0.0)

            fib_startBar = math.min(fib_hiBar, fib_loBar)
            fib_endBar   = math.max(fib_hiBar, fib_loBar)

            for bi = fib_startBar to fib_endBar
                offset = bar_index - bi
                price  = hlc3[offset]
                vol    = volume[offset]
                bull   = close[offset] > open[offset]

                for r = 0 to fib_rows - 1
                    dn = array.get(fib_levels, r)
                    up = array.get(fib_levels, r + 1)
                    if price >= dn and price < up
                        if bull
                            array.set(fib_volUp, r, array.get(fib_volUp, r) + vol)
                        else
                            array.set(fib_volDn, r, array.get(fib_volDn, r) + vol)
                        break

            float fib_maxTot = 0.0
            int   fib_poc_idx_local = 0
            for r = 0 to fib_rows - 1
                float binTot = array.get(fib_volUp, r) + array.get(fib_volDn, r)
                if binTot > fib_maxTot
                    fib_maxTot := binTot
                    fib_poc_idx_local := r
            fib_poc_idx   := fib_poc_idx_local
            fib_poc_price := fib_bottom + fib_step * (fib_poc_idx_local + 0.5)
            fib_poc_maxtot := fib_maxTot

            // ── Value Area: расчёт сразу после POC, throttled тем же fib_doProfileCalc (5.3 ТЗ) ──
            if en_va and fib_maxTot > 0
                float fib_totalVol = 0.0
                for r = 0 to fib_rows - 1
                    fib_totalVol += array.get(fib_volUp, r) + array.get(fib_volDn, r)
                [va_lo_idx, va_hi_idx] = f_calc_value_area(fib_volUp, fib_volDn, fib_rows, fib_poc_idx_local, fib_totalVol, va_threshold)
                va_val_idx   := va_lo_idx
                va_vah_idx   := va_hi_idx
                va_val_price := fib_bottom + fib_step * va_lo_idx
                va_vah_price := fib_bottom + fib_step * (va_hi_idx + 1)

            fib_span = fib_endBar - fib_startBar + 1

            if fib_maxTot > 0 and en_fib_vis
                for r = 0 to fib_rows - 1
                    upVol = array.get(fib_volUp, r)
                    dnVol = array.get(fib_volDn, r)

                    normUp = upVol == 0 ? 0 : int((upVol / fib_maxTot) * fib_span)
                    normDn = dnVol == 0 ? 0 : int((dnVol / fib_maxTot) * fib_span)

                    bullRowCol = color.from_gradient(r, 0, fib_rows - 1, color.new(fib_bull_color, 80), color.new(fib_bull_color, 10))
                    bearRowCol = color.from_gradient(r, 0, fib_rows - 1, color.new(fib_bear_color, 80), color.new(fib_bear_color, 10))

                    yTop    = array.get(fib_levels, r + 1)
                    yBottom = array.get(fib_levels, r)

                    leftBull  = fib_flipOrder ? fib_startBar : fib_startBar + normDn
                    rightBull = fib_flipOrder ? fib_startBar + normUp : fib_startBar + normDn + normUp

                    leftBear  = fib_flipOrder ? fib_startBar + normUp : fib_startBar
                    rightBear = fib_flipOrder ? fib_startBar + normUp + normDn : fib_startBar + normDn

                    if normUp > 0
                        bBull = box.new(
                         leftBull,  yTop,
                         rightBull, yBottom,
                         bgcolor      = bullRowCol,
                         border_color = color.new(bullRowCol, 0),
                         border_style = line.style_dotted
                         )
                        array.push(fib_fibProfileBoxes, bBull)

                    if normDn > 0
                        bBear = box.new(
                         leftBear,  yTop,
                         rightBear, yBottom,
                         bgcolor      = bearRowCol,
                         border_color = color.new(bearRowCol, 0),
                         border_style = line.style_dotted
                         )
                        array.push(fib_fibProfileBoxes, bBear)

    // Fib Volume Delta Profile — визуал-онли, пересчёт также не чаще 1 раза за бар (fib_doDeltaCalc).
    if en_fib_vis and fib_showFibDelta and fib_doDeltaCalc and fib_hiBar != fib_loBar and not na(fib_hiPrice) and not na(fib_loPrice)
        fib_lastDeltaBar := bar_index

        for i = array.size(fib_fibDeltaBoxes) - 1 to 0
            f_fib_cleaner(fib_fibDeltaBoxes, i)

        fib_fibPrices = array.new_float()
        array.push(fib_fibPrices, fib_hiPrice)
        for e in fib_lvls
            lvlPrice = f_fibbFunc(e, fib_HB < fib_LB, fib_hiPrice, fib_loPrice)
            array.push(fib_fibPrices, lvlPrice)
        array.push(fib_fibPrices, fib_loPrice)

        fib_fibSorted = array.copy(fib_fibPrices)
        array.sort(fib_fibSorted)

        fib_bandsCount = array.size(fib_fibSorted) - 1
        if fib_bandsCount > 0
            fib_bandBull = array.new_float(fib_bandsCount, 0.0)
            fib_bandBear = array.new_float(fib_bandsCount, 0.0)

            fib_startBar2 = math.min(fib_hiBar, fib_loBar)
            fib_endBar2   = math.max(fib_hiBar, fib_loBar)

            for bi = fib_startBar2 to fib_endBar2
                offset = bar_index - bi
                price  = hlc3[offset]
                vol    = volume[offset]
                bull   = close[offset] > open[offset]

                for b = 0 to fib_bandsCount - 1
                    bandLow  = array.get(fib_fibSorted, b)
                    bandHigh = array.get(fib_fibSorted, b + 1)
                    if price >= bandLow and price < bandHigh
                        if bull
                            array.set(fib_bandBull, b, array.get(fib_bandBull, b) + vol)
                        else
                            array.set(fib_bandBear, b, array.get(fib_bandBear, b) + vol)
                        break

            fib_maxAbsDelta = 0.0
            for b = 0 to fib_bandsCount - 1
                delta = array.get(fib_bandBull, b) - array.get(fib_bandBear, b)
                fib_maxAbsDelta := math.max(fib_maxAbsDelta, math.abs(delta))

            if fib_maxAbsDelta > 0
                int fib_deltaSpanBars = math.max(fib_endBar2 - fib_startBar2, 1)

                for b = 0 to fib_bandsCount - 1
                    bandLow  = array.get(fib_fibSorted, b)
                    bandHigh = array.get(fib_fibSorted, b + 1)

                    delta = array.get(fib_bandBull, b) - array.get(fib_bandBear, b)
                    if delta == 0
                        continue

                    absDelta  = math.abs(delta)
                    widthBars = int((absDelta / fib_maxAbsDelta) * math.min(fib_deltaMaxWidth, fib_deltaSpanBars))
                    widthBars := math.max(widthBars, 1)

                    xEnd   = fib_endBar2
                    xStart = math.max(fib_startBar2, fib_endBar2 - widthBars)
                    col    = delta >= 0 ? fib_deltaBullColor : fib_deltaBearColor

                    dBox = box.new(
                     xStart,  bandHigh,
                     xEnd,    bandLow,
                     bgcolor      = col,
                     border_color = color.new(col, 0),
                     border_style = line.style_solid,
                     text         = "Δ " + str.tostring(delta, format.volume),
                     text_color   = color.white,
                     text_halign  = "center",
                     text_valign  = "center"
                     )
                    array.push(fib_fibDeltaBoxes, dBox)

// ~~ Value Area: обновление отрисовки (каждый бар, независимо от throttle расчёта) ──
if en_va
    if not na(va_val_price) and not na(va_vah_price)
        if va_show_lines
            line.set_xy1(va_val_line, bar_index - 1, va_val_price)
            line.set_xy2(va_val_line, bar_index + va_extend_bars, va_val_price)
            line.set_color(va_val_line, va_val_color)
            line.set_xy1(va_vah_line, bar_index - 1, va_vah_price)
            line.set_xy2(va_vah_line, bar_index + va_extend_bars, va_vah_price)
            line.set_color(va_vah_line, va_vah_color)
            if not na(fib_poc_price)
                line.set_xy1(va_poc_line_local, bar_index - 1, fib_poc_price)
                line.set_xy2(va_poc_line_local, bar_index + va_extend_bars, fib_poc_price)
                line.set_color(va_poc_line_local, va_poc_color_ext)
            else
                line.set_color(va_poc_line_local, color.new(va_poc_color_ext, 100))
        else
            line.set_color(va_val_line, color.new(va_val_color, 100))
            line.set_color(va_vah_line, color.new(va_vah_color, 100))
            line.set_color(va_poc_line_local, color.new(va_poc_color_ext, 100))

        linefill.set_color(va_fill_obj, va_show_fill ? va_fill_color : color.new(va_fill_color, 100))

        if va_show_labels and barstate.islast
            if not na(va_val_lbl)
                label.delete(va_val_lbl)
            if not na(va_vah_lbl)
                label.delete(va_vah_lbl)
            if not na(va_poc_lbl)
                label.delete(va_poc_lbl)
            int va_lbl_x = int(math.avg(bar_index - 1, bar_index + va_extend_bars))
            va_val_lbl := label.new(va_lbl_x, va_val_price, "VAL " + str.tostring(va_val_price, format.mintick), style=label.style_label_down, color=color.new(color.white,100), textcolor=va_label_color, size=va_label_sz, textalign=text.align_center)
            va_vah_lbl := label.new(va_lbl_x, va_vah_price, "VAH " + str.tostring(va_vah_price, format.mintick), style=label.style_label_down, color=color.new(color.white,100), textcolor=va_label_color, size=va_label_sz, textalign=text.align_center)
            if not na(fib_poc_price)
                va_poc_lbl := label.new(va_lbl_x, fib_poc_price, "POC " + str.tostring(fib_poc_price, format.mintick), style=label.style_label_down, color=color.new(color.white,100), textcolor=va_label_color, size=va_label_sz, textalign=text.align_center)
    else
        line.set_color(va_val_line, color.new(va_val_color, 100))
        line.set_color(va_vah_line, color.new(va_vah_color, 100))
        line.set_color(va_poc_line_local, color.new(va_poc_color_ext, 100))
        linefill.set_color(va_fill_obj, color.new(va_fill_color, 100))
else
    line.set_color(va_val_line, color.new(va_val_color, 100))
    line.set_color(va_vah_line, color.new(va_vah_color, 100))
    line.set_color(va_poc_line_local, color.new(va_poc_color_ext, 100))
    linefill.set_color(va_fill_obj, color.new(va_fill_color, 100))

// ── Экспортное состояние позиции цены относительно Value Area (используется в Части 4 для plot) ──
va_export_position() =>
    int result = 0
    if not na(va_val_price) and not na(va_vah_price) and not na(fib_poc_price)
        if close < va_val_price
            result := 0
        else if close > va_vah_price
            result := 4
        else if math.abs(close - fib_poc_price) <= ta.atr(14) * va_poc_tol_atr
            result := 2
        else if close < fib_poc_price
            result := 1
        else
            result := 3
    result

int export_va_position = va_export_position()

// ── 2. Clusters Volume Profile ───────────────────────────────────────────────
grp_1      = "2. Clusters Volume Profile"
en_1       = input.bool(true,  "Включить Clusters VP",          group=grp_1, tooltip="Общий выключатель модуля кластерного объёмного профиля (K-Means по цене и объёму).")
lookback_1 = input.int(200,    "Период (Lookback)",  minval=10,  group=grp_1, tooltip="Количество баров истории для построения кластеров.")
k_1        = input.int(5,      "Количество кластеров", minval=2, maxval=10, group=grp_1, tooltip="На сколько ценовых кластеров K-Means разбивает диапазон.")
iters_1    = input.int(50,     "Итерации K-Means",  minval=5,   maxval=50,  group=grp_1, tooltip="Число итераций алгоритма K-Means для сходимости центров.")
rows_1     = input.int(20,     "Строк на кластер (Bins)", minval=3, group=grp_1, tooltip="На сколько строк делится каждый кластер для профиля объёма внутри.")
vpWidth    = input.int(40,     "Ширина гистограммы (бары)", minval=5, group=grp_1, tooltip="Максимальная ширина столбцов профиля объёма.")
vpOffset   = input.int(10,     "Отступ гистограммы",          group=grp_1, tooltip="Горизонтальный отступ гистограммы от последнего бара.")
showDots   = input.bool(true,  "Точки прайса (Price Dots)",     group=grp_1, tooltip="Показывать ли точки цены (hl2) внутри каждого кластера.")

// ── 3. FVG Volume Profile ────────────────────────────────────────────────────
grp_2          = "3. FVG Volume Profile [ChartPrime]"
en_2           = input.bool(true,   "Включить FVG VP",                   group=grp_2, tooltip="Общий выключатель модуля объёмного профиля внутри Fair Value Gap.")
fvg_autoTf     = input.bool(true,   "Auto",          inline="1",          group=grp_2, tooltip="Автоматический выбор младшего ТФ для подсчёта объёма внутри FVG.")
fvg_tf1        = input.timeframe("10", "",            inline="1",          group=grp_2, tooltip="Custom timeframe for detecting volume of Fair Value Gaps. Используется только если Auto выключен.")
fvg_hideVP     = input.bool(true,   "Display",                            group=grp_2, tooltip="Показывать ли визуальный профиль объёма внутри FVG.")
fvg_bins       = input.int(10,      "Resolution",                         group=grp_2, tooltip="Количество ценовых бинов для построения профиля объёма внутри FVG.")
fvg_gap_filter = input.float(0.3,   "Filter Gaps",   step=0.01,           group=grp_2, tooltip="Минимальный нормализованный размер гэпа для признания его валидным FVG.")
fvg_bull_color = input.color(#1da370, "Bullish Color",                    group=grp_2, tooltip="Цвет бычьего FVG.")
fvg_bear_color = input.color(#bc25d6, "Bearish Color",                    group=grp_2, tooltip="Цвет медвежьего FVG.")
fvg_show_type_label = input.bool(true, "Имя по центру блока (FVG/iFVG)", group=grp_2, tooltip="Показывать компактную центрированную метку 'FVG' или 'iFVG' точно в центре бокса гэпа — только имя, без описания, чтобы визуально сразу отличать обычный FVG от инверсионного.")
fvg_type_label_color = input.color(color.white, "Цвет текста имени", group=grp_2, tooltip="Цвет текста центрированной метки FVG/iFVG.")
fvg_type_label_size = input.string("Small", "Размер имени", options=["Tiny","Small","Normal"], group=grp_2, tooltip="Размер шрифта центрированной метки FVG/iFVG.")
fvg_show_quality_shade = input.bool(true, "Прозрачность блока по качеству (confluence)", group=grp_2, tooltip="Чем выше расчётное схождение факторов (OB/S&D/Value Area) в момент образования гэпа, тем менее прозрачным (более заметным) рисуется блок FVG/iFVG. При выключении используется обычная фиксированная прозрачность цвета блока. Если в разделе 8.2 включено скрытие некачественных элементов и прозрачность блока превышает заданный там порог — блок не рисуется вовсе.")

// ── 3.1 iFVG (Инверсионный Fair Value Gap) ─────────────────────
grp_2_ifvg = "3.1 iFVG (Инверсионный FVG)"
en_ifvg = input.bool(true, "Включить детекцию iFVG", group=grp_2_ifvg, tooltip="Что это: обнаружение инверсионного FVG — когда новый FVG формируется на месте недавно сломанного FVG противоположного направления (память сохраняется отдельно). Такой FVG считается более значимым разворотным сигналом.")
ifvg_pair_window = input.int(8, "Окно спаривания (баров)", minval=1, maxval=50, group=grp_2_ifvg, tooltip="Сколько баров после слома старого FVG ещё разрешено спаривать его со свежим FVG противоположного направления для признания iFVG. Увеличение — шире окно спаривания, больше iFVG находится. Уменьшение — строже, только очень свежие развороты.")
ifvg_bull_color = input.color(#2E6BFF, "Цвет iFVG Bull", group=grp_2_ifvg, inline="ifvgc", tooltip="Цвет бычьего iFVG — отдельный от обычного FVG для визуального различения.")
ifvg_bear_color = input.color(#FF8A1F, "Цвет iFVG Bear", group=grp_2_ifvg, inline="ifvgc", tooltip="Цвет медвежьего iFVG.")
// УБРАНО: ifvg_show_delta / ifvg_delta_bins / ifvg_delta_max_width / ifvg_delta_bull_color / ifvg_delta_bear_color —
// перенесены в единый раздел "8. Дельта-объём и Value Area блоков" и теперь управляют дельтой FVG/iFVG,
// S&D, OB/Breaker и LVZ/iLVZ ОДНИМ набором настроек (dva_*).

// ── 3.2 FVG/iFVG — Собственные POC/VAL/VAH ─────────────────────
// УБРАНО: fvg_show_own_va / fvg_own_va_threshold — перенесены в единый раздел 8.3 (dva_show_own_va,
// dva_own_va_threshold), т.к. пользователь просил один набор настроек VAL/VAH/POC для всех блоков.

// ── 4. Supply & Demand ───────────────────────────────────────────────────────
