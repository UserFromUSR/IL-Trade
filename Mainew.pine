plot(g_htf3_sb*100 + g_htf3_ss, title="[P1] HTF3 Score Pack", display=display.data_window)

plot(e1_min_score*1e4 + e2_min_score*1e2 + e3_min_score, title="[P1] Min Score Pack A", display=display.data_window)
