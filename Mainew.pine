// ====================================================================================================================
// ГЛОБАЛЬНЫЕ СЧЁТЧИКИ TF
// ====================================================================================================================

int g_ltf_bull_cnt = (g_ltf1_sb >= e1_min_score ? 1 : 0) + (g_ltf2_sb >= e2_min_score ? 1 : 0) + (g_ltf3_sb >= e3_min_score ? 1 : 0)
int g_ltf_bear_cnt = (g_ltf1_ss >= e1_min_score ? 1 : 0) + (g_ltf2_ss >= e2_min_score ? 1 : 0) + (g_ltf3_ss >= e3_min_score ? 1 : 0)
int g_htf_bull_cnt = (g_htf1_sb >= e4_min_score ? 1 : 0) + (g_htf2_sb >= e5_min_score ? 1 : 0) + (g_htf3_sb >= e6_min_score ? 1 : 0)
int g_htf_bear_cnt = (g_htf1_ss >= e4_min_score ? 1 : 0) + (g_htf2_ss >= e5_min_score ? 1 : 0) + (g_htf3_ss >= e6_min_score ? 1 : 0)

int htf_bull_conf = g_htf_bull_cnt
int htf_bear_conf = g_htf_bear_cnt

// ====================================================================================================================
// FVG GLOBAL DATA REQUESTS (CHARTPRIME)
// ====================================================================================================================

float fvg_time_       = timeframe.in_seconds(fvg_tf1) / 60
float fvg_currentTime = timeframe.in_seconds("") / 60
string fvg_req_tf     = fvg_time_ >= fvg_currentTime and not fvg_autoTf ? "" : (fvg_autoTf ? str.tostring(int(fvg_currentTime / 10)) : fvg_tf1)
array<float> fvg_c = request.security_lower_tf(syminfo.tickerid, fvg_req_tf, close)
array<float> fvg_v = request.security_lower_tf(syminfo.tickerid, fvg_req_tf, volume)

float fvg_bearish_gap_size = (low[2] - high)  / math.max(ta.stdev(low[2] - high,  200), 1e-10)
float fvg_bullish_gap_size = (low  - high[2]) / math.max(ta.stdev(low  - high[2], 200), 1e-10)

// ====================================================================================================================
// ОБЩИЕ ХЕЛПЕРЫ: дельта-профиль объёма по бинам за окно истории (для OB/Breaker, S&D, LVZ/iLVZ) и перевод
// "качества" (0..1) в прозрачность бокса. Для FVG/iFVG используется отдельный, более точный метод на
// тиковых данных младшего ТФ (f_ifvg_delta_profile, см. Часть 3). f_dva_visible/f_dva_txsz — из раздела 8.
// ====================================================================================================================
f_delta_profile_generic(float rangeLo, float rangeHi, int lookback, int bins) =>
    array<float> dBull = array.new_float(bins, 0.0)
    array<float> dBear = array.new_float(bins, 0.0)
    float step = (rangeHi - rangeLo) / bins
    int startBar = math.max(0, math.min(lookback, bar_index))
    if step > 0
        for i = 0 to startBar - 1
            float price = hlc3[i]
            float vol = volume[i]
            bool bull = close[i] > open[i]
            if price >= rangeLo and price < rangeHi
                int idx = int((price - rangeLo) / step)
                idx := math.max(0, math.min(bins - 1, idx))
                if bull
                    array.set(dBull, idx, array.get(dBull, idx) + vol)
                else
                    array.set(dBear, idx, array.get(dBear, idx) + vol)
    [dBull, dBear]

f_quality_alpha(float ratio) =>
    int(math.max(15, 85 - math.max(0.0, math.min(ratio, 1.0)) * 70))
    
// ====================================================================================================================
// НОВОЕ по запросу: сопоставление цены (POC/VAL/VAH) с бином дельта-гистограммы того же блока —
// возвращает ширину линии в барах (равную ширине соответствующего бина дельты) и признак того, что
// эта цена попадает именно в бин с максимальной по модулю дельтой (для solid/dashed стиля).
// Используется одинаково и для FVG/iFVG, и для LVZ/iLVZ (раздел 8.3).
// ====================================================================================================================
f_dva_bin_match(float price, float rangeLo, float rangeHi, int bins, array<float> dBull, array<float> dBear, int maxIdx, float maxAbsD, int maxWidthBars) =>
    float step = bins > 0 ? (rangeHi - rangeLo) / bins : 0.0
    int idx = 0
    if step > 0
        idx := math.max(0, math.min(bins - 1, int((price - rangeLo) / step)))
    float d = (array.size(dBull) > idx and array.size(dBear) > idx) ? array.get(dBull, idx) - array.get(dBear, idx) : 0.0
    int wBars = 1
    if maxAbsD > 0 and d != 0
        wBars := math.max(1, int((math.abs(d) / maxAbsD) * maxWidthBars))
    bool isMax = maxIdx >= 0 and idx == maxIdx
    [wBars, isMax]

// ~~ то же самое, но в МИЛЛИСЕКУНДАХ — для блоков, использующих xloc.bar_time (OB/Breaker, S&D) ──
f_dva_bin_match_ms(float price, float rangeLo, float rangeHi, int bins, array<float> dBull, array<float> dBear, int maxIdx, float maxAbsD, int maxWidthBars, float barDurMs) =>
    float step = bins > 0 ? (rangeHi - rangeLo) / bins : 0.0
    int idx = 0
    if step > 0
        idx := math.max(0, math.min(bins - 1, int((price - rangeLo) / step)))
    float d = (array.size(dBull) > idx and array.size(dBear) > idx) ? array.get(dBull, idx) - array.get(dBear, idx) : 0.0
    float wMs = barDurMs
    if maxAbsD > 0 and d != 0
        wMs := (math.abs(d) / maxAbsD) * maxWidthBars * barDurMs
    bool isMax = maxIdx >= 0 and idx == maxIdx
    [int(wMs), isMax]
    
// ====================================================================================================================
// МЕТОДЫ И ФУНКЦИИ SMC & OB
// ====================================================================================================================

method txSz(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        "Auto"   => size.auto
        => size.auto

method lstyle(string style) => style == "----" ? line.style_dashed : line.style_solid

f_IDMIDX(bool use_max, int loc) =>
    float min = 99999999.
    float max = 0.
    int   idx = 0
    int limit = math.min(bar_index - loc, 200)
    if use_max
        for i = 0 to limit
            max := math.max(high[i], max)
            min := max == high[i] ? low[i]  : min
            idx := max == high[i] ? i       : idx
    else
        for i = 0 to limit
            min := math.min(low[i], min)
            max := min == low[i]  ? high[i] : max
            idx := min == low[i]  ? i       : idx
    idx

f_mapping() =>
    var float         up      = na
    var float         dn      = na
    var float         point   = na
    var int           trend   = 0
    var int           idx     = na
    var int           sum     = na
    var int           project = na
    var chart.point[] charts  = array.new<chart.point>()
    if na(up)
        up := high, idx := bar_index
    if na(dn)
        dn := low,  idx := bar_index
    if high > up
        if trend == -1
            int id = f_IDMIDX(false, idx)
            charts.unshift(chart.point.from_time(time[id], low[id]))
            idx := bar_index, point := low[id], sum := time[id]
        up := high, dn := low, project := time, trend := 1
    if low < dn
        if trend == 1
            int id = f_IDMIDX(true, idx)
            charts.unshift(chart.point.from_time(time[id], high[id]))
            idx := bar_index, point := high[id], sum := time[id]
        up := high, dn := low, project := time, trend := -1
    if barstate.islast
        var line     ln = na
        var polyline pl = na
        ln.delete(), pl.delete()
        ln := line.new(x1=sum, x2=project, y1=point, y2=trend == 1 ? up : dn, xloc=xloc.bar_time, color=color.red)
        pl := polyline.new(charts, line_color=bb_mappingcss, xloc=xloc.bar_time, line_style=bb_mappingStyle.lstyle())

method find(structure ms, bool use_max, bool sweep, bool useob) =>
    float min    = 99999999.
    float max    = 0.
    int   idx    = 0
    int   limit  = math.min(bar_index - ms.xloc, 200)
    int   loop_e = (limit - 1) > 0 ? limit - 1 : limit
    if use_max
        for i = 0 to loop_e
            max := math.max(high[i], max)
            min := max == high[i] ? low[i]  : min
            idx := max == high[i] ? i       : idx
        if useob and high[idx + 1] > high[idx]
            max := high[idx + 1], min := low[idx + 1], idx := idx + 1
    else
        for i = 0 to loop_e
            min := math.min(low[i], min)
            max := min == low[i]  ? high[i] : max
            idx := min == low[i]  ? i       : idx
        if useob and low[idx + 1] < low[idx]
            max := high[idx + 1], min := low[idx + 1], idx := idx + 1
    idx

method fnOB(ob[] block, bool bull, float cords, int idx) =>
    switch bull
        true =>
            blobenter.normal  := false
            blobenter.breaker := false
            block.unshift(ob.new(true, cords, low[idx], math.avg(cords, low[idx]), time[idx], bb_obupcs, volume[idx], close[idx] > open[idx] ? 1 : -1, 1, 1, 1, time[idx], time[idx], false, time[idx], 0))
        false =>
            brobenter.normal  := false
            brobenter.breaker := false
            block.unshift(ob.new(false, high[idx], cords, math.avg(cords, high[idx]), time[idx], bb_obdncs, volume[idx], close[idx] > open[idx] ? 1 : -1, 1, 1, 1, time[idx], time[idx], false, time[idx], 0))

method mitigated(ob[] block) =>
    if barstate.isconfirmed and block.size() > 0
        for i = block.size() - 1 to 0
            stuff = block.get(i)
            if not stuff.isbb
                switch stuff.bull
                    true =>
                        if bb_obmiti == "Close" ? math.min(close, open) < stuff.btm : bb_obmiti == "Wick" ? low < stuff.btm : bb_obmiti == "Avg" ? low < stuff.avg : false
                            stuff.isbb := true, stuff.bbloc := time
                            if not bb_obshowbb
                                block.remove(i)
                    false =>
                        if bb_obmiti == "Close" ? math.max(close, open) > stuff.top : bb_obmiti == "Wick" ? high > stuff.top : bb_obmiti == "Avg" ? high > stuff.avg : false
                            stuff.isbb := true, stuff.bbloc := time
                            if not bb_obshowbb
                                block.remove(i)
            else
                switch stuff.bull
                    true =>
                        if bb_obmiti == "Close" ? math.max(close, open) > stuff.top : bb_obmiti == "Wick" ? high > stuff.top : bb_obmiti == "Avg" ? high > stuff.avg : false
                            block.remove(i)
                    false =>
                        if bb_obmiti == "Close" ? math.min(close, open) < stuff.btm : bb_obmiti == "Wick" ? low < stuff.btm : bb_obmiti == "Avg" ? low < stuff.avg : false
                            block.remove(i)

f_zones_overlap(float t1, float b1, float t2, float b2) =>
    (b1 > b2 and b1 < t2) or (t1 < t2 and b1 > b2) or (t1 > t2 and b1 < b2) or (t1 < t2 and t1 > b2)

f_overlap(ob[] bull, ob[] bear) =>
    if bull.size() > 1
        for i = bull.size() - 1 to 1
            stuff = bull.get(i), current = bull.get(0)
            if f_zones_overlap(stuff.top, stuff.btm, current.top, current.btm)
                bull.remove(bb_wichlap == "Recent" ? i : 0)
    if bear.size() > 1
        for i = bear.size() - 1 to 1
            stuff = bear.get(i), current = bear.get(0)
            if f_zones_overlap(stuff.top, stuff.btm, current.top, current.btm)
                bear.remove(bb_wichlap == "Recent" ? i : 0)
    if bull.size() > 0 and bear.size() > 0
        for i = bull.size() - 1 to 0
            stuff = bull.get(i), current = bear.get(0)
            if f_zones_overlap(stuff.top, stuff.btm, current.top, current.btm)
                bull.remove(bb_wichlap == "Recent" ? 0 : i)
    if bull.size() > 0 and bear.size() > 0
        for i = bear.size() - 1 to 0
            stuff = bear.get(i), current = bull.get(0)
            if f_zones_overlap(stuff.top, stuff.btm, current.top, current.btm)
                bear.remove(bb_wichlap == "Recent" ? 0 : i)

method umt(ob metric) =>
    switch metric.dir
        1 =>
            switch metric.move
                1 => metric.blPOS += 1, metric.move := 2
                2 => metric.blPOS += 1, metric.move := 3
                3 => metric.brPOS += 1, metric.move := 1
        -1 =>
            switch metric.move
                1 => metric.brPOS += 1, metric.move := 2
                2 => metric.brPOS += 1, metric.move := 3
                3 => metric.blPOS += 1, metric.move := 1
    if (time - time[1]) == (time[1] - time[2])
        metric.xlocbl := metric.loc + (time - time[1]) * metric.blPOS
        metric.xlocbr := metric.loc + (time - time[1]) * metric.brPOS

// ── f_display — ИЗМЕНЕНО по запросу: максимальный по модулю бин дельты внутри блока OB/Breaker больше
// НЕ перекрашивается отдельным цветом (dva_delta_max_color убран). Вместо этого заливка полосы
// остаётся обычной bull/bear (dva_delta_bull_color/dva_delta_bear_color — видно сторону), а сам
// максимальный бин получает контрастную РАМКУ (dva_max_border_color/dva_max_border_width) — видно
// одновременно и величину, и то, покупатель это или продавец. Текст дельты выровнен по левому краю
// полосы. Если dva_hide_low_quality включён и расчётная прозрачность блока превышает
// dva_quality_alpha_thr — блок (включая рамку, имя, метрики и дельту) не рисуется вовсе. ──
f_display(ob id, ob[] full, int i, float dV_val) =>
    int obShadeAlpha = f_quality_alpha(dV_val / 100.0)
    bool obVisible = f_dva_visible(obShadeAlpha)

    if obVisible
        if not id.isbb
            bin.bx.unshift(box.new(top=id.top, bottom=id.btm, left=id.loc, right=time, border_color=na, bgcolor=id.css, xloc=xloc.bar_time))
            bin.bx.unshift(box.new(top=id.top, bottom=id.btm, left=time, right=time + 1, border_color=na, bgcolor=id.css, xloc=xloc.bar_time, extend=extend.right))
        else
            bin.bx.unshift(box.new(top=id.top, bottom=id.btm, left=id.loc, right=id.bbloc, border_color=na, bgcolor=id.css, xloc=xloc.bar_time))
            bin.bx.unshift(box.new(top=id.top, bottom=id.btm, left=id.bbloc, right=time, border_color=id.css, bgcolor=id.bull ? bb_bbup : bb_bbdn, xloc=xloc.bar_time, border_width=2))
            bin.bx.unshift(box.new(top=id.top, bottom=id.btm, left=time, right=time + 1, border_color=id.css, bgcolor=id.bull ? bb_bbup : bb_bbdn, xloc=xloc.bar_time, extend=extend.right))
        if bb_obshowactivity
            bin.bx.unshift(box.new(top=id.top, bottom=id.avg, left=id.loc, right=id.xlocbl, border_color=na, bgcolor=bb_obactup, xloc=xloc.bar_time))
            bin.bx.unshift(box.new(top=id.avg, bottom=id.btm, left=id.loc, right=id.xlocbr, border_color=na, bgcolor=bb_obactdn, xloc=xloc.bar_time))
        if bb_showline
            bin.ln.unshift(line.new(x1=id.loc, x2=time, y1=id.avg, y2=id.avg, color=color.new(id.css, 0), xloc=xloc.bar_time, style=line.style_dashed))
        if bb_showmetric
            bin.lb.unshift(label.new(bar_index - 1, id.avg, textcolor=color.new(id.css, 0), style=label.style_label_left, size=bb_obtxt.txSz(), color=#ffffff00, text=str.tostring(math.round(id.vol, 3), format=format.volume) + " (" + str.tostring(dV_val) + "%)"))

        // ── имя блока по центру, без описания ──
        if bb_show_name_label
            int   nameX = int(math.avg(id.loc, id.isbb ? id.bbloc : time))
            float nameY = math.avg(id.top, id.btm)
            bin.lb.unshift(label.new(nameX, nameY, id.isbb ? "Breaker" : "OB", xloc=xloc.bar_time, style=label.style_label_center, color=color.new(color.white, 100), textcolor=bb_name_label_color, size=bb_name_label_size == "Tiny" ? size.tiny : bb_name_label_size == "Normal" ? size.normal : size.small, textalign=text.align_center))

        // ── прозрачность блока по доле объёма ──
        if bb_show_quality_shade
            bin.bx.unshift(box.new(top=id.top, bottom=id.btm, left=id.loc, right=id.isbb ? id.bbloc : time, border_color=na, bgcolor=color.new(id.css, obShadeAlpha), xloc=xloc.bar_time))

        // ── дельта-профиль блока (единые настройки раздела 8) — считается один раз, питает и
        // гистограмму дельты, и собственные POC/VAL/VAH. Максимальный по модулю бин дельты: заливка
        // обычная bull/bear, рамка — dva_max_border_color/width. ──
        if dva_show_delta or dva_show_own_va
            [obDeltaBull, obDeltaBear] = f_delta_profile_generic(id.btm, id.top, bb_swingLimit, dva_delta_bins)
            float obStep   = (id.top - id.btm) / dva_delta_bins
            float obMaxAbs = 0.0
            int   obMaxIdx = -1
            for bnk = 0 to dva_delta_bins - 1
                float d0 = array.get(obDeltaBull, bnk) - array.get(obDeltaBear, bnk)
                if math.abs(d0) > obMaxAbs
                    obMaxAbs := math.abs(d0)
                    obMaxIdx := bnk
            float barDurMs = time - time[1]

            if dva_show_delta and obMaxAbs > 0
                for bnk = 0 to dva_delta_bins - 1
                    float bandLo = id.btm + obStep * bnk
                    float bandHi = bandLo + obStep
                    float d = array.get(obDeltaBull, bnk) - array.get(obDeltaBear, bnk)
                    if d != 0
                        float widthMs = (math.abs(d) / obMaxAbs) * dva_delta_max_width * barDurMs
                        color dcol = d >= 0 ? dva_delta_bull_color : dva_delta_bear_color
                        bool  isMaxBin = bnk == obMaxIdx
                        color borderCol = isMaxBin ? dva_max_border_color : color.new(dcol, 0)
                        int   borderW   = isMaxBin ? dva_max_border_width : 1
                        bin.bx.unshift(box.new(id.loc, bandHi, id.loc + int(widthMs), bandLo, border_color=borderCol, border_width=borderW, bgcolor=dcol, xloc=xloc.bar_time, text=dva_show_delta_text ? "Δ" + str.tostring(d, format.volume) : "", text_color=color.black, text_size=f_dva_txsz(dva_delta_text_size), text_halign=text.align_left))

            // ── собственные POC/VAL/VAH блока (раздел 8.3): раздельные цвет/толщина, длина линии —
            // ширина того бина дельты, куда попадает её ценовой уровень, стиль solid/dashed по попаданию
            // в максимальный бин — единообразно с FVG/iFVG и LVZ/iLVZ. ──
            if dva_show_own_va
                float obTotalVol = obDeltaBull.sum() + obDeltaBear.sum()
                if obTotalVol > 0
                    float obMaxTot = 0.0
                    int   obPocIdx = 0
                    for r = 0 to dva_delta_bins - 1
                        float tot = array.get(obDeltaBull, r) + array.get(obDeltaBear, r)
                        if tot > obMaxTot
                            obMaxTot := tot
                            obPocIdx := r
                    [obVaLo, obVaHi] = f_calc_value_area(obDeltaBull, obDeltaBear, dva_delta_bins, obPocIdx, obTotalVol, dva_own_va_threshold)
                    float obOwnPoc = id.btm + obStep * (obPocIdx + 0.5)
                    float obOwnVal = id.btm + obStep * obVaLo
                    float obOwnVah = id.btm + obStep * (obVaHi + 1)

                    [obPocMs, obPocIsMax] =f_dva_bin_match_ms(obOwnPoc, id.btm, id.top, dva_delta_bins, obDeltaBull, obDeltaBear, obMaxIdx, obMaxAbs, dva_delta_max_width, barDurMs)
                    [obValMs, obValIsMax] = f_dva_bin_match_ms(obOwnVal, id.btm, id.top, dva_delta_bins, obDeltaBull, obDeltaBear, obMaxIdx, obMaxAbs, dva_delta_max_width, barDurMs)
                    [obVahMs, obVahIsMax] = f_dva_bin_match_ms(obOwnVah, id.btm, id.top, dva_delta_bins, obDeltaBull, obDeltaBear, obMaxIdx, obMaxAbs, dva_delta_max_width, barDurMs)

                    bin.ln.unshift(line.new(id.loc, obOwnPoc, id.loc + obPocMs, obOwnPoc, color=dva_poc_line_color, width=dva_poc_line_width, xloc=xloc.bar_time, style=obPocIsMax ? line.style_solid : line.style_dashed))
                    bin.ln.unshift(line.new(id.loc, obOwnVal, id.loc + obValMs, obOwnVal, color=dva_val_line_color, width=dva_val_line_width, xloc=xloc.bar_time, style=obValIsMax ? line.style_solid : line.style_dashed))
                    bin.ln.unshift(line.new(id.loc, obOwnVah, id.loc + obVahMs, obOwnVah, color=dva_vah_line_color, width=dva_vah_line_width, xloc=xloc.bar_time, style=obVahIsMax ? line.style_solid : line.style_dashed))
                    bin.lb.unshift(label.new(id.loc, obOwnPoc, "POC " + str.tostring(obOwnPoc, format.mintick), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white,100), textcolor=dva_poc_line_color, size=f_dva_txsz(dva_va_text_size)))
                    bin.lb.unshift(label.new(id.loc, obOwnVal, "VAL " + str.tostring(obOwnVal, format.mintick), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white,100), textcolor=dva_val_line_color, size=f_dva_txsz(dva_va_text_size)))
                    bin.lb.unshift(label.new(id.loc, obOwnVah, "VAH " + str.tostring(obOwnVah, format.mintick), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white,100), textcolor=dva_vah_line_color, size=f_dva_txsz(dva_va_text_size)))

// ====================================================================================================================
// ОСНОВНАЯ ФУНКЦИЯ SMC — f_bb_structure (без Bubbles on Structure)
// ── ИЗМЕНЕНО по запросу: Order Block больше НЕ ждёт подтверждения ChoCh/BOS. Внутри функции добавлен
// независимый детектор смещения (displacement) цены с объёмным подтверждением — точно такой же принцип,
// что уже использовался в OB-прокси tf_engine_v2 (ob_disl_b/s). Как только смещение обнаружено, OB
// создаётся сразу через тот же fnOB(...), используя актуальные topP/btmP/idbull/idbear, не дожидаясь
// switch-веток ms.start==1/2, которые остаются как есть — структурные OB на ChoCh/BOS создаются
// по-прежнему, это отдельный ДОПОЛНИТЕЛЬНЫЙ путь, а не замена. ──
// ====================================================================================================================

f_bb_structure(color upcss, color dncss, bool draw, bool internal, int limit, bool sd_in_demand, bool sd_in_supply) =>
    var structure ms     = structure.new(start=0)
    var ob[]      blob   = array.new<ob>()
    var ob[]      bearob = array.new<ob>()
    var drawms[]  bldw   = array.new<drawms>()
    var drawms[]  brdw   = array.new<drawms>()
    bool crossup = false
    bool crossdn = false
    var float up = na
    var float dn = na

    int idbull = ms.find(false, false, true)
    int idbear = ms.find(true,  false, true)

    float btmP = bb_obmode == "Length" ? (high[idbear] - 1 * bb_atr[idbear]) < low[idbear] ? low[idbear] : (high[idbear] - 1 * bb_atr[idbear]) : low[idbear]
    float topP = bb_obmode == "Length" ? (low[idbull]  + 1 * bb_atr[idbull]) > high[idbull] ? high[idbull] : (low[idbull]  + 1 * bb_atr[idbull]) : high[idbull]

    // ── НЕЗАВИСИМАЯ ДЕТЕКЦИЯ OB ПО СМЕЩЕНИЮ (отвязано от ChoCh/BOS) ──
    var int ind_last_ob_bull_bar = -1
    var int ind_last_ob_bear_bar = -1
    float ind_atr     = ta.atr(bb_len)
    float ind_vol_sma = ta.sma(volume, 20)
    bool  ind_disp_up = (close > open) and (math.abs(close - open) > ind_atr * 1.0) and (volume > ind_vol_sma * 1.3) and (close > high[1])
    bool  ind_disp_dn = (close < open) and (math.abs(close - open) > ind_atr * 1.0) and (volume > ind_vol_sma * 1.3) and (close < low[1])
    if bb_obshow and barstate.isconfirmed and ind_disp_up and (bar_index - ind_last_ob_bull_bar) > 1
        blob.fnOB(true, topP, idbull)
        ind_last_ob_bull_bar := bar_index
    if bb_obshow and barstate.isconfirmed and ind_disp_dn and (bar_index - ind_last_ob_bear_bar) > 1
        bearob.fnOB(false, btmP, idbear)
        ind_last_ob_bear_bar := bar_index

    float ph = ta.pivothigh(high, bb_mslen, bb_mslen)
    float pl = ta.pivotlow (low,  bb_mslen, bb_mslen)
    var int[]   phn = array.new<int>(1,   na)
    var int[]   pln = array.new<int>(1,   na)
    var float[] php = array.new<float>(1, na)
    var float[] plp = array.new<float>(1, na)

    if internal
        blob.clear(), bearob.clear()

    if not na(ph)
        phn.unshift(bar_index[bb_mslen]), php.unshift(high[bb_mslen])
    if not na(pl)
        pln.unshift(bar_index[bb_mslen]), plp.unshift(low[bb_mslen])

    if php.size() > 0 and high > php.get(0)
        php.clear(), phn.clear()
    if plp.size() > 0 and low < plp.get(0)
        plp.clear(), pln.clear()

    if na(up)
        up := high
    if na(dn)
        dn := low

    if high > up
        up := high, dn := low, crossup := true
    if low  < dn
        up := high, dn := low, crossdn := true

    if ms.start == 0
        ms := structure.new(bar_index, na, high, low, bar_index, bar_index, 0, 1, na, bar_index)
        if draw
            bldw.unshift(drawms.new(time, time, high, "CHoCH", upcss, line.style_dashed))
            brdw.unshift(drawms.new(time, time, low,  "CHoCH", dncss, line.style_dashed))

    ms.upsweep := false
    ms.dnsweep := false

    if ms.start == 1
        switch
            low <= ms.choch and close >= ms.choch and bb_buildsweep =>
                ms.dnsweep := true, ms.choch := low, ms.xloc := bar_index
                if draw
                    drawms t = brdw.get(0)
                    t.x2 := time, t.style := line.style_dotted, t.txt := "x"
                    brdw.unshift(drawms.new(time, time, low, "CHoCH", dncss, line.style_dashed))
            high >= ms.bos and close <= ms.bos and bb_buildsweep =>
                ms.upsweep := true, ms.bos := high, ms.xloc := bar_index
                if draw
                    drawms t = bldw.get(0)
                    t.x2 := time, t.style := line.style_dotted, t.txt := "x"
                    bldw.unshift(drawms.new(time, time, high, "CHoCH", upcss, line.style_dashed))
            close <= ms.choch =>
                ms.txt := "choch", lc.start := true, lc.count := 0
                blob.fnOB(true, topP, idbull)
                ms.trend := -1, ms.choch := ms.bos, ms.bos := na, ms.start := 2
                ms.loc := bar_index, ms.main := low, ms.temp := ms.loc, ms.xloc := bar_index
                if draw
                    drawms t = brdw.get(0)
                    t.x2 := time, t.style := internal ? line.style_dashed : line.style_solid
            close >= ms.bos =>
                ms.txt := "choch", lc.start := true, lc.count := 0
                bearob.fnOB(false, btmP, idbear)
                ms.trend := 1, ms.bos := na, ms.start := 2
                ms.loc := bar_index, ms.main := high, ms.temp := ms.loc, ms.xloc := bar_index
                if draw
                    drawms t = bldw.get(0)
                    t.x2 := time, t.style := internal ? line.style_dashed : line.style_solid

    if ms.start == 2
        switch ms.trend
            -1 =>
                if low <= ms.main
                    ms.main := low, ms.temp := bar_index
                if not na(ms.bos) and bb_msmode == "Adjusted Points" and php.size() > 0
                    if php.get(0) < ms.choch
                        ms.choch := php.get(0), ms.loc := phn.get(0), ms.xloc := phn.get(0), ms.temp := phn.get(0)
                        if draw
                            drawms t = bldw.get(0)
                            t.x1 := time[bar_index - phn.get(0)], t.x2 := time, t.y := php.get(0)
                if na(ms.bos) and crossup and close > open and close[1] > open[1]
                    ms.bos := ms.main, ms.loc := ms.temp, ms.xloc := ms.loc
                    if draw
                        brdw.unshift(drawms.new(time[bar_index - ms.loc], time, low[bar_index - ms.loc], "BOS", dncss, line.style_dashed))
                if not na(ms.bos) and draw
                    drawms t1 = brdw.get(0), t1.x2 := time
                if draw
                    drawms t2 = bldw.get(0), t2.x2 := time
                switch
                    low <= ms.bos and close >= ms.bos and not na(ms.bos) and bb_buildsweep =>
                        ms.dnsweep := true, ms.bos := low, ms.xloc := bar_index
                        if draw
                            drawms t = brdw.get(0)
                            t.x2 := time, t.style := line.style_dotted, t.txt := "x"
                            brdw.unshift(drawms.new(time, time, low, "BOS", dncss, line.style_dashed))
                    close <= ms.bos and not na(ms.bos) =>
                        ms.txt := "bos", ms.zz := ms.bos, ms.zn := bar_index
                        lc.start := true, lc.count := 0
                        bearob.fnOB(false, btmP, idbear)
                        int id = ms.find(true, false, false)
                        ms.xloc := bar_index, ms.bos := na, ms.choch := high[id], ms.loc := bar_index[id]
                        if draw
                            drawms t1 = brdw.get(0)
                            t1.x2 := time, t1.style := internal ? line.style_dashed : line.style_solid
                            drawms t2 = bldw.get(0)
                            t2.x1 := time[id], t2.x2 := time, t2.y := high[id]
                    high >= ms.choch and close <= ms.choch and bb_buildsweep =>
                        ms.upsweep := true, ms.choch := high, ms.xloc := bar_index
                        if draw
                            drawms t = bldw.get(0)
                            t.x2 := time, t.style := line.style_dotted, t.txt := "x"
                            bldw.unshift(drawms.new(time, time, high, "CHoCH", upcss, line.style_dashed))
                    close >= ms.choch =>
                        ms.txt := "choch", ms.zz := ms.choch, ms.zn := bar_index
                        lc.start := true, lc.count := 0
                        blob.fnOB(true, topP, idbull)
                        int id = ms.find(false, false, false)
                        if na(ms.bos)
                            ms.choch := low[id]
                            if draw
                                brdw.unshift(drawms.new(time, time, low, "BOS", dncss, line.style_dashed))
                                drawms t = brdw.get(0), t.x1 := time[bar_index - ms.temp]
                        else
                            ms.choch := ms.bos
                        ms.bos := na, ms.main := high, ms.trend := 1
                        ms.loc := bar_index, ms.xloc := bar_index, ms.temp := ms.loc
                        if draw
                            drawms tc = bldw.get(0)
                            tc.x2 := time, tc.txt := "CHoCH", tc.style := internal ? line.style_dashed : line.style_solid
                            drawms tc2 = brdw.get(0)
                            tc2.x2 := time, tc2.y := ms.choch, tc2.txt := "CHoCH"
                        ms.xloc := bar_index, blarea.normal := false
            1 =>
                if high >= ms.main
                    ms.main := high, ms.temp := bar_index
                if na(ms.bos) and crossdn and close < open and close[1] < open[1]
                    ms.bos := ms.main, ms.loc := ms.temp, ms.xloc := ms.loc
                    if draw
                        bldw.unshift(drawms.new(time[bar_index - ms.loc], time, high[bar_index - ms.loc], "BOS", upcss, line.style_dashed))
                if not na(ms.bos) and bb_msmode == "Adjusted Points" and plp.size() > 0
                    if plp.get(0) > ms.choch
                        ms.choch := plp.get(0), ms.loc := pln.get(0), ms.xloc := pln.get(0), ms.temp := pln.get(0)
                        if draw
                            drawms t = brdw.get(0)
                            t.x1 := time[bar_index - pln.get(0)], t.x2 := time, t.y := plp.get(0)
                if not na(ms.bos) and draw
                    drawms t1 = bldw.get(0), t1.x2 := time
                if draw
                    drawms t2 = brdw.get(0), t2.x2 := time
                switch
                    high >= ms.bos and close <= ms.bos and not na(ms.bos) and bb_buildsweep =>
                        ms.upsweep := true, ms.bos := high, ms.xloc := bar_index
                        if draw
                            drawms t = bldw.get(0)
                            t.x2 := time, t.style := line.style_dotted, t.txt := "x"
                            bldw.unshift(drawms.new(time, time, high, "BOS", upcss, line.style_dashed))
                    close >= ms.bos and not na(ms.bos) =>
                        ms.txt := "bos", ms.zz := ms.bos, ms.zn := bar_index
                        lc.start := true, lc.count := 0
                        blob.fnOB(true, topP, idbull)
                        int id = ms.find(false, false, false)
                        ms.xloc := bar_index, ms.bos := na, ms.choch := low[id], ms.loc := bar_index[id]
                        if draw
                            drawms t1 = bldw.get(0)
                            t1.x2 := time, t1.style := internal ? line.style_dashed : line.style_solid
                            drawms t2 = brdw.get(0)
                            t2.x1 := time[id], t2.x2 := time, t2.y := low[id]
                    low <= ms.choch and close >= ms.choch and bb_buildsweep =>
                        ms.dnsweep := true, ms.choch := low, ms.xloc := bar_index
                        if draw
                            drawms t = brdw.get(0)
                            t.x2 := time, t.style := line.style_dotted, t.txt := "x"
                            brdw.unshift(drawms.new(time, time, low, "CHoCH", dncss, line.style_dashed))
                    close <= ms.choch =>
                        ms.txt := "choch", ms.zz := ms.choch, ms.zn := bar_index
                        lc.start := true, lc.count := 0
                        bearob.fnOB(false, btmP, idbear)
                        int id = ms.find(true, false, false)
                        if na(ms.bos)
                            ms.choch := high[id]
                            if draw
                                bldw.unshift(drawms.new(time, time, high, "BOS", upcss, line.style_dashed))
                                drawms t = bldw.get(0), t.x1 := time[bar_index - ms.temp]
                        else
                            ms.choch := ms.bos
                        ms.bos := na, ms.main := low, ms.trend := -1
                        ms.loc := bar_index, ms.temp := ms.loc
                        if draw
                            drawms tc = brdw.get(0)
                            tc.x2 := time, tc.txt := "CHoCH", tc.style := internal ? line.style_dashed : line.style_solid
                            drawms tc2 = bldw.get(0)
                            tc2.y := ms.choch, tc2.x2 := time, tc2.txt := "CHoCH"
                        ms.xloc := bar_index

    if blob.size() > 0 and not blob.get(0).isbb and low < blob.get(0).top
        blobenter.normal := true
    else if blob.size() > 0 and blob.get(0).isbb and high > blob.get(0).btm
        blobenter.breaker := true
    if bearob.size() > 0 and not bearob.get(0).isbb and high > bearob.get(0).btm
        brobenter.normal := true
    else if bearob.size() > 0 and bearob.get(0).isbb and low < bearob.get(0).top
        brobenter.breaker := true

    if bb_obshow
        if barstate.isconfirmed
            blob.mitigated(), bearob.mitigated()
            if bb_overlap
                f_overlap(blob, bearob)
        if blob.size() > 0
            for metric in blob
                metric.umt()
        if bearob.size() > 0
            for metric in bearob
                metric.umt()
        if barstate.islast
            float tV_bull = 0.0, float tV_bear = 0.0
            for obj in blob
                tV_bull += obj.vol
            for obj in bearob
                tV_bear += obj.vol
            if blob.size() > 0
                for i = 0 to blob.size() - 1
                    ob item = blob.get(i)
                    f_display(item, blob, i, math.floor((item.vol / math.max(1, tV_bull)) * 100))
            if bearob.size() > 0
                for i = 0 to bearob.size() - 1
                    ob item = bearob.get(i)
                    f_display(item, bearob, i, math.floor((item.vol / math.max(1, tV_bear)) * 100))

    if barstate.islast and draw and bldw.size() > 0 and brdw.size() > 0
        for i = 0 to bldw.size() - 1
            obj = bldw.get(i)
            if i <= limit
                bin.ln.unshift(line.new(x1=obj.x1, x2=obj.x2, y1=obj.y, y2=obj.y, color=obj.css, style=obj.style, xloc=xloc.bar_time))
                bin.lb.unshift(label.new(x=int(math.avg(bin.ln.get(0).get_x1(), bin.ln.get(0).get_x2())), y=obj.y, xloc=xloc.bar_time, color=invcol, style=label.style_label_down, textcolor=obj.css, size=bb_mstext.txSz(), text=obj.txt))
        for i = 0 to brdw.size() - 1
            obj = brdw.get(i)
            if i <= limit
                bin.ln.unshift(line.new(x1=obj.x1, x2=obj.x2, y1=obj.y, y2=obj.y, color=obj.css, style=obj.style, xloc=xloc.bar_time))
                bin.lb.unshift(label.new(x=int(math.avg(bin.ln.get(0).get_x1(), bin.ln.get(0).get_x2())), y=obj.y, xloc=xloc.bar_time, color=invcol, style=label.style_label_up, textcolor=obj.css, size=bb_mstext.txSz(), text=obj.txt))

    int current_ob_signal = 0, int current_ob_touch = 0, int current_bb_signal = 0
    if blob.size() > 0
        for i = 0 to blob.size() - 1
            ob obb = blob.get(i)
            if not obb.isbb and close <= obb.top and close >= obb.btm
                current_ob_signal := 1
                if obb.touches == 0
                    current_ob_touch := 1
                obb.touches += 1
            if obb.isbb and close <= obb.top and close >= obb.btm
                current_bb_signal := 1
    if bearob.size() > 0
        for i = 0 to bearob.size() - 1
            ob obb = bearob.get(i)
            if not obb.isbb and close <= obb.top and close >= obb.btm
                current_ob_signal := -1
                if obb.touches == 0
                    current_ob_touch := -1
                obb.touches += 1
            if obb.isbb and close <= obb.top and close >= obb.btm
                current_bb_signal := -1

    // ── ближняя граница (proximal) и дальняя граница ближайшего OB — bull_ob_top / bear_ob_bot — для POI
    // (раздел 11 удалён) — оставлено для внутренней структуры и других частей скрипта. ──
    float bull_prox = na, float bear_prox = na
    float bull_ob_top = na, float bear_ob_bot = na
    if blob.size() > 0
        for i = 0 to blob.size() - 1
            ob item = blob.get(i)
            if not item.isbb and close > item.btm
                bull_prox := item.btm, bull_ob_top := item.top, break
    if bearob.size() > 0
        for i = 0 to bearob.size() - 1
            ob item = bearob.get(i)
            if not item.isbb and close < item.top
                bear_prox := item.top, bear_ob_bot := item.btm, break

    int bull_ob_touch_count = 0
    int bear_ob_touch_count = 0
    if blob.size() > 0
        ob nearest_bull = blob.get(0)
        bull_ob_touch_count := nearest_bull.touches
    if bearob.size() > 0
        ob nearest_bear = bearob.get(0)
        bear_ob_touch_count := nearest_bear.touches

    bool ob_in_sd_bull = false
    bool ob_in_sd_bear = false
    if blob.size() > 0
        ob item = blob.get(0)
        if not item.isbb
            ob_in_sd_bull := sd_in_demand and close >= item.btm and close <= item.top
    if bearob.size() > 0
        ob item = bearob.get(0)
        if not item.isbb
            ob_in_sd_bear := sd_in_supply and close >= item.btm and close <= item.top

    [ms, current_ob_signal, current_ob_touch, current_bb_signal, bull_prox, bear_prox,
     bull_ob_touch_count, bear_ob_touch_count, ob_in_sd_bull, ob_in_sd_bear, bull_ob_top, bear_ob_bot]

// ====================================================================================================================
// SUPPLY & DEMAND — имя блока по центру, прозрачность по объёму формирования, дельта-объём внутри блока
// (координаты времени, т.к. S&D использует xloc.bar_time) теперь берутся из единого раздела 8 (dva_*).
// Максимальный по модулю бин дельты: заливка обычная bull/bear, рамка выделена (dva_max_border_color/width).
// ====================================================================================================================

var demandZones = array.new<sd_info>()
var supplyZones = array.new<sd_info>()
var sdBoxes     = array.new_box()
var sdLines     = array.new_line()
var sdLabels    = array.new_label()

float sd_atr  = ta.atr(20)
float sd_body = math.abs(close - open)

bool sd_bull_disp = close[1] > open[1] and sd_body[1] > sd_atr[1] * 1.4
bool sd_bear_disp = open[1] > close[1] and sd_body[1] > sd_atr[1] * 1.4
bool sd_base_cond = math.max(sd_body[2], nz(sd_body[3], sd_body[2])) < sd_atr[2] * 0.75

var int  lastDemand   = 0
var int  lastSupply   = 0
var bool sd_in_demand = false
var bool sd_in_supply = false
var int  export_sd_inv = 0
export_sd_inv := 0

if en_3
    if sd_bull_disp and sd_base_cond and bar_index - lastDemand > 5
        lastDemand := bar_index
        float demand_proximal = math.max(open[2], close[2])
        float demand_distal   = math.min(open[2], close[2])
        demandZones.unshift(sd_info.new(demand_proximal + sd_atr * 0.1, demand_distal - sd_atr * 0.2, "Demand", time[2], na, false, volume[2]))
        if demandZones.size() > 30
            demandZones.pop()
    if sd_bear_disp and sd_base_cond and bar_index - lastSupply > 5
        lastSupply := bar_index
        float supply_proximal = math.min(open[2], close[2])
        float supply_distal   = math.max(open[2], close[2])
        supplyZones.unshift(sd_info.new(supply_distal + sd_atr * 0.2, supply_proximal - sd_atr * 0.1, "Supply", time[2], na, false, volume[2]))
        if supplyZones.size() > 30
            supplyZones.pop()
    if demandZones.size() > 0
        for i = 0 to demandZones.size() - 1
            curr = demandZones.get(i)
            if na(curr.breakTime) and close < curr.bottom
                if barstate.isconfirmed
                    curr.breakTime := time, export_sd_inv := -1
    if supplyZones.size() > 0
        for i = 0 to supplyZones.size() - 1
            curr = supplyZones.get(i)
            if na(curr.breakTime) and close > curr.top
                if barstate.isconfirmed
                    curr.breakTime := time, export_sd_inv := 1
    sd_in_demand := false, sd_in_supply := false
    if demandZones.size() > 0
        for i = 0 to demandZones.size() - 1
            curr = demandZones.get(i)
            if na(curr.breakTime) and close >= curr.bottom and close <= curr.top
                sd_in_demand := true
    if supplyZones.size() > 0
        for i = 0 to supplyZones.size() - 1
            curr = supplyZones.get(i)
            if na(curr.breakTime) and close >= curr.bottom and close <= curr.top
                sd_in_supply := true
    if barstate.islast
        for b in sdBoxes
            b.delete()
        sdBoxes.clear()
        for l in sdLines
            l.delete()
        sdLines.clear()
        for lb in sdLabels
            lb.delete()
        sdLabels.clear()
        var validZones = array.new<sd_info>()
        validZones.clear()
        for z in demandZones
            if na(z.breakTime)
                validZones.push(sd_info.new(z.top, z.bottom, z.type, z.startTime, z.breakTime, z.disabled, z.vol))
        for z in supplyZones
            if na(z.breakTime)
                validZones.push(sd_info.new(z.top, z.bottom, z.type, z.startTime, z.breakTime, z.disabled, z.vol))
        bool combining = true
        while combining
            combining := false
            if validZones.size() > 1
                for i = 0 to validZones.size() - 1
                    for j = 0 to validZones.size() - 1
                        if i == j
                            continue
                        z1 = validZones.get(i), z2 = validZones.get(j)
                        if z1.disabled or z2.disabled or z1.type != z2.type
                            continue
                        float ot = sd_atr * 0.3
                        if math.min(z1.top + ot, z2.top + ot) >= math.max(z1.bottom - ot, z2.bottom - ot)
                            z1.disabled := true, z2.disabled := true
                            validZones.push(sd_info.new(math.max(z1.top, z2.top), math.min(z1.bottom, z2.bottom), z1.type, math.min(z1.startTime, z2.startTime), na, false, math.max(z1.vol, z2.vol)))
                            combining := true
        string tfFormat = timeframe.isintraday ? (timeframe.multiplier >= 60 ? str.tostring(timeframe.multiplier / 60) + " Hour" : str.tostring(timeframe.multiplier) + " Min") : (timeframe.isdaily ? "1 Day" : "TF")
        float sdVolSma = ta.sma(volume, 20)
        float sdBarDurMs = time - time[1]
        for z in validZones
            if not z.disabled
                color  zColor = z.type == "Demand" ? sd_d_col : sd_s_col
                float  mid    = (z.top + z.bottom) / 2

                // ── прозрачность блока по объёму формирования — вычисляется ДО отрисовки, чтобы решить, рисовать ли блок вообще ──
                int sdTr = 0
                if sd_show_quality_shade and not na(z.vol) and sdVolSma > 0
                    float sdRatio = math.min(z.vol / sdVolSma / 3.0, 1.0)
                    sdTr := f_quality_alpha(sdRatio)
                bool sdVisible = f_dva_visible(sdTr)

                if sdVisible
                    sdBoxes.push(box.new(left=z.startTime, top=z.top, right=time, bottom=z.bottom, xloc=xloc.bar_time, border_color=zColor, bgcolor=color.new(zColor, 85)))
                    sdLines.push(line.new(x1=z.startTime, y1=mid, x2=time, y2=mid, xloc=xloc.bar_time, color=color.new(color.white, 30), style=line.style_dashed))
                    int tlt = math.max(z.startTime, time - int((time - z.startTime) / 2))
                    sdBoxes.push(box.new(left=tlt, top=mid, right=time, bottom=z.bottom, xloc=xloc.bar_time, border_color=na, bgcolor=color.new(color.white, 100), text=tfFormat + " " + z.type, text_color=sd_text_col, text_size=size.small, text_halign=text.align_right, text_valign=text.align_bottom))

                    // ── имя блока по центру, без описания ──
                    if sd_show_name_label
                        int sdNameX = int(math.avg(z.startTime, time))
                        sdLabels.push(label.new(sdNameX, mid, z.type, xloc=xloc.bar_time, style=label.style_label_center, color=color.new(color.white, 100), textcolor=color.white, size=size.small, textalign=text.align_center))

                    // ── прозрачность блока по объёму формирования относительно SMA20 ──
                    if sd_show_quality_shade and not na(z.vol) and sdVolSma > 0
                        sdBoxes.push(box.new(left=z.startTime, top=z.top, right=time, bottom=z.bottom, xloc=xloc.bar_time, border_color=na, bgcolor=color.new(zColor, sdTr)))

                    // ── дельта-профиль блока S&D — считается один раз, питает и дельта-гистограмму, и
                    // собственные POC/VAL/VAH. Максимальный по модулю бин: обычная заливка bull/bear +
                    // выделенная рамка. ──
                    if dva_show_delta or dva_show_own_va
                        [sdDBull, sdDBear] = f_delta_profile_generic(z.bottom, z.top, math.min(bar_index, 300), dva_delta_bins)
                        float sdStep = (z.top - z.bottom) / dva_delta_bins
                        float sdMaxAbs = 0.0
                        int   sdMaxIdx = -1
                        for bnk = 0 to dva_delta_bins - 1
                            float d0 = array.get(sdDBull, bnk) - array.get(sdDBear, bnk)
                            if math.abs(d0) > sdMaxAbs
                                sdMaxAbs := math.abs(d0)
                                sdMaxIdx := bnk

                        if dva_show_delta and sdMaxAbs > 0
                            for bnk = 0 to dva_delta_bins - 1
                                float bandLo = z.bottom + sdStep * bnk
                                float bandHi = bandLo + sdStep
                                float d = array.get(sdDBull, bnk) - array.get(sdDBear, bnk)
                                if d != 0
                                    float widthMs = (math.abs(d) / sdMaxAbs) * dva_delta_max_width * sdBarDurMs
                                    color dcol = d >= 0 ? dva_delta_bull_color : dva_delta_bear_color
                                    bool  isMaxBin = bnk == sdMaxIdx
                                    color borderCol = isMaxBin ? dva_max_border_color : color.new(dcol, 0)
                                    int   borderW   = isMaxBin ? dva_max_border_width : 1
                                    sdBoxes.push(box.new(z.startTime, bandHi, z.startTime + int(widthMs), bandLo, xloc=xloc.bar_time, border_color=borderCol, border_width=borderW, bgcolor=dcol, text=dva_show_delta_text ? "Δ" + str.tostring(d, format.volume) : "", text_color=color.black, text_size=f_dva_txsz(dva_delta_text_size), text_halign=text.align_left))

                        // ── собственные POC/VAL/VAH блока S&D (раздел 8.3) — те же правила, что у OB/Breaker,
                        // FVG/iFVG и LVZ/iLVZ. ──
                        if dva_show_own_va
                            float sdTotalVol2 = sdDBull.sum() + sdDBear.sum()
                            if sdTotalVol2 > 0
                                float sdMaxTot2 = 0.0
                                int   sdPocIdx2 = 0
                                for r = 0 to dva_delta_bins - 1
                                    float tot = array.get(sdDBull, r) + array.get(sdDBear, r)
                                    if tot > sdMaxTot2
                                        sdMaxTot2 := tot
                                        sdPocIdx2 := r
                                [sdVaLo2, sdVaHi2] = f_calc_value_area(sdDBull, sdDBear, dva_delta_bins, sdPocIdx2, sdTotalVol2, dva_own_va_threshold)
                                float sdOwnPoc = z.bottom + sdStep * (sdPocIdx2 + 0.5)
                                float sdOwnVal = z.bottom + sdStep * sdVaLo2
                                float sdOwnVah = z.bottom + sdStep * (sdVaHi2 + 1)

                                [sdPocMs, sdPocIsMax] = f_dva_bin_match_ms(sdOwnPoc, z.bottom, z.top, dva_delta_bins, sdDBull, sdDBear, sdMaxIdx, sdMaxAbs, dva_delta_max_width, sdBarDurMs)
                                [sdValMs, sdValIsMax] = f_dva_bin_match_ms(sdOwnVal, z.bottom, z.top, dva_delta_bins, sdDBull, sdDBear, sdMaxIdx, sdMaxAbs, dva_delta_max_width, sdBarDurMs)
                                [sdVahMs, sdVahIsMax] = f_dva_bin_match_ms(sdOwnVah, z.bottom, z.top, dva_delta_bins, sdDBull, sdDBear, sdMaxIdx, sdMaxAbs, dva_delta_max_width, sdBarDurMs)

                                sdLines.push(line.new(z.startTime, sdOwnPoc, z.startTime + sdPocMs, sdOwnPoc, xloc=xloc.bar_time, color=dva_poc_line_color, width=dva_poc_line_width, style=sdPocIsMax ? line.style_solid : line.style_dashed))
                                sdLines.push(line.new(z.startTime, sdOwnVal, z.startTime + sdValMs, sdOwnVal, xloc=xloc.bar_time, color=dva_val_line_color, width=dva_val_line_width, style=sdValIsMax ? line.style_solid : line.style_dashed))
                                sdLines.push(line.new(z.startTime, sdOwnVah, z.startTime + sdVahMs, sdOwnVah, xloc=xloc.bar_time, color=dva_vah_line_color, width=dva_vah_line_width, style=sdVahIsMax ? line.style_solid : line.style_dashed))
                                sdLabels.push(label.new(z.startTime, sdOwnPoc, "POC " + str.tostring(sdOwnPoc, format.mintick), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white,100), textcolor=dva_poc_line_color, size=f_dva_txsz(dva_va_text_size)))
                                sdLabels.push(label.new(z.startTime, sdOwnVal, "VAL " + str.tostring(sdOwnVal, format.mintick), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white,100), textcolor=dva_val_line_color, size=f_dva_txsz(dva_va_text_size)))
                                sdLabels.push(label.new(z.startTime, sdOwnVah, "VAH " + str.tostring(sdOwnVah, format.mintick), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white,100), textcolor=dva_vah_line_color, size=f_dva_txsz(dva_va_text_size)))

// ====================================================================================================================
// ИСПОЛНЕНИЕ SMC — экспорт export_bull_ob_top / export_bear_ob_bot (полный диапазон ближайшего OB).
// ====================================================================================================================

var structure export_ms               = structure.new(start=0)
var int       export_ob_state         = 0
var int       export_ob_touch         = 0
var int       export_bb_signal        = 0
var float     export_bull_ob_proximal = na
var float     export_bear_ob_proximal = na
var float     export_bull_ob_top      = na
var float     export_bear_ob_bot      = na
var int       export_bull_ob_touches  = 0
var int       export_bear_ob_touches  = 0
var bool      export_ob_sd_bull       = false
var bool      export_ob_sd_bear       = false

[tmp_ms, tmp_ob_state, tmp_ob_touch, tmp_bb, b_prox, br_prox, tmp_bull_touches, tmp_bear_touches, tmp_ob_sd_bull, tmp_ob_sd_bear, tmp_bull_ob_top, tmp_bear_ob_bot] = f_bb_structure(bb_smc_up_col, bb_smc_dn_col, en_smc, false, bb_swingLimit, sd_in_demand, sd_in_supply)

export_ms               := tmp_ms
export_ob_state         := tmp_ob_state
export_ob_touch         := tmp_ob_touch
export_bb_signal        := tmp_bb
export_bull_ob_proximal := b_prox
export_bear_ob_proximal := br_prox
export_bull_ob_top      := tmp_bull_ob_top
export_bear_ob_bot      := tmp_bear_ob_bot
export_bull_ob_touches  := tmp_bull_touches
export_bear_ob_touches  := tmp_bear_touches
export_ob_sd_bull       := tmp_ob_sd_bull
export_ob_sd_bear       := tmp_ob_sd_bear

if en_smc and bb_showMapping
    f_mapping()

// ====================================================================================================================
// LVZ — ФУНКЦИИ ДЕТЕКЦИИ ПУСТОТЫ
// ====================================================================================================================

f_lvz_bin_empty_ratio(float rangeLo, float rangeHi, int lookback, int bins) =>
    float step = (rangeHi - rangeLo) / bins
    array<float> binVol = array.new<float>(bins, 0.0)
    int startBar = math.max(0, math.min(lookback, bar_index))
    for i = 0 to startBar - 1
        float price = hlc3[i]
        float vol = volume[i]
        if price >= rangeLo and price < rangeHi
            int idx = int((price - rangeLo) / math.max(step, syminfo.mintick))
            idx := math.max(0, math.min(bins - 1, idx))
            array.set(binVol, idx, array.get(binVol, idx) + vol)
    float maxV = binVol.max()
    int emptyCnt = 0
    if maxV > 0
        for i = 0 to bins - 1
            if array.get(binVol, i) < maxV * lvz_cluster_thr
                emptyCnt += 1
    else
        emptyCnt := bins
    float(emptyCnt) / bins

f_lvz_fib_empty_ratio(float rangeLo, float rangeHi) =>
    float ratio = 0.0
    if fib_showFibProfile and not na(fib_top) and not na(fib_bottom) and fib_top != fib_bottom
        float step = (fib_top - fib_bottom) / fib_rows
        int emptyCnt = 0
        int overlapCnt = 0
        float maxV = 0.0
        for r = 0 to fib_rows - 1
            float tot = array.get(fib_volUp, r) + array.get(fib_volDn, r)
            maxV := math.max(maxV, tot)
        if maxV > 0
            for r = 0 to fib_rows - 1
                float binLo = fib_bottom + step * r
                float binHi = binLo + step
                if binHi > rangeLo and binLo < rangeHi
                    overlapCnt += 1
                    float tot = array.get(fib_volUp, r) + array.get(fib_volDn, r)
                    if tot < maxV * lvz_fib_thr
                        emptyCnt += 1
        ratio := overlapCnt > 0 ? float(emptyCnt) / overlapCnt : 0.0
    ratio

f_lvz_liq_in_range(float rangeLo, float rangeHi) =>
    bool found = false
    if hm_pivots.size() > 0
        for i = 0 to hm_pivots.size() - 1
            hm_pivot p = hm_pivots.get(i)
            if p.value >= rangeLo and p.value <= rangeHi
                found := true
                break
    found

// ====================================================================================================================
// Directional vacuum (Fib Delta Profile)
// ====================================================================================================================
f_lvz_check_directional(float zTop, float zBot) =>
    bool result = false
    if fib_showFibDelta and array.size(fib_fibbLines) > 0
        float sumDelta = 0.0, float sumAbs = 0.0
        if not na(fib_top) and not na(fib_bottom) and fib_top != fib_bottom
            float step = (fib_top - fib_bottom) / fib_rows
            for r = 0 to fib_rows - 1
                float binLo = fib_bottom + step * r
                float binHi = binLo + step
                if binHi > zBot and binLo < zTop
                    float up_v = array.get(fib_volUp, r)
                    float dn_v = array.get(fib_volDn, r)
                    sumDelta += up_v - dn_v
                    sumAbs   += up_v + dn_v
        result := sumAbs > 0 and math.abs(sumDelta)/sumAbs > 0.65
    result

// ====================================================================================================================
// Confluence при создании зоны — ИЗМЕНЕНО по запросу: убраны hasVA/hasPOC_VA вместе с разделом 7.3
// (Value Area confluence больше не считается через этот вспомогательный механизм). Используется и для
// LVZ, и для синтетических кандидатов, зависит только от переданного диапазона [zTop, zBot].
// ====================================================================================================================
f_lvz_check_confluence(float zTop, float zBot, bool isBull) =>
    bool hasOB = isBull ? export_ob_state == 1 : export_ob_state == -1
    bool hasBreaker = isBull ? export_bb_signal == 1 : export_bb_signal == -1
    bool hasSD = isBull ? (sd_in_demand and demandZones.size()>0 and
                f_zones_overlap(zTop, zBot, demandZones.get(0).top, demandZones.get(0).bottom)) : (sd_in_supply and supplyZones.size()>0 and
                f_zones_overlap(zTop, zBot, supplyZones.get(0).top, supplyZones.get(0).bottom))
    bool hasFib = false
    if array.size(fib_fibbLines) > 0 and not na(fib_hiPrice) and not na(fib_loPrice)
        for e in array.from(0.236, 0.382, 0.5, 0.618, 0.786)
            float lvl = f_fibbFunc(e, fib_HB < fib_LB, fib_hiPrice, fib_loPrice)
            if lvl <= zTop and lvl >= zBot
                hasFib := true
                break
    bool hasOTE = not na(fib_ote_upper) and not na(fib_ote_lower) and f_zones_overlap(zTop, zBot, fib_ote_upper, fib_ote_lower)
    int layers = (hasOB?1:0) + (hasBreaker?2:0) + (hasSD?1:0) + (hasFib?1:0) + (hasOTE?1:0)
    [layers, hasOB, hasBreaker, hasSD, hasFib, hasOTE]

// ====================================================================================================================
// Quality Tier зоны (0-9) — ИЗМЕНЕНО по запросу: убраны параметры isPOC_hvn/isHVN/onVA_POC вместе с
// разделом 7.3.
// ====================================================================================================================
f_lvz_quality(int confluence, bool isDirectional, float widthATR, bool isInversion) =>
    int q = 0
    q += math.min(confluence, 3)
    q += (not isDirectional ? 1 : 0)
    q += (widthATR>0 and widthATR<=0.5 ? 2 : widthATR<=1.0 ? 1 : 0)
    q += (isInversion ? 2 : 0)
    math.min(q, 9)

// ── Собственная Value Area из ОДНОГО массива объёма (для FVG/iFVG, у которых профиль не разбит на бык/медведь) ──
f_calc_value_area_single(array<float> vol, int rows, int pocIdx, float totalVol, float threshold) =>
    int loIdx = pocIdx
    int hiIdx = pocIdx
    float accum = array.get(vol, pocIdx)
    float target = totalVol * threshold
    while accum < target and (loIdx > 0 or hiIdx < rows - 1)
        float loNextVol = loIdx > 0 ? array.get(vol, loIdx - 1) : -1.0
        float hiNextVol = hiIdx < rows - 1 ? array.get(vol, hiIdx + 1) : -1.0
        if loNextVol < 0 and hiNextVol < 0
            break
        if loNextVol >= hiNextVol
            loIdx -= 1
            accum += loNextVol
        else
            hiIdx += 1
            accum += hiNextVol
    [loIdx, hiIdx]

// ====================================================================================================================
// FVG VOLUME PROFILE [CHARTPRIME PORT] + iFVG:
// • дельта-объём внутри блока — общие настройки раздела 8 (dva_*): единое число бинов, макс. длина,
//   цвета, вкл/выкл текста, левое выравнивание текста; максимальный по модулю бин — обычная заливка
//   bull/bear + КОНТРАСТНАЯ РАМКА (dva_max_border_color/dva_max_border_width), без перекраски заливки —
//   так видно одновременно и величину, и сторону (покупатель/продавец);
// • собственные POC/VAL/VAH блока — раздельные цвет и толщина для каждой линии (dva_poc_line_color/
//   width, dva_val_line_color/width, dva_vah_line_color/width), ДЛИНА линии равна длине того бина
//   дельта-гистограммы, в который попадает её ценовой уровень (не во всю ширину блока), стиль —
//   SOLID, если уровень попадает в бин с максимальной по модулю дельтой, иначе DASHED;
// • имя по центру блока ("FVG"/"iFVG") без описания;
// • прозрачность блока зависит от лёгкого confluence-скора на момент образования; если раздел 8.2
//   включает скрытие некачественных элементов и прозрачность выше порога — блок не рисуется вовсе.
// ====================================================================================================================

var fvgs            = array.new<fvg_obj>()
var fvg_pocLblAllow = true
var float export_ifvg_delta_sign = 0.0

f_ifvg_delta_profile(array<float> closeArr, array<float> volArr, float hi, float lo, int bins) =>
    array<float> deltaBull = array.new_float(bins, 0.0)
    array<float> deltaBear = array.new_float(bins, 0.0)
    float binSize = (hi - lo) / bins
    if array.size(closeArr) > 1 and binSize > 0
        for i = 1 to array.size(closeArr) - 1
            float c = array.get(closeArr, i)
            float cPrev = array.get(closeArr, i - 1)
            float v = array.get(volArr, i)
            if c >= lo and c <= hi
                int idx = math.max(0, math.min(bins - 1, int((c - lo) / binSize)))
                if c >= cPrev
                    array.set(deltaBull, idx, array.get(deltaBull, idx) + v)
                else
                    array.set(deltaBear, idx, array.get(deltaBear, idx) + v)
    [deltaBull, deltaBear]

if en_2
    bool fvg_bull_cond = low > high[2] and high[1] > high[2] and fvg_bullish_gap_size > fvg_gap_filter
    bool fvg_bear_cond = high < low[2] and low[1]  < low[2]  and fvg_bearish_gap_size > fvg_gap_filter

    array<float> cls_array = fvg_c.size() > 0 ? fvg_c[1] : array.new_float()
    array<float> vol_array = fvg_v.size() > 0 ? fvg_v[1] : array.new_float()

    // ── очистка просроченной памяти iFVG ──
    if en_ifvg and fvgMem.size() > 0
        for i = fvgMem.size() - 1 to 0
            if f_fvg_mem_expired(fvgMem.get(i))
                fvgMem.remove(i)

    if fvg_bull_cond
        fvg_pocLblAllow := false
        float fvg_lower = high[2], float fvg_upper = low

        // ── проверка спаривания с недавно сломанным медвежьим FVG → iFVG ──
        bool ifvg_bull_made = false
        if en_ifvg and fvgMem.size() > 0
            for m in fvgMem
                if not m.up and m.breakBar >= 0 and f_zones_overlap(fvg_upper, fvg_lower, m.hi, m.lo)
                    ifvg_bull_made := true
                    break

        // ── лёгкий confluence-скор в момент образования — только для прозрачности блока, без описаний ──
        int fvg_qmask_b = 0
        fvg_qmask_b += export_ob_state == 1 ? 1 : 0
        fvg_qmask_b += sd_in_demand ? 1 : 0
        fvg_qmask_b += (en_va and not na(va_val_price) and not na(va_vah_price) and f_zones_overlap(fvg_upper, fvg_lower, va_vah_price, va_val_price)) ? 1 : 0
        fvg_qmask_b += ifvg_bull_made ? 1 : 0
        float fvg_qratio_b = fvg_qmask_b / 4.0
        int   fvg_alpha_b  = f_quality_alpha(fvg_qratio_b)
        bool  fvg_visible_b = f_dva_visible(fvg_alpha_b)

        if fvg_visible_b
            color fvg_box_col = ifvg_bull_made ? ifvg_bull_color : fvg_bull_color
            color fvg_box_bg  = fvg_show_quality_shade ? color.new(fvg_box_col, fvg_alpha_b) : color.new(fvg_box_col, 70)
            box   fvg_box   = box.new(bar_index - 1, fvg_upper, bar_index + 3, fvg_lower, border_color=na, border_width=0, bgcolor=fvg_box_bg)
            float binSize   = (fvg_upper - fvg_lower) / fvg_bins
            array<float> volumeP     = array.new<float>(fvg_bins, 0.)
            array<box>   volumeBoxes = array.new<box>(fvg_bins, box(na))
            line  poc = line(na), label pocLbl = label(na)
            line  valLine = line(na), line vahLine = line(na)
            label valLbl = label(na), label vahLbl = label(na)

            // ── дельта-профиль вычисляется здесь же (на баре создания), чтобы линии POC/VAL/VAH могли
            // сразу сопоставиться с шириной и позицией соответствующего бина дельты. ──
            array<float> ideltaBull = array.new_float()
            array<float> ideltaBear = array.new_float()
            array<box>   ideltaBoxes = array.new<box>()
            if dva_show_delta and cls_array.size() > 0
                [db, dr] = f_ifvg_delta_profile(cls_array, vol_array, fvg_upper, fvg_lower, dva_delta_bins)
                ideltaBull := db
                ideltaBear := dr
            float ifvg_maxAbsD_b = 0.0
            int   ifvg_maxIdx_b  = -1
            if array.size(ideltaBull) > 0
                for bnk = 0 to dva_delta_bins - 1
                    float d0 = array.get(ideltaBull, bnk) - array.get(ideltaBear, bnk)
                    if math.abs(d0) > ifvg_maxAbsD_b
                        ifvg_maxAbsD_b := math.abs(d0)
                        ifvg_maxIdx_b := bnk

            if cls_array.size() > 0
                for k = 0 to fvg_bins - 1
                    float lower_b = fvg_lower + binSize * k, float mid_b = lower_b + binSize / 2
                    for i = 0 to cls_array.size() - 1
                        if math.abs(cls_array.get(i) - mid_b) <= binSize
                            volumeP.set(k, volumeP.get(k) + vol_array.get(i))
            int fvg_poc_idx_b = -1
            for k = 0 to fvg_bins - 1
                float lower_b = fvg_lower + binSize * k, float upper_b = lower_b + binSize, float mid_b = lower_b + binSize / 2
                volumeBoxes.set(k, box.new(bar_index - 1, upper_b, bar_index - 1, lower_b, border_width=0))
                if volumeP.max() != 0 and volumeP.get(k) == volumeP.max() and not fvg_pocLblAllow
                    fvg_poc_idx_b := k
                    // ── собственный POC блока: раздельный цвет/толщина, длина = ширина соответствующего
                    // бина дельты, стиль solid/dashed по попаданию в максимальный бин ──
                    [poc_w_b, poc_isMax_b] = f_dva_bin_match(mid_b, fvg_lower, fvg_upper, dva_delta_bins, ideltaBull, ideltaBear, ifvg_maxIdx_b, ifvg_maxAbsD_b, dva_delta_max_width)
                    poc    := line.new(bar_index - 1, mid_b, bar_index - 1 + poc_w_b, mid_b, color=dva_poc_line_color, width=dva_poc_line_width, style=poc_isMax_b ? line.style_solid : line.style_dashed)
                    pocLbl := label.new(bar_index - 1, mid_b, "POC " + str.tostring(mid_b, format.mintick), style=label.style_label_left, color=color.new(color.white, 100), textcolor=dva_poc_line_color, size=f_dva_txsz(dva_va_text_size))
                    fvg_pocLblAllow := true

            // ── собственная Value Area блока (VAL/VAH) — раздельные цвет/толщина, длина = ширина
            // соответствующего бина дельты, стиль solid/dashed по попаданию в максимальный бин ──
            if dva_show_own_va and fvg_poc_idx_b >= 0 and volumeP.sum() > 0
                [fvg_va_lo_b, fvg_va_hi_b] = f_calc_value_area_single(volumeP, fvg_bins, fvg_poc_idx_b, volumeP.sum(), dva_own_va_threshold)
                float fvg_val_price_b = fvg_lower + binSize * fvg_va_lo_b
                float fvg_vah_price_b = fvg_lower + binSize * (fvg_va_hi_b + 1)
                [val_w_b, val_isMax_b] = f_dva_bin_match(fvg_val_price_b, fvg_lower, fvg_upper, dva_delta_bins, ideltaBull, ideltaBear, ifvg_maxIdx_b, ifvg_maxAbsD_b, dva_delta_max_width)
                [vah_w_b, vah_isMax_b] = f_dva_bin_match(fvg_vah_price_b, fvg_lower, fvg_upper, dva_delta_bins, ideltaBull, ideltaBear, ifvg_maxIdx_b, ifvg_maxAbsD_b, dva_delta_max_width)
                valLine := line.new(bar_index - 1, fvg_val_price_b, bar_index - 1 + val_w_b, fvg_val_price_b, color=dva_val_line_color, width=dva_val_line_width, style=val_isMax_b ? line.style_solid : line.style_dashed)
                vahLine := line.new(bar_index - 1, fvg_vah_price_b, bar_index - 1 + vah_w_b, fvg_vah_price_b, color=dva_vah_line_color, width=dva_vah_line_width, style=vah_isMax_b ? line.style_solid : line.style_dashed)
                valLbl  := label.new(bar_index - 1, fvg_val_price_b, "VAL " + str.tostring(fvg_val_price_b, format.mintick), style=label.style_label_left, color=color.new(color.white, 100), textcolor=dva_val_line_color, size=f_dva_txsz(dva_va_text_size))
                vahLbl  := label.new(bar_index - 1, fvg_vah_price_b, "VAH " + str.tostring(fvg_vah_price_b, format.mintick), style=label.style_label_left, color=color.new(color.white, 100), textcolor=dva_vah_line_color, size=f_dva_txsz(dva_va_text_size))

            // ── имя по центру блока: "FVG" / "iFVG" — только имя, без описания ──
            label fvg_type_lbl_b = na
            if fvg_show_type_label
                int   fvg_lbl_x_b = int(math.avg(bar_index - 1, bar_index + 3))
                float fvg_lbl_y_b = (fvg_upper + fvg_lower) / 2
                fvg_lbl_sz_b = fvg_type_label_size == "Tiny" ? size.tiny : fvg_type_label_size == "Normal" ? size.normal : size.small
                fvg_type_lbl_b := label.new(fvg_lbl_x_b, fvg_lbl_y_b, ifvg_bull_made ? "iFVG" : "FVG", style=label.style_label_center, color=color.new(color.white, 100), textcolor=fvg_type_label_color, size=fvg_lbl_sz_b, textalign=text.align_center)

            fvgs.push(fvg_obj.new(fvg_box, true, volumeP, volumeBoxes, poc, pocLbl, bar_index, ifvg_bull_made, ideltaBull, ideltaBear, ideltaBoxes, fvg_type_lbl_b, valLine, vahLine, valLbl, vahLbl))

            if en_lvz
                float lvz_lo_b = fvg_lower
                float lvz_hi_b = fvg_upper
                float lvz_fibEmpty_b = f_lvz_fib_empty_ratio(lvz_lo_b, lvz_hi_b)
                float lvz_clEmpty_b  = f_lvz_bin_empty_ratio(lvz_lo_b, lvz_hi_b, lvz_profile_lookback, lvz_profile_bins)
                bool  lvz_liqOk_b    = not lvz_require_liq or f_lvz_liq_in_range(lvz_lo_b, lvz_hi_b)
                bool  lvz_bothEmpty_b = (lvz_fibEmpty_b >= lvz_min_empty_pct/100.0) and (lvz_clEmpty_b >= lvz_min_empty_pct/100.0)
                if lvz_bothEmpty_b and lvz_liqOk_b
                    box lvz_zb_b = na
                    [lvz_confl_b, lvz_hasOB_b, lvz_hasBrk_b, lvz_hasSD_b, lvz_hasFib_b, lvz_hasOTE_b] = f_lvz_check_confluence(lvz_hi_b, lvz_lo_b, true)
                    bool lvz_isDir_b = f_lvz_check_directional(lvz_hi_b, lvz_lo_b)
                    float lvz_width_b = (lvz_hi_b - lvz_lo_b) / math.max(ta.atr(14), syminfo.mintick)
                    bool lvz_isInv_b = lvz_link_ifvg and ifvg_bull_made
                    int lvz_qual_b = f_lvz_quality(lvz_confl_b, lvz_isDir_b, lvz_width_b, lvz_isInv_b)
                    color lvz_bg_use_b   = lvz_isInv_b ? lvz_ibg_bull : lvz_bg_bull
                    int   lvz_alpha_b    = lvz_show_quality_shade ? f_quality_alpha(lvz_qual_b / 9.0) : 0
                    color lvz_final_b    = lvz_show_quality_shade ? color.new(lvz_bg_use_b, lvz_alpha_b) : lvz_bg_use_b
                    bool  lvz_visible_b  = f_dva_visible(lvz_alpha_b)
                    if lvz_visible_b
                        if en_lvz_vis
                            lvz_zb_b := box.new(bar_index-1, lvz_hi_b, bar_index+lvz_extend_bars, lvz_lo_b, bgcolor=lvz_final_b, border_color=lvz_border_bull, border_width=lvz_border_w, border_style=lvz_isInv_b ? line.style_dashed : line.style_solid, extend=extend.none)
                        lvz_zone new_zone_b = lvz_zone.new(lvz_zb_b, na, true, bar_index, lvz_hi_b, lvz_lo_b, true, false, false)
                        new_zone_b.touches := 0
                        new_zone_b.state := 1
                        new_zone_b.confluence := lvz_confl_b
                        new_zone_b.quality := lvz_qual_b
                        new_zone_b.direction := 0
                        new_zone_b.mtfConf := 0
                        new_zone_b.widthATR := lvz_width_b
                        new_zone_b.isDirectional := lvz_isDir_b
                        new_zone_b.isInversion := lvz_isInv_b
                        new_zone_b.hasOB := lvz_hasOB_b
                        new_zone_b.hasBreaker := lvz_hasBrk_b
                        new_zone_b.hasSD := lvz_hasSD_b
                        new_zone_b.hasFib := lvz_hasFib_b
                        new_zone_b.hasOTE := lvz_hasOTE_b

                        // ── имя по центру ("LVZ"/"iLVZ") — без описания ──
                        if en_lvz_vis and lvz_show_label
                            int lvz_lbl_x_b = int(math.avg(bar_index - 1, bar_index + lvz_extend_bars))
                            new_zone_b.zlbl := label.new(lvz_lbl_x_b, (lvz_hi_b+lvz_lo_b)/2, lvz_isInv_b ? "iLVZ" : "LVZ", style=label.style_label_center, color=color.new(color.white,100), textcolor=lvz_text_col, size=lvz_text_size=="Tiny"?size.tiny:lvz_text_size=="Large"?size.large:lvz_text_size=="Normal"?size.normal:size.small, textalign=text.align_center)

                        // ── дельта-профиль зоны (единые настройки раздела 8) — считается сразу, чтобы
                        // можно было сопоставить с ним собственную Value Area зоны по длине бина ──
                        [lvz_dBull_b, lvz_dBear_b] = f_delta_profile_generic(lvz_lo_b, lvz_hi_b, lvz_profile_lookback, dva_delta_bins)
                        new_zone_b.deltaBull := lvz_dBull_b
                        new_zone_b.deltaBear := lvz_dBear_b
                        new_zone_b.deltaBoxes := array.new<box>()

                        float lvz_totalVol_b = lvz_dBull_b.sum() + lvz_dBear_b.sum()
                        if lvz_totalVol_b > 0
                            float lvz_step_b = (lvz_hi_b - lvz_lo_b) / dva_delta_bins
                            float lvz_maxTot_b = 0.0
                            int   lvz_pocIdx_b = 0
                            for r = 0 to dva_delta_bins - 1
                                float tot = array.get(lvz_dBull_b, r) + array.get(lvz_dBear_b, r)
                                if tot > lvz_maxTot_b
                                    lvz_maxTot_b := tot
                                    lvz_pocIdx_b := r

                            // ── максимальный по модулю бин дельты — вычисляется один раз, используется
                            // и для рамки бинов, и для сопоставления линий VAL/VAH/POC ──
                            float lvz_maxAbs_b = 0.0
                            int   lvz_maxIdx_b = -1
                            for r = 0 to dva_delta_bins - 1
                                float d0 = array.get(lvz_dBull_b, r) - array.get(lvz_dBear_b, r)
                                if math.abs(d0) > lvz_maxAbs_b
                                    lvz_maxAbs_b := math.abs(d0)
                                    lvz_maxIdx_b := r

                            if dva_show_own_va
                                [lvz_va_lo_b, lvz_va_hi_b] = f_calc_value_area(lvz_dBull_b, lvz_dBear_b, dva_delta_bins, lvz_pocIdx_b, lvz_totalVol_b, dva_own_va_threshold)
                                float lvz_ownPoc_b = lvz_lo_b + lvz_step_b * (lvz_pocIdx_b + 0.5)
                                float lvz_ownVal_b = lvz_lo_b + lvz_step_b * lvz_va_lo_b
                                float lvz_ownVah_b = lvz_lo_b + lvz_step_b * (lvz_va_hi_b + 1)
                                [lvz_poc_w_b, lvz_poc_isMax_b] = f_dva_bin_match(lvz_ownPoc_b, lvz_lo_b, lvz_hi_b, dva_delta_bins, lvz_dBull_b, lvz_dBear_b, lvz_maxIdx_b, lvz_maxAbs_b, dva_delta_max_width)
                                [lvz_val_w_b, lvz_val_isMax_b] = f_dva_bin_match(lvz_ownVal_b, lvz_lo_b, lvz_hi_b, dva_delta_bins, lvz_dBull_b, lvz_dBear_b, lvz_maxIdx_b, lvz_maxAbs_b, dva_delta_max_width)
                                [lvz_vah_w_b, lvz_vah_isMax_b] = f_dva_bin_match(lvz_ownVah_b, lvz_lo_b, lvz_hi_b, dva_delta_bins, lvz_dBull_b, lvz_dBear_b, lvz_maxIdx_b, lvz_maxAbs_b, dva_delta_max_width)
                                new_zone_b.ownPocLn  := line.new(bar_index - 1, lvz_ownPoc_b, bar_index - 1 + lvz_poc_w_b, lvz_ownPoc_b, color=dva_poc_line_color, width=dva_poc_line_width, style=lvz_poc_isMax_b ? line.style_solid : line.style_dashed)
                                new_zone_b.ownValLn  := line.new(bar_index - 1, lvz_ownVal_b, bar_index - 1 + lvz_val_w_b, lvz_ownVal_b, color=dva_val_line_color, width=dva_val_line_width, style=lvz_val_isMax_b ? line.style_solid : line.style_dashed)
                                new_zone_b.ownVahLn  := line.new(bar_index - 1, lvz_ownVah_b, bar_index - 1 + lvz_vah_w_b, lvz_ownVah_b, color=dva_vah_line_color, width=dva_vah_line_width, style=lvz_vah_isMax_b ? line.style_solid : line.style_dashed)
                                new_zone_b.ownPocLbl := label.new(bar_index - 1, lvz_ownPoc_b, "POC " + str.tostring(lvz_ownPoc_b, format.mintick), style=label.style_label_left, color=color.new(color.white,100), textcolor=dva_poc_line_color, size=f_dva_txsz(dva_va_text_size))
                                new_zone_b.ownValLbl := label.new(bar_index - 1, lvz_ownVal_b, "VAL " + str.tostring(lvz_ownVal_b, format.mintick), style=label.style_label_left, color=color.new(color.white,100), textcolor=dva_val_line_color, size=f_dva_txsz(dva_va_text_size))
                                new_zone_b.ownVahLbl := label.new(bar_index - 1, lvz_ownVah_b, "VAH " + str.tostring(lvz_ownVah_b, format.mintick), style=label.style_label_left, color=color.new(color.white,100), textcolor=dva_vah_line_color, size=f_dva_txsz(dva_va_text_size))

                            if dva_show_delta and lvz_maxAbs_b > 0
                                for r = 0 to dva_delta_bins - 1
                                    float bandLo = lvz_lo_b + lvz_step_b * r
                                    float bandHi = bandLo + lvz_step_b
                                    float d = array.get(lvz_dBull_b, r) - array.get(lvz_dBear_b, r)
                                    if d != 0
                                        int wBars = math.max(1, int((math.abs(d) / lvz_maxAbs_b) * dva_delta_max_width))
                                        color dcol = d >= 0 ? dva_delta_bull_color : dva_delta_bear_color
                                        bool  isMaxBin = r == lvz_maxIdx_b
                                        color borderCol = isMaxBin ? dva_max_border_color : color.new(dcol, 0)
                                        int   borderW   = isMaxBin ? dva_max_border_width : 1
                                        new_zone_b.deltaBoxes.push(box.new(bar_index - 1, bandHi, bar_index - 1 + wBars, bandLo, bgcolor=dcol, border_color=borderCol, border_width=borderW, text=dva_show_delta_text ? "Δ" + str.tostring(d, format.volume) : "", text_color=color.black, text_size=f_dva_txsz(dva_delta_text_size), text_halign=text.align_left))

                        lvzBullZones.push(new_zone_b)

    if fvg_bear_cond
        fvg_pocLblAllow := false
        float fvg_upper = low[2], float fvg_lower = high

        bool ifvg_bear_made = false
        if en_ifvg and fvgMem.size() > 0
            for m in fvgMem
                if m.up and m.breakBar >= 0 and f_zones_overlap(fvg_upper, fvg_lower, m.hi, m.lo)
                    ifvg_bear_made := true
                    break

        int fvg_qmask_s = 0
        fvg_qmask_s += export_ob_state == -1 ? 1 : 0
        fvg_qmask_s += sd_in_supply ? 1 : 0
        fvg_qmask_s += (en_va and not na(va_val_price) and not na(va_vah_price) and f_zones_overlap(fvg_upper, fvg_lower, va_vah_price, va_val_price)) ? 1 : 0
        fvg_qmask_s += ifvg_bear_made ? 1 : 0
        float fvg_qratio_s = fvg_qmask_s / 4.0
        int   fvg_alpha_s  = f_quality_alpha(fvg_qratio_s)
        bool  fvg_visible_s = f_dva_visible(fvg_alpha_s)

        if fvg_visible_s
            color fvg_box_col_s = ifvg_bear_made ? ifvg_bear_color : fvg_bear_color
            color fvg_box_bg_s  = fvg_show_quality_shade ? color.new(fvg_box_col_s, fvg_alpha_s) : color.new(fvg_box_col_s, 70)
            box   fvg_box   = box.new(bar_index - 1, fvg_upper, bar_index + 3, fvg_lower, border_color=na, border_width=0, bgcolor=fvg_box_bg_s)
            float binSize   = (fvg_upper - fvg_lower) / fvg_bins
            array<float> volumeP     = array.new<float>(fvg_bins, 0.)
            array<box>   volumeBoxes = array.new<box>(fvg_bins, box(na))
            line  poc = line(na), label pocLbl = label(na)
            line  valLine = line(na), line vahLine = line(na)
            label valLbl = label(na), label vahLbl = label(na)

            array<float> ideltaBull_s = array.new_float()
            array<float> ideltaBear_s = array.new_float()
            array<box>   ideltaBoxes_s = array.new<box>()
            if dva_show_delta and cls_array.size() > 0
                [db2, dr2] = f_ifvg_delta_profile(cls_array, vol_array, fvg_upper, fvg_lower, dva_delta_bins)
                ideltaBull_s := db2
                ideltaBear_s := dr2
            float ifvg_maxAbsD_s = 0.0
            int   ifvg_maxIdx_s  = -1
            if array.size(ideltaBull_s) > 0
                for bnk = 0 to dva_delta_bins - 1
                    float d0 = array.get(ideltaBull_s, bnk) - array.get(ideltaBear_s, bnk)
                    if math.abs(d0) > ifvg_maxAbsD_s
                        ifvg_maxAbsD_s := math.abs(d0)
                        ifvg_maxIdx_s := bnk

            if cls_array.size() > 0
                for k = 0 to fvg_bins - 1
                    float lower_b = fvg_lower + binSize * k, float mid_b = lower_b + binSize / 2
                    for i = 0 to cls_array.size() - 1
                        if math.abs(cls_array.get(i) - mid_b) <= binSize
                            volumeP.set(k, volumeP.get(k) + vol_array.get(i))
            int fvg_poc_idx_s = -1
            for k = 0 to fvg_bins - 1
                float lower_b = fvg_lower + binSize * k, float upper_b = lower_b + binSize, float mid_b = lower_b + binSize / 2
                volumeBoxes.set(k, box.new(bar_index - 1, upper_b, bar_index - 1, lower_b, border_width=0))
                if volumeP.max() != 0 and volumeP.get(k) == volumeP.max() and not fvg_pocLblAllow
                    fvg_poc_idx_s := k
                    [poc_w_s, poc_isMax_s] = f_dva_bin_match(mid_b, fvg_lower, fvg_upper, dva_delta_bins, ideltaBull_s, ideltaBear_s, ifvg_maxIdx_s, ifvg_maxAbsD_s, dva_delta_max_width)
                    poc    := line.new(bar_index - 1, mid_b, bar_index - 1 + poc_w_s, mid_b, color=dva_poc_line_color, width=dva_poc_line_width, style=poc_isMax_s ? line.style_solid : line.style_dashed)
                    pocLbl := label.new(bar_index - 1, mid_b, "POC " + str.tostring(mid_b, format.mintick), style=label.style_label_left, color=color.new(color.white, 100), textcolor=dva_poc_line_color, size=f_dva_txsz(dva_va_text_size))
                    fvg_pocLblAllow := true

            if dva_show_own_va and fvg_poc_idx_s >= 0 and volumeP.sum() > 0
                [fvg_va_lo_s, fvg_va_hi_s] = f_calc_value_area_single(volumeP, fvg_bins, fvg_poc_idx_s, volumeP.sum(), dva_own_va_threshold)
                float fvg_val_price_s = fvg_lower + binSize * fvg_va_lo_s
                float fvg_vah_price_s = fvg_lower + binSize * (fvg_va_hi_s + 1)
                [val_w_s, val_isMax_s] = f_dva_bin_match(fvg_val_price_s, fvg_lower, fvg_upper, dva_delta_bins, ideltaBull_s, ideltaBear_s, ifvg_maxIdx_s, ifvg_maxAbsD_s, dva_delta_max_width)
                [vah_w_s, vah_isMax_s] = f_dva_bin_match(fvg_vah_price_s, fvg_lower, fvg_upper, dva_delta_bins, ideltaBull_s, ideltaBear_s, ifvg_maxIdx_s, ifvg_maxAbsD_s, dva_delta_max_width)
                valLine := line.new(bar_index - 1, fvg_val_price_s, bar_index - 1 + val_w_s, fvg_val_price_s, color=dva_val_line_color, width=dva_val_line_width, style=val_isMax_s ? line.style_solid : line.style_dashed)
                vahLine := line.new(bar_index - 1, fvg_vah_price_s, bar_index - 1 + vah_w_s, fvg_vah_price_s, color=dva_vah_line_color, width=dva_vah_line_width, style=vah_isMax_s ? line.style_solid : line.style_dashed)
                valLbl  := label.new(bar_index - 1, fvg_val_price_s, "VAL " + str.tostring(fvg_val_price_s, format.mintick), style=label.style_label_left, color=color.new(color.white, 100), textcolor=dva_val_line_color, size=f_dva_txsz(dva_va_text_size))
                vahLbl  := label.new(bar_index - 1, fvg_vah_price_s, "VAH " + str.tostring(fvg_vah_price_s, format.mintick), style=label.style_label_left, color=color.new(color.white, 100), textcolor=dva_vah_line_color, size=f_dva_txsz(dva_va_text_size))

            label fvg_type_lbl_s = na
            if fvg_show_type_label
                int   fvg_lbl_x_s = int(math.avg(bar_index - 1, bar_index + 3))
                float fvg_lbl_y_s = (fvg_upper + fvg_lower) / 2
                fvg_lbl_sz_s = fvg_type_label_size == "Tiny" ? size.tiny : fvg_type_label_size == "Normal" ? size.normal : size.small
                fvg_type_lbl_s := label.new(fvg_lbl_x_s, fvg_lbl_y_s, ifvg_bear_made ? "iFVG" : "FVG", style=label.style_label_center, color=color.new(color.white, 100), textcolor=fvg_type_label_color, size=fvg_lbl_sz_s, textalign=text.align_center)

            fvgs.push(fvg_obj.new(fvg_box, false, volumeP, volumeBoxes, poc, pocLbl, bar_index, ifvg_bear_made, ideltaBull_s, ideltaBear_s, ideltaBoxes_s, fvg_type_lbl_s, valLine, vahLine, valLbl, vahLbl))

            if en_lvz
                float lvz_lo_s = fvg_lower
                float lvz_hi_s = fvg_upper
                float lvz_fibEmpty_s = f_lvz_fib_empty_ratio(lvz_lo_s, lvz_hi_s)
                float lvz_clEmpty_s  = f_lvz_bin_empty_ratio(lvz_lo_s, lvz_hi_s, lvz_profile_lookback, lvz_profile_bins)
                bool  lvz_liqOk_s    = not lvz_require_liq or f_lvz_liq_in_range(lvz_lo_s, lvz_hi_s)
                bool  lvz_bothEmpty_s = (lvz_fibEmpty_s >= lvz_min_empty_pct/100.0) and (lvz_clEmpty_s >= lvz_min_empty_pct/100.0)
                if lvz_bothEmpty_s and lvz_liqOk_s
                    box lvz_zb_s = na
                    [lvz_confl_s, lvz_hasOB_s, lvz_hasBrk_s, lvz_hasSD_s, lvz_hasFib_s, lvz_hasOTE_s] = f_lvz_check_confluence(lvz_hi_s, lvz_lo_s, false)
                    bool lvz_isDir_s = f_lvz_check_directional(lvz_hi_s, lvz_lo_s)
                    float lvz_width_s = (lvz_hi_s - lvz_lo_s) / math.max(ta.atr(14), syminfo.mintick)
                    bool lvz_isInv_s = lvz_link_ifvg and ifvg_bear_made
                    int lvz_qual_s = f_lvz_quality(lvz_confl_s, lvz_isDir_s, lvz_width_s, lvz_isInv_s)
                    color lvz_bg_use_s   = lvz_isInv_s ? lvz_ibg_bear : lvz_bg_bear
                    int   lvz_alpha_s    = lvz_show_quality_shade ? f_quality_alpha(lvz_qual_s / 9.0) : 0
                    color lvz_final_s    = lvz_show_quality_shade ? color.new(lvz_bg_use_s, lvz_alpha_s) : lvz_bg_use_s
                    bool  lvz_visible_s  = f_dva_visible(lvz_alpha_s)
                    if lvz_visible_s
                        if en_lvz_vis
                            lvz_zb_s := box.new(bar_index-1, lvz_hi_s, bar_index+lvz_extend_bars, lvz_lo_s, bgcolor=lvz_final_s, border_color=lvz_border_bear, border_width=lvz_border_w, border_style=lvz_isInv_s ? line.style_dashed : line.style_solid, extend=extend.none)
                        lvz_zone new_zone_s = lvz_zone.new(lvz_zb_s, na, false, bar_index, lvz_hi_s, lvz_lo_s, true, false, false)
                        new_zone_s.touches := 0
                        new_zone_s.state := 1
                        new_zone_s.confluence := lvz_confl_s
                        new_zone_s.quality := lvz_qual_s
                        new_zone_s.direction := 0
                        new_zone_s.mtfConf := 0
                        new_zone_s.widthATR := lvz_width_s
                        new_zone_s.isDirectional := lvz_isDir_s
                        new_zone_s.isInversion := lvz_isInv_s
                        new_zone_s.hasOB := lvz_hasOB_s
                        new_zone_s.hasBreaker := lvz_hasBrk_s
                        new_zone_s.hasSD := lvz_hasSD_s
                        new_zone_s.hasFib := lvz_hasFib_s
                        new_zone_s.hasOTE := lvz_hasOTE_s

                        if en_lvz_vis and lvz_show_label
                            int lvz_lbl_x_s = int(math.avg(bar_index - 1, bar_index + lvz_extend_bars))
                            new_zone_s.zlbl := label.new(lvz_lbl_x_s, (lvz_hi_s+lvz_lo_s)/2, lvz_isInv_s ? "iLVZ" : "LVZ", style=label.style_label_center, color=color.new(color.white,100), textcolor=lvz_text_col, size=lvz_text_size=="Tiny"?size.tiny:lvz_text_size=="Large"?size.large:lvz_text_size=="Normal"?size.normal:size.small, textalign=text.align_center)

                        [lvz_dBull_s, lvz_dBear_s] = f_delta_profile_generic(lvz_lo_s, lvz_hi_s, lvz_profile_lookback, dva_delta_bins)
                        new_zone_s.deltaBull := lvz_dBull_s
                        new_zone_s.deltaBear := lvz_dBear_s
                        new_zone_s.deltaBoxes := array.new<box>()

                        float lvz_totalVol_s = lvz_dBull_s.sum() + lvz_dBear_s.sum()
                        if lvz_totalVol_s > 0
                            float lvz_step_s = (lvz_hi_s - lvz_lo_s) / dva_delta_bins
                            float lvz_maxTot_s = 0.0
                            int   lvz_pocIdx_s = 0
                            for r = 0 to dva_delta_bins - 1
                                float tot = array.get(lvz_dBull_s, r) + array.get(lvz_dBear_s, r)
                                if tot > lvz_maxTot_s
                                    lvz_maxTot_s := tot
                                    lvz_pocIdx_s := r

                            float lvz_maxAbs_s = 0.0
                            int   lvz_maxIdx_s = -1
                            for r = 0 to dva_delta_bins - 1
                                float d0 = array.get(lvz_dBull_s, r) - array.get(lvz_dBear_s, r)
                                if math.abs(d0) > lvz_maxAbs_s
                                    lvz_maxAbs_s := math.abs(d0)
                                    lvz_maxIdx_s := r

                            if dva_show_own_va
                                [lvz_va_lo_s, lvz_va_hi_s] = f_calc_value_area(lvz_dBull_s, lvz_dBear_s, dva_delta_bins, lvz_pocIdx_s, lvz_totalVol_s, dva_own_va_threshold)
                                float lvz_ownPoc_s = lvz_lo_s + lvz_step_s * (lvz_pocIdx_s + 0.5)
                                float lvz_ownVal_s = lvz_lo_s + lvz_step_s * lvz_va_lo_s
                                float lvz_ownVah_s = lvz_lo_s + lvz_step_s * (lvz_va_hi_s + 1)
                                [lvz_poc_w_s, lvz_poc_isMax_s] = f_dva_bin_match(lvz_ownPoc_s, lvz_lo_s, lvz_hi_s, dva_delta_bins, lvz_dBull_s, lvz_dBear_s, lvz_maxIdx_s, lvz_maxAbs_s, dva_delta_max_width)
                                [lvz_val_w_s, lvz_val_isMax_s] = f_dva_bin_match(lvz_ownVal_s, lvz_lo_s, lvz_hi_s, dva_delta_bins, lvz_dBull_s, lvz_dBear_s, lvz_maxIdx_s, lvz_maxAbs_s, dva_delta_max_width)
                                [lvz_vah_w_s, lvz_vah_isMax_s] = f_dva_bin_match(lvz_ownVah_s, lvz_lo_s, lvz_hi_s, dva_delta_bins, lvz_dBull_s, lvz_dBear_s, lvz_maxIdx_s, lvz_maxAbs_s, dva_delta_max_width)
                                new_zone_s.ownPocLn  := line.new(bar_index - 1, lvz_ownPoc_s, bar_index - 1 + lvz_poc_w_s, lvz_ownPoc_s, color=dva_poc_line_color, width=dva_poc_line_width, style=lvz_poc_isMax_s ? line.style_solid : line.style_dashed)
                                new_zone_s.ownValLn  := line.new(bar_index - 1, lvz_ownVal_s, bar_index - 1 + lvz_val_w_s, lvz_ownVal_s, color=dva_val_line_color, width=dva_val_line_width, style=lvz_val_isMax_s ? line.style_solid : line.style_dashed)
                                new_zone_s.ownVahLn  := line.new(bar_index - 1, lvz_ownVah_s, bar_index - 1 + lvz_vah_w_s, lvz_ownVah_s, color=dva_vah_line_color, width=dva_vah_line_width, style=lvz_vah_isMax_s ? line.style_solid : line.style_dashed)
                                new_zone_s.ownPocLbl := label.new(bar_index - 1, lvz_ownPoc_s, "POC " + str.tostring(lvz_ownPoc_s, format.mintick), style=label.style_label_left, color=color.new(color.white,100), textcolor=dva_poc_line_color, size=f_dva_txsz(dva_va_text_size))
                                new_zone_s.ownValLbl := label.new(bar_index - 1, lvz_ownVal_s, "VAL " + str.tostring(lvz_ownVal_s, format.mintick), style=label.style_label_left, color=color.new(color.white,100), textcolor=dva_val_line_color, size=f_dva_txsz(dva_va_text_size))
                                new_zone_s.ownVahLbl := label.new(bar_index - 1, lvz_ownVah_s, "VAH " + str.tostring(lvz_ownVah_s, format.mintick), style=label.style_label_left, color=color.new(color.white,100), textcolor=dva_vah_line_color, size=f_dva_txsz(dva_va_text_size))

                            if dva_show_delta and lvz_maxAbs_s > 0
                                for r = 0 to dva_delta_bins - 1
                                    float bandLo = lvz_lo_s + lvz_step_s * r
                                    float bandHi = bandLo + lvz_step_s
                                    float d = array.get(lvz_dBull_s, r) - array.get(lvz_dBear_s, r)
                                    if d != 0
                                        int wBars = math.max(1, int((math.abs(d) / lvz_maxAbs_s) * dva_delta_max_width))
                                        color dcol = d >= 0 ? dva_delta_bull_color : dva_delta_bear_color
                                        bool  isMaxBin = r == lvz_maxIdx_s
                                        color borderCol = isMaxBin ? dva_max_border_color : color.new(dcol, 0)
                                        int   borderW   = isMaxBin ? dva_max_border_width : 1
                                        new_zone_s.deltaBoxes.push(box.new(bar_index - 1, bandHi, bar_index - 1 + wBars, bandLo, bgcolor=dcol, border_color=borderCol, border_width=borderW, text=dva_show_delta_text ? "Δ" + str.tostring(d, format.volume) : "", text_color=color.black, text_size=f_dva_txsz(dva_delta_text_size), text_halign=text.align_left))

                        lvzBearZones.push(new_zone_s)

    if fvgs.size() > 0
        export_ifvg_delta_sign := 0.0
        for i = fvgs.size() - 1 to 0
            f = fvgs.get(i)
            if bar_index - f.age > 720
                if en_ifvg
                    fvgMem.push(fvg_mem.new(f.FVG.get_top(), f.FVG.get_bottom(), f.isBull, f.age, bar_index, f.FVG.get_top(), f.FVG.get_bottom()))
                f.FVG.delete(), f.poc.delete(), f.pocLbl.delete()
                if not na(f.typeLbl)
                    label.delete(f.typeLbl)
                if not na(f.valLine)
                    line.delete(f.valLine)
                if not na(f.vahLine)
                    line.delete(f.vahLine)
                if not na(f.valLbl)
                    label.delete(f.valLbl)
                if not na(f.vahLbl)
                    label.delete(f.vahLbl)
                for b in f.volumeBoxes
                    b.delete()
                if array.size(f.deltaBoxes) > 0
                    for db in f.deltaBoxes
                        db.delete()
                fvgs.remove(i)
                continue
            f.FVG.set_right(bar_index + 25)
            float top  = f.FVG.get_top(), float bot = f.FVG.get_bottom()
            int   left = f.FVG.get_left(), int right = f.FVG.get_right()
            boxes = f.volumeBoxes
            // ── ИЗМЕНЕНО: линии POC/VAL/VAH больше НЕ продлеваются на всю ширину блока каждый бар —
            // их длина зафиксирована по ширине соответствующего бина дельты в момент создания. ──
            f.FVG.set_text((f.isInversion ? "i" : "") + str.tostring(f.volumeProfile.sum(), format.volume))
            f.FVG.set_text_halign(text.align_right)
            f.FVG.set_text_valign(f.isBull ? text.align_bottom : text.align_top)
            f.FVG.set_text_size(size.normal), f.FVG.set_text_color(chart.fg_color)

            if fvg_show_type_label and not na(f.typeLbl)
                label.set_x(f.typeLbl, int(math.avg(left, right)))
                label.set_y(f.typeLbl, (top + bot) / 2)

            // ── дельта-гистограмма внутри блока — для FVG и iFVG, растёт от left вправо, единые
            // настройки раздела 8. Максимальный по модулю бин: обычная заливка bull/bear + выделенная
            // рамка (dva_max_border_color/width), вместо перекраски заливки. ──
            if dva_show_delta and array.size(f.deltaBull) > 0
                if array.size(f.deltaBoxes) == 0
                    float ifvg_step = (top - bot) / dva_delta_bins
                    float maxAbsD = 0.0
                    int   maxIdxD = -1
                    for bnk = 0 to dva_delta_bins - 1
                        float d = array.get(f.deltaBull, bnk) - array.get(f.deltaBear, bnk)
                        if math.abs(d) > maxAbsD
                            maxAbsD := math.abs(d)
                            maxIdxD := bnk
                    if maxAbsD > 0
                        for bnk = 0 to dva_delta_bins - 1
                            float bandLo = bot + ifvg_step * bnk
                            float bandHi = bandLo + ifvg_step
                            float d = array.get(f.deltaBull, bnk) - array.get(f.deltaBear, bnk)
                            if d != 0
                                int wBars = math.max(1, int((math.abs(d)/maxAbsD)*dva_delta_max_width))
                                color dcol = d >= 0 ? dva_delta_bull_color : dva_delta_bear_color
                                bool  isMaxBin = bnk == maxIdxD
                                color borderCol = isMaxBin ? dva_max_border_color : color.new(dcol, 0)
                                int   borderW   = isMaxBin ? dva_max_border_width : 1
                                f.deltaBoxes.push(box.new(left, bandHi, left + wBars, bandLo, bgcolor=dcol, border_color=borderCol, border_width=borderW, text=dva_show_delta_text ? "Δ"+str.tostring(d, format.volume) : "", text_color=color.black, text_size=f_dva_txsz(dva_delta_text_size), text_halign=text.align_left))
                if close <= top and close >= bot
                    float netD = f.deltaBull.sum() - f.deltaBear.sum()
                    export_ifvg_delta_sign := netD > 0 ? 1.0 : netD < 0 ? -1.0 : 0.0

            if f.isBull
                if low < f.FVG.get_bottom()
                    if en_ifvg
                        fvgMem.push(fvg_mem.new(top, bot, true, f.age, bar_index, top, bot))
                    f.FVG.delete(), f.poc.delete(), f.pocLbl.delete()
                    if not na(f.typeLbl)
                        label.delete(f.typeLbl)
                    if not na(f.valLine)
                        line.delete(f.valLine)
                    if not na(f.vahLine)
                        line.delete(f.vahLine)
                    if not na(f.valLbl)
                        label.delete(f.valLbl)
                    if not na(f.vahLbl)
                        label.delete(f.vahLbl)
                    for b in boxes
                        b.delete()
                    if array.size(f.deltaBoxes) > 0
                        for db in f.deltaBoxes
                            db.delete()
                    fvgs.remove(i)
                else
                    for k = 0 to fvg_bins - 1
                        float volRatio = f.volumeProfile.get(k) / math.max(f.volumeProfile.max(), 1) * 50
                        int bw = math.round(volRatio * (right - left) / 100)
                        if bw != 0 and fvg_hideVP
                            boxes.get(k).set_right(left + bw)
                            color vpCol = f.isInversion ? ifvg_bull_color : fvg_bull_color
                            boxes.get(k).set_bgcolor(color.from_gradient(f.volumeProfile.get(k), 0, f.volumeProfile.max(), color.new(vpCol, 100), vpCol))
            else
                if high > f.FVG.get_top()
                    if en_ifvg
                        fvgMem.push(fvg_mem.new(top, bot, false, f.age, bar_index, top, bot))
                    f.FVG.delete(), f.poc.delete(), f.pocLbl.delete()
                    if not na(f.typeLbl)
                        label.delete(f.typeLbl)
                    if not na(f.valLine)
                        line.delete(f.valLine)
                    if not na(f.vahLine)
                        line.delete(f.vahLine)
                    if not na(f.valLbl)
                        label.delete(f.valLbl)
                    if not na(f.vahLbl)
                        label.delete(f.vahLbl)
                    for b in boxes
                        b.delete()
                    if array.size(f.deltaBoxes) > 0
                        for db in f.deltaBoxes
                            db.delete()
                    fvgs.remove(i)
                else
                    for k = 0 to fvg_bins - 1
                        int bw = math.round(f.volumeProfile.get(k) / math.max(f.volumeProfile.max(), 1) * (right - left) / 2.5)
                        if bw != 0 and fvg_hideVP
                            boxes.get(k).set_right(left + bw)
                            color vpCol2 = f.isInversion ? ifvg_bear_color : fvg_bear_color
                            boxes.get(k).set_bgcolor(color.from_gradient(f.volumeProfile.get(k), 0, f.volumeProfile.max(), color.new(vpCol2, 100), vpCol2))

// ====================================================================================================================
// LVZ — ОБНОВЛЕНИЕ / ЧИСТКА / СИГНАЛ. Имя зоны фиксируется один раз при создании; каждый бар обновляется
// только позиция подписи и продление самой зоны (zbox) вправо. Линии POC/VAL/VAH зоны больше НЕ
// продлеваются каждый бар — их длина фиксирована по ширине бина дельты в момент создания зоны.
// ====================================================================================================================

lvz_vol_sma = ta.sma(volume, 20)
bool lvz_vol_spike_now = volume > lvz_vol_sma * lvz_vol_mult

int export_lvz_bull = 0
int export_lvz_bear = 0
float export_lvz_width_bull = na
float export_lvz_width_bear = na

f_lvz_mtf_overlap(float zTop, float zBot) =>
    int cnt = 0
    if g_ltf1_vac and f_zones_overlap(zTop, zBot, g_ltf1_vhi, g_ltf1_vlo)
        cnt += 1
    if g_ltf2_vac and f_zones_overlap(zTop, zBot, g_ltf2_vhi, g_ltf2_vlo)
        cnt += 1
    if g_ltf3_vac and f_zones_overlap(zTop, zBot, g_ltf3_vhi, g_ltf3_vlo)
        cnt += 1
    if g_htf1_vac and f_zones_overlap(zTop, zBot, g_htf1_vhi, g_htf1_vlo)
        cnt += 1
    if g_htf2_vac and f_zones_overlap(zTop, zBot, g_htf2_vhi, g_htf2_vlo)
        cnt += 1
    if g_htf3_vac and f_zones_overlap(zTop, zBot, g_htf3_vhi, g_htf3_vlo)
        cnt += 1
    cnt

if en_lvz
    if lvzBullZones.size() > 0
        for i = lvzBullZones.size()-1 to 0
            lvz_zone z = lvzBullZones.get(i)
            bool tooOld         = (bar_index - z.createdBar) > lvz_max_age_bars
            bool filledThrough  = lvz_invalidate_on_fill and close < z.bot
            bool priceInside    = close <= z.top and close >= z.bot
            z.direction := close < z.bot ? 1 : close > z.top ? 2 : 0
            if en_lvz_mtf
                z.mtfConf := f_lvz_mtf_overlap(z.top, z.bot)
            if priceInside
                z.touches := math.min(z.touches + 1, 9)
                if lvz_vol_spike_now
                    bool closedThrough = close < z.bot
                    bool closedBack    = close > (z.top+z.bot)/2
                    if closedBack and not closedThrough
                        z.state := 2
                        z.liqConfirmed := true
                    else if closedThrough
                        z.state := 3
                        z.liqConfirmed := true
            bool confirmExpired = z.state >= 2 and (bar_index - z.createdBar) > lvz_confirm_window
            if tooOld or filledThrough or confirmExpired
                if not na(z.zbox)
                    box.delete(z.zbox)
                if not na(z.zlbl)
                    label.delete(z.zlbl)
                if array.size(z.deltaBoxes) > 0
                    for db in z.deltaBoxes
                        db.delete()
                if not na(z.ownPocLn)
                    line.delete(z.ownPocLn)
                if not na(z.ownValLn)
                    line.delete(z.ownValLn)
                if not na(z.ownVahLn)
                    line.delete(z.ownVahLn)
                if not na(z.ownPocLbl)
                    label.delete(z.ownPocLbl)
                if not na(z.ownValLbl)
                    label.delete(z.ownValLbl)
                if not na(z.ownVahLbl)
                    label.delete(z.ownVahLbl)
                lvzBullZones.remove(i)
            else
                if en_lvz_vis and not na(z.zbox)
                    box.set_right(z.zbox, bar_index+lvz_extend_bars)
                if en_lvz_vis and not na(z.zlbl)
                    label.set_x(z.zlbl, int(math.avg(z.createdBar - 1, bar_index + lvz_extend_bars)))
            if priceInside
                int lvz_base_b   = 1
                int lvz_candid_b = lvz_vol_spike_now ? lvz_base_b + 1 : lvz_base_b
                export_lvz_bull := math.max(export_lvz_bull, lvz_candid_b)

    if lvzBearZones.size() > 0
        for i = lvzBearZones.size()-1 to 0
            lvz_zone z = lvzBearZones.get(i)
            bool tooOld         = (bar_index - z.createdBar) > lvz_max_age_bars
            bool filledThrough  = lvz_invalidate_on_fill and close > z.top
            bool priceInside    = close <= z.top and close >= z.bot
            z.direction := close < z.bot ? 1 : close > z.top ? 2 : 0
            if en_lvz_mtf
                z.mtfConf := f_lvz_mtf_overlap(z.top, z.bot)
            if priceInside
                z.touches := math.min(z.touches + 1, 9)
                if lvz_vol_spike_now
                    bool closedThrough = close > z.top
                    bool closedBack    = close < (z.top+z.bot)/2
                    if closedBack and not closedThrough
                        z.state := 2
                        z.liqConfirmed := true
                    else if closedThrough
                        z.state := 3
                        z.liqConfirmed := true
            bool confirmExpired = z.state >= 2 and (bar_index - z.createdBar) > lvz_confirm_window
            if tooOld or filledThrough or confirmExpired
                if not na(z.zbox)
                    box.delete(z.zbox)
                if not na(z.zlbl)
                    label.delete(z.zlbl)
                if array.size(z.deltaBoxes) > 0
                    for db in z.deltaBoxes
                        db.delete()
                if not na(z.ownPocLn)
                    line.delete(z.ownPocLn)
                if not na(z.ownValLn)
                    line.delete(z.ownValLn)
                if not na(z.ownVahLn)
                    line.delete(z.ownVahLn)
                if not na(z.ownPocLbl)
                    label.delete(z.ownPocLbl)
                if not na(z.ownValLbl)
                    label.delete(z.ownValLbl)
                if not na(z.ownVahLbl)
                    label.delete(z.ownVahLbl)
                lvzBearZones.remove(i)
            else
                if en_lvz_vis and not na(z.zbox)
                    box.set_right(z.zbox, bar_index+lvz_extend_bars)
                if en_lvz_vis and not na(z.zlbl)
                    label.set_x(z.zlbl, int(math.avg(z.createdBar - 1, bar_index + lvz_extend_bars)))
            if priceInside
                int lvz_base_s   = 1
                int lvz_candid_s = lvz_vol_spike_now ? lvz_base_s + 1 : lvz_base_s
                export_lvz_bear := math.max(export_lvz_bear, lvz_candid_s)

// ── Кодирование по лучшей (по quality) активной зоне (для Sniper) ──
f_lvz_encode(lvz_zone z) =>
    z.state + z.touches*10 + z.quality*100 + z.confluence*1000 + z.direction*10000 + z.mtfConf*100000 + (z.isInversion?1:0)*1000000

export_lvz_bull := 0
export_lvz_bear := 0
if lvzBullZones.size() > 0
    lvz_zone best_b = lvzBullZones.get(0)
    for zz in lvzBullZones
        if zz.quality > best_b.quality
            best_b := zz
    export_lvz_bull := f_lvz_encode(best_b)
    export_lvz_width_bull := best_b.widthATR
if lvzBearZones.size() > 0
    lvz_zone best_s = lvzBearZones.get(0)
    for zz in lvzBearZones
        if zz.quality > best_s.quality
            best_s := zz
    export_lvz_bear := f_lvz_encode(best_s)
    export_lvz_width_bear := best_s.widthATR

// ====================================================================================================================
// CLUSTERS VOLUME PROFILE (LUXALGO PORT)
// ====================================================================================================================

f_kmeans(int n, int k, int iterations) =>
    float[] prices  = array.new_float(0)
    float[] volumes = array.new_float(0)
    float minP = 1e10, maxP = -1e10
    for i = 0 to n - 1
        float p = hl2[i], float v = volume[i]
        prices.push(p), volumes.push(v)
        minP := math.min(minP, p), maxP := math.max(maxP, p)
    float[] centroids = array.new_float(k)
    float   step      = (maxP - minP) / (k + 1)
    for i = 0 to k - 1
        centroids.set(i, minP + (i + 1) * step)
    int[] assignments = array.new_int(n)
    for iter = 1 to iterations
        for i = 0 to n - 1
            float p = prices.get(i), int best_k = 0, float min_dist = 1e10
            for j = 0 to k - 1
                float dist = math.abs(p - centroids.get(j))
                if dist < min_dist
                    min_dist := dist, best_k := j
            assignments.set(i, best_k)
        float[] sum_pv = array.new_float(k, 0.0), float[] sum_v = array.new_float(k, 0.0)
        for i = 0 to n - 1
            int cluster = assignments.get(i)
            sum_pv.set(cluster, sum_pv.get(cluster) + prices.get(i) * volumes.get(i))
            sum_v.set(cluster,  sum_v.get(cluster)  + volumes.get(i))
        for j = 0 to k - 1
            if sum_v.get(j) > 0
                centroids.set(j, sum_pv.get(j) / sum_v.get(j))
    [assignments, centroids]

var box[]   clBoxes  = array.new_box()
var label[] clLabels = array.new_label()
var line[]  clLines  = array.new_line()

if en_1 and barstate.islast
    [assignments, centroids] = f_kmeans(lookback_1, k_1, iters_1)
    if clBoxes.size() > 0
        for b in clBoxes
            b.delete()
        clBoxes.clear()
    if clLabels.size() > 0
        for l in clLabels
            l.delete()
        clLabels.clear()
    if clLines.size() > 0
        for ln in clLines
            ln.delete()
        clLines.clear()
    int calcStart = bar_index - lookback_1 + 1, int vpStartX = bar_index + vpOffset
    int reserved = k_1 * 2, int labelsUsed = 0
    for c_id = 0 to k_1 - 1
        color clusterColor = PALETTE.get(c_id % PALETTE.size())
        float[] c_highs  = array.new_float(0), float[] c_lows   = array.new_float(0)
        float[] c_prices = array.new_float(0), float[] c_vols   = array.new_float(0)
        float c_min = 1e10, float c_max = -1e10, float c_total_vol = 0.0
        for i = 0 to lookback_1 - 1
            if assignments.get(i) == c_id
                float p = hl2[i], float v = volume[i], float h = high[i], float l = low[i]
                c_prices.push(p), c_vols.push(v), c_highs.push(h), c_lows.push(l)
                c_min := math.min(c_min, l), c_max := math.max(c_max, h)
                c_total_vol += v
                if showDots and labelsUsed < (1000 - reserved)
                    clLabels.push(label.new(bar_index - i, p, "•", color=#00000000, textcolor=clusterColor, style=label.style_label_center, size=size.small))
                    labelsUsed += 1
        if c_prices.size() > 0
            float[] binVols = array.new_float(rows_1, 0.0)
            float binSize = math.max((c_max - c_min) / rows_1, syminfo.mintick)
            for i = 0 to c_prices.size() - 1
                float b_h = c_highs.get(i), float b_l = c_lows.get(i), float b_v = c_vols.get(i)
                float wickRange = math.max(b_h - b_l, syminfo.mintick)
                for b_idx = 0 to rows_1 - 1
                    float binB = c_min + b_idx * binSize, float binT = binB + binSize
                    float iL = math.max(b_l, binB), float iH = math.min(b_h, binT)
                    if iH > iL
                        binVols.set(b_idx, binVols.get(b_idx) + b_v * (iH - iL) / wickRange)
            float maxBinVol = binVols.max(), int pocBinIdx = binVols.indexof(maxBinVol)
            for b_idx = 0 to rows_1 - 1
                float vol = binVols.get(b_idx)
                if vol == 0
                    continue
                float b_bottom = c_min + b_idx * binSize, float b_top = b_bottom + binSize
                int b_width = int((vol / math.max(maxBinVol, 1)) * vpWidth), int endX = vpStartX + b_width
                bool isPoc = b_idx == pocBinIdx
                clBoxes.push(box.new(vpStartX, b_top, endX, b_bottom, bgcolor=isPoc ? clusterColor : color.new(clusterColor, 75), border_color=isPoc ? clusterColor : #00000000))
                if isPoc
                    float pocY = (b_top + b_bottom) / 2
                    clLines.push(line.new(calcStart, pocY, vpStartX, pocY, color=clusterColor, width=1, style=line.style_dashed))
                    clLabels.push(label.new(calcStart, pocY, str.tostring(vol, format.volume), color=#00000000, textcolor=clusterColor, style=label.style_label_right, size=size.small))
                    clLabels.push(label.new(endX, pocY, "Total: " + str.tostring(c_total_vol, format.volume), color=#00000000, textcolor=clusterColor, style=label.style_label_left, size=size.small))

// ====================================================================================================================
// DYNAMIC HEATMAP V3 (BIGBELUGA PORT)
// ====================================================================================================================

var hm_boxes       = array.new<box>()
var hm_labels      = array.new<label>()
var hm_lines       = array.new<line>()
var hm_volume_bins = array.new<float>(hm_bins, 0.)
var int   export_hm_signal = 0
var float export_hm_vol    = 0.0
var bool  hm_vol_anomalous_now = false

if en_hm
    export_hm_signal := 0, export_hm_vol := 0.0
    hm_vol_anomalous_now := false
    float hm_vol     = math.sum(volume, 10)
    float hm_max_vol = ta.highest(hm_vol, hm_lookBack)
    float hm_nVol    = hm_max_vol > 0 ? (hm_vol / hm_max_vol * 100) : 0
    float hm_atr     = ta.atr(5) / 50
    float hm_offset  = ta.highest(hm_atr * hm_nVol, hm_lookBack)
    float hm_top     = ta.highest(high + hm_offset, hm_lookBack)
    float hm_bot     = ta.lowest(low   - hm_offset, hm_lookBack)
    float hm_step    = (hm_top - hm_bot) / hm_resolution
    float level1     = high + hm_atr * hm_nVol
    float level2     = low  - hm_atr * hm_nVol
    float hm_h = ta.highest(high, 2), float hm_l = ta.lowest(low, 2)
    if hm_h == high
        for i = 0 to hm_resolution - 1
            float lower = hm_bot + hm_step * i, float mid = lower + hm_step / 2
            if math.abs(level1 - mid) <= hm_step
                hm_pivots.push(hm_pivot.new(mid, bar_index, hm_nVol, hm_vol, false))
    if hm_l == low
        for i = 0 to hm_resolution - 1
            float lower = hm_bot + hm_step * i, float mid = lower + hm_step / 2
            if math.abs(level2 - mid) <= hm_step
                hm_pivots.push(hm_pivot.new(mid - hm_atr * hm_nVol, bar_index, hm_nVol, hm_vol, true))
    if hm_pivots.size() > 0
        for i = hm_pivots.size() - 1 to 0
            hm_pivot p = hm_pivots.get(i)
            if bar_index - p.index > hm_lookBack
                hm_pivots.remove(i)
                continue
            if p.isLower and low < p.value
                if barstate.isconfirmed and close > p.value
                    export_hm_signal := 1, export_hm_vol := p.vol
                    hm_pivots.remove(i)
            else if not p.isLower and high > p.value
                if barstate.isconfirmed and close < p.value
                    export_hm_signal := -1, export_hm_vol := p.vol
                    hm_pivots.remove(i)

    float hm_vol_anomaly_sma = ta.sma(volume, hm_vol_sma_len)
    hm_vol_anomalous_now := export_hm_signal != 0 and export_hm_vol > hm_vol_anomaly_sma * hm_vol_anomaly_mult

    if barstate.islast
        for ln in hm_lines
            ln.delete()
        for b in hm_boxes
            b.delete()
        for lbl in hm_labels
            lbl.delete()
        hm_lines.clear(), hm_boxes.clear(), hm_labels.clear()
        float step_draw = (hm_top - hm_bot) / hm_bins
        for j = 0 to hm_bins - 1
            hm_volume_bins.set(j, 0)
        if hm_pivots.size() > 0
            for i = 0 to hm_pivots.size() - 1
                hm_pivot lvl = hm_pivots.get(i)
                for j = 0 to hm_bins - 1
                    float lower = hm_bot + step_draw * j, float mid = lower + step_draw / 2
                    if math.abs(lvl.value - mid) < step_draw
                        hm_volume_bins.set(j, hm_volume_bins.get(j) + lvl.vol)
        for j = 0 to hm_bins - 1
            float lower  = hm_bot + step_draw * j
            float upper  = lower + step_draw
            float mid    = lower + step_draw / 2
            float voll   = hm_volume_bins.get(j)
            float max_v  = hm_volume_bins.max()
            float valueVol = max_v > 0 ? (voll / max_v * 50) : 0
            color col    = close > mid ? hm_buyColor : hm_sellColor
            color m_col  = color.from_gradient(voll, hm_volume_bins.min(), max_v, color.new(col, 80), color.new(col, 0))
            color m_col1 = color.from_gradient(voll, hm_volume_bins.min(), max_v, color.new(col, 50), color.new(col, 0))
            if not (close < upper and close > lower)
                if hm_displPf and valueVol != 0
                    hm_boxes.push(box.new(bar_index + 20, upper, bar_index + 20 + int(valueVol), lower, bgcolor=(voll == max_v and hm_poc) ? hm_maxColor : m_col, border_color=chart.bg_color, text=voll > hm_volume_bins.avg() ? str.tostring(voll, format.volume) : "", text_halign=text.align_left))
                    hm_boxes.push(box.new(bar_index + 20, upper, bar_index + 5, lower, text=str.tostring(valueVol * 2, format.percent), bgcolor=color(na), border_color=color(na), text_color=(voll == max_v) ? hm_maxColor : m_col1))
                int start_line = 0
                bool isLower_b = close > mid
                for i = 0 to hm_lookBack - 1
                    if isLower_b
                        if low[i] < mid
                            start_line := bar_index - i, break
                        if i == hm_lookBack - 1
                            start_line := bar_index - i
                    else
                        if high[i] > mid
                            start_line := bar_index - i, break
                        if i == hm_lookBack - 1
                            start_line := bar_index - i
                color l_col = (voll == max_v and hm_poc) ? hm_maxColor : color.from_gradient(valueVol, 0, 50, color(na), isLower_b ? color.new(hm_buyColor, 30) : color.new(hm_sellColor, 30))
                hm_lines.push(line.new(start_line + 3, mid, bar_index + 5, mid, width=int(valueVol / 5), color=l_col))

// ====================================================================================================================
// MARKET REGIME (НАПРАВЛЕННЫЙ)
// ====================================================================================================================
[mr_di_plus, mr_di_minus, mr_adx] = ta.dmi(14, 14)
bool mr_trend_bull = mr_adx > 20 and mr_di_plus  > mr_di_minus
bool mr_trend_bear = mr_adx > 20 and mr_di_minus > mr_di_plus

// ====================================================================================================================
// СИНТЕЗ СИГНАЛОВ P1
// ====================================================================================================================

int   p1_smc_trend = en_smc ? export_ms.trend : 0
int   p1_sd_zone   = en_3  ? (sd_in_demand ? 1 : sd_in_supply ? -1 : 0) : 0

int export_sweep = 0
if en_smc and barstate.isconfirmed
    export_sweep := export_ms.upsweep ? -1 : export_ms.dnsweep ? 1 : 0

var string prev_ms_txt = na
string curr_ms_txt = export_ms.txt

bool is_new_choch = false
bool is_new_bos   = false

if barstate.isconfirmed
    if curr_ms_txt == "choch" and (na(prev_ms_txt) ? "" : prev_ms_txt) != "choch"
        is_new_choch := true
    if curr_ms_txt == "bos" and (na(prev_ms_txt) ? "" : prev_ms_txt) != "bos"
        is_new_bos := true
    prev_ms_txt := curr_ms_txt

int export_choch = (is_new_choch and barstate.isconfirmed) ? export_ms.trend : 0
int export_bos   = (is_new_bos   and barstate.isconfirmed) ? export_ms.trend : 0

float current_atr = ta.atr(14)

var float export_fvg_top = na
var float export_fvg_bot = na
var int   export_fvg_poc = 0
export_fvg_poc := 0, export_fvg_top := na, export_fvg_bot := na

if en_2 and fvgs.size() > 0
    for f in fvgs
        if (f.isBull and low  <= f.FVG.get_top() and low  >= f.FVG.get_bottom()) or (not f.isBull and high >= f.FVG.get_bottom() and high <= f.FVG.get_top())
            export_fvg_top := f.FVG.get_top(), export_fvg_bot := f.FVG.get_bottom()
        if not na(f.poc)
            float poc_val   = f.poc.get_y1()
            float tolerance = math.max(math.abs(f.FVG.get_top() - f.FVG.get_bottom()) / fvg_bins, current_atr * 0.1)
            if high >= poc_val - tolerance and low <= poc_val + tolerance
                export_fvg_poc := f.isInversion ? (f.isBull ? 2 : -2) : (f.isBull ? 1 : -1)

var float swing_high = na, var float swing_low = na
if en_smc
    bool is_new_struct = is_new_choch or is_new_bos
    if p1_smc_trend == 1
        swing_low  := export_ms.choch
        swing_high := na(swing_high) or is_new_struct ? high : math.max(swing_high, high)
    else if p1_smc_trend == -1
        swing_high := export_ms.choch
        swing_low  := na(swing_low) or is_new_struct ? low : math.min(swing_low, low)

float ote_upper = na, float ote_lower = na, int export_ote = 0
if not na(swing_high) and not na(swing_low) and swing_high > swing_low
    float rng = swing_high - swing_low
    if p1_smc_trend == 1
        ote_upper := swing_low + rng * 0.382, ote_lower := swing_low + rng * 0.214
        export_ote := (close <= ote_upper and close >= ote_lower) ? 1 : 0
    else if p1_smc_trend == -1
        ote_lower := swing_high - rng * 0.382, ote_upper := swing_high - rng * 0.214
        export_ote := (close >= ote_lower and close <= ote_upper) ? -1 : 0

bool export_ote_confluence_bull = export_ote == 1  and export_fib_ote == 1
bool export_ote_confluence_bear = export_ote == -1 and export_fib_ote == -1

var float confirmed_bos_price   = na
var float confirmed_choch_price = na
if en_smc and export_ms.txt == "bos"
    confirmed_bos_price := export_ms.zz
if en_smc and export_ms.txt == "choch"
    confirmed_choch_price := export_ms.zz

bool  anchor_bar        = is_new_choch or is_new_bos
float export_avwap      = ta.vwap(hlc3, anchor_bar)
bool  anchor_bar_fast   = is_new_choch or is_new_bos or (export_sd_inv != 0)
float export_avwap_fast = ta.vwap(hlc3, anchor_bar_fast)

int export_displacement_dir = 0
if barstate.isconfirmed
    if math.abs(close - open) > (current_atr * 1.5)
        export_displacement_dir := close > open ? 1 : -1

var float prev_confirmed_bos_price   = na
var float prev_confirmed_choch_price = na
var int   bos_level_trend_at_fix     = 0
var int   choch_level_trend_at_fix   = 0
var int   bos_level_touches          = 0
var int   choch_level_touches        = 0

bool bos_level_is_new   = en_smc and export_ms.txt == "bos"   and (na(prev_confirmed_bos_price)   or confirmed_bos_price   != prev_confirmed_bos_price)
bool choch_level_is_new = en_smc and export_ms.txt == "choch" and (na(prev_confirmed_choch_price) or confirmed_choch_price != prev_confirmed_choch_price)

if bos_level_is_new
    bos_level_touches      := 0
    bos_level_trend_at_fix := export_ms.trend
    prev_confirmed_bos_price := confirmed_bos_price

if choch_level_is_new
    choch_level_touches      := 0
    choch_level_trend_at_fix := export_ms.trend
    prev_confirmed_choch_price := confirmed_choch_price

float retest_tol = current_atr * 0.15

if barstate.isconfirmed and not na(confirmed_bos_price) and not bos_level_is_new
    if math.abs(close - confirmed_bos_price) <= retest_tol or (low <= confirmed_bos_price + retest_tol and high >= confirmed_bos_price - retest_tol)
        bos_level_touches += 1

if barstate.isconfirmed and not na(confirmed_choch_price) and not choch_level_is_new
    if math.abs(close - confirmed_choch_price) <= retest_tol or (low <= confirmed_choch_price + retest_tol and high >= confirmed_choch_price - retest_tol)
        choch_level_touches += 1

float export_bos_price_signed   = na(confirmed_bos_price)   ? na : (bos_level_trend_at_fix   == 1 ? confirmed_bos_price   : -confirmed_bos_price)
float export_choch_price_signed = na(confirmed_choch_price) ? na : (choch_level_trend_at_fix == 1 ? confirmed_choch_price : -confirmed_choch_price)

// ====================================================================================================================
// SWEEP ПЕРЕД CHOCH
// ====================================================================================================================

var int bars_since_last_sweep_bull = 999
var int bars_since_last_sweep_bear = 999

bars_since_last_sweep_bull := export_sweep == 1  ? 0 : math.min(bars_since_last_sweep_bull + 1, 999)
bars_since_last_sweep_bear := export_sweep == -1 ? 0 : math.min(bars_since_last_sweep_bear + 1, 999)

// ====================================================================================================================
// ZONE CONFLUENCE — ИЗМЕНЕНО по запросу: проверка LVZ-слоя больше не смотрит на isPOC/isHVN (раздел
// 7.3 удалён) — засчитывается сам факт наличия активной LVZ-зоны на нужной стороне.
// ====================================================================================================================

bool export_zone_conf_bull = false
bool export_zone_conf_bear = false
int  zone_layers_bull      = 0
int  zone_layers_bear      = 0

if export_ob_state == 1
    zone_layers_bull += 1
if sd_in_demand
    zone_layers_bull += 1
if en_2 and not na(export_fvg_top) and not na(export_fvg_bot) and
   close <= export_fvg_top and close >= export_fvg_bot and (export_fvg_poc == 1 or export_fvg_poc == 2)
    zone_layers_bull += 1
if en_lvz and lvzBullZones.size() > 0
    zone_layers_bull += 1

if export_ob_state == -1
    zone_layers_bear += 1
if sd_in_supply
    zone_layers_bear += 1
if en_2 and not na(export_fvg_top) and not na(export_fvg_bot) and
   close <= export_fvg_top and close >= export_fvg_bot and (export_fvg_poc == -1 or export_fvg_poc == -2)
    zone_layers_bear += 1
if en_lvz and lvzBearZones.size() > 0
    zone_layers_bear += 1

export_zone_conf_bull := zone_layers_bull >= 2
export_zone_conf_bear := zone_layers_bear >= 2

// ====================================================================================================================
// MASTER SYNTHESIS
// ====================================================================================================================

int export_conf_bull = 0
export_conf_bull += p1_smc_trend == 1      ? 2 : 0
export_conf_bull += sd_in_demand           ? 1 : 0
export_conf_bull += export_ob_state == 1   ? 1 : 0
export_conf_bull += export_ote == 1        ? 1 : 0
export_conf_bull += export_ote_confluence_bull ? 1 : 0
export_conf_bull += close > export_avwap   ? 1 : 0
export_conf_bull += export_hm_signal == 1  ? 1 : 0
export_conf_bull += export_zone_conf_bull  ? 2 : 0
export_conf_bull += (export_sweep == 1 and is_new_choch and export_ms.trend == 1) ? 1 : 0
export_conf_bull += mr_trend_bull          ? 1 : 0
export_conf_bull += g_ltf_bull_cnt + htf_bull_conf

int export_conf_bear = 0
export_conf_bear += p1_smc_trend == -1     ? 2 : 0
export_conf_bear += sd_in_supply           ? 1 : 0
export_conf_bear += export_ob_state == -1  ? 1 : 0
export_conf_bear += export_ote == -1       ? 1 : 0
export_conf_bear += export_ote_confluence_bear ? 1 : 0
export_conf_bear += close < export_avwap   ? 1 : 0
export_conf_bear += export_hm_signal == -1 ? 1 : 0
export_conf_bear += export_zone_conf_bear  ? 2 : 0
export_conf_bear += (export_sweep == -1 and is_new_choch and export_ms.trend == -1) ? 1 : 0
export_conf_bear += mr_trend_bear          ? 1 : 0
export_conf_bear += g_ltf_bear_cnt + htf_bear_conf

int master_signal_threshold = f_pr_master_thr(9)
int export_master_signal = 0
if export_conf_bull >= master_signal_threshold and export_conf_bull > export_conf_bear
    export_master_signal := 1
else if export_conf_bear >= master_signal_threshold and export_conf_bear > export_conf_bull
    export_master_signal := -1

// ====================================================================================================================
// ИНТЕГРАЦИОННЫЕ ПЛОТЫ ДЛЯ SNIPER [P1]
// ====================================================================================================================

plot(9999.0,                                title="[P1] ALIVE_SIGNAL",              display=display.data_window)
