e6_use_hm       = input.bool(true,  "Включить", inline="e6hm", group=grp_e6f, tooltip="Что это: экстремум диапазона lookback с объёмным подтверждением. Выключение убирает этот фактор из скоринга.")
e6_hm_lookback  = input.int(120,    "Lookback",  minval=10, inline="e6hm", group=grp_e6f, tooltip="Период поиска экстремума диапазона. Увеличение — реже, уменьшение — чаще.")
e6_hm_vol_mult_raw = input.float(2.0, "Объём>SMA×", step=0.1, inline="e6hm", group=grp_e6f, tooltip="Минимальный множитель объёма для HeatMap-прокси. Увеличение — строже, уменьшение — мягче.")

grp_e6g = "Engine HTF3 (1D) — S&D прокси"
e6_use_sd       = input.bool(true,  "Включить",  inline="e6sd", group=grp_e6g, tooltip="Что это: дислокация тела + узкая база — прокси Supply&Demand. Выключение убирает этот фактор из скоринга.")
e6_sd_body_mult_raw = input.float(1.8, "Тело>ATR×", step=0.1, inline="e6sd", group=grp_e6g, tooltip="Минимальный размер тела свечи в ATR. Увеличение — строже, уменьшение — мягче.")
e6_sd_base_mult_raw = input.float(0.40, "База<ATR×", step=0.1, inline="e6sd", group=grp_e6g, tooltip="Максимальный размер базы в ATR. Уменьшение — строже, увеличение — мягче.")

grp_e6h = "Engine HTF3 (1D) — SMC прокси"
e6_use_smc      = input.bool(true,  "Включить",  inline="e6smc", group=grp_e6h, tooltip="Что это: HH/HL или LH/LL по трём наборам пивотов — прокси структуры. Выключение убирает этот фактор из скоринга.")
e6_smc_swing    = input.int(10,     "Swing Len", minval=2, inline="e6smc", group=grp_e6h, tooltip="Период поиска пивотов структуры. Увеличение — крупнее и реже, уменьшение — чаще и мельче.")
e6_smc_hh_cnt   = input.int(3,      "Мин. из 3", minval=1, maxval=3, inline="e6smc", group=grp_e6h, tooltip="Минимальное число совпадающих наборов пивотов из 3. Увеличение — строже, уменьшение — мягче.")
e6_smc_must_raw = input.bool(true, "Обязателен", inline="e6smc", group=grp_e6h, tooltip="Если включено — без подтверждения SMC-трендом сигнал по этому TF не засчитывается.")

// ── Применение пресета (tf_level=6: HTF3) ──
e6_vol_mult     = f_pr_mult(e6_vol_mult_raw, 6)
e6_vol_must     = f_pr_must_vol(e6_vol_must_raw, 6)
e6_ob_atr_mult  = f_pr_mult(e6_ob_atr_mult_raw, 6)
e6_ob_vol_mult  = f_pr_mult(e6_ob_vol_mult_raw, 6)
e6_fvg_thr      = f_pr_mult(e6_fvg_thr_raw, 6)
e6_hm_vol_mult  = f_pr_mult(e6_hm_vol_mult_raw, 6)
e6_sd_body_mult = f_pr_mult(e6_sd_body_mult_raw, 6)
e6_sd_base_mult = f_pr_base_mult(e6_sd_base_mult_raw, 6)
e6_smc_must     = f_pr_must_smc(e6_smc_must_raw, 6)
e6_min_score    = f_pr_score(qa_min_htf3, 6)
[e6_w_struct, e6_w_volume, e6_w_pattern] = f_pr_apply_focus(qa_w_struct_htf3, qa_w_volume_htf3, qa_w_pattern_htf3)

// ====================================================================================================================
// LVZ — UDT зоны ликвидного вакуума. Поля deltaBull/deltaBear/deltaBoxes заполняются числом бинов
// dva_delta_bins (единый раздел 8), поля под собственные POC/VAL/VAH зоны — ownPocLn/ownValLn/ownVahLn
// + подписи, настройки их цвета/размера/толщины — общие (dva_*). Поля isPOC/isHVN/hasVA/hasPOC_VA
// УДАЛЕНЫ по запросу вместе с разделом 7.3 (LVN/HVN/POC-классификация зоны).
// ====================================================================================================================
type lvz_zone
    box    zbox         = na
    label  zlbl         = na
    bool   isBull       = false
    int    createdBar   = na
    float  top          = na
    float  bot          = na
    bool   active       = false
    bool   liqConfirmed = false
    bool   filled       = false
    int    touches       = 0
    int    state         = 1
    int    confluence    = 0
    int    quality       = 0
    int    direction     = 0
    int    mtfConf       = 0
    float  widthATR      = na
    bool   isDirectional = false
    bool   isInversion   = false
    bool   hasOB         = false
    bool   hasBreaker    = false
    bool   hasSD         = false
    bool   hasFib        = false
    bool   hasOTE        = false
    array<float> deltaBull
    array<float> deltaBear
    box[]        deltaBoxes
    line   ownPocLn
    line   ownValLn
    line   ownVahLn
    label  ownPocLbl
    label  ownValLbl
    label  ownVahLbl

var lvz_zone[] lvzBullZones = array.new<lvz_zone>()
var lvz_zone[] lvzBearZones = array.new<lvz_zone>()

type hm_pivot
    float value
    int   index
    float volume_
    float vol
    bool  isLower
var hm_pivot[] hm_pivots = array.new<hm_pivot>()

type store
    line    [] ln
    label   [] lb
    box     [] bx
    linefill[] lf
var store   bin       = store.new(array.new<line>(), array.new<label>(), array.new<box>(), array.new<linefill>())

type entered
    bool normal  = false
    bool breaker = false
var entered blobenter = entered.new()
var entered brobenter = entered.new()
var entered blarea    = entered.new()
var entered brarea    = entered.new()

type timer
    bool start = false
    int  count = 0
var timer   lc        = timer.new()

// ── ОБЩИЕ ПЕРЕМЕННЫЕ И ТИПЫ ──
var color[] PALETTE = array.from(#2196f3, #f44336, #4caf50, #ff9800, #9c27b0, #00bcd4, #ffeb3b, #e91e63, #795548, #607d8b)
color invcol  = #ffffff00
float bb_atr  = ta.atr(200) / (5 / bb_len)

// ── fvg_obj — поля valLine/vahLine/valLbl/vahLbl под собственные VAL/VAH гэпа. Поля poc/pocLbl играют
// роль собственного POC блока. Настройки их цвета/размера/порога VA теперь общие (dva_*, раздел 8.3),
// с раздельными цветами/толщинами для POC/VAL/VAH и переменной длиной по бину дельты (см. Часть 3). ──
type fvg_obj
    box             FVG
    bool            isBull
    array<float>    volumeProfile
    array<box>      volumeBoxes
    line            poc
    label           pocLbl
    int             age
    bool            isInversion = false
    array<float>    deltaBull
    array<float>    deltaBear
    array<box>      deltaBoxes
    label           typeLbl
    line            valLine
    line            vahLine
    label           valLbl
    label           vahLbl

// ── iFVG — память сломанных FVG для спаривания ──
type fvg_mem
    float hi
    float lo
    bool  up
    int   born
    int   breakBar = -1
    float srcHi
    float srcLo
var array<fvg_mem> fvgMem = array.new<fvg_mem>()

f_fvg_mem_expired(fvg_mem m) =>
    (bar_index - m.born > 300) or (m.breakBar >= 0 and bar_index - m.breakBar > ifvg_pair_window)

// ── sd_info — поле vol (объём свечи-формирования) используется для прозрачности блока по качеству. ──
type sd_info
    float  top
    float  bottom
    string type
    int    startTime
    int    breakTime
    bool   disabled
    float  vol = na

type structure
    int    zn
    float  zz
    float  bos
    float  choch
    int    loc
    int    temp
    int    trend
    int    start
    float  main
    int    xloc
    bool   upsweep
    bool   dnsweep
    string txt = na

type drawms
    int    x1
    int    x2
    float  y
    string txt
    color  css
    string style

type ob
    bool  bull
    float top
    float btm
    float avg
    int   loc
    color css
    float vol
    int   dir
    int   move
    int   blPOS
    int   brPOS
    int   xlocbl
    int   xlocbr
    bool  isbb   = false
    int   bbloc
    int   touches = 0

if barstate.islast
    for obj in bin.ln
        obj.delete()
    for obj in bin.lb
        obj.delete()
    for obj in bin.bx
        obj.delete()
    for obj in bin.lf
        obj.delete()
    bin.ln.clear()
    bin.lb.clear()
    bin.bx.clear()
    bin.lf.clear()

// ====================================================================================================================
// tf_engine_v2 — stateless, без var внутри функции. Дополнительный выход tf_has_vacuum/vac_hi/vac_lo
// без новых request.security (используется тот же вызов на каждом TF) — питает MTF Confluence LVZ.
// ====================================================================================================================

tf_engine_v2(
  bool  p_use_rsi,     int   p_rsi_len,      int   p_rsi_bull_th, int   p_rsi_bear_th,
  bool  p_use_candles, int   p_candle_cnt,
  bool  p_use_engulf,
  bool  p_use_strong,  float p_strong_ratio,
  bool  p_use_vol,     int   p_vol_sma_len,  float p_vol_mult,    bool  p_vol_must,
  bool  p_use_ob,      int   p_ob_atr_len,   float p_ob_atr_mult, float p_ob_vol_mult,
  bool  p_use_fvg,     float p_fvg_thr,      bool  p_fvg_with_htf,
  bool  p_use_hm,      int   p_hm_lookback,  float p_hm_vol_mult,
  bool  p_use_sd,      float p_sd_body_mult, float p_sd_base_mult,
  bool  p_use_smc,     int   p_smc_swing,    int   p_smc_hh_cnt,  bool  p_smc_must,
  int   p_w_struct,    int   p_w_volume,      int   p_w_pattern
  ) =>

    float rsi_val   = ta.rsi(close, p_rsi_len)
    bool  rsi_b     = p_use_rsi ? rsi_val < p_rsi_bull_th : false
    bool  rsi_s     = p_use_rsi ? rsi_val > p_rsi_bear_th : false

    int bull_cnt    = (close    > open    ? 1 : 0) + (close[1] > open[1] ? 1 : 0) +
                      (close[2] > open[2] ? 1 : 0) + (close[3] > open[3] ? 1 : 0) +
                      (close[4] > open[4] ? 1 : 0)
    int bear_cnt    = (close    < open    ? 1 : 0) + (close[1] < open[1] ? 1 : 0) +
                      (close[2] < open[2] ? 1 : 0) + (close[3] < open[3] ? 1 : 0) +
                      (close[4] < open[4] ? 1 : 0)
    bool candle_b   = p_use_candles ? bull_cnt >= p_candle_cnt : false
    bool candle_s   = p_use_candles ? bear_cnt >= p_candle_cnt : false

    bool eng_b      = p_use_engulf ? (close > open and close > high[1] and open < close[1]) : false
    bool eng_s      = p_use_engulf ? (close < open and close < low[1]  and open > close[1]) : false

    float body_r    = math.abs(close - open) / math.max(high - low, syminfo.mintick)
    bool  strong_b  = p_use_strong ? (body_r > p_strong_ratio and close > open) : false
    bool  strong_s  = p_use_strong ? (body_r > p_strong_ratio and close < open) : false

    float vol_sma   = ta.sma(volume, p_vol_sma_len)
    bool  vol_b     = p_use_vol ? (volume > vol_sma * p_vol_mult and close > open) : false
    bool  vol_s     = p_use_vol ? (volume > vol_sma * p_vol_mult and close < open) : false

    float h5        = ta.highest(high, 5)[1]
    float l5        = ta.lowest (low,  5)[1]
    bool  micro_b   = ta.crossover (close, h5)
    bool  micro_s   = ta.crossunder(close, l5)

    float ob_atr    = ta.atr(p_ob_atr_len)
    float ob_vol_sm = ta.sma(volume, p_vol_sma_len)
    bool ob_disl_b  = (close[1] < open[1]) and
                      (math.abs(close[1] - open[1]) > ob_atr * p_ob_atr_mult) and
                      (volume[1] > ob_vol_sm * p_ob_vol_mult) and
                      (close > open) and (close > high[1])
    bool ob_disl_s  = (close[1] > open[1]) and
                      (math.abs(close[1] - open[1]) > ob_atr * p_ob_atr_mult) and
                      (volume[1] > ob_vol_sm * p_ob_vol_mult) and
                      (close < open) and (close < low[1])
    bool ob_b       = p_use_ob ? ob_disl_b : false
    bool ob_s       = p_use_ob ? ob_disl_s : false

    float ema_htf_fast = ta.ema(close, 8)
    float ema_htf_slow = ta.ema(close, 21)
    bool  htf_ema_bull = ema_htf_fast > ema_htf_slow
    bool  htf_ema_bear = ema_htf_fast < ema_htf_slow
    float fvg_bull_gap = (low  - high[2]) / math.max(ta.stdev(low  - high[2], 50), 1e-10)
    float fvg_bear_gap = (low[2] - high)  / math.max(ta.stdev(low[2] - high,  50), 1e-10)
    bool  fvg_raw_b    = low > high[2] and fvg_bull_gap > p_fvg_thr
    bool  fvg_raw_s    = high < low[2] and fvg_bear_gap > p_fvg_thr
    bool  fvg_b        = p_use_fvg ? (p_fvg_with_htf ? (fvg_raw_b and htf_ema_bull) : fvg_raw_b) : false
    bool  fvg_s        = p_use_fvg ? (p_fvg_with_htf ? (fvg_raw_s and htf_ema_bear) : fvg_raw_s) : false

    float hm_vol_sma   = ta.sma(volume, p_vol_sma_len)
    float hm_highest   = ta.highest(high, p_hm_lookback)
    float hm_lowest    = ta.lowest (low,  p_hm_lookback)
    bool  hm_b         = p_use_hm ? (low == hm_lowest  and volume > hm_vol_sma * p_hm_vol_mult) : false
    bool  hm_s         = p_use_hm ? (high == hm_highest and volume > hm_vol_sma * p_hm_vol_mult) : false

    float sd_atr_loc   = ta.atr(20)
    bool  sd_disl_b    = close[1] > open[1] and (math.abs(close[1] - open[1]) > sd_atr_loc[1] * p_sd_body_mult)
    bool  sd_disl_s    = open[1]  > close[1] and (math.abs(close[1] - open[1]) > sd_atr_loc[1] * p_sd_body_mult)
    bool  sd_base_cond = math.max(math.abs(close[2] - open[2]), nz(math.abs(close[3] - open[3]), math.abs(close[2] - open[2]))) < sd_atr_loc[2] * p_sd_base_mult
    bool  sd_b         = p_use_sd ? (sd_disl_b and sd_base_cond) : false
    bool  sd_s         = p_use_sd ? (sd_disl_s and sd_base_cond) : false

    int   sw           = p_smc_swing
    float ph_0         = nz(ta.pivothigh(high, sw, sw),         high[sw])
    float ph_1         = nz(ta.pivothigh(high, sw * 3, sw * 3), high[sw * 3])
    float ph_2         = nz(ta.pivothigh(high, sw * 5, sw * 5), high[sw * 5])
    float pl_0         = nz(ta.pivotlow (low,  sw, sw),         low[sw])
    float pl_1         = nz(ta.pivotlow (low,  sw * 3, sw * 3), low[sw * 3])
    float pl_2         = nz(ta.pivotlow (low,  sw * 5, sw * 5), low[sw * 5])

    bool hh1 = ph_0 > ph_1
    bool hl1 = pl_0 > pl_1
    bool hh2 = ph_1 > ph_2
    bool hl2 = pl_1 > pl_2
    bool lh1 = ph_0 < ph_1
    bool ll1 = pl_0 < pl_1
    bool lh2 = ph_1 < ph_2
    bool ll2 = pl_1 < pl_2

    int smc_bull_cnt   = (hh1 ? 1 : 0) + (hl1 ? 1 : 0) + (hh2 ? 1 : 0) + (hl2 ? 1 : 0)
    int smc_bear_cnt   = (lh1 ? 1 : 0) + (ll1 ? 1 : 0) + (lh2 ? 1 : 0) + (ll2 ? 1 : 0)
    bool smc_b         = p_use_smc ? (smc_bull_cnt >= p_smc_hh_cnt) : false
    bool smc_s         = p_use_smc ? (smc_bear_cnt >= p_smc_hh_cnt) : false

    bool must_bull_ok  = (p_vol_must ? vol_b : true) and (p_smc_must ? smc_b : true)
    bool must_bear_ok  = (p_vol_must ? vol_s : true) and (p_smc_must ? smc_s : true)

    int struct_bull    = (smc_b   ? p_w_struct  : 0) +
                         (ob_b    ? p_w_struct  : 0) +
                         (micro_b ? p_w_struct  : 0)

    int volume_bull    = (vol_b   ? p_w_volume  : 0) +
                         (hm_b    ? p_w_volume  : 0) +
                         (fvg_b   ? p_w_volume  : 0)

    int pattern_bull   = (rsi_b    ? p_w_pattern : 0) +
                         (candle_b ? p_w_pattern : 0) +
                         (eng_b    ? p_w_pattern : 0) +
                         (strong_b ? p_w_pattern : 0) +
                         (sd_b     ? p_w_pattern : 0)

    int struct_bear    = (smc_s   ? p_w_struct  : 0) +
                         (ob_s    ? p_w_struct  : 0) +
                         (micro_s ? p_w_struct  : 0)

    int volume_bear    = (vol_s   ? p_w_volume  : 0) +
                         (hm_s    ? p_w_volume  : 0) +
                         (fvg_s   ? p_w_volume  : 0)

    int pattern_bear   = (rsi_s    ? p_w_pattern : 0) +
                         (candle_s ? p_w_pattern : 0) +
                         (eng_s    ? p_w_pattern : 0) +
                         (strong_s ? p_w_pattern : 0) +
                         (sd_s     ? p_w_pattern : 0)

    int score_bull     = must_bull_ok ? (struct_bull + volume_bull + pattern_bull) : 0
    int score_bear     = must_bear_ok ? (struct_bear + volume_bear + pattern_bear) : 0

    float vac_hi = ta.highest(high, 50)
    float vac_lo = ta.lowest(low, 50)
    float vac_step = (vac_hi - vac_lo) / 10
    array<float> vac_bin = array.new_float(10, 0.0)
    for i = 0 to 49
        float price = hlc3[i]
        int idx = math.max(0, math.min(9, int((price - vac_lo) / math.max(vac_step, syminfo.mintick))))
        array.set(vac_bin, idx, array.get(vac_bin, idx) + volume[i])
    float vac_max = vac_bin.max()
    int vac_empty = 0
    if vac_max > 0
        for i = 0 to 9
            if array.get(vac_bin, i) < vac_max * 0.12
                vac_empty += 1
    bool tf_has_vacuum = vac_max > 0 and vac_empty >= 6

    [score_bull, score_bear, tf_has_vacuum, vac_hi, vac_lo]

// ====================================================================================================================
// ЗАПРОСЫ request.security — 6 TF
// ====================================================================================================================

[g_ltf1_sb, g_ltf1_ss, g_ltf1_vac, g_ltf1_vhi, g_ltf1_vlo] = request.security(syminfo.tickerid, g_ltf1,
  tf_engine_v2(
    e1_use_rsi, e1_rsi_len, e1_rsi_bull_th, e1_rsi_bear_th,
    e1_use_candles, e1_candle_cnt, e1_use_engulf, e1_use_strong, e1_strong_ratio,
    e1_use_vol, e1_vol_sma_len, e1_vol_mult, e1_vol_must,
    e1_use_ob,  e1_ob_atr_len,  e1_ob_atr_mult, e1_ob_vol_mult,
    e1_use_fvg, e1_fvg_thr, e1_fvg_with_htf,
    e1_use_hm,  e1_hm_lookback, e1_hm_vol_mult,
    e1_use_sd,  e1_sd_body_mult, e1_sd_base_mult,
    e1_use_smc, e1_smc_swing, e1_smc_hh_cnt, e1_smc_must,
    e1_w_struct, e1_w_volume, e1_w_pattern),
  lookahead=barmerge.lookahead_off)

[g_ltf2_sb, g_ltf2_ss, g_ltf2_vac, g_ltf2_vhi, g_ltf2_vlo] = request.security(syminfo.tickerid, g_ltf2,
  tf_engine_v2(
    e2_use_rsi, e2_rsi_len, e2_rsi_bull_th, e2_rsi_bear_th,
    e2_use_candles, e2_candle_cnt, e2_use_engulf, e2_use_strong, e2_strong_ratio,
    e2_use_vol, e2_vol_sma_len, e2_vol_mult, e2_vol_must,
    e2_use_ob,  e2_ob_atr_len,  e2_ob_atr_mult, e2_ob_vol_mult,
    e2_use_fvg, e2_fvg_thr, e2_fvg_with_htf,
    e2_use_hm,  e2_hm_lookback, e2_hm_vol_mult,
    e2_use_sd,  e2_sd_body_mult, e2_sd_base_mult,
    e2_use_smc, e2_smc_swing, e2_smc_hh_cnt, e2_smc_must,
    e2_w_struct, e2_w_volume, e2_w_pattern),
  lookahead=barmerge.lookahead_off)

[g_ltf3_sb, g_ltf3_ss, g_ltf3_vac, g_ltf3_vhi, g_ltf3_vlo] = request.security(syminfo.tickerid, g_ltf3,
  tf_engine_v2(
    e3_use_rsi, e3_rsi_len, e3_rsi_bull_th, e3_rsi_bear_th,
    e3_use_candles, e3_candle_cnt, e3_use_engulf, e3_use_strong, e3_strong_ratio,
    e3_use_vol, e3_vol_sma_len, e3_vol_mult, e3_vol_must,
    e3_use_ob,  e3_ob_atr_len,  e3_ob_atr_mult, e3_ob_vol_mult,
    e3_use_fvg, e3_fvg_thr, e3_fvg_with_htf,
    e3_use_hm,  e3_hm_lookback, e3_hm_vol_mult,
    e3_use_sd,  e3_sd_body_mult, e3_sd_base_mult,
    e3_use_smc, e3_smc_swing, e3_smc_hh_cnt, e3_smc_must,
    e3_w_struct, e3_w_volume, e3_w_pattern),
  lookahead=barmerge.lookahead_off)

[g_htf1_sb, g_htf1_ss, g_htf1_vac, g_htf1_vhi, g_htf1_vlo] = request.security(syminfo.tickerid, g_htf1,
  tf_engine_v2(
