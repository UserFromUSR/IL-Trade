lvz_cluster_thr     = input.float(0.12, "Порог 'ямы' во вторичном профиле (доля от max-бина)", minval=0.02, maxval=0.5, step=0.01, group=grp_lvz_det, tooltip="То же самое, но по независимому прямому объёмному профилю (не K-means).")
