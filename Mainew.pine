e4_use_ob       = input.bool(true,  "Включить",  inline="e4ob", group=grp_e4d, tooltip="Что это: дислокация цены (ATR×) с объёмным подтверждением — прокси Order Block. Выключение убирает этот фактор из скоринга.")
e4_ob_atr_len   = input.int(14,     "ATR Len",   minval=5, inline="e4ob", group=grp_e4d, tooltip="Период ATR для оценки дислокации цены. Увеличение — сглаженнее, уменьшение — чувствительнее.")
e4_ob_atr_mult_raw = input.float(1.2, "Дислок. ATR×", step=0.1, inline="e4ob", group=grp_e4d, tooltip="Минимальная дислокация цены в ATR для OB-прокси. Увеличение — строже, уменьшение — мягче.")
e4_ob_vol_mult_raw = input.float(1.6, "Объём>SMA×",   step=0.1, inline="e4ob", group=grp_e4d, tooltip="Минимальный множитель объёма для OB-прокси. Увеличение — строже, уменьшение — мягче.")

grp_e4e = "Engine HTF1 (1h) — FVG прокси"
e4_use_fvg      = input.bool(true,  "Включить",   inline="e4fvg", group=grp_e4e, tooltip="Что это: гэп между барами относительно stdev — прокси Fair Value Gap. Выключение убирает этот фактор из скоринга.")
e4_fvg_thr_raw  = input.float(0.20, "Gap порог",  step=0.05, inline="e4fvg", group=grp_e4e, tooltip="Минимальный нормализованный размер гэпа. Увеличение — строже, уменьшение — мягче.")
e4_fvg_with_htf = input.bool(false,  "Только по HTF тренду", inline="e4fvg", group=grp_e4e, tooltip="Что это: засчитывать FVG-прокси только при совпадении с HTF EMA-трендом. По умолчанию выключено на всех TF.")

grp_e4f = "Engine HTF1 (1h) — HeatMap прокси"
e4_use_hm       = input.bool(true,  "Включить", inline="e4hm", group=grp_e4f, tooltip="Что это: экстремум диапазона lookback с объёмным подтверждением. Выключение убирает этот фактор из скоринга.")
e4_hm_lookback  = input.int(72,     "Lookback",  minval=10, inline="e4hm", group=grp_e4f, tooltip="Период поиска экстремума диапазона. Увеличение — реже, уменьшение — чаще.")
e4_hm_vol_mult_raw = input.float(1.7, "Объём>SMA×", step=0.1, inline="e4hm", group=grp_e4f, tooltip="Минимальный множитель объёма для HeatMap-прокси. Увеличение — строже, уменьшение — мягче.")

grp_e4g = "Engine HTF1 (1h) — S&D прокси"
e4_use_sd       = input.bool(true,  "Включить",  inline="e4sd", group=grp_e4g, tooltip="Что это: дислокация тела + узкая база — прокси Supply&Demand. Выключение убирает этот фактор из скоринга.")
e4_sd_body_mult_raw = input.float(1.6, "Тело>ATR×", step=0.1, inline="e4sd", group=grp_e4g, tooltip="Минимальный размер тела свечи в ATR. Увеличение — строже, уменьшение — мягче.")
e4_sd_base_mult_raw = input.float(0.50, "База<ATR×", step=0.1, inline="e4sd", group=grp_e4g, tooltip="Максимальный размер базы в ATR. Уменьшение — строже, увеличение — мягче.")

grp_e4h = "Engine HTF1 (1h) — SMC прокси"
e4_use_smc      = input.bool(true,  "Включить",  inline="e4smc", group=grp_e4h, tooltip="Что это: HH/HL или LH/LL по трём наборам пивотов — прокси структуры. Выключение убирает этот фактор из скоринга.")
e4_smc_swing    = input.int(7,      "Swing Len", minval=2, inline="e4smc", group=grp_e4h, tooltip="Период поиска пивотов структуры. Увеличение — крупнее и реже, уменьшение — чаще и мельче.")
e4_smc_hh_cnt   = input.int(3,      "Мин. из 3", minval=1, maxval=3, inline="e4smc", group=grp_e4h, tooltip="Минимальное число совпадающих наборов пивотов из 3. Увеличение — строже, уменьшение — мягче.")
e4_smc_must_raw = input.bool(true, "Обязателен", inline="e4smc", group=grp_e4h, tooltip="Если включено — без подтверждения SMC-трендом сигнал по этому TF не засчитывается.")

// ── Применение пресета (tf_level=4: HTF1) ──
e4_vol_mult     = f_pr_mult(e4_vol_mult_raw, 4)
e4_vol_must     = f_pr_must_vol(e4_vol_must_raw, 4)
e4_ob_atr_mult  = f_pr_mult(e4_ob_atr_mult_raw, 4)
