hm_resolution = 100

hm_vol_anomaly_mult = input.float(1.5, "Порог аномальности объёма свипа (×SMA)", minval=1.0, maxval=5.0, step=0.1, group=grp_5, tooltip="Во сколько раз объём бара сделки свипа должен превышать среднюю SMA объёма, чтобы считаться 'аномальным'.")
