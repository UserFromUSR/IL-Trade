lvz_max_age_bars    = input.int(300, "Макс. возраст зоны (баров)", minval=20, maxval=2000, group=grp_lvz_det)
lvz_invalidate_on_fill = input.bool(true, "Деактивировать зону после полного прохода ценой", group=grp_lvz_det)
lvz_profile_lookback = input.int(150, "Окно доп. объёмного профиля (баров)", minval=20, maxval=500, group=grp_lvz_det, tooltip="Также используется для расчёта детекции пустоты зоны (7.1).")
lvz_profile_bins    = input.int(10, "Число бинов доп. профиля (детекция)", minval=5, maxval=30, group=grp_lvz_det, tooltip="Используется ТОЛЬКО для детекции пустоты зоны (f_lvz_bin_empty_ratio). Число бинов для отображаемого дельта-профиля и собственной Value Area зоны теперь берётся из единого раздела 8.1 (dva_delta_bins).")
lvz_confirm_window  = input.int(5, "Окно подтверждения после касания (баров)", minval=1, maxval=20, group=grp_lvz_det, tooltip="После первого defended/breached исхода зона держится ещё N баров, а не удаляется мгновенно — даёт время повторным тестам попасть в лог.")
