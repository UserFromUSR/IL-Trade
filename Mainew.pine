e4_smc_must     = f_pr_must_smc(e4_smc_must_raw, 4)
e4_min_score    = f_pr_score(qa_min_htf1, 4)
[e4_w_struct, e4_w_volume, e4_w_pattern] = f_pr_apply_focus(qa_w_struct_htf1, qa_w_volume_htf1, qa_w_pattern_htf1)

