sd_text_col= input.color(color.new(#ffffff, 30), "Цвет текста S&D",       group=grp_3, tooltip="Цвет текста подписи зон S&D.")
sd_show_name_label = input.bool(true, "Имя по центру (Demand/Supply)", group=grp_3, tooltip="Показывать компактную центрированную метку 'Demand' или 'Supply' по центру блока — только имя, без описания, в дополнение к существующей мелкой подписи ТФ у нижнего края.")
sd_show_quality_shade = input.bool(true, "Прозрачность блока по объёму формирования", group=grp_3, tooltip="Чем больше объём свечи, сформировавшей зону, относительно среднего объёма (SMA20), тем менее прозрачным рисуется блок. Если в разделе 8.2 включено скрытие некачественных элементов и прозрачность блока превышает заданный там порог — блок не рисуется вовсе.")

