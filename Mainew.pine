en_3       = input.bool(true,  "Включить S&D",                            group=grp_3, tooltip="Общий выключатель модуля зон Supply/Demand.")
sd_retests = input.bool(true,  "Скрытая логика ретеста (On)",             group=grp_3, tooltip="Включает фоновую логику ретеста зон, даже если визуальные метки скрыты.")
sd_d_col   = input.color(color.new(#089981, 70), "Цвет Demand",           group=grp_3, tooltip="Цвет зоны спроса (Demand).")
