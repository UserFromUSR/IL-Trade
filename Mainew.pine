lvz_ibg_bear        = input.color(color.new(#FF8A1F, 78), "Фон iLVZ Bear", inline="ilvzbg", group=grp_lvz_ivis, tooltip="Фон инверсионной LVZ-зоны, медвежья сторона.")

// ── 7.3 УДАЛЕНО ПОЛНОСТЬЮ ПО ЗАПРОСУ: "LVZ — Узлы объёма (LVN / HVN / POC / POI)" — вся группа
// инпутов (lvz_hvn_thr, lvz_poc_tol_atr, lvz_poi_min_layers, lvz_show_poc, lvz_show_hvn, lvz_poc_color,
// lvz_hvn_color, lvz_check_va) удалена вместе с логикой LVN/HVN-классификации зоны. Общий POC/VAL/VAH
// (раздел 1.4.1/1.4.2) не затронут — это независимый механизм разметки диапазона Фибоначчи.

// ── 7.3.1 LVZ/iLVZ — Собственные POC/VAL/VAH ─────────────────────
// УБРАНО: lvz_show_own_va / lvz_own_va_threshold — перенесены в единый раздел 8.3 (dva_show_own_va,
// dva_own_va_threshold).

// ── 7.4 LVZ/iLVZ — Дельта-объём внутри зоны ─────────────────────
// УБРАНО: lvz_show_delta / lvz_delta_max_width / lvz_delta_bull_color / lvz_delta_bear_color —
// перенесены в единый раздел 8 (dva_*). Число бинов дельта-профиля LVZ также теперь берётся из
// dva_delta_bins (см. правки в Части 3), а не из lvz_profile_bins.

grp_lvz_mtf = "7.5 LVZ — MTF Confluence"
en_lvz_mtf              = input.bool(true, "Включить MTF Confluence для LVZ", group=grp_lvz_mtf)
lvz_mtf_min_bins_empty  = input.float(60.0, "Порог пустоты MTF (%)", minval=20.0, maxval=100.0, step=5.0, group=grp_lvz_mtf)

// ====================================================================================================================
// 8. ДЕЛЬТА-ОБЪЁМ И VALUE AREA БЛОКОВ — ОБЩИЕ НАСТРОЙКИ
// ====================================================================================================================

grp_dva_delta = "8.1 Дельта-объём внутри блоков — общие настройки (FVG/iFVG, S&D, OB/Breaker, LVZ/iLVZ)"
dva_show_delta       = input.bool(true, "Показывать дельту объёма во всех блоках", group=grp_dva_delta, tooltip="Единый переключатель гистограммы дельты объёма внутри FVG/iFVG, S&D, OB/Breaker и LVZ/iLVZ.")
dva_show_delta_text  = input.bool(true, "Показывать текст значения дельты", group=grp_dva_delta, tooltip="Включает/выключает числовую подпись значения дельты на каждой полосе гистограммы (сама полоса при этом остаётся).")
dva_delta_text_size  = input.string("Tiny", "Размер текста дельты", options=["Tiny","Small","Normal"], group=grp_dva_delta, tooltip="Размер шрифта числовых подписей дельты во всех блоках.")
dva_delta_bins       = input.int(8, "Число бинов дельты", minval=3, maxval=30, group=grp_dva_delta, tooltip="Единое число ценовых бинов гистограммы дельты для FVG/iFVG, S&D, OB/Breaker и LVZ/iLVZ. Увеличение — детальнее, уменьшение — грубее.")
dva_delta_max_width  = input.int(20, "Макс. длина полосы (баров)", minval=5, maxval=200, group=grp_dva_delta, tooltip="Единая максимальная длина полос дельты при 100% относительной величине для всех блоков. Полоса может визуально выйти за пределы блока, если её расчётная длина больше ширины блока — это ожидаемое поведение.")
dva_delta_bull_color = input.color(color.new(color.lime, 70), "Цвет Δ Bull", inline="dvad", group=grp_dva_delta, tooltip="Цвет полос, где бычий объём превышает медвежий.")
dva_delta_bear_color = input.color(color.new(color.red, 70), "Цвет Δ Bear", inline="dvad", group=grp_dva_delta, tooltip="Цвет полос, где медвежий объём превышает бычий.")
dva_max_border_color = input.color(color.new(color.yellow, 0), "Цвет рамки макс. дельты", inline="dvam", group=grp_dva_delta, tooltip="Самый крупный по модулю бин дельты в КАЖДОМ блоке получает эту рамку (контур), а заливка остаётся обычной bull/bear — так видно и величину, и сторону (покупатель/продавец) одновременно.")
dva_max_border_width = input.int(2, "Толщина рамки макс. дельты", minval=1, maxval=6, inline="dvam", group=grp_dva_delta, tooltip="Толщина контура вокруг самого крупного по модулю бина дельты в блоке.")

grp_dva_quality = "8.2 Скрытие некачественных / сильно прозрачных элементов"
dva_hide_low_quality  = input.bool(false, "Скрывать некачественные / сильно прозрачные блоки", group=grp_dva_quality, tooltip="Если включено — блоки FVG/iFVG, S&D, OB/Breaker и LVZ/iLVZ, чья расчётная прозрачность закраски по качеству (см. чекбоксы 'Прозрачность блока по...' в каждом разделе) превышает порог ниже, не рисуются вовсе, вместо полупрозрачной заливки. Рамка, имя блока и дельта-гистограмма при этом тоже не рисуются для скрытых блоков.")
dva_quality_alpha_thr = input.int(70, "Порог прозрачности для скрытия (0-100)", minval=0, maxval=100, group=grp_dva_quality, tooltip="Если расчётная прозрачность блока (0 = полностью непрозрачно/качественно, 100 = невидимо/некачественно) выше этого порога — блок скрывается целиком при включённой опции выше. Уменьшение порога — скрывается больше блоков, увеличение — меньше.")

grp_dva_va = "8.3 Собственные POC/VAL/VAH блоков — общие настройки (FVG/iFVG, S&D, OB/Breaker, LVZ/iLVZ)"
dva_show_own_va      = input.bool(true, "Показывать линии VAL/VAH/POC внутри блоков", group=grp_dva_va, tooltip="Единый переключатель для собственных POC/VAL/VAH FVG/iFVG, S&D, OB/Breaker и LVZ/iLVZ (не путать с общей Fibonacci Value Area раздела 1.4.1/1.4.2 — там отдельные настройки, т.к. это разметка всего диапазона, а не отдельного блока).")
dva_own_va_threshold = input.float(0.70, "Порог Value Area блока (%)", minval=0.5, maxval=0.95, step=0.05, group=grp_dva_va, tooltip="Доля объёма профиля конкретного блока, которая должна попасть в границы его собственной Value Area (VAL-VAH). Единое значение для всех типов блоков.")
dva_poc_line_color   = input.color(color.new(#ffd600, 0), "Цвет линии POC", inline="dvavacol", group=grp_dva_va, tooltip="Цвет собственной линии POC внутри блока.")
dva_val_line_color   = input.color(color.new(#2196f3, 0), "Цвет линии VAL", inline="dvavacol", group=grp_dva_va, tooltip="Цвет собственной линии VAL внутри блока.")
dva_vah_line_color   = input.color(color.new(#2196f3, 0), "Цвет линии VAH", inline="dvavacol", group=grp_dva_va, tooltip="Цвет собственной линии VAH внутри блока.")
dva_poc_line_width   = input.int(2, "Толщина POC", minval=1, maxval=6, inline="dvavawid", group=grp_dva_va, tooltip="Толщина собственной линии POC внутри блока.")
dva_val_line_width   = input.int(1, "Толщина VAL", minval=1, maxval=6, inline="dvavawid", group=grp_dva_va, tooltip="Толщина собственной линии VAL внутри блока.")
dva_vah_line_width   = input.int(1, "Толщина VAH", minval=1, maxval=6, inline="dvavawid", group=grp_dva_va, tooltip="Толщина собственной линии VAH внутри блока.")
dva_va_text_size     = input.string("Tiny", "Размер текста VAL/VAH/POC", options=["Tiny","Small","Normal"], group=grp_dva_va, tooltip="Единый размер шрифта подписей собственных POC/VAL/VAH внутри блоков.")

// ── Хелперы раздела 8: перевод строкового размера в size.*, и проверка "рисовать ли элемент с данной прозрачностью" ──
f_dva_txsz(string s) =>
    string result = size.tiny
    if s == "Normal"
        result := size.normal
    else if s == "Small"
        result := size.small
    else
        result := size.tiny
    result

f_dva_visible(int alphaTransp) =>
    not (dva_hide_low_quality and alphaTransp > dva_quality_alpha_thr)

// ====================================================================================================================
// ЕДИНЫЕ ТАЙМФРЕЙМЫ
// ====================================================================================================================

grp_tf_common = "TF — Таймфреймы (общие для всех модулей)"
g_ltf1 = input.timeframe("1",   "LTF1 ТФ", group=grp_tf_common, tooltip="Что это: таймфрейм для движка LTF1. Должен совпадать с LTF1 в Sniper P2. Меньший ТФ — больше шума и сигналов, больший — меньше, но надёжнее.")
g_ltf2 = input.timeframe("3",   "LTF2 ТФ", group=grp_tf_common, tooltip="Что это: таймфрейм для движка LTF2. Должен совпадать с LTF2 в Sniper P2.")
g_ltf3 = input.timeframe("5",   "LTF3 ТФ", group=grp_tf_common, tooltip="Что это: таймфрейм для движка LTF3. Должен совпадать с LTF3 в Sniper P2.")
g_htf1 = input.timeframe("60",  "HTF1 ТФ", group=grp_tf_common, tooltip="Что это: таймфрейм для движка HTF1. Должен совпадать с HTF1 в Sniper P2.")
g_htf2 = input.timeframe("240", "HTF2 ТФ", group=grp_tf_common, tooltip="Что это: таймфрейм для движка HTF2. Должен совпадать с HTF2 в Sniper P2.")
g_htf3 = input.timeframe("D",   "HTF3 ТФ", group=grp_tf_common, tooltip="Что это: таймфрейм для движка HTF3. Должен совпадать с HTF3 в Sniper P2.")

// ====================================================================================================================
// ENGINE LTF1 (1m)
// ====================================================================================================================
grp_e1 = "Engine LTF1 (1m) — RSI"
e1_use_rsi      = input.bool(true,  "Включить", inline="e1rsi", group=grp_e1, tooltip="Что это: RSI-фильтр по направлению (бык: RSI ниже порога, медведь: RSI выше порога). Выключение убирает этот фактор из скоринга LTF1.")
e1_rsi_len      = input.int(9,      "Length", minval=2, inline="e1rsi", group=grp_e1, tooltip="Период RSI. Увеличение — более плавный и медленный RSI (меньше ложных сигналов). Уменьшение — более резкий и быстрый RSI (больше сигналов, больше шума).")
e1_rsi_bull_th  = input.int(55,     "Бык <",  minval=1, maxval=99, inline="e1rsi", group=grp_e1, tooltip="Порог RSI для бычьего фактора: засчитывается, если RSI ниже этого значения. Увеличение порога — фактор срабатывает чаще. Уменьшение — реже, требует более глубокой просадки RSI.")
e1_rsi_bear_th  = input.int(45,     "Медв >", minval=1, maxval=99, inline="e1rsi", group=grp_e1, tooltip="Порог RSI для медвежьего фактора: засчитывается, если RSI выше этого значения. Уменьшение порога — фактор срабатывает чаще. Увеличение — реже, требует более высокого RSI.")

grp_e1b = "Engine LTF1 (1m) — Свечи"
e1_use_candles  = input.bool(true,  "Накопление", inline="e1c1", group=grp_e1b, tooltip="Что это: считает направленные свечи (бык/медведь) из последних 5. Выключение убирает этот фактор из скоринга.")
e1_candle_cnt   = input.int(2,      "Мин. из 5",  minval=1, maxval=5, inline="e1c1", group=grp_e1b, tooltip="Минимальное число однонаправленных свечей из последних 5 для засчитывания фактора. Увеличение — строже (нужно больше согласованных свечей). Уменьшение — мягче.")
e1_use_engulf   = input.bool(false, "Engulfing",  inline="e1c1", group=grp_e1b, tooltip="Что это: поглощение предыдущей свечи текущей. Выключено по умолчанию на всех TF движках.")
e1_use_strong   = input.bool(true,  "Strong Body", inline="e1c2", group=grp_e1b, tooltip="Что это: тело свечи превышает порог от диапазона high-low. Выключение убирает этот фактор из скоринга.")
e1_strong_ratio = input.float(0.60, "Порог",       step=0.05, inline="e1c2", group=grp_e1b, tooltip="Минимальная доля тела свечи от полного диапазона high-low для признания свечи 'сильной'. Увеличение — строже (нужны более выраженные свечи). Уменьшение — мягче.")

grp_e1c = "Engine LTF1 (1m) — Объём"
e1_use_vol      = input.bool(true,  "Включить", inline="e1v", group=grp_e1c, tooltip="Что это: объём выше SMA×мульт на направленной свече. Выключение убирает этот фактор из скоринга.")
e1_vol_sma_len  = input.int(20,     "SMA Len",  minval=5, inline="e1v", group=grp_e1c, tooltip="Период SMA объёма, относительно которой ищется всплеск. Увеличение — более стабильная база сравнения. Уменьшение — более чувствительная к недавним изменениям.")
e1_vol_mult_raw = input.float(2.0,  "Объём>SMA×", step=0.1, inline="e1v", group=grp_e1c, tooltip="Множитель SMA объёма, который должен быть превышен для засчитывания всплеска. Увеличение — строже (нужен более крупный всплеск). Уменьшение — мягче.")
e1_vol_must_raw = input.bool(true, "Обязателен", inline="e1v", group=grp_e1c, tooltip="Если включено — без подтверждения объёмом сигнал по этому TF не засчитывается. Включение делает объём жёстким фильтром для всего движка LTF1.")

grp_e1d = "Engine LTF1 (1m) — OB прокси"
e1_use_ob       = input.bool(true,  "Включить",  inline="e1ob", group=grp_e1d, tooltip="Что это: дислокация цены (ATR×) с объёмным подтверждением — прокси Order Block. Выключение убирает этот фактор из скоринга.")
e1_ob_atr_len   = input.int(10,     "ATR Len",   minval=5, inline="e1ob", group=grp_e1d, tooltip="Период ATR, используемый для оценки дислокации цены. Увеличение — более сглаженная база, уменьшение — более чувствительная.")
e1_ob_atr_mult_raw = input.float(0.8, "Дислок. ATR×", step=0.1, inline="e1ob", group=grp_e1d, tooltip="Минимальная дислокация цены в множителях ATR для признания OB-прокси. Увеличение — строже, уменьшение — мягче.")
e1_ob_vol_mult_raw = input.float(1.3, "Объём>SMA×",   step=0.1, inline="e1ob", group=grp_e1d, tooltip="Минимальный множитель объёма для подтверждения OB-прокси. Увеличение — строже, уменьшение — мягче.")

grp_e1e = "Engine LTF1 (1m) — FVG прокси"
e1_use_fvg      = input.bool(true,  "Включить",   inline="e1fvg", group=grp_e1e, tooltip="Что это: гэп между барами относительно stdev — прокси Fair Value Gap. Выключение убирает этот фактор из скоринга.")
e1_fvg_thr_raw  = input.float(0.10, "Gap порог",  step=0.05, inline="e1fvg", group=grp_e1e, tooltip="Минимальный нормализованный размер гэпа для засчитывания FVG-прокси. Увеличение — строже (только крупные гэпы), уменьшение — мягче.")
e1_fvg_with_htf = input.bool(false, "Только по HTF тренду", inline="e1fvg", group=grp_e1e, tooltip="Что это: засчитывать FVG-прокси только если он совпадает с направлением HTF EMA-тренда. Включение делает фактор строже и реже, выключение — мягче и чаще. По умолчанию выключено на всех TF.")

grp_e1f = "Engine LTF1 (1m) — HeatMap прокси"
e1_use_hm       = input.bool(true,  "Включить", inline="e1hm", group=grp_e1f, tooltip="Что это: экстремум диапазона lookback с объёмным подтверждением. Выключение убирает этот фактор из скоринга.")
e1_hm_lookback  = input.int(30,     "Lookback",  minval=10, inline="e1hm", group=grp_e1f, tooltip="Период поиска экстремума диапазона. Увеличение — реже срабатывает (крупный экстремум), уменьшение — чаще.")
e1_hm_vol_mult_raw = input.float(1.5, "Объём>SMA×", step=0.1, inline="e1hm", group=grp_e1f, tooltip="Минимальный множитель объёма для подтверждения HeatMap-прокси. Увеличение — строже, уменьшение — мягче.")

grp_e1g = "Engine LTF1 (1m) — S&D прокси"
e1_use_sd       = input.bool(true,  "Включить",  inline="e1sd", group=grp_e1g, tooltip="Что это: дислокация тела + узкая база — прокси Supply&Demand. Выключение убирает этот фактор из скоринга.")
e1_sd_body_mult_raw = input.float(1.3, "Тело>ATR×", step=0.1, inline="e1sd", group=grp_e1g, tooltip="Минимальный размер тела свечи (в ATR) для признания дислокации. Увеличение — строже, уменьшение — мягче.")
e1_sd_base_mult_raw = input.float(0.60, "База<ATR×", step=0.1, inline="e1sd", group=grp_e1g, tooltip="Максимальный размер 'базы' (узкого консолидационного участка) в ATR. Уменьшение значения — строже (нужна более узкая база), увеличение — мягче.")

grp_e1h = "Engine LTF1 (1m) — SMC прокси"
e1_use_smc      = input.bool(true,  "Включить",  inline="e1smc", group=grp_e1h, tooltip="Что это: HH/HL или LH/LL по трём наборам пивотов — прокси структуры. Выключение убирает этот фактор из скоринга.")
e1_smc_swing    = input.int(3,      "Swing Len", minval=2, inline="e1smc", group=grp_e1h, tooltip="Период поиска пивотов для определения структуры. Увеличение — крупнее и реже структура, уменьшение — чаще и мельче.")
e1_smc_hh_cnt   = input.int(2,      "Мин. из 3", minval=1, maxval=3, inline="e1smc", group=grp_e1h, tooltip="Минимальное число совпадающих наборов пивотов (из 3) для подтверждения тренда. Увеличение — строже, уменьшение — мягче.")
e1_smc_must_raw = input.bool(false, "Обязателен", inline="e1smc", group=grp_e1h, tooltip="Если включено — без подтверждения SMC-трендом сигнал по этому TF не засчитывается.")

// ── Применение пресета (tf_level=1: LTF1) ──
e1_vol_mult     = f_pr_mult(e1_vol_mult_raw, 1)
e1_vol_must     = f_pr_must_vol(e1_vol_must_raw, 1)
e1_ob_atr_mult  = f_pr_mult(e1_ob_atr_mult_raw, 1)
e1_ob_vol_mult  = f_pr_mult(e1_ob_vol_mult_raw, 1)
e1_fvg_thr      = f_pr_mult(e1_fvg_thr_raw, 1)
e1_hm_vol_mult  = f_pr_mult(e1_hm_vol_mult_raw, 1)
e1_sd_body_mult = f_pr_mult(e1_sd_body_mult_raw, 1)
e1_sd_base_mult = f_pr_base_mult(e1_sd_base_mult_raw, 1)
e1_smc_must     = f_pr_must_smc(e1_smc_must_raw, 1)
e1_min_score    = f_pr_score(qa_min_ltf123, 1)
[e1_w_struct, e1_w_volume, e1_w_pattern] = f_pr_apply_focus(qa_w_struct_ltf1, qa_w_volume_ltf1, qa_w_pattern_ltf1)

// ====================================================================================================================
// ENGINE LTF2 (3m)
// ====================================================================================================================
grp_e2 = "Engine LTF2 (3m) — RSI"
e2_use_rsi      = input.bool(true,  "Включить", inline="e2rsi", group=grp_e2, tooltip="Что это: RSI-фильтр по направлению (бык: RSI ниже порога, медведь: RSI выше порога). Выключение убирает этот фактор из скоринга LTF2.")
e2_rsi_len      = input.int(7,      "Length", minval=2, inline="e2rsi", group=grp_e2, tooltip="Период RSI. Увеличение — более плавный и медленный RSI, уменьшение — более резкий и быстрый.")
e2_rsi_bull_th  = input.int(57,     "Бык <",  minval=1, maxval=99, inline="e2rsi", group=grp_e2, tooltip="Порог RSI для бычьего фактора. Увеличение порога — срабатывает чаще, уменьшение — реже.")
e2_rsi_bear_th  = input.int(43,     "Медв >", minval=1, maxval=99, inline="e2rsi", group=grp_e2, tooltip="Порог RSI для медвежьего фактора. Уменьшение порога — срабатывает чаще, увеличение — реже.")

grp_e2b = "Engine LTF2 (3m) — Свечи"
e2_use_candles  = input.bool(true,  "Накопление", inline="e2c1", group=grp_e2b, tooltip="Что это: считает направленные свечи (бык/медведь) из последних 5. Выключение убирает этот фактор из скоринга.")
e2_candle_cnt   = input.int(2,      "Мин. из 5",  minval=1, maxval=5, inline="e2c1", group=grp_e2b, tooltip="Минимальное число однонаправленных свечей из последних 5. Увеличение — строже, уменьшение — мягче.")
e2_use_engulf   = input.bool(false, "Engulfing",  inline="e2c1", group=grp_e2b, tooltip="Что это: поглощение предыдущей свечи текущей. Выключено по умолчанию на всех TF движках.")
e2_use_strong   = input.bool(true,  "Strong Body", inline="e2c2", group=grp_e2b, tooltip="Что это: тело свечи превышает порог от диапазона high-low. Выключение убирает этот фактор из скоринга.")
e2_strong_ratio = input.float(0.62, "Порог",       step=0.05, inline="e2c2", group=grp_e2b, tooltip="Минимальная доля тела свечи от диапазона high-low. Увеличение — строже, уменьшение — мягче.")

grp_e2c = "Engine LTF2 (3m) — Объём"
e2_use_vol      = input.bool(true,  "Включить", inline="e2v", group=grp_e2c, tooltip="Что это: объём выше SMA×мульт на направленной свече. Выключение убирает этот фактор из скоринга.")
e2_vol_sma_len  = input.int(20,     "SMA Len",  minval=5, inline="e2v", group=grp_e2c, tooltip="Период SMA объёма. Увеличение — стабильнее, уменьшение — чувствительнее.")
e2_vol_mult_raw = input.float(1.8,  "Объём>SMA×", step=0.1, inline="e2v", group=grp_e2c, tooltip="Множитель SMA объёма для засчитывания всплеска. Увеличение — строже, уменьшение — мягче.")
e2_vol_must_raw = input.bool(true, "Обязателен", inline="e2v", group=grp_e2c, tooltip="Если включено — без подтверждения объёмом сигнал по этому TF не засчитывается.")

grp_e2d = "Engine LTF2 (3m) — OB прокси"
e2_use_ob       = input.bool(true,  "Включить",  inline="e2ob", group=grp_e2d, tooltip="Что это: дислокация цены (ATR×) с объёмным подтверждением — прокси Order Block. Выключение убирает этот фактор из скоринга.")
e2_ob_atr_len   = input.int(12,     "ATR Len",   minval=5, inline="e2ob", group=grp_e2d, tooltip="Период ATR для оценки дислокации цены. Увеличение — сглаженнее, уменьшение — чувствительнее.")
e2_ob_atr_mult_raw = input.float(0.9, "Дислок. ATR×", step=0.1, inline="e2ob", group=grp_e2d, tooltip="Минимальная дислокация цены в ATR для OB-прокси. Увеличение — строже, уменьшение — мягче.")
e2_ob_vol_mult_raw = input.float(1.4, "Объём>SMA×",   step=0.1, inline="e2ob", group=grp_e2d, tooltip="Минимальный множитель объёма для OB-прокси. Увеличение — строже, уменьшение — мягче.")

grp_e2e = "Engine LTF2 (3m) — FVG прокси"
e2_use_fvg      = input.bool(true,  "Включить",   inline="e2fvg", group=grp_e2e, tooltip="Что это: гэп между барами относительно stdev — прокси Fair Value Gap. Выключение убирает этот фактор из скоринга.")
e2_fvg_thr_raw  = input.float(0.12, "Gap порог",  step=0.05, inline="e2fvg", group=grp_e2e, tooltip="Минимальный нормализованный размер гэпа. Увеличение — строже, уменьшение — мягче.")
e2_fvg_with_htf = input.bool(false, "Только по HTF тренду", inline="e2fvg", group=grp_e2e, tooltip="Что это: засчитывать FVG-прокси только при совпадении с HTF EMA-трендом. По умолчанию выключено на всех TF.")

grp_e2f = "Engine LTF2 (3m) — HeatMap прокси"
e2_use_hm       = input.bool(true,  "Включить", inline="e2hm", group=grp_e2f, tooltip="Что это: экстремум диапазона lookback с объёмным подтверждением. Выключение убирает этот фактор из скоринга.")
e2_hm_lookback  = input.int(40,     "Lookback",  minval=10, inline="e2hm", group=grp_e2f, tooltip="Период поиска экстремума диапазона. Увеличение — реже, уменьшение — чаще.")
e2_hm_vol_mult_raw = input.float(1.5, "Объём>SMA×", step=0.1, inline="e2hm", group=grp_e2f, tooltip="Минимальный множитель объёма для HeatMap-прокси. Увеличение — строже, уменьшение — мягче.")

grp_e2g = "Engine LTF2 (3m) — S&D прокси"
e2_use_sd       = input.bool(true,  "Включить",  inline="e2sd", group=grp_e2g, tooltip="Что это: дислокация тела + узкая база — прокси Supply&Demand. Выключение убирает этот фактор из скоринга.")
e2_sd_body_mult_raw = input.float(1.4, "Тело>ATR×", step=0.1, inline="e2sd", group=grp_e2g, tooltip="Минимальный размер тела свечи в ATR. Увеличение — строже, уменьшение — мягче.")
e2_sd_base_mult_raw = input.float(0.55, "База<ATR×", step=0.1, inline="e2sd", group=grp_e2g, tooltip="Максимальный размер базы в ATR. Уменьшение — строже, увеличение — мягче.")

grp_e2h = "Engine LTF2 (3m) — SMC прокси"
e2_use_smc      = input.bool(true,  "Включить",  inline="e2smc", group=grp_e2h, tooltip="Что это: HH/HL или LH/LL по трём наборам пивотов — прокси структуры. Выключение убирает этот фактор из скоринга.")
e2_smc_swing    = input.int(4,      "Swing Len", minval=2, inline="e2smc", group=grp_e2h, tooltip="Период поиска пивотов структуры. Увеличение — крупнее и реже, уменьшение — чаще и мельче.")
e2_smc_hh_cnt   = input.int(2,      "Мин. из 3", minval=1, maxval=3, inline="e2smc", group=grp_e2h, tooltip="Минимальное число совпадающих наборов пивотов из 3. Увеличение — строже, уменьшение — мягче.")
e2_smc_must_raw = input.bool(false, "Обязателен", inline="e2smc", group=grp_e2h, tooltip="Если включено — без подтверждения SMC-трендом сигнал по этому TF не засчитывается.")

// ── Применение пресета (tf_level=2: LTF2) ──
e2_vol_mult     = f_pr_mult(e2_vol_mult_raw, 2)
e2_vol_must     = f_pr_must_vol(e2_vol_must_raw, 2)
e2_ob_atr_mult  = f_pr_mult(e2_ob_atr_mult_raw, 2)
e2_ob_vol_mult  = f_pr_mult(e2_ob_vol_mult_raw, 2)
e2_fvg_thr      = f_pr_mult(e2_fvg_thr_raw, 2)
e2_hm_vol_mult  = f_pr_mult(e2_hm_vol_mult_raw, 2)
e2_sd_body_mult = f_pr_mult(e2_sd_body_mult_raw, 2)
e2_sd_base_mult = f_pr_base_mult(e2_sd_base_mult_raw, 2)
e2_smc_must     = f_pr_must_smc(e2_smc_must_raw, 2)
e2_min_score    = f_pr_score(qa_min_ltf2, 2)
[e2_w_struct, e2_w_volume, e2_w_pattern] = f_pr_apply_focus(qa_w_struct_ltf2, qa_w_volume_ltf2, qa_w_pattern_ltf2)

