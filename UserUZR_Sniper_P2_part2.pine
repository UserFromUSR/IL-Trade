// ====================================================================================================================
// ГЛОБАЛЬНЫЕ РАСЧЕТЫ P2
// ====================================================================================================================
[g_mac_line, g_mac_signal, g_mac_hist] = ta.macd(close, 12, 26, 9)
float g_macdL    = g_mac_line
float g_macdH    = g_mac_hist
float g_rsi      = ta.rsi(close, 14)
float g_stc      = ta.sma(ta.stoch(close, high, low, 14), 3)
float g_cci      = ta.cci(close, 10)
float g_mom      = ta.mom(close, 10)
float g_obv      = ta.obv
float g_vwm      = ta.vwma(close, 12) - ta.vwma(close, 26)
float g_cmf      = ta.sma((((close-low)-(high-close))/(high-low))*volume, 21) / ta.sma(volume, 21)
float g_mfi      = ta.mfi(close, 14)
float chg_close  = ta.change(close)
float chg_high   = ta.change(high)
float chg_low    = ta.change(low)
float g_p_obv    = ta.cum(chg_close > 0 ? volume : chg_close < 0 ? -volume : 0)
float g_p_diosc  = fixnan(100 * ta.rma(chg_high - (-chg_low), 14) / ta.rma(ta.tr, 14))
float g_cndl_atr = ta.atr(14)

float s_h1 = request.security(smt_sym1, timeframe.period, high)
float s_l1 = request.security(smt_sym1, timeframe.period, low)
float s_h2 = request.security(smt_sym2, timeframe.period, high)
float s_l2 = request.security(smt_sym2, timeframe.period, low)

float[] global_lt_v = request.security_lower_tf(syminfo.tickerid, sm_act_ltf, volume)
float[] global_lt_c = request.security_lower_tf(syminfo.tickerid, sm_act_ltf, close)
float[] global_lt_o = request.security_lower_tf(syminfo.tickerid, sm_act_ltf, open)

// ====================================================================================================================
// MA РАСЧЕТЫ
// ====================================================================================================================
f_get_ma(src, len, type) =>
    switch type
        "EMA"  => ta.ema(src, len)
        "WMA"  => ta.wma(src, len)
        "HMA"  => ta.hma(src, len)
        "ALMA" => ta.alma(src, len, alma_offset, alma_sigma)
        => ta.sma(src, len)

float ma_f = f_get_ma(close, ma_fast_len, ma_fast_type)
float ma_s = f_get_ma(close, ma_slow_len, ma_slow_type)
float ma_g = f_get_ma(close, ma_filt_len, ma_filt_type)

bool cond_cross_bull = ma_f > ma_s
bool cond_cross_bear = ma_f < ma_s
bool cond_pglob_bull = close > ma_g
bool cond_pglob_bear = close < ma_g

bool ma_trend_bull = ma_sig_logic == "Fast > Slow"      ? cond_cross_bull :
                     ma_sig_logic == "Price > Global MA" ? cond_pglob_bull :
                     (cond_cross_bull and cond_pglob_bull)
bool ma_trend_bear = ma_sig_logic == "Fast > Slow"      ? cond_cross_bear :
                     ma_sig_logic == "Price > Global MA" ? cond_pglob_bear :
                     (cond_cross_bear and cond_pglob_bear)

int  ma_trend_status = ma_trend_bull ? 1 : ma_trend_bear ? -1 : 0
bool x_ma_bull       = ta.crossover(ma_f,  ma_s)
bool x_ma_bear       = ta.crossunder(ma_f, ma_s)

plot(en_ma      ? ma_f : na, "MA Fast",   ma_fast_col, 1)
plot(en_ma      ? ma_s : na, "MA Slow",   ma_slow_col, 2)
plot(en_ma_filt ? ma_g : na, "MA Global", ma_filt_col, 2)
plotshape(en_ma and en_ma_cross and x_ma_bull, "MA Cross Bull", shape.labelup,   location.belowbar, color.new(#2196F3,30), 0, "✕", color.white, size=size.tiny)
plotshape(en_ma and en_ma_cross and x_ma_bear, "MA Cross Bear", shape.labeldown, location.abovebar, color.new(#9C27B0,30), 0, "✕", color.white, size=size.tiny)

var float swing_h  = na
var float swing_l  = na
var int   auto_trend = 1
float ph_sw = ta.pivothigh(high, sync_len, sync_len)
float pl_sw = ta.pivotlow(low,   sync_len, sync_len)
if not na(ph_sw)
    swing_h := ph_sw
if not na(pl_sw)
    swing_l := pl_sw
bool cross_up   = ta.crossover(close,  swing_h)
bool cross_down = ta.crossunder(close, swing_l)
if not na(swing_h) and cross_up
    auto_trend := 1
if not na(swing_l) and cross_down
    auto_trend := -1

int final_trend = p1_connected ? p1_smc_trend : auto_trend
bgcolor(en_bg_trend ? (final_trend == 1 ? bg_bull_col : bg_bear_col) : na, title="Фон тренда")

// ── BOS через p1_bos_trig — надёжный триггер события ─────────────────────────
// Исправлено: раньше использовалось изменение значения уровня (нестабильно).
// Теперь используем p1_bos_trig напрямую — это точное событие из P1.
var int bars_since_bos = 999
bars_since_bos := (p1_connected and p1_bos_trig != 0) ? 0 : math.min(bars_since_bos + 1, 999)

// ====================================================================================================================
// МОДУЛЬ 2.1: KDE RSI
// ====================================================================================================================
f_gaussian(float dist, float bw) =>
    1.0 / math.sqrt(2.0 * math.pi) * math.pow(math.e, -0.5 * math.pow(dist / bw, 2.0))
f_uniform(float dist, float bw) =>
    (math.abs(dist) > bw) ? 0.0 : 0.5
f_sigmoid(float dist, float bw) =>
    2.0 / math.pi * (1.0 / (math.pow(math.e, (dist/bw)) + math.pow(math.e, -(dist/bw))))

f_kde(array<float> arr, string kernel, float bw, int steps) =>
    arrSize      = arr.size()
    arrRange     = arr.range()
    arrMin       = arr.min()
    stepCount    = arrRange / math.max(steps, 1)
    densityRange = array.new<float>(steps * 2)
    for i = 0 to (steps * 2) - 1
        densityRange.set(i, arrMin + i * stepCount)
    xArr = array.new<float>()
    yArr = array.new<float>()
    for i = 0 to densityRange.size() - 1
        float temp = 0
        for j = 0 to arr.size() - 1
            switch kernel
                "Gaussian" => temp += f_gaussian(densityRange.get(i) - arr.get(j), 1.0 / bw)
                "Uniform"  => temp += f_uniform(densityRange.get(i)  - arr.get(j), 1.0 / bw)
                "Sigmoid"  => temp += f_sigmoid(densityRange.get(i)  - arr.get(j), 1.0 / bw)
        xArr.push(densityRange.get(i))
        yArr.push(1.0 / math.max(arrSize, 1) * temp)
    [xArr, yArr]

f_prefixSum(array<float> arr, int l, int r) =>
    arr.get(r) - (l == 0 ? 0 : arr.get(l - 1))

float kde_rsi      = na
bool  osc_kde_bull = false
bool  osc_kde_bear = false

var array<float> highPivotRSIs = array.new<float>()
var array<float> lowPivotRSIs  = array.new<float>()
var array<float> KDEHighX      = array.new<float>()
var array<float> KDEHighY      = array.new<float>()
var array<float> KDEHighYSum   = array.new<float>()
var array<float> KDELowX       = array.new<float>()
var array<float> KDELowY       = array.new<float>()
var array<float> KDELowYSum    = array.new<float>()
var bool in_kde_bull = false
var bool in_kde_bear = false

if en_mod_kde
    kde_rsi := ta.rsi(close, kde_rsi_len)
    float kde_hp = ta.pivothigh(high, kde_piv_len, kde_piv_len)
    float kde_lp = ta.pivotlow(low,  kde_piv_len, kde_piv_len)
    float lowProb  = 0.0
    float highProb = 0.0
    if not na(kde_hp)
        if highPivotRSIs.size() > 300
            highPivotRSIs.remove(0)
        highPivotRSIs.push(kde_rsi[kde_piv_len])
        [kx, ky] = f_kde(highPivotRSIs, kde_kernel, kde_bandw, kde_steps)
        KDEHighX := kx, KDEHighY := ky, KDEHighYSum.clear()
        float tH = 0.0
        for i = 0 to KDEHighY.size() - 1
            tH += KDEHighY.get(i)
            KDEHighYSum.push(tH)
    if not na(kde_lp)
        if lowPivotRSIs.size() > 300
            lowPivotRSIs.remove(0)
        lowPivotRSIs.push(kde_rsi[kde_piv_len])
        [lx, ly] = f_kde(lowPivotRSIs, kde_kernel, kde_bandw, kde_steps)
        KDELowX := lx, KDELowY := ly, KDELowYSum.clear()
        float tL = 0.0
        for i = 0 to KDELowY.size() - 1
            tL += KDELowY.get(i)
            KDELowYSum.push(tL)
    if highPivotRSIs.size() > 0 and KDEHighX.size() > 0
        int sL = array.binary_search_leftmost(KDEHighX,  kde_rsi)
        int sR = array.binary_search_rightmost(KDEHighX, kde_rsi)
        int iL = math.max(0, math.min(sL, KDEHighX.size()-1))
        int iR = math.max(0, math.min(sR, KDEHighX.size()-1))
        int ni = (math.abs(kde_rsi - KDEHighX.get(iL)) < math.abs(kde_rsi - KDEHighX.get(iR))) ? iL : iR
        highProb := f_prefixSum(KDEHighYSum, 0, ni)
    if lowPivotRSIs.size() > 0 and KDELowX.size() > 0
        int sL = array.binary_search_leftmost(KDELowX,  kde_rsi)
        int sR = array.binary_search_rightmost(KDELowX, kde_rsi)
        int iL = math.max(0, math.min(sL, KDELowX.size()-1))
        int iR = math.max(0, math.min(sR, KDELowX.size()-1))
        int ni = (math.abs(kde_rsi - KDELowX.get(iL)) < math.abs(kde_rsi - KDELowX.get(iR))) ? iL : iR
        lowProb := f_prefixSum(KDELowYSum, ni, KDELowYSum.size()-1)
    float act_thresh  = kde_thresh == "High" ? 0.4 : kde_thresh == "Medium" ? 0.25 : 0.15
    bool curr_in_bull = KDELowY.size()  > 0 and lowProb  > array.get(KDELowYSum,  KDELowYSum.size()-1)  * (1.0 - act_thresh)
    bool curr_in_bear = KDEHighY.size() > 0 and highProb > array.get(KDEHighYSum, KDEHighYSum.size()-1) * (1.0 - act_thresh)
    osc_kde_bull := not curr_in_bull and in_kde_bull
    osc_kde_bear := not curr_in_bear and in_kde_bear
    in_kde_bull  := curr_in_bull
    in_kde_bear  := curr_in_bear

// ====================================================================================================================
// МОДУЛЬ 2.2: STOCHASTIC Z-SCORE
// ====================================================================================================================
bool  osc_stoch_bull  = false
bool  osc_stoch_bear  = false
float smoothed_scaled = na

if en_mod_stoch
    float stoch_basis = ta.sma(stoch_z_src, stoch_z_len)
    float stoch_stdev = ta.stdev(stoch_z_src, stoch_z_len)
    float zscore      = stoch_stdev == 0 ? 0.0 : (stoch_z_src - stoch_basis) / stoch_stdev
    float highest_z   = ta.highest(zscore, stoch_z_len)
    float lowest_z    = ta.lowest(zscore,  stoch_z_len)
    float range_z     = highest_z - lowest_z
    float stochZ      = range_z == 0 ? 50.0 : 100.0 * (zscore - lowest_z) / range_z
    float scaledSZ    = (stochZ / 25.0) - 2.0
    smoothed_scaled  := ta.hma(scaledSZ, stoch_z_len)
    float prev        = nz(smoothed_scaled[1], 0.0)
    float ltm         = nz(ta.alma(zscore, stoch_z_len, 0.0, 0.1), 0.0)
    osc_stoch_bull   := ta.crossover(smoothed_scaled,  prev) and prev < stoch_z_os and (stoch_strict ? ltm > 0 : true)
    osc_stoch_bear   := ta.crossunder(smoothed_scaled, prev) and prev > stoch_z_ob and (stoch_strict ? ltm < 0 : true)

// ====================================================================================================================
// МОДУЛЬ 2.3: ADAPTIVE MACD DELUXE
// ====================================================================================================================
bool  osc_macd_dlx_bull = false
bool  osc_macd_dlx_bear = false
float dlx_macSeries     = na
var float mac_dlx       = 0.0

if en_mod_dlx
    float dlx_r      = ta.correlation(close, bar_index, macd_dlx_r2)
    float dlx_detWgt = 0.5 + 0.5 * nz(math.pow(dlx_r, 2), 0.0)
    float dlx_fastK  = 2.0 / (macd_dlx_fast + 1)
    float dlx_slowK  = 2.0 / (macd_dlx_slow + 1)
    float dlx_blend  = dlx_detWgt * (1 - dlx_fastK) * (1 - dlx_slowK) +
                       (1 - dlx_detWgt) * (1 - dlx_fastK) / (1 - dlx_slowK)
    mac_dlx         := (close - nz(close[1], close)) * (dlx_fastK - dlx_slowK)
                     + (2 - dlx_fastK - dlx_slowK) * nz(mac_dlx[1], 0.0)
                     - dlx_blend * nz(mac_dlx[2], 0.0)
    float dlx_hl_ema = ta.ema(high - low, macd_dlx_slow)
    dlx_macSeries   := dlx_hl_ema == 0 ? 0.0 : (mac_dlx / dlx_hl_ema * 100.0)
    osc_macd_dlx_bull := ta.crossover(dlx_macSeries,  macd_dlx_os)
    osc_macd_dlx_bear := ta.crossunder(dlx_macSeries, macd_dlx_ob)

// ====================================================================================================================
// МОДУЛЬ 2.4: ADVANCED CCI
// ====================================================================================================================
bool osc_cci_bull  = false
bool osc_cci_bear  = false
var float st_TrendUp   = na
var float st_TrendDown = na
var int   st_Trend     = 1

if en_mod_cci
    float st_cci_val = ta.cci(close, cci_st_len)
    float st_Up      = hl2 - (cci_st_factor * ta.atr(cci_st_pd))
    float st_Dn      = hl2 + (cci_st_factor * ta.atr(cci_st_pd))
    st_TrendUp   := nz(st_cci_val[1]) > 0 ? math.max(st_Up, nz(st_TrendUp,   st_Up)) : st_Up
    st_TrendDown := nz(st_cci_val[1]) < 0 ? math.min(st_Dn, nz(st_TrendDown, st_Dn)) : st_Dn
    st_Trend     := st_cci_val > 0 ? 1 : st_cci_val < 0 ? -1 : nz(st_Trend[1], 1)
    float st_tsl     = st_Trend == 1 ? st_TrendUp : st_TrendDown
    float l3_typ     = (high + low + close) / 3.0
    float l3_dev     = ta.dev(l3_typ, cci_l3_len)
    float l3_cci_val = (l3_typ - ta.sma(l3_typ, cci_l3_len)) / (0.015 * math.max(l3_dev, 1e-10))
    float l3_ci_val  = ta.ema(l3_cci_val, cci_l3_ci)
    osc_cci_bull := ta.crossover(close,  st_tsl) or (ta.crossover(l3_cci_val,  l3_ci_val) and l3_cci_val < 0)
    osc_cci_bear := ta.crossunder(close, st_tsl) or (ta.crossunder(l3_cci_val, l3_ci_val) and l3_cci_val > 0)

// ====================================================================================================================
// МОДУЛЬ 2.5: SMART MONEY ACTIVITY + CVD
// ====================================================================================================================
bool  sm_act_bull     = false
bool  sm_act_bear     = false
var array<float> sm_vols      = array.new<float>()
var float cvd                 = 0.0
var array<float> cvd_hist_arr = array.new<float>()
bool cvd_bull_div  = false
bool cvd_bear_div  = false
bool sm_absorption = false

if en_mod_smact
    float[] lt_v   = global_lt_v
    float[] lt_c   = global_lt_c
    float[] lt_o   = global_lt_o
    int res_size   = array.size(lt_v)
    int sm_maximum = sm_act_zlen * math.max(1, res_size)
    if res_size > 0
        float bar_cvd = 0.0, float max_bull_vol = 0.0, float max_bear_vol = 0.0
        for i = 0 to res_size - 1
            float v = array.get(lt_v, i)
            float c = array.get(lt_c, i)
            float o = array.get(lt_o, i)
            if c > o
                bar_cvd += v, max_bull_vol := math.max(max_bull_vol, v)
            else if c < o
                bar_cvd -= v, max_bear_vol := math.max(max_bear_vol, v)
        array.unshift(cvd_hist_arr, bar_cvd)
        if array.size(cvd_hist_arr) > 50
            array.pop(cvd_hist_arr)
        cvd := array.sum(cvd_hist_arr)
        if max_bull_vol > (ta.sma(volume, 50) * 0.5) and max_bear_vol > (ta.sma(volume, 50) * 0.5)
            sm_absorption := true
        cvd_bull_div := close < ta.sma(close, 10) and cvd > ta.sma(cvd, 10)
        cvd_bear_div := close > ta.sma(close, 10) and cvd < ta.sma(cvd, 10)
        for i = res_size - 1 to 0
            array.unshift(sm_vols, array.get(lt_v, i))
        while array.size(sm_vols) > sm_maximum
            array.pop(sm_vols)
        float volsAvg = array.avg(sm_vols), float volsStdev = array.stdev(sm_vols)
        if volsStdev > 0
            float max_z = 0.0, int max_idx = -1
            for i = 0 to res_size - 1
                float az = (array.get(lt_v, i) - volsAvg) / volsStdev
                if az > max_z
                    max_z := az, max_idx := i
            if max_z > sm_act_th and max_idx != -1
                float ic = array.get(lt_c, max_idx)
                float io = array.get(lt_o, max_idx)
                bool isBull = ic > io
                float bMin = math.min(open, close), float bMax = math.max(open, close)
                bool cls2 = math.abs(ic - close) < syminfo.mintick or (ic > bMin and ic < bMax)
                bool cls1 = (ic >= bMin * 0.995 and ic <= bMax * 1.005) and not cls2
                if cls2
                    if isBull
                        sm_act_bull := true
                    else
                        sm_act_bear := true
                else if cls1 and max_z > sm_act_th * 1.3
                    if isBull
                        sm_act_bull := true
                    else
                        sm_act_bear := true

var int bars_since_sm_act_bull_N3 = 999
var int bars_since_sm_act_bear_N3 = 999
bars_since_sm_act_bull_N3 := sm_act_bull ? 0 : math.min(bars_since_sm_act_bull_N3 + 1, 999)
bars_since_sm_act_bear_N3 := sm_act_bear ? 0 : math.min(bars_since_sm_act_bear_N3 + 1, 999)

// ====================================================================================================================
// МОДУЛЬ 2.6: SMART MONEY INDEX
// ====================================================================================================================
bool  sm_idx_bull  = false
bool  sm_idx_bear  = false
float sm_net_index = na

if en_mod_smidx
    float safe_pvi = nz(ta.pvi, 1.0), float safe_nvi = nz(ta.nvi, 1.0)
    float sm_drsi  = ta.rsi(safe_pvi - ta.ema(safe_pvi, 255), sm_idx_rr)
    float sm_srsi  = ta.rsi(safe_nvi - ta.ema(safe_nvi, 255), sm_idx_rr)
    float dr_safe  = sm_drsi == 0 ? 1e-10 : sm_drsi
    float di_safe  = (100.0 - sm_drsi) == 0 ? 1e-10 : (100.0 - sm_drsi)
    float sb       = math.sum(sm_srsi / dr_safe, sm_idx_x)
    float ss       = math.sum((100.0 - sm_srsi) / di_safe, sm_idx_x)
    float pk       = ta.highest(math.max(sb, ss), sm_idx_peak)
    float pks      = pk == 0 ? 1e-10 : pk
    sm_net_index  := (sb / pks) - (ss / pks)
    if sm_idx_strict
        sm_idx_bull := ta.crossover(sm_net_index,   sm_idx_thr)
        sm_idx_bear := ta.crossunder(sm_net_index, -sm_idx_thr)
    else
        sm_idx_bull := sm_net_index >  sm_idx_thr and sm_net_index > nz(sm_net_index[1])
        sm_idx_bear := sm_net_index < -sm_idx_thr and sm_net_index < nz(sm_net_index[1])

// ====================================================================================================================
// МОДУЛЬ 2.7: SMART MONEY INTEREST
// ====================================================================================================================
bool sm_int_bull = false
bool sm_int_bear = false

if en_mod_smint
    float d    = ta.pvi - ta.ema(ta.pvi, 255)
    float s    = ta.nvi - ta.ema(ta.nvi, 255)
    float dr   = ta.rsi(d, sm_int_rr), float sr = ta.rsi(s, sm_int_rr)
    float dr_s = dr == 0 ? 1e-10 : dr, float sr_s = sr == 0 ? 1e-10 : sr
    float sumb = math.sum(sr / dr_s, sm_int_x)
    float sums = math.sum(dr / sr_s, sm_int_x)
    float pkb  = ta.highest(sumb, sm_int_peak)
    float pks_ = ta.highest(sums, sm_int_peak)
    sm_int_bull := sumb / (pkb  == 0 ? 1e-10 : pkb)  > sm_int_thr
    sm_int_bear := sums / (pks_ == 0 ? 1e-10 : pks_) > sm_int_thr

// ====================================================================================================================
// МОДУЛЬ 2.8: MULTI-INDICATOR DIVERGENCE
// ====================================================================================================================
bool osc_mdiv_bull   = false
bool osc_mdiv_bear   = false
int  total_mdiv_bull = 0
int  total_mdiv_bear = 0

var int[]   mdiv_ph_pos = array.new<int>(10, 0)
var int[]   mdiv_pl_pos = array.new<int>(10, 0)
var float[] mdiv_ph_val = array.new<float>(10, 0.0)
var float[] mdiv_pl_val = array.new<float>(10, 0.0)

bool chk_reg = mdiv_type == "Regular" or mdiv_type == "Regular/Hidden"
bool chk_hid = mdiv_type == "Hidden"  or mdiv_type == "Regular/Hidden"

f_check_pos_div(series float src, int cond_type) =>
    int div_found = 0
    if src > src[1] or close > close[1]
        for x = 0 to 9
            int len = bar_index - array.get(mdiv_pl_pos, x) + mdiv_prd
            if array.get(mdiv_pl_pos, x) == 0 or len > mdiv_maxb
                break
            if len > 5
                bool c1 = (cond_type == 1 and src[1] > src[len] and close[1] < array.get(mdiv_pl_val, x))
                bool c2 = (cond_type == 2 and src[1] < src[len] and close[1] > array.get(mdiv_pl_val, x))
                if c1 or c2
                    float s1 = (src[1] - src[len]) / (len - 1), float v1 = src[1] - s1
                    float s2 = (close[1] - close[len]) / (len - 1), float v2 = close[1] - s2
                    bool ok = true
                    for y = 2 to len - 1
                        if src[y] < v1 or close[y] < v2
                            ok := false, break
                        v1 -= s1, v2 -= s2
                    if ok
                        div_found := 1, break
    div_found

f_check_neg_div(series float src, int cond_type) =>
    int div_found = 0
    if src < src[1] or close < close[1]
        for x = 0 to 9
            int len = bar_index - array.get(mdiv_ph_pos, x) + mdiv_prd
            if array.get(mdiv_ph_pos, x) == 0 or len > mdiv_maxb
                break
            if len > 5
                bool c1 = (cond_type == 1 and src[1] < src[len] and close[1] > array.get(mdiv_ph_val, x))
                bool c2 = (cond_type == 2 and src[1] > src[len] and close[1] < array.get(mdiv_ph_val, x))
                if c1 or c2
                    float s1 = (src[1] - src[len]) / (len - 1), float v1 = src[1] - s1
                    float s2 = (close[1] - close[len]) / (len - 1), float v2 = close[1] - s2
                    bool ok = true
                    for y = 2 to len - 1
                        if src[y] > v1 or close[y] > v2
                            ok := false, break
                        v1 -= s1, v2 -= s2
                    if ok
                        div_found := 1, break
    div_found

f_add_div(series float src, bool en) =>
    int b = 0, int br = 0
    if en
        if chk_reg
            b  += f_check_pos_div(src, 1)
            br += f_check_neg_div(src, 1)
        if chk_hid
            b  += f_check_pos_div(src, 2)
            br += f_check_neg_div(src, 2)
    [b, br]

if en_mod_mdiv
    float mdiv_ph = ta.pivothigh(close, mdiv_prd, mdiv_prd)
    float mdiv_pl = ta.pivotlow(close,  mdiv_prd, mdiv_prd)
    if not na(mdiv_ph)
        array.unshift(mdiv_ph_pos, bar_index), array.unshift(mdiv_ph_val, mdiv_ph)
        array.pop(mdiv_ph_pos), array.pop(mdiv_ph_val)
    if not na(mdiv_pl)
        array.unshift(mdiv_pl_pos, bar_index), array.unshift(mdiv_pl_val, mdiv_pl)
        array.pop(mdiv_pl_pos), array.pop(mdiv_pl_val)
    [b1,br1]   = f_add_div(g_rsi,   true), [b2, br2]  = f_add_div(g_macdL, true)
    [b3,br3]   = f_add_div(g_macdH, true), [b4, br4]  = f_add_div(g_stc,   true)
    [b5,br5]   = f_add_div(g_cci,   true), [b6, br6]  = f_add_div(g_mom,   true)
    [b7,br7]   = f_add_div(g_obv,   true), [b8, br8]  = f_add_div(g_vwm,   true)
    [b9,br9]   = f_add_div(g_cmf,   true), [b10,br10] = f_add_div(g_mfi,   true)
    total_mdiv_bull := b1+b2+b3+b4+b5+b6+b7+b8+b9+b10
    total_mdiv_bear := br1+br2+br3+br4+br5+br6+br7+br8+br9+br10
    osc_mdiv_bull   := total_mdiv_bull >= mdiv_limit
    osc_mdiv_bear   := total_mdiv_bear >= mdiv_limit

// ====================================================================================================================
// МОДУЛЬ 2.9: PETERO NON-REPAINT DIVERGENCE
// ====================================================================================================================
bool osc_peter_bull = false
bool osc_peter_bear = false

f_petero_div(series float _osc, int _lbL, int _lbR, int _rL, int _rU) =>
    bool pl  = not na(ta.pivotlow(_osc,  _lbL, _lbR))
    bool ph  = not na(ta.pivothigh(_osc, _lbL, _lbR))
    float opl = ta.valuewhen(pl, _osc[_lbR],  1), float cpl = ta.valuewhen(pl, low[_lbR],   1)
    float oph = ta.valuewhen(ph, _osc[_lbR],  1), float cph = ta.valuewhen(ph, high[_lbR],  1)
    int ls    = ta.barssince(pl[1]), int hs = ta.barssince(ph[1])
    bool lr   = ls >= _rL and ls <= _rU, bool hr = hs >= _rL and hs <= _rU
    int breg  = (low[_lbR]  < cpl and _osc[_lbR] > opl and lr and pl) ? 1 : 0
    int bhid  = (low[_lbR]  > cpl and _osc[_lbR] < opl and lr and pl) ? 1 : 0
    int sreg  = (high[_lbR] > cph and _osc[_lbR] < oph and hr and ph) ? 1 : 0
    int shid  = (high[_lbR] < cph and _osc[_lbR] > oph and hr and ph) ? 1 : 0
    [breg + bhid, sreg + shid]

if en_mod_peter
    int pt_b = 0, int pt_s = 0
    [b1,s1]   = f_petero_div(g_rsi,     peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b1,  pt_s+=s1
    [b2,s2]   = f_petero_div(g_macdL,   peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b2,  pt_s+=s2
    [b3,s3]   = f_petero_div(g_macdH,   peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b3,  pt_s+=s3
    [b4,s4]   = f_petero_div(g_mom,     peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b4,  pt_s+=s4
    [b5,s5]   = f_petero_div(g_cci,     peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b5,  pt_s+=s5
    [b6,s6]   = f_petero_div(g_p_obv,   peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b6,  pt_s+=s6
    [b7,s7]   = f_petero_div(g_stc,     peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b7,  pt_s+=s7
    [b8,s8]   = f_petero_div(g_p_diosc, peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b8,  pt_s+=s8
    [b9,s9]   = f_petero_div(g_vwm,     peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b9,  pt_s+=s9
    [b10,s10] = f_petero_div(g_cmf,     peter_lbL, peter_lbR, peter_rngL, peter_rngU), pt_b+=b10, pt_s+=s10
    osc_peter_bull := pt_b >= peter_limit
    osc_peter_bear := pt_s >= peter_limit

// ====================================================================================================================
// МОДУЛЬ 3.0: TRADINGFINDER FRACTAL DIV
// ====================================================================================================================
bool osc_tfdiv_bull = false
bool osc_tfdiv_bear = false

float tf_aoH  = ta.sma(hl2, 5) - ta.sma(hl2, 34)
float tf_rsiH = ta.rsi(close, 14) - 50
float tf_hist = tfdiv_type == "MACD" ? g_macdH : tfdiv_type == "AO" ? tf_aoH : tf_rsiH
float tf_ema  = ta.ema(close, 50)
bool  tf_up_frac = not na(ta.pivothigh(tfdiv_n, tfdiv_n)) and close[tfdiv_n] > tf_ema
bool  tf_dn_frac = not na(ta.pivotlow(tfdiv_n,  tfdiv_n)) and close[tfdiv_n] < tf_ema

float t_h_lp = ta.valuewhen(tf_up_frac, high[tfdiv_n],     0)
float t_h_pp = ta.valuewhen(tf_up_frac, high[tfdiv_n],     1)
float t_h_lh = ta.valuewhen(tf_up_frac, tf_hist[tfdiv_n],  0)
float t_h_ph = ta.valuewhen(tf_up_frac, tf_hist[tfdiv_n],  1)
int   t_h_lb = ta.valuewhen(tf_up_frac, bar_index[tfdiv_n],0)
int   t_h_pb = ta.valuewhen(tf_up_frac, bar_index[tfdiv_n],1)
float t_l_lp = ta.valuewhen(tf_dn_frac, low[tfdiv_n],      0)
float t_l_pp = ta.valuewhen(tf_dn_frac, low[tfdiv_n],      1)
float t_l_lh = ta.valuewhen(tf_dn_frac, tf_hist[tfdiv_n],  0)
float t_l_ph = ta.valuewhen(tf_dn_frac, tf_hist[tfdiv_n],  1)
int   t_l_lb = ta.valuewhen(tf_dn_frac, bar_index[tfdiv_n],0)
int   t_l_pb = ta.valuewhen(tf_dn_frac, bar_index[tfdiv_n],1)

if en_mod_tfdiv
    bool bc  = t_h_lh > 0 and t_h_ph > 0 and (t_h_lb + 30 > bar_index) and (t_h_lb - t_h_pb < 30)
    osc_tfdiv_bear := ta.change(t_h_lp) != 0 and bc  and t_h_lp > t_h_pp and t_h_lh < t_h_ph
    bool bc2 = t_l_lh < 0 and t_l_ph < 0 and (t_l_lb + 30 > bar_index) and (t_l_lb - t_l_pb < 30)
    osc_tfdiv_bull := ta.change(t_l_lp) != 0 and bc2 and t_l_lp < t_l_pp and t_l_lh > t_l_ph

// ====================================================================================================================
// МОДУЛЬ 3.1: SMT DIVERGENCES
// ====================================================================================================================
bool osc_smt_bull = false
bool osc_smt_bear = false

f_get_smt_div(bool is_ph, float y2, float sym_y2) =>
    var float y1 = na, var float sy1 = na, var int cnt = 0, var int ldb = 0
    if bar_index - ldb > 50
        cnt := 0
    if y2 != y2[1] and sym_y2 != sym_y2[1]
        if not na(y1) and not na(sy1) and (y2 - y1) * (sym_y2 - sy1) < 0
            cnt += 1, ldb := bar_index
        sy1 := sym_y2, y1 := y2
    else if (is_ph and y2 > y2[1]) or (not is_ph and y2 < y2[1])
        sy1 := na, y1 := y2
    cnt

if en_mod_smt
    float smt_ph = fixnan(ta.pivothigh(smt_len, smt_len))
    float smt_pl = fixnan(ta.pivotlow(smt_len,  smt_len))
    float sph1   = fixnan(ta.pivothigh(s_h1, smt_len, smt_len))
    float spl1   = fixnan(ta.pivotlow(s_l1,  smt_len, smt_len))
    float sph2   = fixnan(ta.pivothigh(s_h2, smt_len, smt_len))
    float spl2   = fixnan(ta.pivotlow(s_l2,  smt_len, smt_len))
    int ph1 = f_get_smt_div(true,  smt_ph, sph1), int pl1 = f_get_smt_div(false, smt_pl, spl1)
    int ph2 = f_get_smt_div(true,  smt_ph, sph2), int pl2 = f_get_smt_div(false, smt_pl, spl2)
    if smt_ph != nz(smt_ph[1]) and ((smt_use1 and ph1 > nz(ph1[1])) or (smt_use2 and ph2 > nz(ph2[1])))
        osc_smt_bear := true
    if smt_pl != nz(smt_pl[1]) and ((smt_use1 and pl1 > nz(pl1[1])) or (smt_use2 and pl2 > nz(pl2[1])))
        osc_smt_bull := true

// ====================================================================================================================
// МОДУЛЬ 3.2: LUXALGO CANDLESTICK
// ====================================================================================================================
float c_upper = ta.highest(10)
float c_lower = ta.lowest(10)
var int minor_dir = 0
if high == c_upper and minor_dir != 1
    minor_dir := 1
if low  == c_lower and minor_dir != -1
    minor_dir := -1

bool is_major_bull = true
bool is_major_bear = true

bool  rc        = close < open
bool  gc        = close > open
float cand_top  = math.max(open, close), float cand_bot  = math.min(open, close)
float hl_width  = high - low,            float bod_width = cand_top - cand_bot
float hw_per    = hl_width == 0 ? 0 : ((high - cand_top) / hl_width) * 100
float lw_per    = hl_width == 0 ? 0 : ((cand_bot - low)  / hl_width) * 100
float b_per     = hl_width == 0 ? 0 : (bod_width / hl_width) * 100
bool  is_doji   = math.round_to_mintick(close) == math.round_to_mintick(open)
bool  is_minor_bear = minor_dir < 0
bool  is_minor_bull = minor_dir > 0

bool p_hammer   = lw_per>(b_per*2) and b_per<50 and hw_per<2 and not is_doji and is_minor_bear
bool p_ihammer  = hw_per>(b_per*2) and b_per<50 and lw_per<2 and not is_doji and is_minor_bear
bool p_rising_3 = gc[4] and b_per[4]>50 and rc[3] and cand_top[3]<=high[4] and cand_bot[3]>=low[4] and rc[2] and cand_top[2]<=high[4] and cand_bot[2]>=low[4] and rc[1] and cand_top[1]<=high[4] and cand_bot[1]>=low[4] and gc and close>high[4] and b_per>50 and is_minor_bull[4]
bool p_bull_eng = rc[1] and gc and bod_width>(bod_width[1]/2) and open<close[1] and cand_top>cand_top[1] and not p_rising_3 and not is_doji[1] and is_minor_bear
bool p_3ws      = gc[2] and b_per[2]>70 and gc[1] and b_per[1]>70 and cand_bot[1]>=cand_bot[2] and cand_bot[1]<=cand_top[2] and close[1]>high[2] and gc and b_per>70 and cand_bot>=cand_bot[1] and cand_bot<=cand_top[1] and close>high[1] and is_minor_bear[2]
bool p_mstar    = rc[2] and b_per[2]>80 and rc[1] and bod_width[1]<(bod_width[2]/2) and open[1]<close[2] and gc and close>hl2[2] and is_minor_bear[2]
bool p_bull_har = gc and high<=cand_top[1] and low>=cand_bot[1] and rc[1] and is_minor_bear[1]
bool p_tw_bot   = math.round_to_mintick(low)==math.round_to_mintick(low[1]) and gc and rc[1] and is_minor_bear[1]
bool p_sstar    = hw_per>(b_per*2) and b_per<50 and lw_per<2 and not is_doji and is_minor_bull
bool p_hman     = lw_per>(b_per*2) and b_per<50 and hw_per<2 and not is_doji and is_minor_bull
bool p_falling_3= rc[4] and b_per[4]>50 and gc[3] and cand_top[3]<=high[4] and cand_bot[3]>=low[4] and gc[2] and cand_top[2]<=high[4] and cand_bot[2]>=low[4] and gc[1] and cand_top[1]<=high[4] and cand_bot[1]>=low[4] and rc and close<low[4] and b_per>50 and is_minor_bear[4]
bool p_bear_eng = gc[1] and rc and bod_width>(bod_width[1]/2) and open>close[1] and cand_bot<cand_bot[1] and not p_falling_3 and not is_doji[1] and is_minor_bull
bool p_3bc      = rc[2] and b_per[2]>70 and rc[1] and b_per[1]>70 and cand_top[1]<=cand_top[2] and cand_top[1]>=cand_bot[2] and close[1]<low[2] and rc and b_per>70 and cand_top<=cand_top[1] and cand_top>=cand_bot[1] and close<low[1] and is_minor_bull[2]
bool p_estar    = gc[2] and b_per[2]>80 and gc[1] and bod_width[1]<(bod_width[2]/2) and open[1]>close[2] and rc and close<hl2[2] and is_minor_bull[2]
bool p_bear_har = rc and high<=cand_top[1] and low>=cand_bot[1] and gc[1] and is_minor_bull[1]
bool p_tw_top   = math.round_to_mintick(high)==math.round_to_mintick(high[1]) and rc and gc[1] and is_minor_bull[1]

bool   cndl_bull = false, bool cndl_bear = false, bool is_neutral = false, string cndl_name = ""
if en_mod_cndl
    if      en_hammer   and p_hammer    and is_major_bull
        cndl_bull := true, cndl_name := "Молот"
    else if en_ihammer  and p_ihammer   and is_major_bull
        cndl_bull := true, cndl_name := "Пер. Молот"
    else if en_bull_eng and p_bull_eng  and is_major_bull
        cndl_bull := true, cndl_name := "Быч. Поглощение"
    else if en_r3       and p_rising_3  and is_major_bull
        cndl_bull := true, cndl_name := "Метод 3 Подн."
    else if en_3ws      and p_3ws       and is_major_bull
        cndl_bull := true, cndl_name := "3 Белых Солдата"
    else if en_mstar    and p_mstar     and is_major_bull
        cndl_bull := true, cndl_name := "Утренняя Звезда"
    else if en_bull_har and p_bull_har  and is_major_bull
        cndl_bull := true, cndl_name := "Бычье Харами"
    else if en_tw_bot   and p_tw_bot    and is_major_bull
        cndl_bull := true, cndl_name := "Пинцет Дно"
    if      en_sstar    and p_sstar     and is_major_bear
        cndl_bear := true, cndl_name := "Падающая Звезда"
    else if en_hman     and p_hman      and is_major_bear
        cndl_bear := true, cndl_name := "Повешенный"
    else if en_bear_eng and p_bear_eng  and is_major_bear
        cndl_bear := true, cndl_name := "Медв. Поглощение"
    else if en_f3       and p_falling_3 and is_major_bear
        cndl_bear := true, cndl_name := "Метод 3 Пад."
    else if en_3bc      and p_3bc       and is_major_bear
        cndl_bear := true, cndl_name := "3 Черные Вороны"
    else if en_estar    and p_estar     and is_major_bear
        cndl_bear := true, cndl_name := "Вечерняя Звезда"
    else if en_bear_har and p_bear_har  and is_major_bear
        cndl_bear := true, cndl_name := "Медв. Харами"
    else if en_tw_top   and p_tw_top    and is_major_bear
        cndl_bear := true, cndl_name := "Пинцет Вершина"
    if en_doji and is_doji and not cndl_bull and not cndl_bear
        is_neutral := true, cndl_name := "Doji (Нейтраль)"

plotshape(en_mod_cndl and cndl_show_lbl and cndl_bull,  "Бычий паттерн",    shape.triangleup,   location.belowbar, cndl_bull_col, text="", size=size.tiny)
plotshape(en_mod_cndl and cndl_show_lbl and cndl_bear,  "Медвежий паттерн", shape.triangledown, location.abovebar, cndl_bear_col, text="", size=size.tiny)
plotshape(en_mod_cndl and cndl_show_lbl and is_neutral, "Нейтральный",      shape.xcross,       location.abovebar, cndl_neut_col, text="", size=size.tiny)
if en_mod_cndl and cndl_show_lbl
    if cndl_bull
        label.new(bar_index, low  - g_cndl_atr * 0.2, text=cndl_name, style=label.style_label_up,   color=color.new(color.white,100), textcolor=cndl_bull_col, size=get_size(cndl_lbl_size))
    if cndl_bear
        label.new(bar_index, high + g_cndl_atr * 0.2, text=cndl_name, style=label.style_label_down, color=color.new(color.white,100), textcolor=cndl_bear_col, size=get_size(cndl_lbl_size))
    if is_neutral
        label.new(bar_index, high + g_cndl_atr * 0.2, text=cndl_name, style=label.style_label_down, color=color.new(color.white,100), textcolor=cndl_neut_col, size=get_size(cndl_lbl_size))
barcolor(en_mod_cndl and cndl_bar_col ? (cndl_bull ? cndl_bull_col : cndl_bear ? cndl_bear_col : is_neutral ? cndl_neut_col : na) : na)

// ====================================================================================================================
// P1 СТРУКТУРНЫЕ БУЛЕВЫ
// ====================================================================================================================
bool b_smc_bull      = p1_connected ? p1_smc_trend ==  1 : false
bool b_smc_bear      = p1_connected ? p1_smc_trend == -1 : false
bool b_ob_bull       = p1_connected ? p1_ob_signal ==  1 : false
bool b_ob_bear       = p1_connected ? p1_ob_signal == -1 : false
bool b_sd_bull       = p1_connected ? p1_sd_zone   ==  1 : false
bool b_sd_bear       = p1_connected ? p1_sd_zone   == -1 : false
bool b_fvg_bull      = p1_connected ? p1_fvg_dir   ==  1 : false
bool b_fvg_bear      = p1_connected ? p1_fvg_dir   == -1 : false
bool b_bos_bull      = p1_connected ? (bars_since_bos <= bos_bars_ok and p1_smc_trend ==  1) : false
bool b_bos_bear      = p1_connected ? (bars_since_bos <= bos_bars_ok and p1_smc_trend == -1) : false
bool b_bb_bull       = p1_bb_signal    ==  1
bool b_bb_bear       = p1_bb_signal    == -1
bool b_hm_bull       = p1_hm_signal    ==  1
bool b_hm_bear       = p1_hm_signal    == -1
bool b_sdinv_bull    = bars_since_sdinv_bull <= 3
bool b_sdinv_bear    = bars_since_sdinv_bear <= 3
bool b_sweep_bull    = p1_sweep_signal ==  1
bool b_sweep_bear    = p1_sweep_signal == -1
bool b_choch_bull    = p1_choch_signal ==  1
bool b_choch_bear    = p1_choch_signal == -1
bool b_ob_fresh_bull = bars_since_ob_touch_bull <= 2
bool b_ob_fresh_bear = bars_since_ob_touch_bear <= 2
bool b_disp_bull     = bars_since_disp_bull <= 2
bool b_disp_bear     = bars_since_disp_bear <= 2
bool b_fvg_precise_bull = p1_connected and is_conn(p1_fvg_top_src) and is_conn(p1_fvg_bot_src) and not na(p1_fvg_top) and not na(p1_fvg_bot) and close <= p1_fvg_top and close >= p1_fvg_bot and p1_fvg_dir ==  1
bool b_fvg_precise_bear = p1_connected and is_conn(p1_fvg_top_src) and is_conn(p1_fvg_bot_src) and not na(p1_fvg_top) and not na(p1_fvg_bot) and close <= p1_fvg_top and close >= p1_fvg_bot and p1_fvg_dir == -1
bool b_zone_conf_bull   = bars_since_zone_conf_bull <= 5
bool b_zone_conf_bear   = bars_since_zone_conf_bear <= 5
bool b_choch_sw_bull    = bars_since_choch_sw_bull <= 3
bool b_choch_sw_bear    = bars_since_choch_sw_bear <= 3
bool b_ob_sd_bull       = p1_ob_sd_bull
bool b_ob_sd_bear       = p1_ob_sd_bear
bool b_ob_virgin_bull   = is_conn(p1_ob_touch_cnt_bull_src) and p1_ob_touch_cnt_bull <= 1
bool b_ob_virgin_bear   = is_conn(p1_ob_touch_cnt_bear_src) and p1_ob_touch_cnt_bear <= 1
bool b_master_bull      = p1_connected and p1_master ==  1
bool b_master_bear      = p1_connected and p1_master == -1
bool b_conf_bull_ok     = p1_connected and p1_conf_bull >= 8
bool b_conf_bear_ok     = p1_connected and p1_conf_bear >= 8

// ====================================================================================================================
// OTE РАСЧЕТЫ
// ====================================================================================================================
var float recent_swing_h = na
var float recent_swing_l = na
if p1_connected and (p1_choch_src != 0 or p1_bos_src != 0)
    recent_swing_h := high, recent_swing_l := low
else
    recent_swing_h := math.max(nz(recent_swing_h, high), high)
    recent_swing_l := math.min(nz(recent_swing_l, low),  low)

float ote_swing_h    = is_conn(p1_swing_h_src) ? p1_swing_h : recent_swing_h
float ote_swing_l    = is_conn(p1_swing_l_src) ? p1_swing_l : recent_swing_l
float ote_range      = nz(ote_swing_h) - nz(ote_swing_l)
float ote_long_top   = nz(ote_swing_h) - (ote_range * 0.618)
float ote_long_bot   = nz(ote_swing_h) - (ote_range * 0.786)
float disc_long_top  = nz(ote_swing_h) - (ote_range * 0.5)
float ote_short_bot  = nz(ote_swing_l) + (ote_range * 0.618)
float ote_short_top  = nz(ote_swing_l) + (ote_range * 0.786)
float prem_short_bot = nz(ote_swing_l) + (ote_range * 0.5)

int ote_score_bull = (ote_range > 0 and close <= ote_long_top  and close >= ote_long_bot)  ? 2 :
                     (ote_range > 0 and close < disc_long_top)                              ? 1 : 0
int ote_score_bear = (ote_range > 0 and close >= ote_short_bot and close <= ote_short_top) ? 2 :
                     (ote_range > 0 and close > prem_short_bot)                             ? 1 : 0

if p1_ote_zone == 1
    ote_score_bull := math.max(ote_score_bull, 2)
else if p1_ote_zone == -1
    ote_score_bear := math.max(ote_score_bear, 2)

bool b_pd_bull = p1_connected ? (ote_score_bull >= 1) : false
bool b_pd_bear = p1_connected ? (ote_score_bear >= 1) : false

// ====================================================================================================================
// AVWAP БУЛЕВЫ — включая AVWAP Cross как отдельный фактор
// ====================================================================================================================
bool b_avwap_bull     = is_conn(p1_avwap_fast_src) and not na(p1_avwap_fast) ? (close > p1_avwap_fast) :
                        (is_conn(p1_avwap_src) and not na(p1_avwap) ? close > p1_avwap : false)
bool b_avwap_bear     = is_conn(p1_avwap_fast_src) and not na(p1_avwap_fast) ? (close < p1_avwap_fast) :
                        (is_conn(p1_avwap_src) and not na(p1_avwap) ? close < p1_avwap : false)

// AVWAP Cross — пересечение цены с AVWAP (новый скоринговый фактор)
bool b_avwap_cross_bull = is_conn(p1_avwap_fast_src) and not na(p1_avwap_fast) ?
                          ta.crossover(close, p1_avwap_fast) :
                          (is_conn(p1_avwap_src) and not na(p1_avwap) ? ta.crossover(close, p1_avwap) : false)
bool b_avwap_cross_bear = is_conn(p1_avwap_fast_src) and not na(p1_avwap_fast) ?
                          ta.crossunder(close, p1_avwap_fast) :
                          (is_conn(p1_avwap_src) and not na(p1_avwap) ? ta.crossunder(close, p1_avwap) : false)

// ====================================================================================================================
// IN_POI — гейтвей для MTF каскада
// Исправлено: ote_score >= 2 (строгий OTE 0.618-0.786), не >= 1
// Убрана половина свинга как POI — слишком широкий фильтр
// ====================================================================================================================
bool in_poi_bull = b_ob_bull or b_sd_bull or b_fvg_precise_bull or ote_score_bull >= 2
bool in_poi_bear = b_ob_bear or b_sd_bear or b_fvg_precise_bear or ote_score_bear >= 2

// MTF state фильтруется через POI
int mtf_state_bull = in_poi_bull ? mtf_state_raw_bull : 0
int mtf_state_bear = in_poi_bear ? mtf_state_raw_bear : 0

int ltf_bull_conf = mtf_state_bull
int ltf_bear_conf = mtf_state_bear
int htf_bull_conf = htf_state_raw_bull
int htf_bear_conf = htf_state_raw_bear

// ====================================================================================================================
// GATE БУЛЕВЫ — LTF и HTF
// Исправлено: full_gate теперь ОБЯЗАТЕЛЬНОЕ условие для сигнала,
// не скоринговый бонус. HTF Gate по умолчанию обязателен (m_htf_bull/bear=true).
// ====================================================================================================================
bool ltf_gate_bull = (ltf_gate_min == 0 or ltf_bull_conf >= ltf_gate_min or not p1_connected)
bool ltf_gate_bear = (ltf_gate_min == 0 or ltf_bear_conf >= ltf_gate_min or not p1_connected)
bool htf_gate_bull = (htf_gate_min == 0 or htf_bull_conf >= htf_gate_min)
bool htf_gate_bear = (htf_gate_min == 0 or htf_bear_conf >= htf_gate_min)
bool full_gate_bull = ltf_gate_bull and htf_gate_bull
bool full_gate_bear = ltf_gate_bear and htf_gate_bear

// ====================================================================================================================
// HTF ДЕТАЛЬНЫЕ СТРОКИ ДЛЯ ИНФОБЛОКА И СВЕТОФОРА
// ====================================================================================================================
string p2_ltf1_osc_icon_b = p2_ltf1_osc_b ? "✅" : "—"
string p2_ltf2_osc_icon_b = p2_ltf2_osc_b ? "✅" : "—"
string p2_ltf3_osc_icon_b = p2_ltf3_osc_b ? "✅" : "—"
string p2_htf1_osc_icon_b = p2_htf1_osc_b ? "✅" : "—"
string p2_htf2_osc_icon_b = p2_htf2_osc_b ? "✅" : "—"
string p2_htf3_osc_icon_b = p2_htf3_osc_b ? "✅" : "—"
string p2_ltf1_osc_icon_s = p2_ltf1_osc_s ? "✅" : "—"
string p2_ltf2_osc_icon_s = p2_ltf2_osc_s ? "✅" : "—"
string p2_ltf3_osc_icon_s = p2_ltf3_osc_s ? "✅" : "—"
string p2_htf1_osc_icon_s = p2_htf1_osc_s ? "✅" : "—"
string p2_htf2_osc_icon_s = p2_htf2_osc_s ? "✅" : "—"
string p2_htf3_osc_icon_s = p2_htf3_osc_s ? "✅" : "—"

string htf1_detail_b = "HTF1(" + htf_tv_1 + "): P1=" + str.tostring(p1_htf1_sb) + "/" + str.tostring(p1_htf1_min) + " OSC=" + p2_htf1_osc_icon_b + (tier_htf1_bull ? " ✅" : " —")
string htf2_detail_b = "HTF2(" + htf_tv_2 + "): P1=" + str.tostring(p1_htf2_sb) + "/" + str.tostring(p1_htf2_min) + " OSC=" + p2_htf2_osc_icon_b + (tier_htf2_bull ? " ✅" : " —")
string htf3_detail_b = "HTF3(" + htf_tv_3 + "): P1=" + str.tostring(p1_htf3_sb) + "/" + str.tostring(p1_htf3_min) + " OSC=" + p2_htf3_osc_icon_b + (tier_htf3_bull ? " ✅" : " —")
string htf1_detail_s = "HTF1(" + htf_tv_1 + "): P1=" + str.tostring(p1_htf1_ss) + "/" + str.tostring(p1_htf1_min) + " OSC=" + p2_htf1_osc_icon_s + (tier_htf1_bear ? " ✅" : " —")
string htf2_detail_s = "HTF2(" + htf_tv_2 + "): P1=" + str.tostring(p1_htf2_ss) + "/" + str.tostring(p1_htf2_min) + " OSC=" + p2_htf2_osc_icon_s + (tier_htf2_bear ? " ✅" : " —")
string htf3_detail_s = "HTF3(" + htf_tv_3 + "): P1=" + str.tostring(p1_htf3_ss) + "/" + str.tostring(p1_htf3_min) + " OSC=" + p2_htf3_osc_icon_s + (tier_htf3_bear ? " ✅" : " —")

string ltf1_detail_b = "LTF1(" + mtf_tv_1 + "м): P1=" + str.tostring(p1_ltf1_sb) + "/" + str.tostring(p1_ltf1_min) + " OSC=" + p2_ltf1_osc_icon_b + (tier_ltf1_bull ? " ✅" : (blt1b <= mtf_window ? " ⏳" : " —"))
string ltf2_detail_b = "LTF2(" + mtf_tv_2 + "м): P1=" + str.tostring(p1_ltf2_sb) + "/" + str.tostring(p1_ltf2_min) + " OSC=" + p2_ltf2_osc_icon_b + (tier_ltf2_bull ? " ✅" : (blt2b <= mtf_window ? " ⏳" : " —"))
string ltf3_detail_b = "LTF3(" + mtf_tv_3 + "м): P1=" + str.tostring(p1_ltf3_sb) + "/" + str.tostring(p1_ltf3_min) + " OSC=" + p2_ltf3_osc_icon_b + (tier_ltf3_bull ? " ✅" : (blt3b <= mtf_window ? " ⏳" : " —"))
string ltf1_detail_s = "LTF1(" + mtf_tv_1 + "м): P1=" + str.tostring(p1_ltf1_ss) + "/" + str.tostring(p1_ltf1_min) + " OSC=" + p2_ltf1_osc_icon_s + (tier_ltf1_bear ? " ✅" : (blt1s <= mtf_window ? " ⏳" : " —"))
string ltf2_detail_s = "LTF2(" + mtf_tv_2 + "м): P1=" + str.tostring(p1_ltf2_ss) + "/" + str.tostring(p1_ltf2_min) + " OSC=" + p2_ltf2_osc_icon_s + (tier_ltf2_bear ? " ✅" : (blt2s <= mtf_window ? " ⏳" : " —"))
string ltf3_detail_s = "LTF3(" + mtf_tv_3 + "м): P1=" + str.tostring(p1_ltf3_ss) + "/" + str.tostring(p1_ltf3_min) + " OSC=" + p2_ltf3_osc_icon_s + (tier_ltf3_bear ? " ✅" : (blt3s <= mtf_window ? " ⏳" : " —"))

string htf_verdict_b = htf_bull_conf == 3 ? "🟢 HTF: Все 3 TF подтверждены"  :
                       htf_bull_conf == 2 ? "🟡 HTF: 2/3 TF подтверждено"    :
                       htf_bull_conf == 1 ? "⚪ HTF: 1/3 TF подтверждён"      : "❌ HTF: нет подтверждения"
string htf_verdict_s = htf_bear_conf == 3 ? "🟢 HTF: Все 3 TF подтверждены"  :
                       htf_bear_conf == 2 ? "🟡 HTF: 2/3 TF подтверждено"    :
                       htf_bear_conf == 1 ? "⚪ HTF: 1/3 TF подтверждён"      : "❌ HTF: нет подтверждения"

string ltf_cascade_verdict_b = mtf_state_bull == 3 ? "🟢 LTF: Все тиры подтверждены"              :
                                mtf_state_bull == 2 ? "🟡 LTF: 2/3 тира — ждём " + mtf_tv_3 + "м" :
                                mtf_state_bull == 1 ? "⚪ LTF: 1/3 тира — ждём " + mtf_tv_2 + "м" :
                                in_poi_bull          ? "❌ LTF: не подтвердил"                      : "— Вне POI"
string ltf_cascade_verdict_s = mtf_state_bear == 3 ? "🟢 LTF: Все тиры подтверждены"              :
                                mtf_state_bear == 2 ? "🟡 LTF: 2/3 тира — ждём " + mtf_tv_3 + "м" :
                                mtf_state_bear == 1 ? "⚪ LTF: 1/3 тира — ждём " + mtf_tv_2 + "м" :
                                in_poi_bear          ? "❌ LTF: не подтвердил"                      : "— Вне POI"

// ====================================================================================================================
// СКОРИНГ — ВЗВЕШЕННЫЙ
// Исправлено: regime не отменяет must-условия, только добавляет скоринговый бонус
// full_gate теперь обязательное условие (вынесено в генерацию сигналов)
// Добавлен: AVWAP Cross как отдельный фактор s_avwap_x
// ====================================================================================================================
int  buy_score  = 0
int  sell_score = 0
bool buy_valid  = true
bool sell_valid = true

if not p1_connected
    buy_valid := false, sell_valid := false

buy_score  += s_rsi_kde  ? (osc_kde_bull       ? 1 : 0) : 0
sell_score += s_rsi_kde  ? (osc_kde_bear       ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_rsi_kde  ? osc_kde_bull       : true)
sell_valid := sell_valid and (m_rsi_kde  ? osc_kde_bear       : true)

buy_score  += s_stoch    ? (osc_stoch_bull     ? 1 : 0) : 0
sell_score += s_stoch    ? (osc_stoch_bear     ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_stoch    ? osc_stoch_bull     : true)
sell_valid := sell_valid and (m_stoch    ? osc_stoch_bear     : true)

buy_score  += s_macd_dlx ? (osc_macd_dlx_bull  ? 1 : 0) : 0
sell_score += s_macd_dlx ? (osc_macd_dlx_bear  ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_macd_dlx ? osc_macd_dlx_bull  : true)
sell_valid := sell_valid and (m_macd_dlx ? osc_macd_dlx_bear  : true)

buy_score  += s_cci      ? (osc_cci_bull       ? 1 : 0) : 0
sell_score += s_cci      ? (osc_cci_bear       ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_cci      ? osc_cci_bull       : true)
sell_valid := sell_valid and (m_cci      ? osc_cci_bear       : true)

buy_score  += s_mdiv     ? (osc_mdiv_bull      ? 1 : 0) : 0
sell_score += s_mdiv     ? (osc_mdiv_bear      ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_mdiv     ? osc_mdiv_bull      : true)
sell_valid := sell_valid and (m_mdiv     ? osc_mdiv_bear      : true)

buy_score  += s_peter    ? (osc_peter_bull     ? 1 : 0) : 0
sell_score += s_peter    ? (osc_peter_bear     ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_peter    ? osc_peter_bull     : true)
sell_valid := sell_valid and (m_peter    ? osc_peter_bear     : true)

buy_score  += s_tfdiv    ? (osc_tfdiv_bull     ? 1 : 0) : 0
sell_score += s_tfdiv    ? (osc_tfdiv_bear     ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_tfdiv    ? osc_tfdiv_bull     : true)
sell_valid := sell_valid and (m_tfdiv    ? osc_tfdiv_bear     : true)

buy_score  += s_smt      ? (osc_smt_bull       ? 1 : 0) : 0
sell_score += s_smt      ? (osc_smt_bear       ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_smt      ? osc_smt_bull       : true)
sell_valid := sell_valid and (m_smt      ? osc_smt_bear       : true)

buy_score  += s_sm_act   ? (sm_act_bull        ? 1 : 0) : 0
sell_score += s_sm_act   ? (sm_act_bear        ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_sm_act   ? sm_act_bull        : true)
sell_valid := sell_valid and (m_sm_act   ? sm_act_bear        : true)

buy_score  += s_sm_idx   ? (sm_idx_bull        ? 1 : 0) : 0
sell_score += s_sm_idx   ? (sm_idx_bear        ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_sm_idx   ? sm_idx_bull        : true)
sell_valid := sell_valid and (m_sm_idx   ? sm_idx_bear        : true)

buy_score  += s_sm_int   ? (sm_int_bull        ? 1 : 0) : 0
sell_score += s_sm_int   ? (sm_int_bear        ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_sm_int   ? sm_int_bull        : true)
sell_valid := sell_valid and (m_sm_int   ? sm_int_bear        : true)

buy_score  += s_cndl     ? (cndl_bull          ? 1 : 0) : 0
sell_score += s_cndl     ? (cndl_bear          ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_cndl     ? cndl_bull          : true)
sell_valid := sell_valid and (m_cndl     ? cndl_bear          : true)

buy_score  += s_ma_cross ? (x_ma_bull          ? 1 : 0) : 0
sell_score += s_ma_cross ? (x_ma_bear          ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_ma_cross ? x_ma_bull          : true)
sell_valid := sell_valid and (m_ma_cross ? x_ma_bear          : true)

buy_score  += s_ma_trend ? (ma_trend_bull      ? 1 : 0) : 0
sell_score += s_ma_trend ? (ma_trend_bear      ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_ma_trend ? ma_trend_bull      : true)
sell_valid := sell_valid and (m_ma_trend ? ma_trend_bear      : true)

buy_score  += s_smc      ? (b_smc_bull         ? 1 : 0) : 0
sell_score += s_smc      ? (b_smc_bear         ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_smc      ? b_smc_bull         : true)
sell_valid := sell_valid and (m_smc      ? b_smc_bear         : true)

buy_score  += s_ob       ? (b_ob_bull          ? 1 : 0) : 0
sell_score += s_ob       ? (b_ob_bear          ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_ob       ? b_ob_bull          : true)
sell_valid := sell_valid and (m_ob       ? b_ob_bear          : true)

buy_score  += s_sd       ? (b_sd_bull          ? 1 : 0) : 0
sell_score += s_sd       ? (b_sd_bear          ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_sd       ? b_sd_bull          : true)
sell_valid := sell_valid and (m_sd       ? b_sd_bear          : true)

buy_score  += s_fvg      ? ((b_fvg_bull or b_fvg_precise_bull) ? 1 : 0) : 0
sell_score += s_fvg      ? ((b_fvg_bear or b_fvg_precise_bear) ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_fvg      ? (b_fvg_bull or b_fvg_precise_bull) : true)
sell_valid := sell_valid and (m_fvg      ? (b_fvg_bear or b_fvg_precise_bear) : true)

buy_score  += s_bos      ? (b_bos_bull         ? 1 : 0) : 0
sell_score += s_bos      ? (b_bos_bear         ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_bos      ? b_bos_bull         : true)
sell_valid := sell_valid and (m_bos      ? b_bos_bear         : true)

buy_score  += s_bb       ? (b_bb_bull          ? 1 : 0) : 0
sell_score += s_bb       ? (b_bb_bear          ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_bb       ? b_bb_bull          : true)
sell_valid := sell_valid and (m_bb       ? b_bb_bear          : true)

buy_score  += s_hm       ? (b_hm_bull          ? 1 : 0) : 0
sell_score += s_hm       ? (b_hm_bear          ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_hm       ? b_hm_bull          : true)
sell_valid := sell_valid and (m_hm       ? b_hm_bear          : true)

buy_score  += s_sdinv    ? (b_sdinv_bull       ? 1 : 0) : 0
sell_score += s_sdinv    ? (b_sdinv_bear       ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_sdinv    ? b_sdinv_bull       : true)
sell_valid := sell_valid and (m_sdinv    ? b_sdinv_bear       : true)

buy_score  += s_sweep    ? (b_sweep_bull       ? 1 : 0) : 0
sell_score += s_sweep    ? (b_sweep_bear       ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_sweep    ? b_sweep_bull       : true)
sell_valid := sell_valid and (m_sweep    ? b_sweep_bear       : true)

buy_score  += s_choch    ? (b_choch_bull       ? 1 : 0) : 0
sell_score += s_choch    ? (b_choch_bear       ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_choch    ? b_choch_bull       : true)
sell_valid := sell_valid and (m_choch    ? b_choch_bear       : true)

buy_score  += s_pd       ? (b_pd_bull          ? 1 : 0) : 0
sell_score += s_pd       ? (b_pd_bear          ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_pd       ? b_pd_bull          : true)
sell_valid := sell_valid and (m_pd       ? b_pd_bear          : true)

buy_score  += s_avwap    ? (b_avwap_bull       ? 1 : 0) : 0
sell_score += s_avwap    ? (b_avwap_bear       ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_avwap    ? b_avwap_bull       : true)
sell_valid := sell_valid and (m_avwap    ? b_avwap_bear       : true)

// AVWAP Cross — новый фактор
buy_score  += s_avwap_x  ? (b_avwap_cross_bull ? 1 : 0) : 0
sell_score += s_avwap_x  ? (b_avwap_cross_bear ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_avwap_x  ? b_avwap_cross_bull : true)
sell_valid := sell_valid and (m_avwap_x  ? b_avwap_cross_bear : true)

buy_score  += s_disp     ? (b_disp_bull        ? 1 : 0) : 0
sell_score += s_disp     ? (b_disp_bear        ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_disp     ? b_disp_bull        : true)
sell_valid := sell_valid and (m_disp     ? b_disp_bear        : true)

buy_score  += s_ob_frsh  ? (b_ob_fresh_bull    ? 1 : 0) : 0
sell_score += s_ob_frsh  ? (b_ob_fresh_bear    ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_ob_frsh  ? b_ob_fresh_bull    : true)
sell_valid := sell_valid and (m_ob_frsh  ? b_ob_fresh_bear    : true)

// HTF Gate — скоринговый бонус (обязательность вынесена в full_gate)
buy_score  += s_htf_bull ? (htf_gate_bull      ? 1 : 0) : 0
sell_score += s_htf_bear ? (htf_gate_bear      ? 1 : 0) : 0
buy_valid  := buy_valid  and (m_htf_bull ? htf_gate_bull      : true)
sell_valid := sell_valid and (m_htf_bear ? htf_gate_bear      : true)

int zone_w_bull = p1_zone_layers_bull >= 3 ? 2 : p1_zone_layers_bull == 2 ? 1 : 0
int zone_w_bear = p1_zone_layers_bear >= 3 ? 2 : p1_zone_layers_bear == 2 ? 1 : 0
buy_score  += s_zone_conf ? zone_w_bull : 0
sell_score += s_zone_conf ? zone_w_bear : 0
buy_valid  := buy_valid   and (m_zone_conf ? b_zone_conf_bull : true)
sell_valid := sell_valid  and (m_zone_conf ? b_zone_conf_bear : true)

buy_score  += s_choch_sw ? (b_choch_sw_bull    ? 2 : 0) : 0
sell_score += s_choch_sw ? (b_choch_sw_bear    ? 2 : 0) : 0
buy_valid  := buy_valid  and (m_choch_sw ? b_choch_sw_bull    : true)
sell_valid := sell_valid and (m_choch_sw ? b_choch_sw_bear    : true)

buy_score  += s_ob_sd ? (b_ob_sd_bull          ? 2 : 0) : 0
sell_score += s_ob_sd ? (b_ob_sd_bear          ? 2 : 0) : 0
buy_valid  := buy_valid  and (m_ob_sd ? b_ob_sd_bull          : true)
sell_valid := sell_valid and (m_ob_sd ? b_ob_sd_bear          : true)

// Market Regime — только скоринговый бонус, НЕ отменяет must-условия
// Исправлено: убран блок который сбрасывал все must через buy_valid := true
if en_regime and regime_trending
    buy_score  += 1
    sell_score += 1

// ====================================================================================================================
// ГЕНЕРАЦИЯ СИГНАЛОВ
// Исправлено: full_gate теперь ОБЯЗАТЕЛЬНОЕ условие, не скоринговый бонус
// ====================================================================================================================
bool signal_is_score_buy  = p1_connected and (buy_score  >= req_score and buy_valid  and full_gate_bull)
bool signal_is_score_sell = p1_connected and (sell_score >= req_score and sell_valid and full_gate_bear)

var bool is_buy  = false
var bool is_sell = false
var int  bars_since_any_buy  = 999
var int  bars_since_any_sell = 999

is_buy  := false
is_sell := false
bars_since_any_buy  := math.min(bars_since_any_buy  + 1, 999)
bars_since_any_sell := math.min(bars_since_any_sell + 1, 999)

if barstate.isconfirmed
    if signal_is_score_buy  and bars_since_any_buy  >= sig_lookback
        is_buy  := true, bars_since_any_buy  := 0
    if signal_is_score_sell and bars_since_any_sell >= sig_lookback
        is_sell := true, bars_since_any_sell := 0

// ====================================================================================================================
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
// ====================================================================================================================
f_get_align(str) =>
    str == "Left" ? text.align_left : str == "Right" ? text.align_right : text.align_center

// ====================================================================================================================
// ИНФОБЛОК — ПОСТРОЕНИЕ ТЕКСТА
// ====================================================================================================================
f_build_info(bool is_bull) =>
    int    ltf_sc = is_bull ? ltf_bull_conf : ltf_bear_conf
    int    htf_sc = is_bull ? htf_bull_conf : htf_bear_conf
    int    sc     = is_bull ? buy_score     : sell_score
    string info   = ""

    if not p1_connected
        info := "⛔ Main P1 не подключён\nСигналы недоступны"
    else
        if not all_tf_ok
            info += "⚠️ Несовпадение TF!\n"

        string htf_hdr = htf_sc == 3 ? "🟢" : htf_sc == 2 ? "🟡" : htf_sc == 1 ? "⚪" : "❌"
        info += htf_hdr + " HTF Контекст (" + str.tostring(htf_sc) + "/3) ──────\n"
        info += (is_bull ? htf1_detail_b : htf1_detail_s) + "\n"
        info += (is_bull ? htf2_detail_b : htf2_detail_s) + "\n"
        info += (is_bull ? htf3_detail_b : htf3_detail_s) + "\n"
        info += (is_bull ? htf_verdict_b : htf_verdict_s) + "\n"

        string ltf_hdr = ltf_sc == 3 ? "🔵" : ltf_sc == 2 ? "🟡" : ltf_sc == 1 ? "⚪" : "❌"
        info += ltf_hdr + " LTF Каскад (" + str.tostring(ltf_sc) + "/3 тира) ──\n"
        info += (is_bull ? ltf1_detail_b : ltf1_detail_s) + "\n"
        info += (is_bull ? ltf2_detail_b : ltf2_detail_s) + "\n"
        info += (is_bull ? ltf3_detail_b : ltf3_detail_s) + "\n"
        info += (is_bull ? ltf_cascade_verdict_b : ltf_cascade_verdict_s) + "\n"

        int layers = is_bull ? p1_zone_layers_bull : p1_zone_layers_bear
        string zone_q = layers >= 3 ? "🔥 Зона: 3 слоя (макс)" : layers == 2 ? "💪 Зона: 2 слоя" :
                        layers == 1 ? "⚪ Зона: 1 слой"          : "— Зона не активна"
        info += zone_q + "\n"

        bool choch_sw = is_bull ? b_choch_sw_bull : b_choch_sw_bear
        if choch_sw
            info += "⚡ CHoCH после Sweep\n"

        bool ob_virgin = is_bull ? b_ob_virgin_bull : b_ob_virgin_bear
        int  ob_touches = is_bull ? p1_ob_touch_cnt_bull : p1_ob_touch_cnt_bear
        if ob_virgin
            info += "✨ Virgin OB (касаний: " + str.tostring(ob_touches) + ")\n"
        else if ob_touches > 0
            info += "⚠️ OB касаний: " + str.tostring(ob_touches) + "\n"

        bool ob_sd = is_bull ? b_ob_sd_bull : b_ob_sd_bear
        if ob_sd
            info += "🎯 OB внутри S&D зоны\n"

        info += "──────────────────────────\n"
        info += "🎯 СКОР: " + str.tostring(sc) + "/" + str.tostring(req_score) + "\n"
        info += "── Сработавшие факторы ──\n"

        if is_bull
            if b_smc_bull              then info += "✅ SMC бычий\n"
            if b_ob_fresh_bull         then info += "✅ Fresh OB (1й вход)\n"
            else if b_ob_bull          then info += "✅ OB State\n"
            if b_sd_bull               then info += "✅ S&D Demand\n"
            if b_fvg_precise_bull      then info += "✅ FVG точный\n"
            else if b_fvg_bull         then info += "✅ FVG Active\n"
            if ote_score_bull == 2     then info += "✅ OTE 0.618-0.786\n"
            else if ote_score_bull == 1 then info += "✅ Discount зона\n"
            if b_avwap_cross_bull      then info += "✅ AVWAP Cross ↑\n"
            else if b_avwap_bull       then info += "✅ AVWAP выравн.\n"
            if b_bb_bull               then info += "✅ Breaker Block\n"
            if b_disp_bull             then info += "✅ Displacement\n"
            if bars_since_choch_bull <= 5  then info += "✅ CHoCH (" + str.tostring(bars_since_choch_bull) + " бар)\n"
            if bars_since_sweep_bull <= 5  then info += "✅ Sweep (" + str.tostring(bars_since_sweep_bull) + " бар)\n"
            if bars_since_hm_bull <= 7     then info += "✅ HM Sweep (" + str.tostring(bars_since_hm_bull) + " бар)\n"
            if sm_act_bull             then info += "✅ SM Activity\n"
            if sm_idx_bull             then info += "✅ SM Index\n"
            if sm_int_bull             then info += "✅ SM Interest\n"
            if cvd_bull_div            then info += "✅ CVD дивергенция\n"
            if sm_absorption           then info += "✅ SM Absorption\n"
            if osc_kde_bull            then info += "✅ KDE RSI\n"
            if osc_stoch_bull          then info += "✅ Stoch Z\n"
            if osc_macd_dlx_bull       then info += "✅ MACD Deluxe\n"
            if osc_cci_bull            then info += "✅ Adv CCI\n"
            if osc_mdiv_bull           then info += "✅ Multi-Div (" + str.tostring(total_mdiv_bull) + ")\n"
            if osc_peter_bull          then info += "✅ PeterO Div\n"
            if osc_tfdiv_bull          then info += "✅ Fractal Div\n"
            if osc_smt_bull            then info += "✅ SMT Div\n"
            if cndl_bull               then info += "✅ Свеча: " + cndl_name + "\n"
            if ma_trend_bull           then info += "✅ MA тренд бычий\n"
            if b_master_bull           then info += "✅ Main Master Signal\n"
            if b_conf_bull_ok          then info += "✅ Main Confluence ≥8\n"
            if htf_gate_bull           then info += "✅ HTF Gate (" + str.tostring(htf_bull_conf) + "/3)\n"
        else
            if b_smc_bear              then info += "✅ SMC медвежий\n"
            if b_ob_fresh_bear         then info += "✅ Fresh OB (1й вход)\n"
            else if b_ob_bear          then info += "✅ OB State\n"
            if b_sd_bear               then info += "✅ S&D Supply\n"
            if b_fvg_precise_bear      then info += "✅ FVG точный\n"
            else if b_fvg_bear         then info += "✅ FVG Active\n"
            if ote_score_bear == 2     then info += "✅ OTE 0.618-0.786\n"
            else if ote_score_bear == 1 then info += "✅ Premium зона\n"
            if b_avwap_cross_bear      then info += "✅ AVWAP Cross ↓\n"
            else if b_avwap_bear       then info += "✅ AVWAP выравн.\n"
            if b_bb_bear               then info += "✅ Breaker Block\n"
            if b_disp_bear             then info += "✅ Displacement\n"
            if bars_since_choch_bear <= 5  then info += "✅ CHoCH (" + str.tostring(bars_since_choch_bear) + " бар)\n"
            if bars_since_sweep_bear <= 5  then info += "✅ Sweep (" + str.tostring(bars_since_sweep_bear) + " бар)\n"
            if bars_since_hm_bear <= 7     then info += "✅ HM Sweep (" + str.tostring(bars_since_hm_bear) + " бар)\n"
            if sm_act_bear             then info += "✅ SM Activity\n"
            if sm_idx_bear             then info += "✅ SM Index\n"
            if sm_int_bear             then info += "✅ SM Interest\n"
            if cvd_bear_div            then info += "✅ CVD дивергенция\n"
            if sm_absorption           then info += "✅ SM Absorption\n"
            if osc_kde_bear            then info += "✅ KDE RSI\n"
            if osc_stoch_bear          then info += "✅ Stoch Z\n"
            if osc_macd_dlx_bear       then info += "✅ MACD Deluxe\n"
            if osc_cci_bear            then info += "✅ Adv CCI\n"
            if osc_mdiv_bear           then info += "✅ Multi-Div (" + str.tostring(total_mdiv_bear) + ")\n"
            if osc_peter_bear          then info += "✅ PeterO Div\n"
            if osc_tfdiv_bear          then info += "✅ Fractal Div\n"
            if osc_smt_bear            then info += "✅ SMT Div\n"
            if cndl_bear               then info += "✅ Свеча: " + cndl_name + "\n"
            if ma_trend_bear           then info += "✅ MA тренд медвежий\n"
            if b_master_bear           then info += "✅ Main Master Signal\n"
            if b_conf_bear_ok          then info += "✅ Main Confluence ≥8\n"
            if htf_gate_bear           then info += "✅ HTF Gate (" + str.tostring(htf_bear_conf) + "/3)\n"
    info

// ====================================================================================================================
// ЖИВОЙ СВЕТОФОР
// Исправлено: label.delete + label.new вместо множественных set_* вызовов.
// Это решает проблему переключения стиля при смене направления bull↔bear.
// ====================================================================================================================
var label dynamic_lbl = na
var int   last_ltf_state_at_close_b = 0
var int   last_ltf_state_at_close_s = 0
var int   last_htf_state_at_close_b = 0
var int   last_htf_state_at_close_s = 0

if barstate.isrealtime and en_live_lbl and p1_connected
    int  cur_ltf_bull = mtf_state_bull
    int  cur_ltf_bear = mtf_state_bear
    int  cur_htf_bull = htf_bull_conf
    int  cur_htf_bear = htf_bear_conf

    bool is_bull_d = cur_ltf_bull >= cur_ltf_bear and (cur_ltf_bull > 0 or cur_htf_bull > 0)
    bool is_bear_d = cur_ltf_bear > cur_ltf_bull  and (cur_ltf_bear > 0 or cur_htf_bear > 0)

    int  cur_ltf = is_bull_d ? cur_ltf_bull : cur_ltf_bear
    int  cur_htf = is_bull_d ? cur_htf_bull : cur_htf_bear

    if cur_ltf > 0 or cur_htf > 0
        string dir = is_bull_d ? "BUY ↑" : "SELL ↓"

        int    cur_layers  = is_bull_d ? p1_zone_layers_bull : p1_zone_layers_bear
        bool   cur_chsw    = is_bull_d ? b_choch_sw_bull     : b_choch_sw_bear
        bool   cur_virgin  = is_bull_d ? b_ob_virgin_bull    : b_ob_virgin_bear
        bool   cur_ob_sd   = is_bull_d ? b_ob_sd_bull        : b_ob_sd_bear
        string zone_line   = cur_layers >= 3 ? "🔥 Зона: 3 слоя" :
                             cur_layers == 2 ? "💪 Зона: 2 слоя" :
                             cur_layers == 1 ? "⚪ Зона: 1 слой"  : "— Зона не активна"
        string quality_line = ""
        if cur_chsw
            quality_line += "⚡CHoCH/Sw "
        if cur_virgin
            quality_line += "✨Virgin "
        if cur_ob_sd
            quality_line += "🎯OB∈S&D"

        color bg_c = (cur_ltf == 3 and cur_htf >= 2 and cur_layers >= 2) ?
                         (is_bull_d ? live_bg_bull : live_bg_bear) :
                     (cur_ltf >= 2 or cur_htf >= 2) ? live_bg_warn : live_bg_neut

        string htf_icon = cur_htf == 3 ? "🟢" : cur_htf == 2 ? "🟡" : cur_htf == 1 ? "⚪" : "❌"
        string ltf_icon = cur_ltf == 3 ? "🔵" : cur_ltf == 2 ? "🟡" : cur_ltf == 1 ? "⚪" : "❌"

        string tier_txt = (cur_ltf == 3 and cur_htf >= 2 and cur_layers >= 2) ?
                              "✅ ГОТОВ к входу (" + dir + ")" :
                          (cur_ltf >= 2 and cur_htf >= 1) ?
                              "⏳ Почти готов (" + dir + ")" :
                          (cur_htf >= 2) ?
                              "📡 HTF подтверждён — жди LTF (" + dir + ")" :
                              "👀 Внимание (" + dir + ")"

        string htf1_s = is_bull_d ? htf1_detail_b : htf1_detail_s
        string htf2_s = is_bull_d ? htf2_detail_b : htf2_detail_s
        string htf3_s = is_bull_d ? htf3_detail_b : htf3_detail_s
        string ltf1_s = is_bull_d ? ltf1_detail_b : ltf1_detail_s
        string ltf2_s = is_bull_d ? ltf2_detail_b : ltf2_detail_s
        string ltf3_s = is_bull_d ? ltf3_detail_b : ltf3_detail_s

        string poi_s = ""
        if is_bull_d
            poi_s := (b_ob_bull          ? "OB "  : "") +
                     (b_sd_bull          ? "S&D " : "") +
                     (b_fvg_precise_bull ? "FVG " : "") +
                     (ote_score_bull >= 2 ? "OTE"  : "")
        else
            poi_s := (b_ob_bear          ? "OB "  : "") +
                     (b_sd_bear          ? "S&D " : "") +
                     (b_fvg_precise_bear ? "FVG " : "") +
                     (ote_score_bear >= 2 ? "OTE"  : "")

        string live_txt = tier_txt + "\n" +
            htf_icon + " HTF: " + str.tostring(cur_htf) + "/3 │ " + ltf_icon + " LTF: " + str.tostring(cur_ltf) + "/3\n" +
            zone_line + (quality_line != "" ? " │ " + quality_line : "") + "\n" +
            "── HTF (P1 скор | P2 OSC) ──\n" +
            htf1_s + "\n" + htf2_s + "\n" + htf3_s + "\n" +
            "── LTF (P1 скор | P2 OSC) ──\n" +
            ltf1_s + "\n" + ltf2_s + "\n" + ltf3_s + "\n" +
            "POI: " + (poi_s == "" ? "—" : poi_s)

        float  y_pos  = is_bull_d ? low  - atr14 * live_lbl_gap : high + atr14 * live_lbl_gap
        string lbl_st = is_bull_d ? label.style_label_up : label.style_label_down

        // Исправлено: delete + new вместо множественных set_* — корректно при смене стиля
        if not na(dynamic_lbl)
            label.delete(dynamic_lbl)
        dynamic_lbl := label.new(bar_index, y_pos,
            text      = live_txt,
            style     = lbl_st,
            color     = bg_c,
            textcolor = live_text_col,
            size      = get_size(live_text_size))
    else
        if not na(dynamic_lbl)
            label.delete(dynamic_lbl)
            dynamic_lbl := na

if barstate.isconfirmed
    last_ltf_state_at_close_b := mtf_state_bull
    last_ltf_state_at_close_s := mtf_state_bear
    last_htf_state_at_close_b := htf_bull_conf
    last_htf_state_at_close_s := htf_bear_conf
    if not na(dynamic_lbl)
        label.delete(dynamic_lbl)
        dynamic_lbl := na

// ====================================================================================================================
// ВИЗУАЛИЗАЦИЯ — ИСТОРИЧЕСКИЕ ЛЕЙБЛЫ BUY/SELL
// ====================================================================================================================
if is_buy
    int   ltf_s  = last_ltf_state_at_close_b
    int   htf_s  = last_htf_state_at_close_b
    int   layers = p1_zone_layers_bull

    color buy_col = (ltf_s == 3 and htf_s >= 2 and layers >= 2) ? color.new(#00c853, 0) :
                    (ltf_s >= 2 and htf_s >= 1)                  ? color.new(#ff9800, 0) :
                                                                    color.new(#089981, 0)

    string htf_ic  = htf_s == 3 ? "🟢" : htf_s == 2 ? "🟡" : htf_s == 1 ? "⚪" : ""
    string ltf_ic  = ltf_s == 3 ? "🔵" : ltf_s == 2 ? "🟡" : ltf_s == 1 ? "⚪" : ""
    string zone_ic = layers >= 3 ? "🔥" : layers == 2 ? "💪" : ""
    string buy_txt = htf_ic + ltf_ic + zone_ic + " BUY"

    if en_sig_labels
        label.new(bar_index, low - atr14,
            text      = buy_txt,
            style     = label.style_label_up,
            color     = buy_col,
            textcolor = color.white,
            size      = get_size(sig_text_size))

    if en_info_block
        bool  full_ok = ltf_s >= 3 and htf_s >= 2 and layers >= 2
        color info_bg = full_ok ? color.new(#1b5e20, 15) : info_bg_col
        label.new(bar_index, low - atr14 * (1 + info_gap),
            text      = f_build_info(true),
            style     = label.style_label_up,
            color     = info_bg,
            textcolor = info_text_col,
            size      = get_size(info_text_size),
            textalign = f_get_align(info_align))

if is_sell
    int   ltf_s  = last_ltf_state_at_close_s
    int   htf_s  = last_htf_state_at_close_s
    int   layers = p1_zone_layers_bear

    color sell_col = (ltf_s == 3 and htf_s >= 2 and layers >= 2) ? color.new(#d50000, 0) :
                     (ltf_s >= 2 and htf_s >= 1)                  ? color.new(#ff9800, 0) :
                                                                     color.new(#f23645, 0)

    string htf_ic   = htf_s == 3 ? "🟢" : htf_s == 2 ? "🟡" : htf_s == 1 ? "⚪" : ""
    string ltf_ic   = ltf_s == 3 ? "🔵" : ltf_s == 2 ? "🟡" : ltf_s == 1 ? "⚪" : ""
    string zone_ic  = layers >= 3 ? "🔥" : layers == 2 ? "💪" : ""
    string sell_txt = htf_ic + ltf_ic + zone_ic + " SELL"

    if en_sig_labels
        label.new(bar_index, high + atr14,
            text      = sell_txt,
            style     = label.style_label_down,
            color     = sell_col,
            textcolor = color.white,
            size      = get_size(sig_text_size))

    if en_info_block
        bool  full_ok = ltf_s >= 3 and htf_s >= 2 and layers >= 2
        color info_bg = full_ok ? color.new(#b71c1c, 15) : info_bg_col
        label.new(bar_index, high + atr14 * (1 + info_gap),
            text      = f_build_info(false),
            style     = label.style_label_down,
            color     = info_bg,
            textcolor = info_text_col,
            size      = get_size(info_text_size),
            textalign = f_get_align(info_align))
