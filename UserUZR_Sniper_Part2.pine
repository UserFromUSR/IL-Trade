// ====================================================================================================================
// UDT ДЛЯ HC
// ====================================================================================================================
type hc_result
    bool   bull   = false
    bool   bear   = false
    string name_b = ""
    string name_s = ""
    string keys_b = ""
    string keys_s = ""

f_k(string existing, bool cond, string name) =>
    cond ? existing + name + "|" : existing

// ====================================================================================================================
// HC ФУНКЦИИ — ГРУППА: РАЗВОРОТЫ
// ====================================================================================================================

f_pat_A1() =>
    r = hc_result.new()
    r.bull := en_hc_a1 and b_smc_bull and bars_since_choch_bull <= 2 and b_fvg_precise_bull
        and bars_since_hm_bull <= 3 and (b_sd_bull or b_ob_bull) and sm_act_bull and ltf_gate_bull
    r.bear := en_hc_a1 and b_smc_bear and bars_since_choch_bear <= 2 and b_fvg_precise_bear
        and bars_since_hm_bear <= 3 and (b_sd_bear or b_ob_bear) and sm_act_bear and ltf_gate_bear
    r.name_b := r.bull ? "A1: Каскадный разворот" : ""
    r.name_s := r.bear ? "A1: Каскадный разворот" : ""
    if r.bull
        r.keys_b := f_k("", b_smc_bull, "SMC бычий")
        r.keys_b := f_k(r.keys_b, bars_since_choch_bull<=2, "CHoCH ≤2 бар")
        r.keys_b := f_k(r.keys_b, b_fvg_precise_bull, "FVG точный")
        r.keys_b := f_k(r.keys_b, bars_since_hm_bull<=3, "HM Sweep ≤3 бар")
        r.keys_b := f_k(r.keys_b, b_sd_bull, "S&D Demand")
        r.keys_b := f_k(r.keys_b, b_ob_bull, "OB State")
        r.keys_b := f_k(r.keys_b, sm_act_bull, "SM Activity")
        r.keys_b += "LTF " + str.tostring(ltf_bull_conf) + "/3|"
    if r.bear
        r.keys_s := f_k("", b_smc_bear, "SMC медвежий")
        r.keys_s := f_k(r.keys_s, bars_since_choch_bear<=2, "CHoCH ≤2 бар")
        r.keys_s := f_k(r.keys_s, b_fvg_precise_bear, "FVG точный")
        r.keys_s := f_k(r.keys_s, bars_since_hm_bear<=3, "HM Sweep ≤3 бар")
        r.keys_s := f_k(r.keys_s, b_sd_bear, "S&D Supply")
        r.keys_s := f_k(r.keys_s, b_ob_bear, "OB State")
        r.keys_s := f_k(r.keys_s, sm_act_bear, "SM Activity")
        r.keys_s += "LTF " + str.tostring(ltf_bear_conf) + "/3|"
    r

f_pat_A3() =>
    r = hc_result.new()
    r.bull := en_hc_a3 and ote_score_bull == 2 and b_fvg_precise_bull and b_sd_bull
        and osc_smt_bull and (sm_int_bull or sm_idx_bull) and b_avwap_bull
        and (osc_kde_bull or osc_stoch_bull or osc_macd_dlx_bull) and ltf_gate_bull
    r.bear := en_hc_a3 and ote_score_bear == 2 and b_fvg_precise_bear and b_sd_bear
        and osc_smt_bear and (sm_int_bear or sm_idx_bear) and b_avwap_bear
        and (osc_kde_bear or osc_stoch_bear or osc_macd_dlx_bear) and ltf_gate_bear
    r.name_b := r.bull ? "A3: PD-арбитраж" : ""
    r.name_s := r.bear ? "A3: PD-арбитраж" : ""
    if r.bull
        r.keys_b := "OTE 0.618-0.786|FVG точный|S&D Demand|SMT Div|AVWAP выравн.|"
        r.keys_b := f_k(r.keys_b, sm_int_bull, "SM Interest")
        r.keys_b := f_k(r.keys_b, sm_idx_bull, "SM Index")
        r.keys_b := f_k(r.keys_b, osc_kde_bull, "KDE RSI")
        r.keys_b := f_k(r.keys_b, osc_stoch_bull, "Stoch Z")
        r.keys_b := f_k(r.keys_b, osc_macd_dlx_bull, "MACD Deluxe")
    if r.bear
        r.keys_s := "OTE 0.618-0.786|FVG точный|S&D Supply|SMT Div|AVWAP выравн.|"
        r.keys_s := f_k(r.keys_s, sm_int_bear, "SM Interest")
        r.keys_s := f_k(r.keys_s, sm_idx_bear, "SM Index")
        r.keys_s := f_k(r.keys_s, osc_kde_bear, "KDE RSI")
        r.keys_s := f_k(r.keys_s, osc_stoch_bear, "Stoch Z")
        r.keys_s := f_k(r.keys_s, osc_macd_dlx_bear, "MACD Deluxe")
    r

f_pat_C1() =>
    r = hc_result.new()
    bool vol_b = sm_int_bull and (sm_idx_bull or sm_act_bull)
    bool vol_s = sm_int_bear and (sm_idx_bear or sm_act_bear)
    bool zn_b  = b_ob_bull or b_fvg_precise_bull or b_sd_bull or ote_score_bull == 2
    bool zn_s  = b_ob_bear or b_fvg_precise_bear or b_sd_bear or ote_score_bear == 2
    r.bull := en_hc_c1 and osc_kde_bull and (osc_macd_dlx_bull or osc_stoch_bull or osc_cci_bull)
        and vol_b and (osc_smt_bull or osc_tfdiv_bull) and zn_b and b_avwap_bull and ltf_gate_bull
    r.bear := en_hc_c1 and osc_kde_bear and (osc_macd_dlx_bear or osc_stoch_bear or osc_cci_bear)
        and vol_s and (osc_smt_bear or osc_tfdiv_bear) and zn_s and b_avwap_bear and ltf_gate_bear
    r.name_b := r.bull ? "C1: Тройная дивергенция" : ""
    r.name_s := r.bear ? "C1: Тройная дивергенция" : ""
    if r.bull
        r.keys_b := "KDE RSI|AVWAP выравн.|SM Interest|"
        r.keys_b := f_k(r.keys_b, sm_idx_bull, "SM Index")
        r.keys_b := f_k(r.keys_b, sm_act_bull, "SM Activity")
        r.keys_b := f_k(r.keys_b, osc_smt_bull, "SMT Div")
        r.keys_b := f_k(r.keys_b, osc_tfdiv_bull, "Fractal Div")
        r.keys_b := f_k(r.keys_b, osc_macd_dlx_bull, "MACD Deluxe")
        r.keys_b := f_k(r.keys_b, osc_stoch_bull, "Stoch Z")
        r.keys_b := f_k(r.keys_b, osc_cci_bull, "Adv CCI")
        r.keys_b := f_k(r.keys_b, b_ob_bull, "OB State")
        r.keys_b := f_k(r.keys_b, b_sd_bull, "S&D Demand")
        r.keys_b := f_k(r.keys_b, b_fvg_precise_bull, "FVG точный")
    if r.bear
        r.keys_s := "KDE RSI|AVWAP выравн.|SM Interest|"
        r.keys_s := f_k(r.keys_s, sm_idx_bear, "SM Index")
        r.keys_s := f_k(r.keys_s, sm_act_bear, "SM Activity")
        r.keys_s := f_k(r.keys_s, osc_smt_bear, "SMT Div")
        r.keys_s := f_k(r.keys_s, osc_tfdiv_bear, "Fractal Div")
        r.keys_s := f_k(r.keys_s, osc_macd_dlx_bear, "MACD Deluxe")
        r.keys_s := f_k(r.keys_s, osc_stoch_bear, "Stoch Z")
        r.keys_s := f_k(r.keys_s, osc_cci_bear, "Adv CCI")
        r.keys_s := f_k(r.keys_s, b_ob_bear, "OB State")
        r.keys_s := f_k(r.keys_s, b_sd_bear, "S&D Supply")
        r.keys_s := f_k(r.keys_s, b_fvg_precise_bear, "FVG точный")
    r

f_pat_C3() =>
    r = hc_result.new()
    int cnt_b = (osc_tfdiv_bull?1:0)+(osc_peter_bull?1:0)+(osc_mdiv_bull?1:0)+(cndl_bull?1:0)
    int cnt_s = (osc_tfdiv_bear?1:0)+(osc_peter_bear?1:0)+(osc_mdiv_bear?1:0)+(cndl_bear?1:0)
    bool zn_b = b_ob_bull or b_sd_bull or b_fvg_precise_bull
    bool zn_s = b_ob_bear or b_sd_bear or b_fvg_precise_bear
    r.bull := en_hc_c3 and cnt_b >= 3 and sm_int_bull and (sm_idx_bull or sm_act_bull)
        and zn_b and ote_score_bull >= 1 and ltf_gate_bull
    r.bear := en_hc_c3 and cnt_s >= 3 and sm_int_bear and (sm_idx_bear or sm_act_bear)
        and zn_s and ote_score_bear >= 1 and ltf_gate_bear
    r.name_b := r.bull ? "C3: Фрактальная конвергенция" : ""
    r.name_s := r.bear ? "C3: Фрактальная конвергенция" : ""
    if r.bull
        r.keys_b := "SM Interest|" + str.tostring(cnt_b) + " из 4 Div/Cndl|OTE ≥1|"
        r.keys_b := f_k(r.keys_b, osc_tfdiv_bull, "Fractal Div")
        r.keys_b := f_k(r.keys_b, osc_peter_bull, "PeterO Div")
        r.keys_b := f_k(r.keys_b, osc_mdiv_bull, "Multi-Div")
        r.keys_b := f_k(r.keys_b, cndl_bull, "Свеча: " + cndl_name)
        r.keys_b := f_k(r.keys_b, sm_idx_bull, "SM Index")
        r.keys_b := f_k(r.keys_b, sm_act_bull, "SM Activity")
        r.keys_b := f_k(r.keys_b, b_ob_bull, "OB")
        r.keys_b := f_k(r.keys_b, b_sd_bull, "S&D")
        r.keys_b := f_k(r.keys_b, b_fvg_precise_bull, "FVG точный")
    if r.bear
        r.keys_s := "SM Interest|" + str.tostring(cnt_s) + " из 4 Div/Cndl|OTE ≥1|"
        r.keys_s := f_k(r.keys_s, osc_tfdiv_bear, "Fractal Div")
        r.keys_s := f_k(r.keys_s, osc_peter_bear, "PeterO Div")
        r.keys_s := f_k(r.keys_s, osc_mdiv_bear, "Multi-Div")
        r.keys_s := f_k(r.keys_s, cndl_bear, "Свеча: " + cndl_name)
        r.keys_s := f_k(r.keys_s, sm_idx_bear, "SM Index")
        r.keys_s := f_k(r.keys_s, sm_act_bear, "SM Activity")
        r.keys_s := f_k(r.keys_s, b_ob_bear, "OB")
        r.keys_s := f_k(r.keys_s, b_sd_bear, "S&D")
        r.keys_s := f_k(r.keys_s, b_fvg_precise_bear, "FVG точный")
    r

f_pat_G3() =>
    r = hc_result.new()
    r.bull := en_hc_g3 and b_smc_bear and ote_score_bull == 2 and bars_since_hm_bull <= 3
        and total_mdiv_bull >= 4 and sm_idx_bull and sm_int_bull and osc_smt_bull and cndl_bull
        and (ltf_bull_conf >= 3)
    r.bear := en_hc_g3 and b_smc_bull and ote_score_bear == 2 and bars_since_hm_bear <= 3
        and total_mdiv_bear >= 4 and sm_idx_bear and sm_int_bear and osc_smt_bear and cndl_bear
        and (ltf_bear_conf >= 3)
    r.name_b := r.bull ? "G3: Контртрендовый снайпер" : ""
    r.name_s := r.bear ? "G3: Контртрендовый снайпер" : ""
    if r.bull
        r.keys_b := "SMC медвежий (контртренд)|OTE 0.618-0.786|HM Sweep ≤3 бар|Multi-Div ≥4|SM Index|SM Interest|SMT Div|Свеча: " + cndl_name + "|LTF 3/3|"
    if r.bear
        r.keys_s := "SMC бычий (контртренд)|OTE 0.618-0.786|HM Sweep ≤3 бар|Multi-Div ≥4|SM Index|SM Interest|SMT Div|Свеча: " + cndl_name + "|LTF 3/3|"
    r

