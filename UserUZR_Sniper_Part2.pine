f_pat_B2() =>
    r = hc_result.new()
    r.bull := en_hc_b2 and b_smc_bull and (b_fvg_bull or b_fvg_precise_bull)
        and sm_act_bull and sm_idx_bull and b_disp_bull and ote_score_bull >= 1 and ltf_gate_bull
    r.bear := en_hc_b2 and b_smc_bear and (b_fvg_bear or b_fvg_precise_bear)
        and sm_act_bear and sm_idx_bear and b_disp_bear and ote_score_bear >= 1 and ltf_gate_bear
    r.name_b := r.bull ? "B2: Объёмный дисбаланс" : ""
    r.name_s := r.bear ? "B2: Объёмный дисбаланс" : ""
    if r.bull
        r.keys_b := "SMC бычий|SM Activity|SM Index|Displacement|OTE ≥1|"
        r.keys_b := f_k(r.keys_b, b_fvg_precise_bull, "FVG точный")
        r.keys_b := f_k(r.keys_b, b_fvg_bull, "FVG Active")
    if r.bear
        r.keys_s := "SMC медвежий|SM Activity|SM Index|Displacement|OTE ≥1|"
        r.keys_s := f_k(r.keys_s, b_fvg_precise_bear, "FVG точный")
        r.keys_s := f_k(r.keys_s, b_fvg_bear, "FVG Active")
    r

f_pat_C2() =>
    r = hc_result.new()
    r.bull := en_hc_c2 and b_smc_bull and ma_trend_bull and osc_peter_bull
        and (b_ob_bull or b_fvg_precise_bull) and sm_int_bull and not sm_act_bear
        and ote_score_bull >= 1 and (osc_macd_dlx_bull or osc_kde_bull or osc_stoch_bull) and ltf_gate_bull
    r.bear := en_hc_c2 and b_smc_bear and ma_trend_bear and osc_peter_bear
        and (b_ob_bear or b_fvg_precise_bear) and sm_int_bear and not sm_act_bull
        and ote_score_bear >= 1 and (osc_macd_dlx_bear or osc_kde_bear or osc_stoch_bear) and ltf_gate_bear
    r.name_b := r.bull ? "C2: Скрытая дивергенция в тренде" : ""
