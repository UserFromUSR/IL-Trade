grp_htf_tf = "7. HTF Engine — Таймфреймы"
htf_tv_1   = input.timeframe("60",  "HTF1 — 1 час",   group=grp_htf_tf)
htf_tv_2   = input.timeframe("240", "HTF2 — 4 часа",  group=grp_htf_tf)
htf_tv_3   = input.timeframe("D",   "HTF3 — 1 день",  group=grp_htf_tf)

// HTF Engine RSI
grp_htf_e = "7.1 HTF Engine — Параметры"
htf_rsi_len     = input.int(14,    "RSI Length",           minval=2,      group=grp_htf_e)
