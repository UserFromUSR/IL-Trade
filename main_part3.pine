// ====================================================================================================================
// SUPPLY & DEMAND (Flux Charts Port)
// ====================================================================================================================

var demandZones = array.new<sd_info>()
var supplyZones = array.new<sd_info>()
var sdBoxes     = array.new_box()
var sdLines     = array.new_line()

float sd_atr  = ta.atr(20)
float sd_body = math.abs(close - open)

bool sd_bull_disp = close[1] > open[1] and sd_body[1] > sd_atr[1] * 1.5
bool sd_bear_disp = open[1] > close[1] and sd_body[1] > sd_atr[1] * 1.5
bool sd_base_cond = math.max(sd_body[2], nz(sd_body[3], sd_body[2])) < sd_atr[2] * 0.7

var int  lastDemand  = 0
var int  lastSupply  = 0
var bool sd_in_demand = false
var bool sd_in_supply = false

var int export_sd_inv = 0
export_sd_inv := 0

if en_3
    if sd_bull_disp and sd_base_cond and bar_index - lastDemand > 5
        lastDemand := bar_index
        float demand_proximal = math.max(open[2], close[2])
        float demand_distal   = math.min(open[2], close[2])
        float zTop = demand_proximal + sd_atr * 0.1
        float zBot = demand_distal   - sd_atr * 0.2
        demandZones.unshift(sd_info.new(zTop, zBot, "Demand", time[2], na, false))
        if demandZones.size() > 30
            demandZones.pop()

    if sd_bear_disp and sd_base_cond and bar_index - lastSupply > 5
        lastSupply := bar_index
        float supply_proximal = math.min(open[2], close[2])
        float supply_distal   = math.max(open[2], close[2])
        float zBot = supply_proximal - sd_atr * 0.1
        float zTop = supply_distal   + sd_atr * 0.2
        supplyZones.unshift(sd_info.new(zTop, zBot, "Supply", time[2], na, false))
        if supplyZones.size() > 30
            supplyZones.pop()

    if demandZones.size() > 0
        for i = 0 to demandZones.size() - 1
            curr = demandZones.get(i)
            if na(curr.breakTime) and close < curr.bottom
                if barstate.isconfirmed
                    curr.breakTime := time
                    export_sd_inv  := -1

    if supplyZones.size() > 0
        for i = 0 to supplyZones.size() - 1
            curr = supplyZones.get(i)
            if na(curr.breakTime) and close > curr.top
                if barstate.isconfirmed
                    curr.breakTime := time
                    export_sd_inv  := 1

    sd_in_demand := false
    sd_in_supply := false

    if demandZones.size() > 0
        for i = 0 to demandZones.size() - 1
            curr = demandZones.get(i)
            if na(curr.breakTime) and close >= curr.bottom and close <= curr.top
                sd_in_demand := true

    if supplyZones.size() > 0
        for i = 0 to supplyZones.size() - 1
            curr = supplyZones.get(i)
            if na(curr.breakTime) and close >= curr.bottom and close <= curr.top
                sd_in_supply := true

    if barstate.islast
        for b in sdBoxes
            b.delete()
        sdBoxes.clear()
        for l in sdLines
            l.delete()
        sdLines.clear()

        var validZones = array.new<sd_info>()
        validZones.clear()

        for z in demandZones
            if na(z.breakTime)
                validZones.push(sd_info.new(z.top, z.bottom, z.type, z.startTime, z.breakTime, z.disabled))
        for z in supplyZones
            if na(z.breakTime)
                validZones.push(sd_info.new(z.top, z.bottom, z.type, z.startTime, z.breakTime, z.disabled))

        bool combining = true
        while combining
            combining := false
            if validZones.size() > 1
                for i = 0 to validZones.size() - 1
                    for j = 0 to validZones.size() - 1
                        if i == j
                            continue
                        z1 = validZones.get(i)
                        z2 = validZones.get(j)
                        if z1.disabled or z2.disabled or z1.type != z2.type
                            continue
                        float overlap_tolerance = sd_atr * 0.3
                        float YA1 = z1.top    + overlap_tolerance
                        float YA2 = z1.bottom - overlap_tolerance
                        float YB1 = z2.top    + overlap_tolerance
                        float YB2 = z2.bottom - overlap_tolerance
                        if math.min(YA1, YB1) >= math.max(YA2, YB2)
                            z1.disabled := true
                            z2.disabled := true
                            float newTop = math.max(z1.top,    z2.top)
                            float newBot = math.min(z1.bottom, z2.bottom)
                            int newStart = math.min(z1.startTime, z2.startTime)
                            validZones.push(sd_info.new(newTop, newBot, z1.type, newStart, na, false))
                            combining := true

        string tfFormat = timeframe.isintraday ? (timeframe.multiplier >= 60 ? str.tostring(timeframe.multiplier / 60) + " Hour" : str.tostring(timeframe.multiplier) + " Min") : (timeframe.isdaily ? "1 Day" : "TF")

        for z in validZones
            if not z.disabled
                int   eTime  = time
                color zColor = z.type == "Demand" ? sd_d_col : sd_s_col
                float mid    = (z.top + z.bottom) / 2
                sdBoxes.push(box.new(left=z.startTime, top=z.top, right=eTime, bottom=z.bottom, xloc=xloc.bar_time, border_color=zColor, bgcolor=color.new(zColor, 85)))
                sdLines.push(line.new(x1=z.startTime, y1=mid, x2=eTime, y2=mid, xloc=xloc.bar_time, color=color.new(color.white, 30), style=line.style_dashed))
                int textLeftTime = math.max(z.startTime, eTime - int((eTime - z.startTime) / 2))
                sdBoxes.push(box.new(left=textLeftTime, top=mid, right=eTime, bottom=z.bottom, xloc=xloc.bar_time, border_color=na, bgcolor=color.new(color.white, 100), text=tfFormat + " " + z.type, text_color=sd_text_col, text_size=size.small, text_halign=text.align_right, text_valign=text.align_bottom))

// ====================================================================================================================
// FVG VOLUME PROFILE [CHARTPRIME PORT]
// ====================================================================================================================

var fvgs           = array.new<fvg_obj>()
var fvg_pocLblAllow = true

if en_2
    bool fvg_bullish_gap_condition = low > high[2] and high[1] > high[2] and fvg_bullish_gap_size > fvg_gap_filter
    bool fvg_bearish_gap_condition = high < low[2] and low[1] < low[2]  and fvg_bearish_gap_size > fvg_gap_filter

    array<float> cls_array = fvg_c.size() > 0 ? fvg_c[1] : array.new_float()
    array<float> vol_array = fvg_v.size() > 0 ? fvg_v[1] : array.new_float()

    if fvg_bullish_gap_condition
        fvg_pocLblAllow := false
        float fvg_lower = high[2]
        float fvg_upper = low
        box   fvg_box   = box.new(bar_index - 1, fvg_upper, bar_index + 3, fvg_lower, border_color=na, border_width=0, bgcolor=color.new(fvg_bull_color, 70))
        float binSize   = (fvg_upper - fvg_lower) / fvg_bins
        array<float> volumeP    = array.new<float>(fvg_bins, 0.)
        array<box>   volumeBoxes = array.new<box>(fvg_bins,  box(na))
        line  poc    = line(na)
        label pocLbl = label(na)

        if cls_array.size() > 0
            for k = 0 to fvg_bins - 1
                float lower_b = fvg_lower + binSize * k
                float mid_b   = lower_b + binSize / 2
                for i = 0 to cls_array.size() - 1
                    if math.abs(cls_array.get(i) - mid_b) <= binSize
                        volumeP.set(k, volumeP.get(k) + vol_array.get(i))

        for k = 0 to fvg_bins - 1
            float lower_b = fvg_lower + binSize * k
            float upper_b = lower_b + binSize
            float mid_b   = lower_b + binSize / 2
            volumeBoxes.set(k, box.new(bar_index - 1, upper_b, bar_index - 1, lower_b, border_width=0))
            float vol = volumeP.get(k)
            if volumeP.max() != 0
                if vol == volumeP.max() and not fvg_pocLblAllow
                    poc    := line.new(bar_index - 1, mid_b, bar_index - 1, mid_b, color=fvg_bull_color)
                    pocLbl := label.new(bar_index - 1, mid_b, str.tostring(volumeP.max(), format.volume), style=label.style_label_left, color=fvg_bull_color, textcolor=chart.fg_color)
                    fvg_pocLblAllow := true

        fvgs.push(fvg_obj.new(fvg_box, true, volumeP, volumeBoxes, poc, pocLbl, bar_index))

    if fvg_bearish_gap_condition
        fvg_pocLblAllow := false
        float fvg_upper = low[2]
        float fvg_lower = high
        box   fvg_box   = box.new(bar_index - 1, fvg_upper, bar_index + 3, fvg_lower, border_color=na, border_width=0, bgcolor=color.new(fvg_bear_color, 70))
        float binSize   = (fvg_upper - fvg_lower) / fvg_bins
        array<float> volumeP     = array.new<float>(fvg_bins, 0.)
        array<box>   volumeBoxes = array.new<box>(fvg_bins,  box(na))
        line  poc    = line(na)
        label pocLbl = label(na)

        if cls_array.size() > 0
            for k = 0 to fvg_bins - 1
                float lower_b = fvg_lower + binSize * k
                float mid_b   = lower_b + binSize / 2
                for i = 0 to cls_array.size() - 1
                    if math.abs(cls_array.get(i) - mid_b) <= binSize
                        volumeP.set(k, volumeP.get(k) + vol_array.get(i))

        for k = 0 to fvg_bins - 1
            float lower_b = fvg_lower + binSize * k
            float upper_b = lower_b + binSize
            float mid_b   = lower_b + binSize / 2
            float vol     = volumeP.get(k)
            volumeBoxes.set(k, box.new(bar_index - 1, upper_b, bar_index - 1, lower_b, border_width=0))
            if volumeP.max() != 0 and not fvg_pocLblAllow
                if vol == volumeP.max()
                    poc    := line.new(bar_index - 1, mid_b, bar_index - 1, mid_b, color=fvg_bear_color)
                    pocLbl := label.new(bar_index - 1, mid_b, str.tostring(volumeP.max() * -1, format.volume), style=label.style_label_left, color=fvg_bear_color, textcolor=chart.fg_color)
                    fvg_pocLblAllow := true

        fvgs.push(fvg_obj.new(fvg_box, false, volumeP, volumeBoxes, poc, pocLbl, bar_index))

    if fvgs.size() > 0
        for i = fvgs.size() - 1 to 0
            f = fvgs.get(i)
            if bar_index - f.age > 720
                f.FVG.delete()
                f.poc.delete()
                f.pocLbl.delete()
                for b in f.volumeBoxes
                    b.delete()
                fvgs.remove(i)
                continue

            f.FVG.set_right(bar_index + 25)
            float top   = f.FVG.get_top()
            float bot   = f.FVG.get_bottom()
            int   left  = f.FVG.get_left()
            int   right = f.FVG.get_right()
            float binSize = (top - bot) / fvg_bins
            boxes = f.volumeBoxes

            f.poc.set_x2(right)
            f.pocLbl.set_x(right)

            f.FVG.set_text(str.tostring(f.volumeProfile.sum(), format.volume))
            f.FVG.set_text_halign(text.align_right)
            f.FVG.set_text_valign(f.isBull ? text.align_bottom : text.align_top)
            f.FVG.set_text_size(size.normal)
            f.FVG.set_text_color(chart.fg_color)

            if f.isBull
                if low < f.FVG.get_bottom()
                    f.FVG.delete()
                    f.poc.delete()
                    f.pocLbl.delete()
                    for b in boxes
                        b.delete()
                    fvgs.remove(i)
                else
                    for k = 0 to fvg_bins - 1
                        float volSum   = f.volumeProfile.max()
                        float volRatio = f.volumeProfile.get(k) / math.max(volSum, 1) * 50
                        float step     = (right - left) / 100
                        int   boxWidth = math.round(volRatio * step)
                        box   box_id   = boxes.get(k)
                        color bgColor  = color.from_gradient(f.volumeProfile.get(k), 0, f.volumeProfile.max(), color.new(fvg_bull_color, 100), fvg_bull_color)
                        if boxWidth != 0 and fvg_hideVP
                            box_id.set_right(left + boxWidth)
                            box_id.set_bgcolor(bgColor)
            else
                if high > f.FVG.get_top()
                    f.FVG.delete()
                    f.poc.delete()
                    f.pocLbl.delete()
                    for b in boxes
                        b.delete()
                    fvgs.remove(i)
                else
                    for k = 0 to fvg_bins - 1
                        float volSum   = f.volumeProfile.max()
                        float volRatio = f.volumeProfile.get(k) / math.max(volSum, 1)
                        int   boxWidth = math.round(volRatio * (right - left) / 2.5)
                        box   box_id   = boxes.get(k)
                        color bgColor  = color.from_gradient(f.volumeProfile.get(k), 0, f.volumeProfile.max(), color.new(fvg_bear_color, 100), fvg_bear_color)
                        if boxWidth != 0 and fvg_hideVP
                            box_id.set_right(left + boxWidth)
                            box_id.set_bgcolor(bgColor)

// ====================================================================================================================
// CLUSTERS VOLUME PROFILE (LUXALGO PORT)
// ====================================================================================================================

f_kmeans(int n, int k, int iterations) =>
    float[] prices  = array.new_float(0)
    float[] volumes = array.new_float(0)
    float minP = 1e10, maxP = -1e10
    for i = 0 to n - 1
        float p = hl2[i], float v = volume[i]
        prices.push(p), volumes.push(v)
        minP := math.min(minP, p)
        maxP := math.max(maxP, p)
    float[] centroids   = array.new_float(k)
    float   step        = (maxP - minP) / (k + 1)
    for i = 0 to k - 1
        centroids.set(i, minP + (i + 1) * step)
    int[] assignments = array.new_int(n)
    for iter = 1 to iterations
        for i = 0 to n - 1
            float p        = prices.get(i)
            int   best_k   = 0
            float min_dist = 1e10
            for j = 0 to k - 1
                float dist = math.abs(p - centroids.get(j))
                if dist < min_dist
                    min_dist := dist
                    best_k   := j
            assignments.set(i, best_k)
        float[] sum_pv = array.new_float(k, 0.0)
        float[] sum_v  = array.new_float(k, 0.0)
        for i = 0 to n - 1
            int cluster = assignments.get(i)
            sum_pv.set(cluster, sum_pv.get(cluster) + prices.get(i) * volumes.get(i))
            sum_v.set(cluster,  sum_v.get(cluster)  + volumes.get(i))
        for j = 0 to k - 1
            if sum_v.get(j) > 0
                centroids.set(j, sum_pv.get(j) / sum_v.get(j))
    [assignments, centroids]

var box[]   clBoxes  = array.new_box()
var label[] clLabels = array.new_label()
var line[]  clLines  = array.new_line()

if en_1 and barstate.islast
    [assignments, centroids] = f_kmeans(lookback_1, k_1, iters_1)

    if clBoxes.size() > 0
        for b in clBoxes
            b.delete()
        clBoxes.clear()
    if clLabels.size() > 0
        for l in clLabels
            l.delete()
        clLabels.clear()
    if clLines.size() > 0
        for ln in clLines
            ln.delete()
        clLines.clear()

    int calcStart          = bar_index - lookback_1 + 1
    int vpStartX           = bar_index + vpOffset
    int reservedForMetrics = k_1 * 2
    int labelsUsed         = 0

    for c_id = 0 to k_1 - 1
        color   clusterColor = PALETTE.get(c_id % PALETTE.size())
        float[] c_prices     = array.new_float(0)
        float[] c_vols       = array.new_float(0)
        float[] c_highs      = array.new_float(0)
        float[] c_lows       = array.new_float(0)
        float c_min      = 1e10, float c_max = -1e10
        float c_total_vol = 0.0

        for i = 0 to lookback_1 - 1
            if assignments.get(i) == c_id
                float p = hl2[i], float v = volume[i], float h = high[i], float l = low[i]
                c_prices.push(p), c_vols.push(v), c_highs.push(h), c_lows.push(l)
                c_min := math.min(c_min, l)
                c_max := math.max(c_max, h)
                c_total_vol += v
                if showDots and labelsUsed < (1000 - reservedForMetrics)
                    clLabels.push(label.new(bar_index - i, p, "•", color=#00000000, textcolor=clusterColor, style=label.style_label_center, size=size.small))
                    labelsUsed += 1

        if c_prices.size() > 0
            float[] binVols = array.new_float(rows_1, 0.0)
            float   binSize = (c_max - c_min) / rows_1
            if binSize == 0
                binSize := syminfo.mintick

            for i = 0 to c_prices.size() - 1
                float b_h = c_highs.get(i), float b_l = c_lows.get(i), float b_v = c_vols.get(i)
                float wickRange = math.max(b_h - b_l, syminfo.mintick)
                for b_idx = 0 to rows_1 - 1
                    float binB      = c_min + b_idx * binSize
                    float binT      = binB + binSize
                    float intersectL = math.max(b_l, binB)
                    float intersectH = math.min(b_h, binT)
                    if intersectH > intersectL
                        binVols.set(b_idx, binVols.get(b_idx) + b_v * (intersectH - intersectL) / wickRange)

            float maxBinVol = binVols.max()
            int   pocBinIdx = binVols.indexof(maxBinVol)

            for b_idx = 0 to rows_1 - 1
                float vol      = binVols.get(b_idx)
                if vol == 0
                    continue
                float b_bottom = c_min + b_idx * binSize
                float b_top    = b_bottom + binSize
                int   b_width  = int((vol / math.max(maxBinVol, 1)) * vpWidth)
                int   endX     = vpStartX + b_width
                bool  isPoc    = b_idx == pocBinIdx
                color b_color  = isPoc ? clusterColor : color.new(clusterColor, 75)

                clBoxes.push(box.new(vpStartX, b_top, endX, b_bottom, bgcolor=b_color, border_color=isPoc ? clusterColor : #00000000))
                if isPoc
                    float pocY = (b_top + b_bottom) / 2
                    clLines.push(line.new(calcStart, pocY, vpStartX, pocY, color=clusterColor, width=1, style=line.style_dashed))
                    clLabels.push(label.new(calcStart, pocY, str.tostring(vol, format.volume), color=#00000000, textcolor=clusterColor, style=label.style_label_right, size=size.small))
                    clLabels.push(label.new(endX, pocY, "Total: " + str.tostring(c_total_vol, format.volume), color=#00000000, textcolor=clusterColor, style=label.style_label_left, size=size.small))

// ====================================================================================================================
// DYNAMIC HEATMAP V3 (BIGBELUGA PORT)
// ====================================================================================================================

var hm_boxes       = array.new<box>()
var hm_labels      = array.new<label>()
var hm_lines       = array.new<line>()
var hm_volume_bins = array.new<float>(hm_bins, 0.)
var hm_pivots      = array.new<hm_pivot>()
var int   export_hm_signal = 0
var float export_hm_vol    = 0.0

if en_hm
    export_hm_signal := 0
    export_hm_vol    := 0.0

    float hm_vol     = math.sum(volume, 10)
    float hm_max_vol = ta.highest(hm_vol, hm_lookBack)
    float hm_nVol    = hm_max_vol > 0 ? (hm_vol / hm_max_vol * 100) : 0
    float hm_atr     = ta.atr(5) / 50
    float hm_offset  = ta.highest(hm_atr * hm_nVol, hm_lookBack)

    float hm_top  = ta.highest(high + hm_offset, hm_lookBack)
    float hm_bot  = ta.lowest (low  - hm_offset, hm_lookBack)
    float hm_step = (hm_top - hm_bot) / hm_resolution
    float level1  = high + hm_atr * hm_nVol
    float level2  = low  - hm_atr * hm_nVol

    float hm_h = ta.highest(high, 2)
    float hm_l = ta.lowest (low,  2)

    if hm_h == high
        for i = 0 to hm_resolution - 1
            float lower = hm_bot + hm_step * i
            float mid   = lower + hm_step / 2
            if math.abs(level1 - mid) <= hm_step
                hm_pivots.push(hm_pivot.new(mid, bar_index, hm_nVol, hm_vol, false))

    if hm_l == low
        for i = 0 to hm_resolution - 1
            float lower = hm_bot + hm_step * i
            float mid   = lower + hm_step / 2
            if math.abs(level2 - mid) <= hm_step
                hm_pivots.push(hm_pivot.new(mid - hm_atr * hm_nVol, bar_index, hm_nVol, hm_vol, true))

    if hm_pivots.size() > 0
        for i = hm_pivots.size() - 1 to 0
            hm_pivot p = hm_pivots.get(i)
            if bar_index - p.index > hm_lookBack
                hm_pivots.remove(i)
                continue
            if p.isLower and low < p.value
                if barstate.isconfirmed and close > p.value
                    export_hm_signal := 1
                    export_hm_vol    := p.vol
                    hm_pivots.remove(i)
            else if not p.isLower and high > p.value
                if barstate.isconfirmed and close < p.value
                    export_hm_signal := -1
                    export_hm_vol    := p.vol
                    hm_pivots.remove(i)

    if barstate.islast
        for ln in hm_lines
            ln.delete()
        for b in hm_boxes
            b.delete()
        for lbl in hm_labels
            lbl.delete()
        hm_lines.clear()
        hm_boxes.clear()
        hm_labels.clear()

        float step_draw = (hm_top - hm_bot) / hm_bins
        for j = 0 to hm_bins - 1
            hm_volume_bins.set(j, 0)

        if hm_pivots.size() > 0
            for i = 0 to hm_pivots.size() - 1
                hm_pivot lvl  = hm_pivots.get(i)
                float    vol_ = lvl.vol
                float    line_y = lvl.value
                for j = 0 to hm_bins - 1
                    float lower = hm_bot + step_draw * j
                    float mid   = lower + step_draw / 2
                    if math.abs(line_y - mid) < step_draw
                        hm_volume_bins.set(j, hm_volume_bins.get(j) + vol_)

        for j = 0 to hm_bins - 1
            float lower  = hm_bot + step_draw * j
            float upper  = lower + step_draw
            float mid    = lower + step_draw / 2
            float voll   = hm_volume_bins.get(j)
            float max_v  = hm_volume_bins.max()
            float valueVol = max_v > 0 ? (voll / max_v * 50) : 0
            color col    = close > mid ? hm_buyColor : hm_sellColor
            color m_col  = color.from_gradient(voll, hm_volume_bins.min(), max_v, color.new(col, 80), color.new(col, 0))
            color m_col1 = color.from_gradient(voll, hm_volume_bins.min(), max_v, color.new(col, 50), color.new(col, 0))

            if not (close < upper and close > lower)
                if hm_displPf and (valueVol != 0)
                    hm_boxes.push(box.new(bar_index + 20, upper, bar_index + 20 + int(valueVol), lower, bgcolor=(voll == max_v and hm_poc) ? hm_maxColor : m_col, border_color=chart.bg_color, text=voll > hm_volume_bins.avg() ? str.tostring(voll, format.volume) : "", text_halign=text.align_left))
                    hm_boxes.push(box.new(bar_index + 20, upper, bar_index + 5, lower, text=str.tostring(valueVol * 2, format.percent), bgcolor=color(na), border_color=color(na), text_color=(voll == max_v) ? hm_maxColor : m_col1))

                int  start_line = 0
                bool isLower_b  = close > mid
                for i = 0 to hm_lookBack - 1
                    if isLower_b
                        if low[i] < mid
                            start_line := bar_index - i
                            break
                        if i == hm_lookBack - 1
                            start_line := bar_index - i
                    else
                        if high[i] > mid
                            start_line := bar_index - i
                            break
                        if i == hm_lookBack - 1
                            start_line := bar_index - i

                color l_col = (voll == max_v and hm_poc) ? hm_maxColor : color.from_gradient(valueVol, 0, 50, color(na), isLower_b ? color.new(hm_buyColor, 30) : color.new(hm_sellColor, 30))
                hm_lines.push(line.new(start_line + 3, mid, bar_index + 5, mid, width=int(valueVol / 5), color=l_col))

// ====================================================================================================================
// LTF TRIPLE CONFIRMATION ENGINE v2
// ====================================================================================================================
// Каждый тир исполняется через request.security в своём TF.
// lookahead_off гарантирует обновление строго при закрытии свечи данного TF.
// Возвращает [conf_bull 0-6, conf_bear 0-6] — число сработавших факторов.

ltf_engine_v2() =>
    float rsi7    = ta.rsi(close, 7)
    float vol_sma = ta.sma(volume, 20)
    // [1] исключает незакрытую текущую свечу данного TF
    float h5 = ta.highest(high, 5)[1]
    float l5 = ta.lowest (low,  5)[1]

    // 1. Micro CHoCH — пробой 5-барового экстремума данного TF
    bool micro_bull = ta.crossover (close, h5)
    bool micro_bear = ta.crossunder(close, l5)

    // 2. Volume Spike с направлением
    bool vol_b = volume > vol_sma * 2.0 and close > open
    bool vol_s = volume > vol_sma * 2.0 and close < open

    // 3. Накопление: ≥ 3 из 5 последних свечей в одну сторону
    int bull_cnt = (close    >open   ?1:0) + (close[1]>open[1]?1:0) + (close[2]>open[2]?1:0) + (close[3]>open[3]?1:0) + (close[4]>open[4]?1:0)
    int bear_cnt = (close    <open   ?1:0) + (close[1]<open[1]?1:0) + (close[2]<open[2]?1:0) + (close[3]<open[3]?1:0) + (close[4]<open[4]?1:0)
    bool acc_bull = bull_cnt >= 3
    bool acc_bear = bear_cnt >= 3

    // 4. RSI — не перекуплен / не перепродан
    bool rsi_b = rsi7 < 65
    bool rsi_s = rsi7 > 35

    // 5. Engulfing — поглощение предыдущей свечи
    bool eng_bull = close > open and close > high[1] and open < close[1]
    bool eng_bear = close < open and close < low[1]  and open > close[1]

    // 6. Сильное тело — тело > 60 % диапазона wick-to-wick
    float body_r  = math.abs(close - open) / math.max(high - low, syminfo.mintick)
    bool strong_b = body_r > 0.6 and close > open
    bool strong_s = body_r > 0.6 and close < open

    int cb = (micro_bull?1:0) + (vol_b?1:0) + (acc_bull?1:0) + (rsi_b?1:0) + (eng_bull?1:0) + (strong_b?1:0)
    int cs = (micro_bear?1:0) + (vol_s?1:0) + (acc_bear?1:0) + (rsi_s?1:0) + (eng_bear?1:0) + (strong_s?1:0)
    [cb, cs]

[ltf1_cb, ltf1_cs] = request.security(syminfo.tickerid, ltf_tv_1, ltf_engine_v2(), lookahead=barmerge.lookahead_off)
[ltf2_cb, ltf2_cs] = request.security(syminfo.tickerid, ltf_tv_2, ltf_engine_v2(), lookahead=barmerge.lookahead_off)
[ltf3_cb, ltf3_cs] = request.security(syminfo.tickerid, ltf_tv_3, ltf_engine_v2(), lookahead=barmerge.lookahead_off)

// ====================================================================================================================
// СИНТЕЗ СИГНАЛОВ P1
// ====================================================================================================================

int   p1_smc_trend = en_smc ? export_ms.trend : 0
int   p1_sd_zone   = en_3  ? (sd_in_demand ? 1 : sd_in_supply ? -1 : 0) : 0

int export_sweep = en_smc and barstate.isconfirmed ? (export_ms.upsweep ? -1 : export_ms.dnsweep ? 1 : 0) : 0

string curr_ms_txt  = export_ms.txt
bool is_new_choch   = en_smc and curr_ms_txt == "choch" and curr_ms_txt[1] != "choch"
int  export_choch   = (is_new_choch and barstate.isconfirmed) ? export_ms.trend : 0

bool is_new_bos     = en_smc and curr_ms_txt == "bos" and curr_ms_txt[1] != "bos"
int  export_bos     = (is_new_bos and barstate.isconfirmed) ? export_ms.trend : 0

float current_atr   = ta.atr(14)

var float export_fvg_top = na
var float export_fvg_bot = na
var int   export_fvg_poc = 0
export_fvg_poc := 0
export_fvg_top := na
export_fvg_bot := na

if en_2 and fvgs.size() > 0
    for f in fvgs
        if (f.isBull and low  <= f.FVG.get_top() and low  >= f.FVG.get_bottom()) or \
           (not f.isBull and high >= f.FVG.get_bottom() and high <= f.FVG.get_top())
            export_fvg_top := f.FVG.get_top()
            export_fvg_bot := f.FVG.get_bottom()
        if not na(f.poc)
            float poc_val   = f.poc.get_y1()
            float tolerance = math.max(math.abs(f.FVG.get_top() - f.FVG.get_bottom()) / fvg_bins, current_atr * 0.1)
            if high >= poc_val - tolerance and low <= poc_val + tolerance
                export_fvg_poc := f.isBull ? 1 : -1

// ── Swing уровни ─────────────────────────────────────────────────────────────
var float swing_high = na
var float swing_low  = na

if en_smc
    bool is_new_struct = curr_ms_txt == "choch" or curr_ms_txt == "bos"
    if p1_smc_trend == 1
        swing_low  := export_ms.choch
        swing_high := na(swing_high) or is_new_struct ? high : math.max(swing_high, high)
    else if p1_smc_trend == -1
        swing_high := export_ms.choch
        swing_low  := na(swing_low) or is_new_struct ? low  : math.min(swing_low, low)

// ── OTE Zone (Optimal Trade Entry: Fibonacci 61.8 %–78.6 %) ─────────────────
float ote_upper  = na
float ote_lower  = na
int   export_ote = 0

if not na(swing_high) and not na(swing_low) and swing_high > swing_low
    float rng = swing_high - swing_low
    if p1_smc_trend == 1
        // В бычьем тренде: зона скидки 61.8–78.6 % от свинга снизу
        ote_upper   := swing_low + rng * 0.382
        ote_lower   := swing_low + rng * 0.214
        export_ote  := (close <= ote_upper and close >= ote_lower) ? 1 : 0
    else if p1_smc_trend == -1
        // В медвежьем тренде: зона премии 61.8–78.6 % от свинга сверху
        ote_lower   := swing_high - rng * 0.382
        ote_upper   := swing_high - rng * 0.214
        export_ote  := (close >= ote_lower and close <= ote_upper) ? -1 : 0

// ── Premium / Discount ───────────────────────────────────────────────────────
int export_pd_zone = 0
if not na(swing_high) and not na(swing_low) and swing_high != swing_low
    float ratio  = (close - swing_low) / (swing_high - swing_low)
    export_pd_zone := ratio > 0.5 ? -1 : ratio < 0.5 ? 1 : 0

// ── Подтверждённые уровни BOS / CHoCH ───────────────────────────────────────
var float confirmed_bos_price   = na
var float confirmed_choch_price = na
if en_smc and export_ms.txt == "bos"
    confirmed_bos_price   := export_ms.zz
if en_smc and export_ms.txt == "choch"
    confirmed_choch_price := export_ms.zz

// ── Institutional AVWAP (якорь — структурное событие) ────────────────────────
bool  anchor_bar      = is_new_choch or is_new_bos
float export_avwap    = ta.vwap(hlc3, anchor_bar)

// ── Fast AVWAP (якорь — структура ИЛИ пробой S&D) ────────────────────────────
bool  anchor_bar_fast    = is_new_choch or is_new_bos or (export_sd_inv != 0)
float export_avwap_fast  = ta.vwap(hlc3, anchor_bar_fast)

// ── Displacement candle с направлением ───────────────────────────────────────
int export_displacement_dir = 0
if math.abs(close - open) > (current_atr * 1.5)
    export_displacement_dir := close > open ? 1 : -1

// ====================================================================================================================
// MASTER SYNTHESIS — объединяет P1 + P2
// Балл 0–16: используется Sniper как входной порог (score ≥ 10 → высокое качество).
// P2 данные взвешены при наличии подключения.
// ====================================================================================================================

int export_conf_bull = 0
export_conf_bull += p1_smc_trend == 1      ? 2 : 0   // SMC бычий тренд (вес 2)
export_conf_bull += sd_in_demand           ? 1 : 0   // В зоне Demand
export_conf_bull += export_ob_state == 1  ? 1 : 0   // Внутри бычьего OB
export_conf_bull += export_ote == 1        ? 1 : 0   // OTE 61.8–78.6 %
export_conf_bull += close > export_avwap   ? 1 : 0   // Выше AVWAP
export_conf_bull += export_hm_signal == 1  ? 1 : 0   // HeatMap Buy Sweep
export_conf_bull += ltf1_cb >= ltf_conf_thresh ? 1 : 0   // LTF1 подтверждён
export_conf_bull += ltf2_cb >= ltf_conf_thresh ? 1 : 0   // LTF2 подтверждён
export_conf_bull += ltf3_cb >= ltf_conf_thresh ? 1 : 0   // LTF3 подтверждён
// P2 (Sniper обратная связь)
export_conf_bull += p2_conn and p2_mtf_bull >= 2 ? 2 : 0     // Sniper MTF 2–3 тира (вес 2)
export_conf_bull += p2_conn and p2_hc_bull  >= 1 ? 1 : 0     // Sniper HC-паттерн активен
export_conf_bull += p2_conn and p2_oscsm_bull >= 2 ? 1 : 0   // Sniper OSC+SM ≥ 2
export_conf_bull += p2_conn and p2_div_bull >= 2  ? 1 : 0    // Sniper Div ≥ 2
export_conf_bull += p2_conn and p2_cndl_bull      ? 1 : 0    // Sniper бычья свеча

int export_conf_bear = 0
export_conf_bear += p1_smc_trend == -1     ? 2 : 0
export_conf_bear += sd_in_supply           ? 1 : 0
export_conf_bear += export_ob_state == -1  ? 1 : 0
export_conf_bear += export_ote == -1       ? 1 : 0
export_conf_bear += close < export_avwap   ? 1 : 0
export_conf_bear += export_hm_signal == -1 ? 1 : 0
export_conf_bear += ltf1_cs >= ltf_conf_thresh ? 1 : 0
export_conf_bear += ltf2_cs >= ltf_conf_thresh ? 1 : 0
export_conf_bear += ltf3_cs >= ltf_conf_thresh ? 1 : 0
export_conf_bear += p2_conn and p2_mtf_bear >= 2  ? 2 : 0
export_conf_bear += p2_conn and p2_hc_bear  >= 1  ? 1 : 0
export_conf_bear += p2_conn and p2_oscsm_bear >= 2 ? 1 : 0
export_conf_bear += p2_conn and p2_div_bear >= 2   ? 1 : 0
export_conf_bear += p2_conn and p2_cndl_bear       ? 1 : 0

// ── Итоговый Master Signal (для Sniper — финальный вход) ─────────────────────
// +1 = бычий консенсус, -1 = медвежий, 0 = нет сигнала
int export_master_signal = 0
if export_conf_bull >= 10 and export_conf_bull > export_conf_bear
    export_master_signal := 1
else if export_conf_bear >= 10 and export_conf_bear > export_conf_bull
    export_master_signal := -1

// ── Sniper-усиление: если P2 даёт финальный сигнал в том же направлении ──────
bool p2_agrees_bull = p2_conn and p2_final_signal == 1  and export_master_signal == 1
bool p2_agrees_bear = p2_conn and p2_final_signal == -1 and export_master_signal == -1

// ====================================================================================================================
// ИНТЕГРАЦИОННЫЕ ПЛОТЫ ДЛЯ SNIPER [P1]
// ====================================================================================================================

// ── Служебные ────────────────────────────────────────────────────────────────
plot(timeframe.in_seconds("") / 60, title="[P1] Chart TF (Mins)",          display=display.none)
plot(9999.0,                         title="[P1] ALIVE_SIGNAL",             display=display.none)

// ── SMC & OB ─────────────────────────────────────────────────────────────────
plot(p1_smc_trend,                   title="[P1] Base: SMC Trend",          display=display.none)
plot(export_ob_state,                title="[P1] Base: OB State",           display=display.none)
plot(export_ob_touch,                title="[P1] Base: OB Touch",           display=display.none)
plot(export_bb_signal,               title="[P1] Base: Breaker Signal",     display=display.none)

// ── HeatMap ───────────────────────────────────────────────────────────────────
plot(export_hm_signal,               title="[P1] Base: HM Sweep",           display=display.none)
plot(export_hm_vol,                  title="[P1] Base: HM Sweep Vol",       display=display.none)

// ── FVG ───────────────────────────────────────────────────────────────────────
plot(export_fvg_poc,                 title="[P1] Base: FVG POC",            display=display.none)
plot(export_fvg_top,                 title="[P1] Base: FVG Top",            display=display.none)
plot(export_fvg_bot,                 title="[P1] Base: FVG Bottom",         display=display.none)

// ── S&D ───────────────────────────────────────────────────────────────────────
plot(p1_sd_zone,                     title="[P1] Base: S&D Zone",           display=display.none)
plot(export_sd_inv,                  title="[P1] Base: S&D Break",          display=display.none)

// ── Структура ─────────────────────────────────────────────────────────────────
plot(export_sweep,                   title="[P1] Base: SMC Sweep",          display=display.none)
plot(export_choch,                   title="[P1] Base: CHoCH",              display=display.none)
plot(export_bos,                     title="[P1] Base: BOS Trigger",        display=display.none)
plot(export_pd_zone,                 title="[P1] Base: Premium/Discount",   display=display.none)
plot(confirmed_bos_price,            title="[P1] Confirmed BOS Level",      display=display.none)
plot(confirmed_choch_price,          title="[P1] Confirmed CHoCH Level",    display=display.none)

// ── AVWAP ─────────────────────────────────────────────────────────────────────
plot(export_avwap,                   title="[P1] Institutional AVWAP",      display=display.none)
plot(export_avwap_fast,              title="[P1] Fast AVWAP",               display=display.none)
plot(export_displacement_dir,        title="[P1] Displacement Candle",      display=display.none)

// ── OB уровни ─────────────────────────────────────────────────────────────────
plot(export_bull_ob_proximal,        title="[P1] Bull OB Proximal",         display=display.none)
plot(export_bear_ob_proximal,        title="[P1] Bear OB Proximal",         display=display.none)

// ── Swing ─────────────────────────────────────────────────────────────────────
plot(swing_high,                     title="[P1] Swing High",               display=display.none)
plot(swing_low,                      title="[P1] Swing Low",                display=display.none)

// ── OTE ───────────────────────────────────────────────────────────────────────
plot(export_ote,                     title="[P1] OTE Zone",                 display=display.none)
plot(ote_upper,                      title="[P1] OTE Upper",                display=display.none)
plot(ote_lower,                      title="[P1] OTE Lower",                display=display.none)

// ── LTF Triple Engine v2 — три тира по-отдельности ───────────────────────────
plot(ltf1_cb,                        title="[P1] LTF1 Confirm Bull",        display=display.none)
plot(ltf1_cs,                        title="[P1] LTF1 Confirm Bear",        display=display.none)
plot(ltf2_cb,                        title="[P1] LTF2 Confirm Bull",        display=display.none)
plot(ltf2_cs,                        title="[P1] LTF2 Confirm Bear",        display=display.none)
plot(ltf3_cb,                        title="[P1] LTF3 Confirm Bull",        display=display.none)
plot(ltf3_cs,                        title="[P1] LTF3 Confirm Bear",        display=display.none)

// ── Master Synthesis (итог P1+P2) ────────────────────────────────────────────
plot(export_conf_bull,               title="[P1] Confluence Bull",          display=display.none)
plot(export_conf_bear,               title="[P1] Confluence Bear",          display=display.none)
plot(export_master_signal,           title="[P1] Master Signal",            display=display.none)
plot(p2_agrees_bull ? 1 : 0,         title="[P1] P2 Agrees Bull",           display=display.none)
plot(p2_agrees_bear ? 1 : 0,         title="[P1] P2 Agrees Bear",           display=display.none)
