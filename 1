                        if math.min(YA1, YB1) >= math.max(YA2, YB2)
                            z1.disabled := true, z2.disabled := true
                            float newTop = math.max(z1.top, z2.top), float newBot = math.min(z1.bottom, z2.bottom)
                            int newStart = math.min(z1.startTime, z2.startTime)
