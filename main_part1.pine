// P2 — РАЗБОР ОБРАТНОЙ СВЯЗИ ОТ SNIPER
// ====================================================================================================================

p2_is_conn(src) => not na(p2_alive_src) and p2_alive_src == 9999.0 and not na(src)

bool  p2_conn          = p2_is_conn(p2_final_src)
int   p2_final_signal  = p2_conn ? int(p2_final_src)      : 0
int   p2_buy_score     = p2_conn ? int(p2_buy_score_src)  : 0
int   p2_sell_score    = p2_conn ? int(p2_sell_score_src) : 0
int   p2_mtf_bull      = p2_conn ? int(p2_mtf_bull_src)   : 0
int   p2_mtf_bear      = p2_conn ? int(p2_mtf_bear_src)   : 0
int   p2_hc_bull       = p2_conn ? int(p2_hc_bull_src)    : 0
int   p2_hc_bear       = p2_conn ? int(p2_hc_bear_src)    : 0
int   p2_oscsm_bull    = p2_conn ? int(p2_oscsm_bull_src) : 0
int   p2_oscsm_bear    = p2_conn ? int(p2_oscsm_bear_src) : 0
int   p2_div_bull      = p2_conn ? int(p2_div_bull_src)   : 0
int   p2_div_bear      = p2_conn ? int(p2_div_bear_src)   : 0
int   p2_regime        = p2_conn ? int(p2_regime_src)     : 0
bool  p2_cndl_bull     = p2_conn and p2_cndl_bull_src == 1
bool  p2_cndl_bear     = p2_conn and p2_cndl_bear_src == 1

// ====================================================================================================================
// FVG GLOBAL DATA REQUESTS (CHARTPRIME)
// ====================================================================================================================

float fvg_time_       = timeframe.in_seconds(fvg_tf1) / 60
float fvg_currentTime = timeframe.in_seconds("") / 60

string fvg_req_tf = fvg_time_ >= fvg_currentTime and not fvg_autoTf ? "" : (fvg_autoTf ? str.tostring(int(fvg_currentTime / 10)) : fvg_tf1)
array<float> fvg_c = request.security_lower_tf(syminfo.tickerid, fvg_req_tf, close)
array<float> fvg_v = request.security_lower_tf(syminfo.tickerid, fvg_req_tf, volume)

float fvg_bearish_gap_size = (low[2] - high)  / math.max(ta.stdev(low[2] - high,  200), 1e-10)
float fvg_bullish_gap_size = (low  - high[2]) / math.max(ta.stdev(low  - high[2], 200), 1e-10)

// ====================================================================================================================
// МЕТОДЫ И ФУНКЦИИ SMC & OB
// ====================================================================================================================

method txSz(string s) =>
    out = switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        "Auto"   => size.auto
    out

method lstyle(string style) => style == "----" ? line.style_dashed : line.style_solid

f_IDMIDX(bool use_max, int loc) =>
    float min = 99999999.
    float max = 0.
    int   idx = 0
    int limit = math.min(bar_index - loc, 200)
    if use_max
        for i = 0 to limit
            max := math.max(high[i], max)
            min := max == high[i] ? low[i]  : min
            idx := max == high[i] ? i       : idx
    else
        for i = 0 to limit
            min := math.min(low[i], min)
            max := min == low[i]  ? high[i] : max
            idx := min == low[i]  ? i       : idx
    idx

f_mapping() =>
    var float          up      = na
    var float          dn      = na
    var float          point   = na
    var int            trend   = 0
    var int            idx     = na
    var int            sum     = na
    var int            project = na
    var chart.point[]  charts  = array.new<chart.point>()

    if na(up)
        up  := high
        idx := bar_index
    if na(dn)
        dn  := low
        idx := bar_index

    if high > up
        if trend == -1
            int id = f_IDMIDX(false, idx)
            charts.unshift(chart.point.from_time(time[id], low[id]))
            idx   := bar_index
            point := low[id]
            sum   := time[id]
        up      := high
        dn      := low
        project := time
        trend   := 1

    if low < dn
        if trend == 1
            int id = f_IDMIDX(true, idx)
            charts.unshift(chart.point.from_time(time[id], high[id]))
            idx   := bar_index
            point := high[id]
            sum   := time[id]
        up      := high
        dn      := low
        project := time
        trend   := -1

    if barstate.islast
        var line     ln = na
        var polyline pl = na
        ln.delete()
        pl.delete()
        ln := line.new(x1=sum, x2=project, y1=point, y2=trend == 1 ? up : dn, xloc=xloc.bar_time, color=color.red)
        pl := polyline.new(charts, line_color=bb_mappingcss, xloc=xloc.bar_time, line_style=bb_mappingStyle.lstyle())

method find(structure ms, bool use_max, bool sweep, bool useob) =>
    float min     = 99999999.
    float max     = 0.
    int   idx     = 0
    int max_bars  = sweep ? bar_index - ms.loc : math.min(bar_index - ms.xloc, 200)

    if not sweep
        if (max_bars - 1) > 0
            if use_max
                for i = 0 to max_bars - 1
                    max := math.max(high[i], max)
                    min := max == high[i] ? low[i]  : min
                    idx := max == high[i] ? i       : idx
                if useob and high[idx + 1] > high[idx]
                    max := high[idx + 1]
                    min := low [idx + 1]
                    idx := idx + 1
            else
                for i = 0 to max_bars - 1
                    min := math.min(low[i], min)
                    max := min == low[i]  ? high[i] : max
                    idx := min == low[i]  ? i       : idx
                if useob and low[idx + 1] < low[idx]
                    max := high[idx + 1]
                    min := low [idx + 1]
                    idx := idx + 1
        else
            if use_max
                for i = 0 to max_bars
                    max := math.max(high[i], max)
                    min := max == high[i] ? low[i]  : min
                    idx := max == high[i] ? i       : idx
                if useob and high[idx + 1] > high[idx]
                    max := high[idx + 1]
                    min := low [idx + 1]
                    idx := idx + 1
            else
                for i = 0 to max_bars
                    min := math.min(low[i], min)
                    max := min == low[i]  ? high[i] : max
                    idx := min == low[i]  ? i       : idx
                if useob and low[idx + 1] < low[idx]
                    max := high[idx + 1]
                    min := low [idx + 1]
                    idx := idx + 1
    else
        int loop_limit = math.min(bar_index - ms.xloc, 200)
        if (loop_limit - 1) > 0
            if use_max
                for i = 0 to loop_limit - 1
                    max := math.max(high[i], max)
                    min := max == high[i] ? low[i]  : min
                    idx := max == high[i] ? i       : idx
                if useob and high[idx + 1] > high[idx]
                    max := high[idx + 1]
                    min := low [idx + 1]
                    idx := idx + 1
            else
                for i = 0 to loop_limit - 1
                    min := math.min(low[i], min)
                    max := min == low[i]  ? high[i] : max
                    idx := min == low[i]  ? i       : idx
                if useob and low[idx + 1] < low[idx]
                    max := high[idx + 1]
                    min := low [idx + 1]
                    idx := idx + 1
        else
            if use_max
                for i = 0 to loop_limit
                    max := math.max(high[i], max)
                    min := max == high[i] ? low[i]  : min
                    idx := max == high[i] ? i       : idx
                if useob and high[idx + 1] > high[idx]
                    max := high[idx + 1]
                    min := low [idx + 1]
                    idx := idx + 1
            else
                for i = 0 to loop_limit
                    min := math.min(low[i], min)
                    max := min == low[i]  ? high[i] : max
                    idx := min == low[i]  ? i       : idx
                if useob and low[idx + 1] < low[idx]
                    max := high[idx + 1]
                    min := low [idx + 1]
                    idx := idx + 1
    idx
