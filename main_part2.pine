// ====================================================================================================================
// МЕТОДЫ OB — fnOB, mitigated, f_overlap, umt, f_display
// ====================================================================================================================

method fnOB(ob[] block, bool bull, float cords, int idx) =>
    switch bull
        true =>
            blobenter.normal  := false
            blobenter.breaker := false
            block.unshift(ob.new(true, cords, low[idx], math.avg(cords, low[idx]), time[idx], bb_obupcs, volume[idx], close[idx] > open[idx] ? 1 : -1, 1, 1, 1, time[idx], time[idx], false, time[idx], 0))
        false =>
            brobenter.normal  := false
            brobenter.breaker := false
            block.unshift(ob.new(false, high[idx], cords, math.avg(cords, high[idx]), time[idx], bb_obdncs, volume[idx], close[idx] > open[idx] ? 1 : -1, 1, 1, 1, time[idx], time[idx], false, time[idx], 0))

method mitigated(ob[] block) =>
    if barstate.isconfirmed and block.size() > 0
        for i = block.size() - 1 to 0
            stuff = block.get(i)
            if not stuff.isbb
                switch stuff.bull
                    true =>
                        if bb_obmiti == "Close" ? math.min(close, open) < stuff.btm : bb_obmiti == "Wick" ? low < stuff.btm : bb_obmiti == "Avg" ? low < stuff.avg : false
                            stuff.isbb := true
                            stuff.bbloc := time
                            if not bb_obshowbb
                                block.remove(i)
                    false =>
                        if bb_obmiti == "Close" ? math.max(close, open) > stuff.top : bb_obmiti == "Wick" ? high > stuff.top : bb_obmiti == "Avg" ? high > stuff.avg : false
                            stuff.isbb := true
                            stuff.bbloc := time
                            if not bb_obshowbb
                                block.remove(i)
            else
                switch stuff.bull
                    true =>
                        if bb_obmiti == "Close" ? math.max(close, open) > stuff.top : bb_obmiti == "Wick" ? high > stuff.top : bb_obmiti == "Avg" ? high > stuff.avg : false
                            block.remove(i)
                    false =>
                        if bb_obmiti == "Close" ? math.min(close, open) < stuff.btm : bb_obmiti == "Wick" ? low < stuff.btm : bb_obmiti == "Avg" ? low < stuff.avg : false
                            block.remove(i)

f_overlap(ob[] bull, ob[] bear) =>
    if bull.size() > 1
        for i = bull.size() - 1 to 1
            stuff   = bull.get(i)
            current = bull.get(0)
            v       = bb_wichlap == "Recent" ? i : 0
            if (stuff.btm > current.btm and stuff.btm < current.top) or (stuff.top < current.top and stuff.btm > current.btm) or (stuff.top > current.top and stuff.btm < current.btm) or (stuff.top < current.top and stuff.top > current.btm)
                bull.remove(v)
    if bear.size() > 1
        for i = bear.size() - 1 to 1
            stuff   = bear.get(i)
            current = bear.get(0)
            v       = bb_wichlap == "Recent" ? i : 0
            if (stuff.btm > current.btm and stuff.btm < current.top) or (stuff.top < current.top and stuff.btm > current.btm) or (stuff.top > current.top and stuff.btm < current.btm) or (stuff.top < current.top and stuff.top > current.btm)
                bear.remove(v)
    if bull.size() > 0 and bear.size() > 0
        for i = bull.size() - 1 to 0
            stuff   = bull.get(i)
            current = bear.get(0)
            v       = bb_wichlap == "Recent" ? 0 : i
            if (stuff.btm > current.btm and stuff.btm < current.top) or (stuff.top < current.top and stuff.btm > current.btm) or (stuff.top > current.top and stuff.btm < current.btm) or (stuff.top < current.top and stuff.top > current.btm)
                bull.remove(v)
    if bull.size() > 0 and bear.size() > 0
        for i = bear.size() - 1 to 0
            stuff   = bear.get(i)
            current = bull.get(0)
            v       = bb_wichlap == "Recent" ? 0 : i
            if (stuff.btm > current.btm and stuff.btm < current.top) or (stuff.top < current.top and stuff.btm > current.btm) or (stuff.top > current.top and stuff.btm < current.btm) or (stuff.top < current.top and stuff.top > current.btm)
                bear.remove(v)

method umt(ob metric) =>
    switch metric.dir
        1 =>
            switch metric.move
                1 => metric.blPOS += 1, metric.move := 2
                2 => metric.blPOS += 1, metric.move := 3
                3 => metric.brPOS += 1, metric.move := 1
        -1 =>
            switch metric.move
                1 => metric.brPOS += 1, metric.move := 2
                2 => metric.brPOS += 1, metric.move := 3
                3 => metric.blPOS += 1, metric.move := 1
    if (time - time[1]) == (time[1] - time[2])
        metric.xlocbl := metric.loc + (time - time[1]) * metric.blPOS
        metric.xlocbr := metric.loc + (time - time[1]) * metric.brPOS

f_display(ob id, ob[] full, int i, float dV_val) =>
    if not id.isbb
        bin.bx.unshift(box.new(top=id.top, bottom=id.btm, left=id.loc, right=time, border_color=na, bgcolor=id.css, xloc=xloc.bar_time))
        bin.bx.unshift(box.new(top=id.top, bottom=id.btm, left=time, right=time + 1, border_color=na, bgcolor=id.css, xloc=xloc.bar_time, extend=extend.right))
    else
        bin.bx.unshift(box.new(top=id.top, bottom=id.btm, left=id.loc, right=id.bbloc, border_color=na, bgcolor=id.css, xloc=xloc.bar_time))
        bin.bx.unshift(box.new(top=id.top, bottom=id.btm, left=id.bbloc, right=time, border_color=id.css, bgcolor=id.bull ? bb_bbup : bb_bbdn, xloc=xloc.bar_time, border_width=2))
        bin.bx.unshift(box.new(top=id.top, bottom=id.btm, left=time, right=time + 1, border_color=id.css, bgcolor=id.bull ? bb_bbup : bb_bbdn, xloc=xloc.bar_time, extend=extend.right))
    if bb_obshowactivity
        bin.bx.unshift(box.new(top=id.top, bottom=id.avg, left=id.loc, right=id.xlocbl, border_color=na, bgcolor=bb_obactup, xloc=xloc.bar_time))
        bin.bx.unshift(box.new(top=id.avg, bottom=id.btm, left=id.loc, right=id.xlocbr, border_color=na, bgcolor=bb_obactdn, xloc=xloc.bar_time))
    if bb_showline
        bin.ln.unshift(line.new(x1=id.loc, x2=time, y1=id.avg, y2=id.avg, color=color.new(id.css, 0), xloc=xloc.bar_time, style=line.style_dashed))
    if bb_showmetric
        bin.lb.unshift(label.new(bar_index - 1, id.avg, textcolor=color.new(id.css, 0), style=label.style_label_left, size=bb_obtxt.txSz(), color=#ffffff00, text=str.tostring(math.round(id.vol, 3), format=format.volume) + " (" + str.tostring(dV_val) + "%)"))

// ====================================================================================================================
// ОСНОВНАЯ ФУНКЦИЯ SMC — f_bb_structure
// ====================================================================================================================

f_bb_structure(color upcss, color dncss, bool draw, bool internal, int limit) =>
    var structure ms     = structure.new(start=0)
    var ob[]      blob   = array.new<ob>()
    var ob[]      bearob = array.new<ob>()
    var drawms[]  bldw   = array.new<drawms>()
    var drawms[]  brdw   = array.new<drawms>()
    bool crossup = false
    bool crossdn = false
    var float up = na
    var float dn = na

    int idbull = ms.find(false, false, true)
    int idbear = ms.find(true,  false, true)

    float btmP = bb_obmode == "Length" ? (high[idbear] - 1 * bb_atr[idbear]) < low[idbear] ? low[idbear] : (high[idbear] - 1 * bb_atr[idbear]) : low[idbear]
    float topP = bb_obmode == "Length" ? (low[idbull]  + 1 * bb_atr[idbull]) > high[idbull] ? high[idbull] : (low[idbull]  + 1 * bb_atr[idbull]) : high[idbull]

    float ph = ta.pivothigh(high, bb_mslen, bb_mslen)
    float pl = ta.pivotlow (low,  bb_mslen, bb_mslen)
    var int[]   phn = array.new<int>(1,   na)
    var int[]   pln = array.new<int>(1,   na)
    var float[] php = array.new<float>(1, na)
    var float[] plp = array.new<float>(1, na)

    if internal
        blob.clear()
        bearob.clear()

    if not na(ph)
        phn.unshift(bar_index[bb_mslen])
        php.unshift(high[bb_mslen])
    if not na(pl)
        pln.unshift(bar_index[bb_mslen])
        plp.unshift(low[bb_mslen])

    if php.size() > 0 and high > php.get(0)
        php.clear()
        phn.clear()
    if plp.size() > 0 and low < plp.get(0)
        plp.clear()
        pln.clear()

    if na(up)
        up := high
    if na(dn)
        dn := low

    if high > up
        up := high, dn := low, crossup := true
    if low  < dn
        up := high, dn := low, crossdn := true

    // ─── Инициализация структуры ───────────────────────────────────────────
    if ms.start == 0
        ms := structure.new(bar_index, na, high, low, bar_index, bar_index, 0, 1, na, bar_index)
        if draw
            bldw.unshift(drawms.new(time, time, high, "CHoCH", upcss, line.style_dashed))
            brdw.unshift(drawms.new(time, time, low,  "CHoCH", dncss, line.style_dashed))

    ms.upsweep := false
    ms.dnsweep := false

    // ─── Фаза 1: первичный поиск структуры ────────────────────────────────
    if ms.start == 1
        switch
            low <= ms.choch and close >= ms.choch and bb_buildsweep =>
                ms.dnsweep := true
                ms.choch   := low
                ms.xloc    := bar_index
                if draw
                    drawms temp_brdw_sweep1 = brdw.get(0)
                    temp_brdw_sweep1.x2    := time
                    temp_brdw_sweep1.style := line.style_dotted
                    temp_brdw_sweep1.txt   := "x"
                    brdw.unshift(drawms.new(time, time, low, "CHoCH", dncss, line.style_dashed))

            high >= ms.bos and close <= ms.bos and bb_buildsweep =>
                ms.upsweep := true
                ms.bos     := high
                ms.xloc    := bar_index
                if draw
                    drawms temp_bldw_sweep1 = bldw.get(0)
                    temp_bldw_sweep1.x2    := time
                    temp_bldw_sweep1.style := line.style_dotted
                    temp_bldw_sweep1.txt   := "x"
                    bldw.unshift(drawms.new(time, time, high, "CHoCH", upcss, line.style_dashed))

            close <= ms.choch =>
                ms.txt   := "choch"
                lc.start := true
                lc.count := 0
                blob.fnOB(true, topP, idbull)
                ms.trend := -1
                ms.choch := ms.bos
                ms.bos   := na
                ms.start := 2
                ms.loc   := bar_index
                ms.main  := low
                ms.temp  := ms.loc
                ms.xloc  := bar_index
                if draw
                    drawms temp_brdw_start = brdw.get(0)
                    temp_brdw_start.x2    := time
                    temp_brdw_start.style := internal ? line.style_dashed : line.style_solid

            close >= ms.bos =>
                ms.txt   := "choch"
                lc.start := true
                lc.count := 0
                bearob.fnOB(false, btmP, idbear)
                ms.trend := 1
                ms.choch := ms.choch
                ms.bos   := na
                ms.start := 2
                ms.loc   := bar_index
                ms.main  := high
                ms.temp  := ms.loc
                ms.xloc  := bar_index
                if draw
                    drawms temp_bldw_start = bldw.get(0)
                    temp_bldw_start.x2    := time
                    temp_bldw_start.style := internal ? line.style_dashed : line.style_solid

    // ─── Фаза 2: отслеживание структуры ───────────────────────────────────
    if ms.start == 2
        switch ms.trend
            -1 =>
                if low <= ms.main
                    ms.main := low
                    ms.temp := bar_index

                if not na(ms.bos) and bb_msmode == "Adjusted Points" and php.size() > 0
                    if php.get(0) < ms.choch
                        ms.choch := php.get(0)
                        ms.loc   := phn.get(0)
                        ms.xloc  := phn.get(0)
                        ms.temp  := phn.get(0)
                        if draw
                            drawms temp_bldw_adj = bldw.get(0)
                            temp_bldw_adj.x1 := time[bar_index - phn.get(0)]
                            temp_bldw_adj.x2 := time
                            temp_bldw_adj.y  := php.get(0)

                if na(ms.bos) and crossup and close > open and close[1] > open[1]
                    ms.bos  := ms.main
                    ms.loc  := ms.temp
                    ms.xloc := ms.loc
                    if draw
                        brdw.unshift(drawms.new(time[bar_index - ms.loc], time, low[bar_index - ms.loc], "BOS", dncss, line.style_dashed))

                if not na(ms.bos) and draw
                    drawms temp_brdw_1 = brdw.get(0)
                    temp_brdw_1.x2 := time
                if draw
                    drawms temp_bldw_1 = bldw.get(0)
                    temp_bldw_1.x2 := time

                switch
                    low <= ms.bos and close >= ms.bos and not na(ms.bos) and bb_buildsweep =>
                        ms.dnsweep := true
                        ms.bos     := low
                        ms.xloc    := bar_index
                        if draw
                            drawms temp_brdw_sweep2 = brdw.get(0)
                            temp_brdw_sweep2.x2    := time
                            temp_brdw_sweep2.style := line.style_dotted
                            temp_brdw_sweep2.txt   := "x"
                            brdw.unshift(drawms.new(time, time, low, "BOS", dncss, line.style_dashed))

                    close <= ms.bos and not na(ms.bos) =>
                        ms.txt  := "bos"
                        ms.zz   := ms.bos
                        ms.zn   := bar_index
                        lc.start := true
                        lc.count := 0
                        bearob.fnOB(false, btmP, idbear)
                        int id   = ms.find(true, false, false)
                        ms.xloc  := bar_index
                        ms.bos   := na
                        ms.choch := high[id]
                        ms.loc   := bar_index[id]
                        if draw
                            drawms temp_brdw_bos = brdw.get(0)
                            temp_brdw_bos.x2    := time
                            temp_brdw_bos.style := internal ? line.style_dashed : line.style_solid
                            drawms temp_bldw_bos = bldw.get(0)
                            temp_bldw_bos.x1 := time[id]
                            temp_bldw_bos.x2 := time
                            temp_bldw_bos.y  := high[id]

                    high >= ms.choch and close <= ms.choch and bb_buildsweep =>
                        ms.upsweep := true
                        ms.choch   := high
                        ms.xloc    := bar_index
                        if draw
                            drawms temp_bldw_sweep2 = bldw.get(0)
                            temp_bldw_sweep2.x2    := time
                            temp_bldw_sweep2.style := line.style_dotted
                            temp_bldw_sweep2.txt   := "x"
                            bldw.unshift(drawms.new(time, time, high, "CHoCH", upcss, line.style_dashed))

                    close >= ms.choch =>
                        ms.txt  := "choch"
                        ms.zz   := ms.choch
                        ms.zn   := bar_index
                        lc.start := true
                        lc.count := 0
                        blob.fnOB(true, topP, idbull)
                        int id = ms.find(false, false, false)
                        if na(ms.bos)
                            ms.choch := low[id]
                            if draw
                                brdw.unshift(drawms.new(time, time, low, "BOS", dncss, line.style_dashed))
                                drawms temp_brdw_2 = brdw.get(0)
                                temp_brdw_2.x1 := time[bar_index - ms.temp]
                        else
                            ms.choch := ms.bos
                        ms.bos   := na
                        ms.main  := high
                        ms.trend := 1
                        ms.loc   := bar_index
                        ms.xloc  := bar_index
                        ms.temp  := ms.loc
                        if draw
                            drawms temp_bldw_choch = bldw.get(0)
                            temp_bldw_choch.x2    := time
                            temp_bldw_choch.txt   := "CHoCH"
                            temp_bldw_choch.style := internal ? line.style_dashed : line.style_solid
                            drawms temp_brdw_choch = brdw.get(0)
                            temp_brdw_choch.x2  := time
                            temp_brdw_choch.y   := ms.choch
                            temp_brdw_choch.txt := "CHoCH"
                        ms.xloc       := bar_index
                        blarea.normal := false

            1 =>
                if high >= ms.main
                    ms.main := high
                    ms.temp := bar_index

                if na(ms.bos) and crossdn and close < open and close[1] < open[1]
                    ms.bos  := ms.main
                    ms.loc  := ms.temp
                    ms.xloc := ms.loc
                    if draw
                        bldw.unshift(drawms.new(time[bar_index - ms.loc], time, high[bar_index - ms.loc], "BOS", upcss, line.style_dashed))

                if not na(ms.bos) and bb_msmode == "Adjusted Points" and plp.size() > 0
                    if plp.get(0) > ms.choch
                        ms.choch := plp.get(0)
                        ms.loc   := pln.get(0)
                        ms.xloc  := pln.get(0)
                        ms.temp  := pln.get(0)
                        if draw
                            drawms temp_brdw_adj = brdw.get(0)
                            temp_brdw_adj.x1 := time[bar_index - pln.get(0)]
                            temp_brdw_adj.x2 := time
                            temp_brdw_adj.y  := plp.get(0)

                if not na(ms.bos) and draw
                    drawms temp_bldw_3 = bldw.get(0)
                    temp_bldw_3.x2 := time
                if draw
                    drawms temp_brdw_3 = brdw.get(0)
                    temp_brdw_3.x2 := time

                switch
                    high >= ms.bos and close <= ms.bos and not na(ms.bos) and bb_buildsweep =>
                        ms.upsweep := true
                        ms.bos     := high
                        ms.xloc    := bar_index
                        if draw
                            drawms temp_bldw_sweep3 = bldw.get(0)
                            temp_bldw_sweep3.x2    := time
                            temp_bldw_sweep3.style := line.style_dotted
                            temp_bldw_sweep3.txt   := "x"
                            bldw.unshift(drawms.new(time, time, high, "BOS", upcss, line.style_dashed))

                    close >= ms.bos and not na(ms.bos) =>
                        ms.txt  := "bos"
                        ms.zz   := ms.bos
                        ms.zn   := bar_index
                        lc.start := true
                        lc.count := 0
                        blob.fnOB(true, topP, idbull)
                        int id   = ms.find(false, false, false)
                        ms.xloc  := bar_index
                        ms.bos   := na
                        ms.choch := low[id]
                        ms.loc   := bar_index[id]
                        if draw
                            drawms temp_bldw_bos2 = bldw.get(0)
                            temp_bldw_bos2.x2    := time
                            temp_bldw_bos2.style := internal ? line.style_dashed : line.style_solid
                            drawms temp_brdw_bos2 = brdw.get(0)
                            temp_brdw_bos2.x1 := time[id]
                            temp_brdw_bos2.x2 := time
                            temp_brdw_bos2.y  := low[id]

                    low <= ms.choch and close >= ms.choch and bb_buildsweep =>
                        ms.dnsweep := true
                        ms.choch   := low
                        ms.xloc    := bar_index
                        if draw
                            drawms temp_brdw_sweep3 = brdw.get(0)
                            temp_brdw_sweep3.x2    := time
                            temp_brdw_sweep3.style := line.style_dotted
                            temp_brdw_sweep3.txt   := "x"
                            brdw.unshift(drawms.new(time, time, low, "CHoCH", dncss, line.style_dashed))

                    close <= ms.choch =>
                        ms.txt  := "choch"
                        ms.zz   := ms.choch
                        ms.zn   := bar_index
                        lc.start := true
                        lc.count := 0
                        bearob.fnOB(false, btmP, idbear)
                        int id = ms.find(true, false, false)
                        if na(ms.bos)
                            ms.choch := high[id]
                            if draw
                                bldw.unshift(drawms.new(time, time, high, "BOS", upcss, line.style_dashed))
                                drawms temp_bldw_4 = bldw.get(0)
                                temp_bldw_4.x1 := time[bar_index - ms.temp]
                        else
                            ms.choch := ms.bos
                        ms.bos   := na
                        ms.main  := low
                        ms.trend := -1
                        ms.loc   := bar_index
                        ms.temp  := ms.loc
                        if draw
                            drawms temp_brdw_choch2 = brdw.get(0)
                            temp_brdw_choch2.x2    := time
                            temp_brdw_choch2.txt   := "CHoCH"
                            temp_brdw_choch2.style := internal ? line.style_dashed : line.style_solid
                            drawms temp_bldw_choch2 = bldw.get(0)
                            temp_bldw_choch2.y   := ms.choch
                            temp_bldw_choch2.x2  := time
                            temp_bldw_choch2.txt := "CHoCH"
                        ms.xloc := bar_index

    // ─── Детекция входа в OB ───────────────────────────────────────────────
    if blob.size() > 0 and not blob.get(0).isbb and low < blob.get(0).top
        blobenter.normal := true
    else if blob.size() > 0 and blob.get(0).isbb and high > blob.get(0).btm
        blobenter.breaker := true

    if bearob.size() > 0 and not bearob.get(0).isbb and high > bearob.get(0).btm
        brobenter.normal := true
    else if bearob.size() > 0 and bearob.get(0).isbb and low < bearob.get(0).top
        brobenter.breaker := true

    // ─── Митигация и overlap ───────────────────────────────────────────────
    if bb_obshow
        if barstate.isconfirmed
            blob.mitigated()
            bearob.mitigated()
            if bb_overlap
                f_overlap(blob, bearob)

        if blob.size() > 0
            for metric in blob
                metric.umt()
        if bearob.size() > 0
            for metric in bearob
                metric.umt()

        if barstate.islast
            float tV_bull = 0.0
            float tV_bear = 0.0
            for obj in blob
                tV_bull += obj.vol
            for obj in bearob
                tV_bear += obj.vol

            if blob.size() > 0
                for i = 0 to blob.size() - 1
                    ob item      = blob.get(i)
                    float dV_val = math.floor((item.vol / math.max(1, tV_bull)) * 100)
                    f_display(item, blob, i, dV_val)

            if bearob.size() > 0
                for i = 0 to bearob.size() - 1
                    ob item      = bearob.get(i)
                    float dV_val = math.floor((item.vol / math.max(1, tV_bear)) * 100)
                    f_display(item, bearob, i, dV_val)

    // ─── Отрисовка структуры ───────────────────────────────────────────────
    if barstate.islast and draw and bldw.size() > 0 and brdw.size() > 0
        for i = 0 to bldw.size() - 1
            obj = bldw.get(i)
            if i <= limit
                bin.ln.unshift(line.new(x1=obj.x1, x2=obj.x2, y1=obj.y, y2=obj.y, color=obj.css, style=obj.style, xloc=xloc.bar_time))
                bin.lb.unshift(label.new(x=int(math.avg(bin.ln.get(0).get_x1(), bin.ln.get(0).get_x2())), y=obj.y, xloc=xloc.bar_time, color=invcol, style=label.style_label_down, textcolor=obj.css, size=bb_mstext.txSz(), text=obj.txt))
                if bb_msbubble
                    bin.lb.unshift(label.new(x=obj.x1, y=obj.y, xloc=xloc.bar_time, color=color.new(obj.css, 80), style=label.style_circle, size=size.tiny))
        for i = 0 to brdw.size() - 1
            obj = brdw.get(i)
            if i <= limit
                bin.ln.unshift(line.new(x1=obj.x1, x2=obj.x2, y1=obj.y, y2=obj.y, color=obj.css, style=obj.style, xloc=xloc.bar_time))
                bin.lb.unshift(label.new(x=int(math.avg(bin.ln.get(0).get_x1(), bin.ln.get(0).get_x2())), y=obj.y, xloc=xloc.bar_time, color=invcol, style=label.style_label_up, textcolor=obj.css, size=bb_mstext.txSz(), text=obj.txt))
                if bb_msbubble
                    bin.lb.unshift(label.new(x=obj.x1, y=obj.y, xloc=xloc.bar_time, color=color.new(obj.css, 80), style=label.style_circle, size=size.tiny))

    // ─── Сигналы OB для экспорта ───────────────────────────────────────────
    int current_ob_signal = 0
    int current_ob_touch  = 0
    int current_bb_signal = 0

    if blob.size() > 0
        for i = 0 to blob.size() - 1
            ob obb = blob.get(i)
            if not obb.isbb and close <= obb.top and close >= obb.btm
                current_ob_signal := 1
                if obb.touches == 0
                    current_ob_touch := 1
                obb.touches += 1
            if obb.isbb and close <= obb.top and close >= obb.btm
                current_bb_signal := 1

    if bearob.size() > 0
        for i = 0 to bearob.size() - 1
            ob obb = bearob.get(i)
            if not obb.isbb and close <= obb.top and close >= obb.btm
                current_ob_signal := -1
                if obb.touches == 0
                    current_ob_touch := -1
                obb.touches += 1
            if obb.isbb and close <= obb.top and close >= obb.btm
                current_bb_signal := -1

    // ─── Ближайшие OB уровни для Sniper ───────────────────────────────────
    float bull_prox = na
    float bear_prox = na
    if blob.size() > 0
        for i = 0 to blob.size() - 1
            ob item = blob.get(i)
            if not item.isbb and close > item.btm
                bull_prox := item.btm
                break
    if bearob.size() > 0
        for i = 0 to bearob.size() - 1
            ob item = bearob.get(i)
            if not item.isbb and close < item.top
                bear_prox := item.top
                break

    [ms, current_ob_signal, current_ob_touch, current_bb_signal, bull_prox, bear_prox]

// ====================================================================================================================
// ИСПОЛНЕНИЕ SMC
// ====================================================================================================================

var structure export_ms              = structure.new(start=0)
var int       export_ob_state        = 0
var int       export_ob_touch        = 0
var int       export_bb_signal       = 0
var float     export_bull_ob_proximal = na
var float     export_bear_ob_proximal = na

if en_smc
    [tmp_ms, tmp_ob_state, tmp_ob_touch, tmp_bb, b_prox, br_prox] = f_bb_structure(bb_smc_up_col, bb_smc_dn_col, true, false, bb_swingLimit)
    export_ms               := tmp_ms
    export_ob_state         := tmp_ob_state
    export_ob_touch         := tmp_ob_touch
    export_bb_signal        := tmp_bb
    export_bull_ob_proximal := b_prox
    export_bear_ob_proximal := br_prox
    if bb_showMapping
        f_mapping()
else
    [tmp_ms, tmp_ob_state, tmp_ob_touch, tmp_bb, b_prox, br_prox] = f_bb_structure(bb_smc_up_col, bb_smc_dn_col, false, false, bb_swingLimit)
    export_ms               := tmp_ms
    export_ob_state         := tmp_ob_state
    export_ob_touch         := tmp_ob_touch
    export_bb_signal        := tmp_bb
    export_bull_ob_proximal := b_prox
    export_bear_ob_proximal := br_prox
