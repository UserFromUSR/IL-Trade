////////////////////////////////////////////////////////////////////
// БЕЗГРАНИЧНЫЙ ИИ-ДВИЖОК «OMEGA AUTONOMY» ДЛЯ 1С 7.7
// Самообучение, Предварительный анализ, Интерактивный контроль
////////////////////////////////////////////////////////////////////

Перем ПС;              
Перем JS;              
Перем ИмяМодели;       
Перем ПутьКНастройкам; 
Перем ПутьКБазеЗнаний; 
Перем ОдобренныйКод;

////////////////////////////////////////////////////////////////////
// ИНИЦИАЛИЗАЦИЯ СИСТЕМЫ И ПРАВИЛ ПОВЕДЕНИЯ ИИ
////////////////////////////////////////////////////////////////////
Процедура ПриОткрытии()
    ПС = Символ(13) + Символ(10);
    ПутьКНастройкам = КаталогИБ() + "claude_omega_11.txt";
    ПутьКБазеЗнаний = КаталогИБ() + "ai_knowledge_base.txt";
    ИмяМодели = "claude-3-5-sonnet-20241022"; 
    ОдобренныйКод = "";
    
    СистемныйПромпт = 
        "Ты — высший автономный ИИ-Архитектор 1С 7.7 с функцией самообучения. " +
        "Твоя цель: безопасно выполнять задачи, запоминать успешные решения и обучаться. " +
        "ТВОЙ СТРОГИЙ ЖИЗНЕННЫЙ ЦИКЛ (Выполняй шаги последовательно): " +
        "ФАЗА 1 (ПОИСК): Сначала вызови '1С_Поиск_В_Базе_Знаний', чтобы узнать, решал ли ты подобное ранее. " +
        "ФАЗА 2 (ИССЛЕДОВАНИЕ): Если не знаешь структуру базы, используй '1С_Анализ_Метаданных'. " +
        "ФАЗА 3 (УТОЧНЕНИЕ): Прежде чем писать код, ОБЯЗАТЕЛЬНО задай уточняющие вопросы пользователю через '1С_Уточнить_У_Пользователя', чтобы выяснить нюансы задачи. " +
        "ФАЗА 4 (СОГЛАСОВАНИЕ): Напиши код и передай его в '1С_Предложить_И_Объяснить_Код'. Ты ДОЛЖЕН передать понятное текстовое описание того, что код сделает. Инструмент сам спросит пользователя. " +
        "ФАЗА 5 (ВЫПОЛНЕНИЕ): Если пользователь утвердил код, вызови '1С_Выполнить_Одобренный_Код'. Если отклонил — вернись на шаг Уточнения. " +
        "ФАЗА 6 (ОЦЕНКА И ОБУЧЕНИЕ): После выполнения спроси пользователя через '1С_Уточнить_У_Пользователя', доволен ли он результатом. Если 'Да' — вызови '1С_Сохранить_В_Базу_Знаний', чтобы навсегда запомнить этот код для будущих задач. " +
        "Пиши чистый код 1С 7.7 (СоздатьОбъект, НайтиПоНаименованию и т.д.). Обязательно комментируй свой код.";

    Попытка
        html = СоздатьОбъект("htmlfile");
        html.write("<script>" +
                   "var conversationHistory = [];" +
                   "function clearHistory() { conversationHistory = []; }" +
                   "function addMessage(role, content) { conversationHistory.push({'role': role, 'content': content}); }" +
                   "function addToolResult(toolCallId, resultText) { conversationHistory.push({ 'role': 'user', 'content': [{ 'type': 'tool_result', 'tool_use_id': toolCallId, 'content': resultText }] }); }" +
                   "function addAssistantToolCall(contentObj) { conversationHistory.push({'role': 'assistant', 'content': contentObj}); }" +
                   "function getHistoryJSON() { return JSON.stringify(conversationHistory); }" +
                   "function parseJSON(str) { return eval('(' + str + ')'); }" +
                   "function getProp(obj, prop) { return obj[prop]; }" +
                   "function getLength(arr) { return arr.length; }" +
                   "function getElement(arr, idx) { return arr[idx]; }" +
                   "</script>");
        JS = html.parentWindow;
    Исключение Предупреждение("Критическая ошибка инициализации парсера JSON!"); Возврат; КонецПопытки;

    Попытка Т = СоздатьОбъект("Текст"); Т.Открыть(ПутьКНастройкам); Если Т.КоличествоСтрок() >= 1 Тогда АПИКлюч = СокрЛП(Т.ПолучитьСтроку(1)); КонецЕсли; Исключение КонецПопытки;
    ИсторияЧата = "🧠 СИСТЕМА САМООБУЧЕНИЯ АКТИВИРОВАНА. ИИ готов к циклу: Уточнение -> Код -> Согласование -> Выполнение -> Оценка -> Сохранение в Базу Знаний.";
КонецПроцедуры

////////////////////////////////////////////////////////////////////
// СЕТЕВОЙ ОБМЕН И UTF-8
////////////////////////////////////////////////////////////////////
Функция СтрокаВUTF8(Стр)
    Попытка Поток = СоздатьОбъект("ADODB.Stream"); Поток.Type = 2; Поток.Charset = "UTF-8"; Поток.Open(); Поток.WriteText(Стр); Поток.Position = 0; Поток.Type = 1; Поток.Position = 3; Данные = Поток.Read(); Поток.Close(); Возврат Данные; Исключение Возврат Стр; КонецПопытки;
КонецФункции

Функция UTF8ВСтроку(БинарныеДанные)
    Попытка Поток = СоздатьОбъект("ADODB.Stream"); Поток.Type = 1; Поток.Open(); Поток.Write(БинарныеДанные); Поток.Position = 0; Поток.Type = 2; Поток.Charset = "UTF-8"; Текст = Поток.ReadText(); Поток.Close(); Возврат Текст; Исключение Возврат ""; КонецПопытки;
КонецФункции

////////////////////////////////////////////////////////////////////
// СХЕМЫ ИНСТРУМЕНТОВ (Включая память и согласование)
////////////////////////////////////////////////////////////////////
Функция ПостроитьТелоЗапросаJSON()
    СхемыИнструментов = 
    "[" +
    "  {""name"": ""1С_Поиск_В_Базе_Знаний"", ""description"": ""Читает локальную память ИИ для поиска ранее успешно решенных задач."", ""input_schema"": {""type"": ""object"", ""properties"": {}} }," +
    "  {""name"": ""1С_Анализ_Метаданных"", ""description"": ""Узнает реквизиты. КлассОбъекта (Справочник/Документ), ИмяОбъекта (Номенклатура и др)."", ""input_schema"": {""type"": ""object"", ""properties"": {""КлассОбъекта"": {""type"": ""string""}, ""ИмяОбъекта"": {""type"": ""string""}}, ""required"": [""КлассОбъекта"", ""ИмяОбъекта""]} }," +
    "  {""name"": ""1С_Уточнить_У_Пользователя"", ""description"": ""Задает вопрос пользователю перед написанием кода или для оценки результата."", ""input_schema"": {""type"": ""object"", ""properties"": {""ТекстВопроса"": {""type"": ""string""}}, ""required"": [""ТекстВопроса""]} }," +
    "  {""name"": ""1С_Предложить_И_Объяснить_Код"", ""description"": ""Показывает пользователю объяснение и код. Запрашивает разрешение на запуск."", ""input_schema"": {""type"": ""object"", ""properties"": {""ПонятноеОписание"": {""type"": ""string""}, ""Код1С"": {""type"": ""string""}}, ""required"": [""ПонятноеОписание"", ""Код1С""]} }," +
    "  {""name"": ""1С_Выполнить_Одобренный_Код"", ""description"": ""Запускает код, который был утвержден на предыдущем шаге."", ""input_schema"": {""type"": ""object"", ""properties"": {}} }," +
    "  {""name"": ""1С_Сохранить_В_Базу_Знаний"", ""description"": ""Сохраняет успешный алгоритм в память."", ""input_schema"": {""type"": ""object"", ""properties"": {""ОписаниеЗадачи"": {""type"": ""string""}, ""УспешныйКод"": {""type"": ""string""}}, ""required"": [""ОписаниеЗадачи"", ""УспешныйКод""]} }" +
    "]";

    Возврат "{""model"": """ + ИмяМодели + """, ""max_tokens"": 4096, ""system"": " + JS.parseJSON("JSON.stringify('" + СистемныйПромпт + "')") + ", ""tools"": " + СхемыИнструментов + ", ""messages"": " + JS.getHistoryJSON() + "}";
КонецФункции

////////////////////////////////////////////////////////////////////
// ФИЗИЧЕСКОЕ ИСПОЛНЕНИЕ ИНСТРУМЕНТОВ В 1С
////////////////////////////////////////////////////////////////////
Функция ВыполнитьИнструментВ1С(ИмяИнструмента, Аргументы)
    
    Если ИмяИнструмента = "1С_Поиск_В_Базе_Знаний" Тогда
        Попытка
            Т = СоздатьОбъект("Текст"); Т.Открыть(ПутьКБазеЗнаний);
            Если Т.КоличествоСтрок() = 0 Тогда Возврат "База знаний пуста."; КонецЕсли;
            ТекстБЗ = ""; Для й = 1 По Т.КоличествоСтрок() Цикл ТекстБЗ = ТекстБЗ + Т.ПолучитьСтроку(й) + ПС; КонецЦикла;
            Возврат "Содержимое памяти:" + ПС + ТекстБЗ;
        Исключение Возврат "База знаний пока не создана или пуста."; КонецПопытки;

    ИначеЕсли ИмяИнструмента = "1С_Анализ_Метаданных" Тогда
        Класс = JS.getProp(Аргументы, "КлассОбъекта"); ИмяОб = JS.getProp(Аргументы, "ИмяОбъекта");
        Структура = "Реквизиты [" + Класс + "." + ИмяОб + "]: ";
        Попытка
            Если ВРег(Класс) = "СПРАВОЧНИК" Тогда МД = Метаданные.Справочник(ИмяОб); ИначеЕсли ВРег(Класс) = "РЕГИСТР" Тогда МД = Метаданные.Регистр(ИмяОб); Иначе МД = Метаданные.Документ(ИмяОб); КонецЕсли;
            Для к = 1 По МД.Реквизит() Цикл Структура = Структура + МД.Реквизит(к).Идентификатор + ", "; КонецЦикла;
            Если ВРег(Класс) = "ДОКУМЕНТ" Тогда
                Структура = Структура + " | ТабЧасть: ";
                Для к = 1 По МД.РеквизитТабличнойЧасти() Цикл Структура = Структура + МД.РеквизитТабличнойЧасти(к).Идентификатор + ", "; КонецЦикла;
            КонецЕсли; Возврат Структура;
        Исключение Возврат "Ошибка метаданных."; КонецПопытки;

    ИначеЕсли ИмяИнструмента = "1С_Уточнить_У_Пользователя" Тогда
        ВопросКПользователю = JS.getProp(Аргументы, "ТекстВопроса");
        ОтветПользователя = "";
        Если ВвестиСтроку(ОтветПользователя, "ИИ спрашивает: " + ВопросКПользователю, 250, 0, 0) = 1 Тогда
            Возврат "Ответ пользователя: " + ОтветПользователя;
        Иначе
            Возврат "Пользователь прервал диалог ввода.";
        КонецЕсли;

    ИначеЕсли ИмяИнструмента = "1С_Предложить_И_Объяснить_Код" Тогда
        Описание = JS.getProp(Аргументы, "ПонятноеОписание");
        ПредложенныйКод = JS.getProp(Аргументы, "Код1С");
        
        ДиалогСогласования = "⚠️ ИИ предлагает решение!" + ПС + 
                             "ЧТО БУДЕТ СДЕЛАНО:" + ПС + Описание + ПС + 
                             "--------------------------------" + ПС + 
                             "ПРОГРАММНЫЙ КОД:" + ПС + ПредложенныйКод + ПС + 
                             "--------------------------------" + ПС + 
                             "Утверждаете данный алгоритм?";
                             
        Ответ = Вопрос(ДиалогСогласования, "Да+Нет", 0);
        Если Ответ = "Да" Тогда
            ОдобренныйКод = ПредложенныйКод; // Запоминаем код глобально
            Возврат "УСПЕХ: Пользователь полностью утвердил код. Вызывай инструмент '1С_Выполнить_Одобренный_Код'.";
        Иначе
            ОдобренныйКод = "";
            Возврат "ОТКЛОНЕНО: Пользователь отказался. Запроси уточнения через '1С_Уточнить_У_Пользователя'.";
        КонецЕсли;

    ИначеЕсли ИмяИнструмента = "1С_Выполнить_Одобренный_Код" Тогда
        Если СокрЛП(ОдобренныйКод) = "" Тогда Возврат "Ошибка: Нет утвержденного кода для выполнения!"; КонецЕсли;
        ПутьКФайлу = КаталогИБ() + "AiRuntimeExt.ert";
        Попытка
            ТекстКода = СоздатьОбъект("Текст");
            ТекстКода.ДобавитьСтроку("Процедура ПриОткрытии()");
            ТекстКода.ДобавитьСтроку("Попытка");
            ТекстКода.ДобавитьСтроку(ОдобренныйКод);
            ТекстКода.ДобавитьСтроку("Исключение Сообщить(""Ошибка Runtime: "" + ОписаниеОшибки()); КонецПопытки;");
            ТекстКода.ДобавитьСтроку("СтатусВозврата(0);"); 
            ТекстКода.ДобавитьСтроку("КонецПроцедуры");
            ТекстКода.Записать(ПутьКФайлу);
        Исключение Возврат "Ошибка сохранения файла Runtime."; КонецПопытки;
        
        Попытка
            ОткрытьФорму("Отчет", , ПутьКФайлу);
            ОдобренныйКод = ""; // Очищаем после выполнения
            Возврат "Код физически выполнен! Переходи к фазе оценки (спроси пользователя о результате).";
        Исключение
            Возврат "Сбой при выполнении платформой 1С: " + ОписаниеОшибки();
        КонецПопытки;

    ИначеЕсли ИмяИнструмента = "1С_Сохранить_В_Базу_Знаний" Тогда
        ОписаниеЗадачи = JS.getProp(Аргументы, "ОписаниеЗадачи");
        УспешныйКод = JS.getProp(Аргументы, "УспешныйКод");
        Попытка
            БЗ = СоздатьОбъект("Текст");
            Попытка БЗ.Открыть(ПутьКБазеЗнаний); Исключение КонецПопытки;
            БЗ.ДобавитьСтроку("=== ПАТТЕРН [" + ТекущаяДата() + "] ===");
            БЗ.ДобавитьСтроку("ЗАДАЧА: " + ОписаниеЗадачи);
            БЗ.ДобавитьСтроку("КОД: ");
            БЗ.ДобавитьСтроку(УспешныйКод);
            БЗ.ДобавитьСтроку("===================================");
            БЗ.Записать(ПутьКБазеЗнаний);
            Возврат "Паттерн навсегда записан в долгосрочную память ИИ.";
        Исключение Возврат "Ошибка записи в Базу Знаний."; КонецПопытки;
    КонецЕсли;

    Возврат "Инструмент не распознан.";
КонецФункции

////////////////////////////////////////////////////////////////////
// АГЕНТНЫЙ ЦИКЛ ОБРАБОТКИ
////////////////////////////////////////////////////////////////////
Процедура ЗапуститьДинамическийМаршрут()
    ШагЦикла = 1; МаксШагов = 20; // Увеличено до 20 из-за фазовости
    Пока ШагЦикла <= МаксШагов Цикл
        ТелоЗапроса = ПостроитьТелоЗапросаJSON();
        Попытка
            Http = СоздатьОбъект("WinHttp.WinHttpRequest.5.1");
            Http.Open("POST", "https://api.anthropic.com/v1/messages", 0);
            Http.SetRequestHeader("Content-Type", "application/json; charset=utf-8");
            Http.SetRequestHeader("x-api-key", СокрЛП(АПИКлюч));
            Http.SetRequestHeader("anthropic-version", "2023-06-01");
            Http.Send(СтрокаВUTF8(ТелоЗапроса));
            Если Http.Status <> 200 Тогда ИсторияЧата = ИсторияЧата + ПС + "❌ Ошибка API: " + UTF8ВСтроку(Http.ResponseBody); Прервать; КонецЕсли;
            ОтветСервера = UTF8ВСтроку(Http.ResponseBody);
        Исключение ИсторияЧата = ИсторияЧата + ПС + "❌ Ошибка сети: " + ОписаниеОшибки(); Прервать; КонецПопытки;
        
        ОтветОбъект = JS.parseJSON(ОтветСервера);
        ПричинаОстанова = JS.getProp(ОтветОбъект, "stop_reason");
        Контент = JS.getProp(ОтветОбъект, "content");
        ДлинаКонтента = JS.getLength(Контент);
        
        ЛогМыслей = "";
        Для с = 0 По ДлинаКонтента - 1 Цикл
            Блок = JS.getElement(Контент, с);
            Если JS.getProp(Блок, "type") = "text" Тогда ЛогМыслей = ЛогМыслей + JS.getProp(Блок, "text") + ПС; КонецЕсли;
        КонецЦикла;
        Если СокрЛП(ЛогМыслей) <> "" Тогда ИсторияЧата = ИсторияЧата + ПС + ЛогМыслей; КонецЕсли;
        
        Если ПричинаОстанова = "tool_use" Тогда
            JS.addAssistantToolCall(String(Контент));
            Для с = 0 По ДлинаКонтента - 1 Цикл
                Блок = JS.getElement(Контент, с);
                Если JS.getProp(Блок, "type") = "tool_use" Тогда
                    Результат = ВыполнитьИнструментВ1С(JS.getProp(Блок, "name"), JS.getProp(Блок, "input"));
                    JS.addToolResult(JS.getProp(Блок, "id"), Результат);
                КонецЕсли;
            КонецЦикла;
            ШагЦикла = ШагЦикла + 1;
        ИначеЕсли ПричинаОстанова = "end_turn" Тогда
            JS.addMessage("assistant", ЛогМыслей); Прервать;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура Отправить()
    Если СокрЛП(ВводПользователя) = "" Тогда Возврат; КонецЕсли;
    JS.addMessage("user", СокрЛП(ВводПользователя));
    ИсторияЧата = ИсторияЧата + ПС + ПС + "👤 ЗАДАЧА: " + ВводПользователя;
    ВводПользователя = "";
    ЗапуститьДинамическийМаршрут();
КонецПроцедуры

Процедура ОчиститьЧат()
    JS.clearHistory(); ИсторияЧата = "🧹 Оперативная память очищена (База Знаний сохранена).";
КонецПроцедуры

Процедура СохранитьКлюч()
    Попытка Т = СоздатьОбъект("Текст"); Т.ДобавитьСтроку(СокрЛП(АПИКлюч)); Т.Записать(ПутьКНастройкам); Сообщить("Ключ сохранен."); Исключение Предупреждение(ОписаниеОшибки()); КонецПопытки;
КонецПроцедуры
