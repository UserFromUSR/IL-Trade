e2_delta_bias_bins   = input.int(5, "Бинов", minval=3, maxval=10, inline="e2f8", group=grp_e2_f8, tooltip="Число ценовых бинов профиля.")

grp_e2_f9 = "Engine LTF2 (3m) — Ф9. Fib Zone Confluence"
e2_use_fib_zone  = input.bool(true, "Включить", inline="e2f9", group=grp_e2_f9, tooltip="Независимый мини-Фибо-свинг — close в OTE 0.618-0.786 И знак max-delta бэнда совпадает с направлением.")
e2_fib_period_tf = input.int(25, "Период свинга", minval=5, inline="e2f9", group=grp_e2_f9, tooltip="Период поиска мини-свинга hi/lo.")

grp_e2_f10 = "Engine LTF2 (3m) — Ф10. OB Own-Level Confluence"
e2_use_ob_own            = input.bool(true, "Включить", inline="e2f10", group=grp_e2_f10, tooltip="Impulse сработал недавно И close на собственном POC/max-delta бине зоны.")
e2_zone_profile_lookback = input.int(25, "Окно профиля зоны", minval=5, inline="e2f10", group=grp_e2_f10, tooltip="Окно истории для собственного профиля зоны (общее для Ф10-Ф12).")
e2_zone_profile_bins     = input.int(5, "Бинов зоны", minval=3, maxval=10, inline="e2f10", group=grp_e2_f10, tooltip="Число бинов собственного профиля зоны.")
e2_zone_va_threshold     = input.float(0.70, "Порог VA зоны", minval=0.5, maxval=0.95, step=0.05, inline="e2f10", group=grp_e2_f10, tooltip="Порог Value Area собственного профиля зоны.")
e2_ob_proxy_fresh_bars   = input.int(3, "Окно свежести OB (баров)", minval=1, maxval=20, inline="e2f10", group=grp_e2_f10, tooltip="Сколько баров после Impulse ещё разрешено засчитывать Own-Level Confluence.")

grp_e2_f11 = "Engine LTF2 (3m) — Ф11. FVG Own-Level Confluence"
e2_use_fvg_own          = input.bool(true, "Включить", inline="e2f11", group=grp_e2_f11, tooltip="FVG Reaction сработала недавно И close на собственном POC/max-delta бине зоны.")
e2_fvg_proxy_fresh_bars = input.int(3, "Окно свежести FVG (баров)", minval=1, maxval=20, inline="e2f11", group=grp_e2_f11, tooltip="Сколько баров после FVG Reaction ещё разрешено засчитывать Own-Level Confluence.")

grp_e2_f12 = "Engine LTF2 (3m) — Ф12. Compression Own-Level Confluence"
e2_use_sd_own          = input.bool(true, "Включить", inline="e2f12", group=grp_e2_f12, tooltip="Compression Break сработал недавно И close на собственном POC/max-delta бине зоны.")
e2_sd_proxy_fresh_bars = input.int(3, "Окно свежести Compression (баров)", minval=1, maxval=20, inline="e2f12", group=grp_e2_f12, tooltip="Сколько баров после Compression Break ещё разрешено засчитывать Own-Level Confluence.")

e2_ob_atr_mult   = f_pr_mult(e2_ob_atr_mult_raw, 2)
e2_ob_vol_mult   = f_pr_mult(e2_ob_vol_mult_raw, 2)
