e2_sd_base_mult  = f_pr_base_mult(e2_sd_base_mult_raw, 2)
e2_min_score     = f_pr_score(qa_min_ltf2, 2)
[e2_w_struct, e2_w_volume, e2_w_pattern] = f_pr_apply_focus(qa_w_struct_ltf2, qa_w_volume_ltf2, qa_w_pattern_ltf2)

