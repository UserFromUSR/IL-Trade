indicator("UserUZR Main - All-in-One (HTF/LTF,FVG,iFVG,CVP,S&D,SMC,OB/BB,HeatMap,VA,Fibonacci,Liquidity Zones)", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=2500, max_polylines_count=100)

// ====================================================================================================================
// 0. ПРЕСЕТ ЧУВСТВИТЕЛЬНОСТИ — только Custom и Скальпинг+.
// ====================================================================================================================
grp_0 = "0. Пресет чувствительности (синхронизировать с Sniper)"
preset_mode = input.string("Custom", "Профиль чувствительности", options=["Custom", "Скальпинг+"], group=grp_0,
  tooltip="Custom — все настройки ниже работают как обычные ручные инпуты.\n\nСкальпинг+ — единственный оставшийся профиль. Задаёт min_score, мультипликаторы чувствительности и вес паттерн-группы для всех 6 TF движков. Не трогает отдельные факторы.")

bool is_scalp_plus = preset_mode == "Скальпинг+"

int   PR_SCORE_OFS   = -3
float PR_MULT_LTF_OFS = -0.15
float PR_MULT_HTF_OFS = -0.12
int   PR_MASTER_OFS  = -1

f_pr_score(int base, int tf_level) =>
    int result = base
    if is_scalp_plus
        result := math.max(1, base + PR_SCORE_OFS)
    result

f_pr_mult(float base, int tf_level) =>
    float result = base
    if is_scalp_plus
        float ofs = tf_level <= 3 ? PR_MULT_LTF_OFS : PR_MULT_HTF_OFS
        result := math.max(0.05, base + ofs)
    result

f_pr_base_mult(float base, int tf_level) =>
    float result = base
    if is_scalp_plus
        float ofs = tf_level <= 3 ? PR_MULT_LTF_OFS : PR_MULT_HTF_OFS
        result := math.max(0.05, base - ofs)
    result

f_pr_apply_focus(int w_struct, int w_volume, int w_pattern) =>
    int rs = w_struct
    int rv = w_volume
    int rp = w_pattern
    if is_scalp_plus
        rp := w_pattern + 1
    [rs, rv, rp]

f_pr_master_thr(int base) =>
    int result = base
    if is_scalp_plus
        result := math.max(3, base + PR_MASTER_OFS)
    result

// ====================================================================================================================
// 0.1 БЫСТРЫЙ ДОСТУП К ЧУВСТВИТЕЛЬНОСТИ, ВЕСАМ И СКОРИНГУ
// ====================================================================================================================
grp_quick = "0.1 Быстрый доступ — Чувствительность, Веса, Скоринг (по TF)"
qa_min_ltf123 = input.int(5, "Мин. сумма для OK — LTF1", minval=1, maxval=40, inline="qmin_ltf", group=grp_quick, tooltip="Минимальная взвешенная сумма факторов для LTF1. Больше — строже и реже, меньше — мягче и чаще.")
qa_min_ltf2   = input.int(6, "LTF2", minval=1, maxval=40, inline="qmin_ltf", group=grp_quick, tooltip="То же для LTF2.")
qa_min_ltf3   = input.int(7, "LTF3", minval=1, maxval=40, inline="qmin_ltf", group=grp_quick, tooltip="То же для LTF3.")
qa_min_htf1   = input.int(8, "Мин. сумма для OK — HTF1", minval=1, maxval=40, inline="qmin_htf", group=grp_quick, tooltip="Минимальная сумма факторов для HTF1.")
qa_min_htf2   = input.int(9, "HTF2", minval=1, maxval=40, inline="qmin_htf", group=grp_quick, tooltip="Минимальная сумма факторов для HTF2.")
qa_min_htf3   = input.int(11, "HTF3", minval=1, maxval=40, inline="qmin_htf", group=grp_quick, tooltip="Минимальная сумма факторов для HTF3.")

qa_w_struct_ltf1 = input.int(2, "Вес структ. — LTF1", minval=1, maxval=4, inline="qws_ltf", group=grp_quick, tooltip="Вес группы структурных факторов в скоринге LTF1.")
qa_w_struct_ltf2 = input.int(2, "LTF2", minval=1, maxval=4, inline="qws_ltf", group=grp_quick, tooltip="Вес структурных факторов для LTF2.")
qa_w_struct_ltf3 = input.int(2, "LTF3", minval=1, maxval=4, inline="qws_ltf", group=grp_quick, tooltip="Вес структурных факторов для LTF3.")
qa_w_struct_htf1 = input.int(3, "Вес структ. — HTF1", minval=1, maxval=4, inline="qws_htf", group=grp_quick, tooltip="Вес структурных факторов для HTF1.")
qa_w_struct_htf2 = input.int(4, "HTF2", minval=1, maxval=4, inline="qws_htf", group=grp_quick, tooltip="Вес структурных факторов для HTF2.")
qa_w_struct_htf3 = input.int(4, "HTF3", minval=1, maxval=4, inline="qws_htf", group=grp_quick, tooltip="Вес структурных факторов для HTF3.")

qa_w_volume_ltf1 = input.int(3, "Вес объём. — LTF1", minval=1, maxval=4, inline="qwv_ltf", group=grp_quick, tooltip="Вес группы объёмных факторов для LTF1.")
qa_w_volume_ltf2 = input.int(3, "LTF2", minval=1, maxval=4, inline="qwv_ltf", group=grp_quick, tooltip="Вес объёмных факторов для LTF2.")
qa_w_volume_ltf3 = input.int(3, "LTF3", minval=1, maxval=4, inline="qwv_ltf", group=grp_quick, tooltip="Вес объёмных факторов для LTF3.")
qa_w_volume_htf1 = input.int(2, "Вес объём. — HTF1", minval=1, maxval=4, inline="qwv_htf", group=grp_quick, tooltip="Вес объёмных факторов для HTF1.")
qa_w_volume_htf2 = input.int(2, "HTF2", minval=1, maxval=4, inline="qwv_htf", group=grp_quick, tooltip="Вес объёмных факторов для HTF2.")
qa_w_volume_htf3 = input.int(2, "HTF3", minval=1, maxval=4, inline="qwv_htf", group=grp_quick, tooltip="Вес объёмных факторов для HTF3.")

qa_w_pattern_ltf1 = input.int(1, "Вес паттерн. — LTF1", minval=1, maxval=4, inline="qwp_ltf", group=grp_quick, tooltip="Вес группы паттерн-факторов для LTF1.")
qa_w_pattern_ltf2 = input.int(1, "LTF2", minval=1, maxval=4, inline="qwp_ltf", group=grp_quick, tooltip="Вес паттерн-факторов для LTF2.")
qa_w_pattern_ltf3 = input.int(1, "LTF3", minval=1, maxval=4, inline="qwp_ltf", group=grp_quick, tooltip="Вес паттерн-факторов для LTF3.")
qa_w_pattern_htf1 = input.int(1, "Вес паттерн. — HTF1", minval=1, maxval=4, inline="qwp_htf", group=grp_quick, tooltip="Вес паттерн-факторов для HTF1.")
qa_w_pattern_htf2 = input.int(1, "HTF2", minval=1, maxval=4, inline="qwp_htf", group=grp_quick, tooltip="Вес паттерн-факторов для HTF2.")
qa_w_pattern_htf3 = input.int(1, "HTF3", minval=1, maxval=4, inline="qwp_htf", group=grp_quick, tooltip="Вес паттерн-факторов для HTF3.")

// ====================================================================================================================
// 0.2 ГЛОБАЛЬНОЕ ПРИГЛУШЕНИЕ ВИЗУАЛИЗАЦИИ
// ====================================================================================================================
grp_dim = "0.2 Приглушение визуализации (индикатор под график)"
dim_enable = input.bool(false, "Приглушить визуализацию индикатора (под график)", group=grp_dim, tooltip="Делает все элементы индикатора заметно прозрачнее. Расчёты не меняются — приглушается только визуал.")
dim_extra_alpha = input.int(55, "Доп. прозрачность в режиме приглушения (0-95)", minval=0, maxval=95, group=grp_dim, tooltip="Насколько дополнительно прозрачным становится каждый элемент при включённом приглушении.")

f_dim(color c) =>
    color result = c
    if dim_enable
        float baseT = color.t(c)
        float newT  = math.min(100, baseT + dim_extra_alpha)
        result := color.new(c, int(newT))
    result

// ====================================================================================================================
// НАСТРОЙКИ МОДУЛЕЙ
// ====================================================================================================================

grp_fib_main = "1. Fibonacci Projection (Zeiierman)"
en_fib     = input.bool(true, "Включить модуль Fibonacci", group=grp_fib_main, inline="fibmain", tooltip="Общий выключатель всего модуля проекции Фибоначчи (свинги, уровни, объёмные профили, Value Area).")
en_fib_vis = input.bool(true, "Показывать визуал", group=grp_fib_main, inline="fibmain", tooltip="Показывать ли графические элементы модуля при включённом расчёте. Объёмный профиль 1.4 визуально скрыт всегда — расчёт продолжает питать POC/VA независимо от этой настройки.")

grp_fib_set = "1.1 Fibonacci — Настройки расчёта"
