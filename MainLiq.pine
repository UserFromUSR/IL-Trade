grp_e1_f1 = "Engine LTF1 (1m) — Ф1. Impulse"
e1_use_impulse   = input.bool(true, "Включить", inline="e1f1", group=grp_e1_f1, tooltip="Что это: смещение цены (тело > ATR×мульт) с объёмным подтверждением и пробоем экстремума предыдущего бара.")
e1_ob_atr_len    = input.int(10, "ATR Len", minval=5, inline="e1f1", group=grp_e1_f1, tooltip="Период ATR для оценки дислокации цены.")
e1_ob_atr_mult_raw = input.float(0.8, "Дислок. ATR×", step=0.1, inline="e1f1", group=grp_e1_f1, tooltip="Минимальная дислокация цены в множителях ATR.")
e1_ob_vol_mult_raw  = input.float(1.3, "Объём>SMA×", step=0.1, inline="e1f1", group=grp_e1_f1, tooltip="Минимальный множитель объёма для подтверждения Impulse.")

grp_e1_f2 = "Engine LTF1 (1m) — Ф2. Reaction Candle"
e1_use_reaction = input.bool(true, "Включить", inline="e1f2", group=grp_e1_f2, tooltip="Что это: (сильное тело ИЛИ поглощение) И накопление N/5 однонаправленных свечей.")
e1_candle_cnt   = input.int(2, "Мин. из 5", minval=1, maxval=5, inline="e1f2", group=grp_e1_f2, tooltip="Минимальное число однонаправленных свечей из последних 5.")
e1_strong_ratio = input.float(0.60, "Порог тела", step=0.05, inline="e1f2", group=grp_e1_f2, tooltip="Минимальная доля тела свечи от диапазона high-low для 'сильной' свечи ИЛИ порог поглощения.")

grp_e1_f3 = "Engine LTF1 (1m) — Ф3. Momentum Filter"
e1_use_momentum = input.bool(true, "Включить", inline="e1f3", group=grp_e1_f3, tooltip="Что это: RSI за порогом И направление текущей свечи совпадает с направлением RSI-сигнала.")
e1_rsi_len      = input.int(9, "Length", minval=2, inline="e1f3", group=grp_e1_f3, tooltip="Период RSI.")
e1_rsi_bull_th  = input.int(55, "Бык <", minval=1, maxval=99, inline="e1f3", group=grp_e1_f3, tooltip="Порог RSI для бычьего направления.")
e1_rsi_bear_th  = input.int(45, "Медв >", minval=1, maxval=99, inline="e1f3", group=grp_e1_f3, tooltip="Порог RSI для медвежьего направления.")

grp_e1_f4 = "Engine LTF1 (1m) — Ф4. FVG Reaction"
e1_use_fvg_reaction = input.bool(true, "Включить", inline="e1f4", group=grp_e1_f4, tooltip="Что это: гэп (нормализованный размер) И объём выше SMA×мульт.")
e1_fvg_thr_raw      = input.float(0.10, "Gap порог", step=0.05, inline="e1f4", group=grp_e1_f4, tooltip="Минимальный нормализованный размер гэпа.")
e1_fvg_vol_mult_raw = input.float(1.5, "Объём>SMA×", step=0.1, inline="e1f4", group=grp_e1_f4, tooltip="Минимальный множитель объёма для подтверждения гэпа.")
e1_fvg_with_htf     = input.bool(false, "Только по HTF тренду", inline="e1f4", group=grp_e1_f4, tooltip="Засчитывать только при совпадении с направлением HTF EMA-тренда.")

grp_e1_f5 = "Engine LTF1 (1m) — Ф5. Liquidity Sweep"
e1_use_sweep    = input.bool(true, "Включить", inline="e1f5", group=grp_e1_f5, tooltip="Что это: экстремум диапазона lookback И объём выше SMA×мульт И разворотное закрытие от экстремума.")
e1_hm_lookback  = input.int(30, "Lookback", minval=10, inline="e1f5", group=grp_e1_f5, tooltip="Период поиска экстремума диапазона.")
e1_hm_vol_mult_raw = input.float(1.5, "Объём>SMA×", step=0.1, inline="e1f5", group=grp_e1_f5, tooltip="Минимальный множитель объёма для подтверждения свипа.")

grp_e1_f6 = "Engine LTF1 (1m) — Ф6. Compression Break"
e1_use_compression   = input.bool(true, "Включить", inline="e1f6", group=grp_e1_f6, tooltip="Что это: дислокация тела + узкая консолидационная база.")
e1_sd_body_mult_raw  = input.float(1.3, "Тело>ATR×", step=0.1, inline="e1f6", group=grp_e1_f6, tooltip="Минимальный размер тела свечи в ATR.")
e1_sd_base_mult_raw  = input.float(0.60, "База<ATR×", step=0.1, inline="e1f6", group=grp_e1_f6, tooltip="Максимальный размер 'базы' в ATR.")

grp_e1_f7 = "Engine LTF1 (1m) — Ф7. Structure Confluence"
e1_use_structure = input.bool(true, "Включить", inline="e1f7", group=grp_e1_f7, tooltip="Что это: 2+ из 3 наборов пивотов подтверждают HH/HL или LH/LL.")
e1_smc_swing     = input.int(3, "Swing Len", minval=2, inline="e1f7", group=grp_e1_f7, tooltip="Период поиска пивотов структуры.")
e1_smc_hh_cnt    = input.int(2, "Мин. из 3", minval=1, maxval=3, inline="e1f7", group=grp_e1_f7, tooltip="Минимальное число совпадающих наборов пивотов.")

grp_e1_f8 = "Engine LTF1 (1m) — Ф8. Delta Bias"
e1_use_delta_bias      = input.bool(true, "Включить", inline="e1f8", group=grp_e1_f8, tooltip="Что это: мини-дельта-профиль по недавнему окну баров — знак максимального по модулю бина совпадает с направлением.")
e1_delta_bias_window   = input.int(20, "Окно (баров)", minval=5, inline="e1f8", group=grp_e1_f8, tooltip="Окно истории для мини-дельта-профиля.")
e1_delta_bias_bins     = input.int(5, "Бинов", minval=3, maxval=10, inline="e1f8", group=grp_e1_f8, tooltip="Число ценовых бинов профиля.")

grp_e1_f9 = "Engine LTF1 (1m) — Ф9. Fib Zone Confluence"
e1_use_fib_zone   = input.bool(true, "Включить", inline="e1f9", group=grp_e1_f9, tooltip="Что это: независимый мини-Фибо-свинг — close в OTE 0.618-0.786 И знак max-delta бэнда внутри диапазона совпадает с направлением.")
e1_fib_period_tf  = input.int(20, "Период свинга", minval=5, inline="e1f9", group=grp_e1_f9, tooltip="Период поиска мини-свинга hi/lo для сетки Фибоначчи этого TF.")

grp_e1_f10 = "Engine LTF1 (1m) — Ф10. OB Own-Level Confluence"
e1_use_ob_own          = input.bool(true, "Включить", inline="e1f10", group=grp_e1_f10, tooltip="Что это: Impulse сработал недавно И close сейчас на собственном POC ИЛИ max-delta бине impulse-зоны, знак совпадает с направлением.")
e1_zone_profile_lookback = input.int(20, "Окно профиля зоны", minval=5, inline="e1f10", group=grp_e1_f10, tooltip="Окно истории для собственного дельта-профиля зоны (общее для Ф10-Ф12).")
e1_zone_profile_bins     = input.int(5, "Бинов зоны", minval=3, maxval=10, inline="e1f10", group=grp_e1_f10, tooltip="Число бинов собственного профиля зоны.")
e1_zone_va_threshold     = input.float(0.70, "Порог VA зоны", minval=0.5, maxval=0.95, step=0.05, inline="e1f10", group=grp_e1_f10, tooltip="Порог Value Area собственного профиля зоны.")
e1_ob_proxy_fresh_bars   = input.int(3, "Окно свежести OB (баров)", minval=1, maxval=20, inline="e1f10", group=grp_e1_f10, tooltip="Сколько баров после Impulse ещё разрешено засчитывать Own-Level Confluence.")

grp_e1_f11 = "Engine LTF1 (1m) — Ф11. FVG Own-Level Confluence"
e1_use_fvg_own        = input.bool(true, "Включить", inline="e1f11", group=grp_e1_f11, tooltip="Что это: FVG Reaction сработала недавно И close сейчас на собственном POC ИЛИ max-delta бине FVG-зоны, знак совпадает с направлением.")
e1_fvg_proxy_fresh_bars = input.int(3, "Окно свежести FVG (баров)", minval=1, maxval=20, inline="e1f11", group=grp_e1_f11, tooltip="Сколько баров после FVG Reaction ещё разрешено засчитывать Own-Level Confluence.")

grp_e1_f12 = "Engine LTF1 (1m) — Ф12. Compression Own-Level Confluence"
e1_use_sd_own        = input.bool(true, "Включить", inline="e1f12", group=grp_e1_f12, tooltip="Что это: Compression Break сработал недавно И close сейчас на собственном POC ИЛИ max-delta бине зоны, знак совпадает с направлением.")
e1_sd_proxy_fresh_bars = input.int(3, "Окно свежести Compression (баров)", minval=1, maxval=20, inline="e1f12", group=grp_e1_f12, tooltip="Сколько баров после Compression Break ещё разрешено засчитывать Own-Level Confluence.")

e1_ob_atr_mult   = f_pr_mult(e1_ob_atr_mult_raw, 1)
e1_ob_vol_mult   = f_pr_mult(e1_ob_vol_mult_raw, 1)
e1_fvg_thr       = f_pr_mult(e1_fvg_thr_raw, 1)
e1_fvg_vol_mult  = f_pr_mult(e1_fvg_vol_mult_raw, 1)
e1_hm_vol_mult   = f_pr_mult(e1_hm_vol_mult_raw, 1)
e1_sd_body_mult  = f_pr_mult(e1_sd_body_mult_raw, 1)
e1_sd_base_mult  = f_pr_base_mult(e1_sd_base_mult_raw, 1)
e1_min_score     = f_pr_score(qa_min_ltf123, 1)
[e1_w_struct, e1_w_volume, e1_w_pattern] = f_pr_apply_focus(qa_w_struct_ltf1, qa_w_volume_ltf1, qa_w_pattern_ltf1)

