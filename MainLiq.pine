var float davg2_sd_bull_avg   = na
var float davg2_sd_bear_avg   = na
var float davg2_fvg_bull_avg  = na
var float davg2_fvg_bear_avg  = na
var float davg2_ifvg_bull_avg = na
var float davg2_ifvg_bear_avg = na

f_dva_txsz(string s) =>
    string result = size.tiny
    if s == "Normal"
        result := size.normal
    else if s == "Small"
        result := size.small
    else
        result := size.tiny
    result

f_dva_level_eaten(float level) =>
    bool result = false
    if not na(level)
        result := math.min(close, open) <= level and math.max(close, open) >= level
    result

var array<float> davg_buf_ob      = array.new_float(0)
var array<float> davg_buf_breaker = array.new_float(0)
var array<float> davg_buf_sd      = array.new_float(0)
var array<float> davg_buf_fvg     = array.new_float(0)
var array<float> davg_buf_ifvg    = array.new_float(0)

var bool da_ob_fresh_bull  = false
var bool da_ob_fresh_bear  = false
var bool da_sd_fresh_bull  = false
var bool da_sd_fresh_bear  = false
var bool da_fvg_fresh_bull = false
var bool da_fvg_fresh_bear = false

f_davg_push(array<float> buf, float val, int n) =>
    if val > 0
        buf.push(val)
        if buf.size() > n
            buf.shift()

f_davg_avg(array<float> buf) =>
    float result = na
    if buf.size() > 0
        result := buf.avg()
    result

f_davg_excess(float maxAbsD, array<float> buf) =>
    bool  isOver = false
    float pct    = na
    if davg_enable and maxAbsD > 0
        float avgRef = f_davg_avg(buf)
        if not na(avgRef) and avgRef > 0 and maxAbsD > avgRef
            isOver := true
            pct    := (maxAbsD / avgRef - 1) * 100
    [isOver, pct]

