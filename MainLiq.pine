grp_e2_f8 = "Engine LTF2 (3m) — Ф8. Delta Bias"
e2_use_delta_bias    = input.bool(true, "Включить", inline="e2f8", group=grp_e2_f8, tooltip="Мини-дельта-профиль по недавнему окну баров — знак максимального бина совпадает с направлением.")
