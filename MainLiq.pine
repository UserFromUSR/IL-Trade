grp_e2_f7 = "Engine LTF2 (3m) — Ф7. Structure Confluence"
e2_use_structure = input.bool(true, "Включить", inline="e2f7", group=grp_e2_f7, tooltip="2+ из 3 наборов пивотов подтверждают HH/HL или LH/LL.")
e2_smc_swing     = input.int(4, "Swing Len", minval=2, inline="e2f7", group=grp_e2_f7, tooltip="Период поиска пивотов структуры.")
