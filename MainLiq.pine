// ====================================================================================================================
// ОБЩИЕ ХЕЛПЕРЫ ДЕЛЬТА-ПРОФИЛЯ
// ====================================================================================================================
f_delta_profile_generic(float rangeLo, float rangeHi, int lookback, int bins) =>
    array<float> dBull = array.new_float(bins, 0.0)
    array<float> dBear = array.new_float(bins, 0.0)
    float step = (rangeHi - rangeLo) / bins
    int startBar = math.max(0, math.min(lookback, bar_index))
    if step > 0
        for i = 0 to startBar - 1
            float price = hlc3[i]
            float vol = volume[i]
            bool bull = close[i] > open[i]
            if price >= rangeLo and price < rangeHi
                int idx = int((price - rangeLo) / step)
                idx := math.max(0, math.min(bins - 1, idx))
                if bull
                    array.set(dBull, idx, array.get(dBull, idx) + vol)
                else
                    array.set(dBear, idx, array.get(dBear, idx) + vol)
    [dBull, dBear]

f_measure_delta_max(float rangeLo, float rangeHi, int lookback, int bins) =>
    [dBull, dBear] = f_delta_profile_generic(rangeLo, rangeHi, lookback, bins)
    float maxAbs = 0.0
    bool  isBullMax = true
    for bnk = 0 to bins - 1
        float d0 = array.get(dBull, bnk) - array.get(dBear, bnk)
        if math.abs(d0) > maxAbs
            maxAbs := math.abs(d0)
            isBullMax := d0 >= 0
    [maxAbs, isBullMax]

f_own_level_confluence(bool fresh, float zoneLo, float zoneHi, int lookback, int bins, float vaThreshold, bool wantBull) =>
    bool result = false
    if fresh and not na(zoneLo) and not na(zoneHi) and zoneHi > zoneLo
        [dBull, dBear] = f_delta_profile_generic(zoneLo, zoneHi, lookback, bins)
        float maxAbs   = 0.0
        int   maxIdx   = -1
        int   maxSign  = 0
        float totalVol = 0.0
        float maxTot   = 0.0
        int   pocIdx   = 0
        for bnk = 0 to bins - 1
            float bu  = array.get(dBull, bnk)
            float be  = array.get(dBear, bnk)
            float d   = bu - be
            float tot = bu + be
            totalVol += tot
            if math.abs(d) > maxAbs
                maxAbs  := math.abs(d)
                maxIdx  := bnk
                maxSign := d >= 0 ? 1 : -1
            if tot > maxTot
                maxTot := tot
                pocIdx := bnk
        if maxAbs > 0 and totalVol > 0
            [vaLo, vaHi] = f_calc_value_area(dBull, dBear, bins, pocIdx, totalVol, vaThreshold)
            float step = (zoneHi - zoneLo) / bins
            int closeIdx = math.max(0, math.min(bins - 1, int((close - zoneLo) / step)))
            bool onMaxBin = closeIdx == maxIdx
            bool inOwnVA  = closeIdx >= vaLo and closeIdx <= vaHi
            bool signOk   = wantBull ? maxSign == 1 : maxSign == -1
            result := (onMaxBin or inOwnVA) and signOk
    result

// ====================================================================================================================
// tf_engine_v3 — 12 составных факторов, БЕЗ MUST-ФЛАГОВ
// ====================================================================================================================
tf_engine_v3(
  bool  p_use_impulse,     int p_ob_atr_len,   float p_ob_atr_mult,  float p_ob_vol_mult,
  bool  p_use_reaction,    int p_candle_cnt,   float p_strong_ratio,
  bool  p_use_momentum,    int p_rsi_len,      int p_rsi_bull_th,    int p_rsi_bear_th,
  bool  p_use_fvg_reaction, float p_fvg_thr,   float p_fvg_vol_mult, bool p_fvg_with_htf,
  bool  p_use_sweep,       int p_hm_lookback,  float p_hm_vol_mult,
  bool  p_use_compression, float p_sd_body_mult, float p_sd_base_mult,
  bool  p_use_structure,   int p_smc_swing,    int p_smc_hh_cnt,
  bool  p_use_delta_bias,  int p_delta_bias_window, int p_delta_bias_bins,
  bool  p_use_fib_zone,    int p_fib_period_tf,
  bool  p_use_ob_own,      int p_zone_profile_lookback, int p_zone_profile_bins, float p_zone_va_threshold, int p_ob_proxy_fresh_bars,
  bool  p_use_fvg_own,     int p_fvg_proxy_fresh_bars,
  bool  p_use_sd_own,      int p_sd_proxy_fresh_bars,
  int   p_w_struct,        int p_w_volume,     int p_w_pattern
  ) =>

    int VOL_SMA_LEN = 20
    float vol_sma = ta.sma(volume, VOL_SMA_LEN)

    float ob_atr   = ta.atr(p_ob_atr_len)
    bool ob_disl_b = (close[1] < open[1]) and (math.abs(close[1]-open[1]) > ob_atr*p_ob_atr_mult) and (volume[1] > vol_sma*p_ob_vol_mult) and (close>open) and (close>high[1])
    bool ob_disl_s = (close[1] > open[1]) and (math.abs(close[1]-open[1]) > ob_atr*p_ob_atr_mult) and (volume[1] > vol_sma*p_ob_vol_mult) and (close<open) and (close<low[1])
    bool f1_b = p_use_impulse ? ob_disl_b : false
    bool f1_s = p_use_impulse ? ob_disl_s : false

    int bull_cnt = (close>open?1:0)+(close[1]>open[1]?1:0)+(close[2]>open[2]?1:0)+(close[3]>open[3]?1:0)+(close[4]>open[4]?1:0)
    int bear_cnt = (close<open?1:0)+(close[1]<open[1]?1:0)+(close[2]<open[2]?1:0)+(close[3]<open[3]?1:0)+(close[4]<open[4]?1:0)
    bool candle_accum_b = bull_cnt >= p_candle_cnt
    bool candle_accum_s = bear_cnt >= p_candle_cnt
    float body_r  = math.abs(close-open)/math.max(high-low, syminfo.mintick)
    bool strong_b = body_r > p_strong_ratio and close>open
    bool strong_s = body_r > p_strong_ratio and close<open
    bool engulf_b = close>open and close>high[1] and open<close[1]
    bool engulf_s = close<open and close<low[1] and open>close[1]
    bool f2_b = p_use_reaction ? ((strong_b or engulf_b) and candle_accum_b) : false
    bool f2_s = p_use_reaction ? ((strong_s or engulf_s) and candle_accum_s) : false

    float rsi_val = ta.rsi(close, p_rsi_len)
    bool f3_b = p_use_momentum ? (rsi_val < p_rsi_bull_th and close>open) : false
    bool f3_s = p_use_momentum ? (rsi_val > p_rsi_bear_th and close<open) : false

    float ema_htf_fast = ta.ema(close, 8)
    float ema_htf_slow = ta.ema(close, 21)
    bool  htf_ema_bull = ema_htf_fast > ema_htf_slow
    bool  htf_ema_bear = ema_htf_fast < ema_htf_slow
    float fvg_bull_gap = (low  - high[2]) / math.max(ta.stdev(low  - high[2], 50), 1e-10)
    float fvg_bear_gap = (low[2] - high)  / math.max(ta.stdev(low[2] - high,  50), 1e-10)
    bool  fvg_raw_b = low > high[2] and fvg_bull_gap > p_fvg_thr
    bool  fvg_raw_s = high < low[2] and fvg_bear_gap > p_fvg_thr
    bool  fvg_vol_ok = volume > vol_sma * p_fvg_vol_mult
    bool  f4_b_raw = fvg_raw_b and fvg_vol_ok
    bool  f4_s_raw = fvg_raw_s and fvg_vol_ok
    bool  f4_b = p_use_fvg_reaction ? (p_fvg_with_htf ? (f4_b_raw and htf_ema_bull) : f4_b_raw) : false
    bool  f4_s = p_use_fvg_reaction ? (p_fvg_with_htf ? (f4_s_raw and htf_ema_bear) : f4_s_raw) : false

    float hm_highest = ta.highest(high, p_hm_lookback)
    float hm_lowest  = ta.lowest(low,  p_hm_lookback)
    bool  sweep_vol_ok = volume > vol_sma * p_hm_vol_mult
    bool  f5_b = p_use_sweep ? (low  == hm_lowest  and sweep_vol_ok and close > open) : false
    bool  f5_s = p_use_sweep ? (high == hm_highest and sweep_vol_ok and close < open) : false

    float sd_atr_loc   = ta.atr(20)
    bool  sd_disl_b    = close[1] > open[1] and (math.abs(close[1] - open[1]) > sd_atr_loc[1] * p_sd_body_mult)
    bool  sd_disl_s    = open[1]  > close[1] and (math.abs(close[1] - open[1]) > sd_atr_loc[1] * p_sd_body_mult)
    bool  sd_base_cond = math.max(math.abs(close[2] - open[2]), nz(math.abs(close[3] - open[3]), math.abs(close[2] - open[2]))) < sd_atr_loc[2] * p_sd_base_mult
    bool  f6_b = p_use_compression ? (sd_disl_b and sd_base_cond) : false
    bool  f6_s = p_use_compression ? (sd_disl_s and sd_base_cond) : false

    int sw = p_smc_swing
    float ph_0 = nz(ta.pivothigh(high, sw, sw),         high[sw])
    float ph_1 = nz(ta.pivothigh(high, sw * 3, sw * 3), high[sw * 3])
    float ph_2 = nz(ta.pivothigh(high, sw * 5, sw * 5), high[sw * 5])
    float pl_0 = nz(ta.pivotlow (low,  sw, sw),         low[sw])
    float pl_1 = nz(ta.pivotlow (low,  sw * 3, sw * 3), low[sw * 3])
    float pl_2 = nz(ta.pivotlow (low,  sw * 5, sw * 5), low[sw * 5])
    bool hh1 = ph_0 > ph_1
    bool hl1 = pl_0 > pl_1
    bool hh2 = ph_1 > ph_2
    bool hl2 = pl_1 > pl_2
    bool lh1 = ph_0 < ph_1
    bool ll1 = pl_0 < pl_1
    bool lh2 = ph_1 < ph_2
    bool ll2 = pl_1 < pl_2
    int smc_bull_cnt = (hh1?1:0)+(hl1?1:0)+(hh2?1:0)+(hl2?1:0)
    int smc_bear_cnt = (lh1?1:0)+(ll1?1:0)+(lh2?1:0)+(ll2?1:0)
    bool f7_b = p_use_structure ? (smc_bull_cnt >= p_smc_hh_cnt) : false
    bool f7_s = p_use_structure ? (smc_bear_cnt >= p_smc_hh_cnt) : false

    float db8_hi = ta.highest(high, p_delta_bias_window)
    float db8_lo = ta.lowest(low,  p_delta_bias_window)
    [db8_bull, db8_bear] = f_delta_profile_generic(db8_lo, db8_hi, p_delta_bias_window, p_delta_bias_bins)
    float db8_maxAbs  = 0.0
    int   db8_maxSign = 0
    for bnk = 0 to p_delta_bias_bins - 1
        float d = array.get(db8_bull, bnk) - array.get(db8_bear, bnk)
        if math.abs(d) > db8_maxAbs
            db8_maxAbs  := math.abs(d)
            db8_maxSign := d >= 0 ? 1 : -1
    bool f8_b = p_use_delta_bias ? (db8_maxSign == 1) : false
    bool f8_s = p_use_delta_bias ? (db8_maxSign == -1) : false

    var array<float> db8_hist = array.new_float(0)
    var bool db8_was_excess = false
    float db8_avg_ref = db8_hist.size() >= 5 ? db8_hist.avg() : na
    bool db8_is_excess = not na(db8_avg_ref) and db8_avg_ref > 0 and db8_maxAbs > db8_avg_ref
    bool f_delta_anomaly_fresh_bull = db8_is_excess and not db8_was_excess and db8_maxSign == 1
    bool f_delta_anomaly_fresh_bear = db8_is_excess and not db8_was_excess and db8_maxSign == -1
    if db8_maxAbs > 0
        db8_hist.push(db8_maxAbs)
        if db8_hist.size() > 30
            db8_hist.shift()
    db8_was_excess := db8_is_excess

    float f9_hi = ta.highest(high, p_fib_period_tf)
    float f9_lo = ta.lowest(low,  p_fib_period_tf)
    bool  f9_isHi = high == f9_hi
    bool  f9_isLo = low  == f9_lo
    int   f9_HB = ta.barssince(f9_isHi)
    int   f9_LB = ta.barssince(f9_isLo)
    bool  f9_trend_up = f9_HB < f9_LB
    bool  f9_trend_dn = f9_HB > f9_LB
    float f9_hiPrice = ta.valuewhen(f9_isHi, high, 0)
    float f9_loPrice = ta.valuewhen(f9_isLo, low, 0)
    bool  f9_ote_bull = false
    bool  f9_ote_bear = false
    float f9_ote_lo = na
    float f9_ote_hi = na
    if not na(f9_hiPrice) and not na(f9_loPrice) and f9_hiPrice > f9_loPrice
        float f9_rng = f9_hiPrice - f9_loPrice
        if f9_trend_up
            f9_ote_lo := f9_loPrice + f9_rng * 0.214
            f9_ote_hi := f9_loPrice + f9_rng * 0.382
            f9_ote_bull := close >= f9_ote_lo and close <= f9_ote_hi
        else if f9_trend_dn
            f9_ote_hi := f9_hiPrice - f9_rng * 0.214
            f9_ote_lo := f9_hiPrice - f9_rng * 0.382
            f9_ote_bear := close >= f9_ote_lo and close <= f9_ote_hi
    array<float> f9_dBull = array.new_float(5, 0.0)
    array<float> f9_dBear = array.new_float(5, 0.0)
    if not na(f9_ote_lo) and not na(f9_ote_hi) and f9_ote_hi > f9_ote_lo
        [db9, dr9] = f_delta_profile_generic(f9_ote_lo, f9_ote_hi, p_fib_period_tf, 5)
        f9_dBull := db9
        f9_dBear := dr9
    float f9_maxAbs  = 0.0
    int   f9_maxSign = 0
    for bnk = 0 to 4
        float d = array.get(f9_dBull, bnk) - array.get(f9_dBear, bnk)
        if math.abs(d) > f9_maxAbs
            f9_maxAbs  := math.abs(d)
            f9_maxSign := d >= 0 ? 1 : -1
    bool f9_b = p_use_fib_zone ? (f9_ote_bull and f9_maxSign == 1) : false
    bool f9_s = p_use_fib_zone ? (f9_ote_bear and f9_maxSign == -1) : false

    var int   f10_last_bull_bar = -999999
    var float f10_last_bull_lo  = na
    var float f10_last_bull_hi  = na
    var int   f10_last_bear_bar = -999999
    var float f10_last_bear_lo  = na
    var float f10_last_bear_hi  = na
    if f1_b
        f10_last_bull_bar := bar_index
        f10_last_bull_lo  := low[1]
        f10_last_bull_hi  := high[1]
    if f1_s
        f10_last_bear_bar := bar_index
        f10_last_bear_lo  := low[1]
        f10_last_bear_hi  := high[1]
    bool f10_fresh_bull = (bar_index - f10_last_bull_bar) <= p_ob_proxy_fresh_bars
    bool f10_fresh_bear = (bar_index - f10_last_bear_bar) <= p_ob_proxy_fresh_bars
    bool f10_b = p_use_ob_own ? f_own_level_confluence(f10_fresh_bull, f10_last_bull_lo, f10_last_bull_hi, p_zone_profile_lookback, p_zone_profile_bins, p_zone_va_threshold, true)  : false
    bool f10_s = p_use_ob_own ? f_own_level_confluence(f10_fresh_bear, f10_last_bear_lo, f10_last_bear_hi, p_zone_profile_lookback, p_zone_profile_bins, p_zone_va_threshold, false) : false

    var int   f11_last_bull_bar = -999999
    var float f11_last_bull_lo  = na
    var float f11_last_bull_hi  = na
    var int   f11_last_bear_bar = -999999
    var float f11_last_bear_lo  = na
    var float f11_last_bear_hi  = na
    if f4_b
        f11_last_bull_bar := bar_index
        f11_last_bull_lo  := high[2]
        f11_last_bull_hi  := low
    if f4_s
        f11_last_bear_bar := bar_index
        f11_last_bear_lo  := high
        f11_last_bear_hi  := low[2]
    bool f11_fresh_bull = (bar_index - f11_last_bull_bar) <= p_fvg_proxy_fresh_bars
    bool f11_fresh_bear = (bar_index - f11_last_bear_bar) <= p_fvg_proxy_fresh_bars
    bool f11_b = p_use_fvg_own ? f_own_level_confluence(f11_fresh_bull, f11_last_bull_lo, f11_last_bull_hi, p_zone_profile_lookback, p_zone_profile_bins, p_zone_va_threshold, true)  : false
    bool f11_s = p_use_fvg_own ? f_own_level_confluence(f11_fresh_bear, f11_last_bear_lo, f11_last_bear_hi, p_zone_profile_lookback, p_zone_profile_bins, p_zone_va_threshold, false) : false

    var int   f12_last_bull_bar = -999999
    var float f12_last_bull_lo  = na
    var float f12_last_bull_hi  = na
    var int   f12_last_bear_bar = -999999
    var float f12_last_bear_lo  = na
    var float f12_last_bear_hi  = na
    if f6_b
        f12_last_bull_bar := bar_index
        f12_last_bull_lo  := math.min(open[2], close[2])
        f12_last_bull_hi  := math.max(open[2], close[2])
    if f6_s
        f12_last_bear_bar := bar_index
        f12_last_bear_lo  := math.min(open[2], close[2])
        f12_last_bear_hi  := math.max(open[2], close[2])
    bool f12_fresh_bull = (bar_index - f12_last_bull_bar) <= p_sd_proxy_fresh_bars
    bool f12_fresh_bear = (bar_index - f12_last_bear_bar) <= p_sd_proxy_fresh_bars
    bool f12_b = p_use_sd_own ? f_own_level_confluence(f12_fresh_bull, f12_last_bull_lo, f12_last_bull_hi, p_zone_profile_lookback, p_zone_profile_bins, p_zone_va_threshold, true)  : false
    bool f12_s = p_use_sd_own ? f_own_level_confluence(f12_fresh_bear, f12_last_bear_lo, f12_last_bear_hi, p_zone_profile_lookback, p_zone_profile_bins, p_zone_va_threshold, false) : false

    int struct_bull  = (f1_b?p_w_struct:0)+(f6_b?p_w_struct:0)+(f7_b?p_w_struct:0)+(f9_b?p_w_struct:0)+(f10_b?p_w_struct:0)+(f12_b?p_w_struct:0)
    int volume_bull  = (f4_b?p_w_volume:0)+(f5_b?p_w_volume:0)+(f8_b?p_w_volume:0)+(f11_b?p_w_volume:0)
    int pattern_bull = (f2_b?p_w_pattern:0)+(f3_b?p_w_pattern:0)

    int struct_bear  = (f1_s?p_w_struct:0)+(f6_s?p_w_struct:0)+(f7_s?p_w_struct:0)+(f9_s?p_w_struct:0)+(f10_s?p_w_struct:0)+(f12_s?p_w_struct:0)
    int volume_bear  = (f4_s?p_w_volume:0)+(f5_s?p_w_volume:0)+(f8_s?p_w_volume:0)+(f11_s?p_w_volume:0)
    int pattern_bear = (f2_s?p_w_pattern:0)+(f3_s?p_w_pattern:0)

    int score_bull = struct_bull + volume_bull + pattern_bull
    int score_bear = struct_bear + volume_bear + pattern_bear

    [score_bull, score_bear, f_delta_anomaly_fresh_bull, f_delta_anomaly_fresh_bear]

[g_ltf1_sb, g_ltf1_ss, g_ltf1_dab, g_ltf1_das] = request.security(syminfo.tickerid, g_ltf1,
  tf_engine_v3(
    e1_use_impulse, e1_ob_atr_len, e1_ob_atr_mult, e1_ob_vol_mult,
    e1_use_reaction, e1_candle_cnt, e1_strong_ratio,
    e1_use_momentum, e1_rsi_len, e1_rsi_bull_th, e1_rsi_bear_th,
    e1_use_fvg_reaction, e1_fvg_thr, e1_fvg_vol_mult, e1_fvg_with_htf,
    e1_use_sweep, e1_hm_lookback, e1_hm_vol_mult,
    e1_use_compression, e1_sd_body_mult, e1_sd_base_mult,
    e1_use_structure, e1_smc_swing, e1_smc_hh_cnt,
    e1_use_delta_bias, e1_delta_bias_window, e1_delta_bias_bins,
    e1_use_fib_zone, e1_fib_period_tf,
    e1_use_ob_own, e1_zone_profile_lookback, e1_zone_profile_bins, e1_zone_va_threshold, e1_ob_proxy_fresh_bars,
    e1_use_fvg_own, e1_fvg_proxy_fresh_bars,
    e1_use_sd_own, e1_sd_proxy_fresh_bars,
    e1_w_struct, e1_w_volume, e1_w_pattern),
  lookahead=barmerge.lookahead_off)

