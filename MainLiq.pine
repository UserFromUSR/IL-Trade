grp_e2_f3 = "Engine LTF2 (3m) — Ф3. Momentum Filter"
e2_use_momentum = input.bool(true, "Включить", inline="e2f3", group=grp_e2_f3, tooltip="RSI за порогом И направление текущей свечи совпадает с направлением сигнала.")
