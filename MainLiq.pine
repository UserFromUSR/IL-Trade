grp_e2_f5 = "Engine LTF2 (3m) — Ф5. Liquidity Sweep"
e2_use_sweep    = input.bool(true, "Включить", inline="e2f5", group=grp_e2_f5, tooltip="Экстремум диапазона И объём выше SMA×мульт И разворотное закрытие.")
e2_hm_lookback  = input.int(40, "Lookback", minval=10, inline="e2f5", group=grp_e2_f5, tooltip="Период поиска экстремума диапазона.")
e2_hm_vol_mult_raw = input.float(1.5, "Объём>SMA×", step=0.1, inline="e2f5", group=grp_e2_f5, tooltip="Минимальный множитель объёма для подтверждения свипа.")

grp_e2_f6 = "Engine LTF2 (3m) — Ф6. Compression Break"
e2_use_compression   = input.bool(true, "Включить", inline="e2f6", group=grp_e2_f6, tooltip="Дислокация тела + узкая консолидационная база.")
e2_sd_body_mult_raw  = input.float(1.4, "Тело>ATR×", step=0.1, inline="e2f6", group=grp_e2_f6, tooltip="Минимальный размер тела свечи в ATR.")
