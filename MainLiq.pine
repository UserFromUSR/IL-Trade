e2_rsi_bear_th  = input.int(43, "Медв >", minval=1, maxval=99, inline="e2f3", group=grp_e2_f3, tooltip="Порог RSI для медвежьего направления.")

grp_e2_f4 = "Engine LTF2 (3m) — Ф4. FVG Reaction"
e2_use_fvg_reaction = input.bool(true, "Включить", inline="e2f4", group=grp_e2_f4, tooltip="Гэп И объём выше SMA×мульт.")
e2_fvg_thr_raw      = input.float(0.12, "Gap порог", step=0.05, inline="e2f4", group=grp_e2_f4, tooltip="Минимальный нормализованный размер гэпа.")
e2_fvg_vol_mult_raw = input.float(1.5, "Объём>SMA×", step=0.1, inline="e2f4", group=grp_e2_f4, tooltip="Минимальный множитель объёма для подтверждения гэпа.")
