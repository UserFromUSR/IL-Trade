grp_e3_f1 = "Engine LTF3 (5m) — Ф1. Impulse"
e3_use_impulse   = input.bool(true, "Включить", inline="e3f1", group=grp_e3_f1, tooltip="Смещение цены с объёмным подтверждением и пробоем экстремума предыдущего бара.")
e3_ob_atr_len    = input.int(14, "ATR Len", minval=5, inline="e3f1", group=grp_e3_f1, tooltip="Период ATR для оценки дислокации цены.")
e3_ob_atr_mult_raw = input.float(1.0, "Дислок. ATR×", step=0.1, inline="e3f1", group=grp_e3_f1, tooltip="Минимальная дислокация цены в множителях ATR.")
e3_ob_vol_mult_raw  = input.float(1.5, "Объём>SMA×", step=0.1, inline="e3f1", group=grp_e3_f1, tooltip="Минимальный множитель объёма для подтверждения Impulse.")

grp_e3_f2 = "Engine LTF3 (5m) — Ф2. Reaction Candle"
e3_use_reaction = input.bool(true, "Включить", inline="e3f2", group=grp_e3_f2, tooltip="(Сильное тело ИЛИ поглощение) И накопление N/5 однонаправленных свечей.")
e3_candle_cnt   = input.int(3, "Мин. из 5", minval=1, maxval=5, inline="e3f2", group=grp_e3_f2, tooltip="Минимальное число однонаправленных свечей из последних 5.")
e3_strong_ratio = input.float(0.65, "Порог тела", step=0.05, inline="e3f2", group=grp_e3_f2, tooltip="Минимальная доля тела свечи от диапазона high-low ИЛИ порог поглощения.")

grp_e3_f3 = "Engine LTF3 (5m) — Ф3. Momentum Filter"
e3_use_momentum = input.bool(true, "Включить", inline="e3f3", group=grp_e3_f3, tooltip="RSI за порогом И направление текущей свечи совпадает с направлением сигнала.")
e3_rsi_len      = input.int(9, "Length", minval=2, inline="e3f3", group=grp_e3_f3, tooltip="Период RSI.")
e3_rsi_bull_th  = input.int(56, "Бык <", minval=1, maxval=99, inline="e3f3", group=grp_e3_f3, tooltip="Порог RSI для бычьего направления.")
e3_rsi_bear_th  = input.int(44, "Медв >", minval=1, maxval=99, inline="e3f3", group=grp_e3_f3, tooltip="Порог RSI для медвежьего направления.")

grp_e3_f4 = "Engine LTF3 (5m) — Ф4. FVG Reaction"
e3_use_fvg_reaction = input.bool(true, "Включить", inline="e3f4", group=grp_e3_f4, tooltip="Гэп И объём выше SMA×мульт.")
e3_fvg_thr_raw      = input.float(0.15, "Gap порог", step=0.05, inline="e3f4", group=grp_e3_f4, tooltip="Минимальный нормализованный размер гэпа.")
e3_fvg_vol_mult_raw = input.float(1.6, "Объём>SMA×", step=0.1, inline="e3f4", group=grp_e3_f4, tooltip="Минимальный множитель объёма для подтверждения гэпа.")
e3_fvg_with_htf     = input.bool(false, "Только по HTF тренду", inline="e3f4", group=grp_e3_f4, tooltip="Засчитывать только при совпадении с направлением HTF EMA-тренда.")

grp_e3_f5 = "Engine LTF3 (5m) — Ф5. Liquidity Sweep"
e3_use_sweep    = input.bool(true, "Включить", inline="e3f5", group=grp_e3_f5, tooltip="Экстремум диапазона И объём выше SMA×мульт И разворотное закрытие.")
e3_hm_lookback  = input.int(50, "Lookback", minval=10, inline="e3f5", group=grp_e3_f5, tooltip="Период поиска экстремума диапазона.")
e3_hm_vol_mult_raw = input.float(1.6, "Объём>SMA×", step=0.1, inline="e3f5", group=grp_e3_f5, tooltip="Минимальный множитель объёма для подтверждения свипа.")

grp_e3_f6 = "Engine LTF3 (5m) — Ф6. Compression Break"
e3_use_compression   = input.bool(true, "Включить", inline="e3f6", group=grp_e3_f6, tooltip="Дислокация тела + узкая консолидационная база.")
e3_sd_body_mult_raw  = input.float(1.5, "Тело>ATR×", step=0.1, inline="e3f6", group=grp_e3_f6, tooltip="Минимальный размер тела свечи в ATR.")
e3_sd_base_mult_raw  = input.float(0.50, "База<ATR×", step=0.1, inline="e3f6", group=grp_e3_f6, tooltip="Максимальный размер 'базы' в ATR.")

grp_e3_f7 = "Engine LTF3 (5m) — Ф7. Structure Confluence"
e3_use_structure = input.bool(true, "Включить", inline="e3f7", group=grp_e3_f7, tooltip="2+ из 3 наборов пивотов подтверждают HH/HL или LH/LL.")
e3_smc_swing     = input.int(5, "Swing Len", minval=2, inline="e3f7", group=grp_e3_f7, tooltip="Период поиска пивотов структуры.")
e3_smc_hh_cnt    = input.int(2, "Мин. из 3", minval=1, maxval=3, inline="e3f7", group=grp_e3_f7, tooltip="Минимальное число совпадающих наборов пивотов.")

grp_e3_f8 = "Engine LTF3 (5m) — Ф8. Delta Bias"
e3_use_delta_bias    = input.bool(true, "Включить", inline="e3f8", group=grp_e3_f8, tooltip="Мини-дельта-профиль по недавнему окну баров — знак максимального бина совпадает с направлением.")
e3_delta_bias_window = input.int(30, "Окно (баров)", minval=5, inline="e3f8", group=grp_e3_f8, tooltip="Окно истории для мини-дельта-профиля.")
e3_delta_bias_bins   = input.int(5, "Бинов", minval=3, maxval=10, inline="e3f8", group=grp_e3_f8, tooltip="Число ценовых бинов профиля.")

grp_e3_f9 = "Engine LTF3 (5m) — Ф9. Fib Zone Confluence"
e3_use_fib_zone  = input.bool(true, "Включить", inline="e3f9", group=grp_e3_f9, tooltip="Независимый мини-Фибо-свинг — close в OTE 0.618-0.786 И знак max-delta бэнда совпадает с направлением.")
e3_fib_period_tf = input.int(30, "Период свинга", minval=5, inline="e3f9", group=grp_e3_f9, tooltip="Период поиска мини-свинга hi/lo.")

grp_e3_f10 = "Engine LTF3 (5m) — Ф10. OB Own-Level Confluence"
e3_use_ob_own            = input.bool(true, "Включить", inline="e3f10", group=grp_e3_f10, tooltip="Impulse сработал недавно И close на собственном POC/max-delta бине зоны.")
e3_zone_profile_lookback = input.int(30, "Окно профиля зоны", minval=5, inline="e3f10", group=grp_e3_f10, tooltip="Окно истории для собственного профиля зоны (общее для Ф10-Ф12).")
e3_zone_profile_bins     = input.int(5, "Бинов зоны", minval=3, maxval=10, inline="e3f10", group=grp_e3_f10, tooltip="Число бинов собственного профиля зоны.")
e3_zone_va_threshold     = input.float(0.70, "Порог VA зоны", minval=0.5, maxval=0.95, step=0.05, inline="e3f10", group=grp_e3_f10, tooltip="Порог Value Area собственного профиля зоны.")
e3_ob_proxy_fresh_bars   = input.int(3, "Окно свежести OB (баров)", minval=1, maxval=20, inline="e3f10", group=grp_e3_f10, tooltip="Сколько баров после Impulse ещё разрешено засчитывать Own-Level Confluence.")

grp_e3_f11 = "Engine LTF3 (5m) — Ф11. FVG Own-Level Confluence"
e3_use_fvg_own          = input.bool(true, "Включить", inline="e3f11", group=grp_e3_f11, tooltip="FVG Reaction сработала недавно И close на собственном POC/max-delta бине зоны.")
e3_fvg_proxy_fresh_bars = input.int(3, "Окно свежести FVG (баров)", minval=1, maxval=20, inline="e3f11", group=grp_e3_f11, tooltip="Сколько баров после FVG Reaction ещё разрешено засчитывать Own-Level Confluence.")

grp_e3_f12 = "Engine LTF3 (5m) — Ф12. Compression Own-Level Confluence"
e3_use_sd_own          = input.bool(true, "Включить", inline="e3f12", group=grp_e3_f12, tooltip="Compression Break сработал недавно И close на собственном POC/max-delta бине зоны.")
e3_sd_proxy_fresh_bars = input.int(3, "Окно свежести Compression (баров)", minval=1, maxval=20, inline="e3f12", group=grp_e3_f12, tooltip="Сколько баров после Compression Break ещё разрешено засчитывать Own-Level Confluence.")

e3_ob_atr_mult   = f_pr_mult(e3_ob_atr_mult_raw, 3)
e3_ob_vol_mult   = f_pr_mult(e3_ob_vol_mult_raw, 3)
e3_fvg_thr       = f_pr_mult(e3_fvg_thr_raw, 3)
e3_fvg_vol_mult  = f_pr_mult(e3_fvg_vol_mult_raw, 3)
e3_hm_vol_mult   = f_pr_mult(e3_hm_vol_mult_raw, 3)
e3_sd_body_mult  = f_pr_mult(e3_sd_body_mult_raw, 3)
e3_sd_base_mult  = f_pr_base_mult(e3_sd_base_mult_raw, 3)
e3_min_score     = f_pr_score(qa_min_ltf3, 3)
[e3_w_struct, e3_w_volume, e3_w_pattern] = f_pr_apply_focus(qa_w_struct_ltf3, qa_w_volume_ltf3, qa_w_pattern_ltf3)

