if barstate.islast
    for obj in bin.ln
        obj.delete()
    for obj in bin.lb
        obj.delete()
    for obj in bin.bx
        obj.delete()
    for obj in bin.lf
        obj.delete()
    bin.ln.clear()
    bin.lb.clear()
    bin.bx.clear()
    bin.lf.clear()

method txSz(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        "Auto"   => size.auto
        => size.auto

f_IDMIDX(bool use_max, int loc) =>
    float min = 99999999.
    float max = 0.
    int   idx = 0
    int limit = math.min(bar_index - loc, 200)
    if use_max
        for i = 0 to limit
            max := math.max(high[i], max)
            min := max == high[i] ? low[i]  : min
            idx := max == high[i] ? i       : idx
    else
        for i = 0 to limit
            min := math.min(low[i], min)
            max := min == low[i]  ? high[i] : max
            idx := min == low[i]  ? i       : idx
    idx

method find(structure ms, bool use_max, bool sweep, bool useob) =>
    float min    = 99999999.
    float max    = 0.
    int   idx    = 0
    int   limit  = math.min(bar_index - ms.xloc, 200)
    int   loop_e = (limit - 1) > 0 ? limit - 1 : limit
    if use_max
        for i = 0 to loop_e
            max := math.max(high[i], max)
            min := max == high[i] ? low[i]  : min
            idx := max == high[i] ? i       : idx
        if useob and high[idx + 1] > high[idx]
            max := high[idx + 1], min := low[idx + 1], idx := idx + 1
    else
        for i = 0 to loop_e
            min := math.min(low[i], min)
            max := min == low[i]  ? high[i] : max
            idx := min == low[i]  ? i       : idx
        if useob and low[idx + 1] < low[idx]
            max := high[idx + 1], min := low[idx + 1], idx := idx + 1
    idx

method fnOB(ob[] block, bool bull, float cords, int idx) =>
    switch bull
        true =>
            blobenter.normal  := false
            blobenter.breaker := false
            block.unshift(ob.new(true, cords, low[idx], math.avg(cords, low[idx]), time[idx], bb_obupcs, volume[idx], close[idx] > open[idx] ? 1 : -1, 1, 1, 1, time[idx], time[idx], false, time[idx], 0, 0.0, bar_index[idx]))
        false =>
            brobenter.normal  := false
            brobenter.breaker := false
            block.unshift(ob.new(false, high[idx], cords, math.avg(cords, high[idx]), time[idx], bb_obdncs, volume[idx], close[idx] > open[idx] ? 1 : -1, 1, 1, 1, time[idx], time[idx], false, time[idx], 0, 0.0, bar_index[idx]))

method mitigated(ob[] block) =>
    if barstate.isconfirmed and block.size() > 0
        for i = block.size() - 1 to 0
            stuff = block.get(i)
            if not stuff.isbb
                switch stuff.bull
                    true =>
                        if bb_obmiti == "Close" ? math.min(close, open) < stuff.btm : bb_obmiti == "Wick" ? low < stuff.btm : bb_obmiti == "Avg" ? low < stuff.avg : false
                            f_davg_push(davg_buf_ob, stuff.lastMaxDelta, davg_lookback_n)
                            stuff.isbb := true, stuff.bbloc := time
                            if not bb_obshowbb
                                block.remove(i)
                    false =>
                        if bb_obmiti == "Close" ? math.max(close, open) > stuff.top : bb_obmiti == "Wick" ? high > stuff.top : bb_obmiti == "Avg" ? high > stuff.avg : false
                            f_davg_push(davg_buf_ob, stuff.lastMaxDelta, davg_lookback_n)
                            stuff.isbb := true, stuff.bbloc := time
                            if not bb_obshowbb
                                block.remove(i)
            else
                switch stuff.bull
                    true =>
                        if bb_obmiti == "Close" ? math.max(close, open) > stuff.top : bb_obmiti == "Wick" ? high > stuff.top : bb_obmiti == "Avg" ? high > stuff.avg : false
                            f_davg_push(davg_buf_breaker, stuff.lastMaxDelta, davg_lookback_n)
                            block.remove(i)
                    false =>
                        if bb_obmiti == "Close" ? math.min(close, open) < stuff.btm : bb_obmiti == "Wick" ? low < stuff.btm : bb_obmiti == "Avg" ? low < stuff.avg : false
                            f_davg_push(davg_buf_breaker, stuff.lastMaxDelta, davg_lookback_n)
                            block.remove(i)

f_zones_overlap(float t1, float b1, float t2, float b2) =>
    (b1 > b2 and b1 < t2) or (t1 < t2 and b1 > b2) or (t1 > t2 and b1 < b2) or (t1 < t2 and t1 > b2)

f_overlap(ob[] bull, ob[] bear) =>
    if bull.size() > 1
        for i = bull.size() - 1 to 1
            stuff = bull.get(i), current = bull.get(0)
            if f_zones_overlap(stuff.top, stuff.btm, current.top, current.btm)
                bull.remove(bb_wichlap == "Recent" ? i : 0)
    if bear.size() > 1
        for i = bear.size() - 1 to 1
            stuff = bear.get(i), current = bear.get(0)
            if f_zones_overlap(stuff.top, stuff.btm, current.top, current.btm)
                bear.remove(bb_wichlap == "Recent" ? i : 0)
    if bull.size() > 0 and bear.size() > 0
        for i = bull.size() - 1 to 0
            stuff = bull.get(i), current = bear.get(0)
            if f_zones_overlap(stuff.top, stuff.btm, current.top, current.btm)
                bull.remove(bb_wichlap == "Recent" ? 0 : i)
    if bull.size() > 0 and bear.size() > 0
        for i = bear.size() - 1 to 0
            stuff = bear.get(i), current = bull.get(0)
            if f_zones_overlap(stuff.top, stuff.btm, current.top, current.btm)
                bear.remove(bb_wichlap == "Recent" ? 0 : i)

method umt(ob metric) =>
    switch metric.dir
        1 =>
            switch metric.move
                1 => metric.blPOS += 1, metric.move := 2
                2 => metric.blPOS += 1, metric.move := 3
                3 => metric.brPOS += 1, metric.move := 1
        -1 =>
            switch metric.move
                1 => metric.brPOS += 1, metric.move := 2
                2 => metric.brPOS += 1, metric.move := 3
                3 => metric.blPOS += 1, metric.move := 1
    if (time - time[1]) == (time[1] - time[2])
        metric.xlocbl := metric.loc + (time - time[1]) * metric.blPOS
        metric.xlocbr := metric.loc + (time - time[1]) * metric.brPOS
f_display(ob id, ob[] full, int i, float p_ob_bull_avg, float p_ob_bear_avg, float p_brk_bull_avg, float p_brk_bear_avg, bool p_in_sd) =>
    if not id.isbb
        bin.bx.unshift(box.new(top=id.top, bottom=id.btm, left=id.loc, right=time, border_color=na, bgcolor=f_dim(id.css), xloc=xloc.bar_time))
        bin.bx.unshift(box.new(top=id.top, bottom=id.btm, left=time, right=time + 1, border_color=na, bgcolor=f_dim(id.css), xloc=xloc.bar_time, extend=extend.right))
    else
        bin.bx.unshift(box.new(top=id.top, bottom=id.btm, left=id.loc, right=id.bbloc, border_color=na, bgcolor=f_dim(id.css), xloc=xloc.bar_time))
        bin.bx.unshift(box.new(top=id.top, bottom=id.btm, left=id.bbloc, right=time, border_color=f_dim(id.css), bgcolor=f_dim(id.bull ? bb_bbup : bb_bbdn), xloc=xloc.bar_time, border_width=2))
        bin.bx.unshift(box.new(top=id.top, bottom=id.btm, left=time, right=time + 1, border_color=f_dim(id.css), bgcolor=f_dim(id.bull ? bb_bbup : bb_bbdn), xloc=xloc.bar_time, extend=extend.right))
    if bb_obshowactivity
        bin.bx.unshift(box.new(top=id.top, bottom=id.avg, left=id.loc, right=id.xlocbl, border_color=na, bgcolor=f_dim(bb_obactup), xloc=xloc.bar_time))
        bin.bx.unshift(box.new(top=id.avg, bottom=id.btm, left=id.loc, right=id.xlocbr, border_color=na, bgcolor=f_dim(bb_obactdn), xloc=xloc.bar_time))

    if bb_show_name_label
        int   nameX = int(math.avg(id.loc, id.isbb ? id.bbloc : time))
        float nameY = math.avg(id.top, id.btm)
        bin.lb.unshift(label.new(nameX, nameY, id.isbb ? "Breaker" : "OB", xloc=xloc.bar_time, style=label.style_label_center, color=color.new(color.white, 100), textcolor=f_dim(bb_name_label_color), size=bb_name_label_size == "Tiny" ? size.tiny : bb_name_label_size == "Normal" ? size.normal : size.small, textalign=text.align_center))

    int   obState    = id.isbb ? 3 : (id.touches > 0 ? 2 : 1)
    int   obFresh    = math.min((bar_index - id.barCreated) / 5, 9)
    int   obFlags    = 0
    int   obDeltaSign = 2
    int   obAboveAvg = 0
    bool  ob_is_fresh_now = false

    if dva_show_delta or dva_show_own_va
        float barDurMs   = time - time[1]
        float boxWidthMs = math.max(bb_extend_bars * barDurMs, barDurMs)
        int   obLookback = barDurMs > 0 ? int((time - id.loc) / barDurMs) : bb_swingLimit
        obLookback := math.max(obLookback, bb_swingLimit)
        obLookback := math.min(obLookback, 2000)
        [obDeltaBull, obDeltaBear] = f_delta_profile_generic(id.btm, id.top, obLookback, dva_delta_bins)
        float obStep   = (id.top - id.btm) / dva_delta_bins
        float obMaxAbs = 0.0
        int   obMaxIdx = -1
        bool  obMaxIsBull = true
        for bnk = 0 to dva_delta_bins - 1
            float d0 = array.get(obDeltaBull, bnk) - array.get(obDeltaBear, bnk)
            if math.abs(d0) > obMaxAbs
                obMaxAbs := math.abs(d0)
                obMaxIdx := bnk
                obMaxIsBull := d0 >= 0
        id.lastMaxDelta := obMaxAbs
        obDeltaSign := obMaxAbs > 0 ? (obMaxIsBull ? 1 : 0) : 2

        bool ob_isOver_now = false
        if obMaxAbs > 0
            [ob_isOver_chk, ob_pct_chk] = f_davg_excess(obMaxAbs, id.isbb ? davg_buf_breaker : davg_buf_ob)
            ob_isOver_now := ob_isOver_chk
            ob_is_fresh_now := ob_isOver_now and not id.wasAboveAvg
        id.wasAboveAvg := ob_isOver_now

        int closeBinIdx = obStep > 0 ? math.max(0, math.min(dva_delta_bins - 1, int((close - id.btm) / obStep))) : -1
        if obMaxIdx >= 0 and closeBinIdx == obMaxIdx
            obFlags += 4

        if dva_show_delta and obMaxAbs > 0
            for bnk = 0 to dva_delta_bins - 1
                float bandLo = id.btm + obStep * bnk
                float bandHi = bandLo + obStep
                float d = array.get(obDeltaBull, bnk) - array.get(obDeltaBear, bnk)
                if d != 0 and not f_dva_level_eaten(math.avg(bandLo, bandHi))
                    float widthMs = math.min((math.abs(d) / obMaxAbs) * dva_delta_max_width * barDurMs, boxWidthMs)
                    color dcol = d >= 0 ? dva_delta_bull_color : dva_delta_bear_color
                    bool  isMaxBin = bnk == obMaxIdx
                    color borderCol = isMaxBin ? dva_max_border_color : color.new(dcol, 0)
                    int   borderW   = isMaxBin ? dva_max_border_width : 1
                    bin.bx.unshift(box.new(id.loc, bandHi, id.loc + int(widthMs), bandLo, border_color=f_dim(borderCol), border_width=borderW, bgcolor=f_dim(dcol), xloc=xloc.bar_time, text=dva_show_delta_text ? "Δ" + str.tostring(d, format.volume) : "", text_color=f_dim(dva_delta_text_color), text_size=f_dva_txsz(dva_delta_text_size), text_halign=text.align_left))
                    if isMaxBin
                        if ob_isOver_now
                            obAboveAvg := ob_is_fresh_now ? 2 : 1
                            [ob_isOver_lbl, ob_pct] = f_davg_excess(obMaxAbs, id.isbb ? davg_buf_breaker : davg_buf_ob)
                            bin.lb.unshift(label.new(id.loc + int(widthMs), math.avg(bandLo, bandHi), (ob_is_fresh_now ? "🆕+" : "+") + str.tostring(ob_pct, "#.#") + "%", xloc=xloc.bar_time, style=label.style_label_right, color=color.new(color.white, 100), textcolor=f_dim(davg_color), size=f_dva_txsz(davg_text_size)))
                        if davg2_enable
                            float davg2_ref = id.isbb ? (d >= 0 ? p_brk_bull_avg : p_brk_bear_avg) : (d >= 0 ? p_ob_bull_avg : p_ob_bear_avg)
                            if not na(davg2_ref) and davg2_ref > 0 and obMaxAbs > davg2_ref
                                float davg2_pct = (obMaxAbs / davg2_ref - 1) * 100
                                bin.lb.unshift(label.new(id.loc + int(widthMs / 2), math.avg(bandLo, bandHi), "+" + str.tostring(davg2_pct, "#.#") + "%", xloc=xloc.bar_time, style=label.style_label_center, color=color.new(color.white, 100), textcolor=f_dim(davg2_color), size=f_dva_txsz(davg2_text_size)))

        if dva_show_own_va
            float obTotalVol = obDeltaBull.sum() + obDeltaBear.sum()
            if obTotalVol > 0
                float obMaxTot = 0.0
                int   obPocIdx = 0
                for r = 0 to dva_delta_bins - 1
                    float tot = array.get(obDeltaBull, r) + array.get(obDeltaBear, r)
                    if tot > obMaxTot
                        obMaxTot := tot
                        obPocIdx := r
                [obVaLo, obVaHi] = f_calc_value_area(obDeltaBull, obDeltaBear, dva_delta_bins, obPocIdx, obTotalVol, dva_own_va_threshold)
                float obOwnPoc = id.btm + obStep * (obPocIdx + 0.5)
                float obOwnVal = id.btm + obStep * obVaLo
                float obOwnVah = id.btm + obStep * (obVaHi + 1)

                if closeBinIdx == obPocIdx
                    obFlags += 2

                if not f_dva_level_eaten(obOwnPoc)
                    [obPocMs, obPocIsMax] = f_dva_bin_match_ms(obOwnPoc, id.btm, id.top, dva_delta_bins, obDeltaBull, obDeltaBear, obMaxIdx, obMaxAbs, dva_delta_max_width, barDurMs, boxWidthMs)
                    bin.ln.unshift(line.new(id.loc, obOwnPoc, id.loc + obPocMs, obOwnPoc, color=f_dim(dva_poc_line_color), width=dva_poc_line_width, xloc=xloc.bar_time, style=obPocIsMax ? line.style_solid : line.style_dashed))
                    bin.lb.unshift(label.new(id.loc, obOwnPoc, "POC " + str.tostring(obOwnPoc, format.mintick), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white,100), textcolor=f_dim(dva_poc_line_color), size=f_dva_txsz(dva_va_text_size)))
                if not f_dva_level_eaten(obOwnVal)
                    [obValMs, obValIsMax] = f_dva_bin_match_ms(obOwnVal, id.btm, id.top, dva_delta_bins, obDeltaBull, obDeltaBear, obMaxIdx, obMaxAbs, dva_delta_max_width, barDurMs, boxWidthMs)
                    bin.ln.unshift(line.new(id.loc, obOwnVal, id.loc + obValMs, obOwnVal, color=f_dim(dva_val_line_color), width=dva_val_line_width, xloc=xloc.bar_time, style=obValIsMax ? line.style_solid : line.style_dashed))
                    bin.lb.unshift(label.new(id.loc, obOwnVal, "VAL " + str.tostring(obOwnVal, format.mintick), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white,100), textcolor=f_dim(dva_val_line_color), size=f_dva_txsz(dva_va_text_size)))
                if not f_dva_level_eaten(obOwnVah)
                    [obVahMs, obVahIsMax] = f_dva_bin_match_ms(obOwnVah, id.btm, id.top, dva_delta_bins, obDeltaBull, obDeltaBear, obMaxIdx, obMaxAbs, dva_delta_max_width, barDurMs, boxWidthMs)
                    bin.ln.unshift(line.new(id.loc, obOwnVah, id.loc + obVahMs, obOwnVah, color=f_dim(dva_vah_line_color), width=dva_vah_line_width, xloc=xloc.bar_time, style=obVahIsMax ? line.style_solid : line.style_dashed))
                    bin.lb.unshift(label.new(id.loc, obOwnVah, "VAH " + str.tostring(obOwnVah, format.mintick), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white,100), textcolor=f_dim(dva_vah_line_color), size=f_dva_txsz(dva_va_text_size)))

    if p_in_sd
        obFlags += 1

    int obPackCode = f_ob_pack_encode(obState, id.touches, obFresh, obFlags, obDeltaSign, obAboveAvg)
    [obPackCode, ob_is_fresh_now]

var float g_ob_candidate_top_bull = na
var float g_ob_candidate_btm_bull = na
var float g_ob_candidate_top_bear = na
var float g_ob_candidate_btm_bear = na

f_bb_structure(color upcss, color dncss, bool draw, bool internal, int limit, bool sd_in_demand, bool sd_in_supply) =>
    var structure ms     = structure.new(start=0)
    var ob[]      blob   = array.new<ob>()
    var ob[]      bearob = array.new<ob>()
    var drawms[]  bldw   = array.new<drawms>()
    var drawms[]  brdw   = array.new<drawms>()
    bool crossup = false
    bool crossdn = false
    var float up = na
    var float dn = na

    int local_ob_pack_bull      = 0
    int local_ob_pack_bear      = 0
    bool local_da_ob_fresh_bull = false
    bool local_da_ob_fresh_bear = false

    int idbull = ms.find(false, false, true)
    int idbear = ms.find(true,  false, true)

    float btmP = bb_obmode == "Length" ? (high[idbear] - 1 * bb_atr[idbear]) < low[idbear] ? low[idbear] : (high[idbear] - 1 * bb_atr[idbear]) : low[idbear]
    float topP = bb_obmode == "Length" ? (low[idbull]  + 1 * bb_atr[idbull]) > high[idbull] ? high[idbull] : (low[idbull]  + 1 * bb_atr[idbull]) : high[idbull]

    float cand_top_bull = topP
    float cand_btm_bull = low[idbull]
    float cand_top_bear = high[idbear]
    float cand_btm_bear = btmP

    var int ind_last_ob_bull_bar = -1
    var int ind_last_ob_bear_bar = -1
    float ind_atr     = ta.atr(bb_len)
    float ind_vol_sma = ta.sma(volume, 20)
    bool  ind_disp_up = (close > open) and (math.abs(close - open) > ind_atr * 1.0) and (volume > ind_vol_sma * 1.3) and (close > high[1])
    bool  ind_disp_dn = (close < open) and (math.abs(close - open) > ind_atr * 1.0) and (volume > ind_vol_sma * 1.3) and (close < low[1])
    if bb_obshow and barstate.isconfirmed and ind_disp_up and (bar_index - ind_last_ob_bull_bar) > 1
        blob.fnOB(true, topP, idbull)
        ind_last_ob_bull_bar := bar_index
    if bb_obshow and barstate.isconfirmed and ind_disp_dn and (bar_index - ind_last_ob_bear_bar) > 1
        bearob.fnOB(false, btmP, idbear)
        ind_last_ob_bear_bar := bar_index

    float ph = ta.pivothigh(high, bb_mslen, bb_mslen)
    float pl = ta.pivotlow (low,  bb_mslen, bb_mslen)
    var int[]   phn = array.new<int>(1,   na)
    var int[]   pln = array.new<int>(1,   na)
    var float[] php = array.new<float>(1, na)
    var float[] plp = array.new<float>(1, na)

    if internal
        blob.clear(), bearob.clear()

    if not na(ph)
        phn.unshift(bar_index[bb_mslen]), php.unshift(high[bb_mslen])
    if not na(pl)
        pln.unshift(bar_index[bb_mslen]), plp.unshift(low[bb_mslen])

    if php.size() > 0 and high > php.get(0)
        php.clear(), phn.clear()
    if plp.size() > 0 and low < plp.get(0)
        plp.clear(), pln.clear()

    if na(up)
        up := high
    if na(dn)
        dn := low

    if high > up
        up := high, dn := low, crossup := true
    if low  < dn
        up := high, dn := low, crossdn := true

    if ms.start == 0
        ms := structure.new(bar_index, na, high, low, bar_index, bar_index, 0, 1, na, bar_index)
        if draw
            bldw.unshift(drawms.new(time, time, high, "CHoCH", upcss, line.style_dashed))
            brdw.unshift(drawms.new(time, time, low,  "CHoCH", dncss, line.style_dashed))

    ms.upsweep := false
    ms.dnsweep := false

    if ms.start == 1
        switch
            low <= ms.choch and close >= ms.choch and bb_buildsweep =>
                ms.dnsweep := true, ms.choch := low, ms.xloc := bar_index
                if draw
                    drawms t = brdw.get(0)
                    t.x2 := time, t.style := line.style_dotted, t.txt := "x"
                    brdw.unshift(drawms.new(time, time, low, "CHoCH", dncss, line.style_dashed))
            high >= ms.bos and close <= ms.bos and bb_buildsweep =>
                ms.upsweep := true, ms.bos := high, ms.xloc := bar_index
                if draw
                    drawms t = bldw.get(0)
                    t.x2 := time, t.style := line.style_dotted, t.txt := "x"
                    bldw.unshift(drawms.new(time, time, high, "CHoCH", upcss, line.style_dashed))
            close <= ms.choch =>
                ms.txt := "choch", lc.start := true, lc.count := 0
                blob.fnOB(true, topP, idbull)
                ms.trend := -1, ms.choch := ms.bos, ms.bos := na, ms.start := 2
                ms.loc := bar_index, ms.main := low, ms.temp := ms.loc, ms.xloc := bar_index
                if draw
                    drawms t = brdw.get(0)
                    t.x2 := time, t.style := internal ? line.style_dashed : line.style_solid
            close >= ms.bos =>
                ms.txt := "choch", lc.start := true, lc.count := 0
                bearob.fnOB(false, btmP, idbear)
                ms.trend := 1, ms.bos := na, ms.start := 2
                ms.loc := bar_index, ms.main := high, ms.temp := ms.loc, ms.xloc := bar_index
                if draw
                    drawms t = bldw.get(0)
                    t.x2 := time, t.style := internal ? line.style_dashed : line.style_solid

    if ms.start == 2
        switch ms.trend
            -1 =>
                if low <= ms.main
                    ms.main := low, ms.temp := bar_index
                if not na(ms.bos) and bb_msmode == "Adjusted Points" and php.size() > 0
                    if php.get(0) < ms.choch
                        ms.choch := php.get(0), ms.loc := phn.get(0), ms.xloc := phn.get(0), ms.temp := phn.get(0)
                        if draw
                            drawms t = bldw.get(0)
                            t.x1 := time[bar_index - phn.get(0)], t.x2 := time, t.y := php.get(0)
                if na(ms.bos) and crossup and close > open and close[1] > open[1]
                    ms.bos := ms.main, ms.loc := ms.temp, ms.xloc := ms.loc
                    if draw
                        brdw.unshift(drawms.new(time[bar_index - ms.loc], time, low[bar_index - ms.loc], "BOS", dncss, line.style_dashed))
                if not na(ms.bos) and draw
                    drawms t1 = brdw.get(0), t1.x2 := time
                if draw
                    drawms t2 = bldw.get(0), t2.x2 := time
                switch
                    low <= ms.bos and close >= ms.bos and not na(ms.bos) and bb_buildsweep =>
                        ms.dnsweep := true, ms.bos := low, ms.xloc := bar_index
                        if draw
                            drawms t = brdw.get(0)
                            t.x2 := time, t.style := line.style_dotted, t.txt := "x"
                            brdw.unshift(drawms.new(time, time, low, "BOS", dncss, line.style_dashed))
                    close <= ms.bos and not na(ms.bos) =>
                        ms.txt := "bos", ms.zz := ms.bos, ms.zn := bar_index
                        lc.start := true, lc.count := 0
                        bearob.fnOB(false, btmP, idbear)
                        int id = ms.find(true, false, false)
                        ms.xloc := bar_index, ms.bos := na, ms.choch := high[id], ms.loc := bar_index[id]
                        if draw
                            drawms t1 = brdw.get(0)
                            t1.x2 := time, t1.style := internal ? line.style_dashed : line.style_solid
                            drawms t2 = bldw.get(0)
                            t2.x1 := time[id], t2.x2 := time, t2.y := high[id]
                    high >= ms.choch and close <= ms.choch and bb_buildsweep =>
                        ms.upsweep := true, ms.choch := high, ms.xloc := bar_index
                        if draw
                            drawms t = bldw.get(0)
                            t.x2 := time, t.style := line.style_dotted, t.txt := "x"
                            bldw.unshift(drawms.new(time, time, high, "CHoCH", upcss, line.style_dashed))
                    close >= ms.choch =>
                        ms.txt := "choch", ms.zz := ms.choch, ms.zn := bar_index
                        lc.start := true, lc.count := 0
                        blob.fnOB(true, topP, idbull)
                        int id = ms.find(false, false, false)
                        if na(ms.bos)
                            ms.choch := low[id]
                            if draw
                                brdw.unshift(drawms.new(time, time, low, "BOS", dncss, line.style_dashed))
                                drawms t = brdw.get(0), t.x1 := time[bar_index - ms.temp]
                        else
                            ms.choch := ms.bos
                        ms.bos := na, ms.main := high, ms.trend := 1
                        ms.loc := bar_index, ms.xloc := bar_index, ms.temp := ms.loc
                        if draw
                            drawms tc = bldw.get(0)
                            tc.x2 := time, tc.txt := "CHoCH", tc.style := internal ? line.style_dashed : line.style_solid
                            drawms tc2 = brdw.get(0)
                            tc2.x2 := time, tc2.y := ms.choch, tc2.txt := "CHoCH"
                        ms.xloc := bar_index, blarea.normal := false
            1 =>
                if high >= ms.main
                    ms.main := high, ms.temp := bar_index
                if na(ms.bos) and crossdn and close < open and close[1] < open[1]
                    ms.bos := ms.main, ms.loc := ms.temp, ms.xloc := ms.loc
                    if draw
                        bldw.unshift(drawms.new(time[bar_index - ms.loc], time, high[bar_index - ms.loc], "BOS", upcss, line.style_dashed))
                if not na(ms.bos) and bb_msmode == "Adjusted Points" and plp.size() > 0
                    if plp.get(0) > ms.choch
                        ms.choch := plp.get(0), ms.loc := pln.get(0), ms.xloc := pln.get(0), ms.temp := pln.get(0)
                        if draw
                            drawms t = brdw.get(0)
                            t.x1 := time[bar_index - pln.get(0)], t.x2 := time, t.y := plp.get(0)
                if not na(ms.bos) and draw
                    drawms t1 = bldw.get(0), t1.x2 := time
                if draw
                    drawms t2 = brdw.get(0), t2.x2 := time
                switch
                    high >= ms.bos and close <= ms.bos and not na(ms.bos) and bb_buildsweep =>
                        ms.upsweep := true, ms.bos := high, ms.xloc := bar_index
                        if draw
                            drawms t = bldw.get(0)
                            t.x2 := time, t.style := line.style_dotted, t.txt := "x"
                            bldw.unshift(drawms.new(time, time, high, "BOS", upcss, line.style_dashed))
                    close >= ms.bos and not na(ms.bos) =>
                        ms.txt := "bos", ms.zz := ms.bos, ms.zn := bar_index
                        lc.start := true, lc.count := 0
                        blob.fnOB(true, topP, idbull)
                        int id = ms.find(false, false, false)
                        ms.xloc := bar_index, ms.bos := na, ms.choch := low[id], ms.loc := bar_index[id]
                        if draw
                            drawms t1 = bldw.get(0)
                            t1.x2 := time, t1.style := internal ? line.style_dashed : line.style_solid
                            drawms t2 = brdw.get(0)
                            t2.x1 := time[id], t2.x2 := time, t2.y := low[id]
                    low <= ms.choch and close >= ms.choch and bb_buildsweep =>
                        ms.dnsweep := true, ms.choch := low, ms.xloc := bar_index
                        if draw
                            drawms t = brdw.get(0)
                            t.x2 := time, t.style := line.style_dotted, t.txt := "x"
                            brdw.unshift(drawms.new(time, time, low, "CHoCH", dncss, line.style_dashed))
                    close <= ms.choch =>
                        ms.txt := "choch", ms.zz := ms.choch, ms.zn := bar_index
                        lc.start := true, lc.count := 0
                        bearob.fnOB(false, btmP, idbear)
                        int id = ms.find(true, false, false)
                        if na(ms.bos)
                            ms.choch := high[id]
                            if draw
                                bldw.unshift(drawms.new(time, time, high, "BOS", upcss, line.style_dashed))
                                drawms t = bldw.get(0), t.x1 := time[bar_index - ms.temp]
                        else
                            ms.choch := ms.bos
                        ms.bos := na, ms.main := low, ms.trend := -1
                        ms.loc := bar_index, ms.temp := ms.loc
                        if draw
                            drawms tc = brdw.get(0)
                            tc.x2 := time, tc.txt := "CHoCH", tc.style := internal ? line.style_dashed : line.style_solid
                            drawms tc2 = bldw.get(0)
                            tc2.y := ms.choch, tc2.x2 := time, tc2.txt := "CHoCH"
                        ms.xloc := bar_index

    if blob.size() > 0 and not blob.get(0).isbb and low < blob.get(0).top
        blobenter.normal := true
    else if blob.size() > 0 and blob.get(0).isbb and high > blob.get(0).btm
        blobenter.breaker := true
    if bearob.size() > 0 and not bearob.get(0).isbb and high > bearob.get(0).btm
        brobenter.normal := true
    else if bearob.size() > 0 and bearob.get(0).isbb and low < bearob.get(0).top
        brobenter.breaker := true

    if bb_obshow
        if barstate.isconfirmed
            blob.mitigated(), bearob.mitigated()
            if bb_overlap
                f_overlap(blob, bearob)
        if blob.size() > 0
            for metric in blob
                metric.umt()
        if bearob.size() > 0
            for metric in bearob
                metric.umt()
        if barstate.islast
            float ob_bull_avg_calc  = na
            float ob_bear_avg_calc  = na
            float brk_bull_avg_calc = na
            float brk_bear_avg_calc = na
            if davg2_enable
                float ob_bull_sum  = 0.0
                int   ob_bull_cnt  = 0
                float ob_bear_sum  = 0.0
                int   ob_bear_cnt  = 0
                float brk_bull_sum = 0.0
                int   brk_bull_cnt = 0
                float brk_bear_sum = 0.0
                int   brk_bear_cnt = 0
                int   davg2_lb = math.max(bb_extend_bars, bb_swingLimit)
                if blob.size() > 0
                    for i = 0 to blob.size() - 1
                        ob it2 = blob.get(i)
                        [mAbs2, isBull2] = f_measure_delta_max(it2.btm, it2.top, davg2_lb, dva_delta_bins)
                        if mAbs2 > 0
                            if it2.isbb
                                if isBull2
                                    brk_bull_sum += mAbs2, brk_bull_cnt += 1
                                else
                                    brk_bear_sum += mAbs2, brk_bear_cnt += 1
                            else
                                if isBull2
                                    ob_bull_sum += mAbs2, ob_bull_cnt += 1
                                else
                                    ob_bear_sum += mAbs2, ob_bear_cnt += 1
                if bearob.size() > 0
                    for i = 0 to bearob.size() - 1
                        ob it2 = bearob.get(i)
                        [mAbs2, isBull2] = f_measure_delta_max(it2.btm, it2.top, davg2_lb, dva_delta_bins)
                        if mAbs2 > 0
                            if it2.isbb
                                if isBull2
                                    brk_bull_sum += mAbs2, brk_bull_cnt += 1
                                else
                                    brk_bear_sum += mAbs2, brk_bear_cnt += 1
                            else
                                if isBull2
                                    ob_bull_sum += mAbs2, ob_bull_cnt += 1
                                else
                                    ob_bear_sum += mAbs2, ob_bear_cnt += 1
                ob_bull_avg_calc  := ob_bull_cnt  > 0 ? ob_bull_sum  / ob_bull_cnt  : na
                ob_bear_avg_calc  := ob_bear_cnt  > 0 ? ob_bear_sum  / ob_bear_cnt  : na
                brk_bull_avg_calc := brk_bull_cnt > 0 ? brk_bull_sum / brk_bull_cnt : na
                brk_bear_avg_calc := brk_bear_cnt > 0 ? brk_bear_sum / brk_bear_cnt : na
            local_ob_pack_bull := 0
            local_ob_pack_bear := 0
            local_da_ob_fresh_bull := false
            local_da_ob_fresh_bear := false
            if blob.size() > 0
                for i = 0 to blob.size() - 1
                    ob item = blob.get(i)
                    [item_pack_b, item_fresh_b] = f_display(item, blob, i, ob_bull_avg_calc, ob_bear_avg_calc, brk_bull_avg_calc, brk_bear_avg_calc, sd_in_demand)
                    local_ob_pack_bull := item_pack_b
                    if item_fresh_b
                        local_da_ob_fresh_bull := true
            if bearob.size() > 0
                for i = 0 to bearob.size() - 1
                    ob item = bearob.get(i)
                    [item_pack_s, item_fresh_s] = f_display(item, bearob, i, ob_bull_avg_calc, ob_bear_avg_calc, brk_bull_avg_calc, brk_bear_avg_calc, sd_in_supply)
                    local_ob_pack_bear := item_pack_s
                    if item_fresh_s
                        local_da_ob_fresh_bear := true

    if barstate.islast and draw and bldw.size() > 0 and brdw.size() > 0
        for i = 0 to bldw.size() - 1
            obj = bldw.get(i)
            if i <= limit
                bin.ln.unshift(line.new(x1=obj.x1, x2=obj.x2, y1=obj.y, y2=obj.y, color=f_dim(obj.css), style=obj.style, xloc=xloc.bar_time))
                bin.lb.unshift(label.new(x=int(math.avg(bin.ln.get(0).get_x1(), bin.ln.get(0).get_x2())), y=obj.y, xloc=xloc.bar_time, color=invcol, style=label.style_label_down, textcolor=f_dim(obj.css), size=bb_mstext.txSz(), text=obj.txt))
        for i = 0 to brdw.size() - 1
            obj = brdw.get(i)
            if i <= limit
                bin.ln.unshift(line.new(x1=obj.x1, x2=obj.x2, y1=obj.y, y2=obj.y, color=f_dim(obj.css), style=obj.style, xloc=xloc.bar_time))
                bin.lb.unshift(label.new(x=int(math.avg(bin.ln.get(0).get_x1(), bin.ln.get(0).get_x2())), y=obj.y, xloc=xloc.bar_time, color=invcol, style=label.style_label_up, textcolor=f_dim(obj.css), size=bb_mstext.txSz(), text=obj.txt))

    int current_ob_signal = 0, int current_ob_touch = 0, int current_bb_signal = 0
    if blob.size() > 0
        for i = 0 to blob.size() - 1
            ob obb = blob.get(i)
            if not obb.isbb and close <= obb.top and close >= obb.btm
                current_ob_signal := 1
                if obb.touches == 0
                    current_ob_touch := 1
                obb.touches += 1
            if obb.isbb and close <= obb.top and close >= obb.btm
                current_bb_signal := 1
    if bearob.size() > 0
        for i = 0 to bearob.size() - 1
            ob obb = bearob.get(i)
            if not obb.isbb and close <= obb.top and close >= obb.btm
                current_ob_signal := -1
                if obb.touches == 0
                    current_ob_touch := -1
                obb.touches += 1
            if obb.isbb and close <= obb.top and close >= obb.btm
                current_bb_signal := -1

    float bull_prox = na, float bear_prox = na
    float bull_ob_top = na, float bear_ob_bot = na
    if blob.size() > 0
        for i = 0 to blob.size() - 1
            ob item = blob.get(i)
            if not item.isbb and close > item.btm
                bull_prox := item.btm, bull_ob_top := item.top, break
    if bearob.size() > 0
        for i = 0 to bearob.size() - 1
            ob item = bearob.get(i)
            if not item.isbb and close < item.top
                bear_prox := item.top, bear_ob_bot := item.btm, break

    int bull_ob_touch_count = 0
    int bear_ob_touch_count = 0
    if blob.size() > 0
        ob nearest_bull = blob.get(0)
        bull_ob_touch_count := nearest_bull.touches
    if bearob.size() > 0
        ob nearest_bear = bearob.get(0)
        bear_ob_touch_count := nearest_bear.touches

    bool ob_in_sd_bull = false
    bool ob_in_sd_bear = false
    if blob.size() > 0
        ob item = blob.get(0)
        if not item.isbb
            ob_in_sd_bull := sd_in_demand and close >= item.btm and close <= item.top
    if bearob.size() > 0
        ob item = bearob.get(0)
        if not item.isbb
            ob_in_sd_bear := sd_in_supply and close >= item.btm and close <= item.top

    [ms, current_ob_signal, current_ob_touch, current_bb_signal, bull_prox, bear_prox,
     bull_ob_touch_count, bear_ob_touch_count, ob_in_sd_bull, ob_in_sd_bear, bull_ob_top, bear_ob_bot,
     cand_top_bull, cand_btm_bull, cand_top_bear, cand_btm_bear,
     local_ob_pack_bull, local_ob_pack_bear, local_da_ob_fresh_bull, local_da_ob_fresh_bear]

var demandZones = array.new<sd_info>()
var supplyZones = array.new<sd_info>()
var sdBoxes     = array.new_box()
var sdLines     = array.new_line()
var sdLabels    = array.new_label()

float sd_atr  = ta.atr(20)
float sd_body = math.abs(close - open)

bool sd_bull_disp = close[1] > open[1] and sd_body[1] > sd_atr[1] * 1.4
bool sd_bear_disp = open[1] > close[1] and sd_body[1] > sd_atr[1] * 1.4
bool sd_base_cond = math.max(sd_body[2], nz(sd_body[3], sd_body[2])) < sd_atr[2] * 0.75

float g_sd_candidate_demand_top = math.max(open[2], close[2]) + sd_atr * 0.1
float g_sd_candidate_demand_btm = math.min(open[2], close[2]) - sd_atr * 0.2
float g_sd_candidate_supply_top = math.max(open[2], close[2]) + sd_atr * 0.2
float g_sd_candidate_supply_btm = math.min(open[2], close[2]) - sd_atr * 0.1

var int  lastDemand   = 0
var int  lastSupply   = 0
var bool sd_in_demand = false
var bool sd_in_supply = false
var int  export_sd_inv = 0
export_sd_inv := 0

if en_3
    if sd_bull_disp and sd_base_cond and bar_index - lastDemand > 5
        lastDemand := bar_index
        float demand_proximal = math.max(open[2], close[2])
        float demand_distal   = math.min(open[2], close[2])
        demandZones.unshift(sd_info.new(demand_proximal + sd_atr * 0.1, demand_distal - sd_atr * 0.2, "Demand", time[2], na, false, volume[2]))
        if demandZones.size() > 30
            demandZones.pop()
    if sd_bear_disp and sd_base_cond and bar_index - lastSupply > 5
        lastSupply := bar_index
        float supply_proximal = math.min(open[2], close[2])
        float supply_distal   = math.max(open[2], close[2])
        supplyZones.unshift(sd_info.new(supply_distal + sd_atr * 0.2, supply_proximal - sd_atr * 0.1, "Supply", time[2], na, false, volume[2]))
        if supplyZones.size() > 30
            supplyZones.pop()
    if demandZones.size() > 0
        for i = 0 to demandZones.size() - 1
            curr = demandZones.get(i)
            if na(curr.breakTime) and close < curr.bottom
                if barstate.isconfirmed
                    curr.breakTime := time, export_sd_inv := -1
                    f_davg_push(davg_buf_sd, curr.lastMaxDelta, davg_lookback_n)
    if supplyZones.size() > 0
        for i = 0 to supplyZones.size() - 1
            curr = supplyZones.get(i)
            if na(curr.breakTime) and close > curr.top
                if barstate.isconfirmed
                    curr.breakTime := time, export_sd_inv := 1
                    f_davg_push(davg_buf_sd, curr.lastMaxDelta, davg_lookback_n)
    sd_in_demand := false, sd_in_supply := false
    if demandZones.size() > 0
        for i = 0 to demandZones.size() - 1
            curr = demandZones.get(i)
            if na(curr.breakTime) and close >= curr.bottom and close <= curr.top
                sd_in_demand := true
    if supplyZones.size() > 0
        for i = 0 to supplyZones.size() - 1
            curr = supplyZones.get(i)
            if na(curr.breakTime) and close >= curr.bottom and close <= curr.top
                sd_in_supply := true

var structure export_ms               = structure.new(start=0)
var int       export_ob_state         = 0
var int       export_ob_touch         = 0
var int       export_bb_signal        = 0
var float     export_bull_ob_proximal = na
var float     export_bear_ob_proximal = na
var float     export_bull_ob_top      = na
var float     export_bear_ob_bot      = na
var int       export_bull_ob_touches  = 0
var int       export_bear_ob_touches  = 0
var bool      export_ob_sd_bull       = false
var bool      export_ob_sd_bear       = false

// ── ИСПОЛНЕНИЕ SMC — деструктуризация на 20 элементов. Присвоение всем затронутым глобалам
// происходит здесь, в легальной точке (глобальная область видимости) — вместо прямой записи внутри
// функции (CE10088-фикс). ──
[tmp_ms, tmp_ob_state, tmp_ob_touch, tmp_bb, b_prox, br_prox, tmp_bull_touches, tmp_bear_touches, tmp_ob_sd_bull, tmp_ob_sd_bear, tmp_bull_ob_top, tmp_bear_ob_bot, tmp_cand_top_bull, tmp_cand_btm_bull, tmp_cand_top_bear, tmp_cand_btm_bear, tmp_ob_pack_bull, tmp_ob_pack_bear, tmp_da_ob_fresh_bull, tmp_da_ob_fresh_bear] = f_bb_structure(bb_smc_up_col, bb_smc_dn_col, en_smc, false, bb_swingLimit, sd_in_demand, sd_in_supply)

export_ms               := tmp_ms
export_ob_state         := tmp_ob_state
export_ob_touch         := tmp_ob_touch
export_bb_signal        := tmp_bb
export_bull_ob_proximal := b_prox
export_bear_ob_proximal := br_prox
export_bull_ob_top      := tmp_bull_ob_top
export_bear_ob_bot      := tmp_bear_ob_bot
export_bull_ob_touches  := tmp_bull_touches
export_bear_ob_touches  := tmp_bear_touches
export_ob_sd_bull       := tmp_ob_sd_bull
export_ob_sd_bear       := tmp_ob_sd_bear
g_ob_candidate_top_bull  := tmp_cand_top_bull
g_ob_candidate_btm_bull  := tmp_cand_btm_bull
g_ob_candidate_top_bear  := tmp_cand_top_bear
g_ob_candidate_btm_bear  := tmp_cand_btm_bear
export_ob_pack_bull      := tmp_ob_pack_bull
export_ob_pack_bear      := tmp_ob_pack_bear
da_ob_fresh_bull         := tmp_da_ob_fresh_bull
da_ob_fresh_bear         := tmp_da_ob_fresh_bear

f_calc_value_area_single(array<float> vol, int rows, int pocIdx, float totalVol, float threshold) =>
    int loIdx = pocIdx
    int hiIdx = pocIdx
    float accum = array.get(vol, pocIdx)
    float target = totalVol * threshold
    while accum < target and (loIdx > 0 or hiIdx < rows - 1)
        float loNextVol = loIdx > 0 ? array.get(vol, loIdx - 1) : -1.0
        float hiNextVol = hiIdx < rows - 1 ? array.get(vol, hiIdx + 1) : -1.0
        if loNextVol < 0 and hiNextVol < 0
            break
        if loNextVol >= hiNextVol
            loIdx -= 1
            accum += loNextVol
        else
            hiIdx += 1
            accum += hiNextVol
    [loIdx, hiIdx]

var fvgs            = array.new<fvg_obj>()
var fvg_pocLblAllow = true
var float export_ifvg_delta_sign = 0.0

f_ifvg_delta_profile(array<float> closeArr, array<float> volArr, float hi, float lo, int bins) =>
    array<float> deltaBull = array.new_float(bins, 0.0)
    array<float> deltaBear = array.new_float(bins, 0.0)
    float binSize = (hi - lo) / bins
    if array.size(closeArr) > 1 and binSize > 0
        for i = 1 to array.size(closeArr) - 1
            float c = array.get(closeArr, i)
            float cPrev = array.get(closeArr, i - 1)
            float v = array.get(volArr, i)
            if c >= lo and c <= hi
                int idx = math.max(0, math.min(bins - 1, int((c - lo) / binSize)))
                if c >= cPrev
                    array.set(deltaBull, idx, array.get(deltaBull, idx) + v)
                else
                    array.set(deltaBear, idx, array.get(deltaBear, idx) + v)
    [deltaBull, deltaBear]

if en_2
    bool fvg_bull_cond = low > high[2] and high[1] > high[2] and fvg_bullish_gap_size > fvg_gap_filter
    bool fvg_bear_cond = high < low[2] and low[1]  < low[2]  and fvg_bearish_gap_size > fvg_gap_filter

    array<float> cls_array = fvg_c.size() > 0 ? fvg_c[1] : array.new_float()
    array<float> vol_array = fvg_v.size() > 0 ? fvg_v[1] : array.new_float()

    if en_ifvg and fvgMem.size() > 0
        for i = fvgMem.size() - 1 to 0
            if f_fvg_mem_expired(fvgMem.get(i))
                fvgMem.remove(i)

    if fvg_bull_cond
        fvg_pocLblAllow := false
        float fvg_lower = high[2], float fvg_upper = low

        bool ifvg_bull_made = false
        if en_ifvg and fvgMem.size() > 0
            for m in fvgMem
                if not m.up and m.breakBar >= 0 and f_zones_overlap(fvg_upper, fvg_lower, m.hi, m.lo)
                    ifvg_bull_made := true
                    break

        color fvg_box_col = ifvg_bull_made ? ifvg_bull_color : fvg_bull_color
        color fvg_box_bg  = color.new(fvg_box_col, 70)
        int   fvg_box_left_b  = bar_index - 1
        int   fvg_box_right_b = bar_index + fvg_extend_bars
        int   fvg_boxWidthBars_b = math.max(fvg_box_right_b - fvg_box_left_b, 1)
        box   fvg_box   = box.new(fvg_box_left_b, fvg_upper, fvg_box_right_b, fvg_lower, border_color=na, border_width=0, bgcolor=f_dim(fvg_box_bg))
        float binSize   = (fvg_upper - fvg_lower) / fvg_bins
        array<float> volumeP     = array.new<float>(fvg_bins, 0.)
        array<box>   volumeBoxes = array.new<box>(fvg_bins, box(na))
        line  poc = line(na), label pocLbl = label(na)
        line  valLine = line(na), line vahLine = line(na)
        label valLbl = label(na), label vahLbl = label(na)

        array<float> ideltaBull = array.new_float()
        array<float> ideltaBear = array.new_float()
        array<box>   ideltaBoxes = array.new<box>()
        if dva_show_delta and cls_array.size() > 0
            [db, dr] = f_ifvg_delta_profile(cls_array, vol_array, fvg_upper, fvg_lower, dva_delta_bins)
            ideltaBull := db
            ideltaBear := dr
        float ifvg_maxAbsD_b = 0.0
        int   ifvg_maxIdx_b  = -1
        if array.size(ideltaBull) > 0
            for bnk = 0 to dva_delta_bins - 1
                float d0 = array.get(ideltaBull, bnk) - array.get(ideltaBear, bnk)
                if math.abs(d0) > ifvg_maxAbsD_b
                    ifvg_maxAbsD_b := math.abs(d0)
                    ifvg_maxIdx_b := bnk

        if cls_array.size() > 0
            for k = 0 to fvg_bins - 1
                float lower_b = fvg_lower + binSize * k, float mid_b = lower_b + binSize / 2
                for i = 0 to cls_array.size() - 1
                    if math.abs(cls_array.get(i) - mid_b) <= binSize
                        volumeP.set(k, volumeP.get(k) + vol_array.get(i))
        int fvg_poc_idx_b = -1
        for k = 0 to fvg_bins - 1
            float lower_b = fvg_lower + binSize * k, float upper_b = lower_b + binSize, float mid_b = lower_b + binSize / 2
            volumeBoxes.set(k, box.new(bar_index - 1, upper_b, bar_index - 1, lower_b, border_width=0))
            if volumeP.max() != 0 and volumeP.get(k) == volumeP.max() and not fvg_pocLblAllow
                fvg_poc_idx_b := k
                [poc_w_b, poc_isMax_b] = f_dva_bin_match(mid_b, fvg_lower, fvg_upper, dva_delta_bins, ideltaBull, ideltaBear, ifvg_maxIdx_b, ifvg_maxAbsD_b, dva_delta_max_width, fvg_boxWidthBars_b)
                poc    := line.new(bar_index - 1, mid_b, bar_index - 1 + poc_w_b, mid_b, color=f_dim(dva_poc_line_color), width=dva_poc_line_width, style=poc_isMax_b ? line.style_solid : line.style_dashed)
                pocLbl := label.new(bar_index - 1, mid_b, "POC " + str.tostring(mid_b, format.mintick), style=label.style_label_left, color=color.new(color.white, 100), textcolor=f_dim(dva_poc_line_color), size=f_dva_txsz(dva_va_text_size))
                fvg_pocLblAllow := true

        if dva_show_own_va and fvg_poc_idx_b >= 0 and volumeP.sum() > 0
            [fvg_va_lo_b, fvg_va_hi_b] = f_calc_value_area_single(volumeP, fvg_bins, fvg_poc_idx_b, volumeP.sum(), dva_own_va_threshold)
            float fvg_val_price_b = fvg_lower + binSize * fvg_va_lo_b
            float fvg_vah_price_b = fvg_lower + binSize * (fvg_va_hi_b + 1)
            [val_w_b, val_isMax_b] = f_dva_bin_match(fvg_val_price_b, fvg_lower, fvg_upper, dva_delta_bins, ideltaBull, ideltaBear, ifvg_maxIdx_b, ifvg_maxAbsD_b, dva_delta_max_width, fvg_boxWidthBars_b)
            [vah_w_b, vah_isMax_b] = f_dva_bin_match(fvg_vah_price_b, fvg_lower, fvg_upper, dva_delta_bins, ideltaBull, ideltaBear, ifvg_maxIdx_b, ifvg_maxAbsD_b, dva_delta_max_width, fvg_boxWidthBars_b)
            valLine := line.new(bar_index - 1, fvg_val_price_b, bar_index - 1 + val_w_b, fvg_val_price_b, color=f_dim(dva_val_line_color), width=dva_val_line_width, style=val_isMax_b ? line.style_solid : line.style_dashed)
            vahLine := line.new(bar_index - 1, fvg_vah_price_b, bar_index - 1 + vah_w_b, fvg_vah_price_b, color=f_dim(dva_vah_line_color), width=dva_vah_line_width, style=vah_isMax_b ? line.style_solid : line.style_dashed)
            valLbl  := label.new(bar_index - 1, fvg_val_price_b, "VAL " + str.tostring(fvg_val_price_b, format.mintick), style=label.style_label_left, color=color.new(color.white, 100), textcolor=f_dim(dva_val_line_color), size=f_dva_txsz(dva_va_text_size))
            vahLbl  := label.new(bar_index - 1, fvg_vah_price_b, "VAH " + str.tostring(fvg_vah_price_b, format.mintick), style=label.style_label_left, color=color.new(color.white, 100), textcolor=f_dim(dva_vah_line_color), size=f_dva_txsz(dva_va_text_size))

        label fvg_type_lbl_b = na
        if fvg_show_type_label
            int   fvg_lbl_x_b = int(math.avg(bar_index - 1, bar_index + fvg_extend_bars))
            float fvg_lbl_y_b = (fvg_upper + fvg_lower) / 2
            fvg_lbl_sz_b = fvg_type_label_size == "Tiny" ? size.tiny : fvg_type_label_size == "Normal" ? size.normal : size.small
            fvg_type_lbl_b := label.new(fvg_lbl_x_b, fvg_lbl_y_b, ifvg_bull_made ? "iFVG" : "FVG", style=label.style_label_center, color=color.new(color.white, 100), textcolor=f_dim(fvg_type_label_color), size=fvg_lbl_sz_b, textalign=text.align_center)

        fvgs.push(fvg_obj.new(fvg_box, true, volumeP, volumeBoxes, poc, pocLbl, bar_index, ifvg_bull_made, ideltaBull, ideltaBear, ideltaBoxes, fvg_type_lbl_b, valLine, vahLine, valLbl, vahLbl, ifvg_maxAbsD_b))

    if fvg_bear_cond
        fvg_pocLblAllow := false
        float fvg_upper = low[2], float fvg_lower = high

        bool ifvg_bear_made = false
        if en_ifvg and fvgMem.size() > 0
            for m in fvgMem
                if m.up and m.breakBar >= 0 and f_zones_overlap(fvg_upper, fvg_lower, m.hi, m.lo)
                    ifvg_bear_made := true
                    break

        color fvg_box_col_s = ifvg_bear_made ? ifvg_bear_color : fvg_bear_color
        color fvg_box_bg_s  = color.new(fvg_box_col_s, 70)
        int   fvg_box_left_s  = bar_index - 1
        int   fvg_box_right_s = bar_index + fvg_extend_bars
        int   fvg_boxWidthBars_s = math.max(fvg_box_right_s - fvg_box_left_s, 1)
        box   fvg_box   = box.new(fvg_box_left_s, fvg_upper, fvg_box_right_s, fvg_lower, border_color=na, border_width=0, bgcolor=f_dim(fvg_box_bg_s))
        float binSize   = (fvg_upper - fvg_lower) / fvg_bins
        array<float> volumeP     = array.new<float>(fvg_bins, 0.)
        array<box>   volumeBoxes = array.new<box>(fvg_bins, box(na))
        line  poc = line(na), label pocLbl = label(na)
        line  valLine = line(na), line vahLine = line(na)
        label valLbl = label(na), label vahLbl = label(na)

        array<float> ideltaBull_s = array.new_float()
        array<float> ideltaBear_s = array.new_float()
        array<box>   ideltaBoxes_s = array.new<box>()
        if dva_show_delta and cls_array.size() > 0
            [db2, dr2] = f_ifvg_delta_profile(cls_array, vol_array, fvg_upper, fvg_lower, dva_delta_bins)
            ideltaBull_s := db2
            ideltaBear_s := dr2
        float ifvg_maxAbsD_s = 0.0
        int   ifvg_maxIdx_s  = -1
        if array.size(ideltaBull_s) > 0
            for bnk = 0 to dva_delta_bins - 1
                float d0 = array.get(ideltaBull_s, bnk) - array.get(ideltaBear_s, bnk)
                if math.abs(d0) > ifvg_maxAbsD_s
                    ifvg_maxAbsD_s := math.abs(d0)
                    ifvg_maxIdx_s := bnk

        if cls_array.size() > 0
            for k = 0 to fvg_bins - 1
                float lower_b = fvg_lower + binSize * k, float mid_b = lower_b + binSize / 2
                for i = 0 to cls_array.size() - 1
                    if math.abs(cls_array.get(i) - mid_b) <= binSize
                        volumeP.set(k, volumeP.get(k) + vol_array.get(i))
        int fvg_poc_idx_s = -1
        for k = 0 to fvg_bins - 1
            float lower_b = fvg_lower + binSize * k, float upper_b = lower_b + binSize, float mid_b = lower_b + binSize / 2
            volumeBoxes.set(k, box.new(bar_index - 1, upper_b, bar_index - 1, lower_b, border_width=0))
            if volumeP.max() != 0 and volumeP.get(k) == volumeP.max() and not fvg_pocLblAllow
                fvg_poc_idx_s := k
                [poc_w_s, poc_isMax_s] = f_dva_bin_match(mid_b, fvg_lower, fvg_upper, dva_delta_bins, ideltaBull_s, ideltaBear_s, ifvg_maxIdx_s, ifvg_maxAbsD_s, dva_delta_max_width, fvg_boxWidthBars_s)
                poc    := line.new(bar_index - 1, mid_b, bar_index - 1 + poc_w_s, mid_b, color=f_dim(dva_poc_line_color), width=dva_poc_line_width, style=poc_isMax_s ? line.style_solid : line.style_dashed)
                pocLbl := label.new(bar_index - 1, mid_b, "POC " + str.tostring(mid_b, format.mintick), style=label.style_label_left, color=color.new(color.white, 100), textcolor=f_dim(dva_poc_line_color), size=f_dva_txsz(dva_va_text_size))
                fvg_pocLblAllow := true

        if dva_show_own_va and fvg_poc_idx_s >= 0 and volumeP.sum() > 0
            [fvg_va_lo_s, fvg_va_hi_s] = f_calc_value_area_single(volumeP, fvg_bins, fvg_poc_idx_s, volumeP.sum(), dva_own_va_threshold)
            float fvg_val_price_s = fvg_lower + binSize * fvg_va_lo_s
            float fvg_vah_price_s = fvg_lower + binSize * (fvg_va_hi_s + 1)
            [val_w_s, val_isMax_s] = f_dva_bin_match(fvg_val_price_s, fvg_lower, fvg_upper, dva_delta_bins, ideltaBull_s, ideltaBear_s, ifvg_maxIdx_s, ifvg_maxAbsD_s, dva_delta_max_width, fvg_boxWidthBars_s)
            [vah_w_s, vah_isMax_s] = f_dva_bin_match(fvg_vah_price_s, fvg_lower, fvg_upper, dva_delta_bins, ideltaBull_s, ideltaBear_s, ifvg_maxIdx_s, ifvg_maxAbsD_s, dva_delta_max_width, fvg_boxWidthBars_s)
            valLine := line.new(bar_index - 1, fvg_val_price_s, bar_index - 1 + val_w_s, fvg_val_price_s, color=f_dim(dva_val_line_color), width=dva_val_line_width, style=val_isMax_s ? line.style_solid : line.style_dashed)
            vahLine := line.new(bar_index - 1, fvg_vah_price_s, bar_index - 1 + vah_w_s, fvg_vah_price_s, color=f_dim(dva_vah_line_color), width=dva_vah_line_width, style=vah_isMax_s ? line.style_solid : line.style_dashed)
            valLbl  := label.new(bar_index - 1, fvg_val_price_s, "VAL " + str.tostring(fvg_val_price_s, format.mintick), style=label.style_label_left, color=color.new(color.white, 100), textcolor=f_dim(dva_val_line_color), size=f_dva_txsz(dva_va_text_size))
            vahLbl  := label.new(bar_index - 1, fvg_vah_price_s, "VAH " + str.tostring(fvg_vah_price_s, format.mintick), style=label.style_label_left, color=color.new(color.white, 100), textcolor=f_dim(dva_vah_line_color), size=f_dva_txsz(dva_va_text_size))

        label fvg_type_lbl_s = na
        if fvg_show_type_label
            int   fvg_lbl_x_s = int(math.avg(bar_index - 1, bar_index + fvg_extend_bars))
            float fvg_lbl_y_s = (fvg_upper + fvg_lower) / 2
            fvg_lbl_sz_s = fvg_type_label_size == "Tiny" ? size.tiny : fvg_type_label_size == "Normal" ? size.normal : size.small
            fvg_type_lbl_s := label.new(fvg_lbl_x_s, fvg_lbl_y_s, ifvg_bear_made ? "iFVG" : "FVG", style=label.style_label_center, color=color.new(color.white, 100), textcolor=f_dim(fvg_type_label_color), size=fvg_lbl_sz_s, textalign=text.align_center)

        fvgs.push(fvg_obj.new(fvg_box, false, volumeP, volumeBoxes, poc, pocLbl, bar_index, ifvg_bear_made, ideltaBull_s, ideltaBear_s, ideltaBoxes_s, fvg_type_lbl_s, valLine, vahLine, valLbl, vahLbl, ifvg_maxAbsD_s))

    if davg2_enable and fvgs.size() > 0
        float fvg_bull_sum   = 0.0
        int   fvg_bull_cnt   = 0
        float fvg_bear_sum   = 0.0
        int   fvg_bear_cnt   = 0
        float ifvg_bull_sum  = 0.0
        int   ifvg_bull_cnt  = 0
        float ifvg_bear_sum  = 0.0
        int   ifvg_bear_cnt  = 0
        for f2 in fvgs
            if f2.lastMaxDelta > 0
                if f2.isInversion
                    if f2.lastMaxIsBull
                        ifvg_bull_sum += f2.lastMaxDelta, ifvg_bull_cnt += 1
                    else
                        ifvg_bear_sum += f2.lastMaxDelta, ifvg_bear_cnt += 1
                else
                    if f2.lastMaxIsBull
                        fvg_bull_sum += f2.lastMaxDelta, fvg_bull_cnt += 1
                    else
                        fvg_bear_sum += f2.lastMaxDelta, fvg_bear_cnt += 1
        davg2_fvg_bull_avg  := fvg_bull_cnt  > 0 ? fvg_bull_sum  / fvg_bull_cnt  : na
        davg2_fvg_bear_avg  := fvg_bear_cnt  > 0 ? fvg_bear_sum  / fvg_bear_cnt  : na
        davg2_ifvg_bull_avg := ifvg_bull_cnt > 0 ? ifvg_bull_sum / ifvg_bull_cnt : na
        davg2_ifvg_bear_avg := ifvg_bear_cnt > 0 ? ifvg_bear_sum / ifvg_bear_cnt : na

    export_fvg_pack_bull := 0
    export_fvg_pack_bear := 0
    da_fvg_fresh_bull := false
    da_fvg_fresh_bear := false

    if fvgs.size() > 0
        export_ifvg_delta_sign := 0.0
        for i = fvgs.size() - 1 to 0
            f = fvgs.get(i)
            if bar_index - f.age > 720
                if en_ifvg
                    fvgMem.push(fvg_mem.new(f.FVG.get_top(), f.FVG.get_bottom(), f.isBull, f.age, bar_index, f.FVG.get_top(), f.FVG.get_bottom()))
                f_davg_push(f.isInversion ? davg_buf_ifvg : davg_buf_fvg, f.lastMaxDelta, davg_lookback_n)
                f.FVG.delete()
                if not na(f.poc)
                    f.poc.delete()
                if not na(f.pocLbl)
                    f.pocLbl.delete()
                if not na(f.typeLbl)
                    label.delete(f.typeLbl)
                if not na(f.valLine)
                    line.delete(f.valLine)
                if not na(f.vahLine)
                    line.delete(f.vahLine)
                if not na(f.valLbl)
                    label.delete(f.valLbl)
                if not na(f.vahLbl)
                    label.delete(f.vahLbl)
                for b in f.volumeBoxes
                    b.delete()
                if array.size(f.deltaBoxes) > 0
                    for db in f.deltaBoxes
                        db.delete()
                fvgs.remove(i)
                continue
            f.FVG.set_right(bar_index + fvg_extend_bars)
            float top  = f.FVG.get_top(), float bot = f.FVG.get_bottom()
            int   left = f.FVG.get_left(), int right = f.FVG.get_right()
            boxes = f.volumeBoxes
            if not na(f.poc)
                f.poc.set_x2(right)
            if not na(f.valLine)
                f.valLine.set_x2(right)
            if not na(f.vahLine)
                f.vahLine.set_x2(right)
            f.FVG.set_text((f.isInversion ? "i" : "") + str.tostring(f.volumeProfile.sum(), format.volume))
            f.FVG.set_text_halign(text.align_right)
            f.FVG.set_text_valign(f.isBull ? text.align_bottom : text.align_top)
            f.FVG.set_text_size(size.normal), f.FVG.set_text_color(f_dim(chart.fg_color))

            if fvg_show_type_label and not na(f.typeLbl)
                label.set_x(f.typeLbl, int(math.avg(left, right)))
                label.set_y(f.typeLbl, (top + bot) / 2)

            int   fFlags = 0
            int   fState = f.isInversion ? 2 : 1
            int   fFresh = math.min((bar_index - f.age) / 5, 9)
            int   fDeltaSign = 2
            int   fNetSign   = 2
            bool  fIsCurrent = close <= top and close >= bot

            if barstate.isconfirmed
                if not na(f.poc)
                    float pocLevel = f.poc.get_y1()
                    if f_dva_level_eaten(pocLevel)
                        f.poc.delete(), f.poc := line(na)
                        if not na(f.pocLbl)
                            f.pocLbl.delete(), f.pocLbl := label(na)
                if not na(f.valLine)
                    float valLevel = f.valLine.get_y1()
                    if f_dva_level_eaten(valLevel)
                        f.valLine.delete(), f.valLine := line(na)
                        if not na(f.valLbl)
                            f.valLbl.delete(), f.valLbl := label(na)
                if not na(f.vahLine)
                    float vahLevel = f.vahLine.get_y1()
                    if f_dva_level_eaten(vahLevel)
                        f.vahLine.delete(), f.vahLine := line(na)
                        if not na(f.vahLbl)
                            f.vahLbl.delete(), f.vahLbl := label(na)

            if fIsCurrent and not na(f.poc)
                fFlags += 2
            if fIsCurrent and not na(f.valLine) and not na(f.vahLine)
                float valLvl2 = f.valLine.get_y1()
                float vahLvl2 = f.vahLine.get_y1()
                if close >= valLvl2 and close <= vahLvl2
                    fFlags += 2

            if dva_show_delta and array.size(f.deltaBull) > 0
                if array.size(f.deltaBoxes) == 0
                    int   ifvg_boxWidthBars = fvg_extend_bars
                    float ifvg_step = (top - bot) / dva_delta_bins
                    float maxAbsD = 0.0
                    int   maxIdxD = -1
                    bool  maxIsBullD = true
                    for bnk = 0 to dva_delta_bins - 1
                        float d = array.get(f.deltaBull, bnk) - array.get(f.deltaBear, bnk)
                        if math.abs(d) > maxAbsD
                            maxAbsD := math.abs(d)
                            maxIdxD := bnk
                            maxIsBullD := d >= 0
                    f.lastMaxDelta   := maxAbsD
                    f.lastMaxIsBull  := maxIsBullD
                    if maxAbsD > 0
                        for bnk = 0 to dva_delta_bins - 1
                            float bandLo = bot + ifvg_step * bnk
                            float bandHi = bandLo + ifvg_step
                            float d = array.get(f.deltaBull, bnk) - array.get(f.deltaBear, bnk)
                            if d != 0
                                int wBars = math.max(1, int((math.abs(d)/maxAbsD)*dva_delta_max_width))
                                wBars := math.min(wBars, ifvg_boxWidthBars)
                                color dcol = d >= 0 ? dva_delta_bull_color : dva_delta_bear_color
                                bool  isMaxBin = bnk == maxIdxD
                                color borderCol = isMaxBin ? dva_max_border_color : color.new(dcol, 0)
                                int   borderW   = isMaxBin ? dva_max_border_width : 1
                                f.deltaBoxes.push(box.new(left, bandHi, left + wBars, bandLo, bgcolor=f_dim(dcol), border_color=f_dim(borderCol), border_width=borderW, text=dva_show_delta_text ? "Δ"+str.tostring(d, format.volume) : "", text_color=f_dim(dva_delta_text_color), text_size=f_dva_txsz(dva_delta_text_size), text_halign=text.align_left))
                                if isMaxBin
                                    [fvg_isOver, fvg_pct] = f_davg_excess(maxAbsD, f.isInversion ? davg_buf_ifvg : davg_buf_fvg)
                                    if fvg_isOver
                                        f.deltaBoxes.push(box.new(left + wBars, bandHi, left + wBars, bandLo, border_color=na, bgcolor=na, text="+" + str.tostring(fvg_pct, "#.#") + "%", text_color=f_dim(davg_color), text_size=f_dva_txsz(davg_text_size), text_halign=text.align_left))
                                    if davg2_enable
                                        float davg2_fvg_ref = f.isInversion ? (d >= 0 ? davg2_ifvg_bull_avg : davg2_ifvg_bear_avg) : (d >= 0 ? davg2_fvg_bull_avg : davg2_fvg_bear_avg)
                                        if not na(davg2_fvg_ref) and davg2_fvg_ref > 0 and maxAbsD > davg2_fvg_ref
                                            float davg2_fvg_pct = (maxAbsD / davg2_fvg_ref - 1) * 100
                                            f.deltaBoxes.push(box.new(left, bandHi, left + wBars, bandLo, border_color=na, bgcolor=na, text="+" + str.tostring(davg2_fvg_pct, "#.#") + "%", text_color=f_dim(davg2_color), text_size=f_dva_txsz(davg2_text_size), text_halign=text.align_center))
                if barstate.isconfirmed and array.size(f.deltaBoxes) > 0
                    for bi = array.size(f.deltaBoxes) - 1 to 0
                        box db = array.get(f.deltaBoxes, bi)
                        float dbTop = db.get_top(), float dbBot = db.get_bottom()
                        if f_dva_level_eaten(math.avg(dbTop, dbBot))
                            db.delete()
                            array.remove(f.deltaBoxes, bi)
                if fIsCurrent
                    float netD = f.deltaBull.sum() - f.deltaBear.sum()
                    export_ifvg_delta_sign := netD > 0 ? 1.0 : netD < 0 ? -1.0 : 0.0
                    fNetSign := netD > 0 ? 1 : netD < 0 ? 0 : 2
                    if f.lastMaxDelta > 0 and (f.lastMaxIsBull ? 1 : 0) == (netD >= 0 ? 1 : 0)
                        fFlags += 4
                    fDeltaSign := f.lastMaxDelta > 0 ? (f.lastMaxIsBull ? 1 : 0) : 2

            if fIsCurrent
                int fAboveAvg = 0
                [fOver, fPct] = f_davg_excess(f.lastMaxDelta, f.isInversion ? davg_buf_ifvg : davg_buf_fvg)
                bool f_is_fresh = fOver and not f.wasAboveAvg
                if fOver
                    fAboveAvg := f_is_fresh ? 2 : 1
                f.wasAboveAvg := fOver
                int fPackCode = f_fvg_pack_encode(fState, fFresh, fFlags, fDeltaSign, fNetSign, fAboveAvg)
                if f.isBull
                    export_fvg_pack_bull := fPackCode
                    da_fvg_fresh_bull := f_is_fresh
                else
                    export_fvg_pack_bear := fPackCode
                    da_fvg_fresh_bear := f_is_fresh

            if f.isBull
                if low < f.FVG.get_bottom()
                    if en_ifvg
                        fvgMem.push(fvg_mem.new(top, bot, true, f.age, bar_index, top, bot))
                    f_davg_push(f.isInversion ? davg_buf_ifvg : davg_buf_fvg, f.lastMaxDelta, davg_lookback_n)
                    f.FVG.delete()
                    if not na(f.poc)
                        f.poc.delete()
                    if not na(f.pocLbl)
                        f.pocLbl.delete()
                    if not na(f.typeLbl)
                        label.delete(f.typeLbl)
                    if not na(f.valLine)
                        line.delete(f.valLine)
                    if not na(f.vahLine)
                        line.delete(f.vahLine)
                    if not na(f.valLbl)
                        label.delete(f.valLbl)
                    if not na(f.vahLbl)
                        label.delete(f.vahLbl)
                    for b in boxes
                        b.delete()
                    if array.size(f.deltaBoxes) > 0
                        for db in f.deltaBoxes
                            db.delete()
                    fvgs.remove(i)
                else
                    for k = 0 to fvg_bins - 1
                        float volRatio = f.volumeProfile.get(k) / math.max(f.volumeProfile.max(), 1) * 50
                        int bw = math.round(volRatio * (right - left) / 100)
                        if bw != 0 and fvg_hideVP
                            boxes.get(k).set_right(left + bw)
                            color vpCol = f.isInversion ? ifvg_bull_color : fvg_bull_color
                            boxes.get(k).set_bgcolor(f_dim(color.from_gradient(f.volumeProfile.get(k), 0, f.volumeProfile.max(), color.new(vpCol, 100), vpCol)))
            else
                if high > f.FVG.get_top()
                    if en_ifvg
                        fvgMem.push(fvg_mem.new(top, bot, false, f.age, bar_index, top, bot))
                    f_davg_push(f.isInversion ? davg_buf_ifvg : davg_buf_fvg, f.lastMaxDelta, davg_lookback_n)
                    f.FVG.delete()
                    if not na(f.poc)
                        f.poc.delete()
                    if not na(f.pocLbl)
                        f.pocLbl.delete()
                    if not na(f.typeLbl)
                        label.delete(f.typeLbl)
                    if not na(f.valLine)
                        line.delete(f.valLine)
                    if not na(f.vahLine)
                        line.delete(f.vahLine)
                    if not na(f.valLbl)
                        label.delete(f.valLbl)
                    if not na(f.vahLbl)
                        label.delete(f.vahLbl)
                    for b in boxes
                        b.delete()
                    if array.size(f.deltaBoxes) > 0
                        for db in f.deltaBoxes
                            db.delete()
                    fvgs.remove(i)
                else
                    for k = 0 to fvg_bins - 1
                        int bw = math.round(f.volumeProfile.get(k) / math.max(f.volumeProfile.max(), 1) * (right - left) / 2.5)
                        if bw != 0 and fvg_hideVP
                            boxes.get(k).set_right(left + bw)
                            color vpCol2 = f.isInversion ? ifvg_bear_color : fvg_bear_color
                            boxes.get(k).set_bgcolor(f_dim(color.from_gradient(f.volumeProfile.get(k), 0, f.volumeProfile.max(), color.new(vpCol2, 100), vpCol2)))

// ====================================================================================================================
// 7.4 LIQUIDATION ZONES — пивот-детекция, режим тепловой карты и бегущая метка объёма
//     (интеграция UserUZR поверх ChartPrime, упрощённая версия — без визуальных тир-боксов)
// ====================================================================================================================
var bool  da_liq_fresh_bull = false   // зарезервировано (тир-боксы убраны — не устанавливается)
var bool  da_liq_fresh_bear = false   // зарезервировано (тир-боксы убраны — не устанавливается)
var int   export_liq_pack   = 0

var label liq_run_lbl_top = na
var label liq_run_lbl_bot = na
var int   liq_last_pivot_bar_top = na
var int   liq_last_pivot_bar_bot = na
var float liq_last_pivot_top_price = na
var float liq_last_pivot_bot_price = na

var line  liq_hm_line_top  = na
var line  liq_hm_line_bot  = na
var label liq_hm_label_top = na
var label liq_hm_label_bot = na

f_liq_volume_since(bool isTop, int fromBarsBack) =>
    float vol = 0.0
    if last_bar_index - bar_index < 100
        for i = 0 to fromBarsBack
            vol += isTop ? (close[i] < open[i] ? -volume[i] : 0.0) : (close[i] > open[i] ? volume[i] : 0.0)
    vol

if liq_enable
    float liq_ph = ta.pivothigh(liq_len, liq_len)
    float liq_pl = ta.pivotlow(liq_len, liq_len)

    if not na(liq_ph)
        liq_last_pivot_bar_top   := bar_index[liq_len]
        liq_last_pivot_top_price := high[liq_len]
    if not na(liq_pl)
        liq_last_pivot_bar_bot   := bar_index[liq_len]
        liq_last_pivot_bot_price := low[liq_len]

    if liq_show_running_vol
        if not na(liq_last_pivot_bar_top) and not na(liq_last_pivot_top_price)
            int   liq_idx_top = math.min(bar_index - liq_last_pivot_bar_top, 99)
            float liq_vol_top = f_liq_volume_since(true, liq_idx_top)
            liq_run_lbl_top := label.new(bar_index + liq_extend, liq_last_pivot_top_price, "Sell Volume: " + str.tostring(liq_vol_top, format.volume), color=color(na), style=label.style_label_right, textcolor=f_dim(chart.fg_color))
            label.delete(liq_run_lbl_top[1])
        if not na(liq_last_pivot_bar_bot) and not na(liq_last_pivot_bot_price)
            int   liq_idx_bot = math.min(bar_index - liq_last_pivot_bar_bot, 99)
            float liq_vol_bot = f_liq_volume_since(false, liq_idx_bot)
            liq_run_lbl_bot := label.new(bar_index + liq_extend, liq_last_pivot_bot_price, "Buy Volume: " + str.tostring(liq_vol_bot, format.volume), color=color(na), style=label.style_label_right, textcolor=f_dim(chart.fg_color))
            label.delete(liq_run_lbl_bot[1])
    else
        if not na(liq_run_lbl_top)
            label.delete(liq_run_lbl_top)
            liq_run_lbl_top := na
        if not na(liq_run_lbl_bot)
            label.delete(liq_run_lbl_bot)
            liq_run_lbl_bot := na

    if liq_heatmap_style
        int   liq_hm_length  = 100
        float liq_hm_highest = ta.highest(liq_hm_length)
        float liq_hm_lowest  = ta.lowest(liq_hm_length)

        liq_hm_label_top := label.new(bar_index + liq_extend, liq_hm_highest, "", style=label.style_label_left, color=color.new(color.maroon, 20), textcolor=f_dim(chart.fg_color))
        liq_hm_line_top  := line.new(bar_index - liq_hm_length, liq_hm_highest, bar_index + liq_extend, liq_hm_highest, color=f_dim(color.new(color.maroon, 20)))
        line.delete(liq_hm_line_top[1])
        label.delete(liq_hm_label_top[1])

        liq_hm_label_bot := label.new(bar_index + liq_extend, liq_hm_lowest, "", style=label.style_label_left, color=color.new(color.lime, 40), textcolor=f_dim(chart.fg_color))
        liq_hm_line_bot  := line.new(bar_index - liq_hm_length, liq_hm_lowest, bar_index + liq_extend, liq_hm_lowest, color=f_dim(color.new(color.lime, 20)))
        line.delete(liq_hm_line_bot[1])
        label.delete(liq_hm_label_bot[1])

        float liq_hm_vol_top = f_liq_volume_since(true,  liq_hm_length)
        float liq_hm_vol_bot = f_liq_volume_since(false, liq_hm_length)

        liq_hm_label_top.set_text(str.tostring(liq_hm_vol_top, format.volume))
        liq_hm_label_top.set_x(bar_index + liq_extend)
        liq_hm_label_bot.set_text(str.tostring(liq_hm_vol_bot, format.volume))
        liq_hm_label_bot.set_x(bar_index + liq_extend)

        liq_hm_line_top.set_x2(bar_index + liq_extend)
        liq_hm_line_bot.set_x2(bar_index + liq_extend)
    else
        if not na(liq_hm_line_top)
            line.delete(liq_hm_line_top)
            liq_hm_line_top := na
        if not na(liq_hm_line_bot)
            line.delete(liq_hm_line_bot)
            liq_hm_line_bot := na
        if not na(liq_hm_label_top)
            label.delete(liq_hm_label_top)
            liq_hm_label_top := na
        if not na(liq_hm_label_bot)
            label.delete(liq_hm_label_bot)
            liq_hm_label_bot := na

    export_liq_pack := (da_liq_fresh_bull ? 10 : 0) + (da_liq_fresh_bear ? 20 : 0)

// ====================================================================================================================
// 7.7 LIQUIDITY SWEEPS — оригинальная концепция и код © LuxAlgo (CC BY-NC-SA 4.0), интеграция — © UserUZR
// ====================================================================================================================
type lsq_piv
    float prc
    int   bix
    bool  brk
    bool  mit
    bool  tak
    bool  wic
    line  lin

type lsq_boxBr
    box  bx
    line ln
    bool br
    int  dr

var array<lsq_piv>   lsq_aPivH  = array.new<lsq_piv>(1, lsq_piv.new())
var array<lsq_piv>   lsq_aPivL  = array.new<lsq_piv>(1, lsq_piv.new())
var array<lsq_boxBr> lsq_aBoxBr = array.new<lsq_boxBr>(1, lsq_boxBr.new())

f_lsq_valid(float v) => not na(v)

method lsq_l(lsq_piv get, color c, string s = 'sd') =>
    style = switch s
        'dt' => line.style_dotted
        'ds' => line.style_dashed
        => line.style_solid
    line.new(get.bix, get.prc, bar_index, get.prc, color=c, style=style)

method lsq_br(lsq_piv get, color c3, color c, int d) =>
    y1 = d == 1 ? high : get.prc
    y2 = d == 1 ? get.prc : low
    lsq_boxBr.new(
     box.new(bar_index - 1, y1, bar_index + 1, y2, border_color=color.new(na, na), bgcolor=c3),
     line.new(bar_index, y1, bar_index, y2, color=c, width=3),
     false,
     d)

f_lsq_lnDot(float y, color c) => line.new(bar_index, y, bar_index + 3, y, color=c, style=line.style_dotted)

if lsq_enable
    bool lsq_oW = lsq_opt == "Only Wicks"
    bool lsq_oO = lsq_opt == "Only Outbreaks & Retest"
    bool lsq_WO = lsq_opt == "Wicks + Outbreaks & Retest"

    float lsq_ph = ta.pivothigh(lsq_len, lsq_len)
    float lsq_pl = ta.pivotlow(lsq_len, lsq_len)

    if f_lsq_valid(lsq_ph)
        lsq_aPivH.unshift(lsq_piv.new(lsq_ph, bar_index - lsq_len, false, false, false, false))
    if f_lsq_valid(lsq_pl)
        lsq_aPivL.unshift(lsq_piv.new(lsq_pl, bar_index - lsq_len, false, false, false, false))

    for i = lsq_aPivH.size() - 1 to 0
        get = lsq_aPivH.get(i)
        if not get.mit
            if not get.brk
                if close > get.prc
                    if not lsq_oW
                        get.brk := true
                    else
                        get.mit := true
                if not lsq_oO and not get.wic
                    if high > get.prc and close < get.prc
                        lsq_aBoxBr.unshift(get.lsq_br(f_dim(lsq_colBr3), f_dim(lsq_colBr), 1))
                        get.lsq_l(f_dim(lsq_colBr2), 'dt'), f_lsq_lnDot(low, f_dim(lsq_colBr))
                        get.wic := true
            else
                if close < get.prc
                    get.mit := true
                if not lsq_oW and low < get.prc and close > get.prc
                    lsq_aBoxBr.unshift(get.lsq_br(f_dim(lsq_colBl3), f_dim(lsq_colBl), -1))
                    get.lsq_l(f_dim(lsq_colBl2), 'ds'), f_lsq_lnDot(high, f_dim(lsq_colBl))
                    get.tak := true

        if bar_index - get.bix > 2000 or get.mit or get.tak
            lsq_aPivH.remove(i).lin.delete()

    for i = lsq_aPivL.size() - 1 to 0
        get = lsq_aPivL.get(i)
        if not get.mit
            if not get.brk
                if close < get.prc
                    if not lsq_oW
                        get.brk := true
                    else
                        get.mit := true
                if not lsq_oO and not get.wic
                    if low < get.prc and close > get.prc
                        lsq_aBoxBr.unshift(get.lsq_br(f_dim(lsq_colBl3), f_dim(lsq_colBl), -1))
                        get.lsq_l(f_dim(lsq_colBl2), 'dt'), f_lsq_lnDot(high, f_dim(lsq_colBl))
                        get.wic := true
            else
                if close > get.prc
                    get.mit := true
                if not lsq_oW and high > get.prc and close < get.prc
                    lsq_aBoxBr.unshift(get.lsq_br(f_dim(lsq_colBr3), f_dim(lsq_colBr), 1))
                    get.lsq_l(f_dim(lsq_colBr2), 'ds'), f_lsq_lnDot(low, f_dim(lsq_colBr))
                    get.tak := true

        if bar_index - get.bix > 2000 or get.mit or get.tak
            lsq_aPivL.remove(i).lin.delete()

    if lsq_extend
        for bx in lsq_aBoxBr
            if not bx.br and bar_index - bx.bx.get_left() - 1 <= lsq_maxB
                bx.bx.set_right(bar_index)
                if bx.dr == -1 and close < bx.bx.get_bottom()
                    bx.br := true
                if bx.dr == 1 and close > bx.bx.get_top()
                    bx.br := true

// ====================================================================================================================
// 7.8 LIQUIDITY SWINGS — оригинальная концепция и код © LuxAlgo (CC BY-NC-SA 4.0), интеграция — © UserUZR
// ====================================================================================================================
f_lsw_get_data() => [high, low, volume]

[lsw_h, lsw_l, lsw_v] = request.security_lower_tf(syminfo.tickerid, lsw_intrabarTf, f_lsw_get_data())

f_lsw_get_counts(condition, top, btm) =>
    var count = 0
    var vol = 0.
    if condition
        count := 0
        vol := 0.
    else
        if lsw_intraPrecision
            if bar_index > lsw_length
                if array.size(lsw_v[lsw_length]) > 0
                    for [index, element] in lsw_v[lsw_length]
                        vol += array.get(lsw_l[lsw_length], index) < top and array.get(lsw_h[lsw_length], index) > btm ? element : 0
        else
            vol += low[lsw_length] < top and high[lsw_length] > btm ? volume[lsw_length] : 0
        count += low[lsw_length] < top and high[lsw_length] > btm ? 1 : 0
    [count, vol]

f_lsw_set_label(count, vol, x, y, css, lbl_style) =>
    var label lbl = na
    var label_size = switch lsw_label_size
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal

    target = switch lsw_filterOptions
        "Count"  => count
        "Volume" => vol

    if lsw_show_labels
        if ta.crossover(target, lsw_filterValue)
            lbl := label.new(x, y, str.tostring(vol, format.volume), style=lbl_style, size=label_size, color=#00000000, textcolor=f_dim(css))
        if target > lsw_filterValue
            label.set_text(lbl, str.tostring(vol, format.volume))
    else
        if not na(lbl)
            label.delete(lbl)
            lbl := na

f_lsw_set_level(condition, crossed, value, count, vol, css) =>
    var line lvl = na

    target = switch lsw_filterOptions
        "Count"  => count
        "Volume" => vol

    if condition
        if target[1] < lsw_filterValue[1]
            line.delete(lvl[1])
        else if not crossed[1]
            line.set_x2(lvl, bar_index - lsw_length)

        lvl := line.new(bar_index - lsw_length, value, bar_index, value, color=na)

    if not crossed[1]
        line.set_x2(lvl, bar_index + 3)

    if crossed and not crossed[1]
        line.set_x2(lvl, bar_index)
        line.set_style(lvl, line.style_dashed)

    if target > lsw_filterValue
        line.set_color(lvl, f_dim(css))

f_lsw_set_zone(condition, x, top, btm, count, vol, css) =>
    var box bx = na

    target = switch lsw_filterOptions
        "Count"  => count
        "Volume" => vol

    if ta.crossover(target, lsw_filterValue)
        bx := box.new(x, top, x + count, btm, border_color=na, bgcolor=f_dim(css))

    if target > lsw_filterValue
        box.set_right(bx, x + count)

var float lsw_ph_top     = na
var float lsw_ph_btm     = na
var bool  lsw_ph_crossed = bool(na)
var int   lsw_ph_x1      = 0
var box   lsw_ph_bx      = box.new(na, na, na, na, bgcolor=color.new(color.red, 80), border_color=na)

var float lsw_pl_top     = na
var float lsw_pl_btm     = na
var bool  lsw_pl_crossed = bool(na)
var int   lsw_pl_x1      = 0
var box   lsw_pl_bx      = box.new(na, na, na, na, bgcolor=color.new(color.teal, 80), border_color=na)

if lsw_enable
    box.set_bgcolor(lsw_ph_bx, f_dim(color.new(lsw_topAreaCss, 80)))
    box.set_bgcolor(lsw_pl_bx, f_dim(color.new(lsw_btmAreaCss, 80)))

    lsw_ph = ta.pivothigh(lsw_length, lsw_length)
    bool lsw_ph_valid = not na(lsw_ph)
    [lsw_ph_count, lsw_ph_vol] = f_lsw_get_counts(lsw_ph_valid, lsw_ph_top, lsw_ph_btm)

    if lsw_ph_valid and lsw_show_top
        lsw_ph_top := high[lsw_length]
        lsw_ph_btm := switch lsw_area
            "Wick Extremity" => math.max(close[lsw_length], open[lsw_length])
            "Full Range" => low[lsw_length]

        lsw_ph_x1 := bar_index - lsw_length
        lsw_ph_crossed := false

        box.set_lefttop(lsw_ph_bx, lsw_ph_x1, lsw_ph_top)
        box.set_rightbottom(lsw_ph_bx, lsw_ph_x1, lsw_ph_btm)
    else
        lsw_ph_crossed := close > lsw_ph_top ? true : lsw_ph_crossed

        if lsw_ph_crossed
            box.set_right(lsw_ph_bx, lsw_ph_x1)
        else
            box.set_right(lsw_ph_bx, bar_index + 3)

    if lsw_show_top
        f_lsw_set_zone(lsw_ph_valid, lsw_ph_x1, lsw_ph_top, lsw_ph_btm, lsw_ph_count, lsw_ph_vol, lsw_topAreaCss)
        f_lsw_set_level(lsw_ph_valid, lsw_ph_crossed, lsw_ph_top, lsw_ph_count, lsw_ph_vol, lsw_topCss)
        f_lsw_set_label(lsw_ph_count, lsw_ph_vol, lsw_ph_x1, lsw_ph_top, lsw_topCss, label.style_label_down)

    lsw_pl = ta.pivotlow(lsw_length, lsw_length)
    bool lsw_pl_valid = not na(lsw_pl)
    [lsw_pl_count, lsw_pl_vol] = f_lsw_get_counts(lsw_pl_valid, lsw_pl_top, lsw_pl_btm)

    if lsw_pl_valid and lsw_show_btm
        lsw_pl_top := switch lsw_area
            "Wick Extremity" => math.min(close[lsw_length], open[lsw_length])
            "Full Range" => high[lsw_length]
        lsw_pl_btm := low[lsw_length]

        lsw_pl_x1 := bar_index - lsw_length
        lsw_pl_crossed := false

        box.set_lefttop(lsw_pl_bx, lsw_pl_x1, lsw_pl_top)
        box.set_rightbottom(lsw_pl_bx, lsw_pl_x1, lsw_pl_btm)
    else
        lsw_pl_crossed := close < lsw_pl_btm ? true : lsw_pl_crossed

        if lsw_pl_crossed
            box.set_right(lsw_pl_bx, lsw_pl_x1)
        else
            box.set_right(lsw_pl_bx, bar_index + 3)

    if lsw_show_btm
        f_lsw_set_zone(lsw_pl_valid, lsw_pl_x1, lsw_pl_top, lsw_pl_btm, lsw_pl_count, lsw_pl_vol, lsw_btmAreaCss)
        f_lsw_set_level(lsw_pl_valid, lsw_pl_crossed, lsw_pl_btm, lsw_pl_count, lsw_pl_vol, lsw_btmCss)
        f_lsw_set_label(lsw_pl_count, lsw_pl_vol, lsw_pl_x1, lsw_pl_btm, lsw_btmCss, label.style_label_up)

if barstate.islast and dlead_enable
    if not na(g_ob_candidate_top_bull) and not na(g_ob_candidate_btm_bull) and g_ob_candidate_top_bull > g_ob_candidate_btm_bull
        [ob_lead_abs, ob_lead_isBull] = f_measure_delta_max(g_ob_candidate_btm_bull, g_ob_candidate_top_bull, bb_swingLimit, dva_delta_bins)
        if ob_lead_abs > 0
            [ob_lead_over, ob_lead_pct] = f_davg_excess(ob_lead_abs, davg_buf_ob)
            float ob_lead_y = math.avg(g_ob_candidate_btm_bull, g_ob_candidate_top_bull)
            color ob_lead_col = ob_lead_isBull ? dlead_color_bull : dlead_color_bear
            string ob_lead_txt = "OB " + (ob_lead_isBull ? "▲" : "▼") + " " + str.tostring(ob_lead_abs, format.volume) + (ob_lead_over ? " (+" + str.tostring(ob_lead_pct, "#.#") + "%)" : "")
            if not na(dlead_ob_line)
                line.delete(dlead_ob_line)
            if not na(dlead_ob_lbl)
                label.delete(dlead_ob_lbl)
            dlead_ob_line := line.new(bar_index, ob_lead_y, bar_index + dlead_extend_bars, ob_lead_y, color=f_dim(ob_lead_col), width=dlead_line_width)
            dlead_ob_lbl  := label.new(bar_index + dlead_extend_bars, ob_lead_y, ob_lead_txt, style=label.style_label_left, color=color.new(color.white,100), textcolor=f_dim(ob_lead_col), size=f_dva_txsz(dlead_text_size))

    var line dlead_brk_line_local = dlead_brk_line
    var label dlead_brk_lbl_local = dlead_brk_lbl
    if not na(dlead_brk_line)
        line.delete(dlead_brk_line)
        dlead_brk_line := na
    if not na(dlead_brk_lbl)
        label.delete(dlead_brk_lbl)
        dlead_brk_lbl := na

    if g_sd_candidate_demand_top > g_sd_candidate_demand_btm
        [sd_lead_abs_d, sd_lead_isBull_d] = f_measure_delta_max(g_sd_candidate_demand_btm, g_sd_candidate_demand_top, 300, dva_delta_bins)
        if sd_lead_abs_d > 0
            [sd_lead_over_d, sd_lead_pct_d] = f_davg_excess(sd_lead_abs_d, davg_buf_sd)
            float sd_lead_y_d = math.avg(g_sd_candidate_demand_btm, g_sd_candidate_demand_top)
            color sd_lead_col_d = sd_lead_isBull_d ? dlead_color_bull : dlead_color_bear
            string sd_lead_txt_d = "S&D " + (sd_lead_isBull_d ? "▲" : "▼") + " " + str.tostring(sd_lead_abs_d, format.volume) + (sd_lead_over_d ? " (+" + str.tostring(sd_lead_pct_d, "#.#") + "%)" : "")
            if not na(dlead_sd_line)
                line.delete(dlead_sd_line)
            if not na(dlead_sd_lbl)
                label.delete(dlead_sd_lbl)
            dlead_sd_line := line.new(bar_index, sd_lead_y_d, bar_index + dlead_extend_bars, sd_lead_y_d, color=f_dim(sd_lead_col_d), width=dlead_line_width)
            dlead_sd_lbl  := label.new(bar_index + dlead_extend_bars, sd_lead_y_d, sd_lead_txt_d, style=label.style_label_left, color=color.new(color.white,100), textcolor=f_dim(sd_lead_col_d), size=f_dva_txsz(dlead_text_size))

if barstate.islast and not dlead_enable
    if not na(dlead_ob_line)
        line.delete(dlead_ob_line)
        dlead_ob_line := na
    if not na(dlead_ob_lbl)
        label.delete(dlead_ob_lbl)
        dlead_ob_lbl := na
    if not na(dlead_sd_line)
        line.delete(dlead_sd_line)
        dlead_sd_line := na
    if not na(dlead_sd_lbl)
        label.delete(dlead_sd_lbl)
        dlead_sd_lbl := na

f_kmeans(int n, int k, int iterations) =>
    float[] prices  = array.new_float(0)
    float[] volumes = array.new_float(0)
    float minP = 1e10, maxP = -1e10
    for i = 0 to n - 1
        float p = hl2[i], float v = volume[i]
        prices.push(p), volumes.push(v)
        minP := math.min(minP, p), maxP := math.max(maxP, p)
    float[] centroids = array.new_float(k)
    float   step      = (maxP - minP) / (k + 1)
    for i = 0 to k - 1
        centroids.set(i, minP + (i + 1) * step)
    int[] assignments = array.new_int(n)
    for iter = 1 to iterations
        for i = 0 to n - 1
            float p = prices.get(i), int best_k = 0, float min_dist = 1e10
            for j = 0 to k - 1
                float dist = math.abs(p - centroids.get(j))
                if dist < min_dist
                    min_dist := dist, best_k := j
            assignments.set(i, best_k)
        float[] sum_pv = array.new_float(k, 0.0), float[] sum_v = array.new_float(k, 0.0)
        for i = 0 to n - 1
            int cluster = assignments.get(i)
            sum_pv.set(cluster, sum_pv.get(cluster) + prices.get(i) * volumes.get(i))
            sum_v.set(cluster,  sum_v.get(cluster)  + volumes.get(i))
        for j = 0 to k - 1
            if sum_v.get(j) > 0
                centroids.set(j, sum_pv.get(j) / sum_v.get(j))
    [assignments, centroids]

var box[]   clBoxes  = array.new_box()
var label[] clLabels = array.new_label()
var line[]  clLines  = array.new_line()

if en_1 and barstate.islast
    [assignments, centroids] = f_kmeans(lookback_1, k_1, iters_1)
    if clBoxes.size() > 0
        for b in clBoxes
            b.delete()
        clBoxes.clear()
    if clLabels.size() > 0
        for l in clLabels
            l.delete()
        clLabels.clear()
    if clLines.size() > 0
        for ln in clLines
            ln.delete()
        clLines.clear()
    int calcStart = bar_index - lookback_1 + 1, int vpStartX = bar_index + vpOffset
    for c_id = 0 to k_1 - 1
        color clusterColor = PALETTE.get(c_id % PALETTE.size())
        float[] c_highs  = array.new_float(0), float[] c_lows   = array.new_float(0)
        float[] c_prices = array.new_float(0), float[] c_vols   = array.new_float(0)
        float c_min = 1e10, float c_max = -1e10, float c_total_vol = 0.0
        for i = 0 to lookback_1 - 1
            if assignments.get(i) == c_id
                float p = hl2[i], float v = volume[i], float h = high[i], float l = low[i]
                c_prices.push(p), c_vols.push(v), c_highs.push(h), c_lows.push(l)
                c_min := math.min(c_min, l), c_max := math.max(c_max, h)
                c_total_vol += v
        if c_prices.size() > 0
            float[] binVols = array.new_float(rows_1, 0.0)
            float binSize = math.max((c_max - c_min) / rows_1, syminfo.mintick)
            for i = 0 to c_prices.size() - 1
                float b_h = c_highs.get(i), float b_l = c_lows.get(i), float b_v = c_vols.get(i)
                float wickRange = math.max(b_h - b_l, syminfo.mintick)
                for b_idx = 0 to rows_1 - 1
                    float binB = c_min + b_idx * binSize, float binT = binB + binSize
                    float iL = math.max(b_l, binB), float iH = math.min(b_h, binT)
                    if iH > iL
                        binVols.set(b_idx, binVols.get(b_idx) + b_v * (iH - iL) / wickRange)
            float maxBinVol = binVols.max(), int pocBinIdx = binVols.indexof(maxBinVol)
            for b_idx = 0 to rows_1 - 1
                float vol = binVols.get(b_idx)
                if vol == 0
                    continue
                float b_bottom = c_min + b_idx * binSize, float b_top = b_bottom + binSize
                int b_width = int((vol / math.max(maxBinVol, 1)) * vpWidth), int endX = vpStartX + b_width
                bool isPoc = b_idx == pocBinIdx
                clBoxes.push(box.new(vpStartX, b_top, endX, b_bottom, bgcolor=f_dim(isPoc ? clusterColor : color.new(clusterColor, 75)), border_color=f_dim(isPoc ? clusterColor : #00000000)))
                if isPoc
                    float pocY = (b_top + b_bottom) / 2
                    if cl_show_price_dots
                        clLines.push(line.new(calcStart, pocY, vpStartX, pocY, color=f_dim(clusterColor), width=1, style=line.style_dashed))
                    if cl_show_vol_labels
                        clLabels.push(label.new(calcStart, pocY, str.tostring(vol, format.volume), color=#00000000, textcolor=f_dim(clusterColor), style=label.style_label_right, size=size.small))
                        clLabels.push(label.new(endX, pocY, "Total: " + str.tostring(c_total_vol, format.volume), color=#00000000, textcolor=f_dim(clusterColor), style=label.style_label_left, size=size.small))

var hm_boxes       = array.new<box>()
var hm_labels      = array.new<label>()
var hm_lines       = array.new<line>()
var hm_volume_bins = array.new<float>(hm_bins, 0.)
var int   export_hm_signal = 0
var float export_hm_vol    = 0.0
var bool  hm_vol_anomalous_now = false

if en_hm
    export_hm_signal := 0, export_hm_vol := 0.0
    hm_vol_anomalous_now := false
    float hm_vol     = math.sum(volume, 10)
    float hm_max_vol = ta.highest(hm_vol, hm_lookBack)
    float hm_nVol    = hm_max_vol > 0 ? (hm_vol / hm_max_vol * 100) : 0
    float hm_atr     = ta.atr(5) / 50
    float hm_offset  = ta.highest(hm_atr * hm_nVol, hm_lookBack)
    float hm_top     = ta.highest(high + hm_offset, hm_lookBack)
    float hm_bot     = ta.lowest(low   - hm_offset, hm_lookBack)
    float hm_step    = (hm_top - hm_bot) / hm_resolution
    float level1     = high + hm_atr * hm_nVol
    float level2     = low  - hm_atr * hm_nVol
    float hm_h = ta.highest(high, 2), float hm_l = ta.lowest(low, 2)
    if hm_h == high
        for i = 0 to hm_resolution - 1
            float lower = hm_bot + hm_step * i, float mid = lower + hm_step / 2
            if math.abs(level1 - mid) <= hm_step
                hm_pivots.push(hm_pivot.new(mid, bar_index, hm_nVol, hm_vol, false))
    if hm_l == low
        for i = 0 to hm_resolution - 1
            float lower = hm_bot + hm_step * i, float mid = lower + hm_step / 2
            if math.abs(level2 - mid) <= hm_step
                hm_pivots.push(hm_pivot.new(mid - hm_atr * hm_nVol, bar_index, hm_nVol, hm_vol, true))
    if hm_pivots.size() > 0
        for i = hm_pivots.size() - 1 to 0
            hm_pivot p = hm_pivots.get(i)
            if bar_index - p.index > hm_lookBack
                hm_pivots.remove(i)
                continue
            if p.isLower and low < p.value
                if barstate.isconfirmed and close > p.value
                    export_hm_signal := 1, export_hm_vol := p.vol
                    hm_pivots.remove(i)
            else if not p.isLower and high > p.value
                if barstate.isconfirmed and close < p.value
                    export_hm_signal := -1, export_hm_vol := p.vol
                    hm_pivots.remove(i)

    float hm_vol_anomaly_sma = ta.sma(volume, hm_vol_sma_len)
    hm_vol_anomalous_now := export_hm_signal != 0 and export_hm_vol > hm_vol_anomaly_sma * hm_vol_anomaly_mult

    if barstate.islast
        for ln in hm_lines
            ln.delete()
        for b in hm_boxes
            b.delete()
        for lbl in hm_labels
            lbl.delete()
        hm_lines.clear(), hm_boxes.clear(), hm_labels.clear()
        float step_draw = (hm_top - hm_bot) / hm_bins
        for j = 0 to hm_bins - 1
            hm_volume_bins.set(j, 0)
        if hm_pivots.size() > 0
            for i = 0 to hm_pivots.size() - 1
                hm_pivot lvl = hm_pivots.get(i)
                for j = 0 to hm_bins - 1
                    float lower = hm_bot + step_draw * j, float mid = lower + step_draw / 2
                    if math.abs(lvl.value - mid) < step_draw
                        hm_volume_bins.set(j, hm_volume_bins.get(j) + lvl.vol)
        for j = 0 to hm_bins - 1
            float lower  = hm_bot + step_draw * j
            float upper  = lower + step_draw
            float mid    = lower + step_draw / 2
            float voll   = hm_volume_bins.get(j)
            float max_v  = hm_volume_bins.max()
            float valueVol = max_v > 0 ? (voll / max_v * 50) : 0
            color col    = close > mid ? hm_buyColor : hm_sellColor
            color m_col  = color.from_gradient(voll, hm_volume_bins.min(), max_v, color.new(col, 80), color.new(col, 0))
            color m_col1 = color.from_gradient(voll, hm_volume_bins.min(), max_v, color.new(col, 50), color.new(col, 0))
            if not (close < upper and close > lower)
                if hm_displPf and valueVol != 0
                    hm_boxes.push(box.new(bar_index + hm_hist_offset, upper, bar_index + hm_hist_offset + int(valueVol), lower, bgcolor=f_dim((voll == max_v and hm_poc) ? hm_maxColor : m_col), border_color=f_dim(chart.bg_color), text=voll > hm_volume_bins.avg() ? str.tostring(voll, format.volume) : "", text_halign=text.align_left))
                    hm_boxes.push(box.new(bar_index + hm_hist_offset, upper, bar_index + 5, lower, text=str.tostring(valueVol * 2, format.percent), bgcolor=color(na), border_color=color(na), text_color=f_dim((voll == max_v) ? hm_maxColor : m_col1)))
                int start_line = 0
                bool isLower_b = close > mid
                for i = 0 to hm_lookBack - 1
                    if isLower_b
                        if low[i] < mid
                            start_line := bar_index - i, break
                        if i == hm_lookBack - 1
                            start_line := bar_index - i
                    else
                        if high[i] > mid
                            start_line := bar_index - i, break
                        if i == hm_lookBack - 1
                            start_line := bar_index - i
                color l_col = (voll == max_v and hm_poc) ? hm_maxColor : color.from_gradient(valueVol, 0, 50, color(na), isLower_b ? color.new(hm_buyColor, 30) : color.new(hm_sellColor, 30))
                hm_lines.push(line.new(start_line + 3, mid, bar_index + 5, mid, width=int(valueVol / 5), color=f_dim(l_col)))

[mr_di_plus, mr_di_minus, mr_adx] = ta.dmi(14, 14)
bool mr_trend_bull = mr_adx > 20 and mr_di_plus  > mr_di_minus
bool mr_trend_bear = mr_adx > 20 and mr_di_minus > mr_di_plus

int   p1_smc_trend = en_smc ? export_ms.trend : 0
int   p1_sd_zone   = en_3  ? (sd_in_demand ? 1 : sd_in_supply ? -1 : 0) : 0

int export_sweep = 0
if en_smc and barstate.isconfirmed
    export_sweep := export_ms.upsweep ? -1 : export_ms.dnsweep ? 1 : 0

var string prev_ms_txt = na
string curr_ms_txt = export_ms.txt

bool is_new_choch = false
bool is_new_bos   = false

if barstate.isconfirmed
    if curr_ms_txt == "choch" and (na(prev_ms_txt) ? "" : prev_ms_txt) != "choch"
        is_new_choch := true
    if curr_ms_txt == "bos" and (na(prev_ms_txt) ? "" : prev_ms_txt) != "bos"
        is_new_bos := true
    prev_ms_txt := curr_ms_txt

int export_choch = (is_new_choch and barstate.isconfirmed) ? export_ms.trend : 0
int export_bos   = (is_new_bos   and barstate.isconfirmed) ? export_ms.trend : 0

float current_atr = ta.atr(14)

var float export_fvg_top = na
var float export_fvg_bot = na
var int   export_fvg_poc = 0
export_fvg_poc := 0, export_fvg_top := na, export_fvg_bot := na

if en_2 and fvgs.size() > 0
    for f in fvgs
        if (f.isBull and low  <= f.FVG.get_top() and low  >= f.FVG.get_bottom()) or (not f.isBull and high >= f.FVG.get_bottom() and high <= f.FVG.get_top())
            export_fvg_top := f.FVG.get_top(), export_fvg_bot := f.FVG.get_bottom()
        if not na(f.poc)
            float poc_val   = f.poc.get_y1()
            float tolerance = math.max(math.abs(f.FVG.get_top() - f.FVG.get_bottom()) / fvg_bins, current_atr * 0.1)
            if high >= poc_val - tolerance and low <= poc_val + tolerance
                export_fvg_poc := f.isInversion ? (f.isBull ? 2 : -2) : (f.isBull ? 1 : -1)

var float swing_high = na, var float swing_low = na
if en_smc
    bool is_new_struct = is_new_choch or is_new_bos
    if p1_smc_trend == 1
        swing_low  := export_ms.choch
        swing_high := na(swing_high) or is_new_struct ? high : math.max(swing_high, high)
    else if p1_smc_trend == -1
        swing_high := export_ms.choch
        swing_low  := na(swing_low) or is_new_struct ? low : math.min(swing_low, low)

float ote_upper = na, float ote_lower = na, int export_ote = 0
if not na(swing_high) and not na(swing_low) and swing_high > swing_low
    float rng = swing_high - swing_low
    if p1_smc_trend == 1
        ote_upper := swing_low + rng * 0.382, ote_lower := swing_low + rng * 0.214
        export_ote := (close <= ote_upper and close >= ote_lower) ? 1 : 0
    else if p1_smc_trend == -1
        ote_lower := swing_high - rng * 0.382, ote_upper := swing_high - rng * 0.214
        export_ote := (close >= ote_lower and close <= ote_upper) ? -1 : 0

bool export_ote_confluence_bull = export_ote == 1  and export_fib_ote == 1
bool export_ote_confluence_bear = export_ote == -1 and export_fib_ote == -1

var float confirmed_bos_price   = na
var float confirmed_choch_price = na
if en_smc and export_ms.txt == "bos"
    confirmed_bos_price := export_ms.zz
if en_smc and export_ms.txt == "choch"
    confirmed_choch_price := export_ms.zz

bool  anchor_bar        = is_new_choch or is_new_bos
float export_avwap      = ta.vwap(hlc3, anchor_bar)
bool  anchor_bar_fast   = is_new_choch or is_new_bos or (export_sd_inv != 0)
float export_avwap_fast = ta.vwap(hlc3, anchor_bar_fast)

int export_displacement_dir = 0
if barstate.isconfirmed
    if math.abs(close - open) > (current_atr * 1.5)
        export_displacement_dir := close > open ? 1 : -1

var float prev_confirmed_bos_price   = na
var float prev_confirmed_choch_price = na
var int   bos_level_trend_at_fix     = 0
var int   choch_level_trend_at_fix   = 0
var int   bos_level_touches          = 0
var int   choch_level_touches        = 0

bool bos_level_is_new   = en_smc and export_ms.txt == "bos"   and (na(prev_confirmed_bos_price)   or confirmed_bos_price   != prev_confirmed_bos_price)
bool choch_level_is_new = en_smc and export_ms.txt == "choch" and (na(prev_confirmed_choch_price) or confirmed_choch_price != prev_confirmed_choch_price)

if bos_level_is_new
    bos_level_touches      := 0
    bos_level_trend_at_fix := export_ms.trend
    prev_confirmed_bos_price := confirmed_bos_price

if choch_level_is_new
    choch_level_touches      := 0
    choch_level_trend_at_fix := export_ms.trend
    prev_confirmed_choch_price := confirmed_choch_price

float retest_tol = current_atr * 0.15

if barstate.isconfirmed and not na(confirmed_bos_price) and not bos_level_is_new
    if math.abs(close - confirmed_bos_price) <= retest_tol or (low <= confirmed_bos_price + retest_tol and high >= confirmed_bos_price - retest_tol)
        bos_level_touches += 1

if barstate.isconfirmed and not na(confirmed_choch_price) and not choch_level_is_new
    if math.abs(close - confirmed_choch_price) <= retest_tol or (low <= confirmed_choch_price + retest_tol and high >= confirmed_choch_price - retest_tol)
        choch_level_touches += 1

float export_bos_price_signed   = na(confirmed_bos_price)   ? na : (bos_level_trend_at_fix   == 1 ? confirmed_bos_price   : -confirmed_bos_price)
float export_choch_price_signed = na(confirmed_choch_price) ? na : (choch_level_trend_at_fix == 1 ? confirmed_choch_price : -confirmed_choch_price)

var int bars_since_last_sweep_bull = 999
var int bars_since_last_sweep_bear = 999

bars_since_last_sweep_bull := export_sweep == 1  ? 0 : math.min(bars_since_last_sweep_bull + 1, 999)
bars_since_last_sweep_bear := export_sweep == -1 ? 0 : math.min(bars_since_last_sweep_bear + 1, 999)

bool export_zone_conf_bull = false
bool export_zone_conf_bear = false
int  zone_layers_bull      = 0
int  zone_layers_bear      = 0

if export_ob_state == 1
    zone_layers_bull += 1
if sd_in_demand
    zone_layers_bull += 1
if en_2 and not na(export_fvg_top) and not na(export_fvg_bot) and
   close <= export_fvg_top and close >= export_fvg_bot and (export_fvg_poc == 1 or export_fvg_poc == 2)
    zone_layers_bull += 1

if export_ob_state == -1
    zone_layers_bear += 1
if sd_in_supply
    zone_layers_bear += 1
if en_2 and not na(export_fvg_top) and not na(export_fvg_bot) and
   close <= export_fvg_top and close >= export_fvg_bot and (export_fvg_poc == -1 or export_fvg_poc == -2)
    zone_layers_bear += 1

export_zone_conf_bull := zone_layers_bull >= 2
export_zone_conf_bear := zone_layers_bear >= 2

int export_conf_bull = 0
export_conf_bull += p1_smc_trend == 1      ? 2 : 0
export_conf_bull += sd_in_demand           ? 1 : 0
export_conf_bull += export_ob_state == 1   ? 1 : 0
export_conf_bull += export_ote == 1        ? 1 : 0
export_conf_bull += export_ote_confluence_bull ? 1 : 0
export_conf_bull += close > export_avwap   ? 1 : 0
export_conf_bull += export_hm_signal == 1  ? 1 : 0
export_conf_bull += export_zone_conf_bull  ? 2 : 0
export_conf_bull += (export_sweep == 1 and is_new_choch and export_ms.trend == 1) ? 1 : 0
export_conf_bull += mr_trend_bull          ? 1 : 0
export_conf_bull += g_ltf_bull_cnt + htf_bull_conf

int export_conf_bear = 0
export_conf_bear += p1_smc_trend == -1     ? 2 : 0
export_conf_bear += sd_in_supply           ? 1 : 0
export_conf_bear += export_ob_state == -1  ? 1 : 0
export_conf_bear += export_ote == -1       ? 1 : 0
export_conf_bear += export_ote_confluence_bear ? 1 : 0
export_conf_bear += close < export_avwap   ? 1 : 0
export_conf_bear += export_hm_signal == -1 ? 1 : 0
export_conf_bear += export_zone_conf_bear  ? 2 : 0
export_conf_bear += (export_sweep == -1 and is_new_choch and export_ms.trend == -1) ? 1 : 0
export_conf_bear += mr_trend_bear          ? 1 : 0
export_conf_bear += g_ltf_bear_cnt + htf_bear_conf

int master_signal_threshold = f_pr_master_thr(9)
int export_master_signal = 0
if export_conf_bull >= master_signal_threshold and export_conf_bull > export_conf_bear
    export_master_signal := 1
else if export_conf_bear >= master_signal_threshold and export_conf_bear > export_conf_bull
    export_master_signal := -1

int delta_anomaly_engine_bitmask =
  (g_ltf1_dab?1:0)    + (g_ltf1_das?1:0)*2   + (g_ltf2_dab?1:0)*4   + (g_ltf2_das?1:0)*8 +
  (g_ltf3_dab?1:0)*16  + (g_ltf3_das?1:0)*32  + (g_htf1_dab?1:0)*64  + (g_htf1_das?1:0)*128 +
  (g_htf2_dab?1:0)*256 + (g_htf2_das?1:0)*512 + (g_htf3_dab?1:0)*1024 + (g_htf3_das?1:0)*2048

int delta_anomaly_block_bitmask =
  (da_ob_fresh_bull?1:0) + (da_ob_fresh_bear?1:0)*2 + (da_sd_fresh_bull?1:0)*4 + (da_sd_fresh_bear?1:0)*8 + (da_fvg_fresh_bull?1:0)*16 + (da_fvg_fresh_bear?1:0)*32 + (da_liq_fresh_bull?1:0)*64 + (da_liq_fresh_bear?1:0)*128

int delta_anomaly_bull_cnt = (g_ltf1_dab?1:0)+(g_ltf2_dab?1:0)+(g_ltf3_dab?1:0)+(g_htf1_dab?1:0)+(g_htf2_dab?1:0)+(g_htf3_dab?1:0)+(da_ob_fresh_bull?1:0)+(da_sd_fresh_bull?1:0)+(da_fvg_fresh_bull?1:0)+(da_liq_fresh_bull?1:0)
int delta_anomaly_bear_cnt = (g_ltf1_das?1:0)+(g_ltf2_das?1:0)+(g_ltf3_das?1:0)+(g_htf1_das?1:0)+(g_htf2_das?1:0)+(g_htf3_das?1:0)+(da_ob_fresh_bear?1:0)+(da_sd_fresh_bear?1:0)+(da_fvg_fresh_bear?1:0)+(da_liq_fresh_bear?1:0)

int export_delta_anomaly_confluence = delta_anomaly_bull_cnt*10 + delta_anomaly_bear_cnt

int   export_ote_confluence_pack = export_ote_confluence_bull ? 1 : export_ote_confluence_bear ? 2 : 0
int   export_confluence_pack     = export_conf_bull * 100 + export_conf_bear
int   mr_regime_code             = mr_trend_bull ? 1 : mr_trend_bear ? -1 : 0
int   export_regime_adx_pack     = (mr_regime_code + 1) * 1000 + int(mr_adx * 10)

plot(9999.0,                                title="[P1] ALIVE_SIGNAL",              display=display.data_window)
plot(p1_smc_trend,                          title="[P1] SMC Trend",                 display=display.data_window)
plot(export_ob_pack_bull,                   title="[P1] OB Pack Bull",              display=display.data_window)
plot(export_ob_pack_bear,                   title="[P1] OB Pack Bear",              display=display.data_window)
plot(export_hm_signal,                      title="[P1] HM Sweep",                  display=display.data_window)
plot(hm_vol_anomalous_now ? -export_hm_vol : export_hm_vol, title="[P1] HM Sweep Vol Pack", display=display.data_window)
plot(export_fvg_pack_bull,                  title="[P1] FVG Pack Bull",             display=display.data_window)
plot(export_fvg_pack_bear,                  title="[P1] FVG Pack Bear",             display=display.data_window)
plot(nz(export_fvg_top),                    title="[P1] FVG Top",                   display=display.data_window)
plot(nz(export_fvg_bot),                    title="[P1] FVG Bottom",                display=display.data_window)
plot(export_sd_pack_bull,                   title="[P1] S&D Pack Bull",             display=display.data_window)
plot(export_sd_pack_bear,                   title="[P1] S&D Pack Bear",             display=display.data_window)
plot(export_sweep,                          title="[P1] SMC Sweep",                 display=display.data_window)
plot(export_choch,                          title="[P1] CHoCH",                     display=display.data_window)
plot(export_bos,                            title="[P1] BOS Trigger",               display=display.data_window)
plot(nz(export_bos_price_signed),           title="[P1] Confirmed BOS Level",       display=display.data_window)
plot(nz(export_choch_price_signed),         title="[P1] Confirmed CHoCH Level",     display=display.data_window)
plot(math.min(bos_level_touches,9)*10 + math.min(choch_level_touches,9), title="[P1] Level Touches Pack", display=display.data_window)
plot(nz(export_avwap),                      title="[P1] Institutional AVWAP",       display=display.data_window)
plot(nz(export_avwap_fast),                 title="[P1] Fast AVWAP",                display=display.data_window)
plot(export_displacement_dir,               title="[P1] Displacement Candle",       display=display.data_window)
plot(export_ote,                            title="[P1] OTE Zone Score",            display=display.data_window)
plot(export_ote_confluence_pack,            title="[P1] OTE Confluence Pack",       display=display.data_window)

plot(export_confluence_pack, title="[P1] Confluence Pack", display=display.data_window)
plot(export_master_signal,   title="[P1] Master Signal",   display=display.data_window)

plot(export_regime_adx_pack, title="[P1] Regime+ADX Pack", display=display.data_window)

plot(g_ltf1_sb*100 + g_ltf1_ss, title="[P1] LTF1 Score Pack", display=display.data_window)
plot(g_ltf2_sb*100 + g_ltf2_ss, title="[P1] LTF2 Score Pack", display=display.data_window)
plot(g_ltf3_sb*100 + g_ltf3_ss, title="[P1] LTF3 Score Pack", display=display.data_window)
plot(g_htf1_sb*100 + g_htf1_ss, title="[P1] HTF1 Score Pack", display=display.data_window)
plot(g_htf2_sb*100 + g_htf2_ss, title="[P1] HTF2 Score Pack", display=display.data_window)
plot(g_htf3_sb*100 + g_htf3_ss, title="[P1] HTF3 Score Pack", display=display.data_window)

plot(e1_min_score*1e4 + e2_min_score*1e2 + e3_min_score, title="[P1] Min Score Pack A", display=display.data_window)
plot(e4_min_score*1e4 + e5_min_score*1e2 + e6_min_score, title="[P1] Min Score Pack B", display=display.data_window)

plot(nz(va_val_price),        title="[P1] VAL Price",           display=display.data_window)
plot(nz(va_vah_price),        title="[P1] VAH Price",           display=display.data_window)
plot(nz(fib_poc_price),       title="[P1] POC Price",           display=display.data_window)
plot(export_fib_range_pack,   title="[P1] Fib Range Pack",      display=display.data_window)
plot(nz(fib_hiPrice),         title="[P1] Fib Swing High",      display=display.data_window)
plot(nz(fib_loPrice),         title="[P1] Fib Swing Low",       display=display.data_window)

plot(delta_anomaly_engine_bitmask,        title="[P1] Delta Anomaly Engine Bitmask", display=display.data_window)
plot(delta_anomaly_block_bitmask,         title="[P1] Delta Anomaly Block Bitmask",  display=display.data_window)
plot(export_delta_anomaly_confluence,     title="[P1] Delta Anomaly Confluence",     display=display.data_window)

plot(export_liq_pack, title="[P1] Liquidation Zones Pack", display=display.data_window)
